    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/search> ;
    skos:definition "Modern solvers combine several solving techniques: constraint propagation, clause learning from SAT, linear relaxation, parallel search; upstream, machine learning or a language model can guide the search or build the model."@en,
        "Les solveurs modernes combinent plusieurs techniques de résolution : propagation de contraintes, apprentissage de clauses venu de SAT, relaxation linéaire, recherche en parallèle ; en amont, l'apprentissage automatique ou un modèle de langue peut guider la recherche ou construire le modèle."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/search> ;
    skos:prefLabel "Hybrid constraint programming solvers"@en,
        "Solveurs hybrides de programmation par contraintes"@fr ;
