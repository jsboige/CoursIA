<https://github.com/jsboige/CoursIA/cursus/concept/c5a17aa1-e8ca-48cc-bf83-3d3928b364fd> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "c5a17aa1-e8ca-48cc-bf83-3d3928b364fd" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/GameTheory/GameTheory-14-DifferentialGames-CSharp.ipynb>,
        <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/GameTheory/GameTheory-14-DifferentialGames-Python.ipynb> ;
    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/gametheory> ;
    skos:broader <https://github.com/jsboige/CoursIA/cursus/concept/3aaa5e32-8101-4dca-a919-40ad9fad15a7> ;
    skos:definition "Differential game with linear dynamics and quadratic costs; its closed-loop Nash equilibrium is linear in the state, with gains obtained by solving coupled Riccati equations."@en,
        "Jeu différentiel à dynamique linéaire et coûts quadratiques ; son équilibre de Nash en boucle fermée est linéaire en l'état, avec des gains obtenus en résolvant des équations de Riccati couplées."@fr ;
