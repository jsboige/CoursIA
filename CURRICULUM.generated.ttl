    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/compression> ;
    skos:definition "Binary codes in which no codeword is a prefix of another, allowing decoding without separators."@en,
        "Codes binaires où aucun mot de code n'est le préfixe d'un autre, ce qui permet un décodage sans séparateur."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/compression> ;
    skos:prefLabel "Prefix codes"@en,
        "Codes préfixes"@fr ;
    cursus:decimalPath "1" ;
    cursus:depth 0 ;
