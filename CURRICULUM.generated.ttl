    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/search> ;
    skos:definition "Basic algorithm for solving a CSP: pick an unassigned variable, try each value of its domain while checking consistency with the partial assignment, and backtrack when no value fits. Unlike a depth-first search that checks a complete assignment, inconsistent branches are cut at every step."@en,
        "Algorithme de base pour résoudre un CSP : choisir une variable non assignée, essayer chaque valeur de son domaine en vérifiant la consistance avec l'assignation partielle, et revenir en arrière quand aucune valeur ne convient. À la différence d'une recherche en profondeur qui vérifie une assignation complète, les branches inconsistantes sont coupées à chaque étape."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/search> ;
    skos:prefLabel "Backtracking search"@en,
        "Recherche par retour arrière (backtracking)"@fr ;
    cursus:decimalPath "8" ;
    cursus:depth 0 ;
    cursus:hasCellCitation [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-01-Fundamentals-Python.ipynb> ;
            cursus:cellId "8b8fb1c0" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-01-Fundamentals-Python.ipynb> ;
            cursus:cellId "189519f8" ],
        [ a cursus:CellCitation ;
