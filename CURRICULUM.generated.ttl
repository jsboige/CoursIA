<https://github.com/jsboige/CoursIA/cursus/concept/e46abb2d-2e80-4ce4-9bda-90a387dd4c67> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "e46abb2d-2e80-4ce4-9bda-90a387dd4c67" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-07-Soft-CSharp.ipynb>,
        <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-07-Soft-Python.ipynb> ;
    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/search> ;
    skos:definition "A classical constraint is either satisfied or violated; a soft constraint replaces that verdict with a degree of satisfaction or a violation cost, which is optimised. Hard constraints remain mandatory."@en,
        "Une contrainte classique est satisfaite ou violée ; une contrainte souple remplace ce verdict par un degré de satisfaction ou par un coût de violation, que l'on optimise. Les contraintes dures restent obligatoires."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/search> ;
    skos:prefLabel "Soft constraints (soft CSP)"@en,
        "Contraintes souples (Soft CSP)"@fr ;
    cursus:decimalPath "14" ;
    cursus:depth 0 ;
    cursus:hasCellCitation [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-07-Soft-Python.ipynb> ;
            cursus:cellId "section-1-intro" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-07-Soft-Python.ipynb> ;
            cursus:cellId "section-6-summary" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-07-Soft-CSharp.ipynb> ;
            cursus:cellId "64337001" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-07-Soft-CSharp.ipynb> ;
            cursus:cellId "a4eb9a27" ] ;
    cursus:path "search/contraintes-souples" ;
    cursus:requiresConcept <https://github.com/jsboige/CoursIA/cursus/concept/1303494f-0bb9-413d-a0c5-be09ded1c027>,
        <https://github.com/jsboige/CoursIA/cursus/concept/4ee7c80e-d9f5-419b-adaa-f8bf74627a89> .

<https://github.com/jsboige/CoursIA/cursus/concept/e9452b0a-4b8a-49d7-8916-d50035e7a2b2> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "e9452b0a-4b8a-49d7-8916-d50035e7a2b2" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-09-Distributed-CSharp.ipynb>,
        <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-09-Distributed-Python.ipynb> ;
    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/search> ;
    skos:definition "A CSP whose variables are spread across agents: each controls its own and communicates through asynchronous messages, with no central solver; constraints between variables of different agents are settled through these exchanges. The usual simplification gives each agent one variable."@en,
        "Un CSP dont les variables sont réparties entre des agents : chacun contrôle les siennes et communique par messages asynchrones, sans solveur central ; les contraintes entre variables d'agents différents se règlent par ces échanges. La simplification courante associe une variable à chaque agent."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/search> ;
    skos:prefLabel "Distributed CSPs (DisCSP)"@en,
        "CSP distribués (DisCSP)"@fr ;
    cursus:decimalPath "16" ;
    cursus:depth 0 ;
    cursus:hasCellCitation [ a cursus:CellCitation ;
