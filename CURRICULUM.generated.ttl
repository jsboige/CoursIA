<https://github.com/jsboige/CoursIA/cursus/concept/772dafad-b151-415b-bcfa-29bc2ca5665f> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "772dafad-b151-415b-bcfa-29bc2ca5665f" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-06-Hybridization-CSharp.ipynb>,
        <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-06-Hybridization-Python.ipynb> ;
    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/search> ;
    skos:broader <https://github.com/jsboige/CoursIA/cursus/concept/e1381ece-164a-4776-8713-8b1deaf2cf1c> ;
    skos:definition "Schema conformance is about form, not meaning: a valid JSON may reverse a precedence or omit a constraint, and the solver then solves another problem. The solution is therefore replayed against the facts of the statement, then the optimum of the transcribed model is compared with that of a hand-written reference model."@en,
        "La conformité au schéma porte sur la forme, pas sur le sens : un JSON valide peut inverser une précédence ou omettre une contrainte, et le solveur résout alors un autre problème. La solution est donc rejouée contre les faits de l'énoncé, puis l'optimum du modèle transcrit est comparé à celui d'un modèle de référence écrit à la main."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/search> ;
    skos:prefLabel "Semantic guard on a generated model"@en,
        "Garde sémantique d'un modèle généré"@fr ;
