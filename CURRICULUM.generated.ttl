    skos:broader <https://github.com/jsboige/CoursIA/cursus/concept/ddf508f4-51be-4125-bafd-29355823e100> ;
    skos:definition "Value of an imperfect signal: average, over the possible results of the signal, the utility of the best decision taken after Bayesian updating, then subtract the utility of the decision without the signal."@en,
        "Valeur d'un signal imparfait : on moyenne, sur les résultats possibles du signal, l'utilité de la meilleure décision prise après mise à jour bayésienne, puis on retranche l'utilité de la décision sans signal."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/probas> ;
    skos:prefLabel "Expected value of sample information (EVSI)"@en,
        "Valeur espérée de l'information d'échantillon (EVSI)"@fr ;
