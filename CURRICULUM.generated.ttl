<https://github.com/jsboige/CoursIA/cursus/concept/0231500b-53f9-4e0a-8b55-1958f854f36d> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "0231500b-53f9-4e0a-8b55-1958f854f36d" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-03-Advanced-CSharp.ipynb>,
        <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-03-Advanced-Python.ipynb> ;
    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/search> ;
    skos:definition "Constraints over a group of variables that come with a specialised propagation algorithm; they state a frequent structure in one line (all-different values, resource capacity, circuit, table of tuples) and propagate more strongly than their decomposition into binary constraints."@en,
        "Contraintes portant sur un groupe de variables et dotées d'un algorithme de propagation spécialisé ; elles expriment en une ligne une structure fréquente (valeurs toutes différentes, capacité d'une ressource, circuit, table de tuples) et propagent plus fort que leur décomposition en contraintes binaires."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/search> ;
    skos:prefLabel "Global constraints"@en,
        "Contraintes globales"@fr ;
    cursus:decimalPath "10" ;
    cursus:depth 0 ;
    cursus:hasCellCitation [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-03-Advanced-Python.ipynb> ;
            cursus:cellId "section-2-global" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-03-Advanced-Python.ipynb> ;
            cursus:cellId "39e38657" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-03-Advanced-CSharp.ipynb> ;
            cursus:cellId "b67e8386" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-03-Advanced-CSharp.ipynb> ;
            cursus:cellId "4ba1f573" ] ;
    cursus:path "search/contraintes-globales" ;
    cursus:requiresConcept <https://github.com/jsboige/CoursIA/cursus/concept/1303494f-0bb9-413d-a0c5-be09ded1c027>,
        <https://github.com/jsboige/CoursIA/cursus/concept/442d06ab-a03e-42f5-bb22-afb076f17f79> .

<https://github.com/jsboige/CoursIA/cursus/concept/1303494f-0bb9-413d-a0c5-be09ded1c027> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "1303494f-0bb9-413d-a0c5-be09ded1c027" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-02-Consistency-CSharp.ipynb>,
        <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-02-Consistency-Python.ipynb> ;
    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/search> ;
    skos:definition "Rather than waiting for an assignment to violate a constraint, propagation removes in advance the values that have become impossible from the domains; consistency levels (node, arc, path, k-consistency) set how far this filtering goes: the stronger the level, the more pruning and the costlier the propagation."@en,
        "Au lieu d'attendre qu'une assignation viole une contrainte, la propagation retire à l'avance des domaines les valeurs devenues impossibles ; les niveaux de consistance (nœud, arc, chemin, k-consistance) fixent jusqu'où va ce filtrage : plus le niveau est fort, plus l'élagage est important et plus la propagation coûte."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/search> ;
    skos:prefLabel "Constraint propagation and consistency"@en,
        "Propagation de contraintes et consistance"@fr ;
    cursus:decimalPath "9" ;
    cursus:depth 0 ;
    cursus:hasCellCitation [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-02-Consistency-Python.ipynb> ;
            cursus:cellId "cell-1" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-02-Consistency-CSharp.ipynb> ;
            cursus:cellId "2f59658f" ] ;
    cursus:path "search/propagation" ;
    cursus:requiresConcept <https://github.com/jsboige/CoursIA/cursus/concept/4ced2c69-54d6-4eab-96a1-c559fb285f79> .

<https://github.com/jsboige/CoursIA/cursus/concept/2be8d188-2b9c-4dcc-a42d-cfdf567f84e1> a skos:Concept,
        cursus:CurriculumConcept ;
