<https://github.com/jsboige/CoursIA/cursus/concept/89117d37-532a-483f-9659-367cd808e550> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "89117d37-532a-483f-9659-367cd808e550" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-01-Fundamentals-CSharp.ipynb>,
        <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-01-Fundamentals-Python.ipynb> ;
    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/search> ;
    skos:definition "Problem defined by variables that take their values in given domains while satisfying constraints. Unlike state-space search, which walks a graph, solving exploits the constraints to discard large parts of the space."@en,
        "Problème défini par des variables qui prennent leurs valeurs dans des domaines donnés en respectant des contraintes. À la différence de la recherche dans un espace d'états, qui parcourt un graphe, la résolution exploite les contraintes pour écarter de larges portions de l'espace."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/search> ;
    skos:prefLabel "Constraint satisfaction problem (CSP)"@en,
        "Problème de satisfaction de contraintes (CSP)"@fr ;
    cursus:decimalPath "7" ;
    cursus:depth 0 ;
    cursus:hasCellCitation [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-01-Fundamentals-Python.ipynb> ;
            cursus:cellId "39d1a680" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-01-Fundamentals-CSharp.ipynb> ;
            cursus:cellId "9f051749" ] ;
    cursus:path "search/csp" ;
    cursus:requiresConcept <https://github.com/jsboige/CoursIA/cursus/concept/cceeb7e5-2921-4d8a-a4ec-ab3564b274cd> .

<https://github.com/jsboige/CoursIA/cursus/concept/ce379592-d998-40e0-be63-c52bdf69e57a> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "ce379592-d998-40e0-be63-c52bdf69e57a" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/SymbolicAI/SMT/Z3-Linq2Z3/01_Linq2Z3_Intro.ipynb>,
        <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/SymbolicAI/SMT/Z3-Linq2Z3/02_Sudoku_Theorem_vs_Array.ipynb> ;
    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/z3-linq2z3> ;
    skos:definition "The Theorem<T> pattern of Z3.Linq: write constraints in C# (lambdas, closures, positional records) and have them translated to Z3, from the explicit property-by-property theorem to the implicit model."@en,
        "Le patron Theorem<T> de Z3.Linq : écrire les contraintes en C# (lambda, closures, records positionnels) et les faire traduire vers Z3, du théorème explicite à l'énumération de propriétés au modèle implicite."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/z3-linq2z3> ;
    skos:prefLabel "The Z3.Linq theorem: a declarative C# DSL"@en,
        "Le théorème Z3.Linq : DSL C# déclaratif"@fr ;
    cursus:decimalPath "2" ;
    cursus:depth 0 ;
    cursus:hasCellCitation [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/SymbolicAI/SMT/Z3-Linq2Z3/02_Sudoku_Theorem_vs_Array.ipynb> ;
            cursus:cellId "f6a7b8c9" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/SymbolicAI/SMT/Z3-Linq2Z3/02_Sudoku_Theorem_vs_Array.ipynb> ;
            cursus:cellId "e1f2a3b4" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/SymbolicAI/SMT/Z3-Linq2Z3/01_Linq2Z3_Intro.ipynb> ;
            cursus:cellId "aa11516a" ] ;
    cursus:path "z3-linq2z3/theorem-linq" ;
    cursus:requiresConcept <https://github.com/jsboige/CoursIA/cursus/concept/f2684efa-78ae-4f95-ba6b-dfd5d03614b0> .

<https://github.com/jsboige/CoursIA/cursus/concept/d989df2d-84ec-4a14-9866-26c3451cf9d9> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "d989df2d-84ec-4a14-9866-26c3451cf9d9" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/SymbolicAI/Planners/03-Advanced/Planners-09-HTN-CSharp.ipynb>,
