    skos:broader <https://github.com/jsboige/CoursIA/cursus/concept/8eb90dfc-33a0-4584-ae3c-180c17d0366a> ;
    skos:definition "Policy choosing at each state an action optimal for the current matrix alone; it is defined only once ties between equivalent actions are broken, and is evaluated on the whole game, where it may reach the optimal value or fall short depending on the tie-break."@en,
        "Politique qui choisit à chaque état une action optimale pour la seule matrice courante ; elle n'est définie qu'une fois fixé le départage entre actions équivalentes, et s'évalue sur la partie entière, où elle peut atteindre la valeur optimale ou rester en dessous selon ce départage."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/gametheory> ;
    skos:prefLabel "Myopic policy"@en,
        "Politique myope"@fr ;
    cursus:decimalPath "21.4" ;
    cursus:depth 1 ;
    cursus:hasCellCitation [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/GameTheory/GameTheory-22-Jeux-Stochastiques-Shapley-Python.ipynb> ;
