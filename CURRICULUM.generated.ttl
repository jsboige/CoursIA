    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/search> ;
    skos:definition "Reasoning about time with constraints, either qualitatively, through relations between intervals (Allen's algebra), or quantitatively, through numeric bounds on the gap between two time points (simple temporal problem, then with disjunctions)."@en,
        "Raisonner sur le temps par contraintes, de façon qualitative, par des relations entre intervalles (algèbre d'Allen), ou quantitative, par des bornes numériques sur l'écart entre deux instants (problème temporel simple, puis à disjonctions)."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/search> ;
    skos:prefLabel "Temporal constraint reasoning"@en,
        "Raisonnement temporel par contraintes"@fr ;
