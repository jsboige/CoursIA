    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/GameTheory/GameTheory-10-ForwardInduction-SPE-CSharp.ipynb>,
        <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/GameTheory/GameTheory-10-ForwardInduction-SPE-Python.ipynb> ;
    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/gametheory> ;
    skos:broader <https://github.com/jsboige/CoursIA/cursus/concept/257888b4-6a4d-4a55-9a03-ca2c448c6aa4> ;
    skos:definition "For finite games with perfect recall, extensive-form trembling-hand perfection implies sequential equilibrium, which implies subgame perfection, which implies Nash; normal-form perfection does not guarantee subgame perfection, and forward induction is not a link of this chain."@en,
        "Pour les jeux finis à mémoire parfaite, la perfection en mains tremblantes de la forme extensive implique l'équilibre séquentiel, qui implique la perfection en sous-jeux, qui implique Nash ; la perfection de la forme normale ne garantit pas la perfection en sous-jeux, et l'induction avant n'est pas un maillon de cette chaîne."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/gametheory> ;
    skos:prefLabel "Inclusion chain of refinements"@en,
        "Chaîne d'inclusion des raffinements"@fr ;
    cursus:decimalPath "9.7" ;
    cursus:depth 1 ;
    cursus:hasCellCitation [ a cursus:CellCitation ;
