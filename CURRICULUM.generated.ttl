    skos:broader <https://github.com/jsboige/CoursIA/cursus/concept/4d3852cf-8f62-4b38-b720-24315d402cfb> ;
    skos:definition "Local search that only accepts a successor with a strictly better heuristic value; when no immediate improvement exists, a breadth-first search looks for an improving state. Fast, but incomplete and with no optimality guarantee."@en,
        "Recherche locale qui n'accepte qu'un successeur de valeur heuristique strictement meilleure ; faute d'amélioration immédiate, une recherche en largeur cherche un état améliorant. Rapide, mais incomplète et sans garantie d'optimalité."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/planners> ;
    skos:prefLabel "Enforced hill climbing (EHC)"@en,
        "Enforced Hill Climbing (EHC)"@fr ;
