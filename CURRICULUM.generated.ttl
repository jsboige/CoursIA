    skos:broader <https://github.com/jsboige/CoursIA/cursus/concept/a9744f4b-3099-44ad-85ad-f8c5665b65f8> ;
    skos:definition "A solution dominates another if it is at least as good on every objective and strictly better on one of them. Dominated solutions are discarded without being explored; those that remain form the Pareto front."@en,
        "Une solution en domine une autre si elle est au moins aussi bonne sur tous les objectifs et strictement meilleure sur l'un d'eux. Les solutions dominées s'écartent sans être explorées ; celles qui restent forment le front de Pareto."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/search> ;
    skos:prefLabel "Dominance breaking and Pareto front"@en,
        "Élimination des solutions dominées (dominance, front de Pareto)"@fr ;
