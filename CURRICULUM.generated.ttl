        cursus:CurriculumConcept ;
    dct:identifier "0e9b31d5-4b3f-4963-9f16-09823c747e72" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/GameTheory/GameTheory-08-CombinatorialGames-CSharp.ipynb>,
        <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/GameTheory/GameTheory-08-CombinatorialGames-Python.ipynb> ;
    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/gametheory> ;
    skos:broader <https://github.com/jsboige/CoursIA/cursus/concept/b030b626-38f1-4c4d-863e-72c47ff33ecc> ;
    skos:definition "Every impartial game is equivalent to a Nim heap whose size is its Grundy value, and the value of a sum of games is the nim-sum of the values of its components."@en,
        "Tout jeu impartial équivaut à un tas de Nim de taille égale à sa valeur de Grundy, et la valeur d'une somme de jeux est la nim-somme des valeurs de ses composantes."@fr ;
