        cursus:CurriculumConcept ;
    dct:identifier "2fb0f263-bcaa-4240-be68-c473faf8233e" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/GameTheory/GameTheory-02-NormalForm-CSharp.ipynb>,
        <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/GameTheory/GameTheory-02-NormalForm-Part2-CSharp.ipynb>,
