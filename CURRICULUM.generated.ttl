    skos:broader <https://github.com/jsboige/CoursIA/cursus/concept/9bbdaca0-2c19-4a16-b026-6b828b4de84b> ;
    skos:definition "Placing in time tasks linked by precedences and consuming limited resources, to minimise total duration; the critical path gives a lower bound that resources sometimes prevent from being reached."@en,
        "Placer dans le temps des tâches liées par des précédences et consommant des ressources limitées, pour minimiser la durée totale ; le chemin critique en donne une borne inférieure que les ressources empêchent parfois d'atteindre."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/planners> ;
    skos:prefLabel "Resource-constrained scheduling (makespan, critical path)"@en,
        "Ordonnancement sous ressources (makespan, chemin critique)"@fr ;
