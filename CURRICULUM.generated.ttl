<https://github.com/jsboige/CoursIA/cursus/concept/3561f48e-dd10-4c97-9cce-8df5cf33a71c> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "3561f48e-dd10-4c97-9cce-8df5cf33a71c" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/GameTheory/GameTheory-22-Jeux-Stochastiques-Shapley-CSharp.ipynb>,
        <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/GameTheory/GameTheory-22-Jeux-Stochastiques-Shapley-Python.ipynb> ;
    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/gametheory> ;
    skos:broader <https://github.com/jsboige/CoursIA/cursus/concept/8eb90dfc-33a0-4584-ae3c-180c17d0366a> ;
    skos:definition "The dynamic value is that of the whole game, transitions included; it is obtained by iterating an operator that solves, at each state, the matrix game made of the current payoff and the discounted expectation of the next value, and Shapley's theorem guarantees a unique fixed point and convergence."@en,
        "La valeur dynamique est celle du jeu entier, transitions comprises ; on l'obtient en itérant un opérateur qui résout, à chaque état, le jeu matriciel formé du gain courant et de l'espérance actualisée de la valeur suivante, et le théorème de Shapley garantit un point fixe unique et la convergence."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/gametheory> ;
    skos:prefLabel "Dynamic value and value iteration"@en,
        "Valeur dynamique et itération de valeur"@fr ;
    cursus:decimalPath "21.2" ;
    cursus:depth 1 ;
    cursus:hasCellCitation [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/GameTheory/GameTheory-22-Jeux-Stochastiques-Shapley-Python.ipynb> ;
            cursus:cellId "c000cedf" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/GameTheory/GameTheory-22-Jeux-Stochastiques-Shapley-CSharp.ipynb> ;
