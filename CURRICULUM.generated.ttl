            cursus:cellId "48e72ae3" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-01-Fundamentals-CSharp.ipynb> ;
            cursus:cellId "f73333ce" ],
        [ a cursus:CellCitation ;
