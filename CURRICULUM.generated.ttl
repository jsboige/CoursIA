    cursus:depth 1 ;
    cursus:hasCellCitation [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Probas/Infer/Infer-03-Factor-Graphs.ipynb> ;
            cursus:cellId "gmwk6d9jwa8" ],
        [ a cursus:CellCitation ;
