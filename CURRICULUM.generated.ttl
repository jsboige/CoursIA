            cursus:cellId "6e98be9a" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/InformationCalcul/Compression/Compression-01-ShannonFano-Prefixe-CSharp.ipynb> ;
            cursus:cellId "6e98be9a" ] ;
    cursus:path "compression/codes-prefixes" .

<https://github.com/jsboige/CoursIA/cursus/concept/e1381ece-164a-4776-8713-8b1deaf2cf1c> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "e1381ece-164a-4776-8713-8b1deaf2cf1c" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-06-Hybridization-CSharp.ipynb>,
