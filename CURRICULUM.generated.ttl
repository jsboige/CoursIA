    skos:broader <https://github.com/jsboige/CoursIA/cursus/concept/a9744f4b-3099-44ad-85ad-f8c5665b65f8> ;
    skos:definition "Choosing the smallest number of subsets whose union covers all elements. In the notebooks, each sensor placed on a grid covers the 3 × 3 square around it and every point must be covered with as few sensors as possible; the number of candidate subsets doubles with each added sensor."@en,
        "Choisir le plus petit nombre de sous-ensembles dont la réunion couvre tous les éléments. Dans les carnets, chaque capteur posé sur une grille couvre le carré 3 × 3 qui l'entoure et il faut couvrir tous les points avec le moins de capteurs possible ; le nombre de sous-ensembles candidats double à chaque capteur ajouté."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/search> ;
    skos:prefLabel "Minimum set cover"@en,
        "Couverture minimale d'ensembles"@fr ;
