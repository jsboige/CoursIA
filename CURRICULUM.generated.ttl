<https://github.com/jsboige/CoursIA/cursus/concept/4aae8886-1c27-4720-a07c-a2fec104f589> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "4aae8886-1c27-4720-a07c-a2fec104f589" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/SymbolicAI/Planners/03-Advanced/Planners-07-OR-Tools-CSharp.ipynb> ;
