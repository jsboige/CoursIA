    skos:broader <https://github.com/jsboige/CoursIA/cursus/concept/a2a639d4-7836-46cd-8539-93f2916d1e52> ;
    skos:definition "Classical planning assumes a static and discrete environment, a fully observable state, and deterministic, instantaneous actions; lifting one of these assumptions leads to temporal, numeric or probabilistic planning."@en,
        "La planification classique suppose un environnement statique et discret, un état entièrement observable et des actions déterministes et instantanées ; lever l'une de ces hypothèses mène aux planifications temporelle, numérique ou probabiliste."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/planners> ;
    skos:prefLabel "Classical planning assumptions"@en,
        "Hypothèses de la planification classique"@fr ;
    cursus:decimalPath "1.4" ;
    cursus:depth 1 ;
    cursus:hasCellCitation [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/SymbolicAI/Planners/02-Classical/Planners-04-Fast-Downward-Python.ipynb> ;
            cursus:cellId "318fe463" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/SymbolicAI/Planners/01-Foundation/Planners-01-Introduction-Python.ipynb> ;
