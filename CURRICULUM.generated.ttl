<https://github.com/jsboige/CoursIA/cursus/concept/4ced2c69-54d6-4eab-96a1-c559fb285f79> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "4ced2c69-54d6-4eab-96a1-c559fb285f79" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-01-Fundamentals-CSharp.ipynb>,
