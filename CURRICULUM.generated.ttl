<https://github.com/jsboige/CoursIA/cursus/concept/042fe40f-8e5a-4672-b5db-cbd7a2a6f3ee> a skos:Concept,
        cursus:CurriculumConcept ;
    dct:identifier "042fe40f-8e5a-4672-b5db-cbd7a2a6f3ee" ;
    dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-04-Scheduling-CSharp.ipynb>,
