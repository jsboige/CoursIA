    rdfs:isDefinedBy <https://github.com/jsboige/CoursIA/cursus/taxonomy/probas> ;
    skos:definition "Normative framework for decision under uncertainty: a rational agent's preferences over uncertain outcomes are represented by a utility function whose expectation the agent maximises."@en,
        "Cadre normatif de la décision sous incertitude : les préférences d'un agent rationnel sur des issues incertaines se représentent par une fonction d'utilité dont il maximise l'espérance."@fr ;
    skos:inScheme <https://github.com/jsboige/CoursIA/cursus/scheme/probas> ;
    skos:prefLabel "Utility theory"@en,
        "Théorie de l'utilité"@fr ;
