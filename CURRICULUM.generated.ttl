            cursus:cellId "14e46c95" ],
        [ a cursus:CellCitation ;
            dct:source <https://github.com/jsboige/CoursIA/blob/main/MyIA.AI.Notebooks/Search/Part2-CSP/CSP-06-Hybridization-Python.ipynb> ;
            cursus:cellId "p9ea5852nb" ] ;
