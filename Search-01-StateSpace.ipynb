&nbsp;valider&nbsp;l'eta</span><span class="mtk8">t&nbsp;resultat</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;</span><span class="mtk6">None</span><span class="mtk1">&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;TODO&nbsp;etudiant</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk6">def</span><span class="mtk1">&nbsp;</span><span class="mtk15">transition</span><span class="mtk1">(</span><span class="mtk16">self</span><span class="mtk1">,&nbsp;</span><span class="mtk16">state</span><span class="mtk1">,&nbsp;</span><span class="mtk16">action</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;TODO&nbsp;etudiant&nbsp;:&nbsp;appliquer&nbsp;l'action&nbsp;(m,&nbsp;c)&nbsp;selon&nbsp;</span><span class="mtk8">la&nbsp;position&nbsp;du&nbsp;bateau</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;</span><span class="mtk6">None</span><span class="mtk1">&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;TODO&nbsp;etudiant</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk6">def</span><span class="mtk1">&nbsp;</span><span class="mtk15">is_goal</span><span class="mtk1">(</span><span class="mtk16">self</span><span class="mtk1">,&nbsp;</span><span class="mtk16">state</span><span class="mtk1">)&nbsp;-&gt;&nbsp;</span><span class="mtk14">bool</span><span class="mtk1">:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;TODO&nbsp;etudiant&nbsp;:&nbsp;verifier&nbsp;si&nbsp;tout&nbsp;le&nbsp;monde&nbsp;es