      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab colab colab" data-lang="notebook-python"><span><span class="mtk8">#&nbsp;Confier&nbsp;le&nbsp;graphe&nbsp;deja&nbsp;defini&nbsp;a&nbsp;networkx&nbsp;(sans&nbsp;d</span><span class="mtk8">upliquer&nbsp;les&nbsp;donnees)</span></span><br><span><span class="mtk1">G&nbsp;=&nbsp;nx.DiGraph()</span></span><br><span><span class="mtk19">for</span><span class="mtk1">&nbsp;city,&nbsp;neighbors&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;france_graph.items():</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;neighbor,&nbsp;dist&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;neighbors:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;G.add_edge(city,&nbsp;neighbor,&nbsp;weight=dist)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Dijkstra&nbsp;=&nbsp;UCS&nbsp;sur&nbsp;un&nbsp;graphe&nbsp;pondere&nbsp;a&nbsp;couts&nbsp;pos</span><span class="mtk8">itifs</span></span><br><span><span class="mtk1">path&nbsp;=&nbsp;nx.dijkstra_path(G,&nbsp;</span><span class="mtk21">'Bordeaux'</span><span class="mtk1">,&nbsp;</span><span class="mtk21">'Strasbourg'</span><span class="mtk1">,&nbsp;weight=</span><span class="mtk21">'weight'</span><span class="mtk1">)</span></span><br><span><span class="mtk1">length&nbsp;=&nbsp;nx.dijkstra_path_length(G,&nbsp;</span><span class="mtk21">'Bordeaux'</span><span class="mtk1">,&nbsp;</span><span class="mtk21">'Strasbourg'</span><span class="mtk1">,&nbsp;weight=</span><span class="mtk21">'weight'</span><span class="mtk1">)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"Chemin&nbsp;optimal&nbsp;(networkx)&nbsp;:&nbsp;</span><span class="mtk1">{</span><span class="mtk21">'&nbsp;-&gt;&nbsp;'</span><span class="mtk1">.join(path)}</span><span class="mtk21">"</span><span class="mtk1">)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"Distance&nbsp;totale&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:&nbsp;</span><span class="mtk1">{length}</span><span class="mtk21">&nbsp;km"</span><span class="mtk1">)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"Facteur&nbsp;de&nbsp;branchement&nbsp;&nbsp;&nbsp;&nbsp;:&nbsp;</span><span class="mtk1">{G.number_of_edges()&nbsp;/&nbsp;G.number_of_nodes()</span><span class="mtk12">:.2f</span><span class="mtk1">}</span><span class="mtk21">&nbsp;(</span><span class="mtk1">{G.number_of_edges()}</span><span class="mtk21">&nbsp;arcs&nbsp;/&nbsp;</span><span class="mtk1">{G.number_of_nodes()}</span><span class="mtk21">&nbsp;villes)"</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Centralite&nbsp;d'intermediarite&nbsp;:&nbsp;role&nbsp;structurel,&nbsp;m</span><span class="mtk8">esure&nbsp;que&nbsp;la&nbsp;stdlib&nbsp;ne&nbsp;sait&nbsp;pas&nbsp;calculer</span></span><br><span><span class="mtk1">centrality&nbsp;=&nbsp;nx.betweenness_centrality(G,&nbsp;weight=</span><span class="mtk21">'weight'</span><span class="mtk1">)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">()</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"Centralite&nbsp;d'intermediarite&nbsp;(top&nbsp;3)&nbsp;:"</span><span class="mtk1">)</span></span><br><span><span class="mtk19">for</span><span class="mtk1">&nbsp;city,&nbsp;c&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;</span><span class="mtk15">sorted</span><span class="mtk1">(centrality.items(),&nbsp;key=</span><span class="mtk6">lambda</span><span class="mtk1">&nbsp;kv:&nbsp;-kv[</span><span class="mtk12">1</span><span class="mtk1">])[:</span><span class="mtk12">3</span><span class="mtk1">]:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"&nbsp;&nbsp;</span><span class="mtk1">{city</span><span class="mtk12">:&lt;12</span><span class="mtk1">}</span><span class="mtk21">&nbsp;</span><span class="mtk1">{c</span><span class="mtk12">:.3f</span><span class="mtk1">}</span><span class="mtk21">"</span><span class="mtk1">)</span></span><br></pre><colab-read-only-cell-placeholder style="display: none;"><template shadowrootmode="open"><!----><div><!--?lit$134988617$-->Commencez à coder ou à <span tabindex="0" role="button" class="link">générer</span> avec l'IA.</div></template></colab-read-only-cell-placeholder></pre></div><colab-form class="formview vertical layout flex"><div class="widget-area"></div></colab-form></div>
