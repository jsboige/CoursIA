@prefix cursus: <https://github.com/jsboige/CoursIA/vocab/cursus#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cursus:NotebookShape a sh:NodeShape ;
    sh:targetClass cursus:Notebook ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path <http://purl.org/dc/terms/identifier> ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cursus:inSeries ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cursus:Series ] ;
    sh:property [ sh:path cursus:inSubseries ; sh:maxCount 1 ; sh:class cursus:Subseries ] ;
    sh:property [ sh:path cursus:requiresAPI ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path cursus:requiresGPU ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path cursus:requiresCloud ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path cursus:requiresWSL ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path cursus:estimatedDuration ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path cursus:status ; sh:maxCount 1 ; sh:datatype rdf:langString ] .

cursus:SeriesShape a sh:NodeShape ;
    sh:targetClass cursus:Series ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] .

cursus:SubseriesShape a sh:NodeShape ;
    sh:targetClass cursus:Subseries ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path cursus:subseriesPath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cursus:partOfSeries ; sh:maxCount 1 ; sh:class cursus:Series ] ;
    sh:property [ sh:path cursus:partOfSubseries ; sh:maxCount 1 ; sh:class cursus:Subseries ] ;
    sh:or ( [ sh:path cursus:partOfSeries ] [ sh:path cursus:partOfSubseries ] ) .

cursus:InterfaceShape a sh:NodeShape ;
    sh:targetClass cursus:Interface ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path <http://purl.org/dc/terms/identifier> ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cursus:interfaceClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:in ( "bridge" "cli" "mcp" ) ] ;
    sh:property [ sh:path cursus:invocation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path <http://purl.org/dc/terms/description> ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path cursus:exitSemantics ; sh:maxCount 1 ; sh:datatype xsd:string ] .

# Concepts de taxonomie fusionnés depuis --taxonomy-dir (#25001, #27635).
# cible CurriculumConcept : la contrainte sh:class sur requiresConcept est le
# témoin négatif — un prérequis qui vise un concept absent du graphe viole la
# forme. Cibles skos:Concept / skos:ConceptScheme : la couche fusionnée émet
# aussi les concepts typés SKOS avec leurs citations de cellules.
cursus:ConceptSchemeShape a sh:NodeShape ;
    sh:targetClass skos:ConceptScheme ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] .

cursus:ConceptShape a sh:NodeShape ;
    sh:targetClass cursus:CurriculumConcept ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path skos:definition ; sh:minCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cursus:requiresConcept ; sh:class cursus:CurriculumConcept ] .

cursus:SkosConceptShape a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:ConceptScheme ] ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path <http://purl.org/dc/terms/identifier> ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cursus:path ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cursus:decimalPath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cursus:depth ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path skos:broader ; sh:class skos:Concept ] ;
    sh:property [ sh:path cursus:hasCellCitation ; sh:class cursus:CellCitation ] .

cursus:CellCitationShape a sh:NodeShape ;
    sh:targetClass cursus:CellCitation ;
    sh:property [ sh:path cursus:cellId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path <http://purl.org/dc/terms/source> ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
