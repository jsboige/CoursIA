# Unite systemd de persistance du superviseur de runners Linux CoursIA.
# Deploiement po-2024 (2026-09-02, mission persistance #13378) : copie de
# reference -- l'original vit dans la distro Ubuntu de l'hote, sous
# /etc/systemd/system/coursia-runner.service (systemctl enable --now).
#
# Parametres machine : NAME_PREFIX (po-2024 -> myia-po-2024-linux-docker) et
# N slots vivent dans le wrapper coursia-runner-start.sh (N porte par
# l'argument ExecStart). Historique de dimensionnement : 8 -> 12 slots le
# 2026-09-09 (famine 682 en queue, marge CPU loadavg=0.08), ramene a 8 le
# 2026-09-22, puis a 6 le 2026-10-01 (#15574 item 3, arbitrage coordinateur
# comment 5933689033) : 6 x 3 vCPU = 18 vCPU docker, + 2 lean x 6 = 30 vCPU
# d'execution pour 16 disponibles -- le budget COURSIA_RUNNER_CPU_BUDGET=30
# du wrapper gardait cette somme. Le defaut wrapper (N=4) reste le filet --
# `start 6` ici etait l'intention explicite pour cette machine.
#
# 6 -> 4 LE 2026-10-08, ET LA RAISON EST MEMOIRE, PAS CPU. La VM WSL de cette
# machine est revenue a 24 032 Mo alors que la composition declaree totalisait
# 27 648 Mo de caps (6x1536 docker + 12x512 waiters + 2x6144 lean) : une somme
# de caps superieure a la RAM, payee en swap -- 104 GiB ecrits en moins de 11 h,
# DriveFS et la coordination de la flotte en premier. Les 4 slots ramenaient la
# composition a 21 504 Mo (2 528 Mo de marge) ; l'amendement J+7 du meme jour
# (lean 2 -> 1 slot) la porte a 15 360 Mo, marge 8 672 Mo.
#
# LE CAP UNITAIRE N'EST PAS TOUCHE (1536 Mo), et c'est mesure : 3 des 6
# conteneurs le touchaient a 99 %. C'est la CONCURRENCE qui ne tenait pas, pas
# la taille d'un job -- un job lourd garde exactement le meme regime memoire, il
# attend son tour au lieu de pousser la machine dans le swap.
#
# Le budget CPU suit mecaniquement : 4 x 3 + 2 lean x 6 faisait 24 ; l'amendement
# J+7 (verdict characterize_runner_variance.py --days 7 : 5 runners sur 6 au-dessus
# du seuil p90/mediane 5x) tranche 4 x 3 + 1 lean x 6 = 18, la valeur que porte
# desormais COURSIA_RUNNER_CPU_BUDGET dans les deux wrappers.
[Unit]
Description=CoursIA Linux runners supervisor (docker slots)
# #15095 : Requires+BindsTo INVERSE le choix Wants= de #14347 item 2. Le
# 07/09, docker.service arrete laissait ce service en Restart=always
# marteler docker run + fetch_token pour zero travail utile (2 gels machine
# sur ai-01 en 90 min : ecriture ext4.vhdx 94-96 Mo/s, load 69, iowait
# 37-63 %). Fail-closed desormais : docker tombe OU echoue au boot => le
# superviseur est ARRETE (propagation Requires+BindsTo), pas laisse a
# retenter. Retour du daemon = geste operateur explicite
# (systemctl start coursia-runner) -- l'hote prime sur la CI.
Requires=docker.service
BindsTo=docker.service
After=docker.service
# Borne de rafale au niveau unite (#15095) : 5 tentatives de demarrage par
# fenetre de 300 s, puis le service passe en failed et SORS de sa boucle de
# restart -- sans cette limite, Restart=always + daemon absent = la boucle
# infinie que l'incident a mesure, deplacee au niveau systemd.
StartLimitIntervalSec=300
StartLimitBurst=5
# En [Unit] et non en [Service] : deplacees en systemd 229 (acceptees en
# [Service] avec un avertissement). Une SEULE paire -- jamais deux blocs
# (union merge = directive dupliquee, test d'unicite #15166).

[Service]
Type=simple
ExecStart=/usr/local/bin/coursia-runner-start.sh start 4
ExecStop=/usr/local/bin/coursia-runner-start.sh stop
Restart=always
RestartSec=30
Nice=10
# ExecStop est gracieux (sentinel supervise.sh) : un job en vol va a son
# terme, ce qui peut prendre des dizaines de minutes sur un build Lean.
TimeoutStopSec=900

# #15091 : Nice=10 ci-dessus gouverne le CPU, et RIEN d autre. L I/O du parc
# n etait bornee par aucun plafond, ce qui a contribue aux gels par famine
# disque de ai-01 le 2026-09-07 (le pool d attente reclonait 1,14 GiB par job,
# 12 slots de front). IOWeight fait ceder le parc sous contention plutot que
# de le laisser rivaliser a poids egal avec le reste de la machine.
# Requiert cgroup v2 avec le controleur io delegue ; IOAccounting rend la
# consommation lisible dans systemctl status meme la ou le poids ne mord pas.
# Le plafond DUR de bande passante (IOWriteBandwidthMax) reste volontairement
# ABSENT DE CETTE UNITE, et c est toujours le cas depuis le 2026-10-08 : sur
# une unite, il ne bornerait que ce que le superviseur ecrit lui-meme (ses
# journaux), parce que les conteneurs sont ses NEVEUX -- nes dans le cgroup du
# daemon, pas dans le sien. Le plafond dur vit donc dans la slice, ou vivent
# les conteneurs : persist/po-2024/coursia-ci.slice porte IOWriteBandwidthMax /
# IOReadBandwidthMax, et COURSIA_RUNNER_CGROUP_PARENT y fait entrer les trois
# familles. La valeur y est reprise de la mesure d ai-01 sous charge plutot que
# devinee ici.
IOAccounting=yes
IOWeight=50

[Install]
WantedBy=multi-user.target
