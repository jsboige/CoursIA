# Unite systemd de persistance du superviseur de runners Linux CoursIA.
# Deploiement po-2024 (2026-09-02, mission persistance #13378) : copie de
# reference -- l'original vit dans la distro Ubuntu de l'hote, sous
# /etc/systemd/system/coursia-runner.service (systemctl enable --now).
#
# Parametres machine : NAME_PREFIX (po-2024 -> myia-po-2024-linux-docker) et
# N slots vivent dans le wrapper coursia-runner-start.sh (N porte par
# l'argument ExecStart). po-2024 est passe de 8 a 12 slots le 2026-09-09
# (mission P0 ai-01, msg-20260909T011024-jgamgp : famine 682 en queue / 10 in_progress,
# marge CPU mesuree nproc=16 loadavg=0.08 autorise 12 slots × 3 vCPU = 36 vCPU
# sur 16 nproc, overcommit 2.25× acceptable en pratique). Le defaut wrapper
# (N=4) reste le filet -- `start 12` ici est l'intention explicite pour cette
# machine, pas une dependance au defaut.
[Unit]
Description=CoursIA Linux runners supervisor (docker slots)
# #15095 : Requires+BindsTo INVERSE le choix Wants= de #14347 item 2. Le
# 07/09, docker.service arrete laissait ce service en Restart=always
# marteler docker run + fetch_token pour zero travail utile (2 gels machine
# sur ai-01 en 90 min : ecriture ext4.vhdx 94-96 Mo/s, load 69, iowait
# 37-63 %). Fail-closed desormais : docker tombe OU echoue au boot => le
# superviseur est ARRETE (propagation Requires+BindsTo), pas laisse a
# retenter. Retour du daemon = geste operateur explicite
# (systemctl start coursia-runner) -- l'hote prime sur la CI.
Requires=docker.service
BindsTo=docker.service
After=docker.service
# Borne de rafale au niveau unite (#15095) : 5 tentatives de demarrage par
# fenetre de 300 s, puis le service passe en failed et SORS de sa boucle de
# restart -- sans cette limite, Restart=always + daemon absent = la boucle
# infinie que l'incident a mesure, deplacee au niveau systemd.
StartLimitIntervalSec=300
StartLimitBurst=5
# En [Unit] et non en [Service] : deplacees en systemd 229 (acceptees en
# [Service] avec un avertissement). Une SEULE paire -- jamais deux blocs
# (union merge = directive dupliquee, test d'unicite #15166).

[Service]
Type=simple
ExecStart=/usr/local/bin/coursia-runner-start.sh start 12
ExecStop=/usr/local/bin/coursia-runner-start.sh stop
Restart=always
RestartSec=30
Nice=10
# ExecStop est gracieux (sentinel supervise.sh) : un job en vol va a son
# terme, ce qui peut prendre des dizaines de minutes sur un build Lean.
TimeoutStopSec=900

# #15091 : Nice=10 ci-dessus gouverne le CPU, et RIEN d autre. L I/O du parc
# n etait bornee par aucun plafond, ce qui a contribue aux gels par famine
# disque de ai-01 le 2026-09-07 (le pool d attente reclonait 1,14 GiB par job,
# 12 slots de front). IOWeight fait ceder le parc sous contention plutot que
# de le laisser rivaliser a poids egal avec le reste de la machine.
# Requiert cgroup v2 avec le controleur io delegue ; IOAccounting rend la
# consommation lisible dans systemctl status meme la ou le poids ne mord pas.
# Le plafond DUR de bande passante (IOWriteBandwidthMax) est volontairement
# laisse ouvert : il exige de nommer le device, et sa valeur doit sortir d une
# mesure sous charge, pas d une intuition -- question posee a roo-extensions.
IOAccounting=yes
IOWeight=50

[Install]
WantedBy=multi-user.target
