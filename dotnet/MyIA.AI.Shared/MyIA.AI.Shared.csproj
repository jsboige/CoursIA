<Project Sdk="Microsoft.NET.Sdk">

  <!-- MyIA.AI.Shared — socle partage .NET pour la pompe patrimoine Aricie (#7265).
       Skeleton initial (506f7ae93, 02/07/2026) net6.0 + HintPaths vers DLLs externes
       Aricie (external/AIMA/aima-core.dll, external/IKVM/IKVM.OpenJDK.Core.dll) qui ne
       sont PAS dans ce repo (0 .cs dans le projet, HintPaths casses => ne compilait pas).
       Fix : alignement net9.0 (convention repo, cf dotnet/GradeBookApp et MyIA.AI.Notebooks) +
       HintPaths casses deplaces en commentaire (ils ciblent du patrimoine a recuperer
       via #7265 B1-AIMA / IKVM Java-bridge, pas des refs vivantes). Les modules A-E
       ameneront leurs propres refs quand ils atterrissent (cf #7265 ordre A->E).
       PackageReferences Flee 2.0.0 + Newtonsoft.Json 13.0.3 = NuGet vivants, conserves. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MyIA.AI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flee" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- System.CodeDom : port A3 T1 (filtres metadata-driven, #19088). Les expressions
         CodeDom de IDescriptor vivent dans ce package sur net9 (plus dans le framework partage). -->
    <PackageReference Include="System.CodeDom" Version="8.0.0" />
  </ItemGroup>

  <!-- BuildInput de GoOnnxEvaluation est interne : son orientation exacte
       (ligne 0 = bas du goban, GoPoint) est un contrat des temoins tranche 8. -->
  <ItemGroup>
    <InternalsVisibleTo Include="MyIA.AI.Shared.Tests" />
  </ItemGroup>

  <!-- Organ FOL B2 tranche 2 (#24320) : Z3.Linq, l'organe reel du sous-module
       SymbolicAI/SMT/Z3.Linq (binaire .deploy, pas une reimplementation). Le pont
       FirstOrder ancre les quantificateurs sur le domaine fini et delegue la
       decision de satisfiabilite au solveur. Les HintPaths visent le .deploy du
       sous-module, epingle par son gitlink (a19c7480) : les DLLs vivent dans
       l'arbre du sous-module, elles ne sont pas recopiees dans ce depot-ci. -->
  <ItemGroup>
    <Reference Include="Z3.Linq">
      <HintPath>..\..\MyIA.AI.Notebooks\SymbolicAI\SMT\Z3.Linq\.deploy\Z3.Linq.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Z3">
      <HintPath>..\..\MyIA.AI.Notebooks\SymbolicAI\SMT\Z3.Linq\.deploy\Microsoft.Z3.dll</HintPath>
    </Reference>
    <Reference Include="ExpressionUtils">
      <HintPath>..\..\MyIA.AI.Notebooks\SymbolicAI\SMT\Z3.Linq\.deploy\ExpressionUtils.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- libz3.dll : binaire natif du solveur, copie a cote des assemblies pour
         que le chargement reussisse dans les tests comme dans les notebooks. -->
    <None Include="..\..\MyIA.AI.Notebooks\SymbolicAI\SMT\Z3.Linq\.deploy\libz3.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="libz3.dll"
          Visible="false" />
  </ItemGroup>

  <!-- References externes patrimoine Aricie (a recuperer via #7265) :
       <Reference Include="aima-core">
         <HintPath>..\external\AIMA\aima-core.dll</HintPath>
       </Reference>
       <Reference Include="IKVM.OpenJDK.Core">
         <HintPath>..\external\IKVM\IKVM.OpenJDK.Core.dll</HintPath>
       </Reference> -->

</Project>
