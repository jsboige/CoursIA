# Pile d'apprentissage CoursIA -- variables optionnelles.
# Copier en .env pour surcharger ; aucune valeur ci-dessous n'est un secret.

# Port JupyterLab publie sur l'hote (conteneur `learning`).
LEARNING_PORT=8888

# Port du service Fast Downward publie sur l'hote (profil `planners`).
PLANNER_PORT=8200

# Adresse de Fast Downward vue du conteneur d'apprentissage. Defaut : le nom
# de service Docker (profil `planners` actif). Sur une machine ou le service
# tourne hors pile, mettre l'URL correspondante, ex. http://127.0.0.1:8200.
FAST_DOWNWARD_URL=http://fast-downward:8200

# Fuseau horaire des conteneurs.
TZ=Europe/Paris
