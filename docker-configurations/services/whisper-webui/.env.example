# Whisper-WebUI - Configuration
# Copier vers .env et adapter les valeurs

# --- GPU ---
# Carte cible : index nvidia-smi, donc index PCI sous CUDA_DEVICE_ORDER=PCI_BUS_ID
# (0 = RTX 3080 Ti, 1 = RTX 3090) -- convention #28423.
# Le compose en derive device_ids, CUDA_VISIBLE_DEVICES et NVIDIA_VISIBLE_DEVICES.
# Les anciennes cles GPU_DEVICE_ID et CUDA_VISIBLE_DEVICES ne sont plus lues.
GPU_PCI_INDEX=1

# --- Ports ---
# Port externe (mappe vers 7860 dans le container)
WHISPER_PORT=36540

# --- Authentification Gradio ---
WHISPER_USER=admin
WHISPER_PASSWORD=

# --- Type Whisper ---
# Options: whisper, faster_whisper, insanely_fast_whisper
WHISPER_TYPE=insanely_fast_whisper

# --- Chemins modeles ---
# Par defaut: ./models (local au service)
# Pour reutiliser les modeles existants depuis WSL:
# WHISPER_MODELS_PATH=\\wsl.localhost\Ubuntu\home\jesse\whisper-webui\models
# WHISPER_CONFIGS_PATH=./configs
# WHISPER_OUTPUTS_PATH=../../shared/outputs/audio

# --- Timezone ---
TZ=Europe/Paris
