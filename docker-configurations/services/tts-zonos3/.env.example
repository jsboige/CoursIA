# Service TTS ZONOS3-Mini -- configuration d'environnement
#
# Copier en .env (gitignore) et adapter. Aucune valeur secrete n'est requise :
# les poids sont publics, et le serveur n'arme son filtre de jeton que si
# ZONOS3_ACCESS_TOKEN est defini.

# Port hote du serveur zonos3 (defaut 1919 : c'est le defaut du client
# v4/zonos3_client.py, ZONOS3_URL=http://localhost:1919).
ZONOS3_PORT=1919

# Repertoire hote qui contient backbone-ptq.gguf, zac-keep2.gguf,
# spk-encoder.gguf, steer.gguf et voices/ (voir fetch_models.py).
ZONOS3_MODELS_PATH=D:/hf-models/zonos3/gguf

# GPU reserve au service (1 = RTX 3090 sur ce siege).
ZONOS3_GPU_ID=1

# Largeur de batching du serveur (syntheses simultanees). Vide = defaut amont (8).
ZONOS3_BATCH=

# Jeton d'acces optionnel. Defini, le serveur rend l'API en 403 sauf
# « Authorization: Bearer <jeton> » (ou le cookie zonos3_access) : la sonde de
# sante et les clients doivent alors le presenter. Vide = aucune authentification,
# protection par la seule boucle locale de l'hote.
ZONOS3_ACCESS_TOKEN=

# Fuseau horaire des journaux.
TZ=Europe/Paris
