# FishAudio S2-Pro TTS Service Configuration
# Copy to .env and adjust values

# GPU Configuration
# Index nvidia-smi sous CUDA_DEVICE_ORDER=PCI_BUS_ID (0 = RTX 3080 Ti, 1 = RTX 3090).
# Le compose en derive device_ids, CUDA_VISIBLE_DEVICES et NVIDIA_VISIBLE_DEVICES.
# L'ancienne cle FISHAUDIO_GPU_ID n'est plus lue : elle ne portait pas d'ordre CUDA.
GPU_PCI_INDEX=1

# Host port
FISHAUDIO_PORT=8197

# Model checkpoints directory (downloaded from HuggingFace on first run)
CHECKPOINTS_PATH=./checkpoints

# Reference audio files for voice cloning
REFERENCES_PATH=./references

# HuggingFace token (for gated model download)
HUGGINGFACE_TOKEN=

# Timezone
TZ=Europe/Paris

# --- variante int4 (docker-compose.int4.yml) ---
# Checkpoint int4, relatif a CHECKPOINTS_PATH (sans --half).
# Cle propre a cette variante : le compose fp16 lit LLAMA_CHECKPOINT_PATH dans
# le meme .env (poids fp16), et la variante int4 partageait cette cle -- elle
# demarrait sur les poids fp16 sans le dire (mesure du 2026-11-28).
# Aucun defaut : le chargeur lit la taille de groupe dans le nom du dossier,
# qui porte donc le dateur de quantization -- remplacer <timestamp> par celui
# du dossier present sur le disque. Cle absente : compose refuse de demarrer.
FISHAUDIO_INT4_CHECKPOINT=checkpoints/fs-1.2-int4-g128-<timestamp>
# Decoder checkpoint + config (shared with the fp16 route; usually left as-is).
DECODER_CHECKPOINT_PATH=checkpoints/s2-pro/codec.pth
DECODER_CONFIG_NAME=modded_dac_vq
