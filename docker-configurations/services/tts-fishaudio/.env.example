# FishAudio S2-Pro TTS Service Configuration
# Copy to .env and adjust values

# GPU assignment (1 = RTX 3090 24GB)
FISHAUDIO_GPU_ID=1

# Host port
FISHAUDIO_PORT=8197

# Model checkpoints directory (downloaded from HuggingFace on first run)
CHECKPOINTS_PATH=./checkpoints

# Reference audio files for voice cloning
REFERENCES_PATH=./references

# HuggingFace token (for gated model download)
HUGGINGFACE_TOKEN=

# Timezone
TZ=Europe/Paris

# --- int4 variant (docker-compose.int4.yml) ---
# int4 quantized checkpoint, relative to CHECKPOINTS_PATH (no --half).
# Set to your actual int4 checkpoint directory name. The README's convention
# is fs-1.2-int4-g128-<timestamp> (the loader reads the groupsize from the
# name); the value below is the base name without the timestamp suffix.
LLAMA_CHECKPOINT_PATH=checkpoints/fs-1.2-int4-g128
# Decoder checkpoint + config (shared with the fp16 route; usually left as-is).
DECODER_CHECKPOINT_PATH=checkpoints/s2-pro/codec.pth
DECODER_CONFIG_NAME=modded_dac_vq
