# Configuration ComfyUI-Video
# Copiez ce fichier vers .env et adaptez les valeurs

# GPU Configuration
# GPU_DEVICE_ID designe la carte physique visee, par son index nvidia-smi
# (0 = 3080Ti 16GB, 1 = 3090 24GB ; l'ordre PCI_BUS_ID est fixe dans
# docker-compose.yml). CUDA_VISIBLE_DEVICES liste les cartes visibles de CUDA :
# c'est le seul reglage qui isole sous WSL2 (device_ids et
# NVIDIA_VISIBLE_DEVICES ne suffisent pas, mesure du 2026-11-24). Elle prend
# donc la meme valeur que la carte visee.
# Sans l'ordre PCI_BUS_ID, l'index CUDA 1 serait la 3080Ti.
# comfyui-qwen vise l'autre carte (GPU 0) : l'exclusivite entre les deux
# services est levee (decision #28423 §5).
GPU_DEVICE_ID=1
CUDA_VISIBLE_DEVICES=1
NVIDIA_VISIBLE_DEVICES=1

# Port externe (8189 pour ne pas confliter avec comfyui-qwen:8188)
COMFYUI_VIDEO_PORT=8189

# Workspace Path - repertoire ComfyUI sur le host
# Utilisez un workspace separe de comfyui-qwen pour eviter les conflits
COMFYUI_WORKSPACE_PATH=\\wsl.localhost\Ubuntu\home\jesse\SD\workspace\comfyui-video\ComfyUI

# API Keys for Model Downloads
CIVITAI_TOKEN=your_civitai_token_here
HF_TOKEN=hf_your_huggingface_token_here

# Authentification ComfyUI-Login
COMFYUI_LOGIN_ENABLED=true
COMFYUI_USERNAME=admin
# Centralisee dans .secrets/master.env (render_envs.py, #10985) - nom distinct
# par instance pour ne pas ecraser le mot de passe de comfyui-qwen
COMFYUI_VIDEO_PASSWORD=your_secure_password_here
COMFYUI_VIDEO_TOKEN=your_bearer_token_here

# Configuration CORS
CORS_ENABLED=true

# Timeout pour les requetes API (secondes) - plus long pour video
API_TIMEOUT=600

# System
TZ=Europe/Paris
