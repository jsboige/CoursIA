<tbody><tr>
<td><strong>Recherche non informee</strong></td>
<td>Exploration sans connaissance du domaine (pas d'heuristique)</td>
</tr>
<tr>
<td><strong>Frontiere</strong></td>
<td>Ensemble des noeuds generes mais pas encore explores</td>
</tr>
<tr>
<td><strong>Ensemble explore</strong></td>
<td>Noeuds déjà etendus (graph-search)</td>
</tr>
<tr>
<td><strong>Completude</strong></td>
<td>Garantie de trouver une solution si elle existe</td>
</tr>
<tr>
<td><strong>Optimalite</strong></td>
<td>Garantie de trouver la solution de cout minimal</td>
</tr>
</tbody></table>
