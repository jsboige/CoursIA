<td><span><span class="md-math" style=""></span><span class="MathJax" id="MathJax-Element-21-Frame" tabindex="0" style=""><nobr><span class="math" id="MathJax-Span-121" style="width: 4.17em; display: inline-block;"><span style="display: inline-block; position: relative; width: 3.419em; height: 0px; font-size: 122%;"><span style="position: absolute; clip: rect(3.35em, 1003.35em, 6.971em, -999.997em); top: -4.232em; left: 0em;"><span class="mrow" id="MathJax-Span-122"><span style="display: inline-block; position: relative; width: 3.419em; height: 0px;"><span style="position: absolute; clip: rect(3.145em, 1000.75em, 4.238em, -999.997em); top: -4.027em; left: 0em;"><span class="mi" id="MathJax-Span-123" style="font-family: MathJax_Math-italic;">O</span><span style="display: inline-block; width: 0px; height: 4.033em;"></span></span><span style="position: absolute; clip: rect(1.984em, 1003.35em, 4.512em, -999.997em); top: -1.704em; left: 0em;"><span class="mo" id="MathJax-Span-124" style="font-family: MathJax_Main;">(</span><span class="msubsup" id="MathJax-Span-125"><span style="display: inline-block; position: relative; width: 2.667em; height: 0px;"><span style="position: absolute; clip: rect(3.145em, 1000.41em, 4.238em, -999.997em); top: -4.027em; left: 0em;"><span class="mi" id="MathJax-Span-126" style="font-family: MathJax_Math-italic;">b</span><span style="display: inline-block; width: 0px; height: 4.033em;"></span></span><span style="position: absolute; top: -5.324em; left: 0.413em;"><span class="texatom" id="MathJax-Span-127"><span class="mrow" id="MathJax-Span-128"><span style="display: inline-block; position: relative; width: 2.121em; height: 0px;"><span style="position: absolute; clip: rect(3.282em, 1002.12em, 4.443em, -999.997em); top: -4.027em; left: 0em;"><span class="mn" id="MathJax-Span-129" style="font-size: 70.7%; font-family: MathJax_Main;">1</span><span class="mo" id="MathJax-Span-130" style="font-size: 70.7%; font-family: MathJax_Main;">+</span><span 