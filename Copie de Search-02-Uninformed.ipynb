      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab colab" data-lang="notebook-python"><span><span class="mtk8">#&nbsp;---&nbsp;Exercice&nbsp;2&nbsp;:&nbsp;Analyser&nbsp;l'ecart&nbsp;de&nbsp;cout&nbsp;entre&nbsp;</span><span class="mtk8">BFS&nbsp;et&nbsp;UCS&nbsp;---</span></span><br><span><span></span></span><br><span><span class="mtk6">def</span><span class="mtk1">&nbsp;</span><span class="mtk15">cout_chemin</span><span class="mtk1">(</span><span class="mtk16">graph</span><span class="mtk1">,&nbsp;</span><span class="mtk16">chemin</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"""Cout&nbsp;d'un&nbsp;chemin&nbsp;=&nbsp;somme&nbsp;des&nbsp;distances&nbsp;de&nbsp;ses&nbsp;a</span><span class="mtk21">retes&nbsp;(calcule,&nbsp;pas&nbsp;code&nbsp;en&nbsp;dur)."""</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;</span><span class="mtk15">sum</span><span class="mtk1">(graph[a][b]&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;a,&nbsp;b&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;</span><span class="mtk15">zip</span><span class="mtk1">(chemin,&nbsp;chemin[</span><span class="mtk12">1</span><span class="mtk1">:]))</span></span><br><span><span></span></span><br><span><span class="mtk6">def</span><span class="mtk1">&nbsp;</span><span class="mtk15">comparer</span><span class="mtk1">(</span><span class="mtk16">depart</span><span class="mtk1">,&nbsp;</span><span class="mtk16">arrivee</span><span class="mtk1">,&nbsp;</span><span class="mtk16">graph</span><span class="mtk1">=france_graph):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"""Execute&nbsp;BFS&nbsp;et&nbsp;UCS&nbsp;sur&nbsp;depart&nbsp;-&gt;&nbsp;arrivee&nbsp;et&nbsp;ren</span><span class="mtk21">voie&nbsp;(probleme,&nbsp;res_bfs,&nbsp;res_ucs)."""</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;probleme&nbsp;=&nbsp;GraphProblem(depart,&nbsp;arrivee,&nbsp;graph</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;probleme,&nbsp;breadth_first_search(probleme),&nbsp;uniform</span><span class="mtk1">_cost_search(probleme)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Etape&nbsp;0&nbsp;:&nbsp;chercher&nbsp;automatiquement&nbsp;les&nbsp;trajets&nbsp;o</span><span class="mtk8">u&nbsp;BFS&nbsp;et&nbsp;UCS&nbsp;divergent</span></span><br><span><span class="mtk1">divergents&nbsp;=&nbsp;[]</span></span><br><span><span class="mtk19">for</span><span class="mtk1">&nbsp;d&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;france_graph:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;a&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;france_graph:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">if</span><span class="mtk1">&nbsp;d&nbsp;!=&nbsp;a:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;_,&nbsp;rb,&nbsp;ru&nbsp;=&nbsp;comparer(d,&nbsp;a)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">if</span><span class="mtk1">&nbsp;rb.cost&nbsp;!=&nbsp;ru.cost:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;divergents.append((d,&nbsp;a,&nbsp;rb.cost,&nbsp;</span><span class="mtk1">ru.cost))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"</span><span class="mtk1">{</span><span class="mtk15">len</span><span class="mtk1">(divergents)}</span><span class="mtk21">&nbsp;trajets&nbsp;(sur&nbsp;</span><span class="mtk1">{</span><span class="mtk15">len</span><span class="mtk1">(france_graph)&nbsp;*&nbsp;(</span><span class="mtk15">len</span><span class="mtk1">(france_graph)&nbsp;-&nbsp;</span><span class="mtk12">1</span><span class="mtk1">)}</span><span class="mtk21">)&nbsp;"</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk6">f</span><span class="mtk21">"ou&nbsp;BFS&nbsp;et&nbsp;UCS&nbsp;trouvent&nbsp;des&nbsp;couts&nbsp;differents."</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Choix&nbsp;du&nbsp;trajet&nbsp;propose&nbsp;par&nbsp;l'indice&nbsp;:&nbsp;meme&nbsp;nomb</span><span class="mtk8">re&nbsp;d'etapes,&nbsp;cout&nbsp;different</span></span><br><span><span class="mtk1">depart_6&nbsp;=&nbsp;</span><span class="mtk21">'Rennes'</span></span><br><span><span class="mtk1">arrivee_6&nbsp;=&nbsp;</span><span class="mtk21">'Nice'</span></span><br><span><span></span></span><br><span><span class="mtk1">problem_6&nbsp;=&nbsp;GraphProblem(depart_6,&nbsp;arrivee_6,&nbsp;fran</span><span class="mtk1">ce_graph)</span></span><br><span><span class="mtk1">res_bfs_6&nbsp;=&nbsp;breadth_first_search(problem_6)</span></span><br><span><span class="mtk1">res_ucs_6&nbsp;=&nbsp;uniform_cost_search(problem_6)</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"\n===&nbsp;</span><span class="mtk1">{depart_6}</span><span class="mtk21">&nbsp;-&gt;&nbsp;</span><span class="mtk1">{arrivee_6}</span><span class="mtk21">&nbsp;==="</span><span class="mtk1">)</span></span><br><span><span class="mtk1">res_bfs_6.display()</span></span><br><span><span class="mtk1">res_ucs_6.display()</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Detail&nbsp;arete&nbsp;par&nbsp;arete&nbsp;des&nbsp;deux&nbsp;chemins</span></span><br><span><span class="mtk19">for</span><span class="mtk1">&nbsp;res&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;(res_bfs_6,&nbsp;res_ucs_6):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"\n</span><span class="mtk1">{res.algorithm}</span><span class="mtk21">&nbsp;:&nbsp;detail&nbsp;des&nbsp;aretes"</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;a,&nbsp;b&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;</span><span class="mtk15">zip</span><span class="mtk1">(res.path,&nbsp;res.path[</span><span class="mtk12">1</span><span class="mtk1">:]):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"&nbsp;&nbsp;</span><span class="mtk1">{a</span><span class="mtk12">:10s</span><span class="mtk1">}</span><span class="mtk21">&nbsp;-&gt;&nbsp;</span><span class="mtk1">{b</span><span class="mtk12">:10s</span><span class="mtk1">}</span><span class="mtk21">&nbsp;</span><span class="mtk1">{france_graph[a][b]</span><span class="mtk12">:4d</span><span class="mtk1">}</span><span class="mtk21">&nbsp;km"</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"&nbsp;&nbsp;</span><span class="mtk1">{</span><span class="mtk21">'Total'</span><span class="mtk12">:&lt;26s</span><span class="mtk1">}</span><span class="mtk21">&nbsp;</span><span class="mtk1">{cout_chemin(france_graph,&nbsp;res.path)</span><span class="mtk12">:4d</span><span class="mtk1">}</span><span class="mtk21">&nbsp;km"</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Verifications&nbsp;:&nbsp;les&nbsp;couts&nbsp;annonces&nbsp;par&nbsp;les&nbsp;algor</span><span class="mtk8">ithmes&nbsp;sont&nbsp;bien&nbsp;ceux&nbsp;des&nbsp;aretes</span></span><br><span><span class="mtk19">assert</span><span class="mtk1">&nbsp;res_bfs_6.cost&nbsp;==&nbsp;cout_chemin(france_graph,&nbsp;res_b</span><span class="mtk1">fs_6.path)</span></span><br><span><span class="mtk19">assert</span><span class="mtk1">&nbsp;res_ucs_6.cost&nbsp;==&nbsp;cout_chemin(france_graph,&nbsp;res_u</span><span class="mtk1">cs_6.path)</span></span><br><span><span class="mtk19">assert</span><span class="mtk1">&nbsp;res_ucs_6.cost&nbsp;&lt;=&nbsp;res_bfs_6.cost&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;UCS&nbsp;est&nbsp;optimal&nbsp;en&nbsp;cout</span></span><br><span><span></span></span><br><span><span class="mtk1">ecart&nbsp;=&nbsp;res_bfs_6.cost&nbsp;-&nbsp;res_ucs_6.cost</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"\nEcart&nbsp;:&nbsp;</span><span class="mtk1">{res_bfs_6.cost}</span><span class="mtk21">&nbsp;-&nbsp;</span><span class="mtk1">{res_ucs_6.cost}</span><span class="mtk21">&nbsp;=&nbsp;</span><span class="mtk1">{ecart}</span><span class="mtk21">&nbsp;km&nbsp;"</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk6">f</span><span class="mtk21">"(</span><span class="mtk1">{</span><span class="mtk12">100</span><span class="mtk1">&nbsp;*&nbsp;ecart&nbsp;/&nbsp;res_bfs_6.cost</span><span class="mtk12">:.1f</span><span class="mtk1">}</span><span class="mtk21">%&nbsp;de&nbsp;moins&nbsp;avec&nbsp;UCS),&nbsp;"</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk6">f</span><span class="mtk21">"pour&nbsp;</span><span class="mtk1">{</span><span class="mtk15">len</span><span class="mtk1">(res_bfs_6.path)&nbsp;-&nbsp;</span><span class="mtk12">1</span><span class="mtk1">}</span><span class="mtk21">&nbsp;vs&nbsp;</span><span class="mtk1">{</span><span class="mtk15">len</span><span class="mtk1">(res_ucs_6.path)&nbsp;-&nbsp;</span><span class="mtk12">1</span><span class="mtk1">}</span><span class="mtk21">&nbsp;etapes."</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Cas&nbsp;limite&nbsp;:&nbsp;trajet&nbsp;ou&nbsp;BFS&nbsp;et&nbsp;UCS&nbsp;trouvent&nbsp;le&nbsp;me</span><span class="mtk8">me&nbsp;chemin&nbsp;(pas&nbsp;d'ecart)</span></span><br><span><span class="mtk1">_,&nbsp;rb0,&nbsp;ru0&nbsp;=&nbsp;comparer(</span><span class="mtk21">'Bordeaux'</span><span class="mtk1">,&nbsp;</span><span class="mtk21">'Strasbourg'</span><span class="mtk1">)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"\nCas&nbsp;limite&nbsp;Bordeaux&nbsp;-&gt;&nbsp;Strasbourg&nbsp;:&nbsp;BFS&nbsp;=&nbsp;</span><span class="mtk1">{rb0.cost}</span><span class="mtk21">&nbsp;km,&nbsp;UCS&nbsp;=&nbsp;</span><span class="mtk1">{ru0.cost}</span><span class="mtk21">&nbsp;km&nbsp;"</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk6">f</span><span class="mtk21">"-&gt;&nbsp;</span><span class="mtk1">{</span><span class="mtk21">'meme&nbsp;cout'</span><span class="mtk1">&nbsp;</span><span class="mtk19">if</span><span class="mtk1">&nbsp;rb0.cost&nbsp;==&nbsp;ru0.cost&nbsp;</span><span class="mtk19">else</span><span class="mtk1">&nbsp;</span><span class="mtk21">'couts&nbsp;differents'</span><span class="mtk1">}</span><span class="mtk21">."</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"""</span></span><br><span><span class="mtk21">Explication&nbsp;:</span></span><br><span><span class="mtk21">-&nbsp;BFS&nbsp;minimise&nbsp;le&nbsp;NOMBRE&nbsp;d'etapes&nbsp;et&nbsp;ignore&nbsp;les&nbsp;di</span><span class="mtk21">stances.&nbsp;Ici&nbsp;les&nbsp;deux&nbsp;chemins&nbsp;ont&nbsp;5&nbsp;etapes&nbsp;:</span></span><br><span><span class="mtk21">&nbsp;&nbsp;pour&nbsp;BFS&nbsp;ils&nbsp;se&nbsp;valent,&nbsp;il&nbsp;garde&nbsp;simplement&nbsp;le&nbsp;p</span><span class="mtk21">remier&nbsp;trouve&nbsp;(ordre&nbsp;des&nbsp;voisins&nbsp;dans&nbsp;le&nbsp;graphe).</span></span><br><span><span class="mtk21">&nbsp;&nbsp;Il&nbsp;passe&nbsp;donc&nbsp;par&nbsp;Paris&nbsp;et&nbsp;Lyon&nbsp;:&nbsp;Nantes&nbsp;-&gt;&nbsp;Pari</span><span class="mtk21">s&nbsp;-&gt;&nbsp;Lyon&nbsp;-&gt;&nbsp;Marseille&nbsp;=&nbsp;385&nbsp;+&nbsp;465&nbsp;+&nbsp;315&nbsp;=&nbsp;1165&nbsp;km</span><span class="mtk21">.</span></span><br><span><span class="mtk21">-&nbsp;UCS&nbsp;developpe&nbsp;toujours&nbsp;le&nbsp;noeud&nbsp;de&nbsp;plus&nbsp;petit&nbsp;co</span><span class="mtk21">ut&nbsp;cumule&nbsp;g(n).&nbsp;Il&nbsp;prefere&nbsp;la&nbsp;route&nbsp;du&nbsp;sud-ouest</span></span><br><span><span class="mtk21">&nbsp;&nbsp;Nantes&nbsp;-&gt;&nbsp;Bordeaux&nbsp;-&gt;&nbsp;Toulouse&nbsp;-&gt;&nbsp;Marseille&nbsp;=&nbsp;34</span><span class="mtk21">0&nbsp;+&nbsp;245&nbsp;+&nbsp;405&nbsp;=&nbsp;990&nbsp;km,&nbsp;soit&nbsp;175&nbsp;km&nbsp;de&nbsp;moins.</span></span><br><span><span class="mtk21">-&nbsp;Les&nbsp;aretes&nbsp;exploitees&nbsp;par&nbsp;UCS&nbsp;(Nantes-Bordeaux&nbsp;3</span><span class="mtk21">40,&nbsp;Bordeaux-Toulouse&nbsp;245)&nbsp;sont&nbsp;courtes&nbsp;comparees</span></span><br><span><span class="mtk21">&nbsp;&nbsp;a&nbsp;Nantes-Paris&nbsp;385&nbsp;et&nbsp;Paris-Lyon&nbsp;465&nbsp;:&nbsp;un&nbsp;detour</span><span class="mtk21">&nbsp;par&nbsp;le&nbsp;sud-ouest,&nbsp;mais&nbsp;moins&nbsp;cher&nbsp;au&nbsp;total.</span></span><br><span><span class="mtk21">-&nbsp;Conclusion&nbsp;:&nbsp;quand&nbsp;les&nbsp;couts&nbsp;ne&nbsp;sont&nbsp;pas&nbsp;uniform</span><span class="mtk21">es,&nbsp;le&nbsp;nombre&nbsp;d'etapes&nbsp;ne&nbsp;mesure&nbsp;pas&nbsp;le&nbsp;cout.</span></span><br><span><span class="mtk21">&nbsp;&nbsp;Seul&nbsp;UCS&nbsp;garantit&nbsp;le&nbsp;chemin&nbsp;de&nbsp;cout&nbsp;minimal.</span></span><br><span><span class="mtk21">"""</span><span class="mtk1">)</span></span><br></pre><colab-read-only-cell-placeholder style="display: none;"><template shadowrootmode="open"><!----><div><!--?lit$560317306$-->Commencez à coder ou à <span tabindex="0" role="button" class="link">générer</span> avec l'IA.</div></template></colab-read-only-cell-placeholder></pre></div><colab-form class="formview vertical layout flex"><div class="widget-area"></div></colab-form></div>
