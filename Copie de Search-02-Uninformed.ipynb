      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab colab" data-lang="notebook-python"><span><span class="mtk8">#&nbsp;---&nbsp;Tableau&nbsp;récapitulatif&nbsp;et&nbsp;graphique&nbsp;---</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Tableau&nbsp;récapitulatif&nbsp;théorique</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"\nTableau&nbsp;récapitulatif&nbsp;des&nbsp;propriétés"</span><span class="mtk1">)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"="</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk12">85</span><span class="mtk1">)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"</span><span class="mtk1">{</span><span class="mtk21">'Algorithme'</span><span class="mtk12">:&lt;12</span><span class="mtk1">}</span><span class="mtk21">&nbsp;</span><span class="mtk1">{</span><span class="mtk21">'Complet?'</span><span class="mtk12">:&lt;12</span><span class="mtk1">}</span><span class="mtk21">&nbsp;</span><span class="mtk1">{</span><span class="mtk21">'Optimal?'</span><span class="mtk12">:&lt;15</span><span class="mtk1">}</span><span class="mtk21">&nbsp;"</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk6">f</span><span class="mtk21">"</span><span class="mtk1">{</span><span class="mtk21">'Temps'</span><span class="mtk12">:&lt;18</span><span class="mtk1">}</span><span class="mtk21">&nbsp;</span><span class="mtk1">{</span><span class="mtk21">'Espace'</span><span class="mtk12">:&lt;15</span><span class="mtk1">}</span><span class="mtk21">&nbsp;</span><span class="mtk1">{</span><span class="mtk21">'Frontiere'</span><span class="mtk12">:&lt;10</