span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;ax.plot([x1,&nbsp;x2],&nbsp;[y1,&nbsp;y2],&nbsp;</span><span class="mtk21">'k-'</span><span class="mtk1">,&nbsp;linewidth=</span><span class="mtk12">0.8</span><span class="mtk1">,&nbsp;alpha=</span><span class="mtk12">0.4</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;Dessiner&nbsp;les&nbsp;noeuds&nbsp;avec&nbsp;le&nbsp;numéro&nbsp;d'exploration</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;idx,&nbsp;node_name&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;</span><span class="mtk15">enumerate</span><span class="mtk1">(order):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">if</span><span class="mtk1">&nbsp;node_name&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;positions:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;x,&nbsp;y&nbsp;=&nbsp;positions[node_name]</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;circle&nbsp;=&nbsp;plt.Circle((x,&nbsp;y),&nbsp;</span><span class="mtk12">0.025</span><span class="mtk1">,&nbsp;color=color,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;ec=</span><span class="mtk21">'black'</span><span class="mtk1">,&nbsp;linewidth=</span><span class="mtk12">1</span><span class="mtk1">,&nbsp;zorder=</span><span class="mtk12">5</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&