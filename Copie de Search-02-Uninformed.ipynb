n</span><span class="mtk1">&nbsp;[</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;(axes[</span><span class="mtk12">0</span><span class="mtk1">],&nbsp;bfs_tree,&nbsp;</span><span class="mtk21">'#4169E1'</span><span class="mtk1">,&nbsp;</span><span class="mtk21">'BFS&nbsp;-&nbsp;Exploration&nbsp;par&nbsp;niveaux'</span><span class="mtk1">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;(axes[</span><span class="mtk12">1</span><span class="mtk1">],&nbsp;dfs_tree,&nbsp;</span><span class="mtk21">'#228B22'</span><span class="mtk1">,&nbsp;</span><span class="mtk21">'DFS&nbsp;-&nbsp;Exploration&nbsp;en&nbsp;profondeur'</span><span class="mtk1">),</span></span><br><span><span class="mtk1">]:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;order&nbsp;=&nbsp;result.explored_order</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;Creer&nbsp;les&nbsp;positions&nbsp;pour&nbsp;l'arbre</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;positions&nbsp;=&nbsp;{}</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;name&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;tree_graph:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;parts&nbsp;=&nbsp;name.split(</span><span class="mtk21">'_'</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;d&nbsp;=&nbsp;</span><span class="mtk14">int</span><span class="mtk1">(parts[</span><span class="mtk12">0</span><span class="mtk1">][</span><span class="mtk12">1</span><span class="mtk1">:])</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;i&nbsp;=&nbsp;</span><span class="mtk14">int</span><span class="mtk1">(parts[</span><span class="mtk12">1</span><span class="mtk1">])</span></span><br><span><spa