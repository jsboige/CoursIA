          <div class="markdown"><span><div class="text-cell-section-header layout horizontal center"><md-icon-button class="header-section-toggle" title="Réduire 1&nbsp;cellule enfant sous Exemple guide 3 : IDS avec suivi de memoire (appuyez sur &lt;Maj&gt; pour réduire aussi les sections dépendantes)" data-aria-label="Réduire 1&nbsp;cellule enfant sous Exemple guide 3 : IDS avec suivi de memoire (appuyez sur &lt;Maj&gt; pour réduire aussi les sections dépendantes)" value=""><template shadowrootmode="open" shadowrootdelegatesfocus><!----><button id="button" class="icon-button  standard " aria-label="Réduire 1&nbsp;cellule enfant sous Exemple guide 3 : IDS avec suivi de memoire (appuyez sur &lt;Maj&gt; pour réduire aussi les sections dépendantes)">
        <!--?lit$560317306$--><md-focus-ring part="focus-ring" for="button" aria-hidden="true"><template shadowrootmode="open"><!----></template></md-focus-ring>
        <!--?lit$560317306$--><md-ripple aria-hidden="true"><template shadowrootmode="open"><!----><div class="surface   "></div></template></md-ripple>
