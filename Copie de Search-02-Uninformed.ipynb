          <div class="markdown"><span><div class="text-cell-section-header layout horizontal center"><md-icon-button class="header-section-toggle" title="Réduire 0&nbsp;cellule enfant sous Interpretation - Graphiques comparatifs (appuyez sur &lt;Maj&gt; pour réduire aussi les sections dépendantes)" data-aria-label="Réduire 0&nbsp;cellule enfant sous Interpretation - Graphiques comparatifs (appuyez sur &lt;Maj&gt; pour réduire aussi les sections dépendantes)" style="display: none;" value=""><template shadowrootmode="open" shadowrootdelegatesfocus><!----><button id="button" class="icon-button  standard " aria-label="Réduire 0&nbsp;cellule enfant sous Interpretation - Graphiques comparatifs (appuyez sur &lt;Maj&gt; pour réduire aussi les sections dépendantes)">
        <!--?lit$560317306$--><md-focus-ring part="focus-ring" for="button" aria-hidden="true"><template shadowrootmode="open"><!----></template></md-focus-ring>
