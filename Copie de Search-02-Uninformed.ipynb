ass="mtk19">if</span><span class="mtk1">&nbsp;child.state&nbsp;</span><span class="mtk6">not</span><span class="mtk1">&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;explored:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;frontier.append(child)&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;Empiler&nbsp;(LIFO)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;max_frontier&nbsp;=&nbsp;</span><span class="mtk15">max</span><span class="mtk1">(max_frontier,&nbsp;</span><span class="mtk15">len</span><span class="mtk1">(frontier))</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;elapsed&nbsp;=&nbsp;(time.perf_counter()&nbsp;-&nbsp;start_time)&nbsp;*</span><span class="mtk1">&nbsp;</span><span class="mtk12">1000</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;SearchResult(</span><span class="mtk21">'DFS'</span><span class="mtk1">,&nbsp;</span><span class="mtk6">None</span><span class="mtk1">,&nbsp;nodes_expanded,&nbsp;nodes_generated,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;max_frontier,&nbsp;elapsed,&nbsp;exp</span><span class="mtk1">lored_order)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"Fonction&nbsp;depth_first_search&nbsp;definie&nbsp;(DFS)"</span><span class="mtk1">)</span></span><br></pre><colab-read-only-cell-placeholder style="display: none;"><template shadowrootmode="open"><!----><div><!--?lit$560317306$-->Commencez à coder ou à <span tabindex="0" role="button" class="link">générer</span> avec l'IA.</div></template></colab-read-only-cel