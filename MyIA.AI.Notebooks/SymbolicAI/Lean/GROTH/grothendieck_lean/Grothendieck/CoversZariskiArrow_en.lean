import Mathlib.AlgebraicGeometry.Sites.BigZariski

namespace Grothendieck.CoversZariskiArrow_en

open CategoryTheory Limits AlgebraicGeometry

universe u

/-!
## Section 1: the central bridge — arrow form ↔ test on the pullback target

The Zariski topology is the fundamental example of a Grothendieck
topology arising from a pretopology: `Scheme.zariskiPretopology :=
pretopology @IsOpenImmersion` (covering families are jointly
surjective families of open immersions), and `Scheme.zariskiTopology_eq`
identifies the generated topology. The arrow form
`J.Covers S f ↔ S.pullback f ∈ J Y` (Mathlib `covers_iff`) combines
with `Pretopology.mem_toGrothendieck` (membership in the generated
topology means containing a covering family) to give the concrete test:
`Covers S f` iff there exists a covering family of open immersions on
`Y` refining the pullback of `S` along `f`.
-/

/-- Central bridge: the arrow form for the Zariski topology is
    equivalent to the existential test on the pretopology of the target:
    `Scheme.zariskiTopology.Covers S f ↔ ∃ R ∈ Scheme.zariskiPretopology Y,
    R ≤ (S.pullback f).arrows`.
    Proof: `covers_iff` reduces to `S.pullback f ∈ zariskiTopology Y`,
    `zariskiTopology_eq` moves to `zariskiPretopology.toGrothendieck`,
    then `Pretopology.mem_toGrothendieck` identifies with the existence
    of a covering family `R` above the pullback. -/
theorem covers_iff_zariski {X Y : Scheme.{u}} (S : Sieve X) (f : Y ⟶ X) :
    Scheme.zariskiTopology.Covers S f ↔
      ∃ R ∈ Scheme.zariskiPretopology Y, R ≤ (S.pullback f).arrows := by
  rw [GrothendieckTopology.covers_iff, Scheme.zariskiTopology_eq]
  exact Pretopology.mem_toGrothendieck _ _ _

/-!
## Section 2: Zariski specificity — the open-cover characterization

This is the contribution absent from the generic level of Parts 52-54:
in the category of schemes, the Zariski pretopology comes from a
morphism property (`IsOpenImmersion`), and Mathlib characterizes
membership in the generated topology by the existence of a **concrete
cover** (`Scheme.Cover`, an indexed family of jointly surjective open
immersions) whose generated sieve refines `S`. In arrow form:
`Covers S f` iff an open cover of `Y` refines the pullback. This is
the formulation a geometer uses: covering a scheme means exhibiting an
open cover.
-/

/-- Zariski specificity (signature theorem): the arrow form for the
    Zariski topology is equivalent to the existence of a concrete open
    cover of the target:
    `Scheme.zariskiTopology.Covers S f ↔ ∃ 𝒰 : Y.Cover (precoverage
    IsOpenImmersion), Presieve.ofArrows 𝒰.X 𝒰.f ≤ S.pullback f`.
    Proof: `covers_iff` reduces to the pointwise level on `Y`, then
    `Scheme.mem_grothendieckTopology_iff` (Mathlib,
    `AlgebraicGeometry.Sites.Pretopology`) identifies membership with
    the existence of a `Scheme.Cover` by open immersions refining the
    sieve. -/
theorem covers_iff_exists_cover {X Y : Scheme.{u}} (S : Sieve X) (f : Y ⟶ X) :
    Scheme.zariskiTopology.Covers S f ↔
      ∃ 𝒰 : Scheme.Cover.{u} (Scheme.precoverage IsOpenImmersion) Y,
        Presieve.ofArrows 𝒰.X 𝒰.f ≤ S.pullback f := by
  rw [GrothendieckTopology.covers_iff]
  exact Scheme.mem_grothendieckTopology_iff (P := IsOpenImmersion)

/-!
## Section 3: base cases — covering families and the generated sieve

When the pretopology provides a family `R` of covering open immersions
on `X`, the sieve `Sieve.generate R` it generates covers. On the
identity, the pullback is trivial (`Sieve.pullback_id`) and `R` itself
is the witness (`Sieve.le_generate`). For a general arrow, the
refinement descends to `Y` via `pullbackArrows`, admitted in the
pretopology by the base-change stability axiom
(`Pretopology.pullbacks`); the commutation
`generate ∘ pullbackArrows = pullback ∘ generate`
(`Sieve.pullbackArrows_comm`) closes the goal.
-/

/-- Base case: if `R` is a family of covering open immersions of `X`
    (for `zariskiPretopology`), then the sieve it generates covers the
    identity:
    `Scheme.zariskiTopology.Covers (Sieve.generate R) (𝟙 X)`.
    Proof: `covers_iff_zariski` reduces to the existential test on
    `X`, `Sieve.pullback_id` trivializes the pullback, and `R` is its
    own witness by `Sieve.le_generate`. -/
theorem covers_zariski_of_mem {X : Scheme.{u}} {R : Presieve X}
    (hR : R ∈ Scheme.zariskiPretopology X) :
    Scheme.zariskiTopology.Covers (Sieve.generate R) (𝟙 X) := by
  rw [covers_iff_zariski, Sieve.pullback_id]
  exact ⟨R, hR, Sieve.le_generate R⟩

/-- Generalized base case: the coverage generated by `R` covers any
    arrow `f : Y ⟶ X`. Proof: the witness on `Y` is
    `R.pullbackArrows f`, admitted in the pretopology by
    `Pretopology.pullbacks` (base-change stability — the preimage of
    an open cover along a scheme arrow is an open cover), and
    `Sieve.pullbackArrows_comm` commutes generation and pullback. -/
theorem covers_zariski_of_mem_arrow {X Y : Scheme.{u}} (f : Y ⟶ X)
    {R : Presieve X} (hR : R ∈ Scheme.zariskiPretopology X) :
    Scheme.zariskiTopology.Covers (Sieve.generate R) f := by
  rw [covers_iff_zariski]
  refine ⟨R.pullbackArrows f, Scheme.zariskiPretopology.pullbacks f R hR, ?_⟩
  rw [← Sieve.generate_le_iff, Sieve.pullbackArrows_comm]

/-- Special case on the top sieve:
    `Scheme.zariskiTopology.Covers ⊤ f` for any arrow `f : Y ⟶ X`.
    Proof: the witness is `Presieve.singleton (𝟙 Y)`, admitted by the
    `Pretopology.has_isos` axiom (the identity is an isomorphism, hence
    a trivial open immersion), which dominates `⊤`. -/
theorem covers_zariski_top {X Y : Scheme.{u}} (f : Y ⟶ X) :
    Scheme.zariskiTopology.Covers (⊤ : Sieve X) f := by
  rw [covers_iff_zariski]
  exact ⟨Presieve.singleton (𝟙 Y), Scheme.zariskiPretopology.has_isos (𝟙 Y), by simp⟩

/-!
## Section 4: pointwise fallout

Specialization to the identity: covering along the identity is
equivalent to belonging to the topology — Mathlib's
`covering_iff_covers_id`, connected to `zariskiTopology` via
`zariskiTopology_eq`.
-/

/-- Pointwise fallout: covering along the identity is equivalent to
    belonging to the Zariski topology:
    `Scheme.zariskiTopology.Covers S (𝟙 X) ↔ S ∈ Scheme.zariskiTopology X`.
    Proof: `zariskiTopology_eq` moves to the pointwise level, then it
    is exactly `GrothendieckTopology.covering_iff_covers_id`. -/
theorem covers_iff_pullback_zariski {X : Scheme.{u}} (S : Sieve X) :
    Scheme.zariskiTopology.Covers S (𝟙 X) ↔ S ∈ Scheme.zariskiTopology X := by
  rw [Scheme.zariskiTopology_eq]
  exact (GrothendieckTopology.covering_iff_covers_id
    (J := Scheme.zariskiPretopology.toGrothendieck) S).symm

end Grothendieck.CoversZariskiArrow_en
