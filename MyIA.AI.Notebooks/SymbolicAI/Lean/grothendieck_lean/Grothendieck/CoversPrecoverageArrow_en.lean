import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck

namespace Grothendieck.CoversPrecoverageArrow_en

open CategoryTheory Precoverage

universe u v

/-!
## Section 1: the central bridge — arrow form ↔ inductive extension

The extension `Precoverage.toGrothendieck` starts from a precoverage
(family of covering presieves on each object) and saturates it into a
Grothendieck topology via the inductive closure `Saturate` with 4
constructors: `of` (base case of a precoverage), `top` (trivial case),
`pullback` (pullback stability — which is **inductive** here and not
an axiom as in `Coverage`), and `transitive` (local character). The
arrow form `J.toGrothendieck.Covers S f ↔ S.pullback f ∈ J.toGrothendieck Y`
reduces to the point level; `Precoverage.mem_toGrothendieck_iff`
identifies the point membership to `Saturate J Y (S.pullback f)`. The
bridge is immediate by rewriting, but **missing** in Mathlib in this form.

The difference with Part 52 (`Coverage` → `Grothendieck`) is that
`Precoverage.Saturate.pullback` appears as an **inductive constructor**,
so pullback stability is internal to the induction. This gives
`covers_iff_toGrothendieck` the same statement, but the underlying proof
structure is richer (the definition of `Saturate.pullback` must be
manipulated more directly).
-/

/-- Central bridge: the arrow form for the topology `J.toGrothendieck`
    (where `J : Precoverage C`) is equivalent to the inductive extension
    `Saturate`: `J.toGrothendieck.Covers S f ↔ Saturate J Y (S.pullback f)`.
    Proof: `covers_iff` reduces to `S.pullback f ∈ J.toGrothendieck Y`,
    then `Precoverage.mem_toGrothendieck_iff` identifies to
    `Saturate J Y (S.pullback f)`. -/
theorem covers_iff_toGrothendieck {C : Type u} [Category.{v} C]
    (J : Precoverage C) {X Y : C} (S : Sieve X) (f : Y ⟶ X) :
    J.toGrothendieck.Covers S f ↔ Saturate J Y (S.pullback f) := by
  rw [GrothendieckTopology.covers_iff]
  exact Precoverage.mem_toGrothendieck_iff.symm

/-!
## Section 2: base case — the constructor `Saturate.of`

When the precoverage is a family of morphisms to `X`, its generated
sieve covers the identity in the sense of `J.toGrothendieck` — this is
the base case of the inductive closure `Saturate` exported in arrow
form. Mathlib has `Precoverage.Saturate.of` at the point level, but
**not** the arrow form. `Precoverage.generate_mem_toGrothendieck` is the
point fall-out, but we export the bridge in arrow form here.
-/

/-- Base case: if `R ∈ J X` is a precoverage, then the sieve it
    generates covers the identity:
    `J.toGrothendieck.Covers (Sieve.generate R) (𝟙 X)`.
    Proof: we directly compute that `S.pullback (𝟙 X) = S` (via
    `Sieve.pullback_id`), so
    `J.toGrothendieck.Covers (Sieve.generate R) (𝟙 X) ↔ Saturate J X (Sieve.generate R)`
    by `covers_iff_toGrothendieck`. The right member is `Saturate.of X R hR`
    (the base constructor of `Saturate`). -/
theorem covers_toGrothendieck_of_of {C : Type u} [Category.{v} C]
    (J : Precoverage C) {X : C} {R : Presieve X} (hR : R ∈ J X) :
    J.toGrothendieck.Covers (Sieve.generate R) (𝟙 X) := by
  rw [covers_iff_toGrothendieck, Sieve.pullback_id]
  exact Saturate.of X R hR

/-- Generalized base case: the cover generated by `R` covers any arrow
    `f : Y ⟶ X`. Proof: `Saturate.pullback` propagates
    `Saturate J X (Sieve.generate R)` to the pullback along `f`, then
    `covers_iff_toGrothendieck` gives the arrow form. NB: in
    `Precoverage`, `Saturate.pullback` is an **inductive constructor**
    (not an axiom as in `Coverage`). -/
theorem covers_of_mem_toGrothendieck {C : Type u} [Category.{v} C]
    (J : Precoverage C) {X Y : C} (f : Y ⟶ X) {R : Presieve X} (hR : R ∈ J X) :
    J.toGrothendieck.Covers (Sieve.generate R) f := by
  rw [covers_iff_toGrothendieck]
  exact Saturate.pullback X (Sieve.generate R) (Saturate.of X R hR) Y f

/-- Particular case on the top sieve: `J.toGrothendieck.Covers ⊤ f` for
    any `f : Y ⟶ X`. Proof: `Saturate.top Y` provides `Saturate J Y ⊤`
    (the top is its own pullback along any arrow, and `Saturate.top` is
    valid for any `Y`); `covers_iff_toGrothendieck` gives the arrow form. -/
theorem covers_toGrothendieck_top {C : Type u} [Category.{v} C]
    (J : Precoverage C) {X Y : C} (f : Y ⟶ X) :
    J.toGrothendieck.Covers (⊤ : Sieve X) f := by
  rw [covers_iff_toGrothendieck]
  exact Saturate.top Y

/-!
## Section 3: point-level fall-out

Specialization on the identity: `J.toGrothendieck.Covers S (𝟙 X) ↔ S ∈
J.toGrothendieck X`. The bridge to point membership
`Precoverage.mem_toGrothendieck_iff` is immediate.
-/

/-- Point fall-out: for `J : Precoverage C`, covering along the
    identity is equivalent to belonging to the topology:
    `J.toGrothendieck.Covers S (𝟙 X) ↔ S ∈ J.toGrothendieck X ↔ Saturate J X S`.
    Proof: `Sieve.pullback_id` reduces to point, then
    `Precoverage.mem_toGrothendieck_iff` identifies to `Saturate J X S`. -/
theorem covers_iff_pullback_toGrothendieck {C : Type u} [Category.{v} C]
    (J : Precoverage C) {X : C} (S : Sieve X) :
    J.toGrothendieck.Covers S (𝟙 X) ↔ Saturate J X S := by
  rw [GrothendieckTopology.covers_iff, Sieve.pullback_id]
  exact Precoverage.mem_toGrothendieck_iff.symm

end Grothendieck.CoversPrecoverageArrow_en