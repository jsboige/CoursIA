  have hvB_21 : π 21 = 4 :=
    stepB_15 _ (mem_of_blockMap_eq π hKBB_0 (by decide)) (ne_of_value π h0 (by decide)) (ne_of_value π h1 (by decide)) (ne_of_value π h2 (by decide)) (ne_of_value π h3 (by decide)) (ne_of_value π h4 (by decide))
  apply Equiv.ext
