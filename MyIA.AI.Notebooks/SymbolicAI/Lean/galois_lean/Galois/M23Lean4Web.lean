theorem m23a_mem_M23Subgroup : m23a ∈ M23Subgroup :=
  Subgroup.subset_closure (by simp)

/-- The second generator belongs to the generated subgroup. -/
theorem m23b_mem_M23Subgroup : m23b ∈ M23Subgroup :=
