/--
If a permutation has a verified block-index certificate, then it sends every
listed block to a listed block.
-/
theorem forall_mem_blockMap_mem_of_blockMapAt (g : Perm23) (index : Fin 253 → Fin 253)
    (h : ∀ i : Fin 253, blockMap g (heptadAt i) = heptadAt (index i)) :
    ∀ B ∈ heptadList, blockMap g B ∈ heptads := by
  rw [List.forall_mem_iff_get]
  intro i
  obtain ⟨j, hget⟩ := exists_heptadAt_eq_get i
  rw [hget, h]
  exact heptadAt_mem (index j)

/--
A permutation preserves the candidate block set once both it and its inverse
have verified block-index certificates.
-/
theorem PreservesHeptads.of_blockMapAt (g : Perm23)
    (index invIndex : Fin 253 → Fin 253)
    (h : ∀ i : Fin 253, blockMap g (heptadAt i) = heptadAt (index i))
    (hinv : ∀ i : Fin 253, blockMap g⁻¹ (heptadAt i) = heptadAt (invIndex i)) :
    PreservesHeptads g :=
  ⟨forall_mem_blockMap_mem_of_blockMapAt g index h,
    forall_mem_blockMap_mem_of_blockMapAt g⁻¹ invIndex hinv⟩

theorem PreservesHeptads.one : PreservesHeptads (1 : Perm23) := by
  constructor <;> intro B hB
  · rw [blockMap_one]
    exact mem_heptads_of_mem_heptadList hB
  · change blockMap (1 : Perm23) B ∈ heptads
    rw [blockMap_one]
    exact mem_heptads_of_mem_heptadList hB

theorem PreservesHeptads.mul {g h : Perm23}
    (hg : PreservesHeptads g) (hh : PreservesHeptads h) :
    PreservesHeptads (g * h) := by
  constructor
  · intro B hB
    rw [blockMap_mul]
    have hhB : blockMap h B ∈ heptads := hh.1 B hB
    exact hg.1 (blockMap h B) (mem_heptadList_of_mem_heptads hhB)
  · intro B hB
    rw [show (g * h)⁻¹ = h⁻¹ * g⁻¹ by simp, blockMap_mul]
    have hgB : blockMap g⁻¹ B ∈ heptads := hg.2 B hB
    exact hh.2 (blockMap g⁻¹ B) (mem_heptadList_of_mem_heptads hgB)

theorem PreservesHeptads.inv {g : Perm23}
    (hg : PreservesHeptads g) : PreservesHeptads g⁻¹ := by
  constructor
  · exact hg.2
  · exact hg.1

/-- The first generator preserves the candidate block set. -/
theorem m23a_preserves_heptads : PreservesHeptads m23a :=
  PreservesHeptads.of_blockMapAt m23a m23aBlockIndex m23aInvBlockIndex
    m23a_blockMapAt m23aInv_blockMapAt

/-- The second generator preserves the candidate block set. -/
theorem m23b_preserves_heptads : PreservesHeptads m23b :=
  PreservesHeptads.of_blockMapAt m23b m23bBlockIndex m23bInvBlockIndex
    m23b_blockMapAt m23bInv_blockMapAt

/-- The third generator preserves the candidate block set. -/
theorem m23c_preserves_heptads : PreservesHeptads m23c :=
  PreservesHeptads.of_blockMapAt m23c m23cBlockIndex m23cInvBlockIndex
    m23c_blockMapAt m23cInv_blockMapAt

/-- Every element of the generated subgroup preserves the candidate block set. -/
theorem M23_preserves_heptads (g : M23) : PreservesHeptads g.1 := by
  exact Subgroup.closure_induction
    (p := fun x hx => PreservesHeptads x)
    (fun x hx => by
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl | rfl
      · exact m23a_preserves_heptads
      · exact m23b_preserves_heptads
      · exact m23c_preserves_heptads)
    PreservesHeptads.one
    (fun x y _ _ hx hy => PreservesHeptads.mul hx hy)
    (fun x _ hx => PreservesHeptads.inv hx)
    g.2

