/-!
# The stabilizer of the last point is the embedded M22

This file identifies the stabilizer of the point `22` in `M23` with the
embedded copy of the repo's `M22` and concludes that the point stabilizer is
a simple group of order `443520`.

Because the first two `M23` generators are by definition the `M22`
generators acting on `0,…,21` (fixing `22`), the embedding certificates are
trivial: `embedPerm m22a = m23a` and `embedPerm m22b = m23b` are checked by
`decide`, and the embedded `M22` is precisely the subgroup generated by
`m23a` and `m23b`.  The cardinality identification is then immediate from
`|M22| = 443520` (already proved in the `M22` layer) and
`|Stab 22| = 10200960 / 23 = 443520`.
-/

namespace Sporadic
namespace M23PointStabilizer

open M23Certificates M23Certificates.StabilizerChain

/-- The stabilizer of the last point `22` in the 23-point action. -/
def StabLast : Subgroup M23 :=
  MulAction.stabilizer M23 (22 : Fin 23)

/-! ## The stabilizer has order 443520 -/

theorem orbit_last_witness (x : Fin 23) :
    ∃ g : M23, g.1 (22 : Fin 23) = x :=
  ⟨Word.toM23 (levelOneWord x), by simpa using levelOneWord_maps_last_all x⟩

theorem orbit_last_eq_univ : MulAction.orbit M23 (22 : Fin 23) = Set.univ := by
  ext x
  constructor
  · intro _
    exact Set.mem_univ x
  · intro _
    obtain ⟨g, hg⟩ := orbit_last_witness x
    exact ⟨g, by simpa [Subgroup.smul_def, Equiv.Perm.smul_def] using hg⟩

theorem orbit_last_ncard : (MulAction.orbit M23 (22 : Fin 23)).ncard = 23 := by
  rw [orbit_last_eq_univ, Set.ncard_univ]
  simp

theorem card_M23_eq_23_mul_stabLast :
    Nat.card M23 = 23 * Nat.card StabLast := by
  classical
  rw [Nat.card_eq_fintype_card,
    ← MulAction.card_orbit_mul_card_stabilizer_eq_card_group M23 (22 : Fin 23)]
  rw [Set.fintypeCard_eq_ncard, orbit_last_ncard]
  rw [← Nat.card_eq_fintype_card (α := MulAction.stabilizer M23 (22 : Fin 23))]
  rfl

theorem card_stabLast : Nat.card StabLast = 443520 := by
  have h := card_M23_eq_23_mul_stabLast
  rw [M23Cardinality.card_M23] at h
  omega

/-! ## The embedding of the 22-point world -/

/-- `Fin 22` as the subtype of points of `Fin 23` below `22`. -/
def finTwentyTwoEquiv : Fin 22 ≃ {x : Fin 23 // x.val < 22} where
  toFun i := ⟨⟨i.val, Nat.lt_succ_of_lt i.isLt⟩, i.isLt⟩
  invFun x := ⟨x.1.val, x.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- The embedding of degree-22 permutations into degree-23 permutations,
fixing the last point. -/
def embedPerm : Perm22 →* Perm23 :=
  Equiv.Perm.extendDomainHom finTwentyTwoEquiv

theorem embedPerm_injective : Function.Injective embedPerm :=
  Equiv.Perm.extendDomainHom_injective finTwentyTwoEquiv

set_option maxRecDepth 400000 in
/-- The embedded first `M22` generator is the first `M23` generator. -/
theorem embedPerm_m22a : embedPerm m22a = m23a := by
  apply Equiv.ext
  decide

set_option maxRecDepth 400000 in
/-- The embedded second `M22` generator is the second `M23` generator. -/
theorem embedPerm_m22b : embedPerm m22b = m23b := by
  apply Equiv.ext
  decide

/-- The embedded copy of `M22` inside the degree-23 permutations. -/
def EmbeddedM22 : Subgroup Perm23 :=
  M22Subgroup.map embedPerm

theorem embeddedM22_eq_closure :
    EmbeddedM22 = Subgroup.closure ({m23a, m23b} : Set Perm23) := by
  rw [EmbeddedM22, M22Subgroup, MonoidHom.map_closure]
  congr 1
  rw [Set.image_insert_eq, Set.image_singleton, embedPerm_m22a, embedPerm_m22b]

/-- The embedded copy is isomorphic to `M22`. -/
noncomputable def embeddedM22Equiv : M22Subgroup ≃* EmbeddedM22 :=
  M22Subgroup.equivMapOfInjective embedPerm embedPerm_injective

theorem card_embeddedM22 : Nat.card EmbeddedM22 = Nat.card M22Subgroup := by
  rw [← Nat.card_congr embeddedM22Equiv.toEquiv]

theorem embeddedM22_le_M23Subgroup : EmbeddedM22 ≤ M23Subgroup := by
  rw [embeddedM22_eq_closure, Subgroup.closure_le]
  intro g hg
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with rfl | rfl
  · exact m23a_mem_M23Subgroup
  · exact m23b_mem_M23Subgroup

theorem fixes_last_of_mem_embeddedM22 {g : Perm23} (hg : g ∈ EmbeddedM22) :
    g 22 = 22 := by
  obtain ⟨p, _, rfl⟩ := Subgroup.mem_map.mp hg
  exact Equiv.Perm.extendDomain_apply_not_subtype p finTwentyTwoEquiv
    (by decide)

/-- The embedded `M22`, viewed as a subgroup of `M23`. -/
def EmbeddedM22InM23 : Subgroup M23 :=
  EmbeddedM22.subgroupOf M23Subgroup

noncomputable def embeddedInM23Equiv : EmbeddedM22InM23 ≃* EmbeddedM22 :=
  Subgroup.subgroupOfEquivOfLe embeddedM22_le_M23Subgroup

theorem embeddedInM23_le_stabLast : EmbeddedM22InM23 ≤ StabLast := by
  intro g hg
  have hfix : g.1 (22 : Fin 23) = 22 :=
    fixes_last_of_mem_embeddedM22 (Subgroup.mem_subgroupOf.mp hg)
  rw [StabLast, MulAction.mem_stabilizer_iff]
  simpa [Subgroup.smul_def, Equiv.Perm.smul_def] using hfix

/-! ## Closing the identification -/

theorem card_embeddedInM23 : Nat.card EmbeddedM22InM23 = 443520 := by
  rw [Nat.card_congr embeddedInM23Equiv.toEquiv, card_embeddedM22]
  exact card_M22

/-- The embedded `M22` is exactly the stabilizer of the last point. -/
theorem embeddedInM23_eq_stabLast : EmbeddedM22InM23 = StabLast := by
  apply SetLike.coe_injective
  apply Set.eq_of_subset_of_ncard_le
  · exact embeddedInM23_le_stabLast
  · rw [← Nat.card_coe_set_eq, ← Nat.card_coe_set_eq]
    rw [SetLike.coe_sort_coe, SetLike.coe_sort_coe]
    rw [card_stabLast, card_embeddedInM23]
  · exact Set.toFinite _

/-- The stabilizer of the last point is isomorphic to `M22`. -/
noncomputable def stabLastEquivM22 : StabLast ≃* M22Subgroup :=
  ((MulEquiv.subgroupCongr embeddedInM23_eq_stabLast).symm.trans
    embeddedInM23Equiv).trans embeddedM22Equiv.symm

/-- The stabilizer of the last point is a simple group. -/
theorem isSimpleGroup_stabLast : IsSimpleGroup StabLast := by
  haveI := simple_M22
  exact stabLastEquivM22.isSimpleGroup

end M23PointStabilizer
