  | 9 => [Gen.a, Gen.b, Gen.aInv]
  | 10 => [Gen.a]
  | 11 => [Gen.b, Gen.aInv, Gen.bInv]
  | 12 => [Gen.b]
  | 13 => [Gen.b, Gen.b]
  | 14 => [Gen.aInv]
  | 15 => [Gen.bInv, Gen.a]
  | 16 => [Gen.b, Gen.aInv]
  | 17 => [Gen.a, Gen.bInv]
  | 18 => [Gen.a, Gen.a]
  | 19 => [Gen.a, Gen.b]
  | 20 => [Gen.bInv, Gen.bInv]
