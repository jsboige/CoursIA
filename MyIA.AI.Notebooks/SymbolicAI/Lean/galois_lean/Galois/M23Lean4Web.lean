/-!
# Simplicity of M23

The classical point-stabilizer argument, with a new twist for the regular
case:

Let `N` be a nontrivial normal subgroup of `M23` and `S` the stabilizer of
the point `22` (the embedded `M22`, simple by `simple_M22`).

1. Two-transitivity word certificates make `N` transitive on the 23 points.
2. Orbit-stabilizer: `|N| = 23 * |N ∩ S|`.
3. `N ∩ S ⊴ S` and `S` is simple, so `N ∩ S = ⊥` or `S ≤ N`.
4. If `S ≤ N`: `|N| = 23 * 443520 = 10200960 = |M23|`, so `N = ⊤`.
5. If `N ∩ S = ⊥`: `|N| = 23` is prime, so the `M12`/`M22` route (Cauchy
   with two different prime orders) is unavailable.  Instead: `N = ⟨z⟩` for
   an element `z` of order 23, and conjugation by the order-5 generator
   `m23a` sends `z` to `z^j` with `j^5 ≡ 1 (mod 23)`; a `decide` certificate
   pins `j = 1`, so `m23a` centralizes the transitive subgroup `N` while
   fixing `22` — forcing `m23a = 1`, a contradiction.
-/

namespace Sporadic
namespace M23Simplicity

open M23Certificates
open M23Certificates.StabilizerChain
open M23PointStabilizer

/-! ## Permutation helpers -/

theorem perm_apply_inv_self (f : Perm23) (x : Fin 23) : f (f⁻¹ x) = x :=
  Equiv.Perm.eq_inv_iff_eq.mp rfl

theorem perm_inv_apply_self (f : Perm23) (x : Fin 23) : f⁻¹ (f x) = x :=
  Equiv.Perm.inv_eq_iff_eq.mpr rfl

/-! ## Two-transitivity certificates -/

theorem pair_witness_from_base (x y : Fin 23) (hxy : x ≠ y) :
    ∃ g : M23, g.1 22 = x ∧ g.1 0 = y := by
  classical
  set A := Word.toM23 (levelOneWord x) with hA
  have hA22 : A.1 (22 : Fin 23) = x := by
    simpa [hA] using levelOneWord_maps_last_all x
  set z := A.1⁻¹ y with hzdef
  have hz22 : z ≠ 22 := by
    intro h
    apply hxy
    have : y = A.1 (22 : Fin 23) := by
      rw [← h, hzdef, perm_apply_inv_self]
    rw [this, hA22]
  set B := Word.toM23 (levelTwoWord z) with hB
  have hBfix : B.1 (22 : Fin 23) = 22 := by
    simpa [hB] using levelTwoWord_fixes_last_all z hz22
  have hBzero : B.1 (0 : Fin 23) = z := by
    simpa [hB] using levelTwoWord_maps_zero_all z hz22
  refine ⟨A * B, ?_, ?_⟩
  · change (A.1 * B.1) 22 = x
    rw [Equiv.Perm.mul_apply, hBfix, hA22]
  · change (A.1 * B.1) 0 = y
    rw [Equiv.Perm.mul_apply, hBzero, hzdef, perm_apply_inv_self]

theorem pair_witness (p q u v : Fin 23) (hpq : p ≠ q) (huv : u ≠ v) :
    ∃ g : M23, g.1 p = u ∧ g.1 q = v := by
  obtain ⟨g1, h1p, h1q⟩ := pair_witness_from_base p q hpq
  obtain ⟨g2, h2u, h2v⟩ := pair_witness_from_base u v huv
  have hinvp : g1.1⁻¹ p = 22 := by
    rw [← h1p, perm_inv_apply_self]
  have hinvq : g1.1⁻¹ q = 0 := by
    rw [← h1q, perm_inv_apply_self]
  refine ⟨g2 * g1⁻¹, ?_, ?_⟩
  · change (g2.1 * g1.1⁻¹) p = u
    rw [Equiv.Perm.mul_apply, hinvp, h2u]
  · change (g2.1 * g1.1⁻¹) q = v
    rw [Equiv.Perm.mul_apply, hinvq, h2v]

/-! ## Transitivity of nontrivial normal subgroups -/

theorem exists_moved_of_ne_bot (N : Subgroup M23) (hbot : N ≠ ⊥) :
    ∃ n ∈ N, ∃ p : Fin 23, n.1 p ≠ p := by
  by_contra h
  push Not at h
  apply hbot
  rw [eq_bot_iff]
  intro n hn
  rw [Subgroup.mem_bot]
  apply Subtype.ext
  apply Equiv.ext
  intro p
  simpa using h n hn p

theorem normal_orbit_witness (N : Subgroup M23) (hN : N.Normal)
    {n : M23} (hnN : n ∈ N) {p : Fin 23} (hp : n.1 p ≠ p) (u v : Fin 23) :
    ∃ m ∈ N, m.1 u = v := by
  by_cases huv : u = v
  · exact ⟨1, N.one_mem, by simp [huv]⟩
  · obtain ⟨g, hgp, hgq⟩ := pair_witness p (n.1 p) u v (Ne.symm hp) huv
    refine ⟨g * n * g⁻¹, hN.conj_mem n hnN g, ?_⟩
    have hinv : g.1⁻¹ u = p := by
      rw [← hgp, perm_inv_apply_self]
    change (g.1 * n.1 * g.1⁻¹) u = v
    rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hinv, hgq]

theorem normal_orbit_last_eq_univ (N : Subgroup M23) (hN : N.Normal)
    {n : M23} (hnN : n ∈ N) {p : Fin 23} (hp : n.1 p ≠ p) :
    MulAction.orbit N (22 : Fin 23) = Set.univ := by
  ext x
  constructor
  · intro _
    exact Set.mem_univ x
  · intro _
    obtain ⟨m, hmN, hmx⟩ := normal_orbit_witness N hN hnN hp 22 x
    exact ⟨⟨m, hmN⟩, by simpa [Subgroup.smul_def, Equiv.Perm.smul_def] using hmx⟩

/-! ## Orbit-stabilizer for the normal subgroup -/

theorem card_normal_eq_23_mul_stab (N : Subgroup M23)
    (horbit : MulAction.orbit N (22 : Fin 23) = Set.univ) :
    Nat.card N = 23 * Nat.card (MulAction.stabilizer N (22 : Fin 23)) := by
  classical
  rw [Nat.card_eq_fintype_card,
    ← MulAction.card_orbit_mul_card_stabilizer_eq_card_group N (22 : Fin 23)]
  rw [Set.fintypeCard_eq_ncard, horbit, Set.ncard_univ]
  rw [← Nat.card_eq_fintype_card (α := MulAction.stabilizer N (22 : Fin 23))]
  simp

/-- The stabilizer of `22` inside `N` matches `N` viewed inside `StabLast`. -/
def stabInNEquiv (N : Subgroup M23) :
    MulAction.stabilizer N (22 : Fin 23) ≃* (N.subgroupOf StabLast) where
  toFun g :=
    ⟨⟨g.1.1, by
      rw [StabLast, MulAction.mem_stabilizer_iff]
      have hg := MulAction.mem_stabilizer_iff.mp g.2
      simpa [Subgroup.smul_def] using hg⟩,
    Subgroup.mem_subgroupOf.mpr g.1.2⟩
  invFun g :=
    ⟨⟨g.1.1, Subgroup.mem_subgroupOf.mp g.2⟩, by
      rw [MulAction.mem_stabilizer_iff]
      have hg := MulAction.mem_stabilizer_iff.mp g.1.2
      simpa [Subgroup.smul_def] using hg⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl

theorem card_stabInN_eq (N : Subgroup M23) :
    Nat.card (MulAction.stabilizer N (22 : Fin 23)) =
      Nat.card (N.subgroupOf StabLast) :=
  Nat.card_congr (stabInNEquiv N).toEquiv

/-! ## Certificates for the regular case -/

set_option maxRecDepth 40000 in
/-- The first generator has order dividing 5. -/
theorem m23a_pow_five : m23a ^ 5 = 1 := by
  decide

set_option maxRecDepth 40000 in
/-- The first generator fixes the base point `22`. -/
theorem m23a_fixes_last : m23a (22 : Fin 23) = 22 := by
  decide

set_option maxRecDepth 20000 in
theorem m23a_ne_one : m23a ≠ 1 := by
  intro h
  have h0 : m23a (0 : Fin 23) = 0 := by
    rw [h]
    rfl
  exact absurd h0 (by decide)

set_option maxRecDepth 40000 in
/-- Arithmetic pin: the only `j < 23` with `j^5 ≡ 1 (mod 23)` is `j = 1`
(the multiplicative group mod 23 has order 22, coprime to 5). -/
theorem pow_five_mod_pin :
    ∀ j : Fin 23, 1 % 23 = (j : ℕ) ^ 5 % 23 → (j : ℕ) = 1 := by
  decide

/-- The first generator as an element of `M23`. -/
def aM : M23 := ⟨m23a, m23a_mem_M23Subgroup⟩

theorem aM_pow_five : aM ^ 5 = 1 := by
  apply Subtype.ext
  rw [SubgroupClass.coe_pow, OneMemClass.coe_one]
  exact m23a_pow_five

/-- Conjugation distributes over powers. -/
theorem conj_pow' (a z : M23) (n : ℕ) :
    (a * z * a⁻¹) ^ n = a * z ^ n * a⁻¹ := by
  induction n with
  | zero => simp
  | succ m ih =>
    rw [pow_succ, pow_succ, ih]
    group

/-! ## The regular case is impossible -/

/--
A normal subgroup of order 23 that is transitive from the base point `22`
is impossible: it is generated by an element `z` of order 23, conjugation
by the order-5 element `m23a` fixes `z` (since `j^5 ≡ 1 (mod 23)` forces
`j = 1`), and then `m23a` centralizes the transitive group `N` while fixing
`22`, hence is the identity — contradiction.
-/
theorem regular_case_absurd (N : Subgroup M23) (hN : N.Normal)
    (hcard : Nat.card N = 23)
    (htrans : ∀ x : Fin 23, ∃ n ∈ N, n.1 (22 : Fin 23) = x) : False := by
  classical
  haveI : Fintype N := Fintype.ofFinite N
  haveI : Fact (Nat.Prime 23) := ⟨by decide⟩
  have hF : Fintype.card N = 23 := by
    rw [← Nat.card_eq_fintype_card, hcard]
  obtain ⟨z0, hz0⟩ :=
    exists_prime_orderOf_dvd_card (G := N) 23 (by rw [hF])
  have hzM : orderOf (z0.1 : M23) = 23 := by
    have h := orderOf_injective N.subtype N.subtype_injective z0
    rw [hz0] at h
    exact h
  set zM : M23 := z0.1 with hzMdef
  have hzmem : zM ∈ N := z0.2
  -- `N` is exactly the cyclic group on `zM`
  have hle : Subgroup.zpowers zM ≤ N := Subgroup.zpowers_le.mpr hzmem
  have hzcard : Nat.card (Subgroup.zpowers zM) = 23 := by
    rw [Nat.card_zpowers, hzM]
  have hzpow_eq : Subgroup.zpowers zM = N := by
    apply SetLike.coe_injective
    apply Set.eq_of_subset_of_ncard_le
    · exact hle
    · rw [← Nat.card_coe_set_eq, ← Nat.card_coe_set_eq,
        SetLike.coe_sort_coe, SetLike.coe_sort_coe, hcard, hzcard]
    · exact Set.toFinite _
  -- the conjugate of `zM` by `aM` is a power `zM ^ j` with `j < 23`
  have hconj_mem : aM * zM * aM⁻¹ ∈ Subgroup.zpowers zM := by
    rw [hzpow_eq]
    exact hN.conj_mem zM hzmem aM
  have hconj_pow : ∃ j : ℕ, j < 23 ∧ zM ^ j = aM * zM * aM⁻¹ := by
    have hmem' : aM * zM * aM⁻¹ ∈ Submonoid.powers zM :=
      mem_powers_iff_mem_zpowers.mpr hconj_mem
    rw [Submonoid.mem_powers_iff] at hmem'
    obtain ⟨j0, hj0⟩ := hmem'
    refine ⟨j0 % 23, Nat.mod_lt _ (by norm_num), ?_⟩
    calc zM ^ (j0 % 23) = zM ^ (j0 % orderOf zM) := by rw [hzM]
      _ = zM ^ j0 := pow_mod_orderOf zM j0
      _ = aM * zM * aM⁻¹ := hj0
  obtain ⟨j, hjlt, hj⟩ := hconj_pow
  -- iterating conjugation five times returns to `zM`
  have hchain : ∀ k : ℕ, aM ^ k * zM * (aM ^ k)⁻¹ = zM ^ j ^ k := by
    intro k
    induction k with
    | zero => simp
    | succ m ih =>
      have hstep : aM ^ (m + 1) * zM * (aM ^ (m + 1))⁻¹
          = aM * (aM ^ m * zM * (aM ^ m)⁻¹) * aM⁻¹ := by
        rw [pow_succ']
        group
      calc aM ^ (m + 1) * zM * (aM ^ (m + 1))⁻¹
          = aM * (aM ^ m * zM * (aM ^ m)⁻¹) * aM⁻¹ := hstep
        _ = aM * zM ^ j ^ m * aM⁻¹ := by rw [ih]
        _ = (aM * zM * aM⁻¹) ^ j ^ m := (conj_pow' aM zM (j ^ m)).symm
        _ = (zM ^ j) ^ j ^ m := by rw [hj]
        _ = zM ^ (j * j ^ m) := by rw [← pow_mul]
        _ = zM ^ j ^ (m + 1) := by rw [pow_succ']
  have h5 : zM ^ (1 : ℕ) = zM ^ j ^ 5 := by
    have h := hchain 5
    rw [aM_pow_five] at h
    simpa using h
  -- pin the exponent to `j = 1`
  have hmod : (1 : ℕ) ≡ j ^ 5 [MOD 23] := by
    have h := pow_eq_pow_iff_modEq.mp h5
    rwa [hzM] at h
  have hj1 : j = 1 := by
    have harg : 1 % 23 = (j : ℕ) ^ 5 % 23 := hmod
    exact pow_five_mod_pin ⟨j, hjlt⟩ harg
  -- so `aM` commutes with `zM`, hence with all of `N`
  have hcomm : Commute aM zM := by
    have hz1 : zM = aM * zM * aM⁻¹ := by
      have := hj
      rwa [hj1, pow_one] at this
    have h' : aM * zM = zM * aM := by
      have h'' := congrArg (· * aM) hz1
      simpa [mul_assoc] using h''.symm
    exact h'
  -- `m23a` fixes every point: contradiction with `m23a ≠ 1`
  apply m23a_ne_one
  apply Equiv.ext
  intro x
  obtain ⟨n, hnN, hn22⟩ := htrans x
  have hnz : n ∈ Subgroup.zpowers zM := by
    rw [hzpow_eq]
    exact hnN
  obtain ⟨t, ht⟩ := Subgroup.mem_zpowers_iff.mp hnz
  have hcommn : Commute aM n := by
    rw [← ht]
    exact hcomm.zpow_right t
  have hfix : m23a x = x := by
    have hmul : (aM * n).1 (22 : Fin 23) = m23a x := by
      change (m23a * n.1) 22 = m23a x
      rw [Equiv.Perm.mul_apply, hn22]
    have hmul' : (n * aM).1 (22 : Fin 23) = x := by
      change (n.1 * m23a) 22 = x
      rw [Equiv.Perm.mul_apply, m23a_fixes_last, hn22]
    rw [← hmul, hcommn.eq, hmul']
  simpa using hfix

/-! ## Main theorem -/

theorem normal_eq_bot_or_eq_top (N : Subgroup M23) (hN : N.Normal) :
    N = ⊥ ∨ N = ⊤ := by
  classical
  by_cases hbot : N = ⊥
  · exact Or.inl hbot
  right
  obtain ⟨n, hnN, p, hp⟩ := exists_moved_of_ne_bot N hbot
  have horbit := normal_orbit_last_eq_univ N hN hnN hp
  have hcardN := card_normal_eq_23_mul_stab N horbit
  rw [card_stabInN_eq] at hcardN
  haveI : IsSimpleGroup StabLast := isSimpleGroup_stabLast
  have hnormal : (N.subgroupOf StabLast).Normal := hN.subgroupOf StabLast
  rcases hnormal.eq_bot_or_eq_top with hb | ht
  · exfalso
    have hcard23 : Nat.card N = 23 := by
      rw [hcardN, hb, Subgroup.card_bot]
    exact regular_case_absurd N hN hcard23
      (fun x => normal_orbit_witness N hN hnN hp 22 x)
  · have hcardS : Nat.card (N.subgroupOf StabLast) = 443520 := by
      rw [ht, Subgroup.card_top]
      exact card_stabLast
    have hcard : Nat.card N = Nat.card M23 := by
      rw [hcardN, hcardS, M23Cardinality.card_M23]
    exact Subgroup.eq_top_of_card_eq N hcard

theorem nontrivial_M23 : Nontrivial M23 := by
  refine ⟨⟨⟨m23a, m23a_mem_M23Subgroup⟩, 1, ?_⟩⟩
  intro h
  exact m23a_ne_one (by simpa using congrArg Subtype.val h)

/-- The Mathieu group `M23` is simple. -/
theorem simple_M23 : IsSimpleGroup M23 :=
  { toNontrivial := nontrivial_M23
    eq_bot_or_eq_top_of_normal := normal_eq_bot_or_eq_top }

end M23Simplicity
end Sporadic

