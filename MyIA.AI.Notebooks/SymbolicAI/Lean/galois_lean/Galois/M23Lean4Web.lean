def lastStabWord (x : Fin 22) : Word :=
  match x.val with
  | 1 => [Gen.aInv, Gen.b, Gen.a, Gen.bInv, Gen.a, Gen.b]
  | 2 => [Gen.a, Gen.a, Gen.bInv, Gen.a, Gen.bInv, Gen.a, Gen.bInv]
