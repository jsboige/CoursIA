    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#standingOvation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#standingOvation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#standingOvation</IRI>
    <Literal xml:lang="FR">Standing ovation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#standingOvation</IRI>
    <Literal xml:lang="EN">Standing ovation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#standingOvation</IRI>
    <Literal xml:lang="FR">Vous vous levez et applaudissez pour exprimer un respect ou une admiration exceptionnels.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#standingOvation</IRI>
    <Literal xml:lang="EN">Standing and applauding to express exceptional respect or admiration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#standingOvation</IRI>
    <Literal xml:lang="FR">Le public s’est lèvé pour une ovation debout après un discours inspirant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#standingOvation</IRI>
    <Literal xml:lang="EN">The audience rising to their feet for a standing ovation after an inspiring speech.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#standingOvation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Standing_ovation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#standingOvation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Standing_ovation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#standingOvation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#standingOvation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
  </AnnotationAssertion>
