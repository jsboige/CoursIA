    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nationalism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nationalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nationalism</IRI>
    <Literal xml:lang="FR">Nationalisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nationalism</IRI>
    <Literal xml:lang="EN">Nationalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nationalism</IRI>
    <Literal xml:lang="FR">Votre argument construit et perpétue les préjugés d’ordre nationaux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nationalism</IRI>
    <Literal xml:lang="EN">Arguing and perpetuating biases based on national identity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nationalism</IRI>
    <Literal xml:lang="FR">Notre empire était le plus grand et le plus juste, c’est parce que nous sommes une nation exceptionnelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nationalism</IRI>
    <Literal xml:lang="EN">Our empire was the greatest and most just; it's because we are an exceptional nation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nationalism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Nationalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nationalism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Nationalisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nationalism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nationalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#religiousIntolerance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#religiousIntolerance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#religiousIntolerance</IRI>
    <Literal xml:lang="FR">Bigoterie religieuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#religiousIntolerance</IRI>
    <Literal xml:lang="EN">Religious intolerance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#religiousIntolerance</IRI>
    <Literal xml:lang="FR">Votre argument construit et perpétue les préjugés d’ordre religieux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#religiousIntolerance</IRI>
    <Literal xml:lang="EN">Arguing and maintaining prejudices of a religious nature.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#religiousIntolerance</IRI>
    <Literal xml:lang="FR">Si ceux-là veulent pratiquer leur religion de haîne, ils n’ont qu’à rentrer dans leur pays.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#religiousIntolerance</IRI>
    <Literal xml:lang="EN">If they want to practice their religion of hate, they should do it back in their country.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#religiousIntolerance</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Religious_discrimination</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#religiousIntolerance</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Discrimination_religieuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#religiousIntolerance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#religiousIntolerance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
    <Literal xml:lang="FR">Classisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
    <Literal xml:lang="EN">Classism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
    <Literal xml:lang="FR">Votre argument construit et perpétue les préjugés sur l’appartenance à une classe sociale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
    <Literal xml:lang="EN">Building and perpetuating prejudices concerning social class membership.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
    <Literal xml:lang="FR">Les gens de ton milieu préfèrent s’acheter des yachts que de sauver la planète.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
    <Literal xml:lang="EN">People from your class prefer buying yachts over saving the planet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Class_discrimination</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Classisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#populism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#populism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#populism</IRI>
    <Literal xml:lang="FR">Populisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#populism</IRI>
    <Literal xml:lang="EN">Populism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#populism</IRI>
    <Literal xml:lang="FR">Vous utilisez une rhétorique qui mobilise la population contre une élite perçue comme corrompue ou déconnectée, souvent en simplifiant les problèmes complexes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#populism</IRI>
    <Literal xml:lang="EN">Using rhetoric that mobilizes the population against an elite perceived as corrupt or out of touch, often by simplifying complex issues.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#populism</IRI>
    <Literal xml:lang="FR">Les élites ne comprennent pas les vrais problèmes du peuple. Seul un vrai changement pourra les remettre à leur place.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#populism</IRI>
    <Literal xml:lang="EN">The elites don't understand the real problems of the people. Only a true change can put them in their place.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#populism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Populism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#populism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Populisme_(politique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#populism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#populism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#classism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
    <Literal xml:lang="FR">Lookisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
    <Literal xml:lang="EN">Lookism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
    <Literal xml:lang="FR">Vous jugez les gens principalement sur leur apparence physique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
    <Literal xml:lang="EN">Judging people primarily based on their physical appearance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
    <Literal xml:lang="FR">Elle n’a pas vraiment l’allure d’une dirigeante, tu ne trouves pas ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
    <Literal xml:lang="EN">She doesn't really look like a leader, don't you think?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Lookism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Discrimination_selon_l%27apparence_physique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sizeism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sizeism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sizeism</IRI>
    <Literal xml:lang="FR">Discrimination par la taille</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sizeism</IRI>
    <Literal xml:lang="EN">Sizeism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sizeism</IRI>
    <Literal xml:lang="FR">Vous avez des préjugés envers les personnes en fonction de leur taille ou de leur poids.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sizeism</IRI>
    <Literal xml:lang="EN">Holding biases against people based on their size or weight.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sizeism</IRI>
    <Literal xml:lang="FR">Je ne pense pas qu’elle soit faite pour ce rôle, elle n’a pas la silhouette requise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sizeism</IRI>
    <Literal xml:lang="EN">I don't think she's cut out for this role, she doesn't have the required figure.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sizeism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sizeism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sizeism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Discrimination_par_la_taille</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sizeism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sizeism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lookism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ageism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ageism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ageism</IRI>
    <Literal xml:lang="FR">Âgisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ageism</IRI>
    <Literal xml:lang="EN">Ageism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ageism</IRI>
    <Literal xml:lang="FR">Vous discriminez les gens en fonction de leur âge.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ageism</IRI>
    <Literal xml:lang="EN">Discriminating against people based on their age.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ageism</IRI>
    <Literal xml:lang="FR">Je doute qu’il soit capable de comprendre les nouvelles technologies, vu son âge.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ageism</IRI>
    <Literal xml:lang="EN">I doubt he will be able to understand new technologies, given his age.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ageism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ageism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ageism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/%C3%82gisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ageism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ageism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalCringe</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalCringe</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalCringe</IRI>
    <Literal xml:lang="FR">Dévalorisation culturelle de soi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalCringe</IRI>
    <Literal xml:lang="EN">Cultural cringe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalCringe</IRI>
    <Literal xml:lang="FR">Vous considérez votre propre culture comme inférieure à celle d’autres pays.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalCringe</IRI>
    <Literal xml:lang="EN">Experiencing a sense of inferiority about one's own culture compared with those of other countries.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalCringe</IRI>
    <Literal xml:lang="FR">La musique de notre pays n’est pas aussi raffinée que celle que nous importons.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalCringe</IRI>
    <Literal xml:lang="EN">The music of our country is not as refined as the music we import.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalCringe</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cultural_cringe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalCringe</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalCringe</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oikophobia</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oikophobia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oikophobia</IRI>
    <Literal xml:lang="FR">Oikophobie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oikophobia</IRI>
    <Literal xml:lang="EN">Oikophobia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oikophobia</IRI>
    <Literal xml:lang="FR">Vous éprouvez du rejet ou de l’aversion pour votre propre culture ou environnement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oikophobia</IRI>
    <Literal xml:lang="EN">Experiencing repulsion or aversion towards one's own culture or environment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oikophobia</IRI>
    <Literal xml:lang="FR">Je n’aime pas vraiment nos traditions locales ; je préfère celles des autres pays.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oikophobia</IRI>
    <Literal xml:lang="EN">I don't really like our local traditions, I prefer those of other countries.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oikophobia</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Oikophobia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oikophobia</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Oikophobie#Usage_politique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalCringe</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oikophobia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oikophobia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalCringe</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allophilia</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allophilia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allophilia</IRI>
    <Literal xml:lang="FR">Allophilie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allophilia</IRI>
    <Literal xml:lang="EN">Allophilia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allophilia</IRI>
    <Literal xml:lang="FR">Vous éprouvez de l’admiration ou de l’affection pour des groupes différents du vôtre, au point d’en biaiser votre jugement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allophilia</IRI>
    <Literal xml:lang="EN">Feeling admiration or affection for groups different from one's own, to the point of biasing one's judgment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allophilia</IRI>
    <Literal xml:lang="FR">Je suis fasciné par leur culture ; j’aimerais beaucoup être comme eux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allophilia</IRI>
    <Literal xml:lang="EN">I am fascinated by their culture; I would very much like to be like them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allophilia</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Allophilia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allophilia</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Allophilie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allophilia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allophilia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <Literal xml:lang="FR">Xenocentrisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <Literal xml:lang="EN">Xenocentrism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <Literal xml:lang="FR">Vous préférez les pratiques culturelles d’autres cultures à celles de votre propre société.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <Literal xml:lang="EN">The preference for cultural practices of other cultures over those of one's own society.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <Literal xml:lang="FR">Je n’achète que des produits importés. Les produits locaux ne sont tout simplement pas à la hauteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <Literal xml:lang="EN">I only buy imported products. Local products just don't measure up.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Xenocentrism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#malinchism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#malinchism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#malinchism</IRI>
    <Literal xml:lang="FR">Malinchisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#malinchism</IRI>
    <Literal xml:lang="EN">Malinchism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#malinchism</IRI>
    <Literal xml:lang="FR">Vous montrez une admiration excessive pour certaines cultures étrangères, souvent en dépréciant votre propre culture.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#malinchism</IRI>
    <Literal xml:lang="EN">Exhibiting an excessive admiration for certain foreign cultures, often while disparaging one's own culture.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#malinchism</IRI>
    <Literal xml:lang="FR">Je suis tellement fasciné par la culture et le style de vie européens que je trouve notre mode de vie local terne et moins sophistiqué en comparaison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#malinchism</IRI>
    <Literal xml:lang="EN">I'm so enamored with European culture and lifestyle that I find our local way of life dull and less sophisticated by comparison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#malinchism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Malinchism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#malinchism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Malinchismo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#malinchism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#malinchism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clientitis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clientitis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clientitis</IRI>
    <Literal xml:lang="FR">Clientisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clientitis</IRI>
    <Literal xml:lang="EN">Clientitis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clientitis</IRI>
    <Literal xml:lang="FR">Vous adoptez un point de vue excessivement favorable envers les intérêts ou la culture d’un groupe extérieur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clientitis</IRI>
    <Literal xml:lang="EN">Adopting an excessively favorable view towards the interests or culture of an external group</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clientitis</IRI>
    <Literal xml:lang="FR">Nous devons comprendre le contexte culturel et historique qui a conduit ce pays à cette décision. Il est important de maintenir des relations diplomatiques stables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clientitis</IRI>
    <Literal xml:lang="EN">We must understand the cultural and historical context that led this country to this decision. It's important to maintain stable diplomatic relations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clientitis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Clientitis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clientitis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clientitis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racialFetishism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racialFetishism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racialFetishism</IRI>
    <Literal xml:lang="FR">Fétichisme racial</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racialFetishism</IRI>
    <Literal xml:lang="EN">Racial fetishism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racialFetishism</IRI>
    <Literal xml:lang="FR">Vous avez une fascination ou une obsession pour certaines caractéristiques raciales, souvent perçues comme exotiques ou supérieures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racialFetishism</IRI>
    <Literal xml:lang="EN">Fascination or obsession with certain racial characteristics, often perceived as exotic or superior.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racialFetishism</IRI>
    <Literal xml:lang="FR">Je ne sors qu’avec des personnes d’une certaine race parce que je les trouve tellement plus attirantes que les autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racialFetishism</IRI>
    <Literal xml:lang="EN">I only date people of a certain race because I find them so much more attractive than others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racialFetishism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Race_and_sexuality#Racial_fetishism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racialFetishism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racialFetishism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapism</IRI>
    <Literal xml:lang="FR">Evasion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapism</IRI>
    <Literal xml:lang="EN">Escapism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapism</IRI>
    <Literal xml:lang="FR">Vous évitez ou à niez les réalités de votre propre culture ou environnement en vous plongeant dans une culture ou un contexte différent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapism</IRI>
    <Literal xml:lang="EN">Avoiding or denying the realities of one's own culture or environment by immersing oneself in a different culture or context.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapism</IRI>
    <Literal xml:lang="FR">Je passe tout mon temps à regarder des séries de pays lointains pour oublier à quel point ma vie est ennuyeuse ici.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapism</IRI>
    <Literal xml:lang="EN">I spend all my time watching shows from faraway countries to forget how boring my life is here.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Escapism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primitivism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primitivism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primitivism</IRI>
    <Literal xml:lang="FR">Primitivisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primitivism</IRI>
    <Literal xml:lang="EN">Primitivism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primitivism</IRI>
    <Literal xml:lang="FR">Vous idéalisez des cultures perçues comme "moins développées" ou "plus proches de la nature", souvent de manière simpliste et romantique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primitivism</IRI>
    <Literal xml:lang="EN">Idealizing cultures perceived as "less developed" or "closer to nature", often in a simplistic and romantic way.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primitivism</IRI>
    <Literal xml:lang="FR">Je rêve de vivre dans une tribu lointaine, loin de la complexité de la vie moderne. La vie y est tellement plus authentique et pure.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primitivism</IRI>
    <Literal xml:lang="EN">I dream of living in a distant tribe, far from the complexity of modern life. Life there is so much more authentic and pure.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primitivism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Primitivism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primitivism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Primitivisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primitivism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primitivism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalAppropriation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalAppropriation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalAppropriation</IRI>
    <Literal xml:lang="FR">Appropriation culturelle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalAppropriation</IRI>
    <Literal xml:lang="EN">Cultural appropriation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalAppropriation</IRI>
    <Literal xml:lang="FR">Vous adoptez ou utilisez des éléments d’une culture étrangère, souvent sans une compréhension approfondie ou en ignorant leur contexte culturel original.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalAppropriation</IRI>
    <Literal xml:lang="EN">Adopting or using elements from a foreign culture, often without a deep understanding or ignoring their original cultural context.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalAppropriation</IRI>
    <Literal xml:lang="FR">J’ai décidé de porter ce vêtement traditionnel asiatique à la fête, car je trouve que c’est esthétiquement beau, même si je ne connais pas vraiment son importance culturelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalAppropriation</IRI>
    <Literal xml:lang="EN">I decided to wear this traditional Asian attire to the party because I find it aesthetically beautiful, even though I don't really know its cultural significance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalAppropriation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cultural_appropriation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalAppropriation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Appropriation_culturelle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalAppropriation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalAppropriation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#xenocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#functionalFixedness</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#functionalFixedness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#functionalFixedness</IRI>
    <Literal xml:lang="FR">Fixation fonctionnelle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#functionalFixedness</IRI>
    <Literal xml:lang="EN">Functional fixedness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#functionalFixedness</IRI>
    <Literal xml:lang="FR">Vous avez du mal à envisager pour un objet des usages autres que sa fonction habituelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#functionalFixedness</IRI>
    <Literal xml:lang="EN">Struggling to conceive uses for an object beyond its usual function.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#functionalFixedness</IRI>
    <Literal xml:lang="FR">Je n’aurais jamais pensé à utiliser cet objet comme presse-papier.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#functionalFixedness</IRI>
    <Literal xml:lang="EN">I would never have thought of using this object as a paperweight.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#functionalFixedness</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Functional_fixedness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#functionalFixedness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#functionalFixedness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
    <Literal xml:lang="FR">Biais de subjectivité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
    <Literal xml:lang="EN">Subjectivity bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
    <Literal xml:lang="FR">Vous argumentez à partir d’un point de vue subjectif, sans le distinguer clairement d’un jugement objectif.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
    <Literal xml:lang="EN">You argue from a subjective point of view without clearly distinguishing it from an objective judgment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
    <Literal xml:lang="FR">Cette œuvre d’art ne mérite pas d’être exposée ici : je ne la trouve pas belle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
    <Literal xml:lang="EN">This work of art does not deserve to be exhibited here: I do not find it beautiful.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Subjectivity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <Literal xml:lang="FR">Suggestibilité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <Literal xml:lang="EN">Suggestibility</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <Literal xml:lang="FR">Vous êtes influencé par les suggestions ou les attentes des autres, ce qui modifie vos souvenirs ou vos perceptions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <Literal xml:lang="EN">Being influenced by others' suggestions or expectations, altering one's memories or perceptions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <Literal xml:lang="FR">Quand quelqu’un me suggère que j’ai peut-être oublié quelque chose, je commence à douter de ma mémoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <Literal xml:lang="EN">When someone suggests that I may have forgotten something, I begin to doubt my memory.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Suggestibility</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misinformationEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misinformationEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misinformationEffect</IRI>
    <Literal xml:lang="FR">Effet de désinformation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misinformationEffect</IRI>
    <Literal xml:lang="EN">Misinformation effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misinformationEffect</IRI>
    <Literal xml:lang="FR">Vous modifiez vos souvenirs, ou vous en créez de faux, sous l’effet d’informations trompeuses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misinformationEffect</IRI>
    <Literal xml:lang="EN">Altering or creating false memories in response to misleading information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misinformationEffect</IRI>
    <Literal xml:lang="FR">Après avoir entendu une version trompeuse d’un événement, vous commencez à douter de votre propre souvenir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misinformationEffect</IRI>
    <Literal xml:lang="EN">After hearing a misleading version of an event, I begin to doubt my own memory.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misinformationEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Misinformation_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misinformationEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_de_d%C3%A9sinformation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misinformationEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misinformationEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialdesirabilityBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialdesirabilityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialdesirabilityBias</IRI>
    <Literal xml:lang="FR">Biais de désirabilité sociale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialdesirabilityBias</IRI>
    <Literal xml:lang="EN">Social-desirability bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialdesirabilityBias</IRI>
    <Literal xml:lang="FR">Vous répondez ou agissez de manière à être perçu favorablement par les autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialdesirabilityBias</IRI>
    <Literal xml:lang="EN">Responding or acting in a way to be favorably viewed by others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialdesirabilityBias</IRI>
    <Literal xml:lang="FR">Vous dites que vous accordez beaucoup d’importance au recyclage pour paraître écoresponsable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialdesirabilityBias</IRI>
    <Literal xml:lang="EN">I say that I attach great importance to recycling in order to appear eco-responsible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialdesirabilityBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Social-desirability_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialdesirabilityBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/D%C3%A9sirabilit%C3%A9_sociale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialdesirabilityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialdesirabilityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialComparisonBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialComparisonBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialComparisonBias</IRI>
    <Literal xml:lang="FR">Biais de comparaison sociale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialComparisonBias</IRI>
    <Literal xml:lang="EN">Social comparison bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialComparisonBias</IRI>
    <Literal xml:lang="FR">Vous vous évaluez en vous comparant aux autres, par envie ou pour vous percevoir sous un jour favorable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialComparisonBias</IRI>
    <Literal xml:lang="EN">Evaluating oneself by comparing oneself to others, with envy or by viewing oneself favorably.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialComparisonBias</IRI>
    <Literal xml:lang="FR">Je suis plus intelligent que la plupart de mes collègues.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialComparisonBias</IRI>
    <Literal xml:lang="EN">I'm smarter than most of my colleagues.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialComparisonBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Social_comparison_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialComparisonBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialComparisonBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="FR">Effet de halo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="EN">Halo effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="FR">Vous laissez une qualité positive d’une personne influencer votre jugement global sur elle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="EN">Letting a person's positive quality influence one's overall judgment of that person.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="FR">Parce qu’il est attrayant, je suppose qu’il est aussi intelligent et gentil.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="EN">Because he's attractive, I guess he's also smart and kind.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Halo_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_de_halo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authorityBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authorityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authorityBias</IRI>
    <Literal xml:lang="FR">Biais d’autorité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authorityBias</IRI>
    <Literal xml:lang="EN">Authority bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authorityBias</IRI>
    <Literal xml:lang="FR">Vous accordez plus de crédibilité ou de confiance aux opinions ou affirmations des autorités ou des experts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authorityBias</IRI>
    <Literal xml:lang="EN">Giving more credibility or trust to the opinions or statements of authorities or experts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authorityBias</IRI>
    <Literal xml:lang="FR">Si ce scientifique renommé le dit, alors ça doit être vrai.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authorityBias</IRI>
    <Literal xml:lang="EN">If this renowned scientist says it, then it must be true.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authorityBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Authority_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authorityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authorityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheerleaderEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheerleaderEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheerleaderEffect</IRI>
    <Literal xml:lang="FR">Effet de cheerleader</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheerleaderEffect</IRI>
    <Literal xml:lang="EN">Cheerleader effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheerleaderEffect</IRI>
    <Literal xml:lang="FR">Vous percevez les gens comme étant plus attirants lorsqu’ils sont en groupe que lorsqu’ils sont seuls.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheerleaderEffect</IRI>
    <Literal xml:lang="EN">Perceiving people as more attractive when they are in a group than when they are alone.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheerleaderEffect</IRI>
    <Literal xml:lang="FR">Les gens semblent plus séduisants dans un groupe que lorsqu’ils sont seuls.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheerleaderEffect</IRI>
    <Literal xml:lang="EN">People seem more attractive in a group than when they are alone.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheerleaderEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cheerleader_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheerleaderEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheerleaderEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonEffect</IRI>
    <Literal xml:lang="FR">Effet de mode</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonEffect</IRI>
    <Literal xml:lang="EN">Bandwagon effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonEffect</IRI>
    <Literal xml:lang="FR">Vous adoptez des croyances ou des comportements simplement parce qu’ils sont populaires ou largement acceptés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonEffect</IRI>
    <Literal xml:lang="EN">Adopting beliefs or behaviors simply because they are popular or widely accepted.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonEffect</IRI>
    <Literal xml:lang="FR">Tout le monde utilise cette application, donc je l’ai téléchargée moi aussi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonEffect</IRI>
    <Literal xml:lang="EN">Everyone uses this app, so I downloaded it too.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Bandwagon_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_de_mode</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupshift</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupshift</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupshift</IRI>
    <Literal xml:lang="FR">Biais de groupe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupshift</IRI>
    <Literal xml:lang="EN">Groupshift</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupshift</IRI>
    <Literal xml:lang="FR">Vous tendez à adopter des positions plus extrêmes ou risquées en groupe qu’individuellement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupshift</IRI>
    <Literal xml:lang="EN">Tending to adopt more extreme or riskier positions in a group than individually.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupshift</IRI>
    <Literal xml:lang="FR">Lors de la réunion, le groupe a opté pour une stratégie plus audacieuse que ce que chaque membre aurait choisi seul.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupshift</IRI>
    <Literal xml:lang="EN">In the meeting, the group leaned towards a bolder strategy than what individual members might have chosen on their own.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupshift</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Groupshift</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupshift</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_de_groupe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupshift</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupshift</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhymeasreasonEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhymeasreasonEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhymeasreasonEffect</IRI>
    <Literal xml:lang="FR">Effet de la rime comme raison</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhymeasreasonEffect</IRI>
    <Literal xml:lang="EN">Rhyme-as-reason effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhymeasreasonEffect</IRI>
    <Literal xml:lang="FR">Vous considérez qu’une affirmation est plus vraie si elle rime ou a un flux rythmique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhymeasreasonEffect</IRI>
    <Literal xml:lang="EN">Perceiving a statement as more accurate if it rhymes or has a rhythmic flow.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhymeasreasonEffect</IRI>
    <Literal xml:lang="FR">Les phrases qui riment nous parlent naturellement, comme ’ce qui se conçoit bien s’énonce clairement.’</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhymeasreasonEffect</IRI>
    <Literal xml:lang="EN">Rhyming phrases resonate with us, such as 'What is clearly conceived is clearly stated.'</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhymeasreasonEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Rhyme-as-reason_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhymeasreasonEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhymeasreasonEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suggestibility</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <Literal xml:lang="FR">Comptabilité mentale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <Literal xml:lang="EN">Mental accounting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <Literal xml:lang="FR">Vous classez et traitez l’argent différemment selon sa source ou l’usage que vous lui destinez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <Literal xml:lang="EN">Categorizing and treating money differently depending on its source or intended use.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <Literal xml:lang="FR">Je dépense facilement ma prime, car je la considère comme de l’argent « en plus ».</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <Literal xml:lang="EN">I easily spend my bonus because I consider it 'extra' money.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Mental_accounting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Comptabilit%C3%A9_mentale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationEffect</IRI>
    <Literal xml:lang="FR">Effet de dénomination</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationEffect</IRI>
    <Literal xml:lang="EN">Denomination effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationEffect</IRI>
    <Literal xml:lang="FR">Vous dépensez plus facilement les petites coupures ou les pièces que les grosses coupures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationEffect</IRI>
    <Literal xml:lang="EN">Spending smaller denominations more easily than larger sums.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationEffect</IRI>
    <Literal xml:lang="FR">Je dépense sans réfléchir les pièces de monnaie, mais j’y réfléchis à deux fois avant de casser un billet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationEffect</IRI>
    <Literal xml:lang="EN">I mindlessly spend coins but think twice before breaking a bill.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Denomination_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="FR">Effet « moins, c’est mieux »</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="EN">Less-is-better effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="FR">Vous jugez une option meilleure lorsqu’elle est évaluée seule que lorsqu’elle est comparée directement à d’autres options.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="EN">Evaluating an option as better when considered in isolation as opposed to when compared directly with other options.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="FR">Je préfère un petit cadeau élégamment emballé à un cadeau plus gros, mais moins bien présenté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="EN">I prefer a small, elegantly wrapped gift to a larger, less well presented gift.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Less-is-better_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_moins-c%27est-mieux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subadditivityEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subadditivityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subadditivityEffect</IRI>
    <Literal xml:lang="FR">Effet de subadditivité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subadditivityEffect</IRI>
    <Literal xml:lang="EN">Subadditivity effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subadditivityEffect</IRI>
    <Literal xml:lang="FR">Vous sous-estimez la somme totale en évaluant individuellement ses parties.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subadditivityEffect</IRI>
    <Literal xml:lang="EN">Underestimating the total sum by assessing its parts individually.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subadditivityEffect</IRI>
    <Literal xml:lang="FR">Je dépense plus en achetant des articles séparément que si j’avais évalué leur coût total.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subadditivityEffect</IRI>
    <Literal xml:lang="EN">I spend more buying items separately than if I had estimated their total cost.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subadditivityEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Subadditivity_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subadditivityEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subadditivityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moneyIllusion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moneyIllusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moneyIllusion</IRI>
    <Literal xml:lang="FR">Illusion monétaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moneyIllusion</IRI>
    <Literal xml:lang="EN">Money illusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moneyIllusion</IRI>
    <Literal xml:lang="FR">Vous surestimez ou sous-estimez la valeur réelle de l’argent en fonction de facteurs non économiques ou sans tenir compte de l’inflation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moneyIllusion</IRI>
    <Literal xml:lang="EN">Overestimating or underestimating the real value of money based on non-economic factors or without accounting for inflation..</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moneyIllusion</IRI>
    <Literal xml:lang="FR">Depuis que ce produit est à 11€, je fais plus attention à ma consommation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moneyIllusion</IRI>
    <Literal xml:lang="EN">Since this product costs €11, I am more cautious about how I use it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moneyIllusion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Money_illusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moneyIllusion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Illusion_mon%C3%A9taire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moneyIllusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moneyIllusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalAccounting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <Literal xml:lang="FR">Biais théoriques</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <Literal xml:lang="EN">Theoretical biases</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <Literal xml:lang="FR">Vous raisonnez dans un cadre déformé par une application trop rigide de concepts théoriques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <Literal xml:lang="EN">Reasoning on the basis of the strict, exclusive application of theoretical concepts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <Literal xml:lang="FR">En cuisine, seule l’huile d’olive vaut vraiment la peine d’être utilisée. Je fais donc mes viennoiseries sans beurre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <Literal xml:lang="EN">In cooking, only olive oil is really worth using. So I make my pastries without butter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Idola_theatri</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Idoles_du_Th%C3%A9%C3%A2tre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <Literal xml:lang="FR">Dogmatisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <Literal xml:lang="EN">Dogmatism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <Literal xml:lang="FR">Vous fondez votre raisonnement sur une croyance tenue pour indiscutable, sans tenir compte des preuves contraires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <Literal xml:lang="EN">Reasoning from an unquestionable and irrefutable belief, without considering contrary evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <Literal xml:lang="FR">L’entreprise a toujours privilégié cette technologie ; inutile d’examiner les autres options disponibles sur le marché.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <Literal xml:lang="EN">The company has always favored this technology, so there's no point in considering other options on the market.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Dogma</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Dogme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
    <Literal xml:lang="FR">Anthropocentrisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
    <Literal xml:lang="EN">Anthropocentrism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
    <Literal xml:lang="FR">Vous évaluez et interprétez le monde principalement du point de vue humain, souvent au détriment des perspectives environnementales.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
    <Literal xml:lang="EN">Assessing and interpreting the world mainly from a human-centered perspective, often overlooking the needs and perspectives of other species and the environment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
    <Literal xml:lang="FR">Ce n’est qu’une forêt : nous pouvons la déboiser pour construire. Après tout, les besoins humains passent en premier.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
    <Literal xml:lang="EN">It's just a forest, we can clear it for development. After all, human needs come first.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Anthropocentrism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Anthropocentrisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
    <Literal xml:lang="FR">Individualisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
    <Literal xml:lang="EN">Individualism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
    <Literal xml:lang="FR">Vous mettez l’accent sur la liberté et l’autonomie de l’individu, souvent en minimisant le rôle de la société ou de la communauté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
    <Literal xml:lang="EN">Emphasizing the freedom and autonomy of the individual, often downplaying the role of society or community.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
    <Literal xml:lang="FR">Chacun est le maître de son destin et ne doit compter que sur ses propres efforts pour réussir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
    <Literal xml:lang="EN">Everyone is the master of their own destiny and should only rely on their own efforts to succeed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Individualism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Individualisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#objectivism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#objectivism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#objectivism</IRI>
    <Literal xml:lang="FR">Objectivisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#objectivism</IRI>
    <Literal xml:lang="EN">Objectivism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#objectivism</IRI>
    <Literal xml:lang="FR">Vous adhérez à une philosophie qui insiste sur l’importance de l’objectivité et de la raison, parfois au détriment de la compassion ou de l’empathie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#objectivism</IRI>
    <Literal xml:lang="EN">Adhering to a philosophy that emphasizes the importance of objectivity and reason, sometimes at the expense of compassion or empathy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#objectivism</IRI>
    <Literal xml:lang="FR">Les émotions et les sentiments personnels ne devraient pas interférer dans une prise de décision rationnelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#objectivism</IRI>
    <Literal xml:lang="EN">Personal emotions and feelings should not interfere in rational decision-making.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#objectivism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Objectivism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#objectivism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Objectivisme_(Ayn_Rand)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#objectivism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#objectivism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#individualism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logocentrism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logocentrism</IRI>
    <Literal xml:lang="FR">Logocentrisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logocentrism</IRI>
    <Literal xml:lang="EN">Logocentrism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logocentrism</IRI>
    <Literal xml:lang="FR">Vous vous enfermez dans la logique de votre propre langage, que vous prenez pour référence, et vous négligez les nuances qui dépassent les mots.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logocentrism</IRI>
    <Literal xml:lang="EN">Encapsulating oneself within the logic of one's own language, viewing it as a reference model while neglecting the complexity and nuances that exist beyond language.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logocentrism</IRI>
    <Literal xml:lang="FR">Nous analysons toujours nos expériences à partir de catégories linguistiques ; donc tout ce qui ne peut pas être exprimé clairement avec des mots n’a pas vraiment de sens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logocentrism</IRI>
    <Literal xml:lang="EN">We always analyze our experiences in terms of linguistic categories, therefore anything that cannot be clearly expressed in words is not truly meaningful.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logocentrism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Logocentrism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logocentrism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Logocentrisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
    <Literal xml:lang="FR">Scientisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
    <Literal xml:lang="EN">Scientism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
    <Literal xml:lang="FR">Vous considérez la science comme la source ultime de connaissance, supérieure à toute autre forme de compréhension ou de savoir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
    <Literal xml:lang="EN">Believing that science is the ultimate source of knowledge and is superior to other forms of understanding or knowledge.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
    <Literal xml:lang="FR">Seules les explications scientifiques peuvent être considérées comme vraies. Les autres formes de savoir sont inférieures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
    <Literal xml:lang="EN">Only scientific explanations can be considered true. Other forms of knowledge are inferior.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Scientism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Scientisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
    <Literal xml:lang="FR">Réductionnisme dogmatique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
    <Literal xml:lang="EN">Dogmatic Reductionism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
    <Literal xml:lang="FR">Vous adoptez une approche qui réduit systématiquement les phénomènes à des composantes plus simples, en négligeant leurs aspects émergents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
    <Literal xml:lang="EN">Adhering to an approach that systematically reduces phenomena to simpler components, neglecting emergent aspects.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
    <Literal xml:lang="FR">Tous les comportements humains peuvent être expliqués uniquement par la biologie et la génétique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
    <Literal xml:lang="EN">All human behavior can be explained solely by biology and genetics.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Reductionism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/R%C3%A9ductionnisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivism</IRI>
    <Literal xml:lang="FR">Positivisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivism</IRI>
    <Literal xml:lang="EN">Positivism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivism</IRI>
    <Literal xml:lang="FR">Vous adhérez à la philosophie selon laquelle la seule véritable connaissance est celle obtenue par les sciences positives, et vous rejetez les questions métaphysiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivism</IRI>
    <Literal xml:lang="EN">Adhering to the philosophy that the only true knowledge is that obtained through positive sciences, rejecting metaphysics.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivism</IRI>
    <Literal xml:lang="FR">Seules les affirmations vérifiables empiriquement ont un sens ; les questions métaphysiques en sont dépourvues.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivism</IRI>
    <Literal xml:lang="EN">Only empirically verifiable statements have meaning; metaphysical questions are meaningless.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Positivism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Positivisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticReductionism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <Literal xml:lang="FR">Empirisme dogmatique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <Literal xml:lang="EN">Dogmatic Empiricism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <Literal xml:lang="FR">Vous dépendez uniquement de l’expérience et de l’observation pour comprendre le monde, rejetant toute théorie ou spéculation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <Literal xml:lang="EN">Relying solely on experience and observation to understand the world, rejecting any theory or speculation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <Literal xml:lang="FR">Si je ne peux pas le voir ou le mesurer, alors ça n’existe pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <Literal xml:lang="EN">If I can't see it or measure it, then it doesn't exist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Empiricism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Empirisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scientism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phenomenalism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phenomenalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phenomenalism</IRI>
    <Literal xml:lang="FR">Phénoménisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phenomenalism</IRI>
    <Literal xml:lang="EN">Phenomenalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phenomenalism</IRI>
    <Literal xml:lang="FR">Vous croyez que les seules réalités sont les phénomènes tels qu’ils sont perçus, rejetant l’existence d’une réalité objective indépendante de la perception.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phenomenalism</IRI>
    <Literal xml:lang="EN">Believing that the only realities are phenomena as they are perceived, rejecting the existence of an objective reality independent of perception.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phenomenalism</IRI>
    <Literal xml:lang="FR">Le monde n’existe que dans ma perception; rien n’est réel en dehors de ce que je peux percevoir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phenomenalism</IRI>
    <Literal xml:lang="EN">The world only exists in my perception; nothing is real outside of what I can perceive.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phenomenalism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Phenomenalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phenomenalism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Ph%C3%A9nom%C3%A9nisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phenomenalism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phenomenalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#behaviorism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#behaviorism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#behaviorism</IRI>
    <Literal xml:lang="FR">Comportementalisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#behaviorism</IRI>
    <Literal xml:lang="EN">Behaviorism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#behaviorism</IRI>
    <Literal xml:lang="FR">ous adhérez à une approche qui attribue tout comportement humain à l’environnement et aux stimuli externes, négligeant les facteurs internes comme les pensées et les émotions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#behaviorism</IRI>
    <Literal xml:lang="EN">Adhering to an approach that attributes all human behavior to the environment and external stimuli, neglecting internal factors such as thoughts and emotions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#behaviorism</IRI>
    <Literal xml:lang="FR">Quand mon collègue s’est énervé en réunion, c’était clairement à cause du bruit et du stress ambiant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#behaviorism</IRI>
    <Literal xml:lang="EN">When my colleague got angry in the meeting, it was clearly because of the noise and surrounding stress.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#behaviorism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Behaviorism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#behaviorism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Comportementalisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#behaviorism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#behaviorism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalPositivism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalPositivism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalPositivism</IRI>
    <Literal xml:lang="FR">Positivisme logique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalPositivism</IRI>
    <Literal xml:lang="EN">Logical positivism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalPositivism</IRI>
    <Literal xml:lang="FR">Vous soutenez une approche qui combine empirisme et logique formelle, en affirmant que la signification d’une proposition est sa méthode de vérification.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalPositivism</IRI>
    <Literal xml:lang="EN">Supporting an approach that combines empiricism and formal logic, asserting that the meaning of a proposition is its method of verification.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalPositivism</IRI>
    <Literal xml:lang="FR">Une déclaration est significative si et seulement si elle peut être vérifiée logiquement ou empiriquement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalPositivism</IRI>
    <Literal xml:lang="EN">A statement is meaningful if and only if it can be logically or empirically verified.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalPositivism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Logical_positivism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalPositivism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Empirisme_logique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalPositivism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalPositivism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmaticEmpiricism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#materialism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#materialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#materialism</IRI>
    <Literal xml:lang="FR">Matérialisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#materialism</IRI>
    <Literal xml:lang="EN">Materialism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#materialism</IRI>
    <Literal xml:lang="FR">Vous pensez que la matière est la seule réalité et que tous les phénomènes, y compris la conscience, peuvent s’expliquer par des processus matériels.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#materialism</IRI>
    <Literal xml:lang="EN">Believing that the only reality is matter and that all phenomena, including consciousness, can be explained by material processes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#materialism</IRI>
    <Literal xml:lang="FR">L’esprit et la conscience ne sont que des produits de l’activité cérébrale physique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#materialism</IRI>
    <Literal xml:lang="EN">The mind and consciousness are merely products of physical brain activity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#materialism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Materialism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#materialism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Mat%C3%A9rialisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#materialism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#materialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vitalism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vitalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vitalism</IRI>
    <Literal xml:lang="FR">Vitalisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vitalism</IRI>
    <Literal xml:lang="EN">Vitalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vitalism</IRI>
    <Literal xml:lang="FR">Vous adhérez à l’idée qu’une force vitale, au-delà des processus physiques et chimiques, serait nécessaire à la vie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vitalism</IRI>
    <Literal xml:lang="EN">Adhering to the belief that there is a vital force beyond physical and chemical processes, necessary for life.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vitalism</IRI>
    <Literal xml:lang="FR">Une force vitale particulière distingue les êtres vivants de la matière inerte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vitalism</IRI>
    <Literal xml:lang="EN">There is a special life force that differentiates living beings from inanimate matter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vitalism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Vitalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vitalism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Vitalisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vitalism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vitalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
    <Literal xml:lang="FR">Idéalisme subjectif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
    <Literal xml:lang="EN">Subjective idealism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
    <Literal xml:lang="FR">Vous pensez que la réalité est entièrement mentale ou spirituelle, et que le monde matériel est une illusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
    <Literal xml:lang="EN">Believing that reality is entirely mental or spiritual, and that the material world is an illusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
    <Literal xml:lang="FR">Le monde extérieur n’est qu’une projection de mon esprit; rien n’existe indépendamment de ma conscience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
    <Literal xml:lang="EN">The external world is just a projection of my mind; nothing truly exists outside my own consciousness.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Subjective_idealism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Id%C3%A9alisme_subjectif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogmatism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solipsism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solipsism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solipsism</IRI>
    <Literal xml:lang="FR">Solipsisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solipsism</IRI>
    <Literal xml:lang="EN">Solipsism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solipsism</IRI>
    <Literal xml:lang="FR">Vous pensez que seul votre propre esprit est certain d’exister, doutant de l’existence du monde extérieur ou d’autres esprits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solipsism</IRI>
    <Literal xml:lang="EN">Thinking that only one's own mind is certain to exist, doubting the existence of the outside world or other minds.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solipsism</IRI>
    <Literal xml:lang="FR">Je ne peux être sûr que de ma propre existence; tout le reste pourrait n’être qu’une illusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solipsism</IRI>
    <Literal xml:lang="EN">I can only be sure of my own existence; everything else could be just an illusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solipsism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Solipsism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solipsism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Solipsisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solipsism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solipsism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveIdealism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <Literal xml:lang="FR">Fondamentalisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <Literal xml:lang="EN">Fundamentalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <Literal xml:lang="FR">Vous adhérez strictement et littéralement à un ensemble de principes fondamentaux, souvent avec hostilité envers les autres perspectives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <Literal xml:lang="EN">Adhering strictly and literally to a set of core principles, often with an hostile view of other perspectives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <Literal xml:lang="FR">Toutes nos traditions doivent être respectées à la lettre, parce qu’elles ont toujours guidé notre communauté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <Literal xml:lang="EN">All our traditions must be respected to the letter, because they have always guided our community.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fundamentalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Fondamentalisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
    <Literal xml:lang="FR">Autoritarisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
    <Literal xml:lang="EN">Authoritarianism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
    <Literal xml:lang="FR">Vous favorisez un contrôle strict et une obéissance inconditionnelle à l’autorité, souvent au détriment de la liberté individuelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
    <Literal xml:lang="EN">Favoring strict control and unquestioning obedience to authority, often at the expense of individual freedom.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
    <Literal xml:lang="FR">Il est essentiel de suivre les ordres de nos dirigeants sans les remettre en question afin de maintenir l’ordre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
    <Literal xml:lang="EN">Following our leaders' orders without question is crucial to maintaining order.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Authoritarianism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Autoritarisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#totalitarianism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#totalitarianism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#totalitarianism</IRI>
    <Literal xml:lang="FR">Totalitarisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#totalitarianism</IRI>
    <Literal xml:lang="EN">Totalitarianism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#totalitarianism</IRI>
    <Literal xml:lang="FR">Vous soutenez un système politique autoritaire et centralisé qui ne tolère aucune opposition ni critique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#totalitarianism</IRI>
    <Literal xml:lang="EN">Supporting an authoritarian and centralized political system that tolerates no opposition or criticism.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#totalitarianism</IRI>
    <Literal xml:lang="FR">Un gouvernement fort qui contrôle tous les aspects de la société est nécessaire pour maintenir l’ordre et la sécurité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#totalitarianism</IRI>
    <Literal xml:lang="EN">A strong government controlling every aspect of society is necessary to maintain order and security.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#totalitarianism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Totalitarianism

</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#totalitarianism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Totalitarisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#totalitarianism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#totalitarianism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#authoritarianism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#radicalPolitics</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#radicalPolitics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#radicalPolitics</IRI>
    <Literal xml:lang="FR">Radicalisme politique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#radicalPolitics</IRI>
    <Literal xml:lang="EN">Radical politics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#radicalPolitics</IRI>
    <Literal xml:lang="FR">Vous prônez des changements fondamentaux ou extrêmes dans la structure politique ou sociale, souvent sans tenir compte de leurs conséquences.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#radicalPolitics</IRI>
    <Literal xml:lang="EN">Advocating fundamental or extreme changes in the political or social structure, often without consideration of the consequences.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#radicalPolitics</IRI>
    <Literal xml:lang="FR">Nous devons renverser l’ordre établi pour construire une société totalement nouvelle et juste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#radicalPolitics</IRI>
    <Literal xml:lang="EN">We must overturn the established order to build a completely new and fair society.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#radicalPolitics</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Radical_politics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#radicalPolitics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#radicalPolitics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
    <Literal xml:lang="FR">Extrémisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
    <Literal xml:lang="EN">Extremism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
    <Literal xml:lang="FR">Vous adoptez ou défendez des idées, des attitudes ou des actions extrêmes ou radicales, souvent au mépris des normes sociales acceptées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
    <Literal xml:lang="EN">Adopting or defending ideas, attitudes or actions that are extreme or radical, often in defiance of the accepted social norm.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
    <Literal xml:lang="FR">Pour réaliser notre vision, nous devons aller au-delà des limites acceptées par la société.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
    <Literal xml:lang="EN">To achieve our vision, we must go beyond the limits accepted by society.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Extremism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Extr%C3%A9misme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fanaticism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fanaticism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fanaticism</IRI>
    <Literal xml:lang="FR">Fanatisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fanaticism</IRI>
    <Literal xml:lang="EN">Fanaticism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fanaticism</IRI>
    <Literal xml:lang="FR">Vous montrez un zèle ou une passion excessifs pour une cause ou une idéologie, souvent sans considération pour les opinions divergentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fanaticism</IRI>
    <Literal xml:lang="EN">Showing excessive zeal or passion for a cause or ideology, often without consideration for differing opinions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fanaticism</IRI>
    <Literal xml:lang="FR">Ma cause est la seule juste, et je suis prêt à tout pour la défendre, même contre ceux qui ne la comprennent pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fanaticism</IRI>
    <Literal xml:lang="EN">My cause is the only just one, and I am ready to do anything to defend it, even against those who don't understand it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fanaticism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fanaticism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fanaticism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Fanatisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fanaticism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fanaticism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorism</IRI>
    <Literal xml:lang="FR">Terrorisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorism</IRI>
    <Literal xml:lang="EN">Terrorism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorism</IRI>
    <Literal xml:lang="FR">ous justifiez ou participez à l’utilisation de la violence et de l’intimidation, surtout contre les civils, pour des fins politiques ou idéologiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorism</IRI>
    <Literal xml:lang="EN">Justifying or participating in the use of violence and intimidation, especially against civilians, for political or ideological purposes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorism</IRI>
    <Literal xml:lang="FR">Nos actions radicales sont nécessaires pour attirer l’attention sur notre cause et provoquer le changement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorism</IRI>
    <Literal xml:lang="EN">Our radical actions are necessary to draw attention to our cause and provoke change.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Terrorism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Terrorisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extremism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
    <Literal xml:lang="FR">Sectarisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
    <Literal xml:lang="EN">Sectarianism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
    <Literal xml:lang="FR">Vous montrez une loyauté et une adhésion rigides à un groupe ou une idéologie spécifique, souvent accompagnées d’une hostilité envers les autres groupes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
    <Literal xml:lang="EN">Showing rigid loyalty and adherence to a specific group or ideology, often accompanied by hostility toward other groups.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
    <Literal xml:lang="FR">Notre groupe détient la vérité absolue, et ceux qui ne sont pas avec nous sont contre nous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
    <Literal xml:lang="EN">Our group holds the absolute truth, and those who are not with us are against us.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sectarianism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sectarisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sect</IRI>
    <Literal xml:lang="FR">Secte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sect</IRI>
    <Literal xml:lang="EN">Sect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sect</IRI>
    <Literal xml:lang="FR">Vous adhérez ou défendez une organisation ou un mouvement qui se caractérise par des croyances ou des pratiques extrêmes ou non conventionnelles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sect</IRI>
    <Literal xml:lang="EN">You join or defend an organization or movement characterized by extreme or unconventional beliefs or practices.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sect</IRI>
    <Literal xml:lang="FR">Cette communauté m’a révélé la vraie signification de la vie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sect</IRI>
    <Literal xml:lang="EN">This community has shown me the true meaning of life.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Secte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sectarianism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <Literal xml:lang="FR">Dogmes opportunistes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <Literal xml:lang="EN">Opportunistic Dogmas</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <Literal xml:lang="FR">Vous adoptez des croyances ou des principes non fondés parce qu’ils servent vos intérêts ou vos objectifs argumentatifs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <Literal xml:lang="EN">Adopting unproven beliefs or principles that serve one's interests or argumentative purposes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <Literal xml:lang="FR">Si je n’ai pas poussé plus loin mon analyse, c’est que je pars du principe que la vérité finit toujours par apparaître clairement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <Literal xml:lang="EN">If I didn't delve deeper into my analysis, it's because I operate under the assumption that truth always emerges in a straightforward manner.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theoreticalBiases</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
    <Literal xml:lang="FR">Pseudo-dogmes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
    <Literal xml:lang="EN">Pseudodogmas</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
    <Literal xml:lang="FR">Vous adhérez à des idées ou à des théories qui semblent profondes ou significatives, mais qui manquent de fondement scientifique ou logique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
    <Literal xml:lang="EN">Adhering to ideas or theories that seem profound or significant but lack scientific or logical foundation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
    <Literal xml:lang="FR">Les vibrations de ces cristaux vont nettoyer votre aura.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
    <Literal xml:lang="EN">The vibrations from these crystals will cleanse your aura.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudophilosophy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudophilosophy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudophilosophy</IRI>
    <Literal xml:lang="FR">Pseudo-philosophie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudophilosophy</IRI>
    <Literal xml:lang="EN">Pseudophilosophy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudophilosophy</IRI>
    <Literal xml:lang="FR">Vous utilisez un jargon ou des concepts qui semblent profonds ou philosophiques, mais qui sont en réalité vagues, peu substantiels ou dénués de portée pratique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudophilosophy</IRI>
    <Literal xml:lang="EN">Using jargon or concepts that seem deep or philosophical, but are actually vague, insubstantial, or devoid of practical meaning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudophilosophy</IRI>
    <Literal xml:lang="FR">Quand un problème apparaît, je le vois comme une opportunité pour grandir spirituellement, plutôt que de chercher des solutions pratiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudophilosophy</IRI>
    <Literal xml:lang="EN">When a problem arises, I see it as a spiritual growth opportunity rather than looking for practical solutions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudophilosophy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pseudophilosophy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudophilosophy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pseudo-philosophie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudophilosophy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudophilosophy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="FR">Pseudoscience</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="EN">Pseudoscience</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="FR">Vous présentez ou adoptez des croyances ou des pratiques dites scientifiques, mais qui manquent de preuves empiriques ou de méthodologie scientifique rigoureuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="EN">Presenting or adhering to beliefs or practices that are presented as scientific, but which lack empirical evidence or rigorous scientific methodology.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="FR">Cette méthode de guérison aurait des effets miraculeux, démontrés par des méthodes très modernes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="EN">This healing method is said to have miraculous effects, demonstrated by very modern methods.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pseudoscience</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pseudoscience</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantumPhysicsFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantumPhysicsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantumPhysicsFallacy</IRI>
    <Literal xml:lang="FR">Argument par la physique quantique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantumPhysicsFallacy</IRI>
    <Literal xml:lang="EN">Quantum physics fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantumPhysicsFallacy</IRI>
    <Literal xml:lang="FR">Vous utilisez la référence à la physique quantique pour justifier votre manque de raisonnement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantumPhysicsFallacy</IRI>
    <Literal xml:lang="EN">Arguing from a reference to quantum physics to justify a lack of reasoning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantumPhysicsFallacy</IRI>
    <Literal xml:lang="FR">Puisque la physique quantique permet ces phénomènes étranges à petite échelle, mes rêves de voyages intersidéraux dans l’espace peuvent se réaliser.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantumPhysicsFallacy</IRI>
    <Literal xml:lang="EN">Since quantum physics allows for strange phenomena on the micro scale, my dreams of intersidereal space travel could finally become reality.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantumPhysicsFallacy</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/147/Quantum-Physics-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantumPhysicsFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantumPhysicsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoskepticism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoskepticism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoskepticism</IRI>
    <Literal xml:lang="FR">Pseudoscepticisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoskepticism</IRI>
    <Literal xml:lang="EN">Pseudoskepticism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoskepticism</IRI>
    <Literal xml:lang="FR">Vous affichez une attitude de scepticisme, mais en réalité, vous rejetez les nouvelles informations ou preuves sans examen objectif.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoskepticism</IRI>
    <Literal xml:lang="EN">Displaying an attitude of skepticism while actually rejecting new information or evidence without objective examination.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoskepticism</IRI>
    <Literal xml:lang="FR">Ces nouvelles théories scientifiques ne peuvent pas être vraies, je reste sceptique quoiqu’en disent les preuves.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoskepticism</IRI>
    <Literal xml:lang="EN">These new scientific theories can't be true; I remain skeptical regardless of the evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoskepticism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pseudoskepticism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoskepticism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoskepticism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudorationalism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudorationalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudorationalism</IRI>
    <Literal xml:lang="FR">Pseudorationalisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudorationalism</IRI>
    <Literal xml:lang="EN">Pseudorationalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudorationalism</IRI>
    <Literal xml:lang="FR">Vous utilisez la logique ou la rationalité d’une manière qui semble correcte en surface, mais qui est fondamentalement erronée ou trompeuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudorationalism</IRI>
    <Literal xml:lang="EN">Using logic or rationality in a way that appears correct on the surface, but is fundamentally wrong or misleading.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudorationalism</IRI>
    <Literal xml:lang="FR">En me basant sur une analyse rationnelle, j’ai conclu que notre entreprise devrait investir massivement dans cette nouvelle technologie. C’est la tendance du marché, et toutes les données indiquent qu’elle ne fera que croître.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudorationalism</IRI>
    <Literal xml:lang="EN">Based on rational analysis, I concluded that our company should invest heavily in this new technology. This is the market trend, and all the data indicates that it will only grow.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudorationalism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pseudorationalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudorationalism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudorationalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudodogmas</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiritualFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiritualFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiritualFallacy</IRI>
    <Literal xml:lang="FR">Appel au spirituel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiritualFallacy</IRI>
    <Literal xml:lang="EN">Spiritual Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiritualFallacy</IRI>
    <Literal xml:lang="FR">Vous affirmez qu’un énoncé qui, pris à la lettre, est dépourvu de sens rationnel doit en réalité être compris de manière spirituelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiritualFallacy</IRI>
    <Literal xml:lang="EN">Claiming that something, if not making sense in a literal or rational way, is in fact, spiritual.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiritualFallacy</IRI>
    <Literal xml:lang="FR">Certes, les Écritures saintes contiennent des horreurs, mais il faut les lire de manière spirituelle et y voir une vérité de l’esprit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiritualFallacy</IRI>
    <Literal xml:lang="EN">But all the Holy Scriptures contain horrors. They should be read in a spiritual way to see the truth of the spirit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiritualFallacy</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/164/Spiritual-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiritualFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiritualFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#virtualityFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#virtualityFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#virtualityFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de la virtualité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#virtualityFallacy</IRI>
    <Literal xml:lang="EN">Virtuality fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#virtualityFallacy</IRI>
    <Literal xml:lang="FR">Vous soutenez qu’un événement qui a lieu dans un contexte virtuel n’a pas de conséquences réelles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#virtualityFallacy</IRI>
    <Literal xml:lang="EN">Arguing that events happening in a virtual setting have no real-world consequences.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#virtualityFallacy</IRI>
    <Literal xml:lang="FR">Il n’a écrit ses insultes que sur Internet ; cela ne compte pas dans la vraie vie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#virtualityFallacy</IRI>
    <Literal xml:lang="EN">He just posted those insults online, it doesn't count in real life.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#virtualityFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Virtuality_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#virtualityFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#virtualityFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justWorldHypothesis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justWorldHypothesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justWorldHypothesis</IRI>
    <Literal xml:lang="FR">Hypothèse du monde juste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justWorldHypothesis</IRI>
    <Literal xml:lang="EN">Just world hypothesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justWorldHypothesis</IRI>
    <Literal xml:lang="FR">Votre argument suppose que le monde est naturellement équitable et que tout le monde récolte ce qu’il mérite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justWorldHypothesis</IRI>
    <Literal xml:lang="EN">The belief that the world is inherently fair and that people ultimately get what they deserve.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justWorldHypothesis</IRI>
    <Literal xml:lang="FR">Si cet homme est dans la rue, c’est forcément qu’il a mal géré sa vie; chacun récolte ce qu’il sème.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justWorldHypothesis</IRI>
    <Literal xml:lang="EN">If that man is living on the streets, it must be because he mishandled his life; you reap what you sow.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justWorldHypothesis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Just-world_hypothesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justWorldHypothesis</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Croyance_en_un_monde_juste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justWorldHypothesis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justWorldHypothesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#packageDealFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#packageDealFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#packageDealFallacy</IRI>
    <Literal xml:lang="FR">Argument du package</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#packageDealFallacy</IRI>
    <Literal xml:lang="EN">Package deal fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#packageDealFallacy</IRI>
    <Literal xml:lang="FR">Vous pensez que parce que certaines choses sont souvent regroupées, elles doivent toujours l’être.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#packageDealFallacy</IRI>
    <Literal xml:lang="EN">Assuming that because things are typically bundled together, they must always be bundled together.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#packageDealFallacy</IRI>
    <Literal xml:lang="FR">Sans leurs costumes et leur mise en scène traditionnels, les chanteurs d’opéra ne pourraient pas transmettre aussi bien les émotions de leur art.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#packageDealFallacy</IRI>
    <Literal xml:lang="EN">Without their costumes and traditional stage settings, opera singers couldn't convey the emotions of their art as well.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#packageDealFallacy</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/139/Package-Deal-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#packageDealFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#packageDealFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elGrecoFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elGrecoFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elGrecoFallacy</IRI>
    <Literal xml:lang="FR">Sophisme El Greco</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elGrecoFallacy</IRI>
    <Literal xml:lang="EN">El Greco fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elGrecoFallacy</IRI>
    <Literal xml:lang="FR">Vous supposez que des anomalies perceptuelles chez une personne influencent de manière similaire ses interactions avec le monde.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elGrecoFallacy</IRI>
    <Literal xml:lang="EN">You assume that a person's perceptual anomalies similarly influence their interactions with the world.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elGrecoFallacy</IRI>
    <Literal xml:lang="FR">Ce peintre est atteint de myopie, il a peint des formes floues pour représenter sa perception du monde.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elGrecoFallacy</IRI>
    <Literal xml:lang="EN">The painter, being shortsighted, depicted his subjects with blurred edges to represent how he sees the world.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elGrecoFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/El_Greco_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elGrecoFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elGrecoFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#opportunisticDogmas</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <Literal xml:lang="FR">Obstruction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <Literal xml:lang="EN">Obstruction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <Literal xml:lang="FR">Par un artifice, oratoire ou autre, vous faites en sorte que la discussion ne se déroule pas comme prévu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <Literal xml:lang="EN">Through a rhetorical or other device, you make sure that the discussion does not proceed as planned.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <Literal xml:lang="FR"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <Literal xml:lang="EN"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <Literal xml:lang="EN">http://www.ditext.com/fearnside/39.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#ResolvingInconsistency_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
    <Literal xml:lang="FR">Refus du débat</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
    <Literal xml:lang="EN">Refusing debate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
    <Literal xml:lang="FR">Vous esquivez le débat pour empêcher tout échange constructif fondé sur des arguments rationnels.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
    <Literal xml:lang="EN">Evading debate by means of preventing a rational argumentative discussion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
    <Literal xml:lang="FR">Mes positions sont claires, connues de tous, et je n’ai pas à en débattre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
    <Literal xml:lang="EN">My positions are clear, known to all, and I don't have to debate them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Dialogue_Scheme_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
    <Literal xml:lang="FR">Relativisme abusif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
    <Literal xml:lang="EN">Abusive relativism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
    <Literal xml:lang="FR">Vous affirmez que la vérité est subjective et propre à chaque individu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
    <Literal xml:lang="EN">Claiming that truth is subjective and specific to each individual.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
    <Literal xml:lang="FR">C’est peut-être vrai pour vous, mais cela ne l’est pas pour moi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
    <Literal xml:lang="EN">That may be true for you, but it isn't true for me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
    <Literal xml:lang="EN">http://www.ditext.com/fearnside/9.html#b</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
    <Literal xml:lang="FR">Sophisme subjectiviste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
    <Literal xml:lang="EN">Subjectivist Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
    <Literal xml:lang="FR">Vous affirmez qu’une idée est vraie pour les autres, mais pas pour vous, afin d’éviter de vous l’appliquer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
    <Literal xml:lang="EN">Claiming that a particular idea is true for others but not for oneself, thereby avoiding applying it to oneself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
    <Literal xml:lang="FR">Oui, fumer est mauvais pour la santé, mais pas pour moi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
    <Literal xml:lang="EN">Yes, smoking is bad for health, but not for me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/171/Subjectivist-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truthiness</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truthiness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truthiness</IRI>
    <Literal xml:lang="FR">Truthiness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truthiness</IRI>
    <Literal xml:lang="EN">Truthiness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truthiness</IRI>
    <Literal xml:lang="FR">Vous affirmez qu’une chose est vraie parce que vous la ressentez ainsi, sans preuve concrète.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truthiness</IRI>
    <Literal xml:lang="EN">Asserting something is true because it feels true personally, regardless of the absence of concrete evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truthiness</IRI>
    <Literal xml:lang="FR">Je n’ai pas besoin de statistiques pour savoir que le changement climatique est un mythe : je le vois bien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truthiness</IRI>
    <Literal xml:lang="EN">I don't need statistics to know climate change is a myth: I can see it for myself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truthiness</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Truthiness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truthiness</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Truthiness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truthiness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truthiness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#entitledToMyOpinion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#entitledToMyOpinion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#entitledToMyOpinion</IRI>
    <Literal xml:lang="FR">Droit à mon opinion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#entitledToMyOpinion</IRI>
    <Literal xml:lang="EN">Entitled to my opinion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#entitledToMyOpinion</IRI>
    <Literal xml:lang="FR">Vous prétendez que votre avis vaut autant qu’un fait établi, sans avoir à le justifier.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#entitledToMyOpinion</IRI>
    <Literal xml:lang="EN">Claiming that one's opinion holds as much weight as a proven fact, without the need for justification.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#entitledToMyOpinion</IRI>
    <Literal xml:lang="FR">J’ai le droit de croire que ces médicaments sont plus dangereux qu’utiles. Après tout, chacun a droit à sa propre opinion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#entitledToMyOpinion</IRI>
    <Literal xml:lang="EN">I believe these medicines are more harmful than beneficial. Everyone's entitled to their opinion, after all.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#entitledToMyOpinion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/I%27m_entitled_to_my_opinion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#entitledToMyOpinion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#entitledToMyOpinion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectivistFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongerThanWrong</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongerThanWrong</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongerThanWrong</IRI>
    <Literal xml:lang="FR">Plus faux que faux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongerThanWrong</IRI>
    <Literal xml:lang="EN">Wronger than wrong</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongerThanWrong</IRI>
    <Literal xml:lang="FR">Vous assimilez des erreurs de gravité différente en les présentant comme équivalentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongerThanWrong</IRI>
    <Literal xml:lang="EN">Equating errors of different severity as being identical in nature.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongerThanWrong</IRI>
    <Literal xml:lang="FR">Il a peut-être grillé le feu rouge à cent à l’heure, mais vous traversiez en dehors des clous. Vous avez tous les deux tort.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongerThanWrong</IRI>
    <Literal xml:lang="EN">He may have sped through a red light, but you jaywalked. You're both in the wrong.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongerThanWrong</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Wronger_than_wrong</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongerThanWrong</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongerThanWrong</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusiveRelativism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <Literal xml:lang="FR">Pseudo-explication</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <Literal xml:lang="EN">Pseudo-explanation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <Literal xml:lang="FR">Vous faussez le débat en feignant d’expliquer des faits ou des concepts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <Literal xml:lang="EN">Distorting the debate by pretending to explain facts or concepts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <Literal xml:lang="FR">Peu importe vos arguments : la vraie explication, c’est que nous n’avons pas besoin de ce produit. Tout le monde le sait.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <Literal xml:lang="EN">No matter what your arguments are: the real explanation is that we do not need this product. Everyone knows it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <Literal xml:lang="EN">https://web.archive.org/web/20171215143918/http://www.onegoodmove.org/fallacy/explan_index.htm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
    <Literal xml:lang="FR">Postulat infalsifiable</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
    <Literal xml:lang="EN">Unfalsifiability</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
    <Literal xml:lang="FR">Vous avancez une affirmation impossible à confirmer ou à réfuter, ce qui empêche tout échange rationnel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
    <Literal xml:lang="EN">You make a claim that is impossible to confirm or refute, preventing any rational exchange.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
    <Literal xml:lang="FR">C’est une voix intérieure qui m’a ordonné de faire cela…</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
    <Literal xml:lang="EN">An inner voice ordered me to do that…</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/178/Unfalsifiability</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfsealingArgument</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfsealingArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfsealingArgument</IRI>
    <Literal xml:lang="FR">Argument autocollant</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfsealingArgument</IRI>
    <Literal xml:lang="EN">Self-sealing argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfsealingArgument</IRI>
    <Literal xml:lang="FR">Vous proposez un argument qui reste intact quelles que soient les objections, car il échappe à toute justification.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfsealingArgument</IRI>
    <Literal xml:lang="EN">Proposing an argument that remains unchallenged regardless of objections, as it evades all justification.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfsealingArgument</IRI>
    <Literal xml:lang="FR">Quoi qu’il arrive, cela était destiné à arriver.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfsealingArgument</IRI>
    <Literal xml:lang="EN">Whatever happens was meant to be; there's no arguing with fate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfsealingArgument</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/160/Self-Sealing-Argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfsealingArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfsealingArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#untestability</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#untestability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#untestability</IRI>
    <Literal xml:lang="FR">Impossibilité de test</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#untestability</IRI>
    <Literal xml:lang="EN">Untestability</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#untestability</IRI>
    <Literal xml:lang="FR">Vous présentez une affirmation qui ne peut pas être testée, ce qui la rend indiscutable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#untestability</IRI>
    <Literal xml:lang="EN">Presenting a claim that cannot be empirically tested, thus making it beyond dispute.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#untestability</IRI>
    <Literal xml:lang="FR">C’est parce que mon horoscope m’a prévenu que j’ai pu éviter le pire qu’il annonçait.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#untestability</IRI>
    <Literal xml:lang="EN">Because my horoscope warned me, I was able to avoid the disaster it predicted.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#untestability</IRI>
    <Literal xml:lang="EN">http://www.onegoodmove.org/fallacy/untest.htm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#untestability</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#untestability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfalsifiability</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedDepth</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedDepth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedDepth</IRI>
    <Literal xml:lang="FR">Profondeur limitée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedDepth</IRI>
    <Literal xml:lang="EN">Limited depth</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedDepth</IRI>
    <Literal xml:lang="FR">Vous restez à la surface du sujet au lieu d’examiner suffisamment les causes profondes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedDepth</IRI>
    <Literal xml:lang="EN">Failing to engage with the underlying causes of a phenomenon, thus resorting to superficial assertions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedDepth</IRI>
    <Literal xml:lang="FR">Mon chien fouille dans les poubelles parce que… c’est un chien !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedDepth</IRI>
    <Literal xml:lang="EN">My dog goes through our garbage because, well, that's just what dogs do.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedDepth</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/118/Limited-Depth</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedDepth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedDepth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="FR">Réfutation lapidaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="EN">Appeal to the stone</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="FR">Vous rejetez arbitrairement une proposition sans fournir d’explication ou de preuve.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="EN">Dismissively rejecting a proposition without offering any explanation or evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="FR">Ce que vous affirmez ne peut pas être vrai, parce que cela semble complètement ridicule.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="EN">What you're saying can't be true because it sounds utterly absurd.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argumentum_ad_lapidem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedDepth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedDepth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handwave</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handwave</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handwave</IRI>
    <Literal xml:lang="FR">Balayer d’un revers de main</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handwave</IRI>
    <Literal xml:lang="EN">Handwave</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handwave</IRI>
    <Literal xml:lang="FR">Vous écartez certaines parties de l’argument adverse en les jugeant sans importance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handwave</IRI>
    <Literal xml:lang="EN">Disregarding parts of the opposing argument as unimportant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handwave</IRI>
    <Literal xml:lang="FR">Ne nous attardons pas sur les détails de l’accord. L’essentiel, c’est que nous avancions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handwave</IRI>
    <Literal xml:lang="EN">Let's not dwell on the details of the deal. What matters is that we move forward.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handwave</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Handwave</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handwave</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handwave</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedScope</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedScope</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedScope</IRI>
    <Literal xml:lang="FR">Portée limitée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedScope</IRI>
    <Literal xml:lang="EN">Limited scope</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedScope</IRI>
    <Literal xml:lang="FR">Votre argument n’explique qu’une situation isolée et ne tient pas compte de ses liens avec d’autres éléments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedScope</IRI>
    <Literal xml:lang="EN">Explaining only an isolated situation without considering its connections with other elements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedScope</IRI>
    <Literal xml:lang="FR">Les gens souffrent de schizophrénie parce que leur cerveau dysfonctionne.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedScope</IRI>
    <Literal xml:lang="EN">People suffer from schizophrenia because their brains start to malfunction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedScope</IRI>
    <Literal xml:lang="EN">https://web.archive.org/web/20171229040147/http://www.onegoodmove.org/fallacy/liscope.htm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedScope</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedScope</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unsoundPremise</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unsoundPremise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unsoundPremise</IRI>
    <Literal xml:lang="FR">Fondement erroné</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unsoundPremise</IRI>
    <Literal xml:lang="EN">Unsound premise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unsoundPremise</IRI>
    <Literal xml:lang="FR">Vous appuyez votre argument sur des présupposés faux ou non démontrés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unsoundPremise</IRI>
    <Literal xml:lang="EN">Basing an argument on incorrect or undemonstrated assumptions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unsoundPremise</IRI>
    <Literal xml:lang="FR">La raison pour laquelle la plupart des célibataires sont timides est que leurs mères étaient dominatrices.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unsoundPremise</IRI>
    <Literal xml:lang="EN">The reason why most singles are shy is that their mothers were overbearing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unsoundPremise</IRI>
    <Literal xml:lang="EN">https://web.archive.org/web/20171229034434/http://www.onegoodmove.org/fallacy/nonsup.htm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unsoundPremise</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unsoundPremise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subvertedSupport</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subvertedSupport</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subvertedSupport</IRI>
    <Literal xml:lang="FR">Fondement invalidé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subvertedSupport</IRI>
    <Literal xml:lang="EN">Subverted support</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subvertedSupport</IRI>
    <Literal xml:lang="FR">Vous tentez d’expliquer un phénomène qui, en réalité, ne se produit pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subvertedSupport</IRI>
    <Literal xml:lang="EN">Attempting to explain a phenomenon that, in reality, does not occur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subvertedSupport</IRI>
    <Literal xml:lang="FR">La raison pour laquelle des milliards d’enfants meurent de faim chaque année est que nous vivons dans un monde qui s’en fiche.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subvertedSupport</IRI>
    <Literal xml:lang="EN">The reason billions of children die of hunger every year is because we live in a world that doesn't care.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subvertedSupport</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/172/Subverted-Support</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subvertedSupport</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subvertedSupport</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoexplanation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <Literal xml:lang="FR">Preuve par assertion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <Literal xml:lang="EN">Proof by assertion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <Literal xml:lang="FR">Vous répétez votre point de vue avec insistance au lieu de fournir de véritables preuves ou arguments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <Literal xml:lang="EN">Repeating one's point of view insistently instead of providing real evidence or arguments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <Literal xml:lang="FR">Il est évident que notre futur produit sera un succès mondial ; nul besoin d’étude de marché.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <Literal xml:lang="EN">It's obvious our new product will be a global success, there's no need for market research.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Proof_by_assertion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#refusingDebate</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#OpposedCommitment_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToClarify</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToClarify</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToClarify</IRI>
    <Literal xml:lang="FR">Défaut de clarification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToClarify</IRI>
    <Literal xml:lang="EN">Failure to clarify</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToClarify</IRI>
    <Literal xml:lang="FR">Vous employez des définitions trop complexes qui obscurcissent plutôt qu’elles n’éclairent vos propos.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToClarify</IRI>
    <Literal xml:lang="EN">Using overly complex definitions that obscure rather than clarify what is being said.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToClarify</IRI>
    <Literal xml:lang="FR">Vous dites que l’éther est responsable de ce phénomène. Mais qu’est-ce que l’éther ? C’est un corps subtil et invisible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToClarify</IRI>
    <Literal xml:lang="EN">You say that ether is responsible for this phenomenon. But what is ether? It is a subtle and invisible body.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToClarify</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/85/Failure_to_Elucidate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToClarify</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToClarify</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByFastTalking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByFastTalking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByFastTalking</IRI>
    <Literal xml:lang="FR">Débit trop rapide</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByFastTalking</IRI>
    <Literal xml:lang="EN">Argument by fast talking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByFastTalking</IRI>
    <Literal xml:lang="FR">Vous parlez si vite que vos interlocuteurs n’ont pas le temps de comprendre vos arguments ni d’en repérer les failles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByFastTalking</IRI>
    <Literal xml:lang="EN">You speak so quickly that your audience does not have time to understand your arguments or identify their flaws.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByFastTalking</IRI>
    <Literal xml:lang="FR">Donc je redivise par 5, je passe x de l’autre côté, je mets le tout au carré, je prends la tangente hyperbolique, et je retrouve le même résultat. Vous me suivez ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByFastTalking</IRI>
    <Literal xml:lang="EN">So, I divide by 5, move x to the other side, square the whole thing, take the hyperbolic tangent, and end up at the same result. You got all that?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByFastTalking</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/46/Argument-by-Fast-Talking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByFastTalking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByFastTalking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="FR">Déluge argumentatif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="EN">Spreading</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="FR">Vous parlez extrêmement vite pour présenter un maximum d’arguments en un minimum de temps, ce qui rend difficile, pour l’adversaire, de répondre à tous les points.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="EN">Speaking extremely fast to present as many arguments as possible in the
least amount of time, making it hard for the opponent to respond to all
points.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="FR">Mon adversaire devrait maintenant répondre à mes arguments sur diverses politiques économiques, sociales et environnementales, en tenant compte des implications à court et à long terme, des effets sur les populations vulnérables, des considérations géopolitiques ainsi que des aspects juridiques et éthiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="EN">My opponent should now answer my arguments about various economic, social, and environmental policies,
covering implications in the short and long term, impacts on vulnerable
populations, geopolitical considerations, and legal and ethical aspects.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Spreading_(debate)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByFastTalking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByFastTalking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
    <Literal xml:lang="FR">Argumentum ad nauseam</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
    <Literal xml:lang="EN">Ad nauseam</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
    <Literal xml:lang="FR">Vous répétez votre point de vue à l’excès pour tenter de l’imposer, sans répondre aux objections.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
    <Literal xml:lang="EN">Repeating one's point of view excessively in an attempt to impose it, without responding to objections.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
    <Literal xml:lang="FR">Les produits laitiers sont nos amis pour la vie. Ils sont excellents pour la santé. Ils sont vraiment bons pour nous. Ils nous aident à rester en forme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
    <Literal xml:lang="EN">Dairy products are our friends for life. They are great for your health. Furthermore, they are really good for us. They keep us in shape.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ad_nauseam</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_nauseam</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="FR">Lavage de cerveau</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="EN">Brainwashing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="FR">Vous combinez répétition intensive et manipulation psychologique pour influencer une personne ou modifier radicalement ses opinions et ses croyances.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="EN">Employing a combination of intense repetition and psychological manipulation to influence or drastically change an individual's views and beliefs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="FR">Je comprends que vous soyez sceptique, mais pensez-y chaque soir avant de dormir et vous verrez que ma théorie est la seule qui tient la route.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="EN">I know you're skeptical, but just think about it every night before you sleep, and you'll see that my theory is the only one that makes sense.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Brainwashing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Lavage_de_cerveau</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carthagoDelendaEst</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carthagoDelendaEst</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carthagoDelendaEst</IRI>
    <Literal xml:lang="FR">Delenda Carthago</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carthagoDelendaEst</IRI>
    <Literal xml:lang="EN">Carthago delenda est</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carthagoDelendaEst</IRI>
    <Literal xml:lang="FR">Vous êtes tellement fixé sur une idée que vous la répétez constamment, sans tenir compte des discussions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carthagoDelendaEst</IRI>
    <Literal xml:lang="EN">So fixated on a notion that it's constantly repeated, disregarding ongoing discussions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carthagoDelendaEst</IRI>
    <Literal xml:lang="FR">Que tout cela ne nous détourne pas de notre principal objectif : il faut détruire Carthage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carthagoDelendaEst</IRI>
    <Literal xml:lang="EN">Let's not let this distract us from our main goal: Carthage must be destroyed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carthagoDelendaEst</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Carthago_delenda_est</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carthagoDelendaEst</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Delenda_Carthago</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carthagoDelendaEst</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carthagoDelendaEst</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adNauseam</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="FR">Langage idiosyncratique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="EN">Idiosyncratic language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="FR">Vous attribuez à des termes un sens particulier et inattendu afin d’appuyer votre point de vue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="EN">Assigning a particular, often unexpected meaning to terms to support one's viewpoint.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="FR">Quand je parle de « liberté », je ne parle pas de l’absence de contraintes ; pour moi, c’est la possibilité de choisir parmi les contraintes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="EN">When I talk about 'freedom', I'm not talking about the absence of constraints; it's the ability to choose among constraints.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="EN">http://www.ditext.com/fearnside/51.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
    <Literal xml:lang="FR">Négation de la contre-preuve</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
    <Literal xml:lang="EN">Denying the counterevidence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
    <Literal xml:lang="FR">Au lieu de répondre à une preuve contraire, vous la rejetez entièrement sans justification.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
    <Literal xml:lang="EN">Rejecting contrary evidence completely without justification, instead of responding to it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
    <Literal xml:lang="FR">Ce que vous m’opposez, c’est une étude réalisée par des humains. Mais ma connaissance me vient de Dieu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
    <Literal xml:lang="EN">What you're opposing me with is a study conducted by people. But my knowledge comes from God.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
    <Literal xml:lang="EN">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByPigheadness</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByPigheadness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByPigheadness</IRI>
    <Literal xml:lang="FR">Argument par acharnement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByPigheadness</IRI>
    <Literal xml:lang="EN">Argument by pigheadness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByPigheadness</IRI>
    <Literal xml:lang="FR">Vous persistez à rejeter un argument bien fondé, par entêtement irrationnel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByPigheadness</IRI>
    <Literal xml:lang="EN">Insisting on the rejection of a well-founded argument, showing an irrational stubbornness.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByPigheadness</IRI>
    <Literal xml:lang="FR">Vous pouvez me montrer toutes les études que vous voulez sur le réchauffement climatique. Je n’ai jamais eu aussi froid chez moi que ces dernières semaines, et c’est tout ce qui compte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByPigheadness</IRI>
    <Literal xml:lang="EN">You can show me all the studies you want on climate change. I've never been colder in my house than these past few weeks, and that's all that matters to me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByPigheadness</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#dogged</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByPigheadness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByPigheadness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
    <Literal xml:lang="FR">Dénialisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
    <Literal xml:lang="EN">Denialism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
    <Literal xml:lang="FR">Vous niez la réalité ou le consensus établi pour rester aligné avec vos croyances personnelles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
    <Literal xml:lang="EN">Denying reality or established consensus to remain aligned with one's personal beliefs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
    <Literal xml:lang="FR">La Covid n’est qu’une invention de nos dirigeants pour contrôler nos vies et nous injecter du poison dans le sang.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
    <Literal xml:lang="EN">COVID is just an invention of our rulers to control our lives and inject poison into our bloodstream.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Denialism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/D%C3%A9nialisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByPigheadness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByPigheadness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historicalNegationism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historicalNegationism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historicalNegationism</IRI>
    <Literal xml:lang="FR">Négationnisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historicalNegationism</IRI>
    <Literal xml:lang="EN">Historical negationism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historicalNegationism</IRI>
    <Literal xml:lang="FR">Vous refusez de reconnaître des faits historiques avérés, souvent pour des raisons idéologiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historicalNegationism</IRI>
    <Literal xml:lang="EN">Refusing to acknowledge proven historical facts, often for ideological reasons.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historicalNegationism</IRI>
    <Literal xml:lang="FR">Ces soi-disant « faits historiques » ne sont que des rumeurs amplifiées au fil du temps ; je ne crois que ce que j’ai appris de nos dirigeants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historicalNegationism</IRI>
    <Literal xml:lang="EN">These so-called 'historical facts' are just rumors amplified over time; I only believe what I've learned from our leaders.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historicalNegationism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Historical_negationism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historicalNegationism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/N%C3%A9gationnisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historicalNegationism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historicalNegationism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denialism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensorship</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensorship</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensorship</IRI>
    <Literal xml:lang="FR">Appel à la censure</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensorship</IRI>
    <Literal xml:lang="EN">Appeal to censorship</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensorship</IRI>
    <Literal xml:lang="FR">Vous considérez l’absence contrainte de réponse à un argument comme une acceptation, ignorant l’éthique du débat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensorship</IRI>
    <Literal xml:lang="EN">You consider the forced absence of a response to an argument to be acceptance, disregarding the ethics of debate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensorship</IRI>
    <Literal xml:lang="FR">Notre président n’a pas été épargné durant la séance de questions réponses qu’il a organisé pour la nouvelle année. Pourtant personne n’a contesté sa décision de poursuivre la guerre. Celle-ci fait donc l’unanimité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensorship</IRI>
    <Literal xml:lang="EN">Our president wasn't spared during the question and answer session he organized for the new year. However, nobody challenged his decision to continue the war. Thus, it is assumed to be unanimously supported.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensorship</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_censorship</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensorship</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensorship</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCounterevidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#claimVictoryDespiteDefeat</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#claimVictoryDespiteDefeat</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#claimVictoryDespiteDefeat</IRI>
    <Literal xml:lang="FR">Clamer la victoire malgré la défaite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#claimVictoryDespiteDefeat</IRI>
    <Literal xml:lang="EN">Claim victory despite defeat</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#claimVictoryDespiteDefeat</IRI>
    <Literal xml:lang="FR">Vous prétendez avoir remporté un débat, alors même que vos arguments n’ont pas été convaincants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#claimVictoryDespiteDefeat</IRI>
    <Literal xml:lang="EN">Claiming to have won a debate despite the arguments being unconvincing, often ignoring the substantive issues discussed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#claimVictoryDespiteDefeat</IRI>
    <Literal xml:lang="FR">Notre armée a exécuté avec brio un repli stratégique après avoir infligé de très lourdes pertes à l’ennemi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#claimVictoryDespiteDefeat</IRI>
    <Literal xml:lang="EN">Our army brilliantly executed a strategic retreat after inflicting heavy losses on the enemy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#claimVictoryDespiteDefeat</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Claim_Victory_Despite_Defeat</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#claimVictoryDespiteDefeat</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_XIV</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#claimVictoryDespiteDefeat</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#claimVictoryDespiteDefeat</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goBig(lie)OrGoHome</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goBig(lie)OrGoHome</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goBig(lie)OrGoHome</IRI>
    <Literal xml:lang="FR">Plus c’est gros, plus ça passe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goBig(lie)OrGoHome</IRI>
    <Literal xml:lang="EN">Go big (lie) or go home</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goBig(lie)OrGoHome</IRI>
    <Literal xml:lang="FR">Vous misez sur un mensonge tellement énorme que les gens hésitent à le croire faux, car ils pensent que personne n’oserait mentir à ce point.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goBig(lie)OrGoHome</IRI>
    <Literal xml:lang="EN">Relies on telling a lie so huge that people doubt it can be false, thinking no one would dare to lie that much.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goBig(lie)OrGoHome</IRI>
    <Literal xml:lang="FR">Nous n’avons perdu cette élection qu’à cause d’une fraude massive : le scandale du siècle, avec des complicités à tous les niveaux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goBig(lie)OrGoHome</IRI>
    <Literal xml:lang="EN">We only lost this election due to massive fraud, the scandal of the century that involved complicity at every level.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goBig(lie)OrGoHome</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Big_lie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goBig(lie)OrGoHome</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goBig(lie)OrGoHome</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAssertion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
    <Literal xml:lang="FR">Sabotage du débat</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
    <Literal xml:lang="EN">Sabotage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
    <Literal xml:lang="FR">Vous perturbez le débat pour l’orienter à votre avantage ou pour en limiter la portée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
    <Literal xml:lang="EN">Disrupting the debate to steer it to one's advantage or to limit its scope.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
    <Literal xml:lang="FR">Allons plutôt dans mon bureau discuter de l’absurdité de votre demande d’augmentation…</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
    <Literal xml:lang="EN">Let's move to my office so we can discuss why your request for a raise is absurd.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sabotage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <Literal xml:lang="FR">Évasion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <Literal xml:lang="EN">Evasion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <Literal xml:lang="FR">Vous utilisez un procédé qui vous permet d’éviter de répondre sur le fond.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <Literal xml:lang="EN">Using a procedure that makes it possible to avoid addressing the substance of the debate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <Literal xml:lang="FR">C’est une question intéressante, mais examinons d’abord le contexte plus large…</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <Literal xml:lang="EN">That's an interesting question, but let's first look at this broader context...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Evasion_(ethics)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Dialogue_Scheme_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
    <Literal xml:lang="FR">Fausse piste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
    <Literal xml:lang="EN">Red herring</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
    <Literal xml:lang="FR">Vous détournez le débat de son sujet initial afin d’échapper aux arguments de votre contradicteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
    <Literal xml:lang="EN">Introducing an item that distracts from the original subject of discussion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
    <Literal xml:lang="FR">Avant de me reprocher mon retard, pouvez-vous m’expliquer pourquoi vous vous promenez dans cette tenue ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
    <Literal xml:lang="EN">Before criticizing me for being late, can you explain why you're walking around dressed like that?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Red_herring</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <Literal xml:lang="FR">Changement de sujet</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <Literal xml:lang="EN">Changing the subject</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <Literal xml:lang="FR">Vous détournez l’attention en traitant un sujet totalement différent pour éviter de répondre à la critique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <Literal xml:lang="EN">Diverting attention by introducing an unrelated topic to avoid addressing criticism.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <Literal xml:lang="FR">Parlons plutôt de l’importance de développer l’économie. Nous devons nous concentrer sur la création d’emplois : c’est le sujet le plus urgent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <Literal xml:lang="EN">Let's instead discuss the importance of developing the economy. We should focus on job creation and economic improvement; that's the most pressing issue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#digression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="FR">Digression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="EN">Digression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="FR">Vous déviez du sujet principal pour introduire un thème secondaire, ce qui détourne l’attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="EN">Diverting from the main topic to address a secondary issue, thus shifting the focus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="FR">Avant de parler de l’impact de cette réforme sur les petites entreprises, permettez-moi de rappeler en quelques points clés combien il est essentiel de soutenir l’éducation dans notre pays.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="EN">Before diving into the effects of this reform on small businesses, let me emphasize the critical importance of supporting education in our country.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Digression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Digression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
    <Literal xml:lang="FR">Interrompre et détourner le débat</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
    <Literal xml:lang="EN">Interrupt, Break, Divert the Dispute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
    <Literal xml:lang="FR">Vous empêchez votre adversaire de conclure afin d’éviter qu’il l’emporte, puis vous modifiez le cours du débat à votre avantage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
    <Literal xml:lang="EN">Avoiding an opponent's victory by preventing them from concluding and altering the course of the debate to one's advantage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
    <Literal xml:lang="FR">Permettez-moi de rebondir sur ce que vous venez de dire. N’est-il pas plus urgent de débattre de la disparition des abeilles, qui menace nos écosystèmes ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
    <Literal xml:lang="EN">Allow me to bounce back on what you just said. Isn't it more urgent to debate about the disappearing bees threatening our ecosystems?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Interrupt,_Break,_Divert_the_Dispute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_XVIII</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="FR">Stratégie du chat mort</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="EN">Dead cat strategy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="FR">Vous détournez intentionnellement l’attention des problèmes importants en créant un scandale ou une controverse choquante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="EN">Intentionally diverting attention from significant issues by creating a shocking scandal or controversy.
</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="FR">Mes chers compatriotes, nous allons devoir repousser l’examen de cette loi, car j’ai une nouvelle choquante à partager. Savez-vous qu’un de nos responsables politiques est impliqué dans un scandale de corruption ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="EN">My dear compatriots, we will have to postpone the examination of this law, because I have some shocking news to share. Do you know that one of our politicians is involved in a corruption scandal?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Dead_cat_strategy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interruptBreakDivertTheDispute</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="FR">Changement de terrain</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="EN">Shifting ground</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="FR">Vous modifiez constamment les bases de votre argumentation pour éviter d’admettre une défaite sur un point précis et pour désorienter votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="EN">Constantly modifying the bases of one's argument so as not to admit defeat on any one of them and to disorient the interlocutor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="FR">Vous critiquez ma gestion de projet ? Et que dire de votre retard sur le rapport la semaine dernière ? D’ailleurs, n’oublions pas votre échec lors de la présentation du mois dernier...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="EN">You're questioning my project management? What about your delay on the report last week? And let's not forget your failure in last month's presentation...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="EN">https://leanlogic.online/glossary/shifting-ground/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meaninglessQuestion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meaninglessQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meaninglessQuestion</IRI>
    <Literal xml:lang="FR">Question absurde</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meaninglessQuestion</IRI>
    <Literal xml:lang="EN">Meaningless question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meaninglessQuestion</IRI>
    <Literal xml:lang="FR">Vous posez une question dénuée de pertinence pour créer la confusion et détourner l’attention des véritables enjeux du débat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meaninglessQuestion</IRI>
    <Literal xml:lang="EN">Asking a question that lacks relevance to create confusion and divert attention from the real issues of the debate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meaninglessQuestion</IRI>
    <Literal xml:lang="FR">Comment pouvons-nous attendre de l’économie qu’elle suive les lois de la gravité ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meaninglessQuestion</IRI>
    <Literal xml:lang="EN">How can we expect the economy to follow the laws of gravity?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meaninglessQuestion</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/124/Meaningless-Question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meaninglessQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meaninglessQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#changingTheSubject</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="FR">Équivalence morale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="EN">Moral equivalence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="FR">Vous supposez à tort que deux actions différentes ont la même valeur morale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="EN">Wrongly assuming that two different actions have the same moral value.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="FR">Certains arguent que la vitesse des véhicules devrait être limitée pour la sécurité, mais s’opposer aux voyages spatiaux car ils sont risqués serait ridicule.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="EN">Some argue that vehicle speeds should be limited for safety, but opposing space travel because it is risky would be ridiculous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Moral_equivalence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redHerring</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
    <Literal xml:lang="FR">Privation relative</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
    <Literal xml:lang="EN">Relative privation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
    <Literal xml:lang="FR">Vous argumentez en comparant la situation au meilleur ou au pire scénario possible, afin de détourner l’attention de la question réelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
    <Literal xml:lang="EN">Arguing by comparing with either the best or worst scenarios to deflect from the actual issue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
    <Literal xml:lang="FR">Vous devriez déjà être content d’avoir reçu quelque chose. Beaucoup d’enfants n’ont pas cette chance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
    <Literal xml:lang="EN">You should already be happy to have received something. Many children don't get that chance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/155/Relative-Privation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theWickedAlternative</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theWickedAlternative</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theWickedAlternative</IRI>
    <Literal xml:lang="FR">Mauvaise alternative</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theWickedAlternative</IRI>
    <Literal xml:lang="EN">The Wicked Alternative</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theWickedAlternative</IRI>
    <Literal xml:lang="FR">Vous opposez à une proposition une alternative erronée pour justifier votre point de vue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theWickedAlternative</IRI>
    <Literal xml:lang="EN">Opposing a proposition with a false alternative to justify one's point of view.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theWickedAlternative</IRI>
    <Literal xml:lang="FR">Voyez comme ce pays peine avec son système de santé. Nous devrions être contents de ce que nous avons dans notre pays.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theWickedAlternative</IRI>
    <Literal xml:lang="EN">Look at how this country struggles with its healthcare system. We should be thankful for what we have in our country.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theWickedAlternative</IRI>
    <Literal xml:lang="EN">http://www.ditext.com/fearnside/36.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theWickedAlternative</IRI>
    <Literal xml:lang="FR">http://www.ditext.com/fearnside/36.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theWickedAlternative</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theWickedAlternative</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="FR">Piège de gratitude</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="EN">Gratitude trap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="FR">Vous vous sentez coupable ou frustré parce que vous pensez devoir être plus reconnaissant dans votre situation actuelle, ou vous utilisez ce sentiment chez autrui pour renforcer votre contrôle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="EN">Feeling guilty or frustrated because of thinking one should be more grateful in one's current situation, or using this feeling in others to assert control.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="FR">Je devrais être heureux d’avoir un emploi, même si je le déteste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="EN">I should be happy to have a job, even though I hate it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Gratitude_trap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#relativePrivation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="FR">Sophisme de la double faute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="EN">Two wrongs make a right</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="FR">Vous croyez à tort que deux erreurs combinées peuvent produire un résultat juste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="EN">Erroneously believing that combining two wrongs can produce a right outcome.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="FR">Le patron ne paie pas ses taxes, alors je ne vais pas me gêner pour me servir dans la caisse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="EN">The boss doesn't pay his taxes, so I won't feel guilty about taking some cash from the till.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Two_wrongs_don%27t_make_a_right</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="FR">http://www.ditext.com/fearnside/35.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPopulum</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPopulum</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPopulum</IRI>
    <Literal xml:lang="FR">Raison de la majorité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPopulum</IRI>
    <Literal xml:lang="EN">Ad populum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPopulum</IRI>
    <Literal xml:lang="FR">Vous justifiez une position par le fait qu’elle est partagée par le plus grand nombre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPopulum</IRI>
    <Literal xml:lang="EN">Justifying a position because it is held by the majority.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPopulum</IRI>
    <Literal xml:lang="FR">La plupart des enfants réclament tous les jours des frites à la cantine ; c’est donc ce qu’il faudrait leur servir quotidiennement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPopulum</IRI>
    <Literal xml:lang="EN">Most kids ask for fries every day in the cafeteria; that's what we should serve them daily.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPopulum</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argumentum_ad_populum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPopulum</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPopulum</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <Literal xml:lang="FR">Esquive de la question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <Literal xml:lang="EN">Avoiding the issue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <Literal xml:lang="FR">Vous évitez de répondre à la question posée par votre adversaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <Literal xml:lang="EN">Avoiding an opponent's question by means of diversion or distraction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <Literal xml:lang="FR">Je reçois un appel urgent, je dois répondre. Désolé de ne pas pouvoir vous accorder plus de temps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <Literal xml:lang="EN">Sorry, I have to take this urgent call now, I can't give you more time.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/61/Avoiding-the-Issue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
    <Literal xml:lang="FR">Conclusion non pertinente</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
    <Literal xml:lang="EN">Irrelevant conclusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
    <Literal xml:lang="FR">Vous répondez à côté en prétendant traiter la question posée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
    <Literal xml:lang="EN">Providing an answer that is irrelevant to the question posed, pretending to address it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
    <Literal xml:lang="FR">Ce médicament n’a pas reçu l’autorisation de mise sur le marché. Pourtant, il a été prouvé qu’il n’est pas dangereux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
    <Literal xml:lang="EN">This medication has not been approved for sale. Yet, it's been proven it does no harm.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Irrelevant_conclusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Ignoratio_elenchi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="FR">Restriction mentale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="EN">Mental reservation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="FR">Vous ne dites pas explicitement ce que vous pensez vraiment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="EN">Failing to say what one really thinks.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="FR">C’est une option à laquelle je n’aurais certainement pas pensé, mais vous êtes libre de la proposer...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="EN">That's definitely an option I hadn't considered, yet you're free to suggest it...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Mental_reservation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Restriction_mentale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantConclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chewbaccaDefense</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chewbaccaDefense</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chewbaccaDefense</IRI>
    <Literal xml:lang="FR">Noyer le poisson</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chewbaccaDefense</IRI>
    <Literal xml:lang="EN">Chewbacca defense</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chewbaccaDefense</IRI>
    <Literal xml:lang="FR">Vous inondez la conversation d’un flot d’informations sans rapport pour masquer la faiblesse de votre position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chewbaccaDefense</IRI>
    <Literal xml:lang="EN">Hiding a flaw in one's argument behind large amounts of mostly irrelevant information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chewbaccaDefense</IRI>
    <Literal xml:lang="FR">J’ai eu une mauvaise note, mais on a volé mes billes : Jean a gagné la première, il est allé aux toilettes, et Sandrine m’a demandé mon goûter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chewbaccaDefense</IRI>
    <Literal xml:lang="EN">I got a bad grade, but my marbles were stolen: Jean won the first one, he went to the bathroom, and Sandrine asked me for my snack.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chewbaccaDefense</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Chewbacca_defense</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chewbaccaDefense</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/D%C3%A9fense_Chewbacca</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chewbaccaDefense</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chewbaccaDefense</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="FR">Gish gallop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="EN">Gish gallop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="FR">Vous submergez votre interlocuteur par un flot rapide et continu d’arguments et d’affirmations, ce qui rend difficile une réfutation complète et réfléchie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="EN">Overwhelming an interlocutor with a rapid and continuous flow of arguments and claims, making a thorough and thoughtful refutation difficult.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="FR">Comment pouvez-vous être compétent si vous ne répondez même pas à mes arguments sur la fiscalité, l’éducation, la santé et l’environnement ? Et je n’ai même pas encore abordé la politique étrangère !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="EN">How can you be competent if you don't even respond to my points on taxation, education, health care, and the environment? And I haven't even started on foreign policy yet!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Gish_Gallop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gish_gallop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheQuestion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheQuestion</IRI>
    <Literal xml:lang="FR">Ignorer la question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheQuestion</IRI>
    <Literal xml:lang="EN">Ignoring the question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheQuestion</IRI>
    <Literal xml:lang="FR">Vous évitez de répondre à une question en l’ignorant totalement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheQuestion</IRI>
    <Literal xml:lang="EN">Refusing to respond to a question by completely ignoring it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheQuestion</IRI>
    <Literal xml:lang="FR">Quand on m’a demandé des détails sur le budget, j’ai simplement parlé des avantages du projet, sans donner aucun chiffre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheQuestion</IRI>
    <Literal xml:lang="EN">When I was asked for details about the budget, I simply talked about the project's benefits without giving any figures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheQuestion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Evasion_(ethics)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#avoidingTheIssue</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#acknowledgingTheQuestionWithoutAnsweringIt</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#acknowledgingTheQuestionWithoutAnsweringIt</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#acknowledgingTheQuestionWithoutAnsweringIt</IRI>
    <Literal xml:lang="FR">Reconnaître la question sans répondre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#acknowledgingTheQuestionWithoutAnsweringIt</IRI>
    <Literal xml:lang="EN">Acknowledging the question without answering it</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#acknowledgingTheQuestionWithoutAnsweringIt</IRI>
    <Literal xml:lang="FR">Vous reconnaissez la question posée, mais vous ne fournissez pas de réponse directe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#acknowledgingTheQuestionWithoutAnsweringIt</IRI>
    <Literal xml:lang="EN">Acknowledging the posed question without providing a direct answer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#acknowledgingTheQuestionWithoutAnsweringIt</IRI>
    <Literal xml:lang="FR">Votre question sur les risques de retard est excellente. Maintenant, laissez-moi vous parler des bénéfices de cette méthode.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#acknowledgingTheQuestionWithoutAnsweringIt</IRI>
    <Literal xml:lang="EN">Your question about the risks of delay is excellent. Now, let me tell you about the benefits of this method.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#acknowledgingTheQuestionWithoutAnsweringIt</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Evasion_(ethics)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#acknowledgingTheQuestionWithoutAnsweringIt</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#acknowledgingTheQuestionWithoutAnsweringIt</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <Literal xml:lang="FR">Fausse objection</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <Literal xml:lang="EN">Pretext</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <Literal xml:lang="FR">Vous avancez un prétexte mineur pour éviter d’exposer des raisons plus sérieuses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <Literal xml:lang="EN">Offering a minor pretext to avoid exposing more serious reasons.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <Literal xml:lang="FR">Vous êtes une personne formidable ; je suis sûre que vous trouverez quelqu’un de mieux que moi pour vous accompagner.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <Literal xml:lang="EN">You're a great person, I'm sure you'll find someone better than me to accompany you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pretext</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Fausse_objection</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#evasion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
    <Literal xml:lang="FR">Questionnement de la question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
    <Literal xml:lang="EN">Questioning the question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
    <Literal xml:lang="FR">Vous remettez en cause la question qui vous est posée au lieu d’y répondre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
    <Literal xml:lang="EN">Challenging the question being asked instead of answering it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
    <Literal xml:lang="FR">Pourquoi cette question ? Je vous la retourne : je serais curieux d’en connaître la réponse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
    <Literal xml:lang="EN">Why this question? I ask you the same, I'd be curious to know the answer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Evasion_(ethics)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#requestingClarification</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#requestingClarification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#requestingClarification</IRI>
    <Literal xml:lang="FR">Demander des clarifications</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#requestingClarification</IRI>
    <Literal xml:lang="EN">Requesting clarification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#requestingClarification</IRI>
    <Literal xml:lang="FR">Vous demandez que la question soit reformulée et clarifiée afin de gagner du temps ou de décourager votre adversaire d’insister.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#requestingClarification</IRI>
    <Literal xml:lang="EN">Requesting that the question being asked be reformulated and clarified to stall for time or in hopes of dissuading an opponent from insisting.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#requestingClarification</IRI>
    <Literal xml:lang="FR">Pourriez-vous préciser ce que vous entendez par « succès » dans ce contexte ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#requestingClarification</IRI>
    <Literal xml:lang="EN">Could you clarify what you mean by 'success' in this context?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#requestingClarification</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Evasion_(ethics)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#requestingClarification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#requestingClarification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turningTheQuestionBackOnTheInterlocutor</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turningTheQuestionBackOnTheInterlocutor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turningTheQuestionBackOnTheInterlocutor</IRI>
    <Literal xml:lang="FR">Renvoyer la question à son interlocuteur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turningTheQuestionBackOnTheInterlocutor</IRI>
    <Literal xml:lang="EN">Turning the question back on the interlocutor</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turningTheQuestionBackOnTheInterlocutor</IRI>
    <Literal xml:lang="FR">Vous faites semblant de ne pas saisir l’argument pour éviter d’y répondre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turningTheQuestionBackOnTheInterlocutor</IRI>
    <Literal xml:lang="EN">Pretending not to grasp the argument in order to avoid answering it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turningTheQuestionBackOnTheInterlocutor</IRI>
    <Literal xml:lang="FR">Pourquoi me demandez-vous cela ? Que pensez-vous de la situation ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turningTheQuestionBackOnTheInterlocutor</IRI>
    <Literal xml:lang="EN">Why are you asking me that? What do you think of the situation?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turningTheQuestionBackOnTheInterlocutor</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Evasion_(ethics)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turningTheQuestionBackOnTheInterlocutor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turningTheQuestionBackOnTheInterlocutor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questioningTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
    <Literal xml:lang="FR">Attaque de la question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
    <Literal xml:lang="EN">Attacking the question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
    <Literal xml:lang="FR">Vous remettez en cause la légitimité de la question qui vous est adressée pour ne pas avoir à y répondre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
    <Literal xml:lang="EN">Questioning the legitimacy of the posed question to avoid answering it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
    <Literal xml:lang="FR">Cette question repose sur des hypothèses incorrectes et ne mérite pas de réponse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
    <Literal xml:lang="EN">This question is based on incorrect assumptions and does not warrant an answer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Evasion_(ethics)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAMisquotation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAMisquotation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAMisquotation</IRI>
    <Literal xml:lang="FR">Mise en cause d’une mauvaise citation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAMisquotation</IRI>
    <Literal xml:lang="EN">Invoking a misquotation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAMisquotation</IRI>
    <Literal xml:lang="FR">Vous disqualifiez la question posée en affirmant qu’elle ne reprend pas fidèlement vos propos, ou ceux que vous défendez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAMisquotation</IRI>
    <Literal xml:lang="EN">Disqualifying the question being asked on the grounds that it does not accurately represent one's words or stance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAMisquotation</IRI>
    <Literal xml:lang="FR">Vous me faites dire ce que je n’ai pas dit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAMisquotation</IRI>
    <Literal xml:lang="EN">You are putting words in my mouth that I didn't say.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAMisquotation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Evasion_(ethics)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAMisquotation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAMisquotation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAnIncorrectTranslation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAnIncorrectTranslation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAnIncorrectTranslation</IRI>
    <Literal xml:lang="FR">Mise en cause d’une mauvaise traduction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAnIncorrectTranslation</IRI>
    <Literal xml:lang="EN">Invoking an incorrect translation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAnIncorrectTranslation</IRI>
    <Literal xml:lang="FR">Vous refusez la critique en attribuant une erreur à la traduction, sans vous attaquer au fond du problème.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAnIncorrectTranslation</IRI>
    <Literal xml:lang="EN">Refusing criticism by attributing an error to translation, without addressing the issue itself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAnIncorrectTranslation</IRI>
    <Literal xml:lang="FR">Votre argument pourrait peut-être tenir la route dans votre langue, mais en français, il perd tout son sens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAnIncorrectTranslation</IRI>
    <Literal xml:lang="EN">Your argument might hold up in your language, but in English, it loses all its meaning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAMisquotation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAnIncorrectTranslation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAnIncorrectTranslation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingAMisquotation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="FR">Politiquement correct</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="EN">Political correctness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="FR">Vous rejetez ou détournez un argument au motif qu’il risque de heurter la sensibilité d’une partie de l’auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="EN">Rejecting or diverting an argument on the basis that it may offend part of the audience's sensitivities.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="FR">Ne cherchez pas d’explication du côté des croyances ; la religion relève de la conscience et ne doit donc jamais être critiquée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="EN">Don't look into those people's beliefs. Religion is a matter of conscience and should never be criticized.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/141/Political-Correctness-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Politiquement_correct</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attackingTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
    <Literal xml:lang="FR">Décliner la question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
    <Literal xml:lang="EN">Declining to answer</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
    <Literal xml:lang="FR">Vous refusez explicitement de répondre à la question posée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
    <Literal xml:lang="EN">Explicitly refusing to answer the question posed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
    <Literal xml:lang="FR">Je ne suis pas en mesure de répondre à cette question pour le moment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
    <Literal xml:lang="EN">I am not in a position to answer this question at the moment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Evasion_(ethics)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretext</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thisIsBeyondMe</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thisIsBeyondMe</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thisIsBeyondMe</IRI>
    <Literal xml:lang="FR">Feindre l’incompétence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thisIsBeyondMe</IRI>
    <Literal xml:lang="EN">This is beyond me</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thisIsBeyondMe</IRI>
    <Literal xml:lang="FR">Vous faites semblant de ne pas saisir l’argument pour éviter d’y répondre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thisIsBeyondMe</IRI>
    <Literal xml:lang="EN">Pretending not to understand the argument in order to avoid responding to it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thisIsBeyondMe</IRI>
    <Literal xml:lang="FR">Je ne vois vraiment pas où vous voulez en venir avec cette « théorie ». Cela semble tellement alambiqué que je ne vais même pas essayer de comprendre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thisIsBeyondMe</IRI>
    <Literal xml:lang="EN">I really don't see where you're going with this 'theory'. It seems so convoluted that I'm not even going to try to understand.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thisIsBeyondMe</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#This_is_Beyond_Me</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thisIsBeyondMe</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_XXXI</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thisIsBeyondMe</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thisIsBeyondMe</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="FR">Renvoyer la balle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="EN">Buck passing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="FR">Vous attribuez à une autre personne ou à un groupe une responsabilité qui vous revient en réalité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="EN">Attributing to another person or group a responsibility that is actually one's own.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="FR">Si nous avons échoué, c’est parce que l’équipe a fait preuve de nonchalance et n’a pas suivi mes directives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="EN">If we failed, it's because the team was complacent and didn't follow my directions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Buck_passing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decliningToAnswer</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
    <Literal xml:lang="FR">Complication exagérée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
    <Literal xml:lang="EN">Overcomplicating</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
    <Literal xml:lang="FR">Vous complexifiez volontairement le débat afin d’empêcher toute résolution claire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
    <Literal xml:lang="EN">Deliberately complicating the discussion to prevent reaching a clear resolution.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
    <Literal xml:lang="FR">Je ne vois pas comment on pourrait discuter de ce sujet, il y a de toute façon beaucoup trop de variables à prendre en compte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
    <Literal xml:lang="EN">I do not see how we could discuss this topic; in any case, there are far too many variables to take into account.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_XVII</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
    <Literal xml:lang="FR">Méthode hypercritique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
    <Literal xml:lang="EN">Hypercritical method</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
    <Literal xml:lang="FR">Vous critiquez de manière disproportionnée pour embarrasser votre interlocuteur et éviter le fond du problème.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
    <Literal xml:lang="EN">Criticizing disproportionately in order to embarrass one's interlocutor and avoid the substance of the issue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
    <Literal xml:lang="FR">Comment pouvez-vous être absolument certain que cela s’est passé exactement comme vous le décrivez ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
    <Literal xml:lang="EN">How can you be absolutely certain that it happened exactly as you describe it?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/overcritical</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/M%C3%A9thode_hypercritique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExpertise</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExpertise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExpertise</IRI>
    <Literal xml:lang="FR">Appel à l’expertise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExpertise</IRI>
    <Literal xml:lang="EN">Appeal to Expertise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExpertise</IRI>
    <Literal xml:lang="FR">Vous exigez une expertise spécifique pour discréditer l’avis de tout interlocuteur non spécialiste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExpertise</IRI>
    <Literal xml:lang="EN">Demanding specific expertise to discredit any non-specialist's opinion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExpertise</IRI>
    <Literal xml:lang="FR">À moins que vous ne soyez un climatologue, votre opinion ne compte pas sur ces questions très complexes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExpertise</IRI>
    <Literal xml:lang="EN">Unless you are a climatologist, your opinion does not count on these complex issues.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExpertise</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExpertise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de l’examen sur-le-champ</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="EN">On the spot fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="FR">Vous jugez votre interlocuteur incompétent s’il ne peut pas citer immédiatement des données précises ou des détails techniques sur un sujet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="EN">Considering an interlocutor incompetent if unable to recite specific data or technical details on a topic.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="FR">Si vous ne pouvez pas me citer les dernières statistiques sur la croissance économique, alors votre point de vue sur la politique économique n’est pas valable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="EN">If you can't quote the latest economic growth statistics, then your views on economic policy are invalid.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/On_the_spot_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExpertise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExpertise</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="FR">Justification infinie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="EN">Infinite regress</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="FR">Vous demandez sans cesse davantage d’explications, tout en évitant d’arriver à une conclusion claire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="EN">Constantly demanding further explanations while avoiding reaching a clear conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="FR">Mais pourquoi ? Et d’où vient cette information ? Et pourquoi devrais-je croire cette source ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="EN">But why? And where does that information come from? And why should I trust that source?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Infinite_regress</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/R%C3%A9gression_%C3%A0_l%27infini</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypercriticalMethod</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="FR">Solution parfaite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="EN">Nirvana fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="FR">Vous rejetez les solutions réalistes en demandant un idéal inatteignable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="EN">Rejecting realistic solutions by demanding an unattainable ideal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="FR">Je suis opposée au port obligatoire de la ceinture de sécurité, car cette mesure n’empêche pas tous les accidents de la route.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="EN">I am opposed to the mandatory wearing of seatbelts because this measure does not prevent road accidents altogether.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Nirvana_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialObjections</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialObjections</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialObjections</IRI>
    <Literal xml:lang="FR">Objection triviale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialObjections</IRI>
    <Literal xml:lang="EN">Trivial objections</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialObjections</IRI>
    <Literal xml:lang="FR">Vous soulevez des objections mineures pour affaiblir les arguments avancés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialObjections</IRI>
    <Literal xml:lang="EN">Raising minor objections to undermine significant arguments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialObjections</IRI>
    <Literal xml:lang="FR">Vous me dites que marcher jusqu’au supermarché est bon pour la santé, mais cela ne m’intéresse pas, car je ne vais jamais au supermarché.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialObjections</IRI>
    <Literal xml:lang="EN">You say walking to the supermarket is healthy, but I don't care because I never go to the supermarket.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialObjections</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Trivial_objections</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialObjections</IRI>
    <Literal xml:lang="FR">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialObjections</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialObjections</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overcomplicating</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <Literal xml:lang="FR">Empoisonnement du puits</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <Literal xml:lang="EN">Poisoning the well</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <Literal xml:lang="FR">Vous discréditez l’autre partie au moyen d’informations préjudiciables afin d’affaiblir sa position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <Literal xml:lang="EN">Discrediting the other party through prejudicial information in order to weaken their position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <Literal xml:lang="FR">Est-il besoin de vous rappeler que la chirurgie vasculaire a été développée par un sympathisant nazi ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <Literal xml:lang="EN">Should we be reminded that vascular surgery was developed by a Nazi sympathizer?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Poisoning_the_well</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Empoisonner_le_puits</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sabotage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justAskingQuestions</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justAskingQuestions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justAskingQuestions</IRI>
    <Literal xml:lang="FR">Se contenter de poser des questions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justAskingQuestions</IRI>
    <Literal xml:lang="EN">Just asking questions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justAskingQuestions</IRI>
    <Literal xml:lang="FR">Vous posez des questions qui insinuent une accusation pour suggérer une faute sans la nommer directement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justAskingQuestions</IRI>
    <Literal xml:lang="EN">Asking questions that insinuate an accusation to suggest wrongdoing without directly naming it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justAskingQuestions</IRI>
    <Literal xml:lang="FR">N’est-il pas étrange que tous les produits défectueux viennent de votre atelier ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justAskingQuestions</IRI>
    <Literal xml:lang="EN">Isn't it strange that all the faulty products come from your workshop?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justAskingQuestions</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/JAQing_off</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justAskingQuestions</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justAskingQuestions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuadeTheAudience</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuadeTheAudience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuadeTheAudience</IRI>
    <Literal xml:lang="FR">Convaincre le public plutôt que l’adversaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuadeTheAudience</IRI>
    <Literal xml:lang="EN">Persuade the audience</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuadeTheAudience</IRI>
    <Literal xml:lang="FR">Vous avancez des objections qui ne visent pas à convaincre votre interlocuteur, mais à influencer l’auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuadeTheAudience</IRI>
    <Literal xml:lang="EN">Advancing objections which, without convincing one's interlocutor, aim to influence the audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuadeTheAudience</IRI>
    <Literal xml:lang="FR">Voyez-vous, ce genre d’argument est exactement ce que l’on attend de quelqu’un qui ne se soucie pas vraiment du bien-être de notre communauté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuadeTheAudience</IRI>
    <Literal xml:lang="EN">You see, this kind of argument is exactly what we would expect from someone who has no real interest in the wellbeing of our community.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuadeTheAudience</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Persuade_the_Audience,_Not_The_Opponent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuadeTheAudience</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_XXVIII</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuadeTheAudience</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuadeTheAudience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="FR">Projection psychologique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="EN">Psychological projection</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="FR">Vous attribuez à votre adversaire vos propres défauts pour détourner l’attention de vos erreurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="EN">Attributing one's own flaws to an opponent to divert attention from one's errors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="FR">Il n’est pas surprenant que vous m’accusiez de fuir le sujet : après tout, c’est exactement ce que ferait quelqu’un qui manque d’arguments, comme vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="EN">It's not surprising that you accuse me of avoiding the subject: after all, that is exactly what someone who lacks arguments would do, like you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Psychological_projection</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darvo</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darvo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darvo</IRI>
    <Literal xml:lang="FR">DARVO</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darvo</IRI>
    <Literal xml:lang="EN">Darvo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darvo</IRI>
    <Literal xml:lang="FR">Vous niez l’abus commis, puis vous accusez la victime d’en être responsable ou d’être elle-même l’agresseuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darvo</IRI>
    <Literal xml:lang="EN">Denying the abuse committed, then accusing the victim of being responsible for it or of being the aggressor themselves.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darvo</IRI>
    <Literal xml:lang="FR">Je n’ai jamais fait une telle chose. C’est plutôt vous qui créez une atmosphère toxique ici. En m’accusant faussement, c’est vous qui me harcelez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darvo</IRI>
    <Literal xml:lang="EN">I've never done such a thing. It's actually you who's creating a toxic atmosphere here. By falsely accusing me, you're the one harassing me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darvo</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/DARVO</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darvo</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darvo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
    <Literal xml:lang="FR">Arguments factices</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
    <Literal xml:lang="EN">False propositions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
    <Literal xml:lang="FR">Vous inventez des arguments qui semblent suivre la logique de votre opposant, mais qui sont en réalité fallacieux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
    <Literal xml:lang="EN">Inventing arguments that seem to fit an opponent's logic but are actually fallacious.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
    <Literal xml:lang="FR">Certains disent que ma politique augmenterait les taxes, mais qu’en est-il de l’augmentation des dépenses de santé qu’elle prévoit d’éviter ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
    <Literal xml:lang="EN">Some say my policy would increase taxes, but what about the healthcare spending it aims to prevent?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#False_Propositions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_V</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisoningTheWell</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurdPropositions</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurdPropositions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurdPropositions</IRI>
    <Literal xml:lang="FR">Utiliser des arguments absurdes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurdPropositions</IRI>
    <Literal xml:lang="EN">Absurd propositions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurdPropositions</IRI>
    <Literal xml:lang="FR">Vous proposez à votre adversaire une idée absurde, ce qui le place dans une position inconfortable quelle que soit sa réponse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurdPropositions</IRI>
    <Literal xml:lang="EN">Offering an opponent an absurd idea, putting them in an uncomfortable position regardless of their response.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurdPropositions</IRI>
    <Literal xml:lang="FR">Donc, si vous n’êtes pas d’accord avec la peine de mort, vous seriez prêt à libérer tous les meurtriers ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurdPropositions</IRI>
    <Literal xml:lang="EN">So, if you disagree with the death penalty, would you be willing to release all murderers?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurdPropositions</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Use_Seemingly_Absurd_Propositions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurdPropositions</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_XV</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurdPropositions</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurdPropositions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingABadCounterargument</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingABadCounterargument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingABadCounterargument</IRI>
    <Literal xml:lang="FR">Répondre par de mauvais arguments</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingABadCounterargument</IRI>
    <Literal xml:lang="EN">Using a bad counter-argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingABadCounterargument</IRI>
    <Literal xml:lang="FR">Vous répliquez à un argument faible par une contre-argumentation tout aussi discutable, privilégiant la victoire sur la vérité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingABadCounterargument</IRI>
    <Literal xml:lang="EN">Replying to a weak argument with an equally disputable counter-argument, prioritizing victory over truth.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingABadCounterargument</IRI>
    <Literal xml:lang="FR">Vous disqualifiez ma proposition à cause de mon soi-disant manque d’expérience, mais voulez-vous que l’on parle de votre âge avancé ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingABadCounterargument</IRI>
    <Literal xml:lang="EN">You disqualify my proposal for my so-called lack of experience, but shall we talk about your advanced age?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingABadCounterargument</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Meet_him_With_a_Counter-Argument_as_Bad_as_His</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingABadCounterargument</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_XXI</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingABadCounterargument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingABadCounterargument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePropositions</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <Literal xml:lang="FR">Ad hominem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <Literal xml:lang="EN">Ad hominem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <Literal xml:lang="FR">Vous visez votre adversaire lui-même plutôt que de contester ses arguments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <Literal xml:lang="EN">Targeting the opponent themself rather than challenging their arguments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <Literal xml:lang="FR">Comment pouvez-vous prétendre que votre politique de santé fonctionnera quand vous n’avez même pas réussi à arrêter de fumer ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <Literal xml:lang="EN">How can you claim that your health policy will work when you have not even managed to quit smoking?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ad_hominem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_hominem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obstruction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Ethotic_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <Literal xml:lang="FR">Procès en incohérence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <Literal xml:lang="EN">Accusation of inconsistency</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <Literal xml:lang="FR">Vous relevez les incohérences ou les contradictions de votre interlocuteur, ou vous lui opposez des arguments erronés qui peuvent néanmoins lui sembler valides.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <Literal xml:lang="EN">Pointing out inconsistencies or contradictions in an interlocutor, or opposing them with erroneous arguments that may nevertheless seem valid to them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <Literal xml:lang="FR">À t’entendre, tout achat est immoral. Pourtant je t’ai vu faire les soldes l’autre jour, et ma morale le tolère.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <Literal xml:lang="EN">To hear you tell it, every purchase is immoral. Yet I saw you shopping the sales the other day, and my morality allows it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <Literal xml:lang="EN">http://www.dougwalton.ca/papers%20in%20pdf/04historical.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="FR">Tu quoque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="EN">Tu quoque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="FR">Vous rejetez ce que dit quelqu’un en affirmant qu’il n’agit pas toujours conformément à ses propres principes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="EN">Discrediting the opponent's position by asserting the opponent's failure to act consistently in accordance with that position</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="FR">Comment peut-on prendre au sérieux ce que Jean-Jacques Rousseau écrit sur l’éducation des enfants, alors qu’il a abandonné les siens ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="EN">How can we take Jean-Jacques Rousseau's writings on child education seriously when he abandoned his own children?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Tu_quoque?oldid=625341405</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_hominem#Tu_quoque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whataboutism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whataboutism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whataboutism</IRI>
    <Literal xml:lang="FR">Whataboutisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whataboutism</IRI>
    <Literal xml:lang="EN">Whataboutism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whataboutism</IRI>
    <Literal xml:lang="FR">Vous détournez les critiques en rappelant à votre adversaire qu’il n’a pas condamné une situation similaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whataboutism</IRI>
    <Literal xml:lang="EN">Redirecting critique by highlighting the opponent's hypocrisy or failure to condemn a similar issue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whataboutism</IRI>
    <Literal xml:lang="FR">Si vous vous préoccupez tant de ma santé, pourquoi l’autorisez-vous, lui, à fumer ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whataboutism</IRI>
    <Literal xml:lang="EN">If you care so much about my health, why do you allow him to smoke?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whataboutism</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Whataboutism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whataboutism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whataboutism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#critiqueOfPastInconsistency</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#critiqueOfPastInconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#critiqueOfPastInconsistency</IRI>
    <Literal xml:lang="FR">Critique de l’incohérence passée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#critiqueOfPastInconsistency</IRI>
    <Literal xml:lang="EN">Critique of Past Inconsistency</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#critiqueOfPastInconsistency</IRI>
    <Literal xml:lang="FR">Vous accusez votre contradicteur d’avoir changé d’opinion au fil du temps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#critiqueOfPastInconsistency</IRI>
    <Literal xml:lang="EN">Arguing that an opponent has opinions that change with time.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#critiqueOfPastInconsistency</IRI>
    <Literal xml:lang="FR">Vous déplorez la surpopulation mondiale, et pourtant vous voilà père de deux enfants !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#critiqueOfPastInconsistency</IRI>
    <Literal xml:lang="EN">You were saying that there are too many humans on the planet and now you have two children.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#critiqueOfPastInconsistency</IRI>
    <Literal xml:lang="EN">http://www.dougwalton.ca/papers%20in%20pdf/04historical.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#critiqueOfPastInconsistency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#critiqueOfPastInconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="FR">Homme de paille</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="EN">Straw man</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="FR">Vous caricaturez l’argument de l’autre afin de pouvoir le réfuter plus facilement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="EN">Drawing a grotesque picture of an opponent's thesis in order to criticize it easily.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="FR">Ah, donc selon vous, nous devrions passer toutes nos journées à fouiller dans les poubelles pour trier les déchets ? Ce n’est pas une vie !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="EN">Oh, so you suggest we should spend all our days sifting through garbage to sort waste? That's no way to live!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Straw_man</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/%C3%89pouvantail_(rh%C3%A9torique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theExtension</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theExtension</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theExtension</IRI>
    <Literal xml:lang="FR">Extension</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theExtension</IRI>
    <Literal xml:lang="EN">The extension</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theExtension</IRI>
    <Literal xml:lang="FR">Vous poussez l’argument de quelqu’un jusqu’à l’absurde pour le rendre inacceptable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theExtension</IRI>
    <Literal xml:lang="EN">Pushing someone's argument to an illogical extreme to render it absurd.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theExtension</IRI>
    <Literal xml:lang="FR">Vous soutenez que la censure est parfois nécessaire ; j’imagine donc que vous seriez d’accord pour me censurer moi-même dès maintenant, n’est-ce pas ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theExtension</IRI>
    <Literal xml:lang="EN">You argue that censorship is sometimes necessary, so I suppose you're fine with censoring me right now, aren't you?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theExtension</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#The_Extension</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theExtension</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_I</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theExtension</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theExtension</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingFalseConclusions</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingFalseConclusions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingFalseConclusions</IRI>
    <Literal xml:lang="FR">Tirer de fausses conclusions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingFalseConclusions</IRI>
    <Literal xml:lang="EN">Drawing false conclusions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingFalseConclusions</IRI>
    <Literal xml:lang="FR">Vous tirez à tort une conclusion de la thèse de votre adversaire en en déformant l’esprit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingFalseConclusions</IRI>
    <Literal xml:lang="EN">Drawing a false conclusion from an opponent's thesis by distorting its spirit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingFalseConclusions</IRI>
    <Literal xml:lang="FR">Vous critiquez les retards des trains ; vous voulez donc qu’ils partent sans respecter les horaires ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingFalseConclusions</IRI>
    <Literal xml:lang="EN">You criticize train delays; so you want them to depart without respecting the timetable?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingFalseConclusions</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#State_a_False_Syllogism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingFalseConclusions</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_XXIV</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingFalseConclusions</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingFalseConclusions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
    <Literal xml:lang="FR">Invocation fallacieuse des sophismes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
    <Literal xml:lang="EN">Calling "Cards"</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
    <Literal xml:lang="FR">Vous attribuez à votre adversaire des procédés fallacieux qu’il n’a pas réellement employés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
    <Literal xml:lang="EN">Attributing fictitious fallacious arguments to an opponent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
    <Literal xml:lang="FR">Vous cherchez à me manipuler par les sentiments et vous me demandez de démontrer plus que nécessaire. Je ne tomberai pas dans votre combine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
    <Literal xml:lang="EN">You are trying to manipulate me through emotion and asking me to prove more than necessary. I will not fall for your scheme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
    <Literal xml:lang="EN">http://utminers.utep.edu/omwilliamson/ENGL1311/fallacies.htm#31</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accusationOfInconsistency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#petitioPrincipii</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#petitioPrincipii</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#petitioPrincipii</IRI>
    <Literal xml:lang="FR">Accusation de petitio principii</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#petitioPrincipii</IRI>
    <Literal xml:lang="EN">Petitio principii</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#petitioPrincipii</IRI>
    <Literal xml:lang="FR">Vous refusez d’accepter le principe qui fonde l’argument de votre adversaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#petitioPrincipii</IRI>
    <Literal xml:lang="EN">Rejecting the foundational principle of an opponent's argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#petitioPrincipii</IRI>
    <Literal xml:lang="FR">Vous affirmez que notre activité augmente le niveau de CO2, ce qui réchauffe l’atmosphère. Mais vous présupposez précisément le lien entre activité humaine et climat que vous prétendez prouver.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#petitioPrincipii</IRI>
    <Literal xml:lang="EN">You claim that our activity increases CO2, warming up the atmosphere. But you're assuming the very link between human activity and climate that you purport to prove.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#petitioPrincipii</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Petitio_principii</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#petitioPrincipii</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_XXII</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#petitioPrincipii</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#petitioPrincipii</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathosGambit</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathosGambit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathosGambit</IRI>
    <Literal xml:lang="FR">Argument du pathos</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathosGambit</IRI>
    <Literal xml:lang="EN">Pathos gambit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathosGambit</IRI>
    <Literal xml:lang="FR">Vous présentez votre adversaire comme irrationnel et guidé par ses émotions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathosGambit</IRI>
    <Literal xml:lang="EN">Portraying an opponent as irrational and overly emotional.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathosGambit</IRI>
    <Literal xml:lang="FR">Vos critiques sur le manque de diversité dans notre entreprise semblent relever davantage de votre frustration personnelle que d’une analyse objective.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathosGambit</IRI>
    <Literal xml:lang="EN">Your criticism of the lack of diversity in our company seems more like a result of your personal frustration than an objective analysis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathosGambit</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Pathos_gambit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathosGambit</IRI>
    <Literal xml:lang="FR">http://rationalwiki.org/wiki/Pathos_gambit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathosGambit</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathosGambit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#calling"Cards"</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="FR">Sophisme génétique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="EN">Genetic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="FR">Vous rejetez une idée en critiquant son origine plutôt que son contenu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="EN">Rejecting an idea by criticizing its origin rather than its content.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="FR">Je ne vais tout de même pas suivre les conseils d’un Américain pour choisir mon vin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="EN">I won't take advice on selecting wine from an American.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Genetic_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme_g%C3%A9n%C3%A9tique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <Literal xml:lang="FR">Culpabilité par association</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <Literal xml:lang="EN">Guilt by association</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <Literal xml:lang="FR">Vous attribuez à une personne ou à une idée les qualités négatives d’une autre, simplement parce qu’elles ont un point commun.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <Literal xml:lang="EN">You attribute the negative qualities of one person or idea to another simply because they have something in common.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <Literal xml:lang="FR">Ce garçon est ami avec les élèves les plus bavards de la classe ; il est donc nécessaire de le garder à l’œil.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <Literal xml:lang="EN">This boy is friends with the most talkative students in the class; he therefore needs to be kept under watch.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/guiltbya.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reductioAdHitlerum</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reductioAdHitlerum</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reductioAdHitlerum</IRI>
    <Literal xml:lang="FR">Reductio ad Hitlerum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reductioAdHitlerum</IRI>
    <Literal xml:lang="EN">Reductio ad Hitlerum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reductioAdHitlerum</IRI>
    <Literal xml:lang="FR">Vous disqualifiez un argument en l’associant injustement à Hitler ou au nazisme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reductioAdHitlerum</IRI>
    <Literal xml:lang="EN">Discarding an argument by unjustly associating it with Hitler or Nazism.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reductioAdHitlerum</IRI>
    <Literal xml:lang="FR">Votre argument sur la régulation est exactement ce qu’Hitler aurait dit !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reductioAdHitlerum</IRI>
    <Literal xml:lang="EN">Your argument about regulation is exactly what Hitler would have said!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reductioAdHitlerum</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/adnazium.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reductioAdHitlerum</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Reductio_ad_Hitlerum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reductioAdHitlerum</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reductioAdHitlerum</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redbaiting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redbaiting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redbaiting</IRI>
    <Literal xml:lang="FR">Appel au drapeau rouge</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redbaiting</IRI>
    <Literal xml:lang="EN">Red-baiting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redbaiting</IRI>
    <Literal xml:lang="FR">Vous discréditez quelqu’un en l’accusant sans fondement d’être communiste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redbaiting</IRI>
    <Literal xml:lang="EN">Discrediting someone by groundlessly accusing them of being a communist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redbaiting</IRI>
    <Literal xml:lang="FR">Seul un communiste endoctriné pourrait remettre en question les mérites de notre économie de marché.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redbaiting</IRI>
    <Literal xml:lang="EN">Only a brainwashed communist could question the merits of our market economy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redbaiting</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Red-baiting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redbaiting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#redbaiting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pinkbaiting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pinkbaiting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pinkbaiting</IRI>
    <Literal xml:lang="FR">Appel au drapeau rose</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pinkbaiting</IRI>
    <Literal xml:lang="EN">Pink-baiting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pinkbaiting</IRI>
    <Literal xml:lang="FR">Pour vous disculper ou discréditer votre adversaire, vous accusez les homosexuels d’être responsables de toutes sortes de maux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pinkbaiting</IRI>
    <Literal xml:lang="EN">Attempting to discredit an opponent or excuse oneself by accusing homosexuals of being responsible for various societal issues.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pinkbaiting</IRI>
    <Literal xml:lang="FR">L’influence de certaines minorités dans notre ville conduit à l’effritement de nos traditions familiales.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pinkbaiting</IRI>
    <Literal xml:lang="EN">The influence of certain minorities in our city is leading to the erosion of our family traditions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pinkbaiting</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Pink-baiting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pinkbaiting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pinkbaiting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorismbaiting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorismbaiting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorismbaiting</IRI>
    <Literal xml:lang="FR">Appel au terrorisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorismbaiting</IRI>
    <Literal xml:lang="EN">Terrorism-baiting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorismbaiting</IRI>
    <Literal xml:lang="FR">Vous discréditez votre adversaire en l’associant faussement à une organisation terroriste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorismbaiting</IRI>
    <Literal xml:lang="EN">Discrediting an opponent by falsely associating them with a terrorist organization.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorismbaiting</IRI>
    <Literal xml:lang="FR">En refusant de soutenir cette guerre, vous vous rangez du côté de ceux qui n’hésitent pas à terroriser des innocents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorismbaiting</IRI>
    <Literal xml:lang="EN">By refusing to support this war, you're siding with those who don't hesitate to terrorize innocents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorismbaiting</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Terrorism-baiting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorismbaiting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#terrorismbaiting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antienvironmentalism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antienvironmentalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antienvironmentalism</IRI>
    <Literal xml:lang="FR">Appel au drapeau vert</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antienvironmentalism</IRI>
    <Literal xml:lang="EN">Anti-environmentalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antienvironmentalism</IRI>
    <Literal xml:lang="FR">Vous ne prenez pas au sérieux la protection de l’environnement et rejetez tout argument en faveur de celle-ci.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antienvironmentalism</IRI>
    <Literal xml:lang="EN">Belittling environmental protection efforts and rejecting any arguments in favor of it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antienvironmentalism</IRI>
    <Literal xml:lang="FR">À ce rythme, les écolos vont bientôt nous faire vivre dans des huttes et manger de l’herbe !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antienvironmentalism</IRI>
    <Literal xml:lang="EN">Next thing we know, the environmentalists will have us living in huts and eating grass!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antienvironmentalism</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Anti-environmentalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antienvironmentalism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antienvironmentalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="FR">Appel à l’identité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="EN">Appeal to identity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="FR">Sans examiner son bien-fondé, vous évaluez la validité d’une proposition selon la communauté à laquelle appartient son auteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="EN">Judging the validity of a proposal based on the identity of its author's community, without considering its merits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="FR">Ces idées sur l’égalité des revenus ? Elles ne peuvent venir que de gens qui n’ont jamais eu à travailler dur dans leur vie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="EN">These ideas about income equality? They can only come from people who have never had to work hard in their lives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_identity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
    <Literal xml:lang="FR">Déshumanisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
    <Literal xml:lang="EN">Dehumanization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
    <Literal xml:lang="FR">Vous déniez les qualités humaines de certaines personnes ou groupes, les traitant comme inférieurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
    <Literal xml:lang="EN">Denying the human qualities of certain people or groups, treating them as inferior.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
    <Literal xml:lang="FR">Ce groupe de personnes n’est rien d’autre qu’une horde sauvage, ils ne méritent pas notre compassion ou notre respect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
    <Literal xml:lang="EN">This group of people are nothing more than a savage horde, they do not deserve our compassion or respect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Dehumanization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/D%C3%A9shumanisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltByAssociation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demonization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demonization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demonization</IRI>
    <Literal xml:lang="FR">Diabolisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demonization</IRI>
    <Literal xml:lang="EN">Demonization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demonization</IRI>
    <Literal xml:lang="FR">Vous discréditez une personne en l’associant à des images ou à des idées malveillantes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demonization</IRI>
    <Literal xml:lang="EN">Attempting to discredit someone by associating them with malevolent images or ideas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demonization</IRI>
    <Literal xml:lang="FR">Comment une personne qui supporte un groupe extrémiste pourrait-elle émettre une opinion valable sur la justice sociale ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demonization</IRI>
    <Literal xml:lang="EN">How can someone who supports an extremist group have a valid opinion on social justice?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demonization</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Demonizing_the_enemy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demonization</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Diabolisation_de_l%27ennemi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demonization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demonization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dehumanization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <Literal xml:lang="FR">Appel au parti pris</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <Literal xml:lang="EN">Circumstantial ad hominem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <Literal xml:lang="FR">Vous mettez en avant des éléments liés au passé ou aux convictions de votre adversaire pour le discréditer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <Literal xml:lang="EN">Arguing against an opponent by highlighting aspects of their background or beliefs to discredit their argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <Literal xml:lang="FR">Fred a tort d’affirmer que les prisonniers peuvent se réinsérer dans la société, car c’est un ancien prisonnier repenti.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <Literal xml:lang="EN">Fred is wrong to claim that prisoners can reintegrate into society, because he is a reformed ex-convict.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ad_hominem#Circumstantial</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_hominem#Circumstanti.C3.A6</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
    <Literal xml:lang="FR">Appel au motif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
    <Literal xml:lang="EN">Appeal to motive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
    <Literal xml:lang="FR">Vous remettez en question un argument en suggérant que son auteur pourrait avoir des motifs cachés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
    <Literal xml:lang="EN">Questioning an argument by suggesting that its proponent may have hidden motives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
    <Literal xml:lang="FR">L’arbitre vient du même village que l’équipe adverse ; il est donc normal qu’il les ait avantagés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
    <Literal xml:lang="EN">The referee comes from the same village as the opposing team, so it is only natural that he favored them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_motive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Procès_d%27intention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shillGambit</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shillGambit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shillGambit</IRI>
    <Literal xml:lang="FR">Tactique du complice</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shillGambit</IRI>
    <Literal xml:lang="EN">Shill gambit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shillGambit</IRI>
    <Literal xml:lang="FR">Vous rejetez les arguments de votre adversaire en le présentant comme étant à la solde d’une agence ou d’une organisation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shillGambit</IRI>
    <Literal xml:lang="EN">Rejecting an opponent's arguments by declaring them to be in the pay of an agency or organization.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shillGambit</IRI>
    <Literal xml:lang="FR">Ce scientifique ne peut pas être objectif dans ses recherches sur le climat, car il est financé par le lobby pétrolier.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shillGambit</IRI>
    <Literal xml:lang="EN">This scientist cannot be objective in his climate research, as he is funded by the petroleum lobby.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shillGambit</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Shill_gambit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shillGambit</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shillGambit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMotive</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBias</IRI>
    <Literal xml:lang="FR">Appel au biais</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBias</IRI>
    <Literal xml:lang="EN">Appeal to bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBias</IRI>
    <Literal xml:lang="FR">Vous discréditez l’argument de votre adversaire en le présentant comme biaisé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBias</IRI>
    <Literal xml:lang="EN">Discrediting an opponent's argument by presenting it as biased.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBias</IRI>
    <Literal xml:lang="FR">Les journalistes de ce média sont tous de gauche ; évidemment, ils ne feront donc pas de reportages objectifs sur des politiciens de droite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBias</IRI>
    <Literal xml:lang="EN">The journalists from that media outlet are all left-wing, so obviously they won't produce objective reports on right-wing politicians.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBias</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ergoDecedo</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ergoDecedo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ergoDecedo</IRI>
    <Literal xml:lang="FR">Erreur de la critique traîtresse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ergoDecedo</IRI>
    <Literal xml:lang="EN">Ergo decedo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ergoDecedo</IRI>
    <Literal xml:lang="FR">Vous laissez entendre que votre adversaire est motivé par une faveur ou par une affiliation non divulguée à un groupe extérieur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ergoDecedo</IRI>
    <Literal xml:lang="EN">Implying that an opponent is motivated by undisclosed favoritism or affiliation with an external group.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ergoDecedo</IRI>
    <Literal xml:lang="FR">Si vous n’aimez pas notre système fiscal, pourquoi n’allez-vous pas là où vous pensez qu’il est meilleur ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ergoDecedo</IRI>
    <Literal xml:lang="EN">If you dislike our tax system so much, why don't you go somewhere you think is better?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ergoDecedo</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ergo_decedo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ergoDecedo</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ergoDecedo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumstantialAdHominem</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="FR">Appel à la réussite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="EN">Appeal to accomplishment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="FR">Vous rejetez ce que dit une personne parce qu’elle ne s’est pas illustrée dans le domaine concerné.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="EN">Discarding someone's argument on grounds of his or her lack of achievement in the field being debated.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="FR">Comment osez-vous affirmer que le petit déjeuner est le repas le plus important de la journée ? Êtes-vous médecin ? Diététicien ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="EN">How dare you claim that breakfast is the most important meal of the day? Are you a doctor? A dietitian?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_accomplishment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="FR">Compliment empoisonné</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="EN">Damning with faint praise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="FR">Vous discréditez quelqu’un par un compliment qui, en réalité, insinue le contraire de ce qu’il semble exprimer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="EN">Discrediting someone with a compliment that insinuates the opposite of what it appears to express.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="FR">Il est, à mon avis, exagéré de suggérer, comme on le fait parfois, que sa ligne de pensée ne vaut rien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="EN">In my view, it is exaggerated to suggest, as some sometimes do, that his line of thought is worthless.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Damning_with_faint_praise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFidentia</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFidentia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFidentia</IRI>
    <Literal xml:lang="FR">Attaque de la confiance en soi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFidentia</IRI>
    <Literal xml:lang="EN">Ad Fidentia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFidentia</IRI>
    <Literal xml:lang="FR">Vous discréditez les idées de quelqu’un en mettant en avant son manque de confiance en soi, plutôt qu’en contestant son argumentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFidentia</IRI>
    <Literal xml:lang="EN">Attacking the arguer's self-confidence about their argument in place of the argument or evidence themselves.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFidentia</IRI>
    <Literal xml:lang="FR">Vous semblez nerveux en présentant votre projet ; vous n’y croyez peut-être pas vous-même ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFidentia</IRI>
    <Literal xml:lang="EN">You seem nervous when presenting your project—do you not believe in it yourself?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFidentia</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/7/Ad-Fidentia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFidentia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFidentia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#courtiersReply</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#courtiersReply</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#courtiersReply</IRI>
    <Literal xml:lang="FR">Réponse de courtier</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#courtiersReply</IRI>
    <Literal xml:lang="EN">Courtier's Reply</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#courtiersReply</IRI>
    <Literal xml:lang="FR">Vous ignorez une critique en prétendant que la personne n’a pas les qualifications nécessaires pour la formuler.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#courtiersReply</IRI>
    <Literal xml:lang="EN">Ignoring a critique by claiming the person is not qualified to make it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#courtiersReply</IRI>
    <Literal xml:lang="FR">Je ne discuterai pas de ma politique économique avec un historien de métier.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#courtiersReply</IRI>
    <Literal xml:lang="EN">I will not discuss my economic policy with a career historian.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#courtiersReply</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Courtier%27s_Reply</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#courtiersReply</IRI>
    <Literal xml:lang="FR">https://en.wikipedia.org/wiki/Courtier%27s_Reply</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#courtiersReply</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#courtiersReply</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdCellarium</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdCellarium</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdCellarium</IRI>
    <Literal xml:lang="FR">Argument de la cave</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdCellarium</IRI>
    <Literal xml:lang="EN">Argumentum ad cellarium</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdCellarium</IRI>
    <Literal xml:lang="FR">Vous écartez l’opinion de quelqu’un en l’accusant de ne pas avoir les compétences sociales minimales et d’être condamné à vivre chez ses parents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdCellarium</IRI>
    <Literal xml:lang="EN">Dismissing someone's opinion by accusing them of lacking the minimum social skills, implying they must live with their parents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdCellarium</IRI>
    <Literal xml:lang="FR">Plutôt que de sortir de telles âneries, vous feriez mieux de sortir de la cave de vos parents et de vous trouver un travail.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdCellarium</IRI>
    <Literal xml:lang="EN">Instead of spouting such nonsense, you'd better get out of your parents' basement and find yourself a job.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdCellarium</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Argumentum_ad_cellarium</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdCellarium</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdCellarium</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credentialism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credentialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credentialism</IRI>
    <Literal xml:lang="FR">Crédentialisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credentialism</IRI>
    <Literal xml:lang="EN">Credentialism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credentialism</IRI>
    <Literal xml:lang="FR">Vous accordez une confiance excessive aux documents officiels d’évaluation d’un individu, estimant notamment à tort qu’un diplôme constitue une garantie absolue d’expertise dans un domaine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credentialism</IRI>
    <Literal xml:lang="EN">Excessive reliance on credentials, especially academic degrees, of an author in determining the value of their claims.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credentialism</IRI>
    <Literal xml:lang="FR">Peu importe ce que tu dis du réchauffement climatique, tant que tu n’as pas un doctorat dans le domaine, ça reste que ton opinion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credentialism</IRI>
    <Literal xml:lang="EN">No matter what you say about climate change, unless you have a PhD in the field, it's just your opinion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credentialism</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Credentialism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credentialism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credentialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <Literal xml:lang="FR">Sophisme d’opposition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <Literal xml:lang="EN">Fallacy of opposition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <Literal xml:lang="FR">Vous rejetez un argument simplement parce qu’il vient de quelqu’un qui n’est pas d’accord avec vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <Literal xml:lang="EN">Rejecting an argument simply because it comes from someone with whom one disagrees.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <Literal xml:lang="FR">Votre opinion n’a pas de valeur pour moi : on sait bien que, dans tous les cas, vous seriez opposé à mes propositions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <Literal xml:lang="EN">Your opinion is worthless to me; it's clear you would be against my propositions regardless.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Fallacy_of_opposition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulverism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulverism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulverism</IRI>
    <Literal xml:lang="FR">Bulvérisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulverism</IRI>
    <Literal xml:lang="EN">Bulverism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulverism</IRI>
    <Literal xml:lang="FR">Vous présumez que l’opinion adverse est fausse, puis vous tentez d’expliquer pourquoi votre interlocuteur s’est trompé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulverism</IRI>
    <Literal xml:lang="EN">Assuming opposing opinion is incorrect and attempting to explain why the other person is wrong.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulverism</IRI>
    <Literal xml:lang="FR">Bien sûr que vous critiquez ma gestion du budget : vous êtes simplement jaloux de ne pas être à ma place.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulverism</IRI>
    <Literal xml:lang="EN">Of course, you're criticizing my budget management because you're just jealous of not being in my position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulverism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Bulverism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulverism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulverism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jonanism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jonanism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jonanism</IRI>
    <Literal xml:lang="FR">Jonanisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jonanism</IRI>
    <Literal xml:lang="EN">Jonanism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jonanism</IRI>
    <Literal xml:lang="FR">Vous supposez que toutes les personnes que vous détestez se ressemblent exactement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jonanism</IRI>
    <Literal xml:lang="EN">Believing that everyone one dislikes is exactly the same.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jonanism</IRI>
    <Literal xml:lang="FR">Je ne suis pas surpris que vous soyez d’accord avec lui : vous appartenez au même parti incompétent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jonanism</IRI>
    <Literal xml:lang="EN">I'm not surprised you agree with him; you're all from that same incompetent party.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jonanism</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Jonanism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jonanism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jonanism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonFallacy</IRI>
    <Literal xml:lang="FR">Appel à la bande</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonFallacy</IRI>
    <Literal xml:lang="EN">Bandwagon Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonFallacy</IRI>
    <Literal xml:lang="FR">Vous soutenez sans examen les causes populaires dans le groupe auquel vous appartenez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonFallacy</IRI>
    <Literal xml:lang="EN">Blindly supporting popular causes within one's group.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonFallacy</IRI>
    <Literal xml:lang="FR">Tout le monde sur le forum pense que c’est une bonne idée ; je ne vois donc pas pourquoi vous êtes contre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonFallacy</IRI>
    <Literal xml:lang="EN">Everyone on this forum thinks it's a good idea, so I don't see why you're against it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonFallacy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/bandwagn.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bandwagonFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disciplinaryBlinders</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disciplinaryBlinders</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disciplinaryBlinders</IRI>
    <Literal xml:lang="FR">Oeillères disciplinaires</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disciplinaryBlinders</IRI>
    <Literal xml:lang="EN">Disciplinary Blinders</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disciplinaryBlinders</IRI>
    <Literal xml:lang="FR">Vous négligez automatiquement les arguments qui viennent de l’extérieur de votre propre communauté discursive.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disciplinaryBlinders</IRI>
    <Literal xml:lang="EN">Automatically dismissing arguments coming from outside one's own discourse community.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disciplinaryBlinders</IRI>
    <Literal xml:lang="FR">Ces arguments venant d’un philosophe ? Merci, mais je préfère écouter un vrai scientifique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disciplinaryBlinders</IRI>
    <Literal xml:lang="EN">Arguments from a philosopher? Thanks, but I'd rather listen to a real scientist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disciplinaryBlinders</IRI>
    <Literal xml:lang="EN">http://utminers.utep.edu/omwilliamson/ENGL1311/fallacies.htm#40</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disciplinaryBlinders</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disciplinaryBlinders</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationalBlinders</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationalBlinders</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationalBlinders</IRI>
    <Literal xml:lang="FR">Oeillères dénominationnelles</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationalBlinders</IRI>
    <Literal xml:lang="EN">Denominational Blinders</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationalBlinders</IRI>
    <Literal xml:lang="FR">Vous n’acceptez pas les perspectives sur la foi des autres, sauf si elles correspondent à votre propre croyance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationalBlinders</IRI>
    <Literal xml:lang="EN">Not accepting others' perspectives on faith unless they match one's own belief.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationalBlinders</IRI>
    <Literal xml:lang="FR">Tu n’appartiens même pas à notre église, comment peux-tu comprendre la signification de nos traditions ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationalBlinders</IRI>
    <Literal xml:lang="EN">You aren't even part of our church, how can you understand the meaning of our traditions?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationalBlinders</IRI>
    <Literal xml:lang="EN">http://utminers.utep.edu/omwilliamson/ENGL1311/fallacies.htm#40</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationalBlinders</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denominationalBlinders</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfOpposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <Literal xml:lang="FR">Attaque personnelle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <Literal xml:lang="EN">Ad personam</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <Literal xml:lang="FR">Au lieu de réfuter les arguments, vous attaquez directement la personne qui les présente.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <Literal xml:lang="EN">Directly attacking the individual presenting arguments instead of countering them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <Literal xml:lang="FR">Ne me dites pas comment hacher l’ail. Un toxicomane ne va pas m’apprendre à me nourrir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <Literal xml:lang="EN">Don't tell me how to chop garlic. A drug addict is not going to teach me how to feed myself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_personam</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHominem</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#DirectAdHominem_Inference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tonePolicing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tonePolicing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tonePolicing</IRI>
    <Literal xml:lang="FR">Argument tonal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tonePolicing</IRI>
    <Literal xml:lang="EN">Tone policing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tonePolicing</IRI>
    <Literal xml:lang="FR">Vous refusez un argument en critiquant la manière dont il est présenté plutôt que son contenu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tonePolicing</IRI>
    <Literal xml:lang="EN">Refusing an argument by criticizing the way it is presented rather than its content.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tonePolicing</IRI>
    <Literal xml:lang="FR">Tant que vous continuez avec cette attitude condescendante, je refuse de discuter avec vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tonePolicing</IRI>
    <Literal xml:lang="EN">As long as you continue with that condescending attitude, I refuse to discuss with you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tonePolicing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Tone_policing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tonePolicing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tonePolicing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taunting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taunting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taunting</IRI>
    <Literal xml:lang="FR">Dérision</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taunting</IRI>
    <Literal xml:lang="EN">Taunting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taunting</IRI>
    <Literal xml:lang="FR">Vous ridiculisez votre interlocuteur au lieu de répondre à son argumentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taunting</IRI>
    <Literal xml:lang="EN">Mocking the person presenting an argument instead of addressing the argument itself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taunting</IRI>
    <Literal xml:lang="FR">Oh, donc maintenant vous êtes l’expert, c’est ça ? Expliquez-moi encore comment cela fonctionne !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taunting</IRI>
    <Literal xml:lang="EN">Oh, so now you're the expert, huh? Tell me more about how this works!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taunting</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Taunting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taunting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taunting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jibe</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jibe</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jibe</IRI>
    <Literal xml:lang="FR">Raillerie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jibe</IRI>
    <Literal xml:lang="EN">Jibe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jibe</IRI>
    <Literal xml:lang="FR">Vous raillez votre interlocuteur avec des moqueries au lieu de discuter son idée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jibe</IRI>
    <Literal xml:lang="EN">Mocking one's interlocutor with ridicule instead of discussing their idea.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jibe</IRI>
    <Literal xml:lang="FR">Au moins, nous saurons qui blâmer quand il n’y aura plus de café à cause du réchauffement climatique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jibe</IRI>
    <Literal xml:lang="EN">At least we'll know who to blame when there's no more coffee due to global warming.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jibe</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/jibe#Etymology_3</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jibe</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jibe</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adPersonam</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defamation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defamation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defamation</IRI>
    <Literal xml:lang="FR">Diffamation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defamation</IRI>
    <Literal xml:lang="EN">Defamation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defamation</IRI>
    <Literal xml:lang="FR">Vous cherchez à discréditer votre adversaire en lui imputant publiquement, et à tort, un fait susceptible de porter atteinte à sa réputation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defamation</IRI>
    <Literal xml:lang="EN">Seeking to discredit an opponent by wrongfully and publicly attributing to them an act that may harm their reputation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defamation</IRI>
    <Literal xml:lang="FR">Il est connu que cette société verse des pots-de-vin pour obtenir des contrats. Comment pouvez-vous retenir son dossier ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defamation</IRI>
    <Literal xml:lang="EN">It is well known that this company bribes to get contracts. How can you consider their file?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defamation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Defamation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defamation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Diffamation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
