    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nameCalling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoeThrow</IRI>
  </AnnotationAssertion>
