    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoeThrow</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoeThrow</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoeThrow</IRI>
    <Literal xml:lang="FR">Lancer de soulier</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoeThrow</IRI>
    <Literal xml:lang="EN">Shoe throw</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoeThrow</IRI>
    <Literal xml:lang="FR">Vous manifestez un profond manque de respect par un geste offensant, ici le lancer de soulier.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoeThrow</IRI>
    <Literal xml:lang="EN">A profound lack of respect is demonstrated by an offensive action, here, shoe throwing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoeThrow</IRI>
    <Literal xml:lang="FR">Au milieu de notre débat sur la politique étrangère, il a subitement retiré sa chaussure et l’a jetée sur la table, prétendant que mes idées ’puent’ autant qu’une vieille semelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoeThrow</IRI>
    <Literal xml:lang="EN">In the midst of our debate on foreign policy, he suddenly took off his shoe and threw it on the table, claiming my ideas 'stink' as much as an old sole.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoeThrow</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/List_of_shoe-throwing_incidents</Literal>
  </AnnotationAssertion>
