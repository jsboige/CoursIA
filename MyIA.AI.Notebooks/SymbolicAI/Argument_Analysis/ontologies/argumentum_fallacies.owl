    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nameCalling</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nameCalling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nameCalling</IRI>
    <Literal xml:lang="FR">Injure</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nameCalling</IRI>
    <Literal xml:lang="EN">Name Calling</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nameCalling</IRI>
    <Literal xml:lang="FR">Sans même examiner sa proposition, vous adressez à votre adversaire des paroles grossières visant à le blesser personnellement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nameCalling</IRI>
    <Literal xml:lang="EN">Without even examining an opponent's proposal, addressing them with coarse words aimed at personally injuring them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nameCalling</IRI>
    <Literal xml:lang="FR">Mais n’avez-vous rien de mieux à dire ? Seul un idiot peut se préoccuper de telles futilités.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nameCalling</IRI>
    <Literal xml:lang="EN">Don't you have anything better to say? Only a fool could be concerned with such trifles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nameCalling</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Name_calling</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nameCalling</IRI>
    <Literal xml:lang="FR">https://en.wikipedia.org/wiki/Name_calling</Literal>
  </AnnotationAssertion>
