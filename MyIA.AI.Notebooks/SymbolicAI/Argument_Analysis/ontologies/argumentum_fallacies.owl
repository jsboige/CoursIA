    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insult</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insult</IRI>
    <Literal xml:lang="FR">Insulte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insult</IRI>
    <Literal xml:lang="EN">Insult</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insult</IRI>
    <Literal xml:lang="FR">Sans même examiner sa proposition, vous adressez à votre adversaire des gestes ou des paroles visant à l’offenser.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insult</IRI>
    <Literal xml:lang="EN">Without even examining an opponent's proposal, addressing them with gestures or words intended to offend them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insult</IRI>
    <Literal xml:lang="FR">Seule une personne aussi ignorante que vous pourrait penser que c’est une bonne idée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insult</IRI>
    <Literal xml:lang="EN">Only someone as ignorant as you could think that's a good idea.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insult</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Insult</Literal>
  </AnnotationAssertion>
