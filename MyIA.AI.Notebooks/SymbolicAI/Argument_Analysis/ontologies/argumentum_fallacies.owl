    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handRubbing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handRubbing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handRubbing</IRI>
    <Literal xml:lang="FR">Se frotter les mains</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handRubbing</IRI>
    <Literal xml:lang="EN">Hand rubbing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handRubbing</IRI>
    <Literal xml:lang="FR">Vous frottez vos mains ensemble, souvent en signe d’anticipation ou de satisfaction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handRubbing</IRI>
    <Literal xml:lang="EN">Rubbing one's hands together, often as a sign of anticipation or satisfaction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handRubbing</IRI>
    <Literal xml:lang="FR">Je me suis frotté les mains avec délice avant de dévoiler une surprise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handRubbing</IRI>
    <Literal xml:lang="EN">Rubbing hands together gleefully before unveiling a surprise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handRubbing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hand_rubbing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handRubbing</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gestuelle_des_doigts_et_des_mains#Se_frotter_les_mains</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handRubbing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handRubbing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistRaise</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistRaise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistRaise</IRI>
    <Literal xml:lang="FR">Tendre le poing serré vers le ciel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistRaise</IRI>
    <Literal xml:lang="EN">Fist raise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistRaise</IRI>
    <Literal xml:lang="FR">Vous tendez un poing serré vers le ciel, souvent en signe de détermination ou de protestation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistRaise</IRI>
    <Literal xml:lang="EN">Raising a clenched fist to the sky, often as a sign of determination or protest.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistRaise</IRI>
    <Literal xml:lang="FR">J’ai tendu un poing serré dans les airs lors de la marche de protestation pour montrer ma solidarité et ma défiance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistRaise</IRI>
    <Literal xml:lang="EN">Raising a fist in the air during a protest march to show solidarity and defiance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistRaise</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Raised_fist</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistRaise</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gestuelle_des_doigts_et_des_mains#Tendre_le_poing_serr.C3.A9_vers_le_ciel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistRaise</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistRaise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <Literal xml:lang="FR">Hostile</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <Literal xml:lang="EN">Hostile</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <Literal xml:lang="FR">Votre geste agressif appuie vos paroles pour souligner votre résolution et intimider.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <Literal xml:lang="EN">Accompanying one's words with an aggressive gesture to underline one's resolve and intimidate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <Literal xml:lang="FR">Je l’ai pointé de manière agressive pendant le débat pour souligner ce point et affirmer ma dominance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <Literal xml:lang="EN">My pointed finger accented each word as I made my stance clear, ensuring my opposition knew my determination.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brasDhonneur</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brasDhonneur</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brasDhonneur</IRI>
    <Literal xml:lang="FR">Bras d’honneur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brasDhonneur</IRI>
    <Literal xml:lang="EN">Bras d'honneur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brasDhonneur</IRI>
    <Literal xml:lang="FR">Vous pliez un bras et levez l’avant-bras avec le poing fermé, un geste offensant dans de nombreuses cultures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brasDhonneur</IRI>
    <Literal xml:lang="EN">Using the 'bras d'honneur' gesture, considered offensive in many cultures, by bending an arm and lifting the forearm with a clenched fist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brasDhonneur</IRI>
    <Literal xml:lang="FR">Pour intimider le conducteur qui le klaxonne, Marc lui fait un bras d’honneur en levant l’avant-bras, poing fermé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brasDhonneur</IRI>
    <Literal xml:lang="EN">In the heat of the argument, I flashed the 'bras d'honneur', inciting a not-so-subtle wave of disdain from those around.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brasDhonneur</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Bras_d%27honneur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brasDhonneur</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Bras_d%27honneur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brasDhonneur</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brasDhonneur</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFinger</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFinger</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFinger</IRI>
    <Literal xml:lang="FR">Doigt d’honneur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFinger</IRI>
    <Literal xml:lang="EN">The finger</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFinger</IRI>
    <Literal xml:lang="FR">Vous levez le majeur en signe d’insulte ou de défi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFinger</IRI>
    <Literal xml:lang="EN">Raising the middle finger as a sign of insult or defiance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFinger</IRI>
    <Literal xml:lang="FR">Pour intimider l’automobiliste qui le klaxonne, il lui adresse un doigt d’honneur par la fenêtre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFinger</IRI>
    <Literal xml:lang="EN">Flipping the middle finger defiantly from across the room, challenging someone's authority in a blatant display of disrespect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFinger</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/The_finger</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFinger</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Doigt_d%27honneur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFinger</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFinger</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbingOnesNose</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbingOnesNose</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbingOnesNose</IRI>
    <Literal xml:lang="FR">Pied de nez</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbingOnesNose</IRI>
    <Literal xml:lang="EN">Thumbing one's nose</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbingOnesNose</IRI>
    <Literal xml:lang="FR">Vous touchez votre nez avec le pouce en signe de moquerie ou de mépris.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbingOnesNose</IRI>
    <Literal xml:lang="EN">Touching the nose with the thumb to indicate mockery or contempt.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbingOnesNose</IRI>
    <Literal xml:lang="FR">Pour provoquer son rival après sa victoire, Léa pose le pouce sur son nez et lui fait un pied de nez moqueur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbingOnesNose</IRI>
    <Literal xml:lang="EN">Thumbing the nose while making a derisive snort, openly displaying contempt for the idea being discussed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbingOnesNose</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Thumbing_one%27s_nose</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbingOnesNose</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pied_de_nez</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbingOnesNose</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbingOnesNose</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheHorns</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheHorns</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheHorns</IRI>
    <Literal xml:lang="FR">Signe des cornes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheHorns</IRI>
    <Literal xml:lang="EN">Sign of the horns</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheHorns</IRI>
    <Literal xml:lang="FR">Vous levez la main avec l’index et le petit doigt écartés, un geste qui peut signifier différentes choses selon le contexte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheHorns</IRI>
    <Literal xml:lang="EN">Raising the hand with the index and little finger apart, a gesture that can have varying meanings depending on the context.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheHorns</IRI>
    <Literal xml:lang="FR">Au concert, Léa lève l’index et le petit doigt en signe des cornes pour entraîner ses amis à acclamer le groupe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheHorns</IRI>
    <Literal xml:lang="EN">Raising my hand in the 'sign of the horns' at a concert, I feel connected to the crowd and the rebellious spirit of the music.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheHorns</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sign_of_the_horns</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheHorns</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Signe_des_cornes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheHorns</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheHorns</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snap</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snap</IRI>
    <Literal xml:lang="FR">Claquer des doigts</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snap</IRI>
    <Literal xml:lang="EN">Snap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snap</IRI>
    <Literal xml:lang="FR">Vous faites claquer vos doigts, souvent pour attirer l’attention ou marquer le rythme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snap</IRI>
    <Literal xml:lang="EN">Snapping one's fingers, often to attract attention or keep rhythm.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snap</IRI>
    <Literal xml:lang="FR">Pendant la réunion, Léa claque des doigts pour attirer l’attention de ses collègues sur son idée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snap</IRI>
    <Literal xml:lang="EN">Snapping fingers at a concert, I keep up with the rhythm and connect to the music.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snap</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Finger_snapping</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snap</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gestuelle_des_doigts_et_des_mains#Claquer_des_doigts</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snap</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuckooSign</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuckooSign</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuckooSign</IRI>
    <Literal xml:lang="FR">Tourner ou frapper son index contre sa tempe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuckooSign</IRI>
    <Literal xml:lang="EN">Cuckoo sign</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuckooSign</IRI>
    <Literal xml:lang="FR">Vous tournez ou frappez votre index contre votre tempe, indiquant que vous pensez que quelqu’un est fou ou insensé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuckooSign</IRI>
    <Literal xml:lang="EN">Twirling or tapping one's index finger against one's temple to suggest someone is crazy or foolish.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuckooSign</IRI>
    <Literal xml:lang="FR">Quand son collègue propose de tout miser sur un client incertain, Léa frappe son index contre sa tempe pour lui faire comprendre qu’elle trouve cette idée insensée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuckooSign</IRI>
    <Literal xml:lang="EN">Tapping my temple with a finger while chuckling, indicating that someone's idea sounds absurd.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuckooSign</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/List_of_gestures#Single_handed</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuckooSign</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gestuelle_des_doigts_et_des_mains#Tourner_ou_frapper_son_index_contre_sa_tempe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuckooSign</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuckooSign</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#donkeyEars</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#donkeyEars</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#donkeyEars</IRI>
    <Literal xml:lang="FR">Oreilles d’âne</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#donkeyEars</IRI>
    <Literal xml:lang="EN">Donkey ears</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#donkeyEars</IRI>
    <Literal xml:lang="FR">Vous placez vos mains derrière la tête pour imiter des oreilles d’âne, en signe d’auto-dérision ou de moquerie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#donkeyEars</IRI>
    <Literal xml:lang="EN">Placing one's hands behind one's head to mimic donkey ears, as a sign of self-deprecation or mockery.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#donkeyEars</IRI>
    <Literal xml:lang="FR">Après avoir donné une mauvaise réponse, Léa place ses mains derrière sa tête pour faire des oreilles d’âne et détendre l’équipe par l’auto-dérision.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#donkeyEars</IRI>
    <Literal xml:lang="EN">Placing hands behind my head to mimic donkey ears, jokingly admitting a mistake amid laughter from the team.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#donkeyEars</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/donkey_ears</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#donkeyEars</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gestuelle_des_doigts_et_des_mains#Oreilles_d.27.C3.A2ne</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#donkeyEars</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#donkeyEars</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsdown</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsdown</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsdown</IRI>
    <Literal xml:lang="FR">Pouce baissé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsdown</IRI>
    <Literal xml:lang="EN">Thumbs-down</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsdown</IRI>
    <Literal xml:lang="FR">Vous abaissez le pouce pour exprimer une désapprobation ou un rejet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsdown</IRI>
    <Literal xml:lang="EN">Lowering the thumb to express disapproval or rejection.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsdown</IRI>
    <Literal xml:lang="FR">Pendant la réunion, Léa baisse le pouce pour pousser son équipe à rejeter la proposition du concurrent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsdown</IRI>
    <Literal xml:lang="EN">Giving a thumbs-down after a disappointing performance, signaling disapproval without needing words.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsdown</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Thumb_signal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsdown</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gestuelle_des_doigts_et_des_mains#Pouce</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsdown</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsdown</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostile</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <Literal xml:lang="FR">Désarroi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <Literal xml:lang="EN">Dismay</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <Literal xml:lang="FR">Vous exprimez la confusion ou l’incompréhension par des gestes désordonnés des mains ou du visage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <Literal xml:lang="EN">Expressing confusion or misunderstanding through disordered hand or facial gestures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <Literal xml:lang="FR">J’ai haussé les épaules tout en exprimant mon incertitude quant à cette décision à venir pour montrer visiblement mon indécision.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <Literal xml:lang="EN">I shrugged my shoulders while expressing my uncertainty about this upcoming decision to visibly show my indecision.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facepalm</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facepalm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facepalm</IRI>
    <Literal xml:lang="FR">Facepalm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facepalm</IRI>
    <Literal xml:lang="EN">Facepalm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facepalm</IRI>
    <Literal xml:lang="FR">Vous couvrez votre visage avec votre main, exprimant la frustration ou l’embarras.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facepalm</IRI>
    <Literal xml:lang="EN">Covering one's face with one's hand to express frustration or embarrassment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facepalm</IRI>
    <Literal xml:lang="FR">Je me suis couvert le visage de la main en réalisant l’erreur flagrante que j’ai commise pendant la présentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facepalm</IRI>
    <Literal xml:lang="EN">I covered my face with my hand when I realized the glaring mistake I had made during the presentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facepalm</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Facepalm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facepalm</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Facepalm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facepalm</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facepalm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbTwiddling</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbTwiddling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbTwiddling</IRI>
    <Literal xml:lang="FR">Se tourner les pouces</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbTwiddling</IRI>
    <Literal xml:lang="EN">Thumb twiddling</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbTwiddling</IRI>
    <Literal xml:lang="FR">Vous faites tourner vos pouces l’un autour de l’autre, souvent en signe d’ennui ou d’attente.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbTwiddling</IRI>
    <Literal xml:lang="EN">Rotating thumbs around each other, often indicating boredom or impatience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbTwiddling</IRI>
    <Literal xml:lang="FR">J’ai joué distraitement avec mes pouces en attendant la réponse qui tardait à venir durant la réunion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbTwiddling</IRI>
    <Literal xml:lang="EN">While awaiting a delayed response during the meeting, I absentmindedly twiddle my thumbs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbTwiddling</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Thumb_twiddling</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbTwiddling</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gestuelle_des_doigts_et_des_mains#Pouce</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbTwiddling</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbTwiddling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistClench</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistClench</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistClench</IRI>
    <Literal xml:lang="FR">Serrer les poings</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistClench</IRI>
    <Literal xml:lang="EN">Fist clench</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistClench</IRI>
    <Literal xml:lang="FR">Vous serrez les poings, souvent en signe de colère, de détermination ou de frustration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistClench</IRI>
    <Literal xml:lang="EN">Clenching fists, often as a sign of anger, determination, or frustration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistClench</IRI>
    <Literal xml:lang="FR">J’ai serré les poings pour canaliser ma frustration face aux commentaires injustes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistClench</IRI>
    <Literal xml:lang="EN">I clenched my fists to channel my frustration at the unfair comments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistClench</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gestuelle_des_doigts_et_des_mains#Serrer_les_poings</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistClench</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistClench</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsoverface</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsoverface</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsoverface</IRI>
    <Literal xml:lang="FR">Mains portées au visage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsoverface</IRI>
    <Literal xml:lang="EN">Hands-over-face</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsoverface</IRI>
    <Literal xml:lang="FR">Vous portez vos mains à votre visage, souvent en signe de réflexion, de surprise ou d’émotion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsoverface</IRI>
    <Literal xml:lang="EN">Bringing hands to the face, often indicative of deep thought, surprise, or emotion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsoverface</IRI>
    <Literal xml:lang="FR">J’ai porté mes mains au visage, bouche bée, lors de l’annonce surprenante de mon collègue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsoverface</IRI>
    <Literal xml:lang="EN">Covering my face with my hands in shock after hearing the unexpected news.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsoverface</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gestuelle_des_doigts_et_des_mains#Mains_port.C3.A9es_au_visage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsoverface</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsoverface</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsInDiscomfort</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsInDiscomfort</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsInDiscomfort</IRI>
    <Literal xml:lang="FR">Être encombré par ses mains</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsInDiscomfort</IRI>
    <Literal xml:lang="EN">Hands in discomfort</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsInDiscomfort</IRI>
    <Literal xml:lang="FR">Vous montrez une incertitude ou une nervosité en ne sachant pas quoi faire de vos mains.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsInDiscomfort</IRI>
    <Literal xml:lang="EN">Showing uncertainty or nervousness by not knowing what to do with one's hands.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsInDiscomfort</IRI>
    <Literal xml:lang="FR">Mes mains se déplaçait d’un endroit à l’autre sur le podium, trahissant mon nervosité apparente.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsInDiscomfort</IRI>
    <Literal xml:lang="EN">My hands moved from one place to another on the podium, betraying my apparent nervousness.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsInDiscomfort</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gestuelle_des_doigts_et_des_mains#.C3.8Atre_encombr.C3.A9_par_ses_mains</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsInDiscomfort</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handsInDiscomfort</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dismay</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proxemics</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proxemics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proxemics</IRI>
    <Literal xml:lang="FR">Proxémie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proxemics</IRI>
    <Literal xml:lang="EN">Proxemics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proxemics</IRI>
    <Literal xml:lang="FR">Vous modifiez la distance physique avec votre interlocuteur pour avoir un impact sur l’échange.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proxemics</IRI>
    <Literal xml:lang="EN">Manipulating physical distance with an interlocutor to impact the interaction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proxemics</IRI>
    <Literal xml:lang="FR">J’ai fait un pas en arrière, créant un espace qui a allégé la tension entre nous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proxemics</IRI>
    <Literal xml:lang="EN">I stepped back slightly, creating a sense of space and reducing the tension.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proxemics</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Proxemics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proxemics</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Proxémie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proxemics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proxemics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
    <Literal xml:lang="FR">Posture</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
    <Literal xml:lang="EN">Posture</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
    <Literal xml:lang="FR">La façon dont vous positionnez votre corps transmet un message à celui qui vous fait face.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
    <Literal xml:lang="EN">Positioning the body in a way that sends a message to one's interlocutor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
    <Literal xml:lang="FR">Debout, les épaules en arrière, j’ai communiqué une confiance inébranlable face à l’assemblée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
    <Literal xml:lang="EN">Standing tall with shoulders back, I communicated unwavering confidence to the crowd.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Posture_(psychology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#akimbo</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#akimbo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#akimbo</IRI>
    <Literal xml:lang="FR">Akimbo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#akimbo</IRI>
    <Literal xml:lang="EN">Akimbo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#akimbo</IRI>
    <Literal xml:lang="FR">En plaçant les mains sur les hanches et en écartant les coudes, vous exprimez une émotion, souvent l’autorité ou la détermination.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#akimbo</IRI>
    <Literal xml:lang="EN">Taking up a position in which the hands are on the hips and the elbows are bowed outward, often expressing authority or determination.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#akimbo</IRI>
    <Literal xml:lang="FR">Le chef d’équipe pose les mains sur les hanches, coudes écartés, pour montrer qu’il ne cédera pas sur le délai.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#akimbo</IRI>
    <Literal xml:lang="EN">With hands on my hips and elbows out, I broadcasted an aura of authority, indicating that I was ready to handle any challenge.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#akimbo</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Akimbo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#akimbo</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#akimbo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedArms</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedArms</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedArms</IRI>
    <Literal xml:lang="FR">Bras croisés</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedArms</IRI>
    <Literal xml:lang="EN">Crossed arms</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedArms</IRI>
    <Literal xml:lang="FR">Les bras croisés envoient un signal de fermeture ou de défense.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedArms</IRI>
    <Literal xml:lang="EN">Crossing one's arms can symbolize a closed, defensive stance or signify reluctance to engage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedArms</IRI>
    <Literal xml:lang="FR">Pendant la négociation, Léa croise les bras pour montrer qu’elle n’est pas prête à accepter l’offre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedArms</IRI>
    <Literal xml:lang="EN">By crossing my arms, I intuitively communicated a sense of disagreement and a defensive stance, without uttering a single word.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedArms</IRI>
    <Literal xml:lang="EN">http://changingminds.org/techniques/body/parts_body_language/arm_body_language.htm#cro</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedArms</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedArms</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#posture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
    <Literal xml:lang="FR">Apparence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
    <Literal xml:lang="EN">Appearance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
    <Literal xml:lang="FR">Vous utilisez votre apparence pour modifier la perception que les autres ont de vos propos.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
    <Literal xml:lang="EN">Using one's appearance to alter others' perception of one's statements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
    <Literal xml:lang="FR">En m’habillant simplement, d’une manière qui inspire confiance, j’ai influencé la perception du public avant même de prendre la parole.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
    <Literal xml:lang="EN">By dressing simply, in a way that inspires trust, I influenced the audience's perception before I even spoke.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
    <Literal xml:lang="EN">https://nonverbalcommunicationpreserviceteacherr.weebly.com/artifactics.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
    <Literal xml:lang="FR">https://en.wikipedia.org/wiki/Human_physical_appearance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socioculturalMarker</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socioculturalMarker</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socioculturalMarker</IRI>
    <Literal xml:lang="FR">Marqueur socioculturel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socioculturalMarker</IRI>
    <Literal xml:lang="EN">Socio-cultural Marker</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socioculturalMarker</IRI>
    <Literal xml:lang="FR">Vous adaptez votre apparence pour afficher des signes d’appartenance à un groupe et influencer votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socioculturalMarker</IRI>
    <Literal xml:lang="EN">Adapting one's appearance to display symbols of group belonging in order to influence an audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socioculturalMarker</IRI>
    <Literal xml:lang="FR">En portant ma veste militaire lors de la rencontre, j’ai immédiatement donné l’impression d’appartenir au groupe des vétérans.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socioculturalMarker</IRI>
    <Literal xml:lang="EN">By wearing my military jacket during the meeting, I immediately gave the impression of belonging to the veterans' group.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socioculturalMarker</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cultural_artifact</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socioculturalMarker</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socioculturalMarker</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clothing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clothing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clothing</IRI>
    <Literal xml:lang="FR">Habillement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clothing</IRI>
    <Literal xml:lang="EN">Clothing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clothing</IRI>
    <Literal xml:lang="FR">Votre choix de vêtements est une stratégie pour affecter l’opinion de votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clothing</IRI>
    <Literal xml:lang="EN">Using a choice of attire as a strategy to affect an audience's opinion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clothing</IRI>
    <Literal xml:lang="FR">Ma décision de porter une tenue traditionnelle à la conférence sur la diversité culturelle a suscité le respect et aiguillé la curiosité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clothing</IRI>
    <Literal xml:lang="EN">My decision to wear a traditional attire to the conference on cultural diversity elicited respect and sparked curiosity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clothing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Nonverbal_communication#Clothing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clothing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clothing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appearance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haptics</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haptics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haptics</IRI>
    <Literal xml:lang="FR">Haptique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haptics</IRI>
    <Literal xml:lang="EN">Haptics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haptics</IRI>
    <Literal xml:lang="FR">Vous utilisez le toucher pour communiquer et influencer votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haptics</IRI>
    <Literal xml:lang="EN">You use touch to communicate with and influence the person you are speaking to.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haptics</IRI>
    <Literal xml:lang="FR">Il m’a pris dans ses bras ; je ne pouvais plus lui dire non.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haptics</IRI>
    <Literal xml:lang="EN">He took me in his arms; I could no longer say no to him.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haptics</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Haptic_communication</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haptics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haptics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
    <Literal xml:lang="FR">Erreur mathématique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
    <Literal xml:lang="EN">Mathematical error</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
    <Literal xml:lang="FR">Votre raisonnement comporte des inexactitudes quantitatives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
    <Literal xml:lang="EN">The reasoning includes inaccuracies in the use of numerical information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
    <Literal xml:lang="FR"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
    <Literal xml:lang="EN"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Mathematical_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="FR">Généralisation abusive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="EN">Faulty generalisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="FR">Vous formulez une généralisation qui n’est pas valable dans le cas considéré.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="EN">Using a generalisation rule which is invalid in the considered situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="FR">Mes chats ont toujours été très doux ; les chats sont donc des animaux inoffensifs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="EN">My cats have always been very gentle; cats are therefore inoffensive animals.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Faulty_generalization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/G%C3%A9n%C3%A9ralisation#Le_sophisme_de_la_g.C3.A9n.C3.A9ralisation_abusive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <Literal xml:lang="FR">Échantillon biaisé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <Literal xml:lang="EN">Sampling bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <Literal xml:lang="FR">Vous tirez des conclusions à partir d’un échantillon qui n’est pas représentatif de la population cible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <Literal xml:lang="EN">You draw conclusions from a sample that is not representative of the target population.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <Literal xml:lang="FR">Ce yaourt est le meilleur, puisqu’il a été plébiscité par 80 % des consommateurs interrogés dans notre magasin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <Literal xml:lang="EN">This yoghurt is the best, since it was acclaimed by 80% of the consumers surveyed in our store.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sampling_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Échantillon_biaisé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
    <Literal xml:lang="FR">Échantillon non représentatif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
    <Literal xml:lang="EN">Biased Sample</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
    <Literal xml:lang="FR">Vous vous appuyez sur un ensemble d’individus qui n’est pas assez diversifié pour tirer une conclusion globale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
    <Literal xml:lang="EN">Arguing on the basis of a sample that does not accurately represent reality.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
    <Literal xml:lang="FR">J’ai demandé à mes amis leur avis sur le nouveau smartphone arrivé sur le marché, et ils l’adorent tous. C’est certainement le meilleur téléphone actuellement disponible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
    <Literal xml:lang="EN">I asked my friends about their opinions on the latest smartphone on the market, and all of them love it. It must be the best phone available right now.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/biassamp.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <Literal xml:lang="FR">Généralisation hâtive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <Literal xml:lang="EN">Hasty generalization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <Literal xml:lang="FR">Vous déduisez une règle globale d’un échantillon trop restreint.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <Literal xml:lang="EN">Inferring a general rule from too small a sample.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <Literal xml:lang="FR">Avez-vous vu l’augmentation des cas de fraude chez les nouveaux employés ? La nouvelle génération n’est pas fiable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <Literal xml:lang="EN">Have you seen the increase in fraud cases among new employees? The new generation is unreliable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hasty_generalization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromSmallNumbers</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromSmallNumbers</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromSmallNumbers</IRI>
    <Literal xml:lang="FR">Appel aux petits nombres</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromSmallNumbers</IRI>
    <Literal xml:lang="EN">Argument from small numbers</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromSmallNumbers</IRI>
    <Literal xml:lang="FR">Vous formulez une loi générale à partir d’une poignée d’exemples.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromSmallNumbers</IRI>
    <Literal xml:lang="EN">Making a general rule based on a very small number of examples.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromSmallNumbers</IRI>
    <Literal xml:lang="FR">Après avoir remarqué que les deux derniers romans de cet auteur ont reçu des critiques élogieuses, Marc en conclut que tous ses futurs livres seront aussi des chefs-d’œuvre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromSmallNumbers</IRI>
    <Literal xml:lang="EN">After noticing his last two novels received rave reviews, Mark concludes that all future books by this author will be masterpieces too.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromSmallNumbers</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#numbers</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromSmallNumbers</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromSmallNumbers</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="FR">Insensibilité à la taille de l’échantillon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="EN">Insensitivity to sample size</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="FR">Vous ne prenez pas en compte la taille de l’échantillon dans l’évaluation de la fiabilité des données.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="EN">Not considering the sample size when evaluating data reliability.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="FR">Je crois à ce sondage, même s’il n’a interrogé que 10 personnes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="EN">I believe in this poll, even though it only asked 10 people.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Insensitivity_to_sample_size</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slothfulInduction</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slothfulInduction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slothfulInduction</IRI>
    <Literal xml:lang="FR">Appel à la coïncidence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slothfulInduction</IRI>
    <Literal xml:lang="EN">Slothful induction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slothfulInduction</IRI>
    <Literal xml:lang="FR">Vous rejetez les conclusions valables d’un échantillon représentatif, les considérant comme de simples coïncidences.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slothfulInduction</IRI>
    <Literal xml:lang="EN">Denying an inductive argument its proper conclusion despite strong evidence, claiming the latter is mere coincidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slothfulInduction</IRI>
    <Literal xml:lang="FR">J’ai acheté plusieurs fois chez ce fournisseur en ligne et ça a été une réussite. Tous ceux qui se plaignent de mauvaises expériences n’ont simplement pas de chance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slothfulInduction</IRI>
    <Literal xml:lang="EN">I've ordered several times from this online supplier successfully. Those complaining about bad experiences are just unlucky.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slothfulInduction</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Slothful_induction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slothfulInduction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slothfulInduction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedSample</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="FR">Biais de confirmation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="EN">Confirmation bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="FR">Vous vous concentrez uniquement sur les éléments qui renforcent votre argumentation, en écartant tout ce qui pourrait la contester.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="EN">Focusing only on the evidence that supports an argument, while excluding anything that could challenge it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="FR">J’ai lu des dizaines d’articles qui soutiennent mon point de vue ; c’est bien la preuve que j’ai raison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="EN">I've read dozens of articles that back up my viewpoint, which surely means I am right.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="EN">http://skepdic.com/confirmbias.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cherryPicking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cherryPicking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cherryPicking</IRI>
    <Literal xml:lang="FR">Picorage de données</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cherryPicking</IRI>
    <Literal xml:lang="EN">Cherry picking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cherryPicking</IRI>
    <Literal xml:lang="FR">Vous ignorez les faits qui ne vont pas dans le sens de votre argumentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cherryPicking</IRI>
    <Literal xml:lang="EN">Selectively pointing to evidence that supports a position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cherryPicking</IRI>
    <Literal xml:lang="FR">Maman n’a pas dit non, j’ai eu une bonne note, et ce bonbon est rose, ma couleur préférée : s’il vous plaît, achetez-le-moi !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cherryPicking</IRI>
    <Literal xml:lang="EN">Mom didn't say no, I got a good mark and it's my favourite color. Please buy me this candy!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cherryPicking</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cherry_picking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cherryPicking</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Cueillette_de_cerises</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cherryPicking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cherryPicking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
    <Literal xml:lang="FR">Biais de représentativité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
    <Literal xml:lang="EN">Representative heuristic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
    <Literal xml:lang="FR">Votre argumentation ne repose pas sur une véritable enquête statistique, mais sur des informations surtout qualitatives plutôt que quantitatives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
    <Literal xml:lang="EN">Estimating probabilities on the basis of qualitative subjective information rather than on the basis of quantitative statistical data.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
    <Literal xml:lang="FR">Tous mes amis aiment les films de super-héros ; il est donc évident que ce sont les films préférés de notre époque.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
    <Literal xml:lang="EN">All my friends love superhero movies; they must be the favorite genre of our time.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Representativeness_heuristic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_de_représentativité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingVividness</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingVividness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingVividness</IRI>
    <Literal xml:lang="FR">Vivacité trompeuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingVividness</IRI>
    <Literal xml:lang="EN">Misleading Vividness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingVividness</IRI>
    <Literal xml:lang="FR">Vous préférez les histoires marquantes aux statistiques rigoureuses pour appuyer votre argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingVividness</IRI>
    <Literal xml:lang="EN">Preferring compelling anecdotes over rigorous statistics to support an argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingVividness</IRI>
    <Literal xml:lang="FR">Vous souvenez-vous de cette histoire d’enfant attaqué par un chien ? Cela montre bien que ces animaux sont dangereux et qu’il faut s’en méfier.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingVividness</IRI>
    <Literal xml:lang="EN">Do you remember the story about a child attacked by a dog? It goes to show that these animals are dangerous and should be avoided.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingVividness</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/125/Misleading-Vividness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingVividness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingVividness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#representativeHeuristic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apexFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apexFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apexFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de l’apex</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apexFallacy</IRI>
    <Literal xml:lang="EN">Apex fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apexFallacy</IRI>
    <Literal xml:lang="FR">Vous généralisez abusivement à partir des caractéristiques des meilleurs éléments d’un groupe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apexFallacy</IRI>
    <Literal xml:lang="EN">Evaluating a group on the basis of the performance of the "best" groupmembers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apexFallacy</IRI>
    <Literal xml:lang="FR">Ce joueur de basket est très grand ; tous les individus de sa taille doivent donc être d’excellents joueurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apexFallacy</IRI>
    <Literal xml:lang="EN">This basketball player is quite tall, all tall people must be excellent at basketball.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apexFallacy</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Apex_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apexFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apexFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nutpicking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nutpicking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nutpicking</IRI>
    <Literal xml:lang="FR">Picorage des noix</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nutpicking</IRI>
    <Literal xml:lang="EN">Nutpicking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nutpicking</IRI>
    <Literal xml:lang="FR">Vous généralisez à tout un groupe les traits de ses pires éléments, faute d’avoir choisi un échantillon représentatif.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nutpicking</IRI>
    <Literal xml:lang="EN">Evaluating a group on the basis of the performance of the "worst" groupmembers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nutpicking</IRI>
    <Literal xml:lang="FR">Aux informations, ils ont parlé de tous ces étudiants qui trichaient pendant les examens. Cela prouve bien que le niveau global de l’éducation est en baisse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nutpicking</IRI>
    <Literal xml:lang="EN">The news spoke about all these students who cheated during exams. This proves conclusively that the overall level of education is declining.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nutpicking</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Nutpicking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apexFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nutpicking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nutpicking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apexFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <Literal xml:lang="FR">Biais de sélection</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <Literal xml:lang="EN">Selection bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <Literal xml:lang="FR">Vous sélectionnez ou mettez en avant des données spécifiques pour appuyer votre argumentation, tout en négligeant d’autres données pertinentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <Literal xml:lang="EN">Selecting or highlighting specific data to support an argument, while neglecting other pertinent data.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <Literal xml:lang="FR">Regardez les résultats de ces trois élèves exceptionnels de notre école ; cela prouve bien l’excellence de notre système éducatif.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <Literal xml:lang="EN">Look at the results of these three exceptional students at our school; it definitely proves the excellence of our educational system.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Selection_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_de_s%C3%A9lection</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#samplingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
    <Literal xml:lang="FR">Biais du survivant</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
    <Literal xml:lang="EN">Survivorship Bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
    <Literal xml:lang="FR">Vous évaluez un projet uniquement à partir de ses réussites passées, sans tenir compte des échecs moins visibles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
    <Literal xml:lang="EN">Concentrating only on past successes of a project while neglecting unseen failures that may also be relevant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
    <Literal xml:lang="FR">Regardez toutes ces entreprises qui valent des milliards après seulement quelques années d’existence ; les startups ont donc un potentiel énorme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
    <Literal xml:lang="EN">Look at all these companies worth billions after a few years in business; it demonstrates the huge potential of startups.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Survivorship_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_du_survivant</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toupéeFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toupéeFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toupéeFallacy</IRI>
    <Literal xml:lang="FR">Sophisme du postiche</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toupéeFallacy</IRI>
    <Literal xml:lang="EN">Toupée Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toupéeFallacy</IRI>
    <Literal xml:lang="FR">Vous établissez une loi générale à partir d’exemples qui ne peuvent que corroborer votre hypothèse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toupéeFallacy</IRI>
    <Literal xml:lang="EN">Generalizing based on examples that can only confirm the hypothesis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toupéeFallacy</IRI>
    <Literal xml:lang="FR">Toutes les perruques paraissent fausses. Je n’ai jamais vu une perruque dont on ne pouvait pas dire qu’elle était fausse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toupéeFallacy</IRI>
    <Literal xml:lang="EN">All toupées look fake; I've never seen one that I couldn't tell was fake.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toupéeFallacy</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Toupee_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toupéeFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toupéeFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#survivorshipBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfExclusion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfExclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfExclusion</IRI>
    <Literal xml:lang="FR">Sophisme d’exclusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfExclusion</IRI>
    <Literal xml:lang="EN">Fallacy of Exclusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfExclusion</IRI>
    <Literal xml:lang="FR">Vous établissez une loi générale à partir de données statistiques exactes, mais sans tenir compte d’informations importantes qui vont à l’encontre de votre thèse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfExclusion</IRI>
    <Literal xml:lang="EN">You establish a general rule based on accurate statistical data, but without taking into account important information that runs counter to your claim.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfExclusion</IRI>
    <Literal xml:lang="FR">Il n’y a jamais eu d’incidents dans ce parc d’attractions, donc il est totalement sûr d’y aller, nul besoin de se préoccuper des mesures de sécurité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfExclusion</IRI>
    <Literal xml:lang="EN">There were never any incidents in this amusement park, so it's completely safe to go there; no need to worry about safety measures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfExclusion</IRI>
    <Literal xml:lang="EN">https://web.archive.org/web/20171229032715/http://www.onegoodmove.org/fallacy/exclus.htm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfExclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfExclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightFallacy</IRI>
    <Literal xml:lang="FR">Appel au coup de projecteur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightFallacy</IRI>
    <Literal xml:lang="EN">Spotlight fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightFallacy</IRI>
    <Literal xml:lang="FR">Vous considérez que ce qui est dit d’un groupe dans les médias s’applique à tous ses membres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightFallacy</IRI>
    <Literal xml:lang="EN">Assuming that the media coverage of a certain class or category is representative of the class or category in whole.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightFallacy</IRI>
    <Literal xml:lang="FR">Les médias ne parlent que des scandales politiques ; cela prouve que tous les politiciens sont corrompus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightFallacy</IRI>
    <Literal xml:lang="EN">The media only talks about political scandals; this proves that all politicians are corrupt.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightFallacy</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Spotlight_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neymansBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neymansBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neymansBias</IRI>
    <Literal xml:lang="FR">Biais de Neyman</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neymansBias</IRI>
    <Literal xml:lang="EN">Neyman's bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neymansBias</IRI>
    <Literal xml:lang="FR">Vous interprétez mal des données en ne retenant que les éléments visibles et en ignorant ceux qui sont tout aussi importants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neymansBias</IRI>
    <Literal xml:lang="EN">Misinterpreting data or results by focusing only on the most noticeable or significant elements, while overlooking less apparent but equally important data.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neymansBias</IRI>
    <Literal xml:lang="FR">Nous avons constaté une augmentation des ventes dans les magasins où nous avons fait de la publicité, donc notre campagne publicitaire est un succès.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neymansBias</IRI>
    <Literal xml:lang="EN">We saw an increase in sales in stores where we advertised, so our ad campaign is a success.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neymansBias</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Neyman%27s_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neymansBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neymansBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <Literal xml:lang="FR">Sophisme de l’accident</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <Literal xml:lang="EN">Secundum quid</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <Literal xml:lang="FR">Vous appliquez une règle générale à un cas particulier, sans tenir compte des exceptions pertinentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <Literal xml:lang="EN">Applying a general rule to a particular case, ignoring the exceptions that may apply.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <Literal xml:lang="FR">Ma voiture peut rouler à 130 kilomètres à l’heure ; traverser la ville ne me prendra donc que quelques minutes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <Literal xml:lang="EN">My car goes at 130 km an hour, I only need a few minutes to cross the city.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Secundum_quid</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfAccident</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfAccident</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfAccident</IRI>
    <Literal xml:lang="FR">Sophisme de l’accident</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfAccident</IRI>
    <Literal xml:lang="EN">Fallacy of Accident</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfAccident</IRI>
    <Literal xml:lang="FR">Vous appliquez une règle générale à une situation particulière, sans tenir compte des exceptions pertinentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfAccident</IRI>
    <Literal xml:lang="EN">Ignoring that the particular case to which a general rule is applied indeed constitutes an exception to that rule.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfAccident</IRI>
    <Literal xml:lang="FR">Couper quelqu’un avec un couteau est un crime. Les chirurgiens coupent des patients avec un couteau. Donc les chirurgiens sont des criminels.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfAccident</IRI>
    <Literal xml:lang="EN">Using a knife on people is a crime. Surgeons use knives on people. Therefore, surgeons are criminals.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfAccident</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Accident_(fallacy)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfAccident</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfAccident</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="FR">Sophisme du vrai Écossais</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="EN">No true Scotsman</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="FR">Pour réfuter un contre-exemple, vous redéfinissez les contours de l’idée générale que vous soutenez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="EN">Saving a generalization from a counterexample by changing its definition in order to exclude that counterexample.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="FR">— Tous les Écossais sont roux. — Angus est écossais, mais il n’est pas roux. — Alors ce n’est pas un vrai Écossais.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="EN">— All Scots are red-haired.
— Angus is Scottish, but he is not red-haired.
— Then he is not a true Scotsman.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/No_true_Scotsman</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme_du_vrai_%C3%89cossais</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfAccident</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfAccident</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#converseAccidentFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#converseAccidentFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#converseAccidentFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de l’accident contraire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#converseAccidentFallacy</IRI>
    <Literal xml:lang="EN">Converse accident fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#converseAccidentFallacy</IRI>
    <Literal xml:lang="FR">Vous transformez une exception en règle générale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#converseAccidentFallacy</IRI>
    <Literal xml:lang="EN">Applying an exception to a generalisation to cases where the generalisation itself should apply.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#converseAccidentFallacy</IRI>
    <Literal xml:lang="FR">Si l’on autorise les personnes souffrant de sclérose en plaques à consommer de la marijuana, alors tout le monde devrait être autorisé à en consommer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#converseAccidentFallacy</IRI>
    <Literal xml:lang="EN">If people with multiple sclerosis are allowed to use marijuana, then everyone should be allowed to use it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#converseAccidentFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Converse_accident</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#converseAccidentFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#converseAccidentFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overgeneralization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overgeneralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overgeneralization</IRI>
    <Literal xml:lang="FR">Généralisation excessive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overgeneralization</IRI>
    <Literal xml:lang="EN">Overgeneralization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overgeneralization</IRI>
    <Literal xml:lang="FR">Vous accordez trop d’importance à des cas particuliers et les traitez comme s’ils constituaient une norme universelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overgeneralization</IRI>
    <Literal xml:lang="EN">Giving too much weight to particular cases and treating them as if they constituted a universal norm.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overgeneralization</IRI>
    <Literal xml:lang="FR">On observe un pic d’agressions à la sortie des bars à 2 h du matin. Cela prouve que les agressions sont principalement dues à l’alcool.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overgeneralization</IRI>
    <Literal xml:lang="EN">We notice an increase in assaults outside bars at 2 a.m. This proves that assaults are mainly caused by alcohol.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overgeneralization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overgeneralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="FR">Stéréotype</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="EN">Stereotype</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="FR">Votre raisonnement repose sur une généralisation abusive de croyances communes qui catégorisent des objets, des personnes ou des groupes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="EN">Basing reasoning on an abusive generalisation of common beliefs that categorise objects, people, or groups.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="FR">J’ai hâte de goûter ses bons petits plats. On m’a dit tellement de bien de la cuisine française.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="EN">I can't wait to taste those delicious dishes. I've heard so much good about French cuisine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/167/Stereotyping</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overgeneralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overgeneralization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overwhelmingException</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overwhelmingException</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overwhelmingException</IRI>
    <Literal xml:lang="FR">Exception écrasante</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overwhelmingException</IRI>
    <Literal xml:lang="EN">Overwhelming exception</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overwhelmingException</IRI>
    <Literal xml:lang="FR">Votre argumentation repose sur une généralisation dont la validité exige de nombreuses conditions particulières.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overwhelmingException</IRI>
    <Literal xml:lang="EN">Applying a generalization that comes with many qualifications which strip away so many cases, that what is left might seem significantly less impressive than the original claim.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overwhelmingException</IRI>
    <Literal xml:lang="FR">Ces entreprises sont très rentables parce qu’elles utilisent des stratégies marketing novatrices. Par conséquent, pour être rentable, toute entreprise doit utiliser ces mêmes stratégies.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overwhelmingException</IRI>
    <Literal xml:lang="EN">These companies are very profitable because they employ innovative marketing strategies. Therefore, to be profitable, a company must employ these same strategies.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overwhelmingException</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Overwhelming_exception</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overwhelmingException</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overwhelmingException</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#secundumQuid</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <Literal xml:lang="FR">Transfert illicite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <Literal xml:lang="EN">Illicit transference</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <Literal xml:lang="FR">Vous prêtez à un groupe entier les caractéristiques de ses éléments, ou l’inverse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <Literal xml:lang="EN">Attributing to an entire group the characteristics of its elements, or vice versa.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <Literal xml:lang="FR">Un camion consomme plus de carburant qu’une voiture ; on peut donc en déduire que les camions consomment, au total, plus de carburant que les voitures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <Literal xml:lang="EN">A truck consumes more fuel than a car; one can therefore infer that trucks consume, in total, more fuel than cars.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fallacies_of_illicit_transference</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <Literal xml:lang="FR">http://misterming.free.fr/sophismes/#comp</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#PropertyNotExistant_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
    <Literal xml:lang="FR">Sophisme de composition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
    <Literal xml:lang="EN">Fallacy of composition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
    <Literal xml:lang="FR">Vous pensez à tort qu’une caractéristique commune aux membres d’un groupe s’applique au groupe dans son ensemble.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
    <Literal xml:lang="EN">Atrributing properties of the parts of a set to the whole set.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
    <Literal xml:lang="FR">Toutes ces plantes vont mourir un jour ; ce jardin est donc voué à disparaître.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
    <Literal xml:lang="EN">All these plants will die one day, so this garden will disappear.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fallacy_of_composition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme_de_composition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRecapitulationTheory</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRecapitulationTheory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRecapitulationTheory</IRI>
    <Literal xml:lang="FR">Appel à la théorie de la récapitulation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRecapitulationTheory</IRI>
    <Literal xml:lang="EN">Appeal to Recapitulation Theory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRecapitulationTheory</IRI>
    <Literal xml:lang="FR">Vous croyez que le développement individuel d’un être vivant reflète l’évolution de son espèce.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRecapitulationTheory</IRI>
    <Literal xml:lang="EN">Believing that individual development in a living organism retraces the evolutionary stages of its species.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRecapitulationTheory</IRI>
    <Literal xml:lang="FR">On observe que les embryons humains présentent brièvement des structures qui ressemblent à des branchies. Cela démontrerait l’ascendance aquatique des humains.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRecapitulationTheory</IRI>
    <Literal xml:lang="EN">Human embryos briefly exhibit structures resembling gills, which is taken by some to support aquatic ancestry of humans.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRecapitulationTheory</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Recapitulation_theory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRecapitulationTheory</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Théorie_de_la_récapitulation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRecapitulationTheory</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRecapitulationTheory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymicFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymicFallacy</IRI>
    <Literal xml:lang="FR">Sophisme métonymique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymicFallacy</IRI>
    <Literal xml:lang="EN">Metonymic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymicFallacy</IRI>
    <Literal xml:lang="FR">Vous pensez à tort qu’une partie représente le tout de manière exacte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymicFallacy</IRI>
    <Literal xml:lang="EN">Considering that the part used to represent or stand for a whole is an accurate reflection of that whole.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymicFallacy</IRI>
    <Literal xml:lang="FR">Son costume est d’une élégance rare ; il doit avoir rendez-vous avec le patron.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymicFallacy</IRI>
    <Literal xml:lang="EN">His suit is of rare elegance, he must have a meeting with the boss.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymicFallacy</IRI>
    <Literal xml:lang="EN">https://www.oxfordreference.com/display/10.1093/acref/9780199568758.001.0001/acref-9780199568758-e-1729</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfComposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de division</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
    <Literal xml:lang="EN">Division fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
    <Literal xml:lang="FR">Vous attribuez à tort certaines caractéristiques d’un groupe à chacun de ses membres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
    <Literal xml:lang="EN">Attributing properties of a whole set to each of its individual part.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
    <Literal xml:lang="FR">Les tigres royaux sont voués à disparaître prématurément ; ce tigre royal mourra donc jeune.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
    <Literal xml:lang="EN">Royal Bengal tigers are deemed to vanish soon; therefore, this Royal Bengal tiger will likely die young.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fallacy_of_division</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitTransference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <Literal xml:lang="FR">Erreur écologique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <Literal xml:lang="EN">Ecological fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <Literal xml:lang="FR">Vous utilisez à tort des statistiques portant sur un groupe pour décrire un individu particulier.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <Literal xml:lang="EN">Deducing, from statistical data, inferences about individuals from inference for the group to which these individuals belong.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <Literal xml:lang="FR">De quoi vous plaignez-vous ? Vous êtes américain ; votre pays compte parmi les plus riches de la planète.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <Literal xml:lang="EN">Why complain? You are American; your country is among the richest on the planet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ecological_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <Literal xml:lang="FR">http://wikipedia.qwika.com/en2fr/Ecological_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simpsonsParadox</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simpsonsParadox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simpsonsParadox</IRI>
    <Literal xml:lang="FR">Paradoxe de Simpson</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simpsonsParadox</IRI>
    <Literal xml:lang="EN">Simpson's paradox</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simpsonsParadox</IRI>
    <Literal xml:lang="FR">Vous interprétez à tort une tendance statistique qui s’inverse lorsque des groupes sont combinés, sans tenir compte des variables clés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simpsonsParadox</IRI>
    <Literal xml:lang="EN">You wrongly interpret a statistical trend that reverses when groups are combined, without taking key variables into account.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simpsonsParadox</IRI>
    <Literal xml:lang="FR">Je préfère me faire soigner dans l’hôpital du coin : son taux de survie est bien meilleur que celui de cet établissement spécialisé dans le traitement des cancers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simpsonsParadox</IRI>
    <Literal xml:lang="EN">I prefer going to the local hospital because the survival rate there is much higher than that at the cancer-specialized hospital.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simpsonsParadox</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Simpson%27s_paradox</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simpsonsParadox</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Paradoxe_de_Simpson</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simpsonsParadox</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simpsonsParadox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingMeanAndMedian</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingMeanAndMedian</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingMeanAndMedian</IRI>
    <Literal xml:lang="FR">Confusion moyenne-médiane</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingMeanAndMedian</IRI>
    <Literal xml:lang="EN">Confusing mean and median</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingMeanAndMedian</IRI>
    <Literal xml:lang="FR">Vous confondez la moyenne et la médiane, deux mesures statistiques qui peuvent différer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingMeanAndMedian</IRI>
    <Literal xml:lang="EN">Mistaking the mean for the median, two statistical measures that can vastly differ.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingMeanAndMedian</IRI>
    <Literal xml:lang="FR">J’ai du mal à croire que tous ces immeubles d’habitation soient si délabrés, compte tenu des ressources dont dispose la municipalité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingMeanAndMedian</IRI>
    <Literal xml:lang="EN">I find it hard to believe all these residential buildings are so rundown given the resources the municipality has.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingMeanAndMedian</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ecological_fallacy#Mean_and_median</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingMeanAndMedian</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingMeanAndMedian</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingGroupAndTotalAverages</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingGroupAndTotalAverages</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingGroupAndTotalAverages</IRI>
    <Literal xml:lang="FR">Confusion entre la moyenne du tout et celle de la partie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingGroupAndTotalAverages</IRI>
    <Literal xml:lang="EN">Confusing group and total averages</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingGroupAndTotalAverages</IRI>
    <Literal xml:lang="FR">Vous calculez à tort la moyenne d’une partie en vous fondant sur la moyenne de l’ensemble.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingGroupAndTotalAverages</IRI>
    <Literal xml:lang="EN">Infering the mean value for a subset from the mean value of the general set.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingGroupAndTotalAverages</IRI>
    <Literal xml:lang="FR">En moyenne, les habitants de cette ville vivent jusqu’à 75 ans ; j’ai donc de bonnes chances de vivre au moins jusqu’à cet âge.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingGroupAndTotalAverages</IRI>
    <Literal xml:lang="EN">On average, people in this town live until 75 years old; hence, I should have a good chance of living at least that long.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingGroupAndTotalAverages</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ecological_fallacy#Group_and_total_averages</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingGroupAndTotalAverages</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingGroupAndTotalAverages</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingIndividualAndAggregateCorrelations</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingIndividualAndAggregateCorrelations</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingIndividualAndAggregateCorrelations</IRI>
    <Literal xml:lang="FR">Confusion des plans de corrélation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingIndividualAndAggregateCorrelations</IRI>
    <Literal xml:lang="EN">Confusing individual and aggregate correlations</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingIndividualAndAggregateCorrelations</IRI>
    <Literal xml:lang="FR">Vous supposez à tort que les relations entre variables observées chez un individu reflètent celles du groupe auquel il appartient.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingIndividualAndAggregateCorrelations</IRI>
    <Literal xml:lang="EN">Considering that variables applying to individuals are correlated like the variables that apply to the aggregate of individuals.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingIndividualAndAggregateCorrelations</IRI>
    <Literal xml:lang="FR">Plus il y a d’ordinateurs dans un pays, plus on y vend de chocolat. Il est donc normal que plus je passe de temps devant mon écran, plus je mange de chocolat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingIndividualAndAggregateCorrelations</IRI>
    <Literal xml:lang="EN">The more computers a country has, the more chocolate it sells. So, it's only natural that the more time I spend in front of my screen, the more chocolate I eat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingIndividualAndAggregateCorrelations</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ecological_fallacy#Individual_and_aggregate_correlations</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingIndividualAndAggregateCorrelations</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingIndividualAndAggregateCorrelations</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ecologicalFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greedyReductionism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greedyReductionism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greedyReductionism</IRI>
    <Literal xml:lang="FR">Réductionnisme glouton</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greedyReductionism</IRI>
    <Literal xml:lang="EN">Greedy reductionism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greedyReductionism</IRI>
    <Literal xml:lang="FR">Pour expliquer un phénomène complexe, vous le simplifiez à l’excès en ne considérant que ses éléments individuels.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greedyReductionism</IRI>
    <Literal xml:lang="EN">Attempting to explain a thing in terms of what it reduces to but failing to consider the complexity of the issue, thus oversimplifying.
</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greedyReductionism</IRI>
    <Literal xml:lang="FR">L’équipe a perdu le match ; donc chaque joueur manque de talent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greedyReductionism</IRI>
    <Literal xml:lang="EN">The team lost the match, so each player must lack talent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greedyReductionism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Greedy_reductionism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greedyReductionism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greedyReductionism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <Literal xml:lang="FR">Interprétation quantitative erronée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <Literal xml:lang="EN">Interpretation fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <Literal xml:lang="FR">Vous établissez des relations quantitatives inexactes entre des éléments ou des données.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <Literal xml:lang="EN">You establish inaccurate quantitative relationships between elements or data.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <Literal xml:lang="FR">La courbe du réchauffement climatique suit de très près la baisse de la natalité. Le lien entre les deux est donc avéré.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <Literal xml:lang="EN">The global warming curve closely follows the decline in the birth rate. The link between the two is therefore established.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <Literal xml:lang="EN">https://www.seekfind.net/Logical_Fallacy_of_Misinterpretation.html#.Y72hCy-B3RY</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Régression_fallacieuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#EvidenceToHypothesis_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <Literal xml:lang="FR">Relation infondée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <Literal xml:lang="EN">Unfounded relationship</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <Literal xml:lang="FR">Vous attribuez une relation significative à ce qui n’est qu’une simple coïncidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <Literal xml:lang="EN">Attributing a significant relationship to what is merely a simple coincidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <Literal xml:lang="FR">La courbe de la productivité suit clairement celle de la consommation de café. Il doit en être la cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <Literal xml:lang="EN">The productivity curve clearly follows that of coffee consumption. Coffee must therefore be the cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Spurious_relationship</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#correlationCausationFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#correlationCausationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#correlationCausationFallacy</IRI>
    <Literal xml:lang="FR">Confusion entre corrélation et causalité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#correlationCausationFallacy</IRI>
    <Literal xml:lang="EN">Correlation-Causation Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#correlationCausationFallacy</IRI>
    <Literal xml:lang="FR">Vous pensez à tort que, lorsque deux phénomènes coïncident ou évoluent ensemble, l’un est forcément la cause de l’autre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#correlationCausationFallacy</IRI>
    <Literal xml:lang="EN">Seeing the concomitance of two phenomena as proof that one causes the other.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#correlationCausationFallacy</IRI>
    <Literal xml:lang="FR">D’après les statistiques, la hausse des températures mondiales coïncide avec l’augmentation des ventes de glaces ; les glaces doivent donc contribuer au réchauffement climatique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#correlationCausationFallacy</IRI>
    <Literal xml:lang="EN">Following the stats, global warming trends coincide with increased ice cream sales; hence, ice cream must contribute to global warming.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#correlationCausationFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Correlation_does_not_imply_causation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#correlationCausationFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#correlationCausationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocFallacy</IRI>
    <Literal xml:lang="FR">Confusion entre antériorité et causalité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocFallacy</IRI>
    <Literal xml:lang="EN">Post Hoc Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocFallacy</IRI>
    <Literal xml:lang="FR">Vous supposez qu’un événement est la cause d’un autre uniquement parce qu’il l’a précédé dans le temps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocFallacy</IRI>
    <Literal xml:lang="EN">Seeing the succession of two phenomena as the proof that the one occuring first is the cause of the one occuring after.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocFallacy</IRI>
    <Literal xml:lang="FR">Le merle chante juste avant le lever du soleil ; son chant fait donc se lever le soleil.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocFallacy</IRI>
    <Literal xml:lang="EN">The blackbird sings just before sunrise, so the blackbird's song must cause the sun to rise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Post_hoc_ergo_propter_hoc</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressionFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressionFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de régression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressionFallacy</IRI>
    <Literal xml:lang="EN">Regression fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressionFallacy</IRI>
    <Literal xml:lang="FR">Vous attribuez à tort un effet particulier à ce qui n’est qu’un retour à la normale après une fluctuation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressionFallacy</IRI>
    <Literal xml:lang="EN">Mistakenly attributing a particular effect to what is merely a return to normal after a fluctuation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressionFallacy</IRI>
    <Literal xml:lang="FR">Comme j’étais très malade, j’ai prié et cela m’a guéri.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressionFallacy</IRI>
    <Literal xml:lang="EN">Since I was very ill, I prayed and that healed me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressionFallacy</IRI>
    <Literal xml:lang="EN">http://www.skepdic.com/regressive.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressionFallacy</IRI>
    <Literal xml:lang="FR">http://www.fallacyfiles.org/regressf.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressionFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <Literal xml:lang="FR">Pêche aux données</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <Literal xml:lang="EN">Post-designation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <Literal xml:lang="FR">Vous cherchez dans les données, après coup, un résultat qui soutient votre thèse, au lieu de définir à l’avance ce que vous vouliez démontrer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <Literal xml:lang="EN">Drawing a conclusion from a tendency observed in a sample, but without having declared the searched tendency prior to studying the sample.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <Literal xml:lang="FR">En analysant les habitudes alimentaires de cent personnes, nous avons découvert que celles qui mangent du chocolat le matin sont plus productives. Cela prouve que le chocolat augmente la productivité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <Literal xml:lang="EN">In analyzing the eating habits of one hundred people, we found that those who eat chocolate in the morning are more productive. This proves that chocolate increases productivity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/142/Post-Designation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#texasSharpshooter</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#texasSharpshooter</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#texasSharpshooter</IRI>
    <Literal xml:lang="FR">Tireur d’élite texan</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#texasSharpshooter</IRI>
    <Literal xml:lang="EN">Texas sharpshooter</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#texasSharpshooter</IRI>
    <Literal xml:lang="FR">Vous repérez une tendance après coup et vous inventez une cause pour faire correspondre le résultat à vos convictions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#texasSharpshooter</IRI>
    <Literal xml:lang="EN">Assigning a common cause to a pattern. This results in forcing the outcome to adjust to one's belief, shaping the facts until they fit the theory.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#texasSharpshooter</IRI>
    <Literal xml:lang="FR">On trouve des pyramides au Mexique, en Égypte et au Cambodge, ce qui prouve qu’une même entité a inspiré tous ces peuples.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#texasSharpshooter</IRI>
    <Literal xml:lang="EN">Pyramids can be found in Mexico, Egypt, and Cambodia, which proves that the same entity inspired all these peoples.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#texasSharpshooter</IRI>
    <Literal xml:lang="EN">http://www.skepdic.com/texas.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#texasSharpshooter</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme_du_tireur_d'%C3%A9lite_texan</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#texasSharpshooter</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#texasSharpshooter</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#multipleComparisonsFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#multipleComparisonsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#multipleComparisonsFallacy</IRI>
    <Literal xml:lang="FR">Comparaisons multiples</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#multipleComparisonsFallacy</IRI>
    <Literal xml:lang="EN">Multiple Comparisons Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#multipleComparisonsFallacy</IRI>
    <Literal xml:lang="FR">Vous multipliez les comparaisons en espérant que l’une renforcera par hasard votre thèse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#multipleComparisonsFallacy</IRI>
    <Literal xml:lang="EN">Multiplying statistical comparisons untill one proves the hypothesis thanks to luck.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#multipleComparisonsFallacy</IRI>
    <Literal xml:lang="FR">Nous avons effectué 20 études, et l’une d’entre elles indique un risque statistique de plus de 5 %. Le risque est donc avéré.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#multipleComparisonsFallacy</IRI>
    <Literal xml:lang="EN">After conducting 20 studies, one of them showed a statistical risk above 5%. Therefore, this is considered proof of the risk.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#multipleComparisonsFallacy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/multcomp.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#multipleComparisonsFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#multipleComparisonsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoehorning</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoehorning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoehorning</IRI>
    <Literal xml:lang="FR">Sophisme du chausse-pied</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoehorning</IRI>
    <Literal xml:lang="EN">Shoehorning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoehorning</IRI>
    <Literal xml:lang="FR">Vous arrangez les faits de manière biaisée pour défendre votre thèse, au mépris de la rigueur scientifique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoehorning</IRI>
    <Literal xml:lang="EN">You arrange the facts in a biased way to support your claim, with no regard for scientific rigor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoehorning</IRI>
    <Literal xml:lang="FR">Le travail coûte trop cher en France. La preuve : nous n’avons pas remporté cet appel d’offres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoehorning</IRI>
    <Literal xml:lang="EN">Labor costs are too high in France. This is proven by our failure to secure the tender.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoehorning</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/161/Shoehorning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoehorning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shoehorning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#occultStats</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#occultStats</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#occultStats</IRI>
    <Literal xml:lang="FR">Statistiques de l’occulte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#occultStats</IRI>
    <Literal xml:lang="EN">Occult stats</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#occultStats</IRI>
    <Literal xml:lang="FR">Vous trouvez dans des anomalies statistiques la preuve de certaines croyances irrationnelles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#occultStats</IRI>
    <Literal xml:lang="EN">Seeing in statistical anomalies the proof of some irrational beliefs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#occultStats</IRI>
    <Literal xml:lang="FR">Je vous présente notre dernière étude, fondée sur les statistiques de cette compagnie d’assurance, qui démontre enfin l’effet de Mars dans nos vies.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#occultStats</IRI>
    <Literal xml:lang="EN">Let me show you our latest study based on this insurance company's statistics, finally proving the effect of Mars in our lives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#occultStats</IRI>
    <Literal xml:lang="EN">http://skepdic.com/occultstats.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#occultStats</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#occultStats</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postdesignation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="FR">Corrélation illusoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="EN">Illusory correlation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="FR">Vous percevez une relation entre deux variables qui ne sont pas liées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="EN">Perceiving a relationship between two unrelated variables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="FR">Chaque fois que je porte ce pull, mon équipe gagne ; ce pull leur porte donc chance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="EN">Every time I wear this sweater, my team wins; this sweater therefore brings them luck.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Illusory_correlation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Corr%C3%A9lation_illusoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedRelationship</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="FR">Illusion de regroupement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="EN">Clustering Illusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="FR">Vous percevez des motifs ou des tendances dans des données aléatoires ou sans lien, ce qui crée une fausse impression de corrélation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="EN">Perceiving patterns or trends in random or unrelated data, creating a false impression of correlation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="FR">Regardez cette série de nombres : il y a sûrement un motif secret derrière !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="EN">Look at this sequence of numbers; surely, there's a hidden pattern here!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Clustering_illusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Illusion_des_s%C3%A9ries</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <Literal xml:lang="FR">Probabilités faussées</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <Literal xml:lang="EN">Probabilistic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <Literal xml:lang="FR">Vous utilisez mal les probabilités pour appuyer votre argument, ce qui fausse votre raisonnement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <Literal xml:lang="EN">Misusing probabilistic reasoning to bolster an argument, thereby distorting the logical conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <Literal xml:lang="FR">L’ADN laissé par l’auteur de ce crime présente une particularité que l’on retrouve chez l’accusé et chez seulement 10 % de la population ; on peut donc affirmer avec 90 % de certitude que cet homme est coupable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <Literal xml:lang="EN">The DNA left by the perpetrator of this crime has a particular trait found in the accused and in only 10% of the population; one can therefore claim with 90% certainty that this man is guilty.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/probfall.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToProbability</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToProbability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToProbability</IRI>
    <Literal xml:lang="FR">Appel à la probabilité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToProbability</IRI>
    <Literal xml:lang="EN">Appeal to probability</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToProbability</IRI>
    <Literal xml:lang="FR">Vous tenez pour certain ce qui n’est qu’une simple possibilité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToProbability</IRI>
    <Literal xml:lang="EN">Treating as certain what is merely a possibility.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToProbability</IRI>
    <Literal xml:lang="FR">Si je ne prends pas mon parapluie, il va forcément pleuvoir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToProbability</IRI>
    <Literal xml:lang="EN">If I forgot to take my umbrella, it's surely going to rain.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToProbability</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_probability</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToProbability</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToProbability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justInCaseFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justInCaseFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justInCaseFallacy</IRI>
    <Literal xml:lang="FR">Sophisme du cas où</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justInCaseFallacy</IRI>
    <Literal xml:lang="EN">Just in case fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justInCaseFallacy</IRI>
    <Literal xml:lang="FR">Votre argumentation repose sur les pires scénarios possibles plutôt que sur les plus plausibles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justInCaseFallacy</IRI>
    <Literal xml:lang="EN">Making an argument based on the worst-case scenario rather than the most probable scenario.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justInCaseFallacy</IRI>
    <Literal xml:lang="FR">Vous devriez acheter une alarme : on ne sait jamais, de nos jours.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justInCaseFallacy</IRI>
    <Literal xml:lang="EN">You should buy an alarm: you never know, these days.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justInCaseFallacy</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/116/Just-In-Case-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToProbability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justInCaseFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justInCaseFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToProbability</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
    <Literal xml:lang="FR">Appel à la probabilité conditionnelle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
    <Literal xml:lang="EN">Appeal to conditional probability</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
    <Literal xml:lang="FR">Vous fondez votre argumentation sur une hypothèse qui dépend elle-même de la réalisation d’un événement donné.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
    <Literal xml:lang="EN">Basing an argument on a conjecture that itself presupposes the occurrence of a given event.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
    <Literal xml:lang="FR">Je pense qu’en prenant le vol de 8 h demain, plutôt que celui de 20 h ce soir, j’aurai plus de chances d’arriver à l’heure à ma réunion, car les retards sont statistiquement moins fréquents le matin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
    <Literal xml:lang="EN">I think that by taking the 8 a.m. flight tomorrow rather than the 8 p.m. one tonight, I will have a better chance of arriving on time for my meeting, because delays are statistically less frequent in the morning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baseRateFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baseRateFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baseRateFallacy</IRI>
    <Literal xml:lang="FR">Oubli de la fréquence de base</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baseRateFallacy</IRI>
    <Literal xml:lang="EN">Base Rate Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baseRateFallacy</IRI>
    <Literal xml:lang="FR">Vous ignorez les statistiques de départ dans votre calcul des probabilités, ce qui vous conduit à surestimer certains résultats.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baseRateFallacy</IRI>
    <Literal xml:lang="EN">Estimating conditional probabilities without taking into account baseline probabilities.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baseRateFallacy</IRI>
    <Literal xml:lang="FR">J’ai mal à la nuque, et c’est l’un des principaux symptômes de la méningite. J’ai vraiment peur d’en avoir une.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baseRateFallacy</IRI>
    <Literal xml:lang="EN">I have a sore neck, and it is one of the main symptoms of meningitis. I am really afraid I might have it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baseRateFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Base_rate_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baseRateFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Oubli_de_la_fréquence_de_base</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baseRateFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baseRateFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doomsdayArgument</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doomsdayArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doomsdayArgument</IRI>
    <Literal xml:lang="FR">Argument de l’Apocalypse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doomsdayArgument</IRI>
    <Literal xml:lang="EN">Doomsday argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doomsdayArgument</IRI>
    <Literal xml:lang="FR">Vous prédisez des événements extrêmes en vous fondant sur des hypothèses probabilistes erronées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doomsdayArgument</IRI>
    <Literal xml:lang="EN">Predicting extreme events based on erroneous probabilistic assumptions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doomsdayArgument</IRI>
    <Literal xml:lang="FR">On sait le nombre d’hommes qui nous précède, c’est assez peu, il y a de grandes chances que la taille de l’ensemble de ceux qui nous suivent n’en soit qu’un petit multiple donc notre fin est proche</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doomsdayArgument</IRI>
    <Literal xml:lang="EN">I know the number of humans who came before us; it is fairly small, so there is a strong chance that the total number of those who will follow us is only a small multiple of it, and therefore our end is near.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doomsdayArgument</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Doomsday_argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doomsdayArgument</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argument_de_l'apocalypse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doomsdayArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doomsdayArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prosecutorsFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prosecutorsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prosecutorsFallacy</IRI>
    <Literal xml:lang="FR">Sophisme du procureur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prosecutorsFallacy</IRI>
    <Literal xml:lang="EN">Prosecutor's fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prosecutorsFallacy</IRI>
    <Literal xml:lang="FR">Vous confondez la probabilité qu’un événement se produise en général avec la probabilité qu’il se soit produit dans un cas particulier.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prosecutorsFallacy</IRI>
    <Literal xml:lang="EN">Confusing the general probability of an occurrence with the probability that it happened in a specific case.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prosecutorsFallacy</IRI>
    <Literal xml:lang="FR">La probabilité que ces deux nourrissons soient tous deux victimes de mort subite est inférieure à une sur l’ensemble de la population de notre pays. C’est donc bien que leur mère est coupable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prosecutorsFallacy</IRI>
    <Literal xml:lang="EN">The chance of both infants being victims of sudden infant death syndrome is less than one in the entire population of our country. This must mean their mother is guilty.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prosecutorsFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Prosecutor%27s_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prosecutorsFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme_du_procureur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prosecutorsFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prosecutorsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusionOfTheInverse</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusionOfTheInverse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusionOfTheInverse</IRI>
    <Literal xml:lang="FR">Appel aux probabilités inversées</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusionOfTheInverse</IRI>
    <Literal xml:lang="EN">Confusion of the inverse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusionOfTheInverse</IRI>
    <Literal xml:lang="FR">Vous inversez les probabilités en confondant la probabilité qu’un événement en implique un autre avec la probabilité inverse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusionOfTheInverse</IRI>
    <Literal xml:lang="EN">Assuming that, given two events A and B, the probability of A happening given that B has happened is about the same as the probability of B given A.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusionOfTheInverse</IRI>
    <Literal xml:lang="FR">90 % des patients qui ont suivi ce traitement ont guéri. Il est donc efficace à 90 %.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusionOfTheInverse</IRI>
    <Literal xml:lang="EN">90% of patients who followed this treatment recovered. It is therefore 90% effective.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusionOfTheInverse</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Confusion_of_the_inverse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusionOfTheInverse</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusionOfTheInverse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConditionalProbability</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <Literal xml:lang="FR">Sophisme de la ruine du joueur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <Literal xml:lang="EN">Gambler's ruin</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <Literal xml:lang="FR">Vous présentez une série de paris apparemment équitables sans tenir compte du risque de perte totale à long terme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <Literal xml:lang="EN">You present a series of seemingly fair bets without taking into account the risk of losing everything in the long run.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <Literal xml:lang="FR">Je mise toujours sur le rouge à la roulette : après plusieurs tours, ma couleur finit bien par sortir. Cette stratégie est donc infaillible, et je vais doubler ma mise au prochain coup pour récupérer mes pertes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <Literal xml:lang="EN">I always bet on red at roulette: after several spins, my color is bound to come up eventually. This strategy is therefore infallible, and I will double my bet on the next round to recover my losses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Gambler%27s_ruin</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hotHandFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hotHandFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hotHandFallacy</IRI>
    <Literal xml:lang="FR">Main chaude</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hotHandFallacy</IRI>
    <Literal xml:lang="EN">Hot hand fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hotHandFallacy</IRI>
    <Literal xml:lang="FR">Vous croyez que vos succès récents augmenteront vos chances de réussir à nouveau.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hotHandFallacy</IRI>
    <Literal xml:lang="EN">You believe that your recent successes will increase your chances of succeeding again.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hotHandFallacy</IRI>
    <Literal xml:lang="FR">J’ai marqué mes trois derniers paniers : je suis en réussite, donc je vais forcément réussir le prochain tir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hotHandFallacy</IRI>
    <Literal xml:lang="EN">I made my last three baskets: I’m on a hot streak, so I’m definitely going to make the next shot.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hotHandFallacy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/hothandf.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hotHandFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hotHandFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="FR">Erreur du parieur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="EN">Gambler's fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="FR">Vous supposez que des écarts statistiques vont forcément se compenser lors de futurs événements aléatoires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="EN">Arguing that statistical variations will be compensated by future outcomes of random bets.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="FR">Après tout ce qui m’est arrivé de terrible aujourd’hui, je crois que la roue va tourner ; je vais donc jouer au loto.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="EN">After all the terrible things that have happened to me today, I think my luck is about to change, so I'm going to play the lottery.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Gambler%27s_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Erreur_du_parieur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseGamblersFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseGamblersFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseGamblersFallacy</IRI>
    <Literal xml:lang="FR">Erreur inverse du parieur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseGamblersFallacy</IRI>
    <Literal xml:lang="EN">Inverse gambler's fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseGamblersFallacy</IRI>
    <Literal xml:lang="FR">Vous déduisez à tort qu’un événement peu probable est le résultat de nombreuses tentatives précédentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseGamblersFallacy</IRI>
    <Literal xml:lang="EN">Concluding, on the basis of an unlikely outcome of a random process, that the process is likely to have occurred many times before.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseGamblersFallacy</IRI>
    <Literal xml:lang="FR">Vous venez de faire trois double-six de suite ? Mais depuis combien de temps jouez-vous ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseGamblersFallacy</IRI>
    <Literal xml:lang="EN">You got three double-sixes in a row? But since when have you been playing?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseGamblersFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Inverse_gambler%27s_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseGamblersFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseGamblersFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersConceit</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersConceit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersConceit</IRI>
    <Literal xml:lang="FR">Vanité du parieur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersConceit</IRI>
    <Literal xml:lang="EN">Gambler's conceit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersConceit</IRI>
    <Literal xml:lang="FR">Vous croyez pouvoir arrêter un jeu de hasard à temps pour conserver vos gains et éviter la faillite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersConceit</IRI>
    <Literal xml:lang="EN">Vainly trusting one's self-control to enable them to stop playing while still ahead in winnings and thus avoid bankrupcy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersConceit</IRI>
    <Literal xml:lang="FR">J’arrête de parier dès que j’ai gagné davantage que ce que j’ai perdu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersConceit</IRI>
    <Literal xml:lang="EN">I'll stop betting as soon as I've gained more than I've lost.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersConceit</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Gambler%27s_conceit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersConceit</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersConceit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersRuin</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conjunctionFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conjunctionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conjunctionFallacy</IRI>
    <Literal xml:lang="FR">Erreur de conjonction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conjunctionFallacy</IRI>
    <Literal xml:lang="EN">Conjunction fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conjunctionFallacy</IRI>
    <Literal xml:lang="FR">Vous jugez une situation particulière plus probable qu’une situation plus générale, alors qu’elle ne peut pas l’être.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conjunctionFallacy</IRI>
    <Literal xml:lang="EN">You judge a specific situation to be more likely than a more general one, even though it cannot be.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conjunctionFallacy</IRI>
    <Literal xml:lang="FR">Il a de bonnes chances de gagner ce match, mais elles seraient encore meilleures s’il perdait le premier set, comme cela lui arrive souvent, puis remportait les deux suivants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conjunctionFallacy</IRI>
    <Literal xml:lang="EN">He has a good chance of winning this match, but his chances would be even better if he lost the first set, as he often does, and then won the next two.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conjunctionFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Conjunction_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conjunctionFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Erreur_de_conjonction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conjunctionFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conjunctionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#probabilisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
    <Literal xml:lang="FR">Infini fallacieux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
    <Literal xml:lang="EN">Deceptive infinity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
    <Literal xml:lang="FR">Votre argument repose sur une mauvaise compréhension de la notion d’infini.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
    <Literal xml:lang="EN">Involving an improper appreciation of infinite notions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
    <Literal xml:lang="FR">Cette affirmation est vraie. — Mais comment le savez-vous ? Je l’ai vérifiée. — Mais comment avez-vous vérifié cette vérification ? Et la vérification de cette vérification, comment l’avez-vous vérifiée ? … — Régression à l’infini de la justification épistémique : chaque niveau de preuve en exige un autre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
    <Literal xml:lang="EN">This statement is true. — But how do you know? I verified it. — But how did you verify that verification? And how did you verify the verification of that verification? … — An infinite regress of epistemic justification: each level of evidence requires another.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#interpretationFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Gradualism_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuumFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuumFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuumFallacy</IRI>
    <Literal xml:lang="FR">Sophisme du continuum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuumFallacy</IRI>
    <Literal xml:lang="EN">Continuum fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuumFallacy</IRI>
    <Literal xml:lang="FR">Vous niez le caractère continu ou progressif d’un phénomène et exigez des limites strictes là où il n’y en a pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuumFallacy</IRI>
    <Literal xml:lang="EN">You deny the continuous or gradual nature of a phenomenon and demand strict boundaries where none exist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuumFallacy</IRI>
    <Literal xml:lang="FR">Quel mal peut faire une cigarette de plus ou de moins ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuumFallacy</IRI>
    <Literal xml:lang="EN">What difference does one more cigarette make?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuumFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Continuum_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuumFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuumFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="FR">Argument de la barbe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="EN">Argument of the beard</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="FR">En affirmant qu’il n’existe pas de frontière claire entre deux états, vous refusez de les distinguer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="EN">Denying the possibility of an opposite state by arguing that there is no decisive boundary between the two states.
</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="FR">Il y a un risque à tout. Si on commence à porter un casque pour faire du vélo, autant porter un casque tout le temps !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="EN">There is risk in everything. If we start wearing helmets to ride a bike, we might as well wear helmets all the time!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/58/Argument-of-the-Beard</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuumFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuumFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
    <Literal xml:lang="FR">Mauvais argument de la régression infinie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
    <Literal xml:lang="EN">Bad regress argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
    <Literal xml:lang="FR">Votre argument repose sur une mauvaise appréciation d’une chaîne infinie de justifications.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
    <Literal xml:lang="EN">Involving an improper appreciation of an infinite sequence of justifications.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
    <Literal xml:lang="FR">Si l’univers est infini, c’est qu’il doit y avoir quelque chose au-delà de chaque limite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
    <Literal xml:lang="EN">If the universe is infinite, there must be something beyond every limit. Therefore, what lies beyond? It's an endless question.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Regress_argument_(epistemology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argument_de_la_r%C3%A9gression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveInfinity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
    <Literal xml:lang="FR">Régression infinie vicieuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
    <Literal xml:lang="EN">Vicious Infinite regress</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
    <Literal xml:lang="FR">Vous construisez une chaîne de causalité infinie qui mène à une incohérence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
    <Literal xml:lang="EN">Building an infinite chain of causality that leads to inconsistency.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
    <Literal xml:lang="FR">Si Dieu a créé l’homme, qui a créé Dieu ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
    <Literal xml:lang="EN">But if god made Man, who made God?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Infinite_regress#Viciousness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/R%C3%A9gression_%C3%A0_l%27infini</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homunculusArgument</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homunculusArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homunculusArgument</IRI>
    <Literal xml:lang="FR">Hypothèse de l’homoncule</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homunculusArgument</IRI>
    <Literal xml:lang="EN">Homunculus argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homunculusArgument</IRI>
    <Literal xml:lang="FR">Vous tentez d’expliquer un phénomène en le réduisant à une version plus simple de lui-même, ce qui mène à un raisonnement circulaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homunculusArgument</IRI>
    <Literal xml:lang="EN">Trying to explain a phenomenon by reducing it to a simpler version of itself, which leads to circular reasoning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homunculusArgument</IRI>
    <Literal xml:lang="FR">Pour comprendre le système visuel, imaginez la rétine comme un écran de cinéma que vous regardez à l’envers, à l’arrière de votre cerveau.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homunculusArgument</IRI>
    <Literal xml:lang="EN">Consider the retina as a movie screen you are watching from behind your brain to understand the visual system.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homunculusArgument</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Homunculus_argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homunculusArgument</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Hypothèse_de_l%27homoncule</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homunculusArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homunculusArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#viciousInfiniteRegress</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
    <Literal xml:lang="FR">Mauvais argument de la régression infinie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
    <Literal xml:lang="EN">Bad infinite regress argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
    <Literal xml:lang="FR">Vous dénoncez à tort une régression infinie comme étant vicieuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
    <Literal xml:lang="EN">Wrongly denouncing an infinite regress as vicious.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
    <Literal xml:lang="FR">Si vous demandez pourquoi nous faisons cela, puis pourquoi cela est vrai, et encore pourquoi, vous ne ferez que vous embourber dans des questions sans fin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
    <Literal xml:lang="EN">Asking 'why' to every explanation just leads you into an endless loop of questions with no definitive answer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Infinite_regress#Viciousness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/R%C3%A9gression_%C3%A0_l%27infini</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badRegressArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endlessJustificationDemand</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endlessJustificationDemand</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endlessJustificationDemand</IRI>
    <Literal xml:lang="FR">Justification infinie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endlessJustificationDemand</IRI>
    <Literal xml:lang="EN">Endless Justification Demand</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endlessJustificationDemand</IRI>
    <Literal xml:lang="FR">Vous demandez sans cesse davantage d’explications tout en évitant d’aboutir à une conclusion claire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endlessJustificationDemand</IRI>
    <Literal xml:lang="EN">Demanding justification for each justification, in a never ending process.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endlessJustificationDemand</IRI>
    <Literal xml:lang="FR">Mais pourquoi ? Et d’où vient cette information ? Et pourquoi devrais-je croire cette source ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endlessJustificationDemand</IRI>
    <Literal xml:lang="EN">But why? Where does that information come from? And why should I believe that source?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endlessJustificationDemand</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endlessJustificationDemand</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badInfiniteRegressArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
    <Literal xml:lang="FR">Conclusion mathématique invalide</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
    <Literal xml:lang="EN">Invalid result</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
    <Literal xml:lang="FR">Vous tirez une conclusion à partir d’un raisonnement mathématique incorrect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
    <Literal xml:lang="EN">Drawing conclusions based on incorrect mathematical reasoning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
    <Literal xml:lang="FR">L’accélération moyenne de la voiture A est supérieure à celle de la voiture B ; la voiture A va donc plus vite que la voiture B.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
    <Literal xml:lang="EN">Car A's average acceleration is greater than Car B's; therefore, Car A is going faster than Car B.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="FR">Imprécision</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="EN">Vagueness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="FR">Vos arguments s’appuient sur des données imprécises, ce qui conduit à des conclusions incertaines.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="EN">Your arguments are based on imprecise data, which leads to uncertain conclusions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="FR">Pour le même prix, offrez-vous notre nouvelle formule double fraîcheur !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="EN">Try our new formula with double fresh effect for the same price.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/vaguenes.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="FR">Fausse précision</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="EN">False precision</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="FR">Vous présentez des données numériques qui paraissent précises, alors que ce niveau de précision n’est pas justifié.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="EN">Presenting numerical data in a manner that implies better precision than is justified, often to pretend exaggerated accuracy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="FR">Le squelette de ce dinosaure a 100 000 005 ans : il y a cinq ans, des scientifiques estimaient qu’il avait 100 000 000 ans.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="EN">This dinosaur skeleton is 100,000,005 years old, because an expert told me 5 years ago that it was 100 million years old.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/False_precision</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingWithStatistics</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingWithStatistics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingWithStatistics</IRI>
    <Literal xml:lang="FR">Statistiques manipulées</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingWithStatistics</IRI>
    <Literal xml:lang="EN">Lying with statistics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingWithStatistics</IRI>
    <Literal xml:lang="FR">Vous présentez les données de manière biaisée pour soutenir votre argumentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingWithStatistics</IRI>
    <Literal xml:lang="EN">Presenting data in a biased way to support an argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingWithStatistics</IRI>
    <Literal xml:lang="FR">Regardez : après l’effondrement des ventes le mois dernier, nos chiffres ont presque doublé ce mois-ci ! Nos clients ont décidé de nous faire à nouveau confiance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingWithStatistics</IRI>
    <Literal xml:lang="EN">See, after sales collapsed last month, our numbers have almost doubled this month! Our customers have decided to trust us again.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingWithStatistics</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/122/Lying-with-Statistics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingWithStatistics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingWithStatistics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <Literal xml:lang="FR">Faux équilibre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <Literal xml:lang="EN">False balance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <Literal xml:lang="FR">Vous attribuez le même poids à deux avis divergents, de manière injustifiée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <Literal xml:lang="EN">Presenting opposing viewpoints as more balanced than they actually are.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <Literal xml:lang="FR">La communauté scientifique est divisée quant à la réalité du changement climatique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <Literal xml:lang="EN">The reality of global warming is a matter of debate within the scientific community.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/False_balance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Faux_%C3%A9quilibre_m%C3%A9diatique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConflictAsAPretext</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConflictAsAPretext</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConflictAsAPretext</IRI>
    <Literal xml:lang="FR">Appel au conflit comme prétexte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConflictAsAPretext</IRI>
    <Literal xml:lang="EN">Appeal to conflict as a pretext</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConflictAsAPretext</IRI>
    <Literal xml:lang="FR">Vous affirmez qu’une conclusion est introuvable sous prétexte que les experts divergent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConflictAsAPretext</IRI>
    <Literal xml:lang="EN">Claiming that a conclusion cannot be found on the pretext that experts disagree.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConflictAsAPretext</IRI>
    <Literal xml:lang="FR">Dans cette affaire politique, les experts expriment tellement d’avis différents qu’il serait impossible de se faire une idée juste. Autant ne rien changer et laisser les choses telles quelles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConflictAsAPretext</IRI>
    <Literal xml:lang="EN">In this political matter, the experts express so many different opinions that it would be impossible for me to form a sound view. I might as well change nothing and leave things as they are.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConflictAsAPretext</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/113/Inflation-of-Conflict</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConflictAsAPretext</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConflictAsAPretext</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#uncertaintyTactic</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#uncertaintyTactic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#uncertaintyTactic</IRI>
    <Literal xml:lang="FR">Tactique de l’incertitude</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#uncertaintyTactic</IRI>
    <Literal xml:lang="EN">Uncertainty tactic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#uncertaintyTactic</IRI>
    <Literal xml:lang="FR">Vous formulez des critiques contre une thèse consensuelle afin de la placer sur un pied d’égalité avec votre propre proposition, pourtant difficile à défendre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#uncertaintyTactic</IRI>
    <Literal xml:lang="EN">Contradicting the consensus on well-established facts to show the reality as uncertain and defend spurious hypotheses</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#uncertaintyTactic</IRI>
    <Literal xml:lang="FR">Même s’il est établi que le goudron de la cigarette est cancérigène, tout le monde inhale dans la rue de nombreuses particules fines cancérigènes. La cigarette ne serait donc pas plus nocive.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#uncertaintyTactic</IRI>
    <Literal xml:lang="EN">Even though cigarette tar is established to be carcinogenic, everyone inhales many carcinogenic fine particles in the street. Cigarettes would therefore be no more harmful.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#uncertaintyTactic</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Uncertainty_tactic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConflictAsAPretext</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#uncertaintyTactic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#uncertaintyTactic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConflictAsAPretext</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
    <Literal xml:lang="FR">Juste milieu</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
    <Literal xml:lang="EN">Golden mean fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
    <Literal xml:lang="FR">Face à deux positions antagonistes, vous affirmez que la solution réside dans le compromis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
    <Literal xml:lang="EN">Asserting that the truth must be found as a compromise between two opposite positions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
    <Literal xml:lang="FR">Vous préférez le lundi et moi le mercredi ? Coupons la poire en deux et voyons-nous mardi !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
    <Literal xml:lang="EN">You prefer Monday and I Wednesday: let's meetup on Tuesday.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argument_to_moderation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
    <Literal xml:lang="FR">https://yourlogicalfallacyis.com/fr/le-juste-milieu</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#designByCommitte</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#designByCommitte</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#designByCommitte</IRI>
    <Literal xml:lang="FR">Design par comité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#designByCommitte</IRI>
    <Literal xml:lang="EN">Design by committe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#designByCommitte</IRI>
    <Literal xml:lang="FR">Votre proposition, élaborée avec plusieurs autres personnes, manque de cohérence parce qu’aucune autorité n’a permis d’unifier les idées de chacun.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#designByCommitte</IRI>
    <Literal xml:lang="EN">Having a proposal, developed with several other people, lack coherence because no authority unified everyone's ideas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#designByCommitte</IRI>
    <Literal xml:lang="FR">Notre logiciel inclut toutes les fonctionnalités demandées par chaque département pour garantir sa pertinence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#designByCommitte</IRI>
    <Literal xml:lang="EN">Our software includes all the features requested by each department to ensure its relevance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#designByCommitte</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Design_by_committee</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#designByCommitte</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#designByCommitte</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goldenMeanFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brokenWindowFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brokenWindowFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brokenWindowFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de la vitre cassée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brokenWindowFallacy</IRI>
    <Literal xml:lang="EN">Broken window fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brokenWindowFallacy</IRI>
    <Literal xml:lang="FR">Vous prétendez que la destruction d’un bien enrichit la société grâce à l’activité économique qu’elle engendre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brokenWindowFallacy</IRI>
    <Literal xml:lang="EN">Arguing that destroying things to rebuild them anew enriches society as a whole.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brokenWindowFallacy</IRI>
    <Literal xml:lang="FR">Après la tempête, les vitrines des boutiques ont été brisées. Cela devrait stimuler l’économie locale grâce à toutes les réparations nécessaires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brokenWindowFallacy</IRI>
    <Literal xml:lang="EN">After the storm, shop windows were shattered. This should boost the local economy with all the necessary repairs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brokenWindowFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Parable_of_the_broken_window</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brokenWindowFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme_de_la_vitre_cassée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brokenWindowFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brokenWindowFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseBalance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <Literal xml:lang="FR">Appel aux extrêmes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <Literal xml:lang="EN">Appeal to extremes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <Literal xml:lang="FR">Vous dénaturez un argument valable en le poussant à l’extrême, jusqu’à l’absurde.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <Literal xml:lang="EN">Erroneously attempting to make a reasonable argument into an absurd one, by taking the argument to the extremes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <Literal xml:lang="FR">Ils disent que le sport est bon pour la santé, mais à raison d’un marathon par jour, on se détruit à coup sûr.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <Literal xml:lang="EN">They say exercise is good for health, but running a marathon every day is just going to wear you out.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/30/Appeal-to-Extremes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="FR">Pente glissante</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="EN">Slippery slope</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="FR">Vous rejetez une proposition en prédisant une série peu probable d’événements négatifs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="EN">You reject a proposal by predicting an unlikely series of negative events.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="FR">Si nous le laissons se resservir de ce plat, il prendra l’habitude de trop manger et finira obèse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="EN">If you let him have another piece, he'll get used to eating too much and end up obese.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Slippery_slope</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pente_savonneuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrowMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradeOfHorribles</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradeOfHorribles</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradeOfHorribles</IRI>
    <Literal xml:lang="FR">Défilé des horreurs</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradeOfHorribles</IRI>
    <Literal xml:lang="EN">Parade of horribles</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradeOfHorribles</IRI>
    <Literal xml:lang="FR">Vous présentez des conséquences dramatiques et peu probables comme inévitables afin de dissuader d’une action.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradeOfHorribles</IRI>
    <Literal xml:lang="EN">You present dramatic and unlikely consequences as inevitable in order to discourage an action.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradeOfHorribles</IRI>
    <Literal xml:lang="FR">Cette nouvelle politique de santé va entraîner des listes d’attente interminables, des praticiens à bout de nerf, des soins de qualité médiocre, des patients laissés sans traitement et une explosion sans précédent de la mortalité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradeOfHorribles</IRI>
    <Literal xml:lang="EN">This health policy will lead to endless waiting lists, overwhelmed practitioners, poor quality care, untreated patients, and an unprecedented spike in mortality rates.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradeOfHorribles</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Parade_of_horribles</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradeOfHorribles</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradeOfHorribles</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensoriousAbuse</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensoriousAbuse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensoriousAbuse</IRI>
    <Literal xml:lang="FR">Appel à l’abus censeur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensoriousAbuse</IRI>
    <Literal xml:lang="EN">Appeal to censorious abuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensoriousAbuse</IRI>
    <Literal xml:lang="FR">Vous affirmez qu’il faut interdire un usage au motif que certaines personnes en abusent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensoriousAbuse</IRI>
    <Literal xml:lang="EN">To argue that something must be forbidden because it is sometimes abused.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensoriousAbuse</IRI>
    <Literal xml:lang="FR">Puisque certains parents utilisent abusivement la télévision comme nounou pour leurs enfants, il faudrait interdire l’accès à la télévision à tous les mineurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensoriousAbuse</IRI>
    <Literal xml:lang="EN">Since some parents abusively use television as a babysitter for their children, access to television should be banned for all minors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensoriousAbuse</IRI>
    <Literal xml:lang="FR">https://www.eyrolles.com/Chapitres/9782708135291/chapA_Grigorieff.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensoriousAbuse</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCensoriousAbuse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leastPlausibleHypothesis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leastPlausibleHypothesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leastPlausibleHypothesis</IRI>
    <Literal xml:lang="FR">Hypothèse peu plausible</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leastPlausibleHypothesis</IRI>
    <Literal xml:lang="EN">Least Plausible Hypothesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leastPlausibleHypothesis</IRI>
    <Literal xml:lang="FR">Entre plusieurs explications, vous choisissez la plus improbable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leastPlausibleHypothesis</IRI>
    <Literal xml:lang="EN">Choosing less plausible explanations over more likely ones.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leastPlausibleHypothesis</IRI>
    <Literal xml:lang="FR">Il doit vraiment avoir une dent contre moi pour m’avoir attribué une si mauvaise note.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leastPlausibleHypothesis</IRI>
    <Literal xml:lang="EN">He must really have a grudge against me for giving me such a poor grade.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leastPlausibleHypothesis</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/117/Least_Plausible_Hypothesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leastPlausibleHypothesis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leastPlausibleHypothesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToExtremes</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
    <Literal xml:lang="FR">Erreur de calcul</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
    <Literal xml:lang="EN">Erroneous calculation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
    <Literal xml:lang="FR">Votre conclusion résulte d’une erreur de calcul.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
    <Literal xml:lang="EN">Making errors in the calculation from which conclusions are drawn.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
    <Literal xml:lang="FR">Sachant qu’un croissant coûte un euro et cinquante centimes, avec dix euros, vous pouvez largement en acheter huit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
    <Literal xml:lang="EN">Given that a croissant costs one euro and fifty cents, with ten euros you can easily buy eight.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleCounting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleCounting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleCounting</IRI>
    <Literal xml:lang="FR">Double compte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleCounting</IRI>
    <Literal xml:lang="EN">Double counting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleCounting</IRI>
    <Literal xml:lang="FR">Vous comptez deux fois le même élément dans un calcul, ce qui fausse le résultat final.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleCounting</IRI>
    <Literal xml:lang="EN">Counting the same element twice in a calculation, thereby distorting the final result.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleCounting</IRI>
    <Literal xml:lang="FR">Si on joue deux fois à pile ou face, je suis certain de gagner au moins une fois.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleCounting</IRI>
    <Literal xml:lang="EN">If we flip a coin twice, I'm sure I'll win at least once.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleCounting</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Double_counting_(fallacy)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleCounting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleCounting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <Literal xml:lang="FR">Appel au paradoxe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <Literal xml:lang="EN">Paradox</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <Literal xml:lang="FR">Vous utilisez un raisonnement paradoxal pour brouiller les pistes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <Literal xml:lang="EN">Using paradoxical reasoning to muddy the waters.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <Literal xml:lang="FR">Il suffit d’économiser l’eau pour pouvoir la consommer davantage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <Literal xml:lang="EN">Just save water so that we can consume it more in the future.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/List_of_paradoxes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#missingDollarRiddle</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#missingDollarRiddle</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#missingDollarRiddle</IRI>
    <Literal xml:lang="FR">Énigme du dollar manquant</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#missingDollarRiddle</IRI>
    <Literal xml:lang="EN">Missing dollar riddle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#missingDollarRiddle</IRI>
    <Literal xml:lang="FR">Vous créez une confusion en additionnant des montants qui ne devraient pas l’être.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#missingDollarRiddle</IRI>
    <Literal xml:lang="EN">Creating confusion by adding amounts that should not be added together.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#missingDollarRiddle</IRI>
    <Literal xml:lang="FR">Trois amis paient chacun 10 dollars pour un repas qui coûte 25 dollars. Le serveur leur rend 3 dollars et garde 2 dollars. Si l’on additionne les 27 dollars payés et les 2 dollars gardés par le serveur, il semble manquer 1 dollar sur les 30 dollars de départ.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#missingDollarRiddle</IRI>
    <Literal xml:lang="EN">Three friends each pay $10 for a meal totaling $25. The server returns $3, keeping $2 for himself. By adding the $27 given with $2 the server kept, it seems $1 is missing from the original $30.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#missingDollarRiddle</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Missing_dollar_riddle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#missingDollarRiddle</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Énigme_du_dollar_manquant</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#missingDollarRiddle</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#missingDollarRiddle</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoEnveloppes</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoEnveloppes</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoEnveloppes</IRI>
    <Literal xml:lang="FR">Paradoxe des deux enveloppes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoEnveloppes</IRI>
    <Literal xml:lang="EN">Two enveloppes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoEnveloppes</IRI>
    <Literal xml:lang="FR">Vous faites un calcul probabiliste erroné au moment de choisir entre deux options.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoEnveloppes</IRI>
    <Literal xml:lang="EN">You make an erroneous probability calculation when choosing between two options.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoEnveloppes</IRI>
    <Literal xml:lang="FR">Soit le montant est double, soit il est la moitié. Allez-y, vous avez plus à gagner qu’à perdre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoEnveloppes</IRI>
    <Literal xml:lang="EN">The amount is either double or half. Go ahead—you have more to gain than to lose.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoEnveloppes</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Two_envelopes_problem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoEnveloppes</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Paradoxe_des_deux_enveloppes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoEnveloppes</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoEnveloppes</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cellophaneParadox</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cellophaneParadox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cellophaneParadox</IRI>
    <Literal xml:lang="FR">Sophisme du cellophane</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cellophaneParadox</IRI>
    <Literal xml:lang="EN">Cellophane paradox</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cellophaneParadox</IRI>
    <Literal xml:lang="FR">Vous exagérez l’étendue d’un marché pour échapper à une accusation de monopole.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cellophaneParadox</IRI>
    <Literal xml:lang="EN">You exaggerate the scope of a market to evade an accusation of monopoly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cellophaneParadox</IRI>
    <Literal xml:lang="FR">Comment pouvez-vous m’accuser d’abus de position dominante alors que nous ne sommes qu’un poids plume à côté de tous les mastodontes présents à nos côtés sur ce salon ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cellophaneParadox</IRI>
    <Literal xml:lang="EN">How can you accuse us of a monopoly when we are just a small player compared to the giants at this trade show?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cellophaneParadox</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cellophane_paradox</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cellophaneParadox</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cellophaneParadox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#russelsParadox</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#russelsParadox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#russelsParadox</IRI>
    <Literal xml:lang="FR">Paradoxe de Russell</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#russelsParadox</IRI>
    <Literal xml:lang="EN">Russel's paradox</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#russelsParadox</IRI>
    <Literal xml:lang="FR">Vous présentez un ensemble paradoxal qui ne peut ni s’inclure lui-même ni s’exclure de lui-même.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#russelsParadox</IRI>
    <Literal xml:lang="EN">You present a paradoxical set that can neither include itself nor exclude itself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#russelsParadox</IRI>
    <Literal xml:lang="FR">Un barbier, qui ne rase que ceux qui ne se rasent pas eux-mêmes, se rase-t-il lui-même ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#russelsParadox</IRI>
    <Literal xml:lang="EN">A barber shaves only those who do not shave themselves. Does he shave himself?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#russelsParadox</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Russell%27s_paradox</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#russelsParadox</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#russelsParadox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willRogersPhenomenon</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willRogersPhenomenon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willRogersPhenomenon</IRI>
    <Literal xml:lang="FR">Phénomène de Rogers</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willRogersPhenomenon</IRI>
    <Literal xml:lang="EN">Will Rogers Phenomenon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willRogersPhenomenon</IRI>
    <Literal xml:lang="FR">Vous transférez un élément d’un ensemble à un autre de façon à modifier les moyennes de manière trompeuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willRogersPhenomenon</IRI>
    <Literal xml:lang="EN">Shifting an element from one set to another, confusingly changing the average qualities of both sets.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willRogersPhenomenon</IRI>
    <Literal xml:lang="FR">Lorsque les Okies ont quitté l’Oklahoma pour s’installer en Californie, ils ont augmenté le niveau moyen d’intelligence dans les deux États.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willRogersPhenomenon</IRI>
    <Literal xml:lang="EN">When the Okies moved from Oklahoma to California, they managed to raise the average intelligence level in both states.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willRogersPhenomenon</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Will_Rogers_phenomenon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willRogersPhenomenon</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Phénomène_de_Rogers</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willRogersPhenomenon</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willRogersPhenomenon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paradox</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#numericalError</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#numericalError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#numericalError</IRI>
    <Literal xml:lang="FR">Erreur numérique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#numericalError</IRI>
    <Literal xml:lang="EN">Numerical error</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#numericalError</IRI>
    <Literal xml:lang="FR">Vous utilisez des chiffres inexacts ou mal interprétés dans votre argumentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#numericalError</IRI>
    <Literal xml:lang="EN">Using numerical data that are imprecise or misinterpreted to support an argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#numericalError</IRI>
    <Literal xml:lang="FR">Quand vous me dites que mon investissement a progressé de 10 % les deux dernières années, cela veut dire que cela fait 20 % en tout, non ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#numericalError</IRI>
    <Literal xml:lang="EN">When you tell me that my investment has increased by 10% in the last two years, you're implying it's increased 20% in total, right?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#numericalError</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Numerical_error</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#numericalError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#numericalError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCalculation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
    <Literal xml:lang="FR">Opération inappropriée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
    <Literal xml:lang="EN">Wrong reasoning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
    <Literal xml:lang="FR">Vous utilisez un type de raisonnement mathématique qui n’est pas valide dans cette situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
    <Literal xml:lang="EN">Using invalid mathematical reasoning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
    <Literal xml:lang="FR">Dans la fable de La Fontaine, chaque fois que le lièvre avance, la tortue avance aussi ; cela empêcherait donc le lièvre de combler son retard.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
    <Literal xml:lang="EN">In the fable by La Fontaine, each time the hare moves forward, the tortoise moves forward as well, preventing the hare from catching up.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidResult</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
    <Literal xml:lang="FR">Sophisme mathématique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
    <Literal xml:lang="EN">Mathematical fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
    <Literal xml:lang="FR">Vous cachez ou ignorez une erreur dans votre calcul pour appuyer un argument incorrect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
    <Literal xml:lang="EN">You hide or ignore an error in your calculation to support an incorrect argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
    <Literal xml:lang="FR">J’ai divisé toutes les quantités par deux, comme vous me l’avez conseillé, ainsi que le temps de cuisson. Résultat : le gâteau est sorti complètement cru.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
    <Literal xml:lang="EN">I divided all the quantities by two, as you advised me, and the cooking time as well. Result: the cake came out completely raw.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Mathematical_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionByZero</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionByZero</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionByZero</IRI>
    <Literal xml:lang="FR">Division par zéro</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionByZero</IRI>
    <Literal xml:lang="EN">Division by zero</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionByZero</IRI>
    <Literal xml:lang="FR">Vous utilisez un raisonnement qui implique, de manière cachée, une division par zéro.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionByZero</IRI>
    <Literal xml:lang="EN">Using reasoning that involves a hidden division by zero.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionByZero</IRI>
    <Literal xml:lang="FR">En simplifiant les deux membres de cette égalité par leur facteur commun, nous avons donc démontré que 1 = 2.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionByZero</IRI>
    <Literal xml:lang="EN">By simplifying both sides of this equality by their common factor, we have therefore demonstrated that 1 = 2.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionByZero</IRI>
    <Literal xml:lang="EN">http://mathworld.wolfram.com/Fallacy.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionByZero</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divisionByZero</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseProofOfEquality</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseProofOfEquality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseProofOfEquality</IRI>
    <Literal xml:lang="FR">Pseudo démonstration d’égalité entre nombres</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseProofOfEquality</IRI>
    <Literal xml:lang="EN">False proof of equality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseProofOfEquality</IRI>
    <Literal xml:lang="FR">Vous prétendez à tort que deux nombres différents sont égaux en masquant une erreur de calcul.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseProofOfEquality</IRI>
    <Literal xml:lang="EN">Falsely claiming that two different numbers are equal by hiding a calculation error.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseProofOfEquality</IRI>
    <Literal xml:lang="FR">Lors d’un débat, un participant affirme avec assurance que multiplier un nombre par un million revient au même que le diviser par un million, tant que le contexte est « proportionnel ».</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseProofOfEquality</IRI>
    <Literal xml:lang="EN">During a debate, a participant confidently explains that multiplying a number by a million is the same as dividing it by a million, as long as the context is 'proportional'.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseProofOfEquality</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pseudo-démonstration_d%27égalité_entre_nombres</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseProofOfEquality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseProofOfEquality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mathematicalFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misuseOfSymbol</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misuseOfSymbol</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misuseOfSymbol</IRI>
    <Literal xml:lang="FR">Détournement de symbole</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misuseOfSymbol</IRI>
    <Literal xml:lang="EN">Misuse of symbol</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misuseOfSymbol</IRI>
    <Literal xml:lang="FR">Vous utilisez un symbole mathématique dans un sens autre que celui qui est établi pour induire en erreur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misuseOfSymbol</IRI>
    <Literal xml:lang="EN">Using a mathematical symbol in a meaning other than its established one to mislead.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misuseOfSymbol</IRI>
    <Literal xml:lang="FR">Un orateur utilise le symbole ’%’ pour signifier ’pour cent’ dans la plupart de son discours, mais subtilement l’utilise comme un signe de proportion dans un cas clé, induisant en erreur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misuseOfSymbol</IRI>
    <Literal xml:lang="EN">I use the '%' symbol to mean 'percent' throughout most of my speech, but subtly use it as a sign of proportion in one key case, misleading people.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misuseOfSymbol</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misuseOfSymbol</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="FR">Pseudo-science</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="EN">Pseudoscience</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="FR">Vous faites passer des théories non fondées pour des faits scientifiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="EN">Presenting unfounded theories as scientific facts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="FR">Je soutiens que disposer les meubles selon les principes du feng shui améliorera votre santé et vos finances, car cette méthode repose sur d’anciens calculs géométriques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="EN">I argue that arranging furniture according to Feng Shui principles will improve your health and wealth because it's based on ancient geometrical calculations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="EN">http://skepdic.com/pseudosc.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pseudo-science</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudoscience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <Literal xml:lang="FR">Erreur de raisonnement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <Literal xml:lang="EN">Faulty logics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <Literal xml:lang="FR">Votre thèse repose sur un raisonnement incohérent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <Literal xml:lang="EN">Reaching a conclusion through flawed reasoning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <Literal xml:lang="FR"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <Literal xml:lang="EN"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fallacy#Logical_fallacies</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#closeMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#Logical_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <Literal xml:lang="FR">Causalité douteuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <Literal xml:lang="EN">Questionable causality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <Literal xml:lang="FR">Vous supposez un lien de cause à effet qui n’est pas démontré ou qui est incorrect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <Literal xml:lang="EN">Assuming a cause-and-effect relationship that is either unproven or incorrect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <Literal xml:lang="FR">Pas étonnant qu’il obtienne de si bonnes notes à l’école : c’est le chouchou du professeur !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <Literal xml:lang="EN">No wonder he gets such good grades at school: he's the teacher's pet!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <Literal xml:lang="EN">http://www.nizkor.org/features/fallacies/questionable-cause.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="FR">Pétition de principe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="EN">Begging the question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="FR">Vous utilisez un argument qui suppose déjà ce que vous essayez de prouver.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="EN">Attempting to prove a proposition by using an argument that takes the proposition for granted.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="FR">Mieux vaut avoir un chat plutôt qu’un chien, car les chats sont de meilleurs animaux de compagnie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="EN">It is better to have a cat than a dog, because cats make better pets.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Begging_the_question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/P%C3%A9tition_de_principe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="FR">Argument circulaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="EN">Circular reasoning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="FR">Vous raisonnez en cercle : chaque argument repose sur l’acceptation préalable de la conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="EN">Concluding in a circle, each argument relying on acceptance of the conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="FR">L’existence de la Bible prouve celle de Dieu, puisque c’est lui qui l’a dictée aux hommes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="EN">The existence of the Bible proves the existence of God, since it was God who dictated it to humans.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Circular_reasoning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argument_circulaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cartesianCircle</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cartesianCircle</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cartesianCircle</IRI>
    <Literal xml:lang="FR">Cercle cartésien</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cartesianCircle</IRI>
    <Literal xml:lang="EN">Cartesian circle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cartesianCircle</IRI>
    <Literal xml:lang="FR">Vous invoquez une prémisse qui n’a de sens que si la conclusion est déjà acceptée, ce qui renforce la conclusion sans véritable argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cartesianCircle</IRI>
    <Literal xml:lang="EN">Invoking a premise which only makes sense if the conclusion is already accepted, reinforcing the conclusion without genuine argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cartesianCircle</IRI>
    <Literal xml:lang="FR">Les perceptions claires et distinctes ne sont possibles qu’en Dieu, mais prouver que Dieu existe nécessite des perceptions claires et distinctes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cartesianCircle</IRI>
    <Literal xml:lang="EN">Clear and distinct perceptions are only possible through God, but proving God's existence needs those same clear and distinct perceptions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cartesianCircle</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cartesian_circle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cartesianCircle</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cartesianCircle</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trickQuestion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trickQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trickQuestion</IRI>
    <Literal xml:lang="FR">Question piège</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trickQuestion</IRI>
    <Literal xml:lang="EN">Trick question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trickQuestion</IRI>
    <Literal xml:lang="FR">Vous posez une question qui suppose subtilement une prémisse fausse ou controversée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trickQuestion</IRI>
    <Literal xml:lang="EN">Formulating a question that subtly assumes a false or controversial premise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trickQuestion</IRI>
    <Literal xml:lang="FR">Avez-vous arrêté de martyriser votre chien ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trickQuestion</IRI>
    <Literal xml:lang="EN">Have you stopped mistreating your dog?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trickQuestion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Complex_question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trickQuestion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Plurium_interrogationum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trickQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trickQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoratioElenchi</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoratioElenchi</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoratioElenchi</IRI>
    <Literal xml:lang="FR">Conclusion excessive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoratioElenchi</IRI>
    <Literal xml:lang="EN">Ignoratio elenchi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoratioElenchi</IRI>
    <Literal xml:lang="FR">Vous tirez une conclusion qui ne répond pas réellement au sujet traité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoratioElenchi</IRI>
    <Literal xml:lang="EN">Proving something else than the question being discussed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoratioElenchi</IRI>
    <Literal xml:lang="FR">Ce médicament n’a pas reçu l’autorisation de mise sur le marché. Pourtant, il a été prouvé qu’il ne fait pas de mal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoratioElenchi</IRI>
    <Literal xml:lang="EN">This medication has not received marketing authorization. Yet it has been proven to do no harm.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoratioElenchi</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Irrelevant_conclusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoratioElenchi</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Ignoratio_elenchi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoratioElenchi</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoratioElenchi</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionBeggingAnalogy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionBeggingAnalogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionBeggingAnalogy</IRI>
    <Literal xml:lang="FR">Pétition de principe analogique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionBeggingAnalogy</IRI>
    <Literal xml:lang="EN">Question begging analogy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionBeggingAnalogy</IRI>
    <Literal xml:lang="FR">Vous utilisez une analogie qui suppose déjà la conclusion que vous cherchez à démontrer, en assimilant de manière discutable deux situations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionBeggingAnalogy</IRI>
    <Literal xml:lang="EN">Employing an analogy that assumes the conclusion it is meant to demonstrate, dubiously equating two scenarios.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionBeggingAnalogy</IRI>
    <Literal xml:lang="FR">L’accès à Internet est un droit humain, tout comme l’accès à l’eau potable. Tout le monde a besoin d’eau pour vivre, donc tout le monde a besoin d’Internet pour vivre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionBeggingAnalogy</IRI>
    <Literal xml:lang="EN">Internet access is a human right, just like access to clean water. Everyone needs water to survive, so everyone needs internet to live.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionBeggingAnalogy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/qbanalog.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionBeggingAnalogy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionBeggingAnalogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedSupport</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedSupport</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedSupport</IRI>
    <Literal xml:lang="FR">Soutien infondé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedSupport</IRI>
    <Literal xml:lang="EN">Unfounded support</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedSupport</IRI>
    <Literal xml:lang="FR">Vous tentez d’expliquer un phénomène dont l’existence n’est pas prouvée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedSupport</IRI>
    <Literal xml:lang="EN">Trying to explain something whose existence isn't proven.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedSupport</IRI>
    <Literal xml:lang="FR">Si des milliards d’enfants meurent de faim chaque jour, c’est parce que tout le monde s’en fiche : les gens sont trop égoïstes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedSupport</IRI>
    <Literal xml:lang="EN">If billions of children are dying from hunger daily, that's because everyone is too selfish to care.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedSupport</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/172/Subverted-Support</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedSupport</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unfoundedSupport</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="FR">Pente glissante</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="EN">Slippery slope</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="FR">Vous rejetez une proposition en prédisant une séquence peu probable d’événements négatifs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="EN">Rejecting a proposal by predicting an unlikely sequence of negative events.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="FR">Si nous le laissons se resservir de ce plat, il prendra l’habitude de manger à l’excès et deviendra obèse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="EN">If we let him have seconds, he'll get into the habit of overeating and eventually become obese.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <Literal xml:lang="EN">https://www.fallacyfiles.org/slipslop.html#Causal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrowMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slipperySlope_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="FR">Avoir toujours raison</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="EN">Always being right</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="FR">Vous ressentez le besoin de prouver constamment que vos opinions et actions sont correctes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="EN">Feeling the need to constantly prove that one's opinions and actions are correct.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="FR">Je dois gagner cet argument pour montrer que j’ai raison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="EN">I must win this argument to show I'm right.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Always_being_right</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#Avoir_toujours_raison</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <Literal xml:lang="FR">Inversion de causalité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <Literal xml:lang="EN">Reversed causality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <Literal xml:lang="FR">Vous prenez la cause pour la conséquence, ou inversement, ce qui inverse la relation causale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <Literal xml:lang="EN">Confusing the cause with the effect, thus reversing the causal dynamic.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <Literal xml:lang="FR">Il est dangereux d’utiliser un fauteuil roulant, puisque la plupart des personnes qui en utilisent un ont été victimes d’accidents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <Literal xml:lang="EN">Using a wheelchair is dangerous, since most people who use one have been in accidents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Wrong_direction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <Literal xml:lang="FR">http://sophismes.free.fr/#causal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#CauseToEffect_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="FR">Affirmation du conséquent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="EN">Affirming the consequent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="FR">Vous déduisez une cause à partir de son effet, sans tenir compte des autres causes possibles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="EN">Inferring the antecedent from the consequent of an implication without considering alternate causes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="FR">Après une averse, le sol est toujours mouillé. Le sol est mouillé, donc il a plu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="EN">After it rains, the ground is always wet; the ground is wet; therefore, it must have rained.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Affirming_the_consequent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Affirmation_du_cons%C3%A9quent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vanGoghFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vanGoghFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vanGoghFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de Van Gogh</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vanGoghFallacy</IRI>
    <Literal xml:lang="EN">Van Gogh fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vanGoghFallacy</IRI>
    <Literal xml:lang="FR">En faisant une analogie douteuse, vous supposez sans preuve que deux situations similaires auront le même résultat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vanGoghFallacy</IRI>
    <Literal xml:lang="EN">Making a dubious analogy and assuming without proof that two similar situations will have the same result.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vanGoghFallacy</IRI>
    <Literal xml:lang="FR">Tous ces gens célèbres ont arrêté leurs études pour suivre leur passion. Je ne compte pas perdre du temps avec les miennes, j’ai bien mieux à faire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vanGoghFallacy</IRI>
    <Literal xml:lang="EN">Many successful individuals dropped out of school to pursue their passions. I'm also not wasting time on my studies; I've got better things to focus on.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vanGoghFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Van_Gogh_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vanGoghFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vanGoghFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#necessarilySufficient</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#necessarilySufficient</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#necessarilySufficient</IRI>
    <Literal xml:lang="FR">Confusion des conditions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#necessarilySufficient</IRI>
    <Literal xml:lang="EN">Necessarily sufficient</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#necessarilySufficient</IRI>
    <Literal xml:lang="FR">Vous mélangez ce qui est nécessaire pour qu’un événement se produise avec ce qui est suffisant pour l’engendrer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#necessarilySufficient</IRI>
    <Literal xml:lang="EN">Mistaking a necessary condition for a sufficient one.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#necessarilySufficient</IRI>
    <Literal xml:lang="FR">Si vous avez réussi cet examen, cela signifie que vous avez forcément beaucoup étudié, n’est-ce pas ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#necessarilySufficient</IRI>
    <Literal xml:lang="EN">If you passed the exam, it means you must have studied hard, right?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#necessarilySufficient</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Necessity_and_sufficiency</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#necessarilySufficient</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#necessarilySufficient</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiderManFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiderManFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiderManFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de Spider-Man</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiderManFallacy</IRI>
    <Literal xml:lang="EN">Spider-Man fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiderManFallacy</IRI>
    <Literal xml:lang="FR">Vous pensez que parce qu’un élément d’une histoire est vrai, toute l’histoire l’est aussi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiderManFallacy</IRI>
    <Literal xml:lang="EN">extending the veracity of one element of a tale to thewhole of the tale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiderManFallacy</IRI>
    <Literal xml:lang="FR">Les vestiges de Sodome et Gomorrhe ont été retrouvés par des archéologues ! Cela signifie que la Bible est vraie !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiderManFallacy</IRI>
    <Literal xml:lang="EN">Archaeologists have found the remains of Sodom and Gomorrah! This means the Bible is true!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiderManFallacy</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Spider-Man_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#necessarilySufficient</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiderManFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spiderManFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#necessarilySufficient</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCounterinduction</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCounterinduction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCounterinduction</IRI>
    <Literal xml:lang="FR">Contre-induction erronée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCounterinduction</IRI>
    <Literal xml:lang="EN">Erroneous Counterinduction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCounterinduction</IRI>
    <Literal xml:lang="FR">Vous tirez, contre toute logique, une conclusion opposée à ce que les faits suggèrent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCounterinduction</IRI>
    <Literal xml:lang="EN">Assuming the opposite of what induction suggests.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCounterinduction</IRI>
    <Literal xml:lang="FR">Il a plu tous les jours cette semaine, donc je m’attends à ce qu’il fasse grand soleil demain.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCounterinduction</IRI>
    <Literal xml:lang="EN">It has rained every day this week, so I expect tomorrow will be sunny.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCounterinduction</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Counterinduction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCounterinduction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#erroneousCounterinduction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="FR">Deux torts font un droit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="EN">Two wrongs make a right</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="FR">Vous croyez à tort que deux erreurs combinées peuvent produire un résultat juste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="EN">Mistakenly believing that two combined wrongs can produce a just result.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="FR">Le patron ne paie pas ses impôts, alors je ne vais pas me gêner pour me servir dans la caisse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="EN">The boss does not pay his taxes, so I will not hesitate to help myself from the cash register.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Two_wrongs_make_a_right</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Two_wrongs_make_a_right</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="FR">Tu quoque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="EN">Tu quoque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="FR">Pour discréditer une proposition de votre adversaire, vous invoquez des actes qu’il aurait commis et qui seraient incompatibles avec cette proposition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="EN">Claiming that the source making the argument has spoken or acted in a way inconsistent with the argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="FR">Comment pouvez-vous promouvoir les bienfaits de l’exercice physique alors que vous prenez toujours l’ascenseur au lieu de l’escalier ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="EN">How can you promote the benefits of physical exercise when you always take the elevator instead of the stairs?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Tu_quoque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_hominem#Tu_quoque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tuQuoque</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrogressiveCausation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrogressiveCausation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrogressiveCausation</IRI>
    <Literal xml:lang="FR">Causalité régressive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrogressiveCausation</IRI>
    <Literal xml:lang="EN">Retrogressive causation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrogressiveCausation</IRI>
    <Literal xml:lang="FR">Vous prétendez que pour faire cesser un phénomène, il convient de persister dans ce qui l’a provoqué.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrogressiveCausation</IRI>
    <Literal xml:lang="EN">Encouraging the cause of an issue as a way to solve the issue itself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrogressiveCausation</IRI>
    <Literal xml:lang="FR">Pour arrêter de fumer, commencez par fumer encore plus afin d’en être dégoûté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrogressiveCausation</IRI>
    <Literal xml:lang="EN">To quit smoking, start by smoking even more so that you grow disgusted by it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrogressiveCausation</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/156/Retrogressive-Causation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrogressiveCausation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrogressiveCausation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twoWrongsMakeARight</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkToForget</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkToForget</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkToForget</IRI>
    <Literal xml:lang="FR">Boire pour oublier</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkToForget</IRI>
    <Literal xml:lang="EN">Drink to forget</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkToForget</IRI>
    <Literal xml:lang="FR">Vous proposez d’oublier un problème en cherchant à vous en distraire par des moyens nocifs susceptibles de l’aggraver.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkToForget</IRI>
    <Literal xml:lang="EN">Proposing to forget a problem by engaging in harmful distractions that might aggravate it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkToForget</IRI>
    <Literal xml:lang="FR">Jean dit qu’il boit de l’alcool pour oublier ses problèmes professionnels, qui se sont justement aggravés à cause de sa consommation excessive.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkToForget</IRI>
    <Literal xml:lang="EN">John says he drinks to forget his work problems, which have actually worsened because of his excessive drinking.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkToForget</IRI>
    <Literal xml:lang="FR">https://fr.wiktionary.org/wiki/Léthé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrogressiveCausation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkToForget</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkToForget</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrogressiveCausation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="FR">Sophisme du joueur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="EN">Gambler's fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="FR">Vous imaginez une suite d’événements sans tenir compte de leur indépendance aléatoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="EN">Imagining a sequence of events without taking their random independence into account.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="FR">J’ai jeté une pièce dix fois et elle est toujours tombée sur face, donc la prochaine fois elle tombera sur pile.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="EN">I tossed a coin ten times and it always landed on heads, so next time it will land on tails.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Gambler's_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <Literal xml:lang="FR">https://web.archive.org/web/20210506170206/https://www.sceptiques.qc.ca/dictionnaire/gamblers.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gamblersFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#panglossEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#panglossEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#panglossEffect</IRI>
    <Literal xml:lang="FR">Effet Pangloss</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#panglossEffect</IRI>
    <Literal xml:lang="EN">Pangloss effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#panglossEffect</IRI>
    <Literal xml:lang="FR">Vous expliquez après coup un événement fortuit comme s’il avait une cause significative.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#panglossEffect</IRI>
    <Literal xml:lang="EN">A posteriori attributing (often self-serving) causes to a chance event.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#panglossEffect</IRI>
    <Literal xml:lang="FR">100 % des gagnants du loto ont tenté leur chance. Vous devriez en faire autant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#panglossEffect</IRI>
    <Literal xml:lang="EN">100% of lottery winners took a chance. You should too.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#panglossEffect</IRI>
    <Literal xml:lang="EN">https://onemindtherapy.com/social-psychology/defensive-attribution/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#panglossEffect</IRI>
    <Literal xml:lang="FR">https://cortecs.org/materiel/effet-pangloss-ou-les-dangers-des-raisonnements-a-rebours/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#panglossEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#panglossEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversedCausality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <Literal xml:lang="FR">Effet cigogne</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <Literal xml:lang="EN">Stork effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <Literal xml:lang="FR">Vous croyez à tort qu’une corrélation entre deux événements implique nécessairement un lien de causalité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <Literal xml:lang="EN">Asserting a causal relation between two phenomena on grounds of them being correlated.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <Literal xml:lang="FR">Les naissances sont plus nombreuses dans les régions qui comptent le plus de nids de cigognes. Ce sont donc bien elles qui apportent les bébés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <Literal xml:lang="EN">There are more births in regions that have more storks' nests. So it must be the storks that bring the babies.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Correlation_does_not_imply_causation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Cum_hoc_ergo_propter_hoc</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionableCausality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#closeMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#causalReductionism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#causalReductionism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#causalReductionism</IRI>
    <Literal xml:lang="FR">Réductionnisme causal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#causalReductionism</IRI>
    <Literal xml:lang="EN">Causal reductionism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#causalReductionism</IRI>
    <Literal xml:lang="FR">Vous attribuez des causes à un phénomène de façon trop simpliste, en négligeant l’ensemble des facteurs qui ont pu y contribuer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#causalReductionism</IRI>
    <Literal xml:lang="EN">Assuming overly simplistic causes for a phenomenon, neglecting the complexity of factors that might be involved.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#causalReductionism</IRI>
    <Literal xml:lang="FR">Ma voiture, que je conduisais ivre et au téléphone, est sortie de route à cause d’un écureuil.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#causalReductionism</IRI>
    <Literal xml:lang="EN">My car, which I was driving while drunk and on the phone, skidded off the road because of a squirrel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#causalReductionism</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/64/Causal-Reductionism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#causalReductionism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#causalReductionism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
    <Literal xml:lang="FR">Sophisme de la cause unique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
    <Literal xml:lang="EN">Single cause</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
    <Literal xml:lang="FR">Vous attribuez à tort un résultat complexe à une seule et unique cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
    <Literal xml:lang="EN">Wrongly attributing a complex outcome to one singular cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
    <Literal xml:lang="FR">C’est l’introduction du renard qui a entraîné la disparition des lapins.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
    <Literal xml:lang="EN">It's the introduction of foxes that led to the disappearance of the rabbits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fallacy_of_the_single_cause</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme_de_la_cause_unique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#causalReductionism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#causalReductionism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="FR">Négation de l’antécédent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="EN">Denying the antecedent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="FR">Vous rejetez une conclusion simplement parce qu’une cause possible ne s’est pas réalisée, confondant ainsi cause et condition nécessaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="EN">Rejecting a conclusion simply because one possible cause did not occur, thereby confusing a cause with a necessary condition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="FR">S’il pleut, le sol est mouillé. Il n’a pas plu, donc le sol n’est pas mouillé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="EN">If it rains, roads are wet. It hasn't rained, therefore roads are not wet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Denying_the_antecedent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Négation_de_l%27antécédent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="FR">Personnalisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="EN">Personalization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="FR">Vous vous attribuez une responsabilité personnelle, ainsi que l’éloge ou le blâme qui en découle, pour des événements sur lesquels vous avez peu ou pas de contrôle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="EN">Assigning personal responsibility, including resulting praise or blame, for events over which one has little or no control.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="FR">C’est de ma faute si la réunion s’est mal passée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="EN">It's my fault the meeting went poorly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Personalization_and_blaming</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#Personnalisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#singleCause</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCommonCause</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCommonCause</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCommonCause</IRI>
    <Literal xml:lang="FR">Sophisme de la tierce cause</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCommonCause</IRI>
    <Literal xml:lang="EN">Denying the common cause</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCommonCause</IRI>
    <Literal xml:lang="FR">Vous affirmez qu’un événement est la conséquence d’un autre, alors que tous deux sont dus à un troisième facteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCommonCause</IRI>
    <Literal xml:lang="EN">Causally linking two events, forgetting about the possibility of a common cause for them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCommonCause</IRI>
    <Literal xml:lang="FR">Depuis que ma ville a installé davantage de lampadaires, les actes de vandalisme ont augmenté. C’est sûr : l’éclairage supplémentaire pousse les jeunes à commettre davantage de dégradations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCommonCause</IRI>
    <Literal xml:lang="EN">Since my city installed more streetlights, acts of vandalism have increased. Surely, the extra lighting is pushing young people to commit more damage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCommonCause</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Third-cause_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCommonCause</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCommonCause</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocErgoPropterHoc</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocErgoPropterHoc</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocErgoPropterHoc</IRI>
    <Literal xml:lang="FR">Appel à la temporalité comme cause</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocErgoPropterHoc</IRI>
    <Literal xml:lang="EN">Post hoc ergo propter hoc</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocErgoPropterHoc</IRI>
    <Literal xml:lang="FR">Vous supposez qu’un événement est la cause d’un autre uniquement parce qu’il l’a précédé dans le temps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocErgoPropterHoc</IRI>
    <Literal xml:lang="EN">Assuming that one event is the cause of another solely because it preceded it in time.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocErgoPropterHoc</IRI>
    <Literal xml:lang="FR">Le merle chante juste avant le lever du soleil ; le chant du merle fait donc se lever le soleil.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocErgoPropterHoc</IRI>
    <Literal xml:lang="EN">The blackbird sings just before sunrise; hence, the blackbird's singing makes the sun rise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocErgoPropterHoc</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Post_hoc_ergo_propter_hoc</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocErgoPropterHoc</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Post_hoc_ergo_propter_hoc</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocErgoPropterHoc</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#postHocErgoPropterHoc</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#storkEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <Literal xml:lang="FR">Composition fautive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <Literal xml:lang="EN">Spurious composition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <Literal xml:lang="FR">Vous combinez des propositions logiques de façon incorrecte, ce qui conduit à un raisonnement erroné.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <Literal xml:lang="EN">Combining logical propositions incorrectly, leading to flawed reasoning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <Literal xml:lang="FR">Plus il y a de fromage, plus il y a de trous ; or plus il y a de trous, moins il y a de fromage. Donc plus il y a de fromage, moins il y en a.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <Literal xml:lang="EN">The more Swiss cheese you have, the more holes you have; but the more holes you have, the less Swiss cheese you have. Thus, the more Swiss cheese, the less you have.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/glossary.html#Connective</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <Literal xml:lang="FR">Erreur de logique propositionnelle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <Literal xml:lang="EN">Propositional logic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <Literal xml:lang="FR">Vous utilisez incorrectement des propositions logiques élémentaires reliées par « et », « ou » ou « si… alors », ce qui conduit à des conclusions fausses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <Literal xml:lang="EN">Using basic logical propositions connected by 'and', 'or', 'if... then' incorrectly, leading to false conclusions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <Literal xml:lang="FR">Il ne peut pas pleuvoir et neiger en même temps ; donc, s’il ne pleut pas, il neige.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <Literal xml:lang="EN">It can't be both raining and snowing; therefore, if it's not raining, it is snowing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/glossary.html#Connective</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrowMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ModusPonens_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improperTransposition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improperTransposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improperTransposition</IRI>
    <Literal xml:lang="FR">Transposition impropre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improperTransposition</IRI>
    <Literal xml:lang="EN">Improper transposition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improperTransposition</IRI>
    <Literal xml:lang="FR">Vous niez la conséquence d’une déduction logique en en niant une condition suffisante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improperTransposition</IRI>
    <Literal xml:lang="EN">Denying the consequence of a logical deduction by denying a sufficient condition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improperTransposition</IRI>
    <Literal xml:lang="FR">S’il y a du feu, il y a de la fumée. Il n’y a pas de feu donc il n’y a pas de fumée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improperTransposition</IRI>
    <Literal xml:lang="EN">If there is fire, there is smoke. There is no fire, so there is no smoke.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improperTransposition</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/imptrans.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improperTransposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improperTransposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="FR">Négation de l’antécédent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="EN">Denying the antecedent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="FR">Vous concluez qu’une conséquence est fausse simplement parce qu’une de ses conditions suffisantes n’est pas remplie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="EN">Invalidating a conclusion on grounds of the Falsity of a sufficient condition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="FR">S’il pleut, le sol est mouillé. Il n’a pas plu donc le sol n’est pas mouillé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="EN">If it rains, the ground gets wet. It didn't rain, so the ground isn't wet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Denying_the_antecedent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/N%C3%A9gation_de_l%27ant%C3%A9c%C3%A9dent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improperTransposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheAntecedent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improperTransposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commutationOfConditionals</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commutationOfConditionals</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commutationOfConditionals</IRI>
    <Literal xml:lang="FR">Commutation des conditionnelles</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commutationOfConditionals</IRI>
    <Literal xml:lang="EN">Commutation of Conditionals</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commutationOfConditionals</IRI>
    <Literal xml:lang="FR">Vous inversez une implication en traitant sa conclusion comme si elle permettait de retrouver automatiquement son point de départ.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commutationOfConditionals</IRI>
    <Literal xml:lang="EN">Reversing an implication by treating its conclusion as if it automatically led back to its starting point.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commutationOfConditionals</IRI>
    <Literal xml:lang="FR">Si un édifice est une bibliothèque, il contient des livres. Un édifice contient des livres, donc c’est une bibliothèque.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commutationOfConditionals</IRI>
    <Literal xml:lang="EN">If a building is a library, it contains books. This building contains books, therefore it is a library.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commutationOfConditionals</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/commcond.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commutationOfConditionals</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commutationOfConditionals</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="FR">Affirmation du conséquent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="EN">Affirming the consequent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="FR">Vous déduisez une cause de son effet sans prendre en compte les autres causes possibles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="EN">Stating that since the consequent is true, the premisse of an implication is true. That is a confusion of necessary and sufficient conditions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="FR">Après une averse, le sol est toujours mouillé. Le sol est mouillé donc il a plu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="EN">After a rain, the ground is always wet. The ground is wet, therefore it must have rained.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Affirming_the_consequent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Affirmation_du_cons%C3%A9quent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commutationOfConditionals</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingTheConsequent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commutationOfConditionals</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
    <Literal xml:lang="FR">L’un n’empêche pas l’autre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
    <Literal xml:lang="EN">Mistaken exclusivity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
    <Literal xml:lang="FR">Vous traitez à tort deux propositions comme incompatibles, ou vous oubliez qu’elles peuvent être fausses ensemble.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
    <Literal xml:lang="EN">Arguing that certain clauses can't be true or false at the same time due to a mistaken belief in their exclusivity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
    <Literal xml:lang="FR">On ne peut pas être à la fois au travail et en vacances. Vous n’êtes pas au travail, donc vous êtes en vacances.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
    <Literal xml:lang="EN">One cannot be working and on vacation at the same time. You're not at work, so you must be on vacation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#propositionalLogicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingADisjunct</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingADisjunct</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingADisjunct</IRI>
    <Literal xml:lang="FR">Affirmation d’une disjonction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingADisjunct</IRI>
    <Literal xml:lang="EN">Affirming a disjunct</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingADisjunct</IRI>
    <Literal xml:lang="FR">Vous affirmez que deux options sont mutuellement exclusives alors qu’elles pourraient coexister.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingADisjunct</IRI>
    <Literal xml:lang="EN">Claiming that the terms of an "or" statement can't be simultaneously true.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingADisjunct</IRI>
    <Literal xml:lang="FR">Pour réussir dans ce milieu, il faut être très riche ou très beau. Je suis très beau, alors ne me demandez pas d’argent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingADisjunct</IRI>
    <Literal xml:lang="EN">To succeed in this industry, you either have to be very rich or very handsome. I am very handsome, so don't assume I am wealthy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingADisjunct</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/afonedis.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingADisjunct</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Affirmation_d%27une_disjonction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingADisjunct</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affirmingADisjunct</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingAConjunct</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingAConjunct</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingAConjunct</IRI>
    <Literal xml:lang="FR">Déni de conjonction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingAConjunct</IRI>
    <Literal xml:lang="EN">Denying a conjunct</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingAConjunct</IRI>
    <Literal xml:lang="FR">Vous niez une proposition en "et" comme s’il suffisait qu’une seule de ses parties soit fausse, en oubliant que les deux peuvent l’être.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingAConjunct</IRI>
    <Literal xml:lang="EN">To negate 2 assertions linked by "AND," you forget to consider that both can be false.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingAConjunct</IRI>
    <Literal xml:lang="FR">Il ne peut pas pleuvoir et neiger en même temps. Il ne pleut pas donc il neige.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingAConjunct</IRI>
    <Literal xml:lang="EN">It can't be both raining and snowing at the same time. It's not raining, therefore it's snowing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingAConjunct</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/denyconj.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingAConjunct</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingAConjunct</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakenExclusivity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
    <Literal xml:lang="FR">Erreur de quantification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
    <Literal xml:lang="EN">Quantification fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
    <Literal xml:lang="FR">Vous commettez une erreur dans l’emploi de quantificateurs comme « tous », « aucun » ou « quelques », ce qui fausse l’argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
    <Literal xml:lang="EN">Misusing quantifiers such as "all", "none" or "some".</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
    <Literal xml:lang="FR">Tous les philosophes sont sages ; pourtant, certains philosophes sont idiots.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
    <Literal xml:lang="EN">All philosophers are wise, although some of them are idiots.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/quanfall.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
    <Literal xml:lang="FR">Mauvais quantificateur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
    <Literal xml:lang="EN">Wrong quantifier</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
    <Literal xml:lang="FR">Vous confondez l’usage d’un quantificateur universel (« tous », « aucun ») avec celui d’un quantificateur partiel (« certains », « quelques-uns »).</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
    <Literal xml:lang="EN">You confuse the use of a universal quantifier (“all,” “none”) with that of a particular quantifier (“some,” “a few”).</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
    <Literal xml:lang="FR">Vous ne pouvez pas venir de ce pays, car vous êtes petit, alors qu’on y trouve les hommes les plus grands.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
    <Literal xml:lang="EN">You can't be from this country because you are short and it has the tallest people.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByExample</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByExample</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByExample</IRI>
    <Literal xml:lang="FR">Preuve par l’exemple</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByExample</IRI>
    <Literal xml:lang="EN">Proof by example</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByExample</IRI>
    <Literal xml:lang="FR">Votre argument s’appuie sur un exemple ou quelques cas particuliers pour conclure à une règle générale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByExample</IRI>
    <Literal xml:lang="EN">Using one or more examples as "proof" for a more general statement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByExample</IRI>
    <Literal xml:lang="FR">Vos frères et sœurs n’ont pas eu ce genre de problèmes. Je ne vois pas pourquoi ce serait votre cas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByExample</IRI>
    <Literal xml:lang="EN">Your siblings didn't face these issues. I don't see why it would be any different for you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByExample</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Proof_by_example</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByExample</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByExample</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suppressedQuantifier</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suppressedQuantifier</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suppressedQuantifier</IRI>
    <Literal xml:lang="FR">Suppression du quantificateur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suppressedQuantifier</IRI>
    <Literal xml:lang="EN">Suppressed quantifier</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suppressedQuantifier</IRI>
    <Literal xml:lang="FR">Vous omettez de préciser le quantificateur concerné, laissant entendre que l’énoncé peut s’appliquer à tous, à aucun ou seulement à certains.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suppressedQuantifier</IRI>
    <Literal xml:lang="EN">Making statements without specifying the quantifier, leading to interpretations as if it applies to all, none, or only some.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suppressedQuantifier</IRI>
    <Literal xml:lang="FR">Les femmes sont capables d’endurer plus que les hommes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suppressedQuantifier</IRI>
    <Literal xml:lang="EN">Women can endure more than men.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suppressedQuantifier</IRI>
    <Literal xml:lang="EN">http://www.ditext.com/fearnside/41.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suppressedQuantifier</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suppressedQuantifier</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#existentialFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#existentialFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#existentialFallacy</IRI>
    <Literal xml:lang="FR">Sophisme existentiel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#existentialFallacy</IRI>
    <Literal xml:lang="EN">Existential Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#existentialFallacy</IRI>
    <Literal xml:lang="FR">Vous partez du principe qu’il existe des éléments dans l’ensemble sur lequel repose votre argument, sans en apporter la preuve.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#existentialFallacy</IRI>
    <Literal xml:lang="EN">Assuming that elements exist in the set on which an argument is based, without providing proof.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#existentialFallacy</IRI>
    <Literal xml:lang="FR">Tous les terroristes seront poursuivis. Par conséquent, certaines des personnes poursuivies seront des terroristes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#existentialFallacy</IRI>
    <Literal xml:lang="EN">All terrorists will be prosecuted; therefore, some of the people prosecuted will be terrorists.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#existentialFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Existential_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#existentialFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#existentialFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongQuantifier</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <Literal xml:lang="FR">Inférence immédiate erronée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <Literal xml:lang="EN">Faulty immediate inference</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <Literal xml:lang="FR">À partir d’une seule prémisse, vous tirez directement une conclusion incorrecte en lui attribuant des propriétés ou des implications qu’elle ne soutient pas logiquement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <Literal xml:lang="EN">Drawing a conclusion directly from a single premise incorrectly, attributing properties or conclusions that are not logically supported by that premise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <Literal xml:lang="FR">Il est faux que tous les chiens soient blancs ; donc il n’existe aucun chien blanc.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <Literal xml:lang="EN">It's false that all dogs are white, therefore there are no white dogs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Immediate_inference</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitConversion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitConversion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitConversion</IRI>
    <Literal xml:lang="FR">Conversion illicite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitConversion</IRI>
    <Literal xml:lang="EN">Illicit conversion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitConversion</IRI>
    <Literal xml:lang="FR">Votre argument inverse illicitement la relation entre le sujet et le prédicat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitConversion</IRI>
    <Literal xml:lang="EN">Incorrectly reversing the relationship between subject and predicate in an argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitConversion</IRI>
    <Literal xml:lang="FR">Quelques mammifères ne sont pas des chats. Donc quelques chats ne sont pas des mammifères.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitConversion</IRI>
    <Literal xml:lang="EN">Some mammals are not cats; therefore, some cats are not mammals.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitConversion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitConversion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContraposition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContraposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContraposition</IRI>
    <Literal xml:lang="FR">Contraposition illicite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContraposition</IRI>
    <Literal xml:lang="EN">Illicit contraposition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContraposition</IRI>
    <Literal xml:lang="FR">Votre argument inverse la relation entre le sujet et le prédicat, puis y ajoute une négation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContraposition</IRI>
    <Literal xml:lang="EN">Incorrectly reversing the relationship between subject and predicate while negating one of them in an argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContraposition</IRI>
    <Literal xml:lang="FR">Aucun catholique n’est juif. Donc aucun non-juif n’est non-catholique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContraposition</IRI>
    <Literal xml:lang="EN">No Catholic is Jewish; therefore, no non-Jew is non-Catholic.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContraposition</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/108/Illicit-Contraposition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContraposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContraposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitArgumentumEContrario</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitArgumentumEContrario</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitArgumentumEContrario</IRI>
    <Literal xml:lang="FR">Argument a contrario illicite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitArgumentumEContrario</IRI>
    <Literal xml:lang="EN">Illicit argumentum e contrario</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitArgumentumEContrario</IRI>
    <Literal xml:lang="FR">Vous vous appuyez sur la non-vérification des conditions particulières d’une règle pour affirmer que son contraire est juste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitArgumentumEContrario</IRI>
    <Literal xml:lang="EN">Arguing from the non-fulfillment of a rule's specific conditions to affirm the validity of its opposite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitArgumentumEContrario</IRI>
    <Literal xml:lang="FR">Les entreprises doivent obtenir un consentement pour collecter les données personnelles des utilisateurs d’Internet. Elles peuvent donc le faire sans consentement pour les personnes qui n’utilisent pas Internet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitArgumentumEContrario</IRI>
    <Literal xml:lang="EN">Businesses need to obtain consent to collect personal data from internet users. Therefore, they can do so without consent for those not using the internet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitArgumentumEContrario</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argumentum_e_contrario</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitArgumentumEContrario</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/A_contrario</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContraposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitArgumentumEContrario</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitArgumentumEContrario</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContraposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrary</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrary</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrary</IRI>
    <Literal xml:lang="FR">Contraire illicite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrary</IRI>
    <Literal xml:lang="EN">illicit contrary</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrary</IRI>
    <Literal xml:lang="FR">Vous soutenez que, puisqu’il est faux que tous les éléments ont une propriété, alors aucun ne l’a.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrary</IRI>
    <Literal xml:lang="EN">Arguing that, it being not true that all have a property, then no noe has it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrary</IRI>
    <Literal xml:lang="FR">Il est faux que tous les chiens ont des crocs, donc aucun chien n’a de crocs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrary</IRI>
    <Literal xml:lang="EN">It is not true that all dogs have fangs, so no dog has fangs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrary</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Immediate_inference</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrary</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrary</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubcontrary</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubcontrary</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubcontrary</IRI>
    <Literal xml:lang="FR">Sous-contraire illicite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubcontrary</IRI>
    <Literal xml:lang="EN">Illicit subcontrary</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubcontrary</IRI>
    <Literal xml:lang="FR">Vous soutenez que, puisque quelques éléments ont une propriété, aucun ne peut ne pas l’avoir : tous l’ont.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubcontrary</IRI>
    <Literal xml:lang="EN">Arguing that, since some have a property, no one can not have the property. (All have it)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubcontrary</IRI>
    <Literal xml:lang="FR">Certains chats savent nager, donc tous les chats savent nager.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubcontrary</IRI>
    <Literal xml:lang="EN">Some cats can swim, so all cats can swim</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubcontrary</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Immediate_inference</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubcontrary</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubcontrary</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubalternation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubalternation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubalternation</IRI>
    <Literal xml:lang="FR">Subalternation illicite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubalternation</IRI>
    <Literal xml:lang="EN">Illicit subalternation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubalternation</IRI>
    <Literal xml:lang="FR">Vous soutenez que, puisque certains éléments n’ont pas une propriété, alors aucun ne l’a.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubalternation</IRI>
    <Literal xml:lang="EN">Arguing that, since some do not have a property, none has it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubalternation</IRI>
    <Literal xml:lang="FR">Les smartphones ne sont pas tous étanches. Ton smartphone n’est donc pas étanche.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubalternation</IRI>
    <Literal xml:lang="EN">Since not all smartphones are waterproof, your smartphone is not waterproof.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubalternation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Immediate_inference</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubalternation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSubalternation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSuperalternation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSuperalternation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSuperalternation</IRI>
    <Literal xml:lang="FR">Superalternation illicite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSuperalternation</IRI>
    <Literal xml:lang="EN">Illicit superalternation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSuperalternation</IRI>
    <Literal xml:lang="FR">Vous arguez que puisque qu’il est faux que tous ont une propriété, alors il est faux que quelques-uns l’ont.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSuperalternation</IRI>
    <Literal xml:lang="EN">Arguing that since it is false that all have a property, it is false that some have it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSuperalternation</IRI>
    <Literal xml:lang="FR">Comme il est faux que tous les oiseaux peuvent voler, il est faux que certains oiseaux peuvent voler.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSuperalternation</IRI>
    <Literal xml:lang="EN">As it is false that all birds can fly, it is false that some birds can fly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSuperalternation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Immediate_inference</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSuperalternation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitSuperalternation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unwarrantedContrast</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unwarrantedContrast</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unwarrantedContrast</IRI>
    <Literal xml:lang="FR">Contraste injustifié</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unwarrantedContrast</IRI>
    <Literal xml:lang="EN">Unwarranted contrast</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unwarrantedContrast</IRI>
    <Literal xml:lang="FR">Vous supposez à tort qu’en présence de ’certains’, il existe nécessairement des ’autres’ qui ne le sont pas, ce qui n’est pas fondé logiquement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unwarrantedContrast</IRI>
    <Literal xml:lang="EN">Incorrectly assuming that the presence of 'some' necessarily implies the existence of 'others' who are not, which is not logically founded.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unwarrantedContrast</IRI>
    <Literal xml:lang="FR">Certains de nos clients sont insatisfaits de notre service, donc il doit y avoir des clients qui le sont.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unwarrantedContrast</IRI>
    <Literal xml:lang="EN">Some of our clients are dissatisfied with our service; therefore, there must be clients who are satisfied.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unwarrantedContrast</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/179/Unwarranted-Contrast</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unwarrantedContrast</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#unwarrantedContrast</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyImmediateInference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="FR">Glissement du quantificateur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="EN">Quantifier shift</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="FR">Vous modifiez le sens d’une phrase en déplaçant ou en inversant la portée des quantificateurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="EN">Erroneously transposing quantifiers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="FR">Dans chaque ville, il y a un restaurant considéré comme le meilleur de la ville. Il existe donc un restaurant qui est considéré comme le meilleur dans toutes les villes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="EN">In every city, there's a restaurant considered the best in town. Thus, there is a restaurant considered the best in all cities.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Quantifier_shift</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantificationFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <Literal xml:lang="FR">Erreur de modalité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <Literal xml:lang="EN">Modal logic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <Literal xml:lang="FR">Vous confondez ce qui est possible, nécessaire, certain ou obligatoire, et cela fausse votre raisonnement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <Literal xml:lang="EN">Confusing what is possible, necessary, certain or obligatory, thereby distorting the reasoning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <Literal xml:lang="FR">Maman prétend que je ne peux pas manger de bonbons après m’être brossé les dents ; pourtant, j’y parviens sans difficulté !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <Literal xml:lang="EN">Mom says I can't eat candies after I've brushed my teeth; however, I do it anyway without any difficulty.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/modalfal.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Logique_modale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spuriousComposition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Ignorance_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistemicFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistemicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistemicFallacy</IRI>
    <Literal xml:lang="FR">Erreur de modalité épistémique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistemicFallacy</IRI>
    <Literal xml:lang="EN">Epistemic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistemicFallacy</IRI>
    <Literal xml:lang="FR">Vous confondez ce que vous savez avec ce que vous croyez, ce qui nuit à la validité de votre argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistemicFallacy</IRI>
    <Literal xml:lang="EN">Confusing what one knows with what one believes, undermining the validity of one's argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistemicFallacy</IRI>
    <Literal xml:lang="FR">On ne peut pas connaître la vraie nature de l’univers, car cela dépasse l’entendement humain.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistemicFallacy</IRI>
    <Literal xml:lang="EN">One cannot know the true nature of the universe since it goes beyond human comprehension.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistemicFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Epistemic_modal_logic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistemicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistemicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maskedManFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maskedManFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maskedManFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de l’homme masqué</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maskedManFallacy</IRI>
    <Literal xml:lang="EN">Masked Man Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maskedManFallacy</IRI>
    <Literal xml:lang="FR">Vous supposez à tort que des connaissances différentes sur des objets correspondent à des propriétés différentes de ces objets.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maskedManFallacy</IRI>
    <Literal xml:lang="EN">Mistakenly assuming that different knowledge about objects corresponds to different properties of those objects.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maskedManFallacy</IRI>
    <Literal xml:lang="FR">Lois Lane pense que Superman peut voler. Lois Lane pense que Clark Kent ne peut pas voler. Par conséquent, Superman et Clark Kent ne sont pas la même personne.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maskedManFallacy</IRI>
    <Literal xml:lang="EN">Lois Lane thinks Superman can fly. Lois Lane thinks Clark Kent cannot fly. Therefore Superman and Clark Kent are not the same person.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maskedManFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Masked-man_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistemicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maskedManFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maskedManFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistemicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alethicModalFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alethicModalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alethicModalFallacy</IRI>
    <Literal xml:lang="FR">Erreur de modalité aléthique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alethicModalFallacy</IRI>
    <Literal xml:lang="EN">Alethic modal fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alethicModalFallacy</IRI>
    <Literal xml:lang="FR">Vous confondez ce qui est nécessairement faux avec ce qui pourrait simplement être improbable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alethicModalFallacy</IRI>
    <Literal xml:lang="EN">Confusing what is necessarily false with what might merely be improbable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alethicModalFallacy</IRI>
    <Literal xml:lang="FR">Le Président ne peut pas ne pas avoir eu une formation politique approfondie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alethicModalFallacy</IRI>
    <Literal xml:lang="EN">The President can't not have had an extensive political training.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alethicModalFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Alethic_modality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alethicModalFallacy</IRI>
    <Literal xml:lang="FR">https://www.etudes-litteraires.com/figures-de-style/alethique.php</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alethicModalFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alethicModalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalFallacy</IRI>
    <Literal xml:lang="FR">Erreur de modalité temporale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalFallacy</IRI>
    <Literal xml:lang="EN">Temporal fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalFallacy</IRI>
    <Literal xml:lang="FR">Vous utilisez des arguments qui ne prennent pas correctement en compte la dimension temporelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalFallacy</IRI>
    <Literal xml:lang="EN">Using arguments that do not properly take the temporal dimension into account.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalFallacy</IRI>
    <Literal xml:lang="FR">Puisque le train est parti en retard, il est inévitable qu’on arrive en retard.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalFallacy</IRI>
    <Literal xml:lang="EN">Since the train left late, it is inevitable that we will arrive late.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
    <Literal xml:lang="FR">Erreur de modalité déontique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
    <Literal xml:lang="EN">Deontic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
    <Literal xml:lang="FR">Vous ne distinguez pas correctement ce qui est nécessaire, obligatoire, interdit, possible ou autorisé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
    <Literal xml:lang="EN">You do not correctly distinguish between what is necessary, obligatory, forbidden, possible, or permitted.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
    <Literal xml:lang="FR">Si vous êtes capable de faire cent pompes, alors vous devez les faire chaque matin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
    <Literal xml:lang="EN">If you're capable of doing a hundred push-ups, then you're obligated to do them every morning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Deontic_logic
</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Logique_d%C3%A9ontique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="FR">Fausses obligations</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="EN">Should/shouldn't and must/mustn't statements</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="FR">Vous utilisez des énoncés impératifs comme « je dois » ou « il ne faut pas », en imposant des attentes irréalistes à vous-même ou aux autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="EN">Using mandatory imperative statements like 'must' or 'should' which impose unrealistic expectations on oneself or others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="FR">Je devrais toujours être capable de contrôler mes émotions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="EN">I should always be able to control my emotions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Should/shouldn't_and_must/mustn't_statements</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#Fausses_obligations</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deonticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de portée modale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="EN">Modal scope fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="FR">Votre argument altère le sens logique en jouant sur la portée des termes modaux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="EN">Your argument alters the logical meaning by manipulating the scope of modal terms.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="FR">Si vous savez quelque chose, vous ne pouvez pas vous tromper. Mais si vous ne pouvez pas vous tromper, alors vous en êtes certain. La certitude est donc une condition nécessaire de la connaissance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="EN">If you know something, you cannot be wrong. If you can't be wrong, then you are certain. Thus, certainty is a necessary condition of knowledge.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/modlscop.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalLogicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
    <Literal xml:lang="FR">Déduction invalide</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
    <Literal xml:lang="EN">Wrong entailment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
    <Literal xml:lang="FR">Vous tirez des conclusions qui ne découlent pas logiquement de vos prémisses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
    <Literal xml:lang="EN">Drawing conclusions that do not logically follow from the starting assumptions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
    <Literal xml:lang="FR">Si l’on ne trouve pas de solution, c’est qu’il n’y a pas de problème.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
    <Literal xml:lang="EN">If no solution is found, it must be because there is no problem.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyLogics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="FR">Conclusion hâtive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="EN">Hasty conclusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="FR">Vous tirez des conclusions trop vite, sans disposer de suffisamment de preuves.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="EN">Drawing logical consequences from facts which are insufficient to support such an entailment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="FR">Ce bol est rempli de croquettes ; il y a donc un chat dans la maison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="EN">This bowl is filled with cat food; therefore, there is a cat in the house.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Jumping_to_conclusions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#OppositeConsequences_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <Literal xml:lang="FR">Prémisses non pertinentes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <Literal xml:lang="EN">Irrelevant premises</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <Literal xml:lang="FR">Vous vous appuyez sur des prémisses qui ne soutiennent pas réellement votre conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <Literal xml:lang="EN">Relying on premises that don't logically support the conclusion being made.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <Literal xml:lang="FR">Il a été le meilleur vendeur du mois ; il ferait donc clairement un excellent responsable d’équipe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <Literal xml:lang="EN">He was the best salesperson of the month; clearly, he would make an excellent team leader.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <Literal xml:lang="EN">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="FR">Sophisme génétique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="EN">Genetic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="FR">Vous rejetez une idée en critiquant son origine plutôt que son contenu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="EN">Rejecting an idea by criticizing its origin rather than its content.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="FR">Je ne vais tout de même pas suivre les conseils d’un Américain pour choisir mon vin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="EN">I'm not going to take advice on selecting wine from an American.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="EN">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme_g%C3%A9n%C3%A9tique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#geneticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="FR">Rationalisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="EN">Rationalization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="FR">Vous présentez des justifications peu sincères pour rendre une affirmation acceptable, sans discuter du fond.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="EN">Offering insincere justifications to make a claim acceptable, without addressing its substance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="FR">Si je n’ai pas réussi l’examen, c’est juste parce que le professeur me déteste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="EN">If I didn't pass the exam, it's just because the teacher hates me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/149/Rationalization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="FR">Hypothèse farfelue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="EN">Far-fetched hypothesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="FR">Vous privilégiez des explications invraisemblables sans avoir écarté les hypothèses plus probables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="EN">Proposing an unlikely explanation without considering more plausible ones.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="FR">Cette erreur a gâché ma présentation. Je suis sûr que vous l’avez faite exprès pour la saboter !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="EN">This glitch ruined my presentation. I'm sure you did it on purpose to sabotage me!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/96/Far-Fetched-Hypothesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="FR">Familiarité étonnante</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="EN">Amazing familiarity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="FR">Votre argument contient des informations qui semblent impossibles à obtenir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="EN">Including information in an argument that appears to be unobtainable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="FR">Je connais bien cet homme. Il n’a jamais trompé personne.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="EN">I know this man well. He has never cheated anyone.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#familiarity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingTheWrongConclusion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingTheWrongConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingTheWrongConclusion</IRI>
    <Literal xml:lang="FR">Tirer une mauvaise conclusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingTheWrongConclusion</IRI>
    <Literal xml:lang="EN">Drawing the wrong conclusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingTheWrongConclusion</IRI>
    <Literal xml:lang="FR">Vous interprétez incorrectement les prémisses pour arriver à une conclusion erronée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingTheWrongConclusion</IRI>
    <Literal xml:lang="EN">Misinterpreting the premises in order to arrive at an erroneous conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingTheWrongConclusion</IRI>
    <Literal xml:lang="FR">Puisque je crois au caractère sacré du mariage, je pense qu’il devrait unir un homme et une femme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingTheWrongConclusion</IRI>
    <Literal xml:lang="EN">Since I believe in the sanctity of marriage, I think it should be between a man and a woman.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingTheWrongConclusion</IRI>
    <Literal xml:lang="EN">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingTheWrongConclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drawingTheWrongConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingTheWrongReasons</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingTheWrongReasons</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingTheWrongReasons</IRI>
    <Literal xml:lang="FR">Donner de mauvaises raisons</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingTheWrongReasons</IRI>
    <Literal xml:lang="EN">Using the wrong reasons</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingTheWrongReasons</IRI>
    <Literal xml:lang="FR">Vous défendez une thèse en utilisant des arguments qui prouvent en réalité un point différent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingTheWrongReasons</IRI>
    <Literal xml:lang="EN">Defending a thesis using arguments that actually prove a different point.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingTheWrongReasons</IRI>
    <Literal xml:lang="FR">Le tabac est cher et addictif. Il est donc normal d’interdire son usage dans les lieux publics.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingTheWrongReasons</IRI>
    <Literal xml:lang="EN">Tobacco is expensive and addictive, so it makes sense to ban its use in public places.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingTheWrongReasons</IRI>
    <Literal xml:lang="EN">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingTheWrongReasons</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingTheWrongReasons</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irrelevantPremises</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="FR">Analyse défaillante</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="EN">Substituting Explanation for Premise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="FR">Vous considérez qu’un phénomène n’existe pas simplement parce que l’explication théorique proposée est incorrecte ou insuffisante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="EN">Concluding that a phenomenon does not exist merely because the theoretical explanation offered is incorrect or inadequate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="FR">Ils disent que le changement climatique est causé par les activités humaines, mais leur modèle prédictif comporte des failles. Donc, le changement climatique ne doit pas être réel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="EN">They claim climate change is caused by human activities, but their predictive model has flaws. Therefore, climate change must not be real.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Substituting_explanation_for_premise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingTheWrongReasons</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#usingTheWrongReasons</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="FR">Fausse équivalence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="EN">False equivalence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="FR">Vous établissez un parallèle injustifié entre deux arguments ou deux situations qui ne sont pas comparables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="EN">Making two arguments or pieces of evidence appear to be logically equivalent when in fact they are not.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="FR">Vous me demandez de faire mes devoirs après l’école ; mais moi, je ne vous demande pas de faire des heures supplémentaires quand vous rentrez du bureau.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="EN">You ask me to do my homework after school, but I don't ask you to work overtime when you come home from the office.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/False_equivalence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="FR">Équivalence morale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="EN">Moral equivalence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="FR">Vous supposez à tort que deux actions différentes ont la même valeur morale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="EN">Wrongly assuming that two different actions have the same moral value.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="FR">Certains arguent que la vitesse des véhicules devrait être limitée pour la sécurité, mais s’opposer aux voyages spatiaux car ils sont risqués serait ridicule.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="EN">Some argue that vehicle speeds should be limited for safety, but opposing space travel because it is risky would be ridiculous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Moral_equivalence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralEquivalence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="FR">Acte de foi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="EN">Leap of faith</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="FR">Vous demandez d’accepter une affirmation sans raison ni explication logique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="EN">Asking for a claim to be accepted without any reason or logical explanation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="FR">Vous pouvez me croire quand je vous dis que notre produit est supérieur à tous les autres sur le marché.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="EN">You can believe me when I say that our product is superior to all others on the market.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Leap_of_faith</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Acte_de_foi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="FR">Substitut de preuve</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="EN">Proof Surrogate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="FR">Vous prétendez fournir une preuve, sans jamais la présenter concrètement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="EN">Claiming to provide proof or evidence when in reality, no proof or evidence is actually presented.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="FR">Tout le monde sait que cette politique est inefficace. Les experts en parlent tout le temps à la télévision.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="EN">Everyone knows that this policy is ineffective. Experts talk about it all the time on television.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/logicalfallacies/Proof-Surrogate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="FR">Gish gallop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="EN">Gish gallop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="FR">Vous submergez votre interlocuteur par un flot rapide et continu d’arguments et d’affirmations, ce qui rend difficile une réfutation complète et réfléchie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="EN">Overwhelming an opponent with a rapid, continuous flow of arguments and claims, making a thorough and thoughtful refutation difficult.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="FR">Comment pouvez-vous être compétent si vous ne répondez même pas à mes arguments sur la fiscalité, l’éducation, la santé et l’environnement ? Et je n’ai même pas encore abordé la politique étrangère !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="EN">How can you be competent if you don't even respond to my points on taxation, education, health care, and the environment? And I haven't even started on foreign policy yet!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Gish_Gallop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gish_gallop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beamSearch</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beamSearch</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beamSearch</IRI>
    <Literal xml:lang="FR">Sophisme du faisceau d’indices</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beamSearch</IRI>
    <Literal xml:lang="EN">Beam search</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beamSearch</IRI>
    <Literal xml:lang="FR">Vous accumulez plusieurs arguments faibles en espérant qu’ils forment ensemble un argument solide.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beamSearch</IRI>
    <Literal xml:lang="EN">Stacking several weak arguments in the hope of forming a strong argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beamSearch</IRI>
    <Literal xml:lang="FR">Cet homme politique ne doit pas être honnête : il ne sourit pas sur les photos, mon voisin ne l’aime pas, et il fait souvent des fautes de prononciation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beamSearch</IRI>
    <Literal xml:lang="EN">This politician can't be honest; he doesn't smile in photos, my neighbor doesn't like him, and he often misspeaks.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beamSearch</IRI>
    <Literal xml:lang="FR">https://cortecs.org/wp-content/uploads/2010/11/CorteX_Monvoisin_these_didactique_esprit_critique.pdf#page=244</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beamSearch</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beamSearch</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindReading</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindReading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindReading</IRI>
    <Literal xml:lang="FR">Lecture mentale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindReading</IRI>
    <Literal xml:lang="EN">Mind reading</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindReading</IRI>
    <Literal xml:lang="FR">Vous supposez savoir ce que pensent les autres en vous fondant sur leur comportement ou leurs signaux non verbaux, sans preuve concrète.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindReading</IRI>
    <Literal xml:lang="EN">Assuming one knows what others think based on their behavior and nonverbal communication, without concrete evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindReading</IRI>
    <Literal xml:lang="FR">Je suis sûr que mon chef pense que je suis incompétent, vu la façon dont il me regarde.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindReading</IRI>
    <Literal xml:lang="EN">I'm sure my boss thinks I'm incompetent the way he looks at me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindReading</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Mind_reading</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindReading</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#Tirer_des_conclusions_h%C3%A2tives</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindReading</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindReading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fortunetelling</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fortunetelling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fortunetelling</IRI>
    <Literal xml:lang="FR">Prédiction arbitraire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fortunetelling</IRI>
    <Literal xml:lang="EN">Fortune-telling</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fortunetelling</IRI>
    <Literal xml:lang="FR">Vous prédisez une issue négative sans preuve suffisante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fortunetelling</IRI>
    <Literal xml:lang="EN">Predicting negative outcomes without any solid evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fortunetelling</IRI>
    <Literal xml:lang="FR">Je vais certainement échouer à cet entretien ; je le sens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fortunetelling</IRI>
    <Literal xml:lang="EN">I am definitely going to fail this interview, I have a feeling.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fortunetelling</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Fortune-telling</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fortunetelling</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#Tirer_des_conclusions_h%C3%A2tives</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fortunetelling</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fortunetelling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mislabeling</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mislabeling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mislabeling</IRI>
    <Literal xml:lang="FR">Mauvais étiquetage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mislabeling</IRI>
    <Literal xml:lang="EN">Mislabeling</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mislabeling</IRI>
    <Literal xml:lang="FR">Vous attribuez une étiquette négative à vous-même ou à quelqu’un d’autre à partir d’une seule erreur ou d’un événement isolé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mislabeling</IRI>
    <Literal xml:lang="EN">Assigning a negative label to oneself or others based on a mistake or isolated event.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mislabeling</IRI>
    <Literal xml:lang="FR">Je suis un perdant parce que j’ai raté cette occasion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mislabeling</IRI>
    <Literal xml:lang="EN">I'm a loser because I failed at this one task.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mislabeling</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Labeling</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mislabeling</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mislabeling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <Literal xml:lang="FR">Inconsistance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <Literal xml:lang="EN">Inconsistency</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <Literal xml:lang="FR">Votre raisonnement repose sur des affirmations qui se contredisent entre elles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <Literal xml:lang="EN">Using mutually exclusive assertions or premises.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <Literal xml:lang="FR">Ce n’est pas moi qui ai abîmé ce cahier ; non seulement j’en ai pris le plus grand soin, mais en plus je n’y ai jamais touché.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <Literal xml:lang="EN">I didn't damage this notebook; not only did I take the greatest care of it, but I never even touched it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/112/Inconsistency</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompatiblePremises</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompatiblePremises</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompatiblePremises</IRI>
    <Literal xml:lang="FR">Prémisses incompatibles</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompatiblePremises</IRI>
    <Literal xml:lang="EN">Incompatible premises</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompatiblePremises</IRI>
    <Literal xml:lang="FR">Vous construisez un raisonnement sur des bases qui ne peuvent pas coexister.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompatiblePremises</IRI>
    <Literal xml:lang="EN">Drawing a conclusion from incompatible premises.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompatiblePremises</IRI>
    <Literal xml:lang="FR">Je vous ai demandé de ne faire confiance à personne. Vous me faites confiance ? Alors pourquoi ne m’avez-vous pas écouté ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompatiblePremises</IRI>
    <Literal xml:lang="EN">I asked you to trust no one. Do you trust me? Then why didn't you listen to me?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompatiblePremises</IRI>
    <Literal xml:lang="EN">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompatiblePremises</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompatiblePremises</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfrefutingIdea</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfrefutingIdea</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfrefutingIdea</IRI>
    <Literal xml:lang="FR">Concept volé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfrefutingIdea</IRI>
    <Literal xml:lang="EN">Self-refuting idea</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfrefutingIdea</IRI>
    <Literal xml:lang="FR">Vous niez un concept tout en continuant à l’utiliser dans votre raisonnement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfrefutingIdea</IRI>
    <Literal xml:lang="EN">Denying a concept while continuing to use it in the reasoning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfrefutingIdea</IRI>
    <Literal xml:lang="FR">La raison et la logique ne sont pas toujours fiables ; il ne faut donc pas compter sur elles pour établir la vérité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfrefutingIdea</IRI>
    <Literal xml:lang="EN">Reason and logic are not always reliable, so we shouldn't rely on them to establish the truth.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfrefutingIdea</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Self-refuting_idea</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfrefutingIdea</IRI>
    <Literal xml:lang="FR">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/168/Stolen-Concept-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompatiblePremises</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfrefutingIdea</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfrefutingIdea</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompatiblePremises</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
    <Literal xml:lang="FR">Contradiction interne</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
    <Literal xml:lang="EN">Internal contradiction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
    <Literal xml:lang="FR">Votre argumentation comporte des éléments qui se contredisent entre eux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
    <Literal xml:lang="EN">Including elements within an argument that contradict one another.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
    <Literal xml:lang="FR">Nous devons toujours défendre la liberté d’expression, mais certaines opinions ne devraient jamais être exprimées publiquement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
    <Literal xml:lang="EN">We must always defend free speech, yet some opinions should never be expressed publicly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#contradiction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kettleLogic</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kettleLogic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kettleLogic</IRI>
    <Literal xml:lang="FR">Logique du chaudron</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kettleLogic</IRI>
    <Literal xml:lang="EN">Kettle logic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kettleLogic</IRI>
    <Literal xml:lang="FR">Vous multipliez les justifications qui semblent valables seules, mais qui, prises ensemble, se contredisent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kettleLogic</IRI>
    <Literal xml:lang="EN">Cumulating several valid arguments that unfortunately contradict each other.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kettleLogic</IRI>
    <Literal xml:lang="FR">Premièrement, je n’ai absolument pas emprunté de chaudron ; deuxièmement, le chaudron avait déjà un trou lorsque je l’ai reçu ; troisièmement, je lui ai rendu le chaudron intact.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kettleLogic</IRI>
    <Literal xml:lang="EN">First, I did not borrow the pot; second, it already had a hole in it when I got it; third, I returned the pot in perfect condition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kettleLogic</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Kettle_logic
</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kettleLogic</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Logique_du_chaudron</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kettleLogic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kettleLogic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentTriad</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentTriad</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentTriad</IRI>
    <Literal xml:lang="FR">Triade inconsistante</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentTriad</IRI>
    <Literal xml:lang="EN">Inconsistent triad</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentTriad</IRI>
    <Literal xml:lang="FR">Vous vous basez sur trois prémisses parmi lesquelles seules deux peuvent être vraies en même temps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentTriad</IRI>
    <Literal xml:lang="EN">Using three assertions from which only two can be simultaneously true.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentTriad</IRI>
    <Literal xml:lang="FR">Alice est toujours honnête et dit toujours la vérité. Alice a affirmé que, si elle était élue présidente, elle n’augmenterait pas son salaire. Pourtant, Alice a augmenté son propre salaire après son élection.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentTriad</IRI>
    <Literal xml:lang="EN">Alice is always honest and always tells the truth. Alice claimed that if she were elected president, she wouldn't raise her salary. However, Alice gave herself a raise after being elected.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentTriad</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Inconsistent_triad</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentTriad</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentTriad</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#internalContradiction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conclusionContradictingAPremise</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conclusionContradictingAPremise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conclusionContradictingAPremise</IRI>
    <Literal xml:lang="FR">Contradiction entre prémisse et conclusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conclusionContradictingAPremise</IRI>
    <Literal xml:lang="EN">conclusion contradicting a premise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conclusionContradictingAPremise</IRI>
    <Literal xml:lang="FR">Vous démontrez une conclusion incompatible avec au moins une de vos hypothèses de départ.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conclusionContradictingAPremise</IRI>
    <Literal xml:lang="EN">Drawing a conclusion that is incompatible with at least one of the premises.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conclusionContradictingAPremise</IRI>
    <Literal xml:lang="FR">Comme tout a une cause et qu’on ne peut remonter indéfiniment dans le temps, il est nécessaire que Dieu existe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conclusionContradictingAPremise</IRI>
    <Literal xml:lang="EN">Since everything has a cause and we can't infinitely trace back in time, God must necessarily exist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conclusionContradictingAPremise</IRI>
    <Literal xml:lang="EN">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conclusionContradictingAPremise</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conclusionContradictingAPremise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <Literal xml:lang="FR">Syllogisme invalide</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <Literal xml:lang="EN">Syllogistic Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <Literal xml:lang="FR">Vous construisez de façon incorrecte un raisonnement logique en trois parties : prémisse majeure, prémisse mineure et conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <Literal xml:lang="EN">Using a syllogism, or 3-step (major premise - minor premise - conclusion) argument in a faulty way.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <Literal xml:lang="FR">Les poissons vivent dans la mer ; or les baleines vivent dans la mer ; les baleines sont donc des poissons.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <Literal xml:lang="EN">Fish live in the sea. Whales live in the sea. Therefore, whales are fish.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/syllfall.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Syllogisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wrongEntailment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
    <Literal xml:lang="FR">Distribution incorrecte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
    <Literal xml:lang="EN">Illicit Distribution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
    <Literal xml:lang="FR">Dans votre syllogisme, l’un des termes n’est pas distribué correctement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
    <Literal xml:lang="EN">Using a syllogism in which one term is wrongly distributed or undistributed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
    <Literal xml:lang="FR">Si tous ceux qui connaissent Julie l’apprécient, et que Paul l’apprécie, alors Paul doit certainement la connaître.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
    <Literal xml:lang="EN">If everyone who knows Julie likes her, and Paul likes her too, then surely, Paul must know her.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undistributedMiddle</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undistributedMiddle</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undistributedMiddle</IRI>
    <Literal xml:lang="FR">Milieu non distribué</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undistributedMiddle</IRI>
    <Literal xml:lang="EN">Undistributed middle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undistributedMiddle</IRI>
    <Literal xml:lang="FR">Vous n’utilisez pas le terme central de votre raisonnement de façon à relier correctement les deux propositions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undistributedMiddle</IRI>
    <Literal xml:lang="EN">Neither of the premises accounts for all members of the middle term, which consequently fails to link the major and minor term.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undistributedMiddle</IRI>
    <Literal xml:lang="FR">Tous les étudiants portent un sac à dos. Mon grand-père porte un sac à dos. Donc mon grand-père est un étudiant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undistributedMiddle</IRI>
    <Literal xml:lang="EN">All students carry a backpack. My grandfather carries a backpack. Therefore, my grandfather must be a student.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undistributedMiddle</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fallacy_of_the_undistributed_middle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undistributedMiddle</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undistributedMiddle</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="FR">Syllogisme du politicien</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="EN">Politician's syllogism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="FR">Votre argument affirme qu’une action est souhaitable simplement parce qu’elle constitue un changement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="EN">Your argument claims that an action is desirable simply because it constitutes a change.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="FR">Pour qu’elle s’améliore, la situation doit changer. Nous changeons la situation, donc nous améliorons la situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="EN">For the situation to improve, it must change. We are changing the situation, so we are improving the situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Politician%27s_syllogism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undistributedMiddle</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undistributedMiddle</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
    <Literal xml:lang="FR">Distribution illicite d’une conclusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
    <Literal xml:lang="EN">Illicit process</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
    <Literal xml:lang="FR">La conclusion de votre syllogisme distribue un terme qui n’est pas distribué dans une prémisse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
    <Literal xml:lang="EN">Making a categorical syllogism in which a term that is undistributed in a premise is distributed in the conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
    <Literal xml:lang="FR">Tous les chats sont des félins. Tous les félins sont des mammifères. Donc tous les mammifères sont des félins.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
    <Literal xml:lang="EN">All cats are felines. All felines are mammals. Therefore, all mammals are felines.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/illicitp.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
    <Literal xml:lang="FR">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitDistribution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMajor</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMajor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMajor</IRI>
    <Literal xml:lang="FR">Distribution incorrecte du terme majeur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMajor</IRI>
    <Literal xml:lang="EN">Illicit major</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMajor</IRI>
    <Literal xml:lang="FR">La conclusion de votre syllogisme distribue le terme majeur alors qu’il n’est pas distribué dans sa prémisse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMajor</IRI>
    <Literal xml:lang="EN">Making a categorical syllogism in which the major term is undistributed in its premiss but is distributed in the conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMajor</IRI>
    <Literal xml:lang="FR">Tous les chiens sont des animaux. Aucun chat n’est un chien. Donc aucun chat n’est un animal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMajor</IRI>
    <Literal xml:lang="EN">All dogs are animals. No cat is a dog. Therefore, no cat is an animal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMajor</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Illicit_major</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMajor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMajor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMinor</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMinor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMinor</IRI>
    <Literal xml:lang="FR">Distribution incorrecte du terme mineur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMinor</IRI>
    <Literal xml:lang="EN">Illicit minor</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMinor</IRI>
    <Literal xml:lang="FR">La conclusion de votre syllogisme distribue le terme mineur alors qu’il n’est pas distribué dans sa prémisse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMinor</IRI>
    <Literal xml:lang="EN">Making a categorical syllogism in which the minor term is undistributed in its premiss but is distributed in the conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMinor</IRI>
    <Literal xml:lang="FR">Toutes les baleines sont des animaux. Tous les mammifères sont des animaux. Donc tous les animaux sont des mammifères.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMinor</IRI>
    <Literal xml:lang="EN">All whales are animals. All mammals are animals. Therefore, all animals are mammals.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMinor</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Illicit_minor</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMinor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitMinor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitProcess</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
    <Literal xml:lang="FR">Négation incorrecte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
    <Literal xml:lang="EN">Illicit Negation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
    <Literal xml:lang="FR">Votre argument comporte une utilisation incorrecte de la négation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
    <Literal xml:lang="EN">Making a categorical syllogism that wrongly uses at least one negative statement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
    <Literal xml:lang="FR">Aucun animal à plume n’est un mammifère. Aucun mammifère n’est un oiseau. Donc aucun oiseau n’a de plumes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
    <Literal xml:lang="EN">No feathered animal is a mammal. No mammal is a bird. Therefore, no bird has feathers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitAffirmative</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitAffirmative</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitAffirmative</IRI>
    <Literal xml:lang="FR">Conclusion affirmative à partir d’une prémisse négative</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitAffirmative</IRI>
    <Literal xml:lang="EN">Illicit Affirmative</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitAffirmative</IRI>
    <Literal xml:lang="FR">Vous ne pouvez pas obtenir une conclusion affirmative si l’une de vos prémisses est négative.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitAffirmative</IRI>
    <Literal xml:lang="EN">Making a categorical syllogism that has a positive conclusion and at least one negative premise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitAffirmative</IRI>
    <Literal xml:lang="FR">Aucun reptile n’a de poils, et aucun mammifère n’est un reptile, donc tous les mammifères ont des poils.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitAffirmative</IRI>
    <Literal xml:lang="EN">No reptiles have fur, and no mammals are reptiles, therefore all mammals have fur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitAffirmative</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Affirmative_conclusion_from_a_negative_premise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitAffirmative</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitAffirmative</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegative</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegative</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegative</IRI>
    <Literal xml:lang="FR">Conclusion négative à partir de prémisses affirmatives</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegative</IRI>
    <Literal xml:lang="EN">Illicit Negative</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegative</IRI>
    <Literal xml:lang="FR">Vous ne pouvez pas conclure négativement si vos deux prémisses sont affirmatives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegative</IRI>
    <Literal xml:lang="EN">Making a categorical syllogism that draws a negative conclusion from two positive premises.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegative</IRI>
    <Literal xml:lang="FR">Toutes les personnes sont des hommes. Tous les hommes sont des citoyens. Donc certains citoyens ne sont pas des personnes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegative</IRI>
    <Literal xml:lang="EN">All people are human. All humans are citizens. So, some citizens are not people.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegative</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Negative_conclusion_from_affirmative_premises</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegative</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegative</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivePremises</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivePremises</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivePremises</IRI>
    <Literal xml:lang="FR">Prémisses exclusives</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivePremises</IRI>
    <Literal xml:lang="EN">Exclusive premises</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivePremises</IRI>
    <Literal xml:lang="FR">Votre syllogisme est basé sur deux prémisses négatives et ne peut mener à aucune conclusion valable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivePremises</IRI>
    <Literal xml:lang="EN">Drawing a syllogical conclusion from two negative premises.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivePremises</IRI>
    <Literal xml:lang="FR">Aucun félin n’est un chien. Certains chiens ne sont pas des chats. Donc certains chats ne sont pas des félins.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivePremises</IRI>
    <Literal xml:lang="EN">No feline is a dog. Some dogs are not cats. Therefore, some cats are not felines.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivePremises</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fallacy_of_exclusive_premises</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivePremises</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivePremises</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitNegation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
    <Literal xml:lang="FR">Prémisses additionnelles</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
    <Literal xml:lang="EN">Additional asumptions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
    <Literal xml:lang="FR">Votre argumentation repose sur des prémisses supplémentaires non justifiées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
    <Literal xml:lang="EN">Your argument relies on additional, unjustified premises.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
    <Literal xml:lang="FR">Si les voitures nécessitent de l’essence pour fonctionner et que cette moto fonctionne, alors cette moto est une voiture.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
    <Literal xml:lang="EN">If cars require gasoline to operate and this motorcycle operates, then this motorcycle is a car.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllogisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfFourTerms</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfFourTerms</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfFourTerms</IRI>
    <Literal xml:lang="FR">Quaternio terminorum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfFourTerms</IRI>
    <Literal xml:lang="EN">Fallacy of four terms</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfFourTerms</IRI>
    <Literal xml:lang="FR">Votre raisonnement utilise quatre termes, alors qu’un syllogisme valide n’en contient que trois.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfFourTerms</IRI>
    <Literal xml:lang="EN">Using a syllogism that involves at least four terms instead of three.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfFourTerms</IRI>
    <Literal xml:lang="FR">Tous les avocats défendent des clients au tribunal. Ce fruit est un avocat. Donc ce fruit défend des clients au tribunal. — « avocat » change de sens : profession juridique dans la première prémisse, fruit dans la seconde. Le raisonnement contient donc en réalité quatre termes au lieu de trois.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfFourTerms</IRI>
    <Literal xml:lang="EN">All lawyers defend clients in court. This fruit is an avocado. Therefore, this fruit defends clients in court. — “Lawyer” and “avocado” are the same word in French, but its meaning changes: it refers to the legal profession in the first premise and to the fruit in the second. The reasoning therefore actually contains four terms instead of three.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfFourTerms</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fallacy_of_four_terms</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfFourTerms</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Quaternio_terminorum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfFourTerms</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfFourTerms</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidEnthymeme</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidEnthymeme</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidEnthymeme</IRI>
    <Literal xml:lang="FR">Enthymême invalide</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidEnthymeme</IRI>
    <Literal xml:lang="EN">Invalid Enthymeme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidEnthymeme</IRI>
    <Literal xml:lang="FR">Votre argument repose sur une prémisse implicite fausse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidEnthymeme</IRI>
    <Literal xml:lang="EN">Leveraging a false implicit premise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidEnthymeme</IRI>
    <Literal xml:lang="FR">La lumière de la cuisine est allumée, donc quelqu’un doit être chez moi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidEnthymeme</IRI>
    <Literal xml:lang="EN">The kitchen light is on, so someone must be at home.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidEnthymeme</IRI>
    <Literal xml:lang="EN">https://infidels.org/library/modern/mathew/logic.html#alterapars</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidEnthymeme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invalidEnthymeme</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#additionalAsumptions</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
    <Literal xml:lang="FR">Abus de langage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
    <Literal xml:lang="EN">Misleading language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
    <Literal xml:lang="FR">Vous usez de subtilités linguistiques pour convaincre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
    <Literal xml:lang="EN">Using language in a way that misleads or misrepresents the truth.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
    <Literal xml:lang="FR"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
    <Literal xml:lang="EN"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <Literal xml:lang="FR">Définition biaisée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <Literal xml:lang="EN">Biased definition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <Literal xml:lang="FR">Vous définissez les termes de façon à favoriser votre argument, en écartant leur sens établi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <Literal xml:lang="EN">Defining terms in a way that favors one's argument while setting aside their established meaning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <Literal xml:lang="FR">J’arrête de fumer cinq fois par jour, après chaque cigarette.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <Literal xml:lang="EN">I quit smoking five times a day, after each cigarette.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fallacies_of_definition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <Literal xml:lang="FR">Acception vague</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <Literal xml:lang="EN">Vague definition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <Literal xml:lang="FR">Vous utilisez des termes imprécis pour rester évasif et pouvoir modifier votre argumentation en cours de route.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <Literal xml:lang="EN">Using definitions that are vague enough to open argumentative leeway.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <Literal xml:lang="FR">Quand j’ai dit que je serais là dans cinq minutes, cela pouvait aussi vouloir dire dans une heure. C’est une expression : il ne fallait pas la prendre au pied de la lettre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <Literal xml:lang="EN">When I said I would be there in five minutes, that could also have meant in an hour. It's an expression; it wasn't meant to be taken literally.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <Literal xml:lang="EN">http://www.ditext.com/fearnside/10.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#closeMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#VagueVerbalClassification_Inference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToElucidate</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToElucidate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToElucidate</IRI>
    <Literal xml:lang="FR">Défaut d’élucidation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToElucidate</IRI>
    <Literal xml:lang="EN">Failure to elucidate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToElucidate</IRI>
    <Literal xml:lang="FR">Vous employez des définitions trop complexes qui obscurcissent plutôt qu’elles n’éclairent vos propos.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToElucidate</IRI>
    <Literal xml:lang="EN">Using overly complex definitions that obscure rather than clarify the argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToElucidate</IRI>
    <Literal xml:lang="FR">Vous dites que l’éther est responsable de ce phénomène. Mais qu’est-ce que l’éther ? C’est un corps subtil et invisible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToElucidate</IRI>
    <Literal xml:lang="EN">You say ether is responsible for this phenomenon. But what is ether? It is a subtle and invisible body.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToElucidate</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/logicalfallacies/Failure-to-Elucidate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToElucidate</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToElucidate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undefinability</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undefinability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undefinability</IRI>
    <Literal xml:lang="FR">Indéfinissabilité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undefinability</IRI>
    <Literal xml:lang="EN">Undefinability</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undefinability</IRI>
    <Literal xml:lang="FR">Votre argument repose sur un concept crucial qui n’est pas clairement défini.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undefinability</IRI>
    <Literal xml:lang="EN">Basing one's argument on a crucial concept that is not clearly defined.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undefinability</IRI>
    <Literal xml:lang="FR">Le concept de « qualité » est si vaste qu’il est difficile à définir précisément ; mon argument repose donc sur mon interprétation personnelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undefinability</IRI>
    <Literal xml:lang="EN">The concept of 'quality' is so broad that it's difficult to define precisely; therefore, my argument is based on my personal interpretation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undefinability</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Loki%27s_Wager</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undefinability</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undefinability</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentiallyContestedConcept</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentiallyContestedConcept</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentiallyContestedConcept</IRI>
    <Literal xml:lang="FR">Concept essentiellement contesté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentiallyContestedConcept</IRI>
    <Literal xml:lang="EN">Essentially contested concept</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentiallyContestedConcept</IRI>
    <Literal xml:lang="FR">Vous utilisez un terme ou un concept qui admet plusieurs interprétations et dont le sens est intrinsèquement disputé, ce qui entraîne des malentendus ou des débats sans fin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentiallyContestedConcept</IRI>
    <Literal xml:lang="EN">Using a term or concept that has different interpretations and whose meaning is inherently disputed, leading to misunderstandings or endless debate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentiallyContestedConcept</IRI>
    <Literal xml:lang="FR">Le terme « liberté » est utilisé par divers groupes politiques, mais chacun l’interprète différemment selon ses propres valeurs et idéologies.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentiallyContestedConcept</IRI>
    <Literal xml:lang="EN">The term 'freedom' is used by various political groups, but each interprets it differently depending on their own values and ideologies.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentiallyContestedConcept</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Essentially_contested_concept</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentiallyContestedConcept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentiallyContestedConcept</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <Literal xml:lang="FR">Acception arbitraire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <Literal xml:lang="EN">Arbitrary definition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <Literal xml:lang="FR">Vous inventez une définition sur mesure pour vos termes, sans respecter leur sens commun.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <Literal xml:lang="EN">Inventing a tailor-made definition for one's terms without respecting their common meaning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <Literal xml:lang="FR">L’amour, c’est savoir pardonner. Alors, comment osez-vous me reprocher mon infidélité ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <Literal xml:lang="EN">Love is knowing how to forgive. So how can you reproach me for my infidelity?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Arbitrariness#Philosophy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Arbitraire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#PropertyNotExistant_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
    <Literal xml:lang="FR">Incongruité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
    <Literal xml:lang="EN">Incongruity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
    <Literal xml:lang="FR">Votre argument repose sur une définition trop large ou trop restrictive d’un terme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
    <Literal xml:lang="EN">Arguing on the basis of concepts whose definitions are either too broad or too narrow.
</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
    <Literal xml:lang="FR">Je considère que mon appartement est un trois pièces. Après tout, si je peux mettre un rideau pour séparer mon lit du reste, c’est comme si j’avais un salon et une chambre, non ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
    <Literal xml:lang="EN">I consider my apartment a three-room apartment. After all, if I can hang a curtain to separate my bed from the rest, it's like having a living room and a bedroom, isn't it?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fallacies_of_definition#Incongruity:_overly_broad_or_narrow</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#broadDefinition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#broadDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#broadDefinition</IRI>
    <Literal xml:lang="FR">Définition trop large</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#broadDefinition</IRI>
    <Literal xml:lang="EN">Broad definition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#broadDefinition</IRI>
    <Literal xml:lang="FR">Votre argument repose sur une définition trop large.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#broadDefinition</IRI>
    <Literal xml:lang="EN">Arguing on the basis of too broad a definition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#broadDefinition</IRI>
    <Literal xml:lang="FR">La vache est l’animal qui nous donne du lait.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#broadDefinition</IRI>
    <Literal xml:lang="EN">A cow is the animal that gives us milk.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#broadDefinition</IRI>
    <Literal xml:lang="EN">http://www.onegoodmove.org/fallacy/broad.htm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#broadDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#broadDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrowDefinition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrowDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrowDefinition</IRI>
    <Literal xml:lang="FR">Définition trop restrictive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrowDefinition</IRI>
    <Literal xml:lang="EN">Narrow definition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrowDefinition</IRI>
    <Literal xml:lang="FR">Votre argument repose sur une définition trop restrictive.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrowDefinition</IRI>
    <Literal xml:lang="EN">Arguing on the basis of too narrow a definition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrowDefinition</IRI>
    <Literal xml:lang="FR">Une vache est un quadrupède noir et blanc.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrowDefinition</IRI>
    <Literal xml:lang="EN">A cow is a quadruped that is black and white.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrowDefinition</IRI>
    <Literal xml:lang="EN">http://www.onegoodmove.org/fallacy/narrow.htm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrowDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrowDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incongruity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <Literal xml:lang="FR">Sophisme des corrélatifs</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <Literal xml:lang="EN">Fallacy of correlatives</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <Literal xml:lang="FR">Votre argumentation manipule des termes mutuellement exclusifs de façon trompeuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <Literal xml:lang="EN">Manipulating mutually exclusive terms in a misleading way.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <Literal xml:lang="FR">Je vous adore, donc je ne vous aime pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <Literal xml:lang="EN">I adore you, so I do not love you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Correlative-based_fallacies</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#AlternativeMeans_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lostContrast</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lostContrast</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lostContrast</IRI>
    <Literal xml:lang="FR">Contraste perdu</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lostContrast</IRI>
    <Literal xml:lang="EN">Lost contrast</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lostContrast</IRI>
    <Literal xml:lang="FR">Vous définissez des termes distincts de telle sorte qu’il devient impossible de les distinguer les uns des autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lostContrast</IRI>
    <Literal xml:lang="EN">Defining the terms of the debate in a manner that blurs their differences.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lostContrast</IRI>
    <Literal xml:lang="FR">Les atomes font partie de la nature ; cette substance chimique est composée d’atomes, donc c’est un produit naturel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lostContrast</IRI>
    <Literal xml:lang="EN">Atoms are part of nature; this chemical powder is made up of atoms, so it is a natural product.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lostContrast</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Suppressed_correlative</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lostContrast</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lostContrast</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
    <Literal xml:lang="FR">Déni du corrélatif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
    <Literal xml:lang="EN">Denying the correlative</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
    <Literal xml:lang="FR">Face à une question fermée, vous introduisez des options alternatives qui n’ont pas lieu d’être.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
    <Literal xml:lang="EN">Introducing alternatives when, in fact, there are none.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
    <Literal xml:lang="FR">Est-ce que c’est l’homme de la situation ? Disons que je le connais bien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
    <Literal xml:lang="EN">Whether he's the right man for the job? Let's just say I know him well.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Denying_the_correlative</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phantomDistinction</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phantomDistinction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phantomDistinction</IRI>
    <Literal xml:lang="FR">Distinction fantôme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phantomDistinction</IRI>
    <Literal xml:lang="EN">Phantom Distinction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phantomDistinction</IRI>
    <Literal xml:lang="FR">Vous prétendez qu’il existe une différence significative entre deux concepts, deux situations ou deux objets, alors que cette différence est inexistante ou insignifiante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phantomDistinction</IRI>
    <Literal xml:lang="EN">Claiming there is a significant difference between two concepts, situations, or objects, when in fact the difference is nonexistent or insignificant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phantomDistinction</IRI>
    <Literal xml:lang="FR">Je ne suis pas contre la liberté d’expression, je pense simplement que certaines opinions ne devraient pas être exprimées publiquement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phantomDistinction</IRI>
    <Literal xml:lang="EN">I'm not against free speech, I just think some opinions shouldn't be publicly expressed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phantomDistinction</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Phantom_distinction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phantomDistinction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#phantomDistinction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="FR">Conjugaison émotive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="EN">Emotive conjugation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="FR">Vous utilisez des verbes différents pour décrire le même comportement selon que vous approuvez ou non la personne concernée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="EN">Using different verbs to describe the same behavior depending on whether the person involved is approved of or not.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="FR">Je suis persévérant, mais mon adversaire est têtu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="EN">I am persistent, but my opponent is stubborn.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Emotive_conjugation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#denyingTheCorrelative</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="FR">Sophisme du vrai Écossais</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="EN">No true Scotsman</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="FR">Pour écarter un contre-exemple, vous redéfinissez les contours de l’idée générale que vous défendez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="EN">Saving a generalization from a counterexample by changing its definition in order to exclude the latter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="FR">— Tous les Écossais sont roux. — Angus est écossais, mais il n’est pas roux. — Alors ce n’est pas un vrai Écossais.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="EN">— All Scots are red-haired.
— Angus is Scottish, but he is not red-haired.
— Then he is not a true Scot.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/No_true_Scotsman</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme_du_vrai_%C3%89cossais</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <Literal xml:lang="FR">Faux dilemme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <Literal xml:lang="EN">False dilemma</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <Literal xml:lang="FR">Vous raisonnez à partir d’un choix limité à deux options, alors qu’il existe d’autres possibilités.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <Literal xml:lang="EN">Presenting two options as the only, mutually exclusive, possibilities, when there are other possibilities.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <Literal xml:lang="FR">Si les nouvelles technologies ne vous intéressent pas, rien ne vous empêche de retourner vivre dans une grotte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <Literal xml:lang="EN">If new technologies do not interest you, nothing is stopping you from going back to living in a cave.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/False_dilemma</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Faux_dilemme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#closeMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Dilemma_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shorttermPriority</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shorttermPriority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shorttermPriority</IRI>
    <Literal xml:lang="FR">Priorité au court terme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shorttermPriority</IRI>
    <Literal xml:lang="EN">Short-term priority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shorttermPriority</IRI>
    <Literal xml:lang="FR">Vous profitez de l’urgence pour ignorer les questions de long terme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shorttermPriority</IRI>
    <Literal xml:lang="EN">Taking advantage of the pressure of urgency to ignore long-term issues.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shorttermPriority</IRI>
    <Literal xml:lang="FR">Nous devons traiter le problème de la criminalité dans nos rues avant de pouvoir nous attaquer à l’amélioration de l’école.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shorttermPriority</IRI>
    <Literal xml:lang="EN">We must deal with the crime problem on our streets before we can tackle improving our schools.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shorttermPriority</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#short</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shorttermPriority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shorttermPriority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polarizing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polarizing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polarizing</IRI>
    <Literal xml:lang="FR">Polarisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polarizing</IRI>
    <Literal xml:lang="EN">Polarizing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polarizing</IRI>
    <Literal xml:lang="FR">Vous exigez de vos interlocuteurs qu’ils prennent position pour ou contre vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polarizing</IRI>
    <Literal xml:lang="EN">You demand that the people you are talking to take a position either for or against you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polarizing</IRI>
    <Literal xml:lang="FR">Si vous ne soutenez pas notre proposition, vous avez choisi le camp des ennemis de la République.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polarizing</IRI>
    <Literal xml:lang="EN">If you don't support our proposition, you have chosen the side of the republic's enemies.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polarizing</IRI>
    <Literal xml:lang="EN">_ou_vous_%C3%AAtes_contre_nous</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polarizing</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Ou_vous_%C3%AAtes_avec_nous</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polarizing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polarizing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="FR">Pensée dichotomique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="EN">Dichotomous thinking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="FR">Vous voyez les choses en noir ou blanc, sans nuance. Si vous n’êtes pas parfait, vous vous considérez comme un échec total.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="EN">Seeing things in black and white, without nuance. If not perfect, considering oneself a total failure.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="FR">Soit on est en bonne santé, soit on est malade. — Dichotomie : la définition n’admet aucun état entre « bonne santé » et « malade », alors que la santé est un continuum offrant tous les degrés intermédiaires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="EN">Either we are in good health, or we are sick. — Dichotomy: the definition admits no state between “good health” and “sick,” even though health is a continuum offering every intermediate degree.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Splitting_(psychology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#Fractionnement_(pens%C3%A9e_%C2%AB_tout_ou_rien_%C2%BB,_pens%C3%A9e_%C2%AB_noir_ou_blanc_%C2%BB,_pens%C3%A9e_dichotomique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseDilemma</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perfectSolutionFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perfectSolutionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perfectSolutionFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de la solution parfaite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perfectSolutionFallacy</IRI>
    <Literal xml:lang="EN">Perfect solution fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perfectSolutionFallacy</IRI>
    <Literal xml:lang="FR">Vous rejetez les solutions réalistes en demandant un idéal inatteignable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perfectSolutionFallacy</IRI>
    <Literal xml:lang="EN">Rejecting realistic solutions by demanding an unattainable ideal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perfectSolutionFallacy</IRI>
    <Literal xml:lang="FR">Je suis opposée au port obligatoire de la ceinture de sécurité, car cette mesure n’empêche pas tous les accidents de la route.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perfectSolutionFallacy</IRI>
    <Literal xml:lang="EN">I am opposed to mandatory seat belt use, because this measure does not prevent all road accidents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perfectSolutionFallacy</IRI>
    <Literal xml:lang="EN">https://criticalthinkingacademy.net/index.php/blog/entry/the-perfectionist-fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perfectSolutionFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perfectSolutionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfCorrelatives</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <Literal xml:lang="FR">Définition persuasive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <Literal xml:lang="EN">Persuasive definition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <Literal xml:lang="FR">Vous définissez des termes de façon biaisée pour orienter le sens du débat en votre faveur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <Literal xml:lang="EN">Defining terms in ways that are biased towards one conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <Literal xml:lang="FR">Cet homme est un athée, quelqu’un qui n’a pas été touché par la grâce de Dieu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <Literal xml:lang="EN">This man is an atheist, someone who has not been touched by the grace of God.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#arbitraryDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weaselWord</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weaselWord</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weaselWord</IRI>
    <Literal xml:lang="FR">Mots fourbes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weaselWord</IRI>
    <Literal xml:lang="EN">Weasel word</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weaselWord</IRI>
    <Literal xml:lang="FR">Vous utilisez des termes sous-entendus pour donner l’illusion d’une affirmation précise, alors qu’elle ne l’est pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weaselWord</IRI>
    <Literal xml:lang="EN">Using words that create an impression that a specific or meaningful statement has been made, when instead it was only a vague or ambiguous claim.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weaselWord</IRI>
    <Literal xml:lang="FR">Ce produit révolutionnaire, conçu avec des matériaux de pointe de dernière génération, garantit des performances de haut vol.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weaselWord</IRI>
    <Literal xml:lang="EN">This revolutionary product, designed with state-of-the-art next-generation materials, guarantees top-flight performance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weaselWord</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Weasel_word</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weaselWord</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weaselWord</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="FR">Langage idiosyncrasique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="EN">Idiosyncratic language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="FR">Vous attribuez un sens particulier et inattendu à des termes pour appuyer votre point de vue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="EN">Attributing particular and unexpected meanings to terms in order to support one's point of view.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="FR">Quand je parle de « liberté », je ne parle pas de l’absence de contraintes ; pour moi, c’est la possibilité de choisir parmi les contraintes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="EN">When I talk about 'freedom', I don't mean the absence of constraints; for me, it's about choosing among the constraints.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <Literal xml:lang="EN">http://www.ditext.com/fearnside/51.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#talkingPoints</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#talkingPoints</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#talkingPoints</IRI>
    <Literal xml:lang="FR">Élément de langage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#talkingPoints</IRI>
    <Literal xml:lang="EN">Talking points</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#talkingPoints</IRI>
    <Literal xml:lang="FR">Votre discours repose sur des formules toutes faites, chargées idéologiquement, pour influencer l’auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#talkingPoints</IRI>
    <Literal xml:lang="EN">Relying on ready-made, ideologically loaded formulas to influence the audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#talkingPoints</IRI>
    <Literal xml:lang="FR">Ce pays a besoin d’une direction stable et forte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#talkingPoints</IRI>
    <Literal xml:lang="EN">This country needs stable, strong leadership.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#talkingPoints</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Talking_point</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#talkingPoints</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Élément_de_langage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#talkingPoints</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#talkingPoints</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleSpeak</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleSpeak</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleSpeak</IRI>
    <Literal xml:lang="FR">Double langage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleSpeak</IRI>
    <Literal xml:lang="EN">Double speak</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleSpeak</IRI>
    <Literal xml:lang="FR">Vous utilisez délibérément des termes au sens déformé et trompeur pour masquer la réalité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleSpeak</IRI>
    <Literal xml:lang="EN">Deliberately using terms with distorted and deceptive meanings to hide reality.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleSpeak</IRI>
    <Literal xml:lang="FR">Ne parlons pas de « réductions d’effectifs », mais plutôt de maximisation de l’efficacité opérationnelle de l’équipe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleSpeak</IRI>
    <Literal xml:lang="EN">Let's not talk about 'staff reductions', but rather about maximizing the operational efficiency of the team.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleSpeak</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Doublespeak</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleSpeak</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleSpeak</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onewayHashArgument</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onewayHashArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onewayHashArgument</IRI>
    <Literal xml:lang="FR">Confusion sans retour</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onewayHashArgument</IRI>
    <Literal xml:lang="EN">One-way hash argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onewayHashArgument</IRI>
    <Literal xml:lang="FR">Vous présentez une affirmation simple mais trompeuse, qu’il est long et difficile de contester ensuite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onewayHashArgument</IRI>
    <Literal xml:lang="EN">Making a simple yet typically dishonest assertion that is difficult and time consuming for an opponent to rebut.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onewayHashArgument</IRI>
    <Literal xml:lang="FR">La vraie question, c’est pourquoi nous devrions payer pour ceux qui ne travaillent pas alors que nous faisons des efforts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onewayHashArgument</IRI>
    <Literal xml:lang="EN">The real question is, why should we pay for those who do not work while we are making an effort?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onewayHashArgument</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/One-way_hash_argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onewayHashArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onewayHashArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buzzword</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buzzword</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buzzword</IRI>
    <Literal xml:lang="FR">Mot à la mode</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buzzword</IRI>
    <Literal xml:lang="EN">Buzzword</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buzzword</IRI>
    <Literal xml:lang="FR">Vous utilisez des mots à la mode pour rendre votre argumentation attrayante, sans considérer leur pertinence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buzzword</IRI>
    <Literal xml:lang="EN">Using buzzwords to make an argument appealing, without considering their relevance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buzzword</IRI>
    <Literal xml:lang="FR">La médecine douce coûte tellement moins cher au contribuable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buzzword</IRI>
    <Literal xml:lang="EN">Alternative medicine costs the taxpayer so much less.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buzzword</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Buzzword</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buzzword</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Buzzword</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buzzword</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buzzword</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idiosyncraticLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
    <Literal xml:lang="FR">Définition incohérente</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
    <Literal xml:lang="EN">Inconsistent definition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
    <Literal xml:lang="FR">Vous donnez aux termes que vous utilisez des définitions contradictoires ou incohérentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
    <Literal xml:lang="EN">Defining terms in inconsistent, logically faulty ways.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
    <Literal xml:lang="FR">Une bonne éducation doit éveiller l’esprit critique ; or une personne douée d’esprit critique ne se laisse jamais influencer par qui que ce soit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
    <Literal xml:lang="EN">A good education must awaken critical thinking; yet a person endowed with critical thinking never lets themselves be influenced by anyone.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflictingConditions</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflictingConditions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflictingConditions</IRI>
    <Literal xml:lang="FR">Conditions conflictuelles</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflictingConditions</IRI>
    <Literal xml:lang="EN">Conflicting conditions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflictingConditions</IRI>
    <Literal xml:lang="FR">Vous présentez un argument qui se contredit lui-même et ne peut donc pas être valide.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflictingConditions</IRI>
    <Literal xml:lang="EN">Using an argument that contradicts itself and therefore cannot be valid.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflictingConditions</IRI>
    <Literal xml:lang="FR">La seule chose qui est certaine est l’incertitude.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflictingConditions</IRI>
    <Literal xml:lang="EN">The only certainty is uncertainty.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflictingConditions</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/70/Conflicting-Conditions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflictingConditions</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflictingConditions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stolenConceptFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stolenConceptFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stolenConceptFallacy</IRI>
    <Literal xml:lang="FR">Concept volé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stolenConceptFallacy</IRI>
    <Literal xml:lang="EN">Stolen concept fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stolenConceptFallacy</IRI>
    <Literal xml:lang="FR">Vous niez un concept tout en continuant à l’utiliser dans votre raisonnement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stolenConceptFallacy</IRI>
    <Literal xml:lang="EN">Denying a concept while continuing to use it in an argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stolenConceptFallacy</IRI>
    <Literal xml:lang="FR">La raison et la logique ne sont pas toujours fiables ; il ne faut donc pas compter sur elles pour établir la vérité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stolenConceptFallacy</IRI>
    <Literal xml:lang="EN">Reason and logic are not always reliable; therefore, we should not rely on them to establish the truth.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stolenConceptFallacy</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/168/Stolen-Concept-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflictingConditions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stolenConceptFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stolenConceptFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflictingConditions</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="FR">Définition circulaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="EN">Circular reasoning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="FR">Vous définissez un terme au moyen de la notion même qu’il représente et que vous prétendez définir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="EN">You define a term by means of the very notion it represents and that you claim to be defining.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="FR">Nous définissons Dieu comme la chose qui a créé l’Univers. L’Univers existe. Donc Dieu existe et a créé l’Univers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="EN">We define God as the thing that created the universe. The universe exists. Therefore, God exists and created the universe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Circular_reasoning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dictionaryArgument</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dictionaryArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dictionaryArgument</IRI>
    <Literal xml:lang="FR">Argument du dictionnaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dictionaryArgument</IRI>
    <Literal xml:lang="EN">Dictionary argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dictionaryArgument</IRI>
    <Literal xml:lang="FR">Vous affirmez que la réalité décrite par un terme dépend strictement de sa définition dans le dictionnaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dictionaryArgument</IRI>
    <Literal xml:lang="EN">Claiming that the reality described by a term depends strictly on its dictionary definition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dictionaryArgument</IRI>
    <Literal xml:lang="FR">Ce pays n’est pas communiste, car ce qui s’y passe ne correspond pas à la définition donnée par Marx.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dictionaryArgument</IRI>
    <Literal xml:lang="EN">This country cannot be communist, because what happens there does not match Marx's definition of communism.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dictionaryArgument</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Argumentum_ad_dictionarium</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dictionaryArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dictionaryArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#definistFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#definistFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#definistFallacy</IRI>
    <Literal xml:lang="FR">Sophisme définiste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#definistFallacy</IRI>
    <Literal xml:lang="EN">Definist fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#definistFallacy</IRI>
    <Literal xml:lang="FR">Vous définissez un terme en utilisant d’autres termes qui sont tout aussi indéfinis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#definistFallacy</IRI>
    <Literal xml:lang="EN">Defining a term by using other terms that are just as undefined.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#definistFallacy</IRI>
    <Literal xml:lang="FR">Si vous trouvez cela bon, c’est que cela vous fait du bien, alors faites-le.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#definistFallacy</IRI>
    <Literal xml:lang="EN">If you think it's good because it makes you feel good, then you should do it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#definistFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Definist_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#definistFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#definistFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#philosophicalFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#philosophicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#philosophicalFallacy</IRI>
    <Literal xml:lang="FR">Sophisme philosophique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#philosophicalFallacy</IRI>
    <Literal xml:lang="EN">Philosophical fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#philosophicalFallacy</IRI>
    <Literal xml:lang="FR">Vous argumentez d’une manière qui soulève des problèmes quant à l’application de la logique à la connaissance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#philosophicalFallacy</IRI>
    <Literal xml:lang="EN">Arguing in a way that raises problems concerning the application of logic to knowledge.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#philosophicalFallacy</IRI>
    <Literal xml:lang="FR">J’affirme qu’aucune question philosophique ne peut être résolue par la pensée rationnelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#philosophicalFallacy</IRI>
    <Literal xml:lang="EN">I assert that any question of philosophy cannot be resolved through rational thought.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#philosophicalFallacy</IRI>
    <Literal xml:lang="EN">http://www.springer.com/us/book/9783319207827</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#philosophicalFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#philosophicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
    <Literal xml:lang="FR">Comparaison fallacieuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
    <Literal xml:lang="EN">Fallacious comparison</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
    <Literal xml:lang="FR">Vous établissez une comparaison trompeuse pour appuyer votre point de vue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
    <Literal xml:lang="EN">Reasoning on the basis of illegitimate associations of elements brought together incorrectly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
    <Literal xml:lang="FR">L’école, c’est comme la prison : on n’y entre pas et on n’en sort pas comme on veut.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
    <Literal xml:lang="EN">School is like prison: you don't enter it or leave it whenever you want.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <Literal xml:lang="FR">Comparaison abusive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <Literal xml:lang="EN">Faulty comparison</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <Literal xml:lang="FR">Vous utilisez une comparaison excessive ou inappropriée pour appuyer votre argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <Literal xml:lang="EN">Reasoning on the basis of an incorrect comparison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <Literal xml:lang="FR">Gérer une classe, c’est comme piloter une machine : si une pièce ralentit le système, il suffit de la remplacer. — Comparaison abusive : une classe n’est pas une machine, et les élèves ne sont pas des pièces interchangeables. La comparaison efface des différences essentielles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <Literal xml:lang="EN">Managing a class is like operating a machine: if one part slows down the system, you simply replace it. — Faulty comparison: a class is not a machine, and students are not interchangeable parts. The comparison erases essential differences.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/97/Faulty-Comparison</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompleteComparison</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompleteComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompleteComparison</IRI>
    <Literal xml:lang="FR">Comparaison incomplète</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompleteComparison</IRI>
    <Literal xml:lang="EN">Incomplete comparison</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompleteComparison</IRI>
    <Literal xml:lang="FR">Vous faites une comparaison en omettant des informations importantes, ce qui rend votre argument peu clair ou incorrect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompleteComparison</IRI>
    <Literal xml:lang="EN">Using a comparison without providing all the necessary data, which makes it unverifyable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompleteComparison</IRI>
    <Literal xml:lang="FR">Vous devriez acheter ce produit, car il est meilleur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompleteComparison</IRI>
    <Literal xml:lang="EN">You should buy this product, because it is better.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompleteComparison</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Incomplete_comparison</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompleteComparison</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#incompleteComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonexclusiveClassification</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonexclusiveClassification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonexclusiveClassification</IRI>
    <Literal xml:lang="FR">Classification non exclusive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonexclusiveClassification</IRI>
    <Literal xml:lang="EN">Non-exclusive classification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonexclusiveClassification</IRI>
    <Literal xml:lang="FR">Vous utilisez des catégories qui se chevauchent, faussant ainsi votre comparaison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonexclusiveClassification</IRI>
    <Literal xml:lang="EN">Using overlapping categories, thereby distorting the comparison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonexclusiveClassification</IRI>
    <Literal xml:lang="FR">Je vous vois peindre, mais ne m’aviez-vous pas dit que vous étiez scientifique ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonexclusiveClassification</IRI>
    <Literal xml:lang="EN">I see you painting, but didn't you tell me you were a scientist?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonexclusiveClassification</IRI>
    <Literal xml:lang="EN">http://www.ditext.com/fearnside/8.html#b</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonexclusiveClassification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonexclusiveClassification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentComparison</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentComparison</IRI>
    <Literal xml:lang="FR">Comparaison incohérente</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentComparison</IRI>
    <Literal xml:lang="EN">Inconsistent comparison</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentComparison</IRI>
    <Literal xml:lang="FR">Vous comparez des choses en ne retenant que certains aspects, ce qui fausse la comparaison globale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentComparison</IRI>
    <Literal xml:lang="EN">Comparing things while retaining only certain aspects, thereby distorting the overall comparison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentComparison</IRI>
    <Literal xml:lang="FR">La viande est moins chère que le café ; elle est également mieux adaptée que les bananes à une production locale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentComparison</IRI>
    <Literal xml:lang="EN">Meat is cheaper than coffee; it is also better adapted than bananas for local production.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentComparison</IRI>
    <Literal xml:lang="EN">https://www.seekfind.net/Inconsistent_Comparison_Fallacy.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentComparison</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inconsistentComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionWithoutADifference</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionWithoutADifference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionWithoutADifference</IRI>
    <Literal xml:lang="FR">Distinction sans différence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionWithoutADifference</IRI>
    <Literal xml:lang="EN">Distinction without a difference</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionWithoutADifference</IRI>
    <Literal xml:lang="FR">Vous distinguez deux éléments qui sont en réalité semblables ou qui ne présentent aucune différence significative.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionWithoutADifference</IRI>
    <Literal xml:lang="EN">Distinguishing between two elements that are, in fact, similar or have no significant difference.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionWithoutADifference</IRI>
    <Literal xml:lang="FR">Je vous ai dit de le faire. Je ne vous ai pas dit d’essayer de le faire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionWithoutADifference</IRI>
    <Literal xml:lang="EN">I told you to do it, not to try to do it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionWithoutADifference</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/80/Distinction-Without-a-Difference</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionWithoutADifference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionWithoutADifference</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyComparison</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <Literal xml:lang="FR">Fausse analogie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <Literal xml:lang="EN">False analogy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <Literal xml:lang="FR">Vous établissez un parallèle entre deux choses en vous basant seulement sur un point commun, négligeant leurs différences importantes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <Literal xml:lang="EN">You draw a parallel between two things based solely on one feature they share, while overlooking their important differences.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <Literal xml:lang="FR">Personne n’empêche un chirurgien de consulter ses notes pendant une intervention difficile. Alors pourquoi voudriez-vous m’en priver pendant cet examen ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <Literal xml:lang="EN">No one stops a surgeon from consulting their notes during a complex surgery. So why would you want to prevent me from using notes during this exam?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argument_from_analogy#False_analogy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <Literal xml:lang="FR">http://www.sceptiques.qc.ca/dictionnaire/falseanalogy.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#closeMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionbeggingAnalogy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionbeggingAnalogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionbeggingAnalogy</IRI>
    <Literal xml:lang="FR">Pétition de principe analogique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionbeggingAnalogy</IRI>
    <Literal xml:lang="EN">Question-begging analogy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionbeggingAnalogy</IRI>
    <Literal xml:lang="FR">Vous utilisez une analogie qui suppose déjà la conclusion que vous cherchez à démontrer, en assimilant de manière discutable deux situations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionbeggingAnalogy</IRI>
    <Literal xml:lang="EN">You use an analogy that already assumes the conclusion you are trying to prove by questionably equating two situations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionbeggingAnalogy</IRI>
    <Literal xml:lang="FR">L’accès à Internet est un droit humain, tout comme l’accès à l’eau potable. Tout le monde a besoin d’eau pour vivre, donc tout le monde a besoin d’Internet pour vivre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionbeggingAnalogy</IRI>
    <Literal xml:lang="EN">Access to the internet is a human right, just like access to clean water. Everyone needs water to live, so everyone must need the internet to live.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionbeggingAnalogy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/qbanalog.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionbeggingAnalogy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionbeggingAnalogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extendedAnalogy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extendedAnalogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extendedAnalogy</IRI>
    <Literal xml:lang="FR">Analogie étendue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extendedAnalogy</IRI>
    <Literal xml:lang="EN">Extended analogy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extendedAnalogy</IRI>
    <Literal xml:lang="FR">À partir d’une chose qui ressemble à une deuxième et partage une propriété avec une troisième, vous concluez que la deuxième et la troisième se ressemblent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extendedAnalogy</IRI>
    <Literal xml:lang="EN">Suggesting that because two things are alike in some way and one of those things is like something else, then both things must be like that "something else".</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extendedAnalogy</IRI>
    <Literal xml:lang="FR">Quiconque n’a pas de problème à abattre des animaux pour se nourrir ne devrait pas, en principe, avoir de problème avec le fait qu’une race extraterrestre avancée nous massacre pour se nourrir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extendedAnalogy</IRI>
    <Literal xml:lang="EN">If someone thinks it's okay to harvest animals for their meals, then they should not theoretically have a problem with an advanced alien species culling us for their food.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extendedAnalogy</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/84/Extended-Analogy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extendedAnalogy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extendedAnalogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousSimilarityArgument</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousSimilarityArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousSimilarityArgument</IRI>
    <Literal xml:lang="FR">Argument de la similarité fallacieuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousSimilarityArgument</IRI>
    <Literal xml:lang="EN">Fallacious similarity argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousSimilarityArgument</IRI>
    <Literal xml:lang="FR">Vous considérez que deux choses qui se ressemblent sont liées ou similaires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousSimilarityArgument</IRI>
    <Literal xml:lang="EN">Considering two things that resemble each other to be related or similar.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousSimilarityArgument</IRI>
    <Literal xml:lang="FR">Les voitures autonomes sont comme les ascenseurs automatiques. Dans les deux cas, il n’y a pas besoin d’opérateur humain pour contrôler le mouvement. Donc, si les ascenseurs automatiques sont sûrs et fiables, les voitures autonomes le sont également.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousSimilarityArgument</IRI>
    <Literal xml:lang="EN">Self-driving cars are like automatic elevators. In both cases, there is no need for a human operator to control the movement. So, if automatic elevators are safe and reliable, self-driving cars are too.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousSimilarityArgument</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#similarity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousSimilarityArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousSimilarityArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="FR">Fausse équivalence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="EN">False equivalence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="FR">Vous faites un parallèle impropre entre deux arguments distincts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="EN">Drawing an improper parallel between two distinct arguments or situations, assuming them to be equivalent based on a superficial similarity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="FR">Vous me demandez de faire mes devoirs après l’école ; mais je ne vous demande pas, moi, de faire des heures supplémentaires une fois rentré du bureau.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="EN">You're asking me to do my homework after school; but then, I don't ask you to do overtime when you return from work.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/False_equivalence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEquivalence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAnalogy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
    <Literal xml:lang="FR">Sophisme d’association</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
    <Literal xml:lang="EN">Association fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
    <Literal xml:lang="FR">Vous associez à tort des éléments entre eux en vous fondant sur des caractéristiques communes sans rapport avec l’argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
    <Literal xml:lang="EN">Using a shared property between A and B to ascribe any property of B to A.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
    <Literal xml:lang="FR">Jeanne est bonne en mathématiques. Jeanne est dyslexique. Donc tous les dyslexiques sont bons en mathématiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
    <Literal xml:lang="EN">Jane is good at mathematics. Jane is dyslexic. Therefore, all dyslexic people are good at mathematics.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Association_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme_par_association</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciousComparison</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflation</IRI>
    <Literal xml:lang="FR">Amalgame</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflation</IRI>
    <Literal xml:lang="EN">Conflation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflation</IRI>
    <Literal xml:lang="FR">Vous associez à tort une personne ou une chose à une catégorie négative en vous fondant sur un seul point commun.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflation</IRI>
    <Literal xml:lang="EN">You wrongly associate a person or thing with a negative category based on a single point in common.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflation</IRI>
    <Literal xml:lang="FR">Vous êtes végétarien ? Nous n’avons pas besoin de militant écologiste ici.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflation</IRI>
    <Literal xml:lang="EN">You're a vegetarian? We don't need an environmental activist here.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Conflation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Amalgame_(communication)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conflation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#associationFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <Literal xml:lang="FR">Ambiguïté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <Literal xml:lang="EN">Ambiguity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <Literal xml:lang="FR">Votre argumentation repose sur des énoncés qui peuvent avoir plusieurs sens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <Literal xml:lang="EN">Phrasing statements that have several possible meanings.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <Literal xml:lang="FR">Il a peint le portrait de la dame en noir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <Literal xml:lang="EN">He painted the lady's portrait in black.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/17/Ambiguity-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <Literal xml:lang="FR">https://yourlogicalfallacyis.com/fr/ambiguite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <Literal xml:lang="FR">Amphibologie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <Literal xml:lang="EN">Syntactic ambiguity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <Literal xml:lang="FR">Vous construisez votre argumentation sur des phrases dont la structure peut prêter à différentes interprétations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <Literal xml:lang="EN">Using ambiguous sentence structures, that have several possible understandings.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <Literal xml:lang="FR">Je préfère le poulet aux olives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <Literal xml:lang="EN">I prefer chicken with olives—or chicken over olives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Syntactic_ambiguity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Amphibologie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousPunctuation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousPunctuation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousPunctuation</IRI>
    <Literal xml:lang="FR">Ponctuation ambiguë</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousPunctuation</IRI>
    <Literal xml:lang="EN">Ambiguous punctuation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousPunctuation</IRI>
    <Literal xml:lang="FR">Vous utilisez une ponctuation imprécise, créant ainsi des phrases à double sens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousPunctuation</IRI>
    <Literal xml:lang="EN">Using a sentence which may be interpreted in more than one way due to ambiguous punctuation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousPunctuation</IRI>
    <Literal xml:lang="FR">Les membres du comité qui ont validé ce dossier seront convoqués. — Restrictive : seuls les membres ayant validé ce dossier seront convoqués. Les membres du comité, qui ont validé ce dossier, seront convoqués. — Explicative : tous les membres seront convoqués, et l’on précise qu’ils ont validé ce dossier.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousPunctuation</IRI>
    <Literal xml:lang="EN">The committee members who approved this file will be summoned. — Restrictive: only the members who approved this file will be summoned. The committee members, who approved this file, will be summoned. — Non-restrictive: all the members will be summoned, and it is specified that they approved this file.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousPunctuation</IRI>
    <Literal xml:lang="EN">https://cybertext.wordpress.com/2012/11/22/a-light-hearted-look-at-how-punctuation-can-change-meaning/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousPunctuation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousPunctuation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de portée modale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="EN">Modal scope fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="FR">Vous modifiez le sens logique en confondant la portée d’un terme modal (nécessaire, possible, certain).</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="EN">Modifying the logical meaning by confusing the scope of a modal term (necessary, possible, certain).</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="FR">Si vous savez quelque chose, vous ne pouvez pas vous tromper. Mais si vous ne pouvez pas vous tromper, alors vous en êtes certain. La certitude est donc une condition nécessaire de la connaissance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="EN">If I know something, I cannot be mistaken. But if I cannot be mistaken, then I am certain of it. Certainty is therefore a necessary condition of knowledge.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/modlscop.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="FR">Glissement du quantificateur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="EN">Quantifier shift</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="FR">Vous modifiez le sens d’une phrase en déplaçant les quantificateurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="EN">Changing the meaning of a statement by shifting the quantifiers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="FR">Dans chaque ville, il y a un restaurant qui est considéré comme le meilleur de la ville. Il existe donc un restaurant qui est considéré comme le meilleur dans toutes les villes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="EN">In every town, there is a restaurant considered the best in that town. Therefore, there exists a restaurant considered the best in all towns.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Quantifier_shift</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantifierShift</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalScopeFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accent</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accent</IRI>
    <Literal xml:lang="FR">Accent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accent</IRI>
    <Literal xml:lang="EN">Accent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accent</IRI>
    <Literal xml:lang="FR">Vous utilisez l’intonation ou l’accentuation pour suggérer un message différent des mots employés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accent</IRI>
    <Literal xml:lang="EN">Using intonation or emphasis to suggest a message different from the words used.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accent</IRI>
    <Literal xml:lang="FR">Je n’ai pas dit qu’elle a VOLÉ l’argent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accent</IRI>
    <Literal xml:lang="EN">I did not say that she STOLE the money.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accent</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Fallacy_of_accent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrast</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrast</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrast</IRI>
    <Literal xml:lang="FR">Contraste illicite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrast</IRI>
    <Literal xml:lang="EN">Illicit contrast</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrast</IRI>
    <Literal xml:lang="FR">Vous attribuez à autrui une intonation qui modifie le sens perçu de ses mots.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrast</IRI>
    <Literal xml:lang="EN">Attributing to the speaker a specific prosody that alters the perceived meaning of their words.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrast</IRI>
    <Literal xml:lang="FR">Vous « imaginez » que c’est lui le coupable ? Vous faites en effet preuve de beaucoup d’imagination.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrast</IRI>
    <Literal xml:lang="EN">You 'imagine' he's the guilty one? You sure have a vivid imagination.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrast</IRI>
    <Literal xml:lang="EN">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrast</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illicitContrast</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solecism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solecism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solecism</IRI>
    <Literal xml:lang="FR">Solécisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solecism</IRI>
    <Literal xml:lang="EN">Solecism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solecism</IRI>
    <Literal xml:lang="FR">Une erreur de grammaire dans votre phrase crée une ambiguïté, même si les mots employés sont corrects.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solecism</IRI>
    <Literal xml:lang="EN">Making a grammatical error in a sentence that creates ambiguity, even though the words used are correct.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solecism</IRI>
    <Literal xml:lang="FR">Je n’ai pas pu aller au cinéma, avec le coiffeur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solecism</IRI>
    <Literal xml:lang="EN">I couldn't go to the movie, with the hairdresser.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solecism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Solecism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solecism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sol%C3%A9cisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solecism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#solecism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#barbarism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#barbarism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#barbarism</IRI>
    <Literal xml:lang="FR">Barbarisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#barbarism</IRI>
    <Literal xml:lang="EN">Barbarism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#barbarism</IRI>
    <Literal xml:lang="FR">Vous employez un mot inventé ou emprunté à une autre langue, rendant le propos incertain.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#barbarism</IRI>
    <Literal xml:lang="EN">Using an invented word or one borrowed from another language, making the statement uncertain.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#barbarism</IRI>
    <Literal xml:lang="FR">La bravitude de ce peuple est impressionnante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#barbarism</IRI>
    <Literal xml:lang="EN">The bravitude of this people is impressive.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#barbarism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Barbarism_(linguistics)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#barbarism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Barbarisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#barbarism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#barbarism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syntacticAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <Literal xml:lang="FR">Équivoque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <Literal xml:lang="EN">Semantic ambiguity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <Literal xml:lang="FR">Vous exploitez les différents sens d’un même mot pour rendre votre propos ambigu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <Literal xml:lang="EN">Exploiting the different senses of a single word to make one's statement ambiguous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <Literal xml:lang="FR">Cet ours a mangé un avocat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <Literal xml:lang="EN">That bear ate an avocado—or a lawyer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Equivocation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/%C3%89quivoque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="FR">Expression vague</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="EN">Vagueness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="FR">Vous utilisez des termes si vagues qu’ils ne permettent pas de comprendre clairement ce que vous voulez dire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="EN">Using terms so vague that they do not allow the audience to clearly understand what is meant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="FR">Lorsque je vous ai dit que c’était « accessible », je voulais dire accessible à pied, pas en fauteuil roulant ni avec une poussette.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="EN">When I told you it was 'accessible', I meant accessible on foot, not by wheelchair or with a stroller.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/vaguenes.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#VagueVerbalClassification_Inference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="FR">Fausse précision</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="EN">False precision</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="FR">Vous présentez des données numériques qui semblent précises mais dont la précision n’est pas justifiée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="EN">Presenting numerical data in a manner that implies better precision than is justified, often to pretend exaggerated accuracy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="FR">Le squelette de ce dinosaure a 100 000 005 ans, car il y a 5 ans, des scientifiques lui ont donné 100 000 000 ans.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="EN">This dinosaur skeleton is 100,000,005 years old because 5 years ago, an expert determined it was 100 million years old.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/False_precision</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePrecision</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
    <Literal xml:lang="FR">Pente glissante sémantique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
    <Literal xml:lang="EN">Semantic Slippery slope</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
    <Literal xml:lang="FR">Vous considérez que l’application d’un concept mène nécessairement à celle d’un autre, parce que la frontière entre les deux est graduelle et sans distinction nette.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
    <Literal xml:lang="EN">Considering that the application of one concept necessarily leads to that of another because the boundary between the two is gradual without clear distinction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
    <Literal xml:lang="FR">L’autorisation de l’avortement conduira nécessairement à la légalisation de l’infanticide, car nul ne sait vraiment où s’arrête l’embryon et où commence le bébé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
    <Literal xml:lang="EN">Allowing abortion will inevitably lead to legalizing infanticide because there's no clear line where the embryo becomes a baby.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/fallheap.html#Note4</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vagueness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#closeMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#VerbalSlipperySlope_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="FR">Argument de la barbe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="EN">Argument of the beard</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="FR">En soutenant qu’il n’existe pas de frontière claire entre deux états, vous refusez de les distinguer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="EN">Refusing to distinguish between two states by arguing that there is no clear boundary between them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="FR">Il y a un risque à tout. Si on commence à porter un casque pour faire du vélo, autant porter un casque tout le temps !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="EN">There's a risk in everything. If we start wearing helmets for biking, might as well wear one all the time!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/58/Argument-of-the-Beard</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentOfTheBeard</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSlipperySlope</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
    <Literal xml:lang="FR">Glissement lexical polysémique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
    <Literal xml:lang="EN">Polysemic lexical shift</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
    <Literal xml:lang="FR">Vous employez un mot polysémique ou dont le sens a évolué, ce qui peut prêter à confusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
    <Literal xml:lang="EN">Using a polysemous word or one whose meaning has evolved, which may cause confusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
    <Literal xml:lang="FR">Lors de la réunion, il a utilisé le terme « réseau » pour parler de ses contacts ; je pensais qu’il parlait d’Internet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
    <Literal xml:lang="EN">During the meeting, he used the term “network” to talk about his contacts; I thought he was talking about the Internet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Onomasiology#Lexical_change</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mondegreen</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mondegreen</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mondegreen</IRI>
    <Literal xml:lang="FR">Mondegreen</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mondegreen</IRI>
    <Literal xml:lang="EN">Mondegreen</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mondegreen</IRI>
    <Literal xml:lang="FR">Vous comprenez ou rapportez une phrase de manière erronée parce qu’elle ressemble phonétiquement à une autre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mondegreen</IRI>
    <Literal xml:lang="EN">You misunderstand or inaccurately report a phrase because it sounds like another one.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mondegreen</IRI>
    <Literal xml:lang="FR">Il entend « Mariage plus vieux, mariage heureux » au lieu de « Mariage pluvieux, mariage heureux ».</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mondegreen</IRI>
    <Literal xml:lang="EN">He hears “older wedding, happier marriage” instead of “rainy wedding, happy marriage.”</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mondegreen</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Mondegreen</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mondegreen</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mondegreen</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
    <Literal xml:lang="FR">Homonymie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
    <Literal xml:lang="EN">Homonym</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
    <Literal xml:lang="FR">Vous construisez votre argument en utilisant un terme à plusieurs sens, ce qui sème la confusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
    <Literal xml:lang="EN">Constructing an argument using a term with multiple meanings, causing confusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
    <Literal xml:lang="FR">Le poète était ivre et comptait les pieds de son verre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
    <Literal xml:lang="EN">The poet was drunk and counting the feet of his glass.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Homonym</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_II</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heterosemy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heterosemy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heterosemy</IRI>
    <Literal xml:lang="FR">Hétérosémie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heterosemy</IRI>
    <Literal xml:lang="EN">Heterosemy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heterosemy</IRI>
    <Literal xml:lang="FR">Vous basez votre argument sur un mot qui peut signifier plusieurs choses selon le contexte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heterosemy</IRI>
    <Literal xml:lang="EN">Basing an argument on a word that can mean multiple things depending on the context.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heterosemy</IRI>
    <Literal xml:lang="FR">Quand il a dit qu’il « supportait » son équipe, je pensais qu’il parlait de l’encourager, pas de financer ses déplacements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heterosemy</IRI>
    <Literal xml:lang="EN">When he said he 'supported' his team, I thought he meant cheering them on, not financing their travels.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heterosemy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Heterosemy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heterosemy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heterosemy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homonym</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jingleJangleFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jingleJangleFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jingleJangleFallacy</IRI>
    <Literal xml:lang="FR">Sophisme jingle-jangle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jingleJangleFallacy</IRI>
    <Literal xml:lang="EN">Jingle-Jangle Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jingleJangleFallacy</IRI>
    <Literal xml:lang="FR">Vous utilisez des termes différents pour désigner la même idée, ou le même terme pour désigner des idées différentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jingleJangleFallacy</IRI>
    <Literal xml:lang="EN">Using different terms to represent the same ideas or the same term to reflect different ideas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jingleJangleFallacy</IRI>
    <Literal xml:lang="FR">Nous disons tous deux vouloir l’égalité, mais quand je parle de « justice », je crois que nous ne parlons pas du même concept.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jingleJangleFallacy</IRI>
    <Literal xml:lang="EN">We both say we want equality, but when I talk about 'justice', I don't think we're speaking about the same concept.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jingleJangleFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Jingle-jangle_fallacies</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jingleJangleFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#jingleJangleFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemicLexicalShift</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
    <Literal xml:lang="FR">Changement sémantique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
    <Literal xml:lang="EN">Polysemy by semantic change</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
    <Literal xml:lang="FR">Vous utilisez un terme dont le sens a changé au fil de l’histoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
    <Literal xml:lang="EN">A word is used whose meaning is unclear because its usual meaning is not the same as its original.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
    <Literal xml:lang="FR">Il est écrit sur la devanture de cette auberge : « Qui dort dîne » ; nous nous passerons donc de dîner ce soir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
    <Literal xml:lang="EN">The old inn's sign says 'He who sleeps dines', so we're skipping dinner tonight assuming it means not needing to eat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Semantic_change</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="FR">Métonymie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="EN">Metonymy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="FR">Vous remplacez une idée par une autre qui lui est conceptuellement liée, sans que cela soit clairement justifié.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="EN">Using one concept as a substitute for another, conceptually related, without clear justification.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="FR">Au vu du nombre de stylos que cette entreprise distribue, elle écrit manifestement son succès.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="EN">Given how many pens this company gives out, they're clearly writing their own success.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Metonymy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Métonymie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#typeTokenFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#typeTokenFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#typeTokenFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de confusion type-exemple</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#typeTokenFallacy</IRI>
    <Literal xml:lang="EN">Type-Token Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#typeTokenFallacy</IRI>
    <Literal xml:lang="FR">Vous confondez un concept général avec un exemple particulier, ce qui rend votre argument ambigu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#typeTokenFallacy</IRI>
    <Literal xml:lang="EN">Confusing a general concept (type) with a specific instance (token), making the argument ambiguous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#typeTokenFallacy</IRI>
    <Literal xml:lang="FR">Vous me dites que ce restaurant sert une vingtaine de plats différents. Comment peut-il rester ouvert avec si peu de clients ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#typeTokenFallacy</IRI>
    <Literal xml:lang="EN">You tell me that this restaurant serves around twenty different dishes. How can they stay afloat with so few customers?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#typeTokenFallacy</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/logicalfallacies/Type-Token-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#typeTokenFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#typeTokenFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <Literal xml:lang="FR">Idola fori</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <Literal xml:lang="EN">Idola fori</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <Literal xml:lang="FR">Votre argument suppose une correspondance parfaite entre le langage et la réalité qu’il représente.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <Literal xml:lang="EN">Arguing based on the assumption that language perfectly maps onto reality.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <Literal xml:lang="FR">Je pensais que, lorsque nous parlions d’amour, nous parlions tous les deux de ce sentiment unique qui nous lie pour l’éternité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <Literal xml:lang="EN">I thought we were both talking about love, that unique feeling that binds us forever.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Idola_fori</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polysemyBySemanticChange</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
    <Literal xml:lang="FR">Réification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
    <Literal xml:lang="EN">Reification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
    <Literal xml:lang="FR">Vous faites comme si une idée ou un terme abstrait existait physiquement, ce qui fausse votre raisonnement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
    <Literal xml:lang="EN">Treating something abstract as a concrete thing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
    <Literal xml:lang="FR">Quand je serai riche, j’achèterai son amour.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
    <Literal xml:lang="EN">When I'm wealthy, I'll buy his love.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Reification_(fallacy)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/R%C3%A9ification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#referentialFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#referentialFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#referentialFallacy</IRI>
    <Literal xml:lang="FR">Sophisme référentiel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#referentialFallacy</IRI>
    <Literal xml:lang="EN">Referential fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#referentialFallacy</IRI>
    <Literal xml:lang="FR">Vous croyez qu’un mot et l’objet auquel il renvoie sont liés de manière indissociable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#referentialFallacy</IRI>
    <Literal xml:lang="EN">Believing that a word and the object it refers to are inseparably bound, leading to ambiguity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#referentialFallacy</IRI>
    <Literal xml:lang="FR">Ce que j’ai ressenti pour elle, c’est l’amour au premier regard.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#referentialFallacy</IRI>
    <Literal xml:lang="EN">What I felt for her was love at first sight.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#referentialFallacy</IRI>
    <Literal xml:lang="EN">https://www.oxfordreference.com/display/10.1093/oi/authority.20110803100410326?rskey=lUniXs&amp;result=15</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#referentialFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#referentialFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordMagic</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordMagic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordMagic</IRI>
    <Literal xml:lang="FR">La magie des mots</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordMagic</IRI>
    <Literal xml:lang="EN">Word magic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordMagic</IRI>
    <Literal xml:lang="FR">Vous pensez que parce qu’un mot existe, ce qu’il désigne doit forcément exister.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordMagic</IRI>
    <Literal xml:lang="EN">Thinking that because a word exists, what it represents must also certainly exist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordMagic</IRI>
    <Literal xml:lang="FR">Chacun sait ce qu’est le ’bonheur’; il est donc impossible qu’il n’existe pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordMagic</IRI>
    <Literal xml:lang="EN">Everyone knows what 'happiness' is; therefore, it is impossible that it does not exist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordMagic</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Word_magic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordMagic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordMagic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakingTheMapForTheTerritory</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakingTheMapForTheTerritory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakingTheMapForTheTerritory</IRI>
    <Literal xml:lang="FR">Confondre la carte avec le territoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakingTheMapForTheTerritory</IRI>
    <Literal xml:lang="EN">Mistaking the map for the territory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakingTheMapForTheTerritory</IRI>
    <Literal xml:lang="FR">Vous confondez une représentation ou un modèle avec la réalité qu’elle représente.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakingTheMapForTheTerritory</IRI>
    <Literal xml:lang="EN">Confusing a representation or model with the reality it is meant to represent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakingTheMapForTheTerritory</IRI>
    <Literal xml:lang="FR">En analysant les données statistiques sur le bien-être social, nous en avons conclu que la société est en bonne santé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakingTheMapForTheTerritory</IRI>
    <Literal xml:lang="EN">By analyzing statistical data on social well-being, we concluded that society is healthy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakingTheMapForTheTerritory</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Mistaking_the_map_for_the_territory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakingTheMapForTheTerritory</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakingTheMapForTheTerritory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#useMentionError</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#useMentionError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#useMentionError</IRI>
    <Literal xml:lang="FR">Erreur Usage Mention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#useMentionError</IRI>
    <Literal xml:lang="EN">Use mention error</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#useMentionError</IRI>
    <Literal xml:lang="FR">Vous confondez l’utilisation d’un mot avec l’objet qu’il décrit, en traitant le mot comme s’il était l’objet lui-même.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#useMentionError</IRI>
    <Literal xml:lang="EN">Confusing the use of a word with the object it describes, treating the word as if it were the object itself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#useMentionError</IRI>
    <Literal xml:lang="FR">Tu m’as demandé de l’amour. Et bien cette lettre en est remplie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#useMentionError</IRI>
    <Literal xml:lang="EN">You asked me for love. Well, this letter is full of it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#useMentionError</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/logicalfallacies/Use-Mention-Error.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakingTheMapForTheTerritory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#useMentionError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#useMentionError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakingTheMapForTheTerritory</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simulacrum</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simulacrum</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simulacrum</IRI>
    <Literal xml:lang="FR">Simulacre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simulacrum</IRI>
    <Literal xml:lang="EN">Simulacrum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simulacrum</IRI>
    <Literal xml:lang="FR">Vous basez votre argument sur une version représentative idéalisée et trompeuse de la réalité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simulacrum</IRI>
    <Literal xml:lang="EN">Basing an argument on an idealized and misleading representative version of reality.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simulacrum</IRI>
    <Literal xml:lang="FR">Les publicités représentent le bonheur familial comme étant simplement l’achat du dernier gadget technologique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simulacrum</IRI>
    <Literal xml:lang="EN">Advertisements show family happiness as just acquiring the latest tech gadget.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simulacrum</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Simulacrum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simulacrum</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Simulacre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simulacrum</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#simulacrum</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteandbaileyFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteandbaileyFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteandbaileyFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de la motte castrale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteandbaileyFallacy</IRI>
    <Literal xml:lang="EN">Motte-and-bailey fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteandbaileyFallacy</IRI>
    <Literal xml:lang="FR">De deux positions qui présentent des similitudes, vous défendez la position modeste consensuelle et affirmez prouver la position complexe controversée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteandbaileyFallacy</IRI>
    <Literal xml:lang="EN">Of two positions that have similarities, defending the modest consensual position and claiming to prove the complex controversial position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteandbaileyFallacy</IRI>
    <Literal xml:lang="FR">Bien sûr que les astres influencent la nature. Regarde l’effet des marées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteandbaileyFallacy</IRI>
    <Literal xml:lang="EN">Sure, celestial bodies influence nature. Look at the tidal effects.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteandbaileyFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Motte-and-bailey_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteandbaileyFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme_de_la_motte_castrale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteandbaileyFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteandbaileyFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#idolaFori</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <Literal xml:lang="FR">Ambiguïté narrative</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <Literal xml:lang="EN">Narrative ambiguity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <Literal xml:lang="FR">Vous présentez votre argument sous la forme d’un récit qui peut être interprété de plusieurs manières.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <Literal xml:lang="EN">You present your argument in the form of a narrative that can be interpreted in several ways.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <Literal xml:lang="FR">Lundi dernier, vous avez rendu votre devoir à temps ; aujourd’hui, il faut que nous parlions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <Literal xml:lang="EN">Last Monday you handed your work in on time. Today we need to talk.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#ConflictingGoals_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseImplication</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseImplication</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseImplication</IRI>
    <Literal xml:lang="FR">Fausse implication</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseImplication</IRI>
    <Literal xml:lang="EN">False implication</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseImplication</IRI>
    <Literal xml:lang="FR">Votre argument suggère des idées sans les énoncer clairement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseImplication</IRI>
    <Literal xml:lang="EN">Crafting an argument that subtly introduces implicit propositions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseImplication</IRI>
    <Literal xml:lang="FR">Ce jour-là, vous êtes bien arrivé à l’heure.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseImplication</IRI>
    <Literal xml:lang="EN">That day, you indeed arrived on time.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseImplication</IRI>
    <Literal xml:lang="EN">http://skepdic.com/falseimplication.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseImplication</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseImplication</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
    <Literal xml:lang="FR">Argument par l’insinuation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
    <Literal xml:lang="EN">Insinuation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
    <Literal xml:lang="FR">Vous argumentez en insinuant des choses sans les dire clairement, et laissez au public le soin d’interpréter vos sous-entendus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
    <Literal xml:lang="EN">Arguing by insinuating things without stating them clearly, leaving the audience to interpret the implied meanings.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
    <Literal xml:lang="FR">Vous étiez seul dans la pièce, et je ne trouve plus mon portefeuille.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
    <Literal xml:lang="EN">You were alone in the room, and now my wallet is missing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
    <Literal xml:lang="EN">https://www.thoughtco.com/what-is-an-innuendo-1691175</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseImplication</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseImplication</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="FR">Compliment empoisonné</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="EN">Damning with faint praise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="FR">Vous discréditez quelqu’un par un compliment qui, en réalité, insinue le contraire de ce qu’il semble exprimer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="EN">Discrediting someone through a compliment that actually suggests the opposite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="FR">Il est, à mon avis, exagéré de suggérer, comme on le fait parfois, que son raisonnement ne vaut rien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="EN">It would be an exaggeration to suggest, as some do, that his line of thought is worthless.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Damning_with_faint_praise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="FR">Indiscrétion anonyme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="EN">Blind Item</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="FR">Vous diffusez des rumeurs ou des informations sans nommer les personnes impliquées, souvent pour éviter des répercussions légales.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="EN">Spreading rumors or information without naming the involved parties, often to avoid legal repercussions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="FR">Un célèbre acteur, que je ne nommerai pas, aurait eu une liaison secrète.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="EN">A certain famous actor, whom I won't name, is rumored to have had a secret affair.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Blind_item</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insinuation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
    <Literal xml:lang="FR">Propagande grise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
    <Literal xml:lang="EN">Gray propaganda</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
    <Literal xml:lang="FR">Vous dissimulez l’origine réelle de vos informations pour les rendre plus crédibles, sans révéler vos intentions ni vos liens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
    <Literal xml:lang="EN">Hiding the true origin of information to make it seem more credible, without revealing one's intentions or affiliations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
    <Literal xml:lang="FR">Ce documentaire présente des statistiques impressionnantes sur notre produit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
    <Literal xml:lang="EN">This documentary presents impressive statistics about our product.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Propaganda#Types</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Propagande_grise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="FR">Campagne de murmures</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="EN">Whispering campaign</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="FR">Vous répandez des rumeurs nuisibles ou des insinuations à propos d’une cible, tout en évitant d’être identifié.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="EN">Spreading damaging rumors or innuendo about a target, while avoiding being detected.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="FR">Dans l’entreprise, une campagne de murmures commence contre Martin. Ses collègues diffusent anonymement des rumeurs sur son incompétence présumée et son manque d’éthique, créant de la méfiance parmi ses pairs sans confrontation directe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="EN">In the office, a whispering campaign starts against Martin. His colleagues anonymously spread rumors about his alleged incompetence and lack of ethics, causing distrust among his peers without any direct confrontation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Whispering_campaign</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#grayPropaganda</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
    <Literal xml:lang="FR">Propagande noire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
    <Literal xml:lang="EN">Black propaganda</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
    <Literal xml:lang="FR">Vous faites croire que vos arguments viennent de vos alliés, alors qu’ils émanent en réalité de vos opposants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
    <Literal xml:lang="EN">Misleading by making it appear that arguments come from allies when they actually come from opponents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
    <Literal xml:lang="FR">Mes chers concitoyens, en tant que membre de la majorité parlementaire, il est de mon devoir de vous informer que votre gouvernement a choisi de vendre vos intérêts à ce pays qui se prétend notre allié.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
    <Literal xml:lang="EN">My fellow citizens, as a member of the parliamentary majority, it is my duty to inform you that your government has chosen to sell your interests to this country that claims to be our ally.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Propaganda#Types</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Propagande_noire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertInterrogation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertInterrogation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertInterrogation</IRI>
    <Literal xml:lang="FR">Interrogatoire clandestin</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertInterrogation</IRI>
    <Literal xml:lang="EN">Covert Interrogation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertInterrogation</IRI>
    <Literal xml:lang="FR">Vous menez un interrogatoire sans révéler vos intentions ni votre identité, en engageant la personne dans une conversation détendue pour obtenir des informations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertInterrogation</IRI>
    <Literal xml:lang="EN">Conducting an interrogation without disclosing one's intentions or identity, engaging the person in relaxed conversation to extract information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertInterrogation</IRI>
    <Literal xml:lang="FR">Alors, comment va le travail ces jours-ci ? J’ai entendu dire que votre entreprise travaille sur un projet passionnant. Vous pouvez m’en dire plus ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertInterrogation</IRI>
    <Literal xml:lang="EN">So, how's work going these days? I heard your company is working on an exciting project. Can you tell me more about it?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertInterrogation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Covert_interrogation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertInterrogation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertInterrogation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitingForTruth</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitingForTruth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitingForTruth</IRI>
    <Literal xml:lang="FR">Prêcher le faux pour savoir le vrai</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitingForTruth</IRI>
    <Literal xml:lang="EN">Baiting for Truth</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitingForTruth</IRI>
    <Literal xml:lang="FR">Vous faites de fausses affirmations ou posez des questions trompeuses afin d’observer les réactions et de déceler la vérité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitingForTruth</IRI>
    <Literal xml:lang="EN">Making false statements or asking misleading questions in order to observe reactions and uncover the truth.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitingForTruth</IRI>
    <Literal xml:lang="FR">Je sais que votre collègue a parlé de nos plans à la concurrence. Que pensez-vous de son attitude ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitingForTruth</IRI>
    <Literal xml:lang="EN">I heard that your teammate discussed our strategy with our competitors. What's your take on their behavior?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitingForTruth</IRI>
    <Literal xml:lang="FR">https://fr.wiktionary.org/wiki/pr%C3%AAcher_le_faux_pour_savoir_le_vrai</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitingForTruth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitingForTruth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackPropaganda</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polytely</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polytely</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polytely</IRI>
    <Literal xml:lang="FR">Polytélie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polytely</IRI>
    <Literal xml:lang="EN">Polytely</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polytely</IRI>
    <Literal xml:lang="FR">Vous présentez un problème qui sert plusieurs objectifs, ce qui rend la solution ambiguë.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polytely</IRI>
    <Literal xml:lang="EN">Raising an issue that serves multiple objectives, making the solution ambiguous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polytely</IRI>
    <Literal xml:lang="FR">Nous devons réformer notre système éducatif pour améliorer l’économie et renforcer les valeurs morales de notre société.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polytely</IRI>
    <Literal xml:lang="EN">We need to reform our educational system to improve the economy and strengthen the moral values of our society.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polytely</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Polytely</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polytely</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#polytely</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeAmbiguity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <Literal xml:lang="FR">Tricherie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <Literal xml:lang="EN">Cheating</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <Literal xml:lang="FR">Vous vous affranchissez des règles tacites qui régissent un débat rationnel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <Literal xml:lang="EN">Violating the norms of rational debate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <Literal xml:lang="FR"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <Literal xml:lang="EN"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cheating</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Tricherie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <Literal xml:lang="FR">Présentation trompeuse des faits</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <Literal xml:lang="EN">Misleading presentation of facts</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <Literal xml:lang="FR">Vous présentez les faits ou les événements d’une manière susceptible d’induire en erreur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <Literal xml:lang="EN">Presenting events or facts in a misleading light.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <Literal xml:lang="FR">Je ne suis pas responsable de votre décision : je vous ai dit que le produit avait réussi certains tests, mais j’ai omis de préciser qu’il en avait échoué d’autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <Literal xml:lang="EN">I am not responsible for your decision: I told you the product had passed certain tests, but I omitted to mention that it had failed others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/241/Spin-Doctoring</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <Literal xml:lang="FR">Mensonge</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <Literal xml:lang="EN">Lying</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <Literal xml:lang="FR">Vous affirmez quelque chose que vous savez faux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <Literal xml:lang="EN">Stating something known to be false.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <Literal xml:lang="FR">Le Père Noël vous surveille, alors comportez-vous bien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <Literal xml:lang="EN">Santa Claus is watching you, so behave.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Lie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Mensonge</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <Literal xml:lang="FR">Semi-vérité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <Literal xml:lang="EN">Half-truth</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <Literal xml:lang="FR">Vous mélangez des informations vraies et fausses afin de déformer la réalité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <Literal xml:lang="EN">Mixing true and false information to distort reality.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <Literal xml:lang="FR">Il est vrai que notre produit a connu quelques problèmes mineurs, mais rappelons qu’il est le plus innovant du marché et que la concurrence reste loin derrière.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <Literal xml:lang="EN">It's true that our product had some minor issues, but it's important to remember that it's the most innovative on the market and the competition is far behind.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Half-truth</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <Literal xml:lang="FR">Déformation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <Literal xml:lang="EN">Misrepresentation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <Literal xml:lang="FR">Vous présentez une situation ou un point de vue de manière inexacte afin d’induire en erreur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <Literal xml:lang="EN">Misrepresenting a situation or an opponent's position in such a way as to distort understanding.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <Literal xml:lang="FR">Ils ont remplacé l’expression « réchauffement climatique » par « changement climatique » parce que, selon eux, le réchauffement de la planète s’est arrêté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <Literal xml:lang="EN">They replaced the expression “global warming” with “climate change” because, according to them, global warming has stopped.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <Literal xml:lang="EN">https://www.climatechangecommunication.org/wp-content/uploads/2020/11/Cook_2020_deconstructing_denial.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <Literal xml:lang="FR">https://vert.eco/wp-content/uploads/2022/04/techniques-du-deni-scientifique.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="FR">Minimisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="EN">Minimisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="FR">Vous atténuez intentionnellement certains éléments de vérité, l’importance des problèmes ou les sentiments d’autrui afin de réduire leur impact ou de détourner la responsabilité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="EN">Intentionally diminishing elements of the truth, the importance of another's issues or feelings, to minimize their impact or to deflect responsibility.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="FR">Ce n’est pas si grave, tout le monde fait des erreurs et ça ne va rien changer. Pas la peine d’en faire tout un plat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="EN">It's not that bad, everyone makes mistakes and it's not going to change anything. No need to make a mountain out of a molehill.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Minimisation_(psychology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="FR">Exagération</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="EN">Exaggeration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="FR">Vous accentuez certains aspects de manière démesurée pour renforcer votre argumentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="EN">Amplifying certain aspects excessively to strengthen one's argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="FR">Cette situation est absolument catastrophique ! Si nous ne réagissons pas immédiatement, tout sera perdu !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="EN">This situation is an absolute disaster! If we don't act immediately, everything will be lost!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Exaggeration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="FR">Homme de paille</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="EN">Straw man</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="FR">Vous caricaturez l’argument de l’autre pour pouvoir le réfuter plus facilement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="EN">Caricaturing the other person's argument so it can be refuted more easily.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="FR">Ah, donc selon vous, nous devrions passer toutes nos journées à fouiller dans les poubelles pour trier les déchets ? Ce n’est pas une vie !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="EN">So, you're suggesting we should dedicate all our days to digging through trash to sort out recycling? That's no way to live!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Straw_man</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/%C3%89pouvantail_(rh%C3%A9torique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="FR">Amplification et minimisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="EN">Magnification and minimization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="FR">Vous exagérez l’importance des problèmes ou minimisez celle de vos réussites.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="EN">Exaggerating the importance of problems or minimizing the importance of one's successes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="FR">Mon succès dans ce projet n’est pas si important, et puis ce que vous appelez échec mineur est pour moi un désastre total.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="EN">My success in this project isn't very significant, and what you might call a minor failure, I view as a complete disaster.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Magnification_and_minimization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#Amplification_et_minimisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misrepresentation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outdatedInformation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outdatedInformation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outdatedInformation</IRI>
    <Literal xml:lang="FR">Information obsolète</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outdatedInformation</IRI>
    <Literal xml:lang="EN">Outdated information</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outdatedInformation</IRI>
    <Literal xml:lang="FR">Vous vous appuyez sur des données dépassées pour étayer vos arguments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outdatedInformation</IRI>
    <Literal xml:lang="EN">Relying on outdated data that is no longer current to support one's arguments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outdatedInformation</IRI>
    <Literal xml:lang="FR">Selon une étude de 1998, cette méthode est la meilleure.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outdatedInformation</IRI>
    <Literal xml:lang="EN">According to a 1998 study, this method is the best.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outdatedInformation</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#outdated</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outdatedInformation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outdatedInformation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <Literal xml:lang="FR">Fraude pieuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <Literal xml:lang="EN">Pious fraud</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <Literal xml:lang="FR">Vous recourez délibérément à la tromperie en affirmant que la fin justifie les moyens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <Literal xml:lang="EN">Intentionally resorting to deception by claiming that the end justifies the means.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <Literal xml:lang="FR">Les négociations étaient complexes, mais nous avons finalement trouvé un terrain d’entente bénéfique pour tous, même si cela nous a obligés à prendre quelques engagements que nous ne comptons pas respecter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <Literal xml:lang="EN">The negotiations were complex, but we finally agreed on a mutual beneficial arrangement, even if it involved making some commitments we won't keep.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pious_fraud</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <Literal xml:lang="FR">http://www.don-lindsay-archive.org/skeptic/arguments.html#pious_fraud</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politeLie</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politeLie</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politeLie</IRI>
    <Literal xml:lang="FR">Mensonge poli</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politeLie</IRI>
    <Literal xml:lang="EN">Polite lie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politeLie</IRI>
    <Literal xml:lang="FR">Vous prononcez sciemment un mensonge pour éviter de vexer ou de contrarier votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politeLie</IRI>
    <Literal xml:lang="EN">Deliberately telling an untruth to avoid upsetting or offending someone.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politeLie</IRI>
    <Literal xml:lang="FR">Vous vous êtes bien battus et vous n’avez pas démérité. Prenez donc maintenant un repos bien mérité et laissez notre équipe de professionnels terminer le travail.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politeLie</IRI>
    <Literal xml:lang="EN">You fought well and did not disgrace yourselves. Now take a well-earned rest and let our team of professionals finish the job.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politeLie</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Lie#Polite_lie_and_butler_lie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politeLie</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politeLie</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nobleLie</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nobleLie</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nobleLie</IRI>
    <Literal xml:lang="FR">Pour la bonne cause</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nobleLie</IRI>
    <Literal xml:lang="EN">Noble lie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nobleLie</IRI>
    <Literal xml:lang="FR">Vous défendez des idées erronées en pensant qu’elles souderont le groupe autour d’une cause commune.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nobleLie</IRI>
    <Literal xml:lang="EN">Defending incorrect ideas believing they will unite the group around a common cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nobleLie</IRI>
    <Literal xml:lang="FR">Si vous êtes sage, le père Noël vous apportera plein de cadeaux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nobleLie</IRI>
    <Literal xml:lang="EN">If you're good, Santa Claus will bring you lots of presents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nobleLie</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Noble_lie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nobleLie</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nobleLie</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="FR">Restriction mentale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="EN">Mental reservation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="FR">Vous omettez de dire ce que vous pensez vraiment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="EN">Failing to say what one really thinks.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="FR">C’est une option à laquelle je n’aurais certainement pas pensé, mais vous êtes libre de la proposer...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="EN">That's definitely an option I hadn't considered, yet you're free to suggest it...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Mental_reservation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Restriction_mentale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#piousFraud</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#economicalWithTheTruth</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#economicalWithTheTruth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#economicalWithTheTruth</IRI>
    <Literal xml:lang="FR">Ne pas en dire trop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#economicalWithTheTruth</IRI>
    <Literal xml:lang="EN">Economical with the truth</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#economicalWithTheTruth</IRI>
    <Literal xml:lang="FR">Votre argument vise à révéler le moins possible de vérité, sans pour autant être un mensonge.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#economicalWithTheTruth</IRI>
    <Literal xml:lang="EN">Using an argument designed to reveal as little of the truth as possible without being a lie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#economicalWithTheTruth</IRI>
    <Literal xml:lang="FR">Je prends note de votre accusation, et je peux simplement vous dire que l’entreprise a respecté toutes les régulations environnementales en vigueur cette année.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#economicalWithTheTruth</IRI>
    <Literal xml:lang="EN">I've heard your accusation, and I can inform you that the company has complied with all the relevant environmental regulations this year.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#economicalWithTheTruth</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Economical_with_the_truth</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#economicalWithTheTruth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#economicalWithTheTruth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingByOmission</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingByOmission</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingByOmission</IRI>
    <Literal xml:lang="FR">Mensonge par omission</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingByOmission</IRI>
    <Literal xml:lang="EN">Lying by omission</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingByOmission</IRI>
    <Literal xml:lang="FR">Votre argument omet des faits nécessaires à sa validité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingByOmission</IRI>
    <Literal xml:lang="EN">Omitting facts necessary for an argument to be valid.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingByOmission</IRI>
    <Literal xml:lang="FR">Je voudrais souligner les économies exceptionnelles qui seront réalisées grâce à ce plan de restructuration de notre service, et qui bénéficieront à tous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingByOmission</IRI>
    <Literal xml:lang="EN">I would like to highlight the exceptional savings that will be made through this restructuring plan of our department, which will benefit everyone.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingByOmission</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Lie#Types_and_associated_terms</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingByOmission</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Mensonge#Cas_du_mensonge_par_omission</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingByOmission</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lyingByOmission</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalReservation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePremise</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePremise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePremise</IRI>
    <Literal xml:lang="FR">Prémisse fausse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePremise</IRI>
    <Literal xml:lang="EN">False premise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePremise</IRI>
    <Literal xml:lang="FR">Vous partez d’une base erronée pour construire votre raisonnement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePremise</IRI>
    <Literal xml:lang="EN">Starting with a flawed foundation to build an argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePremise</IRI>
    <Literal xml:lang="FR">Si nous partons du principe que nos ressources sont quasiment illimitées, alors notre modèle de consommation actuel est parfaitement viable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePremise</IRI>
    <Literal xml:lang="EN">If we assume that the resources we will have are nearly limitless, then our current consumption model is perfectly sustainable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePremise</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/False_premise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePremise</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Prémisse_fausse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePremise</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsePremise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEffect</IRI>
    <Literal xml:lang="FR">Faux effet</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEffect</IRI>
    <Literal xml:lang="EN">False effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEffect</IRI>
    <Literal xml:lang="FR">Vous affirmez à tort que certaines conséquences découlent directement de vos prémisses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEffect</IRI>
    <Literal xml:lang="EN">To falsely claim that certain consequences directly follow from one's premises.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEffect</IRI>
    <Literal xml:lang="FR">Le fait que la grippe ait épargné toute notre famille cette année prouve l’efficacité de mon remède maison, même si la science ne le confirme pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEffect</IRI>
    <Literal xml:lang="EN">The fact that the flu spared our family this year proves the effectiveness of my homemade remedy, even though science doesn't acknowledge it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEffect</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/95/False-Effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedHangout</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedHangout</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedHangout</IRI>
    <Literal xml:lang="FR">Limitation des dommages</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedHangout</IRI>
    <Literal xml:lang="EN">Limited hangout</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedHangout</IRI>
    <Literal xml:lang="FR">Vous admettez certaines vérités tout en en niant d’autres, afin de limiter les dommages causés à votre argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedHangout</IRI>
    <Literal xml:lang="EN">Acknowledging certain truths while denying others to minimize damage to an argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedHangout</IRI>
    <Literal xml:lang="FR">Je reconnais qu’il y a eu quelques petits problèmes avec notre dernier produit, mais laissons ces détails de côté et concentrons-nous sur nos succès passés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedHangout</IRI>
    <Literal xml:lang="EN">I admit there were a few minor issues with our latest product, but let's forget these details and focus on our past successes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedHangout</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Limited_hangout</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedHangout</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#limitedHangout</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseMemory</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseMemory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseMemory</IRI>
    <Literal xml:lang="FR">Faux souvenir</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseMemory</IRI>
    <Literal xml:lang="EN">False memory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseMemory</IRI>
    <Literal xml:lang="FR">Vous fondez votre argument sur de prétendus souvenirs qui sont en réalité erronés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseMemory</IRI>
    <Literal xml:lang="EN">Basing an argument on alleged memories that are actually incorrect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseMemory</IRI>
    <Literal xml:lang="FR">Je me souviens clairement que vous aviez dit que nous pourrions changer d’avis plus tard.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseMemory</IRI>
    <Literal xml:lang="EN">I clearly remember you saying that we could change our minds later on.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseMemory</IRI>
    <Literal xml:lang="EN">http://skepdic.com/falsememory.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseMemory</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseMemory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#halftruth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confabulation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confabulation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confabulation</IRI>
    <Literal xml:lang="FR">Confabulation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confabulation</IRI>
    <Literal xml:lang="EN">Confabulation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confabulation</IRI>
    <Literal xml:lang="FR">Vous inventez des éléments au fil de votre argumentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confabulation</IRI>
    <Literal xml:lang="EN">Inventing stories as an argument progresses, often to fill gaps in evidence or reasoning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confabulation</IRI>
    <Literal xml:lang="FR">Je me souviens clairement avoir lu une étude qui prouve ce point. Je vous retrouverai la référence ; le reste de mon argument en découle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confabulation</IRI>
    <Literal xml:lang="EN">I clearly recall reading a study that supports your point; I'll find the reference for you. My argument builds from there.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confabulation</IRI>
    <Literal xml:lang="EN">http://skepdic.com/confab.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseMemory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confabulation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confabulation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseMemory</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <Literal xml:lang="FR">Factoïde</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <Literal xml:lang="EN">Factoid</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <Literal xml:lang="FR">Vous vous appuyez sur des faits largement acceptés mais inexacts pour soutenir vos dires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <Literal xml:lang="EN">Relying on widely accepted but inaccurate facts to support one's claims.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <Literal xml:lang="FR">On sait tous que les pyramides ont été construites par des esclaves. — Largement cru, historiquement faux : les travailleurs de Gizeh étaient des ouvriers rémunérés, logés et nourris sur le site.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <Literal xml:lang="EN">We all know that the pyramids were built by slaves. — Widely believed, but historically false: the workers at Giza were paid laborers who were housed and fed on site.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Factoid</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <Literal xml:lang="FR">Désinformation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <Literal xml:lang="EN">Disinformation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <Literal xml:lang="FR">Vous diffusez sciemment une information incorrecte pour induire votre interlocuteur en erreur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <Literal xml:lang="EN">Knowingly spreading incorrect information to mislead an interlocutor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <Literal xml:lang="FR">J’ai lu quelque part que cette technologie avait été totalement discréditée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <Literal xml:lang="EN">I've read somewhere that this technology has been completely discredited.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Disinformation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Désinformation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeNews</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeNews</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeNews</IRI>
    <Literal xml:lang="FR">Fake news</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeNews</IRI>
    <Literal xml:lang="EN">Fake News</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeNews</IRI>
    <Literal xml:lang="FR">Votre argument s’appuie sur de fausses informations sciemment présentées comme des actualités.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeNews</IRI>
    <Literal xml:lang="EN">Relying on false information knowingly presented as news.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeNews</IRI>
    <Literal xml:lang="FR">Je viens de lire un article affirmant que le gouvernement va augmenter les impôts de 50 % l’année prochaine pour tous les citoyens. C’est scandaleux, et nous devons agir immédiatement pour l’empêcher.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeNews</IRI>
    <Literal xml:lang="EN">I just read an article claiming that taxes will increase by 50% next year for all citizens. It's outrageous, and we need to act immediately to prevent it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeNews</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fake_news</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeNews</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Fake_news</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeNews</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeNews</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#echoChamber</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#echoChamber</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#echoChamber</IRI>
    <Literal xml:lang="FR">Chambre d’écho</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#echoChamber</IRI>
    <Literal xml:lang="EN">Echo chamber</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#echoChamber</IRI>
    <Literal xml:lang="FR">Vous présentez votre argument en vous appuyant sur des opinions qui circulent sans être remises en question.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#echoChamber</IRI>
    <Literal xml:lang="EN">Presenting an argument by relying on opinions that circulate without being questioned.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#echoChamber</IRI>
    <Literal xml:lang="FR">Pour perdre du poids, il faut supprimer ces cinq aliments de votre alimentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#echoChamber</IRI>
    <Literal xml:lang="EN">To lose weight, you must eliminate these 5 foods from your diet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#echoChamber</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Echo_chamber_(media)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#echoChamber</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Chambre_d'écho_(médias)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#echoChamber</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#echoChamber</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#astroturfing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#astroturfing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#astroturfing</IRI>
    <Literal xml:lang="FR">Astroturfing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#astroturfing</IRI>
    <Literal xml:lang="EN">Astroturfing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#astroturfing</IRI>
    <Literal xml:lang="FR">Vous créez l’illusion d’un mouvement populaire ou d’une opinion largement partagée pour renforcer votre position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#astroturfing</IRI>
    <Literal xml:lang="EN">Creating the illusion of a popular movement or widespread opinion to strengthen one's position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#astroturfing</IRI>
    <Literal xml:lang="FR">Des milliers de personnes ont exprimé leur soutien à notre cause sur les réseaux sociaux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#astroturfing</IRI>
    <Literal xml:lang="EN">Thousands of people have expressed their support for our cause on social media.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#astroturfing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Astroturfing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#astroturfing</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Astroturfing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#astroturfing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#astroturfing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#canard</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#canard</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#canard</IRI>
    <Literal xml:lang="FR">Canard</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#canard</IRI>
    <Literal xml:lang="EN">Canard</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#canard</IRI>
    <Literal xml:lang="FR">Vous vous appuyez sur une histoire non vérifiée pour justifier une affirmation sans fondement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#canard</IRI>
    <Literal xml:lang="EN">Relying on an unverified story to justify an unfounded claim.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#canard</IRI>
    <Literal xml:lang="FR">Il y a un article selon lequel notre concurrent prévoit de lancer un produit similaire très bientôt.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#canard</IRI>
    <Literal xml:lang="EN">There's an article suggesting our competitor plans to release a similar product very soon.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#canard</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Canard</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#canard</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#canard</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="FR">Stratégie du chat mort</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="EN">Dead cat strategy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="FR">Vous détournez intentionnellement l’attention des problèmes importants en créant un scandale ou une controverse choquante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="EN">Intentionally diverting attention from significant issues by creating a shocking scandal or controversy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="FR">Mes chers compatriotes, nous allons devoir repousser l’examen de cette loi, car j’ai une nouvelle choquante à partager. Savez-vous qu’un de nos politiciens est impliqué dans un scandale de corruption ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="EN">My dear compatriots, we will have to postpone the examination of this law, because I have some shocking news to share. Do you know that one of our politicians is involved in a corruption scandal?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Dead_cat_strategy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadCatStrategy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="FR">Lance à incendie de mensonges</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="EN">Firehose of falsehood</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="FR">Vous diffusez en masse des messages répétés sur de multiples canaux (médias, réseaux sociaux), sans souci de vérité ni de cohérence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="EN">Mass disseminating repeated messages across multiple channels (media, social networks), without regard for truth or consistency.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="FR">Les canaux officiels du gouvernement, appuyés par une armée de bots et de comptes anonymes en ligne, publient une avalanche de rapports contradictoires sur la situation économique. Chaque version contredit les autres, inondant l’espace d’information et rendant impossible de comprendre la réalité économique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="EN">Government channels, supported by a fleet of online bots and anonymous accounts, publish a flood of contradictory reports on the economic situation, each contradicting the other, flooding the informational space and making it impossible to understand the true economic conditions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Firehose_of_falsehood</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Lance_%C3%A0_incendie_du_mensonge</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disinformation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <Literal xml:lang="FR">Rumeur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <Literal xml:lang="EN">Rumor</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <Literal xml:lang="FR">Vous appuyez votre argument sur une information non vérifiée qui circule de personne en personne.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <Literal xml:lang="EN">Supporting an argument with unverified information that circulates from person to person.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <Literal xml:lang="FR">Tout le monde dit que ce restaurant est le meilleur de la ville.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <Literal xml:lang="EN">Everybody says this restaurant is the best in town.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Rumor</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Rumeur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
    <Literal xml:lang="FR">Campagne de dénigrement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
    <Literal xml:lang="EN">Smear campaign</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
    <Literal xml:lang="FR">Vous diffusez de fausses accusations, des ragots et des calomnies pour nuire à la réputation d’une personne ou d’un groupe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
    <Literal xml:lang="EN">Spreading false or exaggerated accusations, malicious gossip, or slanderous claims about a person or group, intending to damage their reputation or credibility.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
    <Literal xml:lang="FR">Lors d’une campagne politique, un candidat lance une campagne de dénigrement : il utilise les réseaux sociaux pour diffuser des rumeurs sur les prétendues malversations financières et violations éthiques de son adversaire, malgré l’absence de preuves concrètes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
    <Literal xml:lang="EN">During the political race, one candidate launches a smear campaign, using social media to spread rumors about the opponent's alleged financial misconduct and ethical violations, despite lack of concrete evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Smear_campaign</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Campagne_de_d%C3%A9nigrement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="FR">Campagne de murmures</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="EN">Whispering campaign</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="FR">Vous répandez des rumeurs nuisibles ou des insinuations à propos d’une cible, tout en évitant d’être identifié.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="EN">Spreading damaging rumors or innuendo about a target, while avoiding being detected.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="FR">Dans l’entreprise, une campagne de murmures commence contre Martin. Ses collègues répandent anonymement des rumeurs sur son incompétence présumée et son manque d’éthique, créant de la méfiance parmi ses pairs sans confrontation directe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="EN">In the office, a whispering campaign starts against Martin. His colleagues anonymously spread rumors about his alleged incompetence and lack of ethics, causing distrust among his peers without any direct confrontation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Whispering_campaign</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whisperingCampaign</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#smearCampaign</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="FR">Culture de la peur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="EN">Fearmongering</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="FR">Vous répandez des rumeurs effrayantes et exagérées sur un danger imminent afin de susciter délibérément, et sans raison valable, la peur du public au sujet d’une question.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="EN">Spreading frightening and exaggerated rumors about imminent danger to deliberately and unnecessarily instill public fear about an issue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="FR">Savez-vous que l’eau du robinet est très rarement contrôlée et souvent contaminée, contrairement à cette eau minérale ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="EN">Did you know that tap water is very rarely checked and often contaminated, unlike this mineral water?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fearmongering</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Culture_de_la_peur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="FR">Appel au doute et à la crainte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="EN">Fear, uncertainty and doubt</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="FR">Vous diffusez des informations négatives, souvent vagues, pour semer la peur et la méfiance, et rallier le public à votre cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="EN">Disseminating negative information, often vague, to sow fear and mistrust and rally the public to one's cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="FR">J’ai entendu dire que notre concurrent était en grande difficulté. Vu leur situation financière, ce serait un miracle s’ils tenaient jusqu’au printemps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="EN">I heard that our competitor was in serious trouble. Given their financial situation, it would be a miracle if they lasted until spring.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fear,_uncertainty,_and_doubt</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Fear,_uncertainty_and_doubt</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strategyOfTension</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strategyOfTension</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strategyOfTension</IRI>
    <Literal xml:lang="FR">Stratégie de la tension</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strategyOfTension</IRI>
    <Literal xml:lang="EN">Strategy of tension</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strategyOfTension</IRI>
    <Literal xml:lang="FR">Vous créez un climat de tension pour justifier des mesures extrêmes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strategyOfTension</IRI>
    <Literal xml:lang="EN">Creating a climate of tension to justify extreme measures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strategyOfTension</IRI>
    <Literal xml:lang="FR">Vous avez entendu parler des récentes explosions ? Je suis sûr que c’est juste un avant-goût. Ils vont devoir renforcer la sécurité, sinon qui sait ce qui pourrait arriver...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strategyOfTension</IRI>
    <Literal xml:lang="EN">Have you heard about the recent explosions? I'm sure this is just a taste. They're going to have to step up security, otherwise who knows what could happen...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strategyOfTension</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Strategy_of_tension</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strategyOfTension</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Strat%C3%A9gie_de_la_tension</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strategyOfTension</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strategyOfTension</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="FR">Appel à la panique morale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="EN">Moral panic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="FR">Vous suscitez l’indignation en présentant certaines actions comme immorales afin de provoquer une forte réaction émotionnelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="EN">Inciting indignation by portraying certain actions as immoral to provoke a strong emotional reaction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="FR">Cette nouvelle danse qui se répand chez les jeunes est un signe de décadence morale qui mène droit à la dépravation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="EN">This new dance which is spreading among young people is a sign of moral decadence, which leads straight to depravity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Moral_panic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Panique_morale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="FR">Potin</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="EN">Gossip</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="FR">Vous partagez des histoires informelles ou des rumeurs sur la vie personnelle d’autres personnes, souvent non vérifiées et privées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="EN">Sharing informal stories or rumors about other people's private lives, often unverified and private.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="FR">J’ai entendu dire que notre patron part en vacances avec son assistant, c’est intrigant !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="EN">I heard our boss is going on vacation with his assistant, how intriguing!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Gossip</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rumor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="FR">Indiscrétion anonyme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="EN">Blind Item</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="FR">Vous diffusez des rumeurs ou des informations sans nommer les personnes impliquées, souvent pour éviter des répercussions légales.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="EN">Spreading rumors or information without naming the involved parties, often to avoid legal repercussions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="FR">Un célèbre acteur, que je ne nommerai pas, aurait eu une liaison secrète.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="EN">A certain famous actor, who I will not name, is rumored to have had a secret affair.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Blind_item</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blindItem</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <Literal xml:lang="FR">Mythe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <Literal xml:lang="EN">Myth</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <Literal xml:lang="FR">Vous appuyez votre argument sur un récit faux ou douteux présenté comme une histoire fondatrice ou porteuse de sens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <Literal xml:lang="EN">You base your argument on a false or dubious narrative presented as a foundational story or as one that conveys meaning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <Literal xml:lang="FR">Il est bien connu que manger des carottes améliore votre vision nocturne.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <Literal xml:lang="EN">It's commonly believed that eating carrots enhances your night vision.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Myth</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Mythe#Le_mythe_comme_croyance_erron.C3.A9e</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#urbanLegend</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#urbanLegend</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#urbanLegend</IRI>
    <Literal xml:lang="FR">Légende urbaine</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#urbanLegend</IRI>
    <Literal xml:lang="EN">Urban legend</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#urbanLegend</IRI>
    <Literal xml:lang="FR">Vous appuyez votre argument sur une histoire dont l’origine est douteuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#urbanLegend</IRI>
    <Literal xml:lang="EN">Basing an argument on a story of dubious origin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#urbanLegend</IRI>
    <Literal xml:lang="FR">Un ami m’a dit qu’il y avait des crocodiles dans les égouts de New York.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#urbanLegend</IRI>
    <Literal xml:lang="EN">A friend told me there are crocodiles in the sewers of New York.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#urbanLegend</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Urban_legends_and_myths</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#urbanLegend</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Légende_urbaine</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#urbanLegend</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#urbanLegend</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#creepypasta</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#creepypasta</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#creepypasta</IRI>
    <Literal xml:lang="FR">Creepypasta</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#creepypasta</IRI>
    <Literal xml:lang="EN">Creepypasta</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#creepypasta</IRI>
    <Literal xml:lang="FR">Vous appuyez votre argument sur une histoire d’origine douteuse destinée à faire peur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#creepypasta</IRI>
    <Literal xml:lang="EN">Basing an argument on a scare-inducing narrative of questionable origin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#creepypasta</IRI>
    <Literal xml:lang="FR">C’est à ce tournant que j’ai vu la Dame Blanche.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#creepypasta</IRI>
    <Literal xml:lang="EN">It was at that turn that I saw the White Lady.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#creepypasta</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Creepypasta</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#creepypasta</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Creepypasta</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#creepypasta</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#creepypasta</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flyingCarpet</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flyingCarpet</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flyingCarpet</IRI>
    <Literal xml:lang="FR">Tapis volant</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flyingCarpet</IRI>
    <Literal xml:lang="EN">Flying Carpet</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flyingCarpet</IRI>
    <Literal xml:lang="FR">Vous appuyez votre argument sur un récit stéréotypé hostile envers une religion ou une culture.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flyingCarpet</IRI>
    <Literal xml:lang="EN">Basing an argument on a hostile stereotyped narrative about a religion or culture.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flyingCarpet</IRI>
    <Literal xml:lang="FR">Vous ne pouvez pas vous dire musulmane et féministe. La véritable représentation de l’islam consiste à tuer les infidèles et à opprimer les femmes. Il suffit de regarder le Moyen-Orient.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flyingCarpet</IRI>
    <Literal xml:lang="EN">You cannot call yourself Muslim and feminist. The true representation of Islam consists in killing infidels and oppressing women. Just look at the Middle East.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flyingCarpet</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Flying_carpet_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flyingCarpet</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flyingCarpet</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#myth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meme</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meme</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meme</IRI>
    <Literal xml:lang="FR">Mème</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meme</IRI>
    <Literal xml:lang="EN">Meme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meme</IRI>
    <Literal xml:lang="FR">Vous fondez votre argumentation sur des éléments culturels populaires sans tenir compte de leur véracité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meme</IRI>
    <Literal xml:lang="EN">Basing an argument on popular cultural elements without regard for their truthfulness.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meme</IRI>
    <Literal xml:lang="FR">Ce mème viral sur le réchauffement climatique est hilarant ; le changement climatique ne peut donc pas être si grave, n’est-ce pas ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meme</IRI>
    <Literal xml:lang="EN">That viral meme on global warming is hilarious, so climate change can't be that serious, right?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meme</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Meme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meme</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Mème</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#meme</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#factoid</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <Literal xml:lang="FR">Imposture</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <Literal xml:lang="EN">Imposture</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <Literal xml:lang="FR">Vous vous faites passer pour ce que vous n’êtes pas (expertise, identité, expérience) afin de renforcer votre argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <Literal xml:lang="EN">Passing oneself off as something one is not (expertise, identity, experience) in order to strengthen an argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <Literal xml:lang="FR">Je suis serrurier certifié… Vous pouvez donc me confier vos clés en toute confiance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <Literal xml:lang="EN">I am a certified locksmith… So you can trust me with your keys with complete confidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Deception</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Imposture</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lying</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsism</IRI>
    <Literal xml:lang="FR">Contre-vérité ironique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsism</IRI>
    <Literal xml:lang="EN">Falsism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsism</IRI>
    <Literal xml:lang="FR">Vous énoncez une contre-vérité pour faire comprendre ou suggérer le contraire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsism</IRI>
    <Literal xml:lang="EN">Stating a falsehood to convey or suggest the opposite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsism</IRI>
    <Literal xml:lang="FR">Évidemment, si nous interprétons les données de cette manière, elles semblent contredire ce que tout le monde sait être vrai.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsism</IRI>
    <Literal xml:lang="EN">Of course, if we interpret the data this way, it seems to indicate the opposite of what everyone believes to be true.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsism</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/falsism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falsism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hoax</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hoax</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hoax</IRI>
    <Literal xml:lang="FR">Canular</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hoax</IRI>
    <Literal xml:lang="EN">Hoax</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hoax</IRI>
    <Literal xml:lang="FR">Votre argument vise à tromper votre interlocuteur afin de vous moquer de lui ou de le faire réagir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hoax</IRI>
    <Literal xml:lang="EN">Using an argument to deceive an opponent in order to mock them or provoke a reaction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hoax</IRI>
    <Literal xml:lang="FR">Je viens d’entendre que notre entreprise va être rachetée par une célèbre multinationale du jeu vidéo. Elle prévoit de transformer nos bureaux en parc à thème interactif. Incroyable, non ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hoax</IRI>
    <Literal xml:lang="EN">I just heard that our company is going to be acquired by a famous multinational in the videogame industry. They're planning to turn our offices into an interactive theme park. Incredible, isn't it?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hoax</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hoax</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hoax</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Canular</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hoax</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hoax</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bullshit</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bullshit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bullshit</IRI>
    <Literal xml:lang="FR">Foutaise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bullshit</IRI>
    <Literal xml:lang="EN">Bullshit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bullshit</IRI>
    <Literal xml:lang="FR">Vous tenez des propos manifestement mensongers dans le seul but d’obtenir l’adhésion de votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bullshit</IRI>
    <Literal xml:lang="EN">Making blatantly false statements aimed solely at gaining an audience's approval.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bullshit</IRI>
    <Literal xml:lang="FR">Si vous me confiez les rênes de notre pays, je mettrai un terme définitif à cette corruption endémique dès le premier mois de mon mandat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bullshit</IRI>
    <Literal xml:lang="EN">If you entrust me with the reins of our country, I will put an end to all this endemic corruption within the first month of my term.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bullshit</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Bullshit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bullshit</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bullshit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fib</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fib</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fib</IRI>
    <Literal xml:lang="FR">Bobard</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fib</IRI>
    <Literal xml:lang="EN">Fib</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fib</IRI>
    <Literal xml:lang="FR">Votre argument vise à justifier une bêtise facilement pardonnable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fib</IRI>
    <Literal xml:lang="EN">Using an argument to justify a minor, easily forgivable mistake.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fib</IRI>
    <Literal xml:lang="FR">C’est le chien qui a fait tomber le vase.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fib</IRI>
    <Literal xml:lang="EN">It was the dog that knocked over the vase.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fib</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Lie#Fib</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fib</IRI>
    <Literal xml:lang="FR">https://fr.wiktionary.org/wiki/bobard</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bullshit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fib</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fib</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bullshit</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
    <Literal xml:lang="FR">Vendre des vessies pour des lanternes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
    <Literal xml:lang="EN">Selling snake oil</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
    <Literal xml:lang="FR">Vous faites croire à une promesse ou une valeur sans aucun fondement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
    <Literal xml:lang="EN">Making people believe in a promise or value with no foundation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
    <Literal xml:lang="FR">Ce logiciel va révolutionner votre manière de travailler : doublez votre productivité en moins d’une semaine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
    <Literal xml:lang="EN">This software will revolutionize the way you work: double your productivity in less than a week.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/hoodwink</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
    <Literal xml:lang="FR">https://www.projet-voltaire.fr/origines/expression-prendre-des-vessies-pour-des-lanternes/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#puffery</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#puffery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#puffery</IRI>
    <Literal xml:lang="FR">Poudre aux yeux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#puffery</IRI>
    <Literal xml:lang="EN">Puffery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#puffery</IRI>
    <Literal xml:lang="FR">Votre argument vise à impressionner de manière subjective plutôt qu’objective.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#puffery</IRI>
    <Literal xml:lang="EN">Using an argument to impress in a more subjective than objective manner.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#puffery</IRI>
    <Literal xml:lang="FR">Notre service est le plus extraordinaire que vous puissiez trouver !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#puffery</IRI>
    <Literal xml:lang="EN">Our service is the most extraordinary one you can find!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#puffery</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Puffery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#puffery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#puffery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sellingSnakeOil</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fabrication</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fabrication</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fabrication</IRI>
    <Literal xml:lang="FR">Fabrication</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fabrication</IRI>
    <Literal xml:lang="EN">Fabrication</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fabrication</IRI>
    <Literal xml:lang="FR">Vous inventez, au fil de la discussion, des raisons pour soutenir votre conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fabrication</IRI>
    <Literal xml:lang="EN">You invent reasons as the discussion unfolds to support your conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fabrication</IRI>
    <Literal xml:lang="FR">Nous savons qu’il y a des armes de destruction massive dans ce pays : plusieurs rapports confidentiels le confirment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fabrication</IRI>
    <Literal xml:lang="EN">We know there are weapons of mass destruction in this country: several confidential reports confirm it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fabrication</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fabrication_(science)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fabrication</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fabrication</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#forgery</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#forgery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#forgery</IRI>
    <Literal xml:lang="FR">Falsification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#forgery</IRI>
    <Literal xml:lang="EN">Forgery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#forgery</IRI>
    <Literal xml:lang="FR">Vous modifiez, au cours de la discussion, les raisons ou les faits afin de préserver votre conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#forgery</IRI>
    <Literal xml:lang="EN">You modify the reasons or facts during the discussion in order to preserve your conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#forgery</IRI>
    <Literal xml:lang="FR">Après réévaluation, nos résultats montrent une performance supérieure à celle que nous avions annoncée initialement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#forgery</IRI>
    <Literal xml:lang="EN">Following a reevaluation, our results now show a performance superior to that initially announced.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#forgery</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Forgery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#forgery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#forgery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coverup</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coverup</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coverup</IRI>
    <Literal xml:lang="FR">Étouffer l’affaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coverup</IRI>
    <Literal xml:lang="EN">Cover-up</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coverup</IRI>
    <Literal xml:lang="FR">Vous dissimulez progressivement des faits ou des raisons afin d’éviter qu’ils soient examinés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coverup</IRI>
    <Literal xml:lang="EN">You progressively conceal facts or reasons to prevent them from being examined.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coverup</IRI>
    <Literal xml:lang="FR">Il n’est pas nécessaire de discuter de cette erreur ; concentrons-nous plutôt sur le succès.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coverup</IRI>
    <Literal xml:lang="EN">There's no need to discuss this mistake, let's focus on the success.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coverup</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cover-up</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coverup</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coverup</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perjury</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perjury</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perjury</IRI>
    <Literal xml:lang="FR">Parjure</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perjury</IRI>
    <Literal xml:lang="EN">Perjury</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perjury</IRI>
    <Literal xml:lang="FR">Votre argument viole un serment que vous avez fait face à une autorité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perjury</IRI>
    <Literal xml:lang="EN">Violating an oath made to an authority.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perjury</IRI>
    <Literal xml:lang="FR">Mon témoignage reflète ma compréhension des faits au moment des événements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perjury</IRI>
    <Literal xml:lang="EN">My testimony represents my understanding of the facts at the time of the events.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perjury</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Perjury</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perjury</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Parjure</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perjury</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perjury</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathologicalLying</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathologicalLying</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathologicalLying</IRI>
    <Literal xml:lang="FR">Mythomanie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathologicalLying</IRI>
    <Literal xml:lang="EN">Pathological lying</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathologicalLying</IRI>
    <Literal xml:lang="FR">Votre argument s’appuie sur une compulsion au mensonge.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathologicalLying</IRI>
    <Literal xml:lang="EN">Relying on a compulsion to lie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathologicalLying</IRI>
    <Literal xml:lang="FR">Mais Monsieur l’agent, je vous assure que mon chien l’a mangé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathologicalLying</IRI>
    <Literal xml:lang="EN">But officer, I swear my dog ate it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathologicalLying</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pathological_lying</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathologicalLying</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Mythomanie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathologicalLying</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pathologicalLying</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#imposture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
    <Literal xml:lang="FR">Fausse attribution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
    <Literal xml:lang="EN">False attribution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
    <Literal xml:lang="FR">Vous donnez du poids à votre argument en citant une source fausse, mal identifiée, incompétente ou inventée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
    <Literal xml:lang="EN">Calling upon irrelevant, unqualified, unidentified, biased, or fabricated sources in support of an argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
    <Literal xml:lang="FR">Un « comité scientifique » dont personne ne connaît les membres affirme que cette crème pour les mains est la vraie recette du bonheur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
    <Literal xml:lang="EN">A “scientific committee” whose members no one knows claims that this hand cream is the true recipe for happiness.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/False_attribution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <Literal xml:lang="FR">Décontextualisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <Literal xml:lang="EN">Contextomy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <Literal xml:lang="FR">Vous détournez des citations de leur sens d’origine en les isolant de leur contexte, afin de les faire paraître favorables à votre propos.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <Literal xml:lang="EN">You twist quotations away from their original meaning by isolating them from their context, in order to make them appear to support your argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <Literal xml:lang="FR">— Vous m’avez pourtant dit avoir trouvé ce film éblouissant...
— Éblouissant par sa stupidité !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <Literal xml:lang="EN">- You said you found this movie dazzling.
- Dazzling in its stupidity!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Quoting_out_of_context</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="FR">Accroche</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="EN">Sound bite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="FR">Vous résumez votre propos par une formule courte et marquante, qui retient l’attention mais peut être trompeuse ou réductrice.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="EN">Summarizing an argument with a catchy, attention-grabbing quote that may be misleading or simplistic.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="FR">Vous vous étonnez de ces coupes budgétaires, pourtant nos concitoyens ont exigé que le gouvernement enclenche le tournant de l’offre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="EN">You are surprised by these budget cuts, yet our fellow citizens demanded that the government initiate a supply-side shift.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sound_bite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quoteMining</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quoteMining</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quoteMining</IRI>
    <Literal xml:lang="FR">Extraction de citations</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quoteMining</IRI>
    <Literal xml:lang="EN">Quote mining</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quoteMining</IRI>
    <Literal xml:lang="FR">Vous choisissez des citations hors contexte pour donner l’impression qu’elles correspondent à votre point de vue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quoteMining</IRI>
    <Literal xml:lang="EN">Choosing quotes out of context to make them seem to support one's viewpoint.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quoteMining</IRI>
    <Literal xml:lang="FR">Vous avez clairement dit : ’Il faut parfois accepter des compromis.’ Alors, comment pouvez-vous maintenant vous opposer à cette nouvelle stratégie de l’entreprise ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quoteMining</IRI>
    <Literal xml:lang="EN">You clearly said: "Sometimes compromises have to be made." So, how can you now oppose this new corporate strategy?'</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quoteMining</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Quotemining</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quoteMining</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quoteMining</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#literalism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#literalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#literalism</IRI>
    <Literal xml:lang="FR">Litéralisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#literalism</IRI>
    <Literal xml:lang="EN">Literalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#literalism</IRI>
    <Literal xml:lang="FR">Vous interprétez les mots de façon trop littérale, en ignorant les sous-entendus ou le contexte global.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#literalism</IRI>
    <Literal xml:lang="EN">Interpreting words too literally, disregarding implications or the larger context.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#literalism</IRI>
    <Literal xml:lang="FR">Vous avez écrit dans votre email ’il faudra geler tous les projets en cours’. J’ai donc demandé à tout le personnel d’arrêter immédiatement de travailler, conformément à vos instructions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#literalism</IRI>
    <Literal xml:lang="EN">You wrote in your email "Freeze all ongoing projects." So, I instructed the staff to stop working immediately.'</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#literalism</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/literalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#literalism</IRI>
    <Literal xml:lang="FR">http://www.cs.oswego.edu/~blue/xhx/books/semiotics/glossaryL/section31/main.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#literalism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#literalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudohistory</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudohistory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudohistory</IRI>
    <Literal xml:lang="FR">Pseudohistoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudohistory</IRI>
    <Literal xml:lang="EN">Pseudohistory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudohistory</IRI>
    <Literal xml:lang="FR">Vous présentez des versions biaisées d’événements historiques afin qu’elles concordent avec vos convictions, au mépris des faits établis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudohistory</IRI>
    <Literal xml:lang="EN">Presenting biased versions of historical events to align with one's beliefs, regardless of established facts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudohistory</IRI>
    <Literal xml:lang="FR">L’or au sommet des pyramides est le meilleur conducteur d’électricité. Les Égyptiens s’en servaient dans leurs constructions : cela a été démontré, et cela prouve que nous n’avons rien inventé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudohistory</IRI>
    <Literal xml:lang="EN">Gold on top of pyramids is the best conductor for electricity, used in their constructions; this proves we haven't invented anything new.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudohistory</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pseudohistory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudohistory</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pseudohistoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudohistory</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudohistory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextomy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
    <Literal xml:lang="FR">Référencement circulaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
    <Literal xml:lang="EN">Circular reporting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
    <Literal xml:lang="FR">Vous vous appuyez sur des sources qui se citent entre elles, sans fondement vérifiable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
    <Literal xml:lang="EN">Relying on sources that do nothing but reference each other, without any verifiable foundation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
    <Literal xml:lang="FR">Tous ces articles évoquent la découverte de l’énergie libre grâce aux travaux d’un scientifique méconnu du XXe siècle. Avec autant de sources concordantes, il doit bien y avoir un fond de vérité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
    <Literal xml:lang="EN">All these articles discuss free energy discovered through the work of an obscure scientist; with so many sources agreeing, there must be some truth to it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Circular_reporting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#citogenesis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#citogenesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#citogenesis</IRI>
    <Literal xml:lang="FR">Citogenèse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#citogenesis</IRI>
    <Literal xml:lang="EN">Citogenesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#citogenesis</IRI>
    <Literal xml:lang="FR">Vous diffusez des citations qui semblent fiables uniquement parce qu’elles sont répétées, créant ainsi une pseudo-crédibilité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#citogenesis</IRI>
    <Literal xml:lang="EN">Spreading quotes that seem valid only because they are repeated, thus creating a pseudo-credibility.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#citogenesis</IRI>
    <Literal xml:lang="FR">Selon un article que j’ai lu sur le blog d’un chercheur indépendant, les canalisations d’eau en cuivre possèdent des propriétés curatives, et cette information vient d’être reprise dans un reportage à la télévision !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#citogenesis</IRI>
    <Literal xml:lang="EN">An article on an independent researcher's blog claims copper water pipes have healing properties, now echoed by a TV report!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#citogenesis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Circular_reporting#History_of_citogenesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#citogenesis</IRI>
    <Literal xml:lang="FR">https://web.archive.org/web/20111118010341/http://xkcd.com/978</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#citogenesis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#citogenesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woozleEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woozleEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woozleEffect</IRI>
    <Literal xml:lang="FR">Effet Woozle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woozleEffect</IRI>
    <Literal xml:lang="EN">Woozle effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woozleEffect</IRI>
    <Literal xml:lang="FR">Vous croyez en l’existence ou en la véracité d’une thèse parce qu’elle est répétée dans les médias ou la littérature, sur la base d’une source à laquelle on attribue à tort cette thèse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woozleEffect</IRI>
    <Literal xml:lang="EN">Believing in the existence or truth of a thesis because of its repetition in the media or literature, based on a source to which the thesis is wrongly attributed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woozleEffect</IRI>
    <Literal xml:lang="FR">Tout le monde parle de cette nouvelle théorie révolutionnaire de la santé, elle doit être vraie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woozleEffect</IRI>
    <Literal xml:lang="EN">Everyone is talking about this revolutionary new health theory, it must be true.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woozleEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Woozle_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woozleEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woozleEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circularReporting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sourcemonitoringError</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sourcemonitoringError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sourcemonitoringError</IRI>
    <Literal xml:lang="FR">Erreur d’identification de la source</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sourcemonitoringError</IRI>
    <Literal xml:lang="EN">Source-monitoring error</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sourcemonitoringError</IRI>
    <Literal xml:lang="FR">Vous attribuez une idée, une information ou un souvenir à une source erronée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sourcemonitoringError</IRI>
    <Literal xml:lang="EN">Confusing the source of information, attributing an idea or memory to the wrong origin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sourcemonitoringError</IRI>
    <Literal xml:lang="FR">J’étais sûr que le professeur Martin avait dit cela en cours, mais cela venait en fait d’un article que j’avais lu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sourcemonitoringError</IRI>
    <Literal xml:lang="EN">I was sure it was Professor Martin who said that in class, but it was actually in an article I read.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sourcemonitoringError</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Source-monitoring_error</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sourcemonitoringError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sourcemonitoringError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseAttribution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cryptomnesia</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cryptomnesia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cryptomnesia</IRI>
    <Literal xml:lang="FR">Cryptomnésie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cryptomnesia</IRI>
    <Literal xml:lang="EN">Cryptomnesia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cryptomnesia</IRI>
    <Literal xml:lang="FR">Vous pensez avoir eu une idée originale alors qu’elle provient en réalité d’une source extérieure oubliée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cryptomnesia</IRI>
    <Literal xml:lang="EN">Thinking one had an original idea when in reality it came from a forgotten outside source.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cryptomnesia</IRI>
    <Literal xml:lang="FR">Je pensais avoir eu cette idée géniale pour un livre, mais je viens de comprendre que c’était l’intrigue d’un film vu il y a longtemps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cryptomnesia</IRI>
    <Literal xml:lang="EN">I thought I had this great idea for a book, but I just realized it was the plot of a movie I saw a long time ago.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cryptomnesia</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cryptomnesia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cryptomnesia</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Cryptomn%C3%A9sie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sourcemonitoringError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cryptomnesia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cryptomnesia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sourcemonitoringError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <Literal xml:lang="FR">Attention sélective</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <Literal xml:lang="EN">Selective attention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <Literal xml:lang="FR">Vous ne présentez que les faits qui soutiennent votre thèse, en occultant ceux qui la contredisent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <Literal xml:lang="EN">Focusing on specific aspects of the argument while ignoring other relevant dimensions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <Literal xml:lang="FR">Le vin est excellent pour la santé : il contient des antioxydants. Inutile de parler des risques liés à l’alcool.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <Literal xml:lang="EN">Wine is excellent for your health: it contains antioxidants. No need to talk about the risks linked to alcohol.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/159/Selective-Attention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misleadingPresentationOfFacts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <Literal xml:lang="FR">Raisonnement motivé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <Literal xml:lang="EN">Motivated reasoning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <Literal xml:lang="FR">Vous construisez votre argument de façon à confirmer vos convictions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <Literal xml:lang="EN">Building an argument merely to confirm preexisting beliefs instead of seeking objective truth.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <Literal xml:lang="FR">Je suis convaincu que mon candidat est honnête ; les accusations de corruption contre lui ne sont donc que des attaques politiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <Literal xml:lang="EN">I am convinced that my candidate is honest; the corruption allegations against him are therefore just political attacks.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <Literal xml:lang="EN">http://skepdic.com/motivatedreasoning.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <Literal xml:lang="FR">Deux poids, deux mesures</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <Literal xml:lang="EN">Double standard</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <Literal xml:lang="FR">Vous appliquez une règle de manière inégale selon vos préférences ou votre intérêt.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <Literal xml:lang="EN">Applying a rule unevenly, based on preference or convenience, rather than applying it equally to all relevant parties.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <Literal xml:lang="FR">Je critique toujours les gens qui mangent mal, mais une petite glace de temps en temps, pour moi, c’est différent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <Literal xml:lang="EN">I always critique people who eat poorly, but having an ice cream occasionally doesn't count for me—it's different.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Double_standard</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Double_standard</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#specialPleading</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#specialPleading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#specialPleading</IRI>
    <Literal xml:lang="FR">Plaidoirie spéciale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#specialPleading</IRI>
    <Literal xml:lang="EN">Special pleading</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#specialPleading</IRI>
    <Literal xml:lang="FR">Vous demandez une exception à une règle sans raison valable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#specialPleading</IRI>
    <Literal xml:lang="EN">Citing something as an exception to the rule without justifying the exception.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#specialPleading</IRI>
    <Literal xml:lang="FR">Je suis contre toute forme de violence envers les enfants ; mais celui-là mériterait tout de même un bon coup de pied aux fesses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#specialPleading</IRI>
    <Literal xml:lang="EN">I am against violence to children, but in this case, he really needs a good smack on the backside.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#specialPleading</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Special_pleading</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#specialPleading</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#specialPleading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandForSpecialConsideration</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandForSpecialConsideration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandForSpecialConsideration</IRI>
    <Literal xml:lang="FR">Demande d’exemption</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandForSpecialConsideration</IRI>
    <Literal xml:lang="EN">Demand for special consideration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandForSpecialConsideration</IRI>
    <Literal xml:lang="FR">Votre argument met en avant votre pathos et demande une considération spéciale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandForSpecialConsideration</IRI>
    <Literal xml:lang="EN">Appealing to pathos in an argument and pleading for special consideration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandForSpecialConsideration</IRI>
    <Literal xml:lang="FR">Cette note décidera probablement de mon entrée en faculté, monsieur le professeur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandForSpecialConsideration</IRI>
    <Literal xml:lang="EN">This grade will probably decide whether I get into college, professor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandForSpecialConsideration</IRI>
    <Literal xml:lang="EN">http://www.ditext.com/fearnside/33.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#specialPleading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandForSpecialConsideration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandForSpecialConsideration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#specialPleading</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
    <Literal xml:lang="FR">Présentation unilatérale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
    <Literal xml:lang="EN">One-sided Argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
    <Literal xml:lang="FR">Vous ne présentez que les faits nécessaires à votre conclusion, en ignorant les faits qui la contredisent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
    <Literal xml:lang="EN">Presenting only the facts necessary to a conclusion while ignoring conflicting facts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
    <Literal xml:lang="FR">Augmenter les heures de travail, c’est augmenter le pouvoir d’achat des salariés, améliorer leur bien-être familial et donc renforcer leur bien-être au travail.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
    <Literal xml:lang="EN">Increasing working hours means increasing employees' purchasing power, their family well-being, and therefore their job satisfaction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/onesided.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheCounterevidence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheCounterevidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheCounterevidence</IRI>
    <Literal xml:lang="FR">Ignorer la contre-preuve</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheCounterevidence</IRI>
    <Literal xml:lang="EN">Ignoring the counterevidence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheCounterevidence</IRI>
    <Literal xml:lang="FR">Votre argument ignore les preuves qui l’invalident.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheCounterevidence</IRI>
    <Literal xml:lang="EN">Disregarding evidence of an argument's invalidity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheCounterevidence</IRI>
    <Literal xml:lang="FR">Tous les cygnes sont blancs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheCounterevidence</IRI>
    <Literal xml:lang="EN">All swans are white.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheCounterevidence</IRI>
    <Literal xml:lang="EN">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheCounterevidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ignoringTheCounterevidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="FR">Bouc émissaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="EN">Scapegoating</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="FR">Votre argument rejette la responsabilité sur un individu ou un groupe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="EN">Assigning blame to an individual or group for a problem.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="FR">La crise économique actuelle est entièrement la faute des immigrants, qui prennent nos emplois et pèsent sur le système. Si nous contrôlions mieux nos frontières, notre économie serait bien plus forte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="EN">The current economic crisis is entirely due to immigrants taking our jobs and straining the system. If we had stronger border control, our economy would be much stronger.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/158/Scapegoating</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onesidedArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badFaith</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badFaith</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badFaith</IRI>
    <Literal xml:lang="FR">Mauvaise foi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badFaith</IRI>
    <Literal xml:lang="EN">Bad faith</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badFaith</IRI>
    <Literal xml:lang="FR">Votre argument est de mauvaise foi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badFaith</IRI>
    <Literal xml:lang="EN">Arguing in bad faith.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badFaith</IRI>
    <Literal xml:lang="FR">Bien sûr que votre avis compte : j’encourage toutes les voix à s’exprimer dans notre association. Mais il est normal que les plus expérimentés parmi nous aient une plus grande influence, n’est-ce pas ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badFaith</IRI>
    <Literal xml:lang="EN">Of course your opinion matters, I encourage all voices to be heard in our association, but it's only natural that the more experienced among us have a greater influence, right?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badFaith</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Bad_faith</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badFaith</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badFaith</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleStandard</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <Literal xml:lang="FR">Pensée sélective</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <Literal xml:lang="EN">Selective thinking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <Literal xml:lang="FR">Vous ne retenez que les faits nécessaires pour soutenir votre conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <Literal xml:lang="EN">Cherry-picking only the facts necessary to reach one's conclusion, ignoring any contradictory information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <Literal xml:lang="FR">Les statistiques montrent que les villes qui, comme nous, ont donné la priorité au budget de la police ont les taux de criminalité les plus faibles. Cela prouve que nous avons eu raison de réduire les prestations sociales.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <Literal xml:lang="EN">The statistics indicate that cities like ours, which prioritised police budgeting, have the lowest crime rates. Clearly, our social welfare cuts were justified.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <Literal xml:lang="EN">http://skepdic.com/selectiv.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveReading</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveReading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveReading</IRI>
    <Literal xml:lang="FR">Argument par la lecture sélective</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveReading</IRI>
    <Literal xml:lang="EN">Selective reading</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveReading</IRI>
    <Literal xml:lang="FR">Vous choisissez de mettre en évidence les arguments les plus faibles de l’autre camp pour décrédibiliser l’ensemble de sa position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveReading</IRI>
    <Literal xml:lang="EN">Selectively highlighting the weakest arguments of the opposing side to discredit their overall position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveReading</IRI>
    <Literal xml:lang="FR">Je constate que votre réquisitoire est bourré de fautes et qu’il énonce une liste interminable de témoignages qui n’apportent aucune information sur le fond de l’affaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveReading</IRI>
    <Literal xml:lang="EN">I see that your argument is rife with errors and lists endless testimonies that fail to provide any substantive information on the matter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveReading</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#selective_reading</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveReading</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveReading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionOfKeyEvidence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionOfKeyEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionOfKeyEvidence</IRI>
    <Literal xml:lang="FR">Omission d’une preuve clé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionOfKeyEvidence</IRI>
    <Literal xml:lang="EN">Omission of key evidence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionOfKeyEvidence</IRI>
    <Literal xml:lang="FR">Vous ignorez volontairement une preuve essentielle qui remet en question votre point de vue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionOfKeyEvidence</IRI>
    <Literal xml:lang="EN">Deliberately ignoring key evidence that challenges one's standpoint.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionOfKeyEvidence</IRI>
    <Literal xml:lang="FR">Nous avons les mêmes goûts, nous fréquentons la même communauté, nous pourrions faire de belles économies tous les deux : marions-nous !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionOfKeyEvidence</IRI>
    <Literal xml:lang="EN">We have the same tastes, we belong to the same community, we could save a lot by being together: let's get married!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionOfKeyEvidence</IRI>
    <Literal xml:lang="EN">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionOfKeyEvidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionOfKeyEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="FR">Biais de confirmation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="EN">Confirmation bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="FR">Vous vous concentrez uniquement sur les éléments qui renforcent votre argumentation, en excluant tout ce qui peut la contester.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="EN">Focusing solely on the elements that fortify one's argumentation, excluding anything that might contest it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="FR">J’ai lu des dizaines d’articles qui soutiennent mon point de vue : c’est bien la preuve que j’ai raison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="EN">I read dozens of articles supporting my view, which surely proves I'm right.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <Literal xml:lang="EN">http://skepdic.com/confirmbias.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confirmationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scotomization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scotomization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scotomization</IRI>
    <Literal xml:lang="FR">Scotomisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scotomization</IRI>
    <Literal xml:lang="EN">Scotomization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scotomization</IRI>
    <Literal xml:lang="FR">Votre argument nie des événements qui vous sont pourtant arrivés, parce qu’ils vous sont insupportables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scotomization</IRI>
    <Literal xml:lang="EN">Denying events one has experienced because they are unbearable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scotomization</IRI>
    <Literal xml:lang="FR">Je n’ai pas pu me tromper de la sorte. Ce doit être une erreur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scotomization</IRI>
    <Literal xml:lang="EN">I couldn't have made such a mistake. It must be some sort of error.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scotomization</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Scotomization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scotomization</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Scotomisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scotomization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scotomization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
    <Literal xml:lang="FR">Biais de publication</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
    <Literal xml:lang="EN">Publication bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
    <Literal xml:lang="FR">Vous favorisez la diffusion des études qui donnent des résultats positifs, en omettant celles qui échouent ou qui sont moins concluantes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
    <Literal xml:lang="EN">Preferentially disseminating studies yielding positive results while omitting those that fail or are inconclusive.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
    <Literal xml:lang="FR">Les études que nous avons publiées montrent toutes un effet positif de notre traitement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
    <Literal xml:lang="EN">The studies we've published all show a positive effect of our treatment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Publication_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_de_publication</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whiteHatBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whiteHatBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whiteHatBias</IRI>
    <Literal xml:lang="FR">Biais du chapeau blanc</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whiteHatBias</IRI>
    <Literal xml:lang="EN">White hat bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whiteHatBias</IRI>
    <Literal xml:lang="FR">Vous mettez en avant les résultats qui soutiennent vos bonnes intentions, tout en ignorant les effets négatifs ou les échecs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whiteHatBias</IRI>
    <Literal xml:lang="EN">Highlighting outcomes that support one's good intentions while ignoring negative impacts or failures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whiteHatBias</IRI>
    <Literal xml:lang="FR">Toutes les études que j’ai pu lire récemment me laissent penser que l’on peut être très optimiste quant à la guérison prochaine de tous les cancers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whiteHatBias</IRI>
    <Literal xml:lang="EN">All the studies I've come across recently lead me to believe we can be very optimistic about curing all cancers soon.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whiteHatBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/White_hat_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whiteHatBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whiteHatBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#filedrawerEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#filedrawerEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#filedrawerEffect</IRI>
    <Literal xml:lang="FR">Effet tiroir</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#filedrawerEffect</IRI>
    <Literal xml:lang="EN">File-drawer effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#filedrawerEffect</IRI>
    <Literal xml:lang="FR">Vous ne citez que les recherches qui obtiennent des résultats significatifs, en excluant celles qui n’ont pas donné de résultat notable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#filedrawerEffect</IRI>
    <Literal xml:lang="EN">Citing only research with significant results in an argument, excluding research without notable findings.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#filedrawerEffect</IRI>
    <Literal xml:lang="FR">Pourquoi n’avez-vous pas publié ces résultats, qui montraient bien que nous n’aboutissions à rien ? Oh, personne ne s’intéresse à ce genre de mauvaises nouvelles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#filedrawerEffect</IRI>
    <Literal xml:lang="EN">Why haven't these findings showing that we're not progressing been published? Oh, no one cares about such bad news.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#filedrawerEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Publication_bias#Definition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#filedrawerEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_de_publication#Effet_tiroir</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#filedrawerEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#filedrawerEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#publicationBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundingBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundingBias</IRI>
    <Literal xml:lang="FR">Biais de financement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundingBias</IRI>
    <Literal xml:lang="EN">Funding bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundingBias</IRI>
    <Literal xml:lang="FR">Vos opinions ou vos conclusions sont influencées par les sources de financement plutôt que par des faits objectifs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundingBias</IRI>
    <Literal xml:lang="EN">Having one's opinions or conclusions swayed by funding sources instead of being based on objective facts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundingBias</IRI>
    <Literal xml:lang="FR">Notre dernière étude montre qu’il n’y a aucun lien significatif entre la consommation de soda et l’obésité chez les adolescents. Ces résultats devraient rassurer sur la qualité des produits de nos sponsors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundingBias</IRI>
    <Literal xml:lang="EN">Our latest study indicates there is no significant link between soda consumption and obesity among adolescents. These results should reassure our sponsors about the quality of their products.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundingBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Funding_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundingBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_de_financement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motivatedReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="FR">Effet de l’expérimentateur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="EN">Experimenter effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="FR">Vous influencez sans vous en rendre compte les résultats ou leur interprétation par vos attentes ou par votre comportement envers le sujet étudié.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="EN">You unknowingly influence the results or their interpretation through your expectations or your behavior toward the subject being studied.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="FR">Pendant l’expérience, je souris et j’encourage davantage les participants qui donnent les réponses que j’attends, sans m’en rendre compte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="EN">During the experiment, I smile at and encourage the participants who give the answers I expect more than the others, without realizing it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="EN">http://skepdic.com/experimentereffect.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inattentionalBlindness</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inattentionalBlindness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inattentionalBlindness</IRI>
    <Literal xml:lang="FR">Cécité d’inattention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inattentionalBlindness</IRI>
    <Literal xml:lang="EN">Inattentional blindness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inattentionalBlindness</IRI>
    <Literal xml:lang="FR">Vous ne remarquez pas un élément significatif parce que vous êtes trop focalisé sur une tâche ou sur un détail précis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inattentionalBlindness</IRI>
    <Literal xml:lang="EN">Not noticing a significant element because of being too focused on a specific task or detail.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inattentionalBlindness</IRI>
    <Literal xml:lang="FR">Lors du contrôle qualité, j’étais tellement concentré sur les finitions que je n’ai pas remarqué un défaut majeur dans le matériau du produit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inattentionalBlindness</IRI>
    <Literal xml:lang="EN">During our last quality control, I was so focused on checking the finishes that I completely missed a major flaw in the materials used for our products.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inattentionalBlindness</IRI>
    <Literal xml:lang="EN">http://skepdic.com/inattentionalblindness.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inattentionalBlindness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inattentionalBlindness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectiveAttention</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="FR">Déplacement des critères</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="EN">Moving the goalposts</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="FR">Vous changez les critères du débat sans le dire, afin d’éviter d’admettre votre erreur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="EN">Changing the criteria of the debate without saying so, in order to avoid admitting one's error.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="FR">Vous aviez demandé une étude publiée pour être convaincu. Lorsqu’on vous en présente une, vous exigez soudain trois études indépendantes et une méta-analyse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="EN">You had asked for a published study to be convinced. When one is presented, you suddenly demand three independent studies and a meta-analysis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Moving_the_goalposts</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#ConflictingGoals_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <Literal xml:lang="FR">Exigence renforcée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <Literal xml:lang="EN">Stronger requirements</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <Literal xml:lang="FR">Vous augmentez vos exigences à mesure que votre interlocuteur y répond.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <Literal xml:lang="EN">Increasing one's demands as one's interlocutor complies with them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <Literal xml:lang="FR">— Vous ne savez pas conduire.
— Mais voyons, j’ai mon permis de conduire !
— Oui, mais vous n’avez jamais su faire un créneau correctement...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <Literal xml:lang="EN">— You don't know how to drive.
— But I have my driver's license!
— Yes, but you've never been able to parallel park properly...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/raise_the_bar</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <Literal xml:lang="FR">Objections sans fin</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <Literal xml:lang="EN">Fallacies of objection</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <Literal xml:lang="FR">Vous multipliez indéfiniment les objections sans jamais trancher, en ignorant les conséquences concrètes de l’inaction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <Literal xml:lang="EN">Indefinitely accumulating objections without making a decision, thus ignoring the practical consequences of inaction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <Literal xml:lang="FR">J’avais toujours une bonne raison de repousser le moment de la demander en mariage. Finalement, elle en a épousé un autre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <Literal xml:lang="EN">I always had a good reason for postponing my marriage proposal. Eventually, she married someone else.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <Literal xml:lang="EN">http://www.ditext.com/fearnside/37.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
    <Literal xml:lang="FR">Attente irréaliste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
    <Literal xml:lang="EN">Impossible Expectations</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
    <Literal xml:lang="FR">Vous exigez un niveau irréaliste de certitude avant d’accepter de prendre position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
    <Literal xml:lang="EN">Demanding an unrealistic level of certainty before agreeing to take a position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
    <Literal xml:lang="FR">Les scientifiques ne peuvent même pas prédire le temps qu’il fera la semaine prochaine. Comment peuvent-ils prédire à quoi ressemblera le climat dans 100 ans ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
    <Literal xml:lang="EN">Scientists can't even predict the weather next week. How can they predict the climate in 100 years?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
    <Literal xml:lang="EN">https://www.climatechangecommunication.org/wp-content/uploads/2020/11/Cook_2020_deconstructing_denial.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
    <Literal xml:lang="FR">https://vert.eco/wp-content/uploads/2022/04/techniques-du-deni-scientifique.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="FR">Solution parfaite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="EN">Nirvana Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="FR">Vous rejetez les solutions réalistes en demandant un idéal inatteignable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="EN">Discarding any solution less than perfect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="FR">Je suis opposée au port obligatoire de la ceinture de sécurité car cette mesure n’empêche nullement les accidents de la route.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="EN">I oppose mandatory seatbelt use because this measure does nothing to prevent road accidents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Nirvana_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <Literal xml:lang="FR">http://www.sceptiques.qc.ca/dictionnaire/perfectsolution.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalHolism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalHolism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalHolism</IRI>
    <Literal xml:lang="FR">Holisme logique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalHolism</IRI>
    <Literal xml:lang="EN">Logical holism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalHolism</IRI>
    <Literal xml:lang="FR">Votre argument suppose qu’une partie de l’univers ne peut être connue que si l’on connaît l’ensemble de l’univers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalHolism</IRI>
    <Literal xml:lang="EN">Arguing that a part of the universe can only be understood if one knows the entire universe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalHolism</IRI>
    <Literal xml:lang="FR">On ne peut pas comprendre les lois du système solaire si l’on ne connaît pas la physique des particules élémentaires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalHolism</IRI>
    <Literal xml:lang="EN">We can't comprehend the laws of the solar system unless we know the physics of elementary particles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalHolism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Logical_holism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalHolism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Holisme_logique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalHolism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#logicalHolism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nirvanaFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="FR">Justification infinie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="EN">Infinite regress</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="FR">Vous demandez sans cesse plus d’explications, tout en évitant de parvenir à une conclusion claire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="EN">Demanding justification for each justification, in a never ending process.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="FR">Mais pourquoi ? Et d’où vient cette information ? Et pourquoi devrais-je croire cette source ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="EN">But why? And where does that information come from? And why should I believe that source?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Infinite_regress</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/R%C3%A9gression_%C3%A0_l%27infini</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#infiniteRegress</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impossibleExpectations</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scienceHasBeenWrongBefore</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scienceHasBeenWrongBefore</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scienceHasBeenWrongBefore</IRI>
    <Literal xml:lang="FR">La science s’est déjà trompée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scienceHasBeenWrongBefore</IRI>
    <Literal xml:lang="EN">Science has been wrong before</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scienceHasBeenWrongBefore</IRI>
    <Literal xml:lang="FR">Vous prétendez à tort que, parce que la science s’est trompée par le passé, elle se trompe forcément aujourd’hui aussi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scienceHasBeenWrongBefore</IRI>
    <Literal xml:lang="EN">Incorrectly claiming that because science has been wrong in the past, it is inevitably wrong now.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scienceHasBeenWrongBefore</IRI>
    <Literal xml:lang="FR">Pourquoi croire les scientifiques au sujet des niveaux d’exposition aux radiations des téléphones portables ? N’oubliez pas qu’autrefois, ils affirmaient que l’exposition à l’amiante ou au tabac était sans risque.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scienceHasBeenWrongBefore</IRI>
    <Literal xml:lang="EN">Why should we trust scientists about cellphone radiation levels? Remember, once they said asbestos and smoking were safe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scienceHasBeenWrongBefore</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Science_was_wrong_before</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scienceHasBeenWrongBefore</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scienceHasBeenWrongBefore</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mediaHasBeenWrongBefore</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mediaHasBeenWrongBefore</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mediaHasBeenWrongBefore</IRI>
    <Literal xml:lang="FR">Le média s’est déjà trompé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mediaHasBeenWrongBefore</IRI>
    <Literal xml:lang="EN">Media has been wrong before</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mediaHasBeenWrongBefore</IRI>
    <Literal xml:lang="FR">Vous doutez systématiquement de toutes les informations d’un média sous prétexte qu’il a déjà fait des erreurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mediaHasBeenWrongBefore</IRI>
    <Literal xml:lang="EN">Systematically doubting all information from a media source because it has made errors in the past.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mediaHasBeenWrongBefore</IRI>
    <Literal xml:lang="FR">Les sondages fournis par cet institut ne valent rien car il s’était complètement trompé lors de la dernière élection présidentielle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mediaHasBeenWrongBefore</IRI>
    <Literal xml:lang="EN">Surveys from this institute are valueless, as they got the last presidential election completely wrong.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mediaHasBeenWrongBefore</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Media_was_wrong_before</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mediaHasBeenWrongBefore</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mediaHasBeenWrongBefore</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseStoppedClock</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseStoppedClock</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseStoppedClock</IRI>
    <Literal xml:lang="FR">La pendule cassée inverse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseStoppedClock</IRI>
    <Literal xml:lang="EN">Inverse stopped clock</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseStoppedClock</IRI>
    <Literal xml:lang="FR">Vous remettez en cause toute la crédibilité d’une personne en raison d’une seule erreur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseStoppedClock</IRI>
    <Literal xml:lang="EN">Challenging the entire credibility of a person due to a single mistake.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseStoppedClock</IRI>
    <Literal xml:lang="FR">Comment pouvez-vous encore prendre au sérieux les théories scientifiques de ce chercheur ? N’oubliez pas qu’il a une fois soutenu une théorie du complot absurde.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseStoppedClock</IRI>
    <Literal xml:lang="EN">How can you still take this scientist's theories seriously? Don't forget he once supported an absurd conspiracy theory.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseStoppedClock</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Inverse_stopped_clock</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseStoppedClock</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inverseStoppedClock</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="FR">Changement de terrain</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="EN">Shifting ground</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="FR">Vous modifiez constamment les bases de votre argumentation pour éviter d’admettre votre défaite sur un point précis et pour désorienter votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="EN">Constantly modifying the bases of an argument to avoid admitting defeat on a specific point and to disorient one's interlocutor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="FR">Vous critiquez ma gestion de projet ? Et que dire de votre retard sur le rapport la semaine dernière ? D’ailleurs, n’oublions pas votre échec lors de la présentation du mois dernier...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="EN">You're questioning my project management? What about your delay on the report last week? And let's not forget your failure in last month's presentation...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <Literal xml:lang="EN">https://leanlogic.online/glossary/shifting-ground/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingGround</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallaciesOfObjection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
    <Literal xml:lang="FR">Confondre une explication et une excuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
    <Literal xml:lang="EN">Confusing an explanation with an excuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
    <Literal xml:lang="FR">Vous confondez la cause d’un acte avec sa justification afin d’esquiver la critique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
    <Literal xml:lang="EN">Conflating the cause of an act with its justification to evade criticism.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
    <Literal xml:lang="FR">Vous dites que la pauvreté et l’oppression peuvent mener à la radicalisation et au terrorisme ? Comment pouvez-vous excuser de tels actes ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
    <Literal xml:lang="EN">You suggest that poverty and oppression lead to radicalization and terrorism? How can you excuse such acts?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/71/Confusing-an-Explanation-with-an-Excuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sanctioningTheDevil</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sanctioningTheDevil</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sanctioningTheDevil</IRI>
    <Literal xml:lang="FR">Refus de légitimer</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sanctioningTheDevil</IRI>
    <Literal xml:lang="EN">Sanctioning the devil</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sanctioningTheDevil</IRI>
    <Literal xml:lang="FR">Vous refusez de discuter sous prétexte que cela légitimerait les arguments de votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sanctioningTheDevil</IRI>
    <Literal xml:lang="EN">Refusing to engage in a discussion on the grounds that it would validate one's opponent's argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sanctioningTheDevil</IRI>
    <Literal xml:lang="FR">Je ne débattrai pas avec ce parti d’extrême droite, car ce serait lui offrir une tribune indue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sanctioningTheDevil</IRI>
    <Literal xml:lang="EN">I won't debate with that far-right party, as it would give them an undue platform.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sanctioningTheDevil</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Sanctioning_the_devil</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sanctioningTheDevil</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sanctioningTheDevil</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="FR">Piège kafkaïen</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="EN">Kafkatrap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="FR">Vous interprétez toute tentative de défense comme une confirmation de culpabilité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="EN">Considering every defense as proof of guilt.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="FR">Si vous avez autant d’excuses, c’est parce que vous avez bien quelque chose à vous reprocher.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="EN">If you have so many excuses, it's because you indeed have something to feel guilty about.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/Kafkatrap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="FR">https://mgtow-france.fr/2020/01/sophismes-kafkaiens-les-armes-rhetoriques-de-la-victimisation/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingAnExplanationWithAnExcuse</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oneSingleProof</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oneSingleProof</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oneSingleProof</IRI>
    <Literal xml:lang="FR">Preuve d’un seul type exigée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oneSingleProof</IRI>
    <Literal xml:lang="EN">One single proof</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oneSingleProof</IRI>
    <Literal xml:lang="FR">Vous exigez que votre interlocuteur prouve sa thèse au moyen d’un seul type de preuve.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oneSingleProof</IRI>
    <Literal xml:lang="EN">Forcing one's interlocutor to prove their thesis with only one kind of evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oneSingleProof</IRI>
    <Literal xml:lang="FR">Si l’accusé était vraiment au restaurant au moment du crime, présentez-nous un reçu qui le prouve.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oneSingleProof</IRI>
    <Literal xml:lang="EN">If the accused was truly at the restaurant at the time of the crime, show us a receipt proving it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oneSingleProof</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/One_single_proof</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oneSingleProof</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oneSingleProof</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de l’improvisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="EN">On the spot fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="FR">Vous jugez votre interlocuteur incompétent s’il ne peut pas citer sur-le-champ des données précises ou des détails techniques sur un sujet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="EN">Considering an interlocutor incompetent if they cannot recite specific data or technical details on a topic.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="FR">Si vous ne pouvez pas citer les dernières statistiques sur la croissance économique, alors votre point de vue sur la politique économique ne vaut rien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="EN">If you can't quote the latest economic growth statistics, then your views on economic policy are invalid.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/On_the_spot_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oneSingleProof</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oneSingleProof</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
    <Literal xml:lang="FR">Renverser la charge de la preuve</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
    <Literal xml:lang="EN">Shifting the burden of proof</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
    <Literal xml:lang="FR">Vous estimez que c’est à la partie adverse de démontrer que votre position est fausse, au lieu de la justifier vous-même.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
    <Literal xml:lang="EN">Assuming a proposition to be true until proved false or vice-versa.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
    <Literal xml:lang="FR">Moi, prouver que mon produit est sans danger ? C’est plutôt à vous de montrer qu’il est nocif !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
    <Literal xml:lang="EN">I need to prove my product is safe? Isn't it rather for you to show how it's harmful?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Philosophical_burden_of_proof#Shifting_the_burden_of_proof</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Renverser_la_charge_de_la_preuve_(philosophie)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#provingNonexistence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#provingNonexistence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#provingNonexistence</IRI>
    <Literal xml:lang="FR">Prouver la non-existence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#provingNonexistence</IRI>
    <Literal xml:lang="EN">Proving non-existence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#provingNonexistence</IRI>
    <Literal xml:lang="FR">Au lieu de prouver l’existence d’un phénomène que vous affirmez, vous exigez que votre adversaire en prouve la non-existence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#provingNonexistence</IRI>
    <Literal xml:lang="EN">Assuming that it is up to an opponent to disprove the existence of a phenomenon one believes in, rather than providing evidence for it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#provingNonexistence</IRI>
    <Literal xml:lang="FR">Si vous ne pouvez pas me prouver que le monstre du Loch Ness n’existe pas, c’est qu’il existe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#provingNonexistence</IRI>
    <Literal xml:lang="EN">If you cannot prove that the Loch Ness monster does not exist, then it must exist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#provingNonexistence</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/145/Proving-Non-Existence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#provingNonexistence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#provingNonexistence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shiftingTheBurdenOfProof</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bigWords</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bigWords</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bigWords</IRI>
    <Literal xml:lang="FR">Mots compliqués</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bigWords</IRI>
    <Literal xml:lang="EN">Big words</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bigWords</IRI>
    <Literal xml:lang="FR">Vous critiquez l’emploi de termes spécialisés pour affaiblir l’argumentation adverse, en laissant entendre qu’ils masquent un manque de substance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bigWords</IRI>
    <Literal xml:lang="EN">Criticizing the use of specialized terms to minimize the strength of the opposing argument, suggesting they mask a lack of substance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bigWords</IRI>
    <Literal xml:lang="FR">Oh, arrêtez avec vos termes comme « climatologie » et « système complexe » ! C’est du vent pour dissimuler que vous n’avez pas d’argument solide !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bigWords</IRI>
    <Literal xml:lang="EN">Oh, stop using your fancy terms like 'climatology' and 'complex systems'! It's just puffery to disguise that you have no strong argument!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bigWords</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Big_words</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bigWords</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bigWords</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strongerRequirements</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <Literal xml:lang="FR">Vouloir le beurre et l’argent du beurre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <Literal xml:lang="EN">Having Your Cake and Eating It Too</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <Literal xml:lang="FR">Vous évitez de prendre une position claire afin de ne pas pouvoir être mis en défaut.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <Literal xml:lang="EN">Avoiding taking any clear stand so as never to be proven wrong.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <Literal xml:lang="FR">Si j’ai offensé quelqu’un dans cette assemblée, même par inadvertance, je lui présente mes excuses ; j’ai cependant agi en mon âme et conscience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <Literal xml:lang="EN">If I accidentally offended someone here, I apologize; however, my actions were in good faith.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/101/Having-Your-Cake</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
    <Literal xml:lang="FR">Ne pas se mouiller</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
    <Literal xml:lang="EN">Failure to state</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
    <Literal xml:lang="FR">Vous présentez un point de vue sans jamais être explicite, rendant votre position insaisissable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
    <Literal xml:lang="EN">You present a point of view without ever stating it explicitly, making your position impossible to pin down.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
    <Literal xml:lang="FR">Bien sûr, je suis pour la liberté d’expression. Cependant, je ne suis pas sûr qu’il soit sage de diffuser toutes les opinions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
    <Literal xml:lang="EN">Of course, I support freedom of expression. However, I am not sure it is wise to disseminate every opinion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#state</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
    <Literal xml:lang="FR">Langue de bois</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
    <Literal xml:lang="EN">Wooden language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
    <Literal xml:lang="FR">Vous noyez votre propos dans un flot de généralités, ce qui vous évite de vous engager sur quoi que ce soit de précis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
    <Literal xml:lang="EN">Drowning one's point in a flood of generalities, thus avoiding committing to anything specific.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
    <Literal xml:lang="FR">Votre colère est légitime. En ces temps troublés, nous devons tous faire preuve d’un grand sens des responsabilités.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
    <Literal xml:lang="EN">I recognize your legitimate anger. In these troubled times, we all must exhibit a high sense of responsibility.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Wooden_language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Langue_de_bois</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twaddleTendency</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twaddleTendency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twaddleTendency</IRI>
    <Literal xml:lang="FR">Effet puits</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twaddleTendency</IRI>
    <Literal xml:lang="EN">Twaddle tendency</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twaddleTendency</IRI>
    <Literal xml:lang="FR">Vous vous exprimez en des termes creux et pompeux de manière à ce que votre discours soit parfaitement vide, tout en donnant l’illusion d’être profond.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twaddleTendency</IRI>
    <Literal xml:lang="EN">You express yourself in hollow, pompous terms so that your speech is completely empty while giving the illusion of being profound.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twaddleTendency</IRI>
    <Literal xml:lang="FR">Considérant la conjoncture actuelle, il est nécessaire de prendre en compte chacune des problématiques déjà en notre possession, afin de pouvoir prendre les mesures indispensables pour y répondre pertinemment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twaddleTendency</IRI>
    <Literal xml:lang="EN">Considering the current circumstances, it is necessary to consider all the issues already at our disposal, in order to take the essential measures effectively.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twaddleTendency</IRI>
    <Literal xml:lang="EN">https://www.readjuancarlos.com/mental-model-twaddle-tendency/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twaddleTendency</IRI>
    <Literal xml:lang="FR">https://cortecs.org/materiel/leffet-puits/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twaddleTendency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#twaddleTendency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#woodenLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousAssertion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousAssertion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousAssertion</IRI>
    <Literal xml:lang="FR">Assertion ambiguë</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousAssertion</IRI>
    <Literal xml:lang="EN">Ambiguous assertion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousAssertion</IRI>
    <Literal xml:lang="FR">Vous énoncez vos idées de manière suffisamment vague pour rendre difficile la compréhension de votre position réelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousAssertion</IRI>
    <Literal xml:lang="EN">Stating one's ideas vaguely enough to make one's real position difficult to understand.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousAssertion</IRI>
    <Literal xml:lang="FR">Nous suivons de très près le conflit qui oppose salariés et employeurs. Face à cette situation, nous avons décidé de nous engager à fond pour ce secteur industriel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousAssertion</IRI>
    <Literal xml:lang="EN">We are vigilantly monitoring the conflict between employees and employers. In this context, we are fully committing ourselves to the industrial sector.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousAssertion</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#ambig_assertion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousAssertion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguousAssertion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureToState</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <Literal xml:lang="FR">Ménager la chèvre et le chou</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <Literal xml:lang="EN">Mixed bag</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <Literal xml:lang="FR">Vous mélangez plusieurs éléments dans votre argument, ce qui permet de l’interpréter de différentes façons.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <Literal xml:lang="EN">Blending several elements in an argument that can be interpreted in multiple ways.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <Literal xml:lang="FR">Dans notre politique envers ce conflit international, nous soutenons une approche qui respecte à la fois la souveraineté des nations et le droit des peuples à l’autodétermination.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <Literal xml:lang="EN">In our approach to this international conflict, we support a policy that respects the sovereignty of nations and the right of peoples to self-determination.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/mixed_bag</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <Literal xml:lang="FR">https://fr.wiktionary.org/wiki/il_y_a_à_boire_et_à_manger</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifbywhiskey</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifbywhiskey</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifbywhiskey</IRI>
    <Literal xml:lang="FR">Si par whisky</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifbywhiskey</IRI>
    <Literal xml:lang="EN">If-by-whiskey</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifbywhiskey</IRI>
    <Literal xml:lang="FR">Vous ajustez votre définition des termes du débat selon la perception de l’interlocuteur pour toujours vous positionner favorablement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifbywhiskey</IRI>
    <Literal xml:lang="EN">Adjusting the definition of the terms of the debate according to the interlocutor's perception in order to always position oneself favorably.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifbywhiskey</IRI>
    <Literal xml:lang="FR">Quand vous dites « réseaux sociaux », parlez-vous d’outils qui isolent les gens et propagent de fausses informations, ou d’outils qui les relient et favorisent l’échange d’idées ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifbywhiskey</IRI>
    <Literal xml:lang="EN">When I say “social networks,” am I talking about tools that isolate people and spread false information, or tools that connect them and encourage the exchange of ideas?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifbywhiskey</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/107/If-By-Whiskey</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifbywhiskey</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifbywhiskey</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mortonsFork</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mortonsFork</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mortonsFork</IRI>
    <Literal xml:lang="FR">La fourchette de Morton</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mortonsFork</IRI>
    <Literal xml:lang="EN">Morton's fork</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mortonsFork</IRI>
    <Literal xml:lang="FR">Vous utilisez, selon votre auditoire, des arguments différents qui mènent tous à la conclusion qui vous arrange.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mortonsFork</IRI>
    <Literal xml:lang="EN">Employing different arguments depending on the audience, all leading to the conclusion that serves one's interests.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mortonsFork</IRI>
    <Literal xml:lang="FR">Si nos concurrents augmentent leurs prix, nous dirons qu’ils profitent de leurs clients. Mais s’ils maintiennent leurs prix, nous dirons qu’ils sacrifient la qualité et l’innovation pour des gains à court terme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mortonsFork</IRI>
    <Literal xml:lang="EN">If our competitors raise their prices, we'll say they're taking advantage of their customers. But if they keep their prices the same, we'll say they're sacrificing quality and innovation for short-term gains.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mortonsFork</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Morton%27s_fork</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mortonsFork</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mortonsFork</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingAdvantageOfTheNaysayer</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingAdvantageOfTheNaysayer</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingAdvantageOfTheNaysayer</IRI>
    <Literal xml:lang="FR">Équivoque antithétique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingAdvantageOfTheNaysayer</IRI>
    <Literal xml:lang="EN">Taking advantage of the nay-sayer</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingAdvantageOfTheNaysayer</IRI>
    <Literal xml:lang="FR">En jouant habilement avec le pour et le contre, vous embrouillez votre auditoire, qui ne sait plus quel est votre véritable point de vue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingAdvantageOfTheNaysayer</IRI>
    <Literal xml:lang="EN">Skillfully playing with the pros and cons, confusing the audience until one's real point of view is no longer clear.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingAdvantageOfTheNaysayer</IRI>
    <Literal xml:lang="FR">Il est essentiel de préserver nos traditions et ce qui peut enrichir notre culture.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingAdvantageOfTheNaysayer</IRI>
    <Literal xml:lang="EN">It's crucial to preserve our traditions and what can enrich our culture.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingAdvantageOfTheNaysayer</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Take_Advantage_of_The_Nay-Sayer</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingAdvantageOfTheNaysayer</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_X</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingAdvantageOfTheNaysayer</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingAdvantageOfTheNaysayer</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mixedBag</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nondenialDenial</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nondenialDenial</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nondenialDenial</IRI>
    <Literal xml:lang="FR">Démenti qui n’en est pas un</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nondenialDenial</IRI>
    <Literal xml:lang="EN">Non-denial denial</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nondenialDenial</IRI>
    <Literal xml:lang="FR">Vous formulez un déni ambigu qui peut apparaître comme une confirmation cachée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nondenialDenial</IRI>
    <Literal xml:lang="EN">Articulating a denial in such an ambiguous way that it could seem like a covert affirmation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nondenialDenial</IRI>
    <Literal xml:lang="FR">Je n’ai jamais accepté de pots-de-vin : il ne s’agissait que de « dîners de travail ».</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nondenialDenial</IRI>
    <Literal xml:lang="EN">I have never taken bribes; they were merely 'business dinners'.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nondenialDenial</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Non-denial_denial</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nondenialDenial</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nondenialDenial</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
    <Literal xml:lang="FR">Excuses qui n’en sont pas</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
    <Literal xml:lang="EN">Non-apology apology</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
    <Literal xml:lang="FR">Vous présentez des excuses qui, de façon détournée, peuvent rejeter la faute sur la personne qui les reçoit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
    <Literal xml:lang="EN">Presenting apologies that indirectly may blame the receiver.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
    <Literal xml:lang="FR">Je suis désolé que vous l’ayez mal pris ; je pensais que vous pouviez encaisser une blague.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
    <Literal xml:lang="EN">I'm sorry you were offended; I thought you could take a joke.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Non-apology_apology</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakesWereMade</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakesWereMade</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakesWereMade</IRI>
    <Literal xml:lang="FR">Des erreurs ont été comises</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakesWereMade</IRI>
    <Literal xml:lang="EN">Mistakes were made</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakesWereMade</IRI>
    <Literal xml:lang="FR">Vous admettez des erreurs en évitant soigneusement de vous en attribuer la responsabilité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakesWereMade</IRI>
    <Literal xml:lang="EN">Admitting mistakes without explicitly taking personal responsibility for them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakesWereMade</IRI>
    <Literal xml:lang="FR">Je regrette amèrement que mes services aient pu faire preuve de légèreté dans le traitement des dossiers de nos clients, mais, dans le monde compétitif d’aujourd’hui, il est difficile de définir les limites de l’utilisation de l’information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakesWereMade</IRI>
    <Literal xml:lang="EN">I deeply regret any potential negligence in my services in handling our clients' files. In today's competitive world, defining the limits of information use is challenging.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakesWereMade</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Mistakes_were_made</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakesWereMade</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mistakesWereMade</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifpology</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifpology</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifpology</IRI>
    <Literal xml:lang="FR">Excuses conditionnées</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifpology</IRI>
    <Literal xml:lang="EN">Ifpology</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifpology</IRI>
    <Literal xml:lang="FR">Vos excuses semblent conditionnelles et transfèrent subtilement le blâme à l’autre partie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifpology</IRI>
    <Literal xml:lang="EN">Offering apologies that seem conditional and subtly shift the blame onto the other party.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifpology</IRI>
    <Literal xml:lang="FR">Si ma question a semblé offensante à quelqu’un, j’en suis désolé, car ce n’était certainement pas mon intention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifpology</IRI>
    <Literal xml:lang="EN">If my words have offended someone, I deeply regret it, as it was never my intention to do so.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifpology</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Non-apology_apology#The_.22if_apology.22</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifpology</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ifpology</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonapologyApology</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
    <Literal xml:lang="FR">Couverture</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
    <Literal xml:lang="EN">Hedging</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
    <Literal xml:lang="FR">Vous adaptez votre position pour esquiver des critiques tout en prétendant maintenir le même discours.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
    <Literal xml:lang="EN">Refining a claim to dodge counter evidence and then acting as if the revised claim is the original one.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
    <Literal xml:lang="FR">Je n’ai pas dit que je voulais abandonner ce projet, voyons ; j’ai simplement dit que j’envisageais d’y travailler différemment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
    <Literal xml:lang="EN">I just said I would change my way of working on this contract. Not that I was giving it up.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="FR">Argument après contestation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="EN">Moving the goalposts</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="FR">Une fois votre argument réfuté, vous le reformulez pour éviter de perdre la face.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="EN">Refining an argument after it has been rebutted or debunked to avoid losing face.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="FR">Je n’ai pas déclaré que cet investissement était sûr ; j’ai simplement souligné son potentiel intéressant au vu des circonstances actuelles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="EN">I didn't say the investment was safe, I just highlighted its interesting potential in the current circumstances.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Post_disputation_argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coveringYourAss</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coveringYourAss</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coveringYourAss</IRI>
    <Literal xml:lang="FR">Couvrir ses arrières</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coveringYourAss</IRI>
    <Literal xml:lang="EN">Covering your ass</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coveringYourAss</IRI>
    <Literal xml:lang="FR">Vous rejetez toute responsabilité pour ne pas être tenu responsable de vos actes ou de vos paroles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coveringYourAss</IRI>
    <Literal xml:lang="EN">Denying any responsibility to avoid being held accountable for one's actions or words.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coveringYourAss</IRI>
    <Literal xml:lang="FR">J’ai toujours précisé qu’il y avait un risque non négligeable associé à notre nouvelle stratégie marketing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coveringYourAss</IRI>
    <Literal xml:lang="EN">I always mentioned there was a significant risk associated with our new marketing strategy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coveringYourAss</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cover_your_ass</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coveringYourAss</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coveringYourAss</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseFront</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseFront</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseFront</IRI>
    <Literal xml:lang="FR">Appel à l’absence de préjugés</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseFront</IRI>
    <Literal xml:lang="EN">False front</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseFront</IRI>
    <Literal xml:lang="FR">Vous affirmez n’avoir aucun biais, mais vos propos révèlent rapidement le contraire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseFront</IRI>
    <Literal xml:lang="EN">Claiming to be unbiased while one's statements quickly reveal the opposite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseFront</IRI>
    <Literal xml:lang="FR">Je ne suis pas sexiste, mais il est évident que les hommes sont plus adaptés à certains emplois que les femmes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseFront</IRI>
    <Literal xml:lang="EN">I'm not sexist, but it's clear that men are better suited for certain jobs than women.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseFront</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Not_prejudiced,_but_._._.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseFront</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseFront</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hedging</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
    <Literal xml:lang="FR">Porte de sortie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
    <Literal xml:lang="EN">Escape hatch</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
    <Literal xml:lang="FR">Vous préparez un moyen rapide de détourner ou d’abandonner un argument dès que vous êtes mis sous pression.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
    <Literal xml:lang="EN">Preparing a quick way to deflect or drop an argument as soon as pressure mounts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
    <Literal xml:lang="FR">Bien sûr, si des preuves contraires sont présentées, je serai prêt à reconsidérer ma position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
    <Literal xml:lang="EN">Of course, if contrary evidence is presented, I would be open to reconsidering my position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Escape_hatch</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#havingYourCakeAndEatingItToo</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whatsTheHarm</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whatsTheHarm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whatsTheHarm</IRI>
    <Literal xml:lang="FR">Où est le mal ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whatsTheHarm</IRI>
    <Literal xml:lang="EN">What's the harm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whatsTheHarm</IRI>
    <Literal xml:lang="FR">Vous proposez d’explorer une idée simplement parce qu’elle ne semble pas directement nuisible, sans évaluer ses véritables inconvénients ni les alternatives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whatsTheHarm</IRI>
    <Literal xml:lang="EN">Exploring a proposition simply because it seems harmless, without assessing its actual drawbacks or considering alternatives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whatsTheHarm</IRI>
    <Literal xml:lang="FR">Essayons ce nouveau produit. Après tout, s’il ne vous aide pas, il ne pourra pas vraiment vous nuire non plus, n’est-ce pas ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whatsTheHarm</IRI>
    <Literal xml:lang="EN">Let's try this new product. After all, if it doesn't help, it surely won't harm you, will it?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whatsTheHarm</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/What%27s_the_harm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whatsTheHarm</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whatsTheHarm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optionalStarting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optionalStarting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optionalStarting</IRI>
    <Literal xml:lang="FR">Départ optionnel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optionalStarting</IRI>
    <Literal xml:lang="EN">optional starting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optionalStarting</IRI>
    <Literal xml:lang="FR">Vous avancez un argument tout en vous ménageant la possibilité de l’abandonner dès que cela vous arrange.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optionalStarting</IRI>
    <Literal xml:lang="EN">Setting forth an argument while allowing for the possibility of its abandonment when it happens to be convenient.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optionalStarting</IRI>
    <Literal xml:lang="FR">Je ne prétends pas que cette méthode fonctionnera pour tout le monde, mais elle a certainement quelque chose d’unique qui pourrait convenir à certains.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optionalStarting</IRI>
    <Literal xml:lang="EN">I'm not saying this method will work for everyone, but it definitely has something unique that might suit some.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optionalStarting</IRI>
    <Literal xml:lang="EN">http://skepdic.com/opstart.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optionalStarting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optionalStarting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escapeHatch</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <Literal xml:lang="FR">Exigence relâchée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <Literal xml:lang="EN">Weaker demands</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <Literal xml:lang="FR">Vous abaissez vos exigences pour défendre une position difficilement défendable, ce qui dénature le débat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <Literal xml:lang="EN">Lowering one's standards to defend an indefensible position, distorting the debate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <Literal xml:lang="FR">Ce n’était certes pas notre meilleur match, mais il a permis à notre équipe de montrer un vrai potentiel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <Literal xml:lang="EN">Sure, it might not have been our most shining moment, but it allowed our team to showcase its true potential.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <Literal xml:lang="EN">https://www.usingenglish.com/reference/idioms/lower+the+bar.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#movingTheGoalposts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumASilentio</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumASilentio</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumASilentio</IRI>
    <Literal xml:lang="FR">Argumentum a silentio</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumASilentio</IRI>
    <Literal xml:lang="EN">Argumentum a silentio</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumASilentio</IRI>
    <Literal xml:lang="FR">Vous fondez votre raisonnement sur l’absence de preuves, alors que cette absence n’est pas une preuve en soi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumASilentio</IRI>
    <Literal xml:lang="EN">Basing reasoning on the absence of evidence, even though that absence is not evidence in itself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumASilentio</IRI>
    <Literal xml:lang="FR">Les girafes n’existaient pas du temps de Jules César. La preuve, c’est qu’il n’en parle jamais.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumASilentio</IRI>
    <Literal xml:lang="EN">Giraffes did not exist in the time of Julius Caesar. The proof is that he never mentions them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumASilentio</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argument_from_silence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumASilentio</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_a_silentio</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumASilentio</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumASilentio</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialism</IRI>
    <Literal xml:lang="FR">Trivialisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialism</IRI>
    <Literal xml:lang="EN">Trivialism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialism</IRI>
    <Literal xml:lang="FR">Vous affirmez que tout est vrai, ce qui vide de sens la notion même de vérité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialism</IRI>
    <Literal xml:lang="EN">Asserting everything is true, thus nullifying the value of any truth statements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialism</IRI>
    <Literal xml:lang="FR">Toutes les affirmations sont vraies : ce médicament guérit toujours, ne guérit jamais, et les deux à la fois.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialism</IRI>
    <Literal xml:lang="EN">All statements are true: this medicine always cures, never cures, and both at the same time.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Trivialism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingDevilsAdvocate</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingDevilsAdvocate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingDevilsAdvocate</IRI>
    <Literal xml:lang="FR">Se faire l’avocat du diable</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingDevilsAdvocate</IRI>
    <Literal xml:lang="EN">Playing devil's advocate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingDevilsAdvocate</IRI>
    <Literal xml:lang="FR">Vous défendez une position qui n’est pas la vôtre, parfois celle de votre adversaire, pour en tester la solidité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingDevilsAdvocate</IRI>
    <Literal xml:lang="EN">Defending a position that is not one's own, sometimes that of one's opponent, to test its strength.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingDevilsAdvocate</IRI>
    <Literal xml:lang="FR">Je ne dis pas que c’est ce qu’il faut faire, mais je vais défendre un instant la privatisation des biens communs afin de vous montrer les failles de votre argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingDevilsAdvocate</IRI>
    <Literal xml:lang="EN">I am not saying that this is what should be done, but I will defend the privatization of common goods for a moment to show you the flaws in your argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingDevilsAdvocate</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Devil%27s_advocate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingDevilsAdvocate</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Avocat_du_diable</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingDevilsAdvocate</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingDevilsAdvocate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <Literal xml:lang="FR">Argument de l’effort notable</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <Literal xml:lang="EN">Notable effort</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <Literal xml:lang="FR">Vous estimez qu’une idée mérite d’être soutenue uniquement parce que quelqu’un y a beaucoup travaillé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <Literal xml:lang="EN">Claiming one's approach is worth at least for the effort devoted to it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <Literal xml:lang="FR">Peut-être que mon invention ne fonctionne pas encore, mais vous ne pouvez nier que j’y ai travaillé jour et nuit pendant des mois.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <Literal xml:lang="EN">Maybe my invention doesn't work yet, but you can't deny I've been working on it day and night for months.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/137/Notable-Effort</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenism</IRI>
    <Literal xml:lang="FR">Pour la forme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenism</IRI>
    <Literal xml:lang="EN">Tokenism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenism</IRI>
    <Literal xml:lang="FR">Vous considérez un geste symbolique comme un substitut adéquat là où une action réelle serait nécessaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenism</IRI>
    <Literal xml:lang="EN">Considering a symbolic gesture as an adequate substitute where real action is needed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenism</IRI>
    <Literal xml:lang="FR">Pour vous prouver que nous ne sommes pas sexistes, nous avons décidé d’intégrer une femme au conseil d’administration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenism</IRI>
    <Literal xml:lang="EN">To prove that we are not sexist, we have decided to include a woman on the board of directors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenism</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/176/Tokenism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angelDusting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angelDusting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angelDusting</IRI>
    <Literal xml:lang="FR">Poussière d’ange</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angelDusting</IRI>
    <Literal xml:lang="EN">Angel dusting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angelDusting</IRI>
    <Literal xml:lang="FR">Vous attribuez l’efficacité d’un produit à un composant actif présent en quantité infime.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angelDusting</IRI>
    <Literal xml:lang="EN">You attribute a product's effectiveness to an active ingredient present in a minute quantity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angelDusting</IRI>
    <Literal xml:lang="FR">Cette essence de lavande est ce qui confère à cette crème toutes ses propriétés uniques et ses incroyables effets beauté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angelDusting</IRI>
    <Literal xml:lang="EN">This lavender essence gives this cream all its unique properties and incredible beauty results.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angelDusting</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Angel_dusting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angelDusting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angelDusting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="FR">Appel à l’identité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="EN">Appeal to identity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="FR">Sans juger de son bien-fondé, vous évaluez la validité d’une proposition selon la communauté à laquelle appartient son auteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="EN">Evaluating the validity of a proposition based on the community of individuals to which its author belongs, regardless of its merits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="FR">Ces idées sur l’égalité des revenus ? Elles ne peuvent venir que de gens qui n’ont jamais dû travailler dur dans leur vie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="EN">Those ideas about income equality? They can only come from people who have never had to work hard in their lives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_identity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIdentity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenEndorsement</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenEndorsement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenEndorsement</IRI>
    <Literal xml:lang="FR">Appui de principe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenEndorsement</IRI>
    <Literal xml:lang="EN">Token endorsement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenEndorsement</IRI>
    <Literal xml:lang="FR">Vous vous défendez contre une accusation de préjugé en invoquant le soutien d’une seule personne concernée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenEndorsement</IRI>
    <Literal xml:lang="EN">Defending against an accusation of prejudice by relying on the support of just one person concerned.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenEndorsement</IRI>
    <Literal xml:lang="FR">Afin de mettre fin à cette polémique sur la soi-disant islamophobie de notre candidat, écoutons le témoignage d’un musulman qui lui apporte son soutien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenEndorsement</IRI>
    <Literal xml:lang="EN">To put an end to this controversy over our candidate's alleged Islamophobia, let's listen to the testimony of a Muslim who supports him.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenEndorsement</IRI>
    <Literal xml:lang="EN">http://utminers.utep.edu/omwilliamson/ENGL1311/fallacies.htm#4</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenEndorsement</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tokenEndorsement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notableEffort</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="FR">Sophisme des coûts irrécupérables</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="EN">Sunk Cost Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="FR">Vous soutenez qu’il faut persister simplement parce que vous y avez déjà consacré beaucoup de ressources.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="EN">Arguing that one must continue simply because a lot has already been invested.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="FR">Nous ne pouvons pas abandonner le chantier maintenant : pensez à toutes les heures que nous y avons déjà consacrées !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="EN">We can't stop the project now, think of all the hours we've already spent on it!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/173/Sunk-Cost-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Waste_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToClosure</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToClosure</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToClosure</IRI>
    <Literal xml:lang="FR">Tourner la page</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToClosure</IRI>
    <Literal xml:lang="EN">Appeal to closure</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToClosure</IRI>
    <Literal xml:lang="FR">Vous acceptez une conclusion pour mettre fin à une situation pénible, sans véritable justification.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToClosure</IRI>
    <Literal xml:lang="EN">Accepting a conclusion without justification to end a distressing situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToClosure</IRI>
    <Literal xml:lang="FR">Mesdames et messieurs les jurés, une fois cet homme derrière les barreaux, les familles ici présentes pourront enfin démarrer le long parcours de leur deuil.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToClosure</IRI>
    <Literal xml:lang="EN">Ladies and gentlemen of the jury, once this man is behind bars, the families here can finally begin their long journey of mourning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToClosure</IRI>
    <Literal xml:lang="EN">https://utminers.utep.edu/omwilliamson/ENGL1311/fallacies.htm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToClosure</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToClosure</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thatWasYearsAgo</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thatWasYearsAgo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thatWasYearsAgo</IRI>
    <Literal xml:lang="FR">C’était il y a longtemps</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thatWasYearsAgo</IRI>
    <Literal xml:lang="EN">That was years ago</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thatWasYearsAgo</IRI>
    <Literal xml:lang="FR">Vous refusez d’assumer la responsabilité de vos anciennes déclarations en prétendant qu’elles sont trop anciennes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thatWasYearsAgo</IRI>
    <Literal xml:lang="EN">Rejecting responsibility for one's past statements by claiming they are too old.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thatWasYearsAgo</IRI>
    <Literal xml:lang="FR">C’était une erreur de jeunesse, le monde a changé, j’ai beaucoup appris depuis et mes opinions ont évolué avec le temps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thatWasYearsAgo</IRI>
    <Literal xml:lang="EN">It was a mistake of youth, the world has changed, I have learned a lot since then and my opinions have evolved over time.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thatWasYearsAgo</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Fun:Argument_from_oh_bloody_hell_that_was_years_ago</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thatWasYearsAgo</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thatWasYearsAgo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weakerDemands</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <Literal xml:lang="FR">Raisonnement biaisé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <Literal xml:lang="EN">Biased thinking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <Literal xml:lang="FR">Vos biais orientent vos arguments, ce qui vous empêche de juger la situation de manière équilibrée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <Literal xml:lang="EN">Arguing under the influence of a cognitive bias, which hinders the ability to reason in a balanced manner.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <Literal xml:lang="FR">Pour moi, tous les membres de ce groupe se ressemblent ; comment font-ils pour se reconnaître entre eux ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <Literal xml:lang="EN">To me, all the members of this group look alike; how do they recognize one another?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Baconian_method#Idols_of_the_mind_.28idola_mentis.29</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cheating</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#closeMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
    <Literal xml:lang="FR">Biais naturels</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
    <Literal xml:lang="EN">Human nature bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
    <Literal xml:lang="FR">Vos arguments reflètent les limites et les réflexes liés à la perspective humaine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
    <Literal xml:lang="EN">Having arguments reflect the limits and reflexes tied to the human perspective.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
    <Literal xml:lang="FR">La nature est si sage qu’elle a fait passer une rivière dans chaque ville.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
    <Literal xml:lang="EN">Nature is so wise that it made a river run through every city.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Idola_tribus</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Idola_tribus</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
    <Literal xml:lang="FR">Biais d’attention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
    <Literal xml:lang="EN">Attentional bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
    <Literal xml:lang="FR">Vous accordez plus d’attention à certains types d’informations en fonction de vos intérêts ou de votre état émotionnel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
    <Literal xml:lang="EN">Paying more attention to certain types of information based on one's interests or emotional state.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
    <Literal xml:lang="FR">Quand je m’inquiète pour ma santé, je remarque toutes les informations qui parlent de maladies.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
    <Literal xml:lang="EN">When I'm worried about my health, I notice all the information about illnesses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Attentional_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_d%27attention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
    <Literal xml:lang="FR">Effet de contexte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
    <Literal xml:lang="EN">Context effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
    <Literal xml:lang="FR">Votre mémoire est influencée par l’environnement dans lequel vous apprenez une information ou tentez de vous la rappeler.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
    <Literal xml:lang="EN">Having one's memory influenced by the environment in which information is learned or retrieved.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
    <Literal xml:lang="FR">Je me rappelle mieux mon enfance quand je retourne dans cette allée où j’ai tant couru.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
    <Literal xml:lang="EN">I remember my childhood better when I return to that alley where I ran so much.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Context_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <Literal xml:lang="FR">Effet de modalité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <Literal xml:lang="EN">Modality effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <Literal xml:lang="FR">Vous retenez mieux les informations selon leur mode de présentation (visuel, auditif, séquentiel, etc.).</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <Literal xml:lang="EN">Better memory for information presented in a certain modality (serial, visual, auditory, etc.).</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <Literal xml:lang="FR">Je retiens mieux les choses quand je les vois écrites que quand je les entends.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <Literal xml:lang="EN">I remember things better when I see them written than when I hear them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Modality_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
    <Literal xml:lang="FR">Effet de position sérielle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
    <Literal xml:lang="EN">Serial-position effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
    <Literal xml:lang="FR">Vous vous souvenez mieux des premiers et des derniers éléments d’une liste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
    <Literal xml:lang="EN">Better memory of the first and last items in a list.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
    <Literal xml:lang="FR">Dans une liste de courses, je me rappelle souvent les premiers et les derniers articles, mais j’oublie ceux du milieu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
    <Literal xml:lang="EN">In a shopping list, I often remember the beginning and end, but forget the middle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Serial-position_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primacyEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primacyEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primacyEffect</IRI>
    <Literal xml:lang="FR">Effet de primauté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primacyEffect</IRI>
    <Literal xml:lang="EN">Primacy effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primacyEffect</IRI>
    <Literal xml:lang="FR">Vous vous souvenez mieux des premiers éléments d’une série.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primacyEffect</IRI>
    <Literal xml:lang="EN">Better memory for the first items in a series.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primacyEffect</IRI>
    <Literal xml:lang="FR">Je me souviens toujours des premiers points abordés dans une réunion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primacyEffect</IRI>
    <Literal xml:lang="EN">I always remember the first points discussed in a meeting.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primacyEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Serial-position_effect#Primacy_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primacyEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#primacyEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialRecall</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialRecall</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialRecall</IRI>
    <Literal xml:lang="FR">Rappel en série</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialRecall</IRI>
    <Literal xml:lang="EN">Serial recall</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialRecall</IRI>
    <Literal xml:lang="FR">Vous vous souvenez des éléments dans l’ordre où ils ont été présentés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialRecall</IRI>
    <Literal xml:lang="EN">Remembering items in the order they were presented.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialRecall</IRI>
    <Literal xml:lang="FR">Je peux réciter une liste dans l’ordre exact où je l’ai apprise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialRecall</IRI>
    <Literal xml:lang="EN">I can recite a list in the exact order I learned it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialRecall</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Recall_(memory)#Serial_recall</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialRecall</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialRecall</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suffixEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suffixEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suffixEffect</IRI>
    <Literal xml:lang="FR">Effet de suffixe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suffixEffect</IRI>
    <Literal xml:lang="EN">Suffix effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suffixEffect</IRI>
    <Literal xml:lang="FR">Vous avez tendance à oublier les derniers éléments d’une série si ceux-ci sont suivis d’éléments non pertinents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suffixEffect</IRI>
    <Literal xml:lang="EN">Tendency to forget the final items in a series if they are followed by non-relevant items.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suffixEffect</IRI>
    <Literal xml:lang="FR">Je n’arrive pas à me souvenir des derniers mots d’une liste si on me dit autre chose juste après.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suffixEffect</IRI>
    <Literal xml:lang="EN">I can't remember the last words of a list if I'm told something else right after.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suffixEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/List_of_cognitive_biases#Suffix_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suffixEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#suffixEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#serialpositionEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pictureSuperiorityEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pictureSuperiorityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pictureSuperiorityEffect</IRI>
    <Literal xml:lang="FR">Effet de supériorité de l’image</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pictureSuperiorityEffect</IRI>
    <Literal xml:lang="EN">Picture superiority effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pictureSuperiorityEffect</IRI>
    <Literal xml:lang="FR">Vous vous souvenez mieux des images que des mots ou des textes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pictureSuperiorityEffect</IRI>
    <Literal xml:lang="EN">Better memory retention for images than for words or texts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pictureSuperiorityEffect</IRI>
    <Literal xml:lang="FR">Je me souviens mieux des logos des entreprises que de leurs noms.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pictureSuperiorityEffect</IRI>
    <Literal xml:lang="EN">I remember company logos better than their names.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pictureSuperiorityEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Picture_superiority_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pictureSuperiorityEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pictureSuperiorityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
    <Literal xml:lang="FR">Inhibition de la mémoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
    <Literal xml:lang="EN">Memory Inhibition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
    <Literal xml:lang="FR">Vous bloquez involontairement l’accès à certaines informations en mémoire lorsque vous essayez d’en rappeler d’autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
    <Literal xml:lang="EN">Involuntarily inhibiting access to certain information in memory when retrieving other information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
    <Literal xml:lang="FR">Quand j’essaie de me souvenir des noms de tous les étudiants de ma classe, certains noms m’empêchent d’en retrouver d’autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
    <Literal xml:lang="EN">When I try to remember the names of all the students in my class, some names block me from accessing the others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Memory_inhibition#Part-set_cuing_effectt</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#partsetCuingEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#partsetCuingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#partsetCuingEffect</IRI>
    <Literal xml:lang="FR">Effet de rappel partiel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#partsetCuingEffect</IRI>
    <Literal xml:lang="EN">Part-set cuing effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#partsetCuingEffect</IRI>
    <Literal xml:lang="FR">Le fait d’avoir accès à une partie de l’information freine votre capacité à vous rappeler le reste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#partsetCuingEffect</IRI>
    <Literal xml:lang="EN">Access to part of the information can inhibit recall of the rest.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#partsetCuingEffect</IRI>
    <Literal xml:lang="FR">Quand on me donne quelques indices, j’ai du mal à me rappeler du reste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#partsetCuingEffect</IRI>
    <Literal xml:lang="EN">When I'm given a few clues, I have trouble remembering the rest.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#partsetCuingEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Memory_inhibition#Part-set_cuing_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#partsetCuingEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#partsetCuingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrievalInducedForgetting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrievalInducedForgetting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrievalInducedForgetting</IRI>
    <Literal xml:lang="FR">Oubli induit par la récupération</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrievalInducedForgetting</IRI>
    <Literal xml:lang="EN">Retrieval-Induced Forgetting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrievalInducedForgetting</IRI>
    <Literal xml:lang="FR">Vous oubliez des informations liées à celles que vous récupérez activement, à cause du processus de sélection de la mémoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrievalInducedForgetting</IRI>
    <Literal xml:lang="EN">Forgetting information related to what is being actively retrieved due to the memory selection process.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrievalInducedForgetting</IRI>
    <Literal xml:lang="FR">Après avoir étudié intensivement pour mon examen d’histoire européenne, j’ai eu plus de mal à me rappeler des détails de l’histoire américaine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrievalInducedForgetting</IRI>
    <Literal xml:lang="EN">After studying intensively for my European history exam, I found it more difficult to remember details of American history.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrievalInducedForgetting</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Retrieval-induced_forgetting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrievalInducedForgetting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrievalInducedForgetting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#memoryInhibition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theMagicalNumberSeven</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theMagicalNumberSeven</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theMagicalNumberSeven</IRI>
    <Literal xml:lang="FR">Nombre magique sept, plus ou moins deux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theMagicalNumberSeven</IRI>
    <Literal xml:lang="EN">The Magical Number Seven</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theMagicalNumberSeven</IRI>
    <Literal xml:lang="FR">Vous avez tendance à retenir environ sept éléments d’information, à deux près, dans votre mémoire à court terme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theMagicalNumberSeven</IRI>
    <Literal xml:lang="EN">Tending to retain about seven pieces of information (plus or minus two) in short-term memory.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theMagicalNumberSeven</IRI>
    <Literal xml:lang="FR">Je me souviens facilement d’une liste de courses d’environ cinq à neuf articles, mais au-delà, j’oublie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theMagicalNumberSeven</IRI>
    <Literal xml:lang="EN">I easily remember a shopping list of about 5-9 items, but beyond that I forget.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theMagicalNumberSeven</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/The_Magical_Number_Seven,_Plus_or_Minus_Two</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theMagicalNumberSeven</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Le_nombre_magique_sept,_plus_ou_moins_deux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theMagicalNumberSeven</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theMagicalNumberSeven</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuedependentForgetting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuedependentForgetting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuedependentForgetting</IRI>
    <Literal xml:lang="FR">Oubli dépendant des indices</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuedependentForgetting</IRI>
    <Literal xml:lang="EN">Cue-dependent forgetting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuedependentForgetting</IRI>
    <Literal xml:lang="FR">Vous oubliez des informations lorsque les indices contextuels associés à leur mémorisation sont absents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuedependentForgetting</IRI>
    <Literal xml:lang="EN">Forgetting information in the absence of contextual cues associated with its memory.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuedependentForgetting</IRI>
    <Literal xml:lang="FR">Depuis que nous ne nous voyons plus, j’ai oublié l’essentiel de nos discussions passionnées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuedependentForgetting</IRI>
    <Literal xml:lang="EN">Since we no longer see each other, I have forgotten most of our passionate discussions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuedependentForgetting</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cue-dependent_forgetting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuedependentForgetting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cuedependentForgetting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#modalityEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
    <Literal xml:lang="FR">Loi de Weber-Fechner</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
    <Literal xml:lang="EN">Weber–Fechner law</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
    <Literal xml:lang="FR">Vous percevez les changements par rapport à un niveau de référence initial, plutôt que de manière absolue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
    <Literal xml:lang="EN">Perceiving changes relative to an initial reference point rather than absolutely.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
    <Literal xml:lang="FR">Une augmentation de salaire de 100 € semble moins significative quand vous gagnez déjà 3 000 € par mois.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
    <Literal xml:lang="EN">A salary increase of €100 seems less significant when you already earn €3,000 per month.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Weber%E2%80%93Fechner_law</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Loi_de_Weber-Fechner</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <Literal xml:lang="FR">Effet de cadrage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <Literal xml:lang="EN">Framing effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <Literal xml:lang="FR">Vous réagissez différemment selon la manière dont une information ou une situation est présentée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <Literal xml:lang="EN">Reacting differently based on how information or a situation is presented.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <Literal xml:lang="FR">Je préfère une opération avec 90 % de chances de survie à une opération avec 10 % de risque de décès.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <Literal xml:lang="EN">I prefer an operation with a 90% chance of survival than an operation with a 10% chance of death.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Framing_effect_(psychology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Cadrage_(d%C3%A9cision)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="FR">Effet de contraste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="EN">Contrast effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="FR">Votre jugement est influencé par la comparaison d’alternatives contrastées, altérant ainsi votre perception de la valeur ou de la qualité réelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="EN">Having one's judgment influenced by the comparison of contrasting alternatives, thereby altering the perception of their actual value or quality.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="FR">Après avoir vu des appartements minuscules, celui-ci me semble immense, alors qu’il est simplement de taille moyenne.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="EN">After seeing tiny apartments, this one seems huge to me, even though it is simply average-sized.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Contrast_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionBias</IRI>
    <Literal xml:lang="FR">Biais de distinction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionBias</IRI>
    <Literal xml:lang="EN">Distinction bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionBias</IRI>
    <Literal xml:lang="FR">Vous présentez des options similaires de manière à faire surestimer leurs différences.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionBias</IRI>
    <Literal xml:lang="EN">Arguing in a way that presents similar alternatives to emphasize their differences, which can distort the perception of those alternatives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionBias</IRI>
    <Literal xml:lang="FR">Dans la même gamme, je peux vous proposer le nouveau modèle de cette marque que vous connaissez sans doute : il est un peu plus cher, mais il offre ces options supplémentaires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionBias</IRI>
    <Literal xml:lang="EN">In the same category, I can offer you the latest model from this brand you're undoubtedly familiar with. It's a bit pricier but comes with these additional features.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Distinction_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distinctionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="FR">Effet « le moins est meilleur »</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="EN">Less-is-better effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="FR">Vous préférez une option inférieure ou plus modeste lorsqu’elle est évaluée isolément, mais pas lorsqu’elle est comparée directement à d’autres options.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="EN">Preferring a lesser or smaller alternative when evaluated on its own, but not when it is directly compared to other options.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="FR">J’étais tellement heureux avec ma médaille de bronze l’an dernier. Celle d’argent, aujourd’hui, me laisse amer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="EN">I was so happy with my bronze medal last year. This year's silver leaves me feeling bitter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Less-is-better_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lessisbetterEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
    <Literal xml:lang="FR">Effet de Von Restorff</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
    <Literal xml:lang="EN">Von Restorff effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
    <Literal xml:lang="FR">Vous vous souvenez mieux des éléments qui se distinguent nettement du reste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
    <Literal xml:lang="EN">Better memory retention for items that distinctly stand out from others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
    <Literal xml:lang="FR">Dans la liste de courses, je me souviens uniquement de l’article le plus inhabituel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
    <Literal xml:lang="EN">In the shopping list, I only remember the most unusual item.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Von_Restorff_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_von_Restorff</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bizarrenessEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bizarrenessEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bizarrenessEffect</IRI>
    <Literal xml:lang="FR">Effet de bizarrerie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bizarrenessEffect</IRI>
    <Literal xml:lang="EN">Bizarreness effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bizarrenessEffect</IRI>
    <Literal xml:lang="FR">Vous retenez mieux les informations étranges, drôles ou inhabituelles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bizarrenessEffect</IRI>
    <Literal xml:lang="EN">Better memory retention for strange, funny, or unusual information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bizarrenessEffect</IRI>
    <Literal xml:lang="FR">Je me souviens toujours de cette publicité bizarre avec des chats parlants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bizarrenessEffect</IRI>
    <Literal xml:lang="EN">I always remember that weird commercial with talking cats.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bizarrenessEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Bizarreness_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bizarrenessEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bizarrenessEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vonRestorffEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humorEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humorEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humorEffect</IRI>
    <Literal xml:lang="FR">Effet d’humour</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humorEffect</IRI>
    <Literal xml:lang="EN">Humor effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humorEffect</IRI>
    <Literal xml:lang="FR">Vous mémorisez mieux les informations présentées de manière humoristique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humorEffect</IRI>
    <Literal xml:lang="EN">Better memory retention for information presented in a humorous way.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humorEffect</IRI>
    <Literal xml:lang="FR">Je me souviens toujours des blagues que le professeur raconte en cours, mais pas des parties plus ennuyeuses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humorEffect</IRI>
    <Literal xml:lang="EN">I always remember the jokes the professor tells in class, but not the boring parts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humorEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/List_of_cognitive_biases#Humor_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bizarrenessEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humorEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humorEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bizarrenessEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoringEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoringEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoringEffect</IRI>
    <Literal xml:lang="FR">Effet d’ancrage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoringEffect</IRI>
    <Literal xml:lang="EN">Anchoring effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoringEffect</IRI>
    <Literal xml:lang="FR">Vous vous fiez trop fortement à la première information reçue lors de la prise de décisions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoringEffect</IRI>
    <Literal xml:lang="EN">Relying too heavily on the first piece of information received when making decisions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoringEffect</IRI>
    <Literal xml:lang="FR">On m’a d’abord dit que la voiture coûtait 20 000€, donc même après avoir négocié, je pense que payer 18 000€ est une bonne affaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoringEffect</IRI>
    <Literal xml:lang="EN">I was initially told the car cost €20,000, so even after negotiating I think paying €18,000 is a good deal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoringEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Anchoring_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoringEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Ancrage_(psychologie)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoringEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoringEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decoyEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decoyEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decoyEffect</IRI>
    <Literal xml:lang="FR">Effet de leurre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decoyEffect</IRI>
    <Literal xml:lang="EN">Decoy effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decoyEffect</IRI>
    <Literal xml:lang="FR">Vous êtes influencé par une option supplémentaire qui rend une des options existantes plus attrayante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decoyEffect</IRI>
    <Literal xml:lang="EN">Being influenced by an additional option that makes one of the existing options more attractive.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decoyEffect</IRI>
    <Literal xml:lang="FR">Je vais choisir ce produit car il semble meilleur comparé à cette troisème option qui est visiblement moins bonne</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decoyEffect</IRI>
    <Literal xml:lang="EN">I'll choose this product because it looks better compared to this third option which is clearly worse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decoyEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Decoy_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decoyEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_de_domination_asym%C3%A9trique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decoyEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#decoyEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framingEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <Literal xml:lang="FR">Effet d’autoréférence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <Literal xml:lang="EN">Self-reference effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <Literal xml:lang="FR">Vous vous souvenez mieux des informations liées directement à vous-même.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <Literal xml:lang="EN">Remembering information directly related to oneself better.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <Literal xml:lang="FR">Je me souviens des dates d’anniversaire qui sont proches du mien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <Literal xml:lang="EN">I remember birthdays that are close to my own.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Self-reference_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#weber–FechnerLaw</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
    <Literal xml:lang="FR">Biais de mentalisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
    <Literal xml:lang="EN">Mindreading bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
    <Literal xml:lang="FR">Vous pensez savoir ce que les autres ont en tête, souvent en surestimant votre capacité à comprendre leurs pensées et leurs émotions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
    <Literal xml:lang="EN">Believing one knows what others are thinking, often overestimating one's ability to understand their thoughts and emotions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
    <Literal xml:lang="FR">Je sais que mon collègue est en colère contre moi, je peux le voir dans son regard.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
    <Literal xml:lang="EN">I know my colleague is angry with me, I can see it in his eyes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
    <Literal xml:lang="EN">https://cogbtherapy.com/cbt-blog/common-cognitive-distortions-mind-reading</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfTransparency</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfTransparency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfTransparency</IRI>
    <Literal xml:lang="FR">Illusion de transparence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfTransparency</IRI>
    <Literal xml:lang="EN">Illusion of transparency</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfTransparency</IRI>
    <Literal xml:lang="FR">Vous surestimez à quel point vos pensées, émotions ou états mentaux sont apparents aux autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfTransparency</IRI>
    <Literal xml:lang="EN">Overestimating how much one's thoughts, emotions, or mental states are apparent to others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfTransparency</IRI>
    <Literal xml:lang="FR">Je suis sûr que tout le monde peut voir à quel point je suis nerveux pendant cette présentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfTransparency</IRI>
    <Literal xml:lang="EN">I'm sure everyone can see how nervous I am during this presentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfTransparency</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Illusion_of_transparency</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfTransparency</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Illusion_de_transparence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfTransparency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfTransparency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curseOfKnowledge</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curseOfKnowledge</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curseOfKnowledge</IRI>
    <Literal xml:lang="FR">Malédiction de la connaissance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curseOfKnowledge</IRI>
    <Literal xml:lang="EN">Curse of knowledge</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curseOfKnowledge</IRI>
    <Literal xml:lang="FR">Vous avez du mal à imaginer ce que c’est de ne pas savoir quelque chose que vous savez déjà.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curseOfKnowledge</IRI>
    <Literal xml:lang="EN">Having difficulty imagining what it is like not to know something already known.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curseOfKnowledge</IRI>
    <Literal xml:lang="FR">Je ne comprends pas pourquoi ils ne comprennent pas ce concept; il me semble si évident.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curseOfKnowledge</IRI>
    <Literal xml:lang="EN">I don't understand why they don't understand this concept; it seems so obvious to me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curseOfKnowledge</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Curse_of_knowledge</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curseOfKnowledge</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Mal%C3%A9diction_de_la_connaissance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curseOfKnowledge</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curseOfKnowledge</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightEffect</IRI>
    <Literal xml:lang="FR">Effet de projecteur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightEffect</IRI>
    <Literal xml:lang="EN">Spotlight effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightEffect</IRI>
    <Literal xml:lang="FR">Vous surestimez à quel point vos actions ou apparences sont remarquées par les autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightEffect</IRI>
    <Literal xml:lang="EN">Overestimating how much one's actions or appearances are noticed by others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightEffect</IRI>
    <Literal xml:lang="FR">Je suis persuadé que tout le monde a remarqué la petite tache sur ma chemise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightEffect</IRI>
    <Literal xml:lang="EN">I'm sure everyone noticed the little stain on my shirt.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Spotlight_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_de_projecteur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spotlightEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindreadingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfAsymmetricInsight</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfAsymmetricInsight</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfAsymmetricInsight</IRI>
    <Literal xml:lang="FR">Illusion de connaissance asymétrique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfAsymmetricInsight</IRI>
    <Literal xml:lang="EN">Illusion of asymmetric insight</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfAsymmetricInsight</IRI>
    <Literal xml:lang="FR">Vous croyez comprendre les autres mieux qu’ils ne vous comprennent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfAsymmetricInsight</IRI>
    <Literal xml:lang="EN">Believing one understands others better than they understand one.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfAsymmetricInsight</IRI>
    <Literal xml:lang="FR">Je peux facilement lire les autres, mais personne ne semble vraiment me comprendre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfAsymmetricInsight</IRI>
    <Literal xml:lang="EN">I can easily read others, but no one really seems to understand me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfAsymmetricInsight</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Illusion_of_asymmetric_insight</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfAsymmetricInsight</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Illusion_de_connaissance_asym%C3%A9trique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfAsymmetricInsight</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfAsymmetricInsight</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveRealism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveRealism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveRealism</IRI>
    <Literal xml:lang="FR">Réalisme naïf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveRealism</IRI>
    <Literal xml:lang="EN">Naïve realism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveRealism</IRI>
    <Literal xml:lang="FR">Vous croyez que votre perception du monde est la réalité objective.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveRealism</IRI>
    <Literal xml:lang="EN">Believing that one's view of the world is objective reality.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveRealism</IRI>
    <Literal xml:lang="FR">Ma façon de voir les choses est la seule manière correcte de comprendre cette situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveRealism</IRI>
    <Literal xml:lang="EN">My way of seeing things is the only correct way to understand this situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveRealism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Na%C3%AFve_realism_(psychology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveRealism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveRealism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="FR">Sophisme du psychologue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="EN">Psychologist's fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="FR">Vous confondez votre perspective individuelle avec une objectivité universelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="EN">Confusing subjective experience of reality with the essence of that which is being observed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="FR">Je trouve les enfants terrifiants ; vous avez donc beaucoup de mérite à élever le vôtre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="EN">I'm so scared of kids. You are so brave to be raising your own.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Psychologist%27s_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveRealism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveRealism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="FR">Effet de l’expérimentateur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="EN">Experimenter effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="FR">Vos attentes influencent inconsciemment le comportement des autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="EN">One's expectations unconsciously influence the behavior of others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="FR">Mes élèves réussissent mieux quand je m’attends à ce qu’ils réussissent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="EN">My students do better when I expect them to succeed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Observer-expectancy_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_exp%C3%A9rimentateur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfreferenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <Literal xml:lang="FR">Modèle des niveaux de traitement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <Literal xml:lang="EN">Levels of Processing model</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <Literal xml:lang="FR">La manière dont une information est traitée affecte sa mémorisation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <Literal xml:lang="EN">How information is processed affects its memorization.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <Literal xml:lang="FR">Je me souviens mieux des mots que j’ai associés à des images ou des histoires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <Literal xml:lang="EN">I remember words better that I associated with images or stories.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Levels_of_Processing_model</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contextEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nextinlineEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nextinlineEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nextinlineEffect</IRI>
    <Literal xml:lang="FR">Effet suivant-en-ligne</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nextinlineEffect</IRI>
    <Literal xml:lang="EN">Next-in-line effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nextinlineEffect</IRI>
    <Literal xml:lang="FR">Vous avez du mal à retenir des informations présentées juste avant que vous deviez vous exprimer à votre tour.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nextinlineEffect</IRI>
    <Literal xml:lang="EN">Struggling to recall information just before having to perform.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nextinlineEffect</IRI>
    <Literal xml:lang="FR">Rappelez-moi ce que vous disiez juste avant mon tour ; j’étais ailleurs, je n’ai rien retenu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nextinlineEffect</IRI>
    <Literal xml:lang="EN">Remind me what you told me just before it was my turn; I was distracted, I didn't catch it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nextinlineEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Next-in-line_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nextinlineEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nextinlineEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absentmindedness</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absentmindedness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absentmindedness</IRI>
    <Literal xml:lang="FR">Distraction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absentmindedness</IRI>
    <Literal xml:lang="EN">Absent-mindedness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absentmindedness</IRI>
    <Literal xml:lang="FR">Vous oubliez une tâche ou vous n’y prêtez pas attention par manque de concentration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absentmindedness</IRI>
    <Literal xml:lang="EN">Forgetting or failing to pay attention to a task due to a lack of focus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absentmindedness</IRI>
    <Literal xml:lang="FR">Je ne me souviens jamais où j’ai mis mes clés quand je suis distrait.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absentmindedness</IRI>
    <Literal xml:lang="EN">I never remember where I put my keys when I'm distracted.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absentmindedness</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Absent-mindedness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absentmindedness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absentmindedness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#testingEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#testingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#testingEffect</IRI>
    <Literal xml:lang="FR">Effet test</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#testingEffect</IRI>
    <Literal xml:lang="EN">Testing effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#testingEffect</IRI>
    <Literal xml:lang="FR">Vous retenez mieux les informations après les avoir révisées ou testées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#testingEffect</IRI>
    <Literal xml:lang="EN">Better retention of information after revising or being tested on it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#testingEffect</IRI>
    <Literal xml:lang="FR">Après avoir fait des quiz, je me souviens mieux des sujets étudiés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#testingEffect</IRI>
    <Literal xml:lang="EN">After taking quizzes, I remember the subjects studied better.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#testingEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Testing_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#testingEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_test</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#testingEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#testingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spacingEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spacingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spacingEffect</IRI>
    <Literal xml:lang="FR">Effet d’espacement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spacingEffect</IRI>
    <Literal xml:lang="EN">Spacing effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spacingEffect</IRI>
    <Literal xml:lang="FR">Vous retenez mieux les informations réparties sur plusieurs sessions plutôt que concentrées en une seule.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spacingEffect</IRI>
    <Literal xml:lang="EN">Better retention of information spread over multiple sessions than concentrated in a single one.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spacingEffect</IRI>
    <Literal xml:lang="FR">J’apprends mieux en étudiant un peu chaque jour plutôt qu’en faisant une session d’étude intensive.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spacingEffect</IRI>
    <Literal xml:lang="EN">I learn better by studying a little each day rather than doing one intensive study session.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spacingEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Spacing_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spacingEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_d%27espacement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spacingEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spacingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#automationBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#automationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#automationBias</IRI>
    <Literal xml:lang="FR">Biais d’automatisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#automationBias</IRI>
    <Literal xml:lang="EN">Automation bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#automationBias</IRI>
    <Literal xml:lang="FR">Vous dépendez excessivement des systèmes automatisés, parfois au détriment de votre propre jugement ou de vos capacités.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#automationBias</IRI>
    <Literal xml:lang="EN">Relying excessively on automated systems, sometimes at the expense of one's own judgment or abilities.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#automationBias</IRI>
    <Literal xml:lang="FR">Je fais tellement confiance à mon GPS que je ne vérifie même plus la route moi-même.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#automationBias</IRI>
    <Literal xml:lang="EN">I trust my GPS so much that I don't even check the route myself anymore.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#automationBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Automation_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#automationBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#automationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#googleEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#googleEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#googleEffect</IRI>
    <Literal xml:lang="FR">Effet Google</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#googleEffect</IRI>
    <Literal xml:lang="EN">Google Effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#googleEffect</IRI>
    <Literal xml:lang="FR">Vous oubliez les informations facilement accessibles en ligne, en comptant sur la possibilité de les rechercher directement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#googleEffect</IRI>
    <Literal xml:lang="EN">Forgetting about easily accessible information online, relying on the ability to search for it directly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#googleEffect</IRI>
    <Literal xml:lang="FR">Je ne me souviens plus de l’adresse de mon restaurant préféré; je sais que je peux toujours la chercher sur Google.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#googleEffect</IRI>
    <Literal xml:lang="EN">I don't remember the address of my favorite restaurant; I know I can always Google it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#googleEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Google_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#googleEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_Google</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#automationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#googleEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#googleEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#automationBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#generationEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#generationEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#generationEffect</IRI>
    <Literal xml:lang="FR">Effet de génération</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#generationEffect</IRI>
    <Literal xml:lang="EN">Generation effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#generationEffect</IRI>
    <Literal xml:lang="FR">Vous vous souvenez mieux des informations que vous avez générées vous-même.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#generationEffect</IRI>
    <Literal xml:lang="EN">Remembering information better after generating it oneself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#generationEffect</IRI>
    <Literal xml:lang="FR">Je me souviens toujours mieux des réponses aux quiz lorsque je les ai devinées moi-même.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#generationEffect</IRI>
    <Literal xml:lang="EN">I always remember quiz answers better when I guess them myself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#generationEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Generation_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#generationEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#generationEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelsOfProcessingModel</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <Literal xml:lang="FR">Perception sélective</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <Literal xml:lang="EN">Selective perception</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <Literal xml:lang="FR">Vous remarquez et retenez plus facilement les informations qui confirment vos croyances.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <Literal xml:lang="EN">Noticing and retaining more easily information that confirms one's beliefs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <Literal xml:lang="FR">Je ne remarque que les nouvelles qui confirment mes opinions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <Literal xml:lang="EN">I tend to only notice news that confirms my perspectives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Selective_perception</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Perception_s%C3%A9lective</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionalBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <Literal xml:lang="FR">Effet de simple exposition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <Literal xml:lang="EN">Mere-exposure effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <Literal xml:lang="FR">Vous êtes plus enclin à accepter quelque chose simplement parce que cela vous est devenu familier.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <Literal xml:lang="EN">Being more likely to accept something simply because it has become familiar.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <Literal xml:lang="FR">Je préfère voter pour ce parti politique, car son nom et ses idées me sont familiers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <Literal xml:lang="EN">I prefer to vote for this political party because its name and ideas are familiar to me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Mere-exposure_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_de_simple_exposition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Example_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="FR">Effet de vérité illusoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="EN">Illusory truth effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="FR">Vous subissez ou exploitez le fait qu’une information fausse, suffisamment répétée, finit par être acceptée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="EN">Experiencing or exploiting the fact that false information, when repeated enough, eventually comes to be accepted.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="FR">J’ai entendu tellement de fois que ce régime alimentaire fonctionne qu’il doit sûrement être efficace.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="EN">I've heard so many times that this diet works that it must surely be effective.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Illusory_truth_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_de_v%C3%A9rit%C3%A9_illusoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#identifiableVictimEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#identifiableVictimEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#identifiableVictimEffect</IRI>
    <Literal xml:lang="FR">Effet victime identifiable</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#identifiableVictimEffect</IRI>
    <Literal xml:lang="EN">Identifiable victim effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#identifiableVictimEffect</IRI>
    <Literal xml:lang="FR">Vous êtes plus touché par le sort d’une personne identifiable que par celui d’un grand nombre de personnes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#identifiableVictimEffect</IRI>
    <Literal xml:lang="EN">Being more moved by the fate of one identifiable person than by a large number of people.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#identifiableVictimEffect</IRI>
    <Literal xml:lang="FR">L’histoire de cet enfant réfugié m’a plus affecté que les statistiques des millions de personnes déplacées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#identifiableVictimEffect</IRI>
    <Literal xml:lang="EN">The story of this refugee child affected me more than the statistics of millions of displaced people.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#identifiableVictimEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Identifiable_victim_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#identifiableVictimEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_victime_identifiable</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#identifiableVictimEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#identifiableVictimEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="FR">Appel à la nouveauté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="EN">Appeal to novelty</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="FR">Le caractère inédit ou prétendument moderne de votre argument vous suffit pour en garantir la validité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="EN">Arguing that an idea or proposition is good, valid or true solely because it is newer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="FR">Cette technologie vient tout juste de sortir : elle doit donc être la meilleure option. Pourquoi s’embarrasser d’anciens modèles ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="EN">This technology has just been released: it must therefore be the best option. Why bother with old models?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_novelty</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_novitatem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#recencyBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#recencyBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#recencyBias</IRI>
    <Literal xml:lang="FR">Effet de récence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#recencyBias</IRI>
    <Literal xml:lang="EN">Recency bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#recencyBias</IRI>
    <Literal xml:lang="FR">Vous vous souvenez mieux des informations les plus récentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#recencyBias</IRI>
    <Literal xml:lang="EN">Better memory retention for the most recent information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#recencyBias</IRI>
    <Literal xml:lang="FR">Je me souviens mieux du dernier chapitre du livre que j’ai lu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#recencyBias</IRI>
    <Literal xml:lang="EN">I remember the last chapter of the book I read better than the earlier ones.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#recencyBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Recency_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#recencyBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#recencyBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbolicDiscounting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbolicDiscounting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbolicDiscounting</IRI>
    <Literal xml:lang="FR">Escompte hyperbolique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbolicDiscounting</IRI>
    <Literal xml:lang="EN">Hyperbolic discounting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbolicDiscounting</IRI>
    <Literal xml:lang="FR">Vous escomptez en réduisant progressivement votre facteur d’escompte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbolicDiscounting</IRI>
    <Literal xml:lang="EN">Discounting by gradually reducing one's discount factor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbolicDiscounting</IRI>
    <Literal xml:lang="FR">Je veux 50€ maintenant ou 100€ dans un an, ou 300€ dans 3 ans.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbolicDiscounting</IRI>
    <Literal xml:lang="EN">I'd rather have €50 right now than €100 in a year, or €300 in three years. Immediate benefits feel more important to me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbolicDiscounting</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hyperbolic_discounting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbolicDiscounting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbolicDiscounting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
    <Literal xml:lang="FR">Heuristique de disponibilité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
    <Literal xml:lang="EN">Availability heuristic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
    <Literal xml:lang="FR">Vous évaluez la fréquence ou la probabilité d’un événement en fonction de la facilité avec laquelle vous pouvez en rappeler des exemples.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
    <Literal xml:lang="EN">Assessing the frequency or likelihood of an event based on how easily examples can be brought to mind.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
    <Literal xml:lang="FR">Je pense que les accidents d’avion sont plus fréquents car ils sont très médiatisés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
    <Literal xml:lang="EN">I think plane crashes are more common because they are highly publicized.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Availability_heuristic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Heuristique_de_disponibilit%C3%A9</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#frequencyIllusion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#frequencyIllusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#frequencyIllusion</IRI>
    <Literal xml:lang="FR">Illusion de fréquence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#frequencyIllusion</IRI>
    <Literal xml:lang="EN">Frequency illusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#frequencyIllusion</IRI>
    <Literal xml:lang="FR">Vous percevez qu’un élément se produit plus fréquemment une fois qu’il a attiré votre attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#frequencyIllusion</IRI>
    <Literal xml:lang="EN">Perceiving an item as occurring more frequently once it has come to one's attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#frequencyIllusion</IRI>
    <Literal xml:lang="FR">Depuis que j’ai acheté ma voiture, je vois le même modèle partout.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#frequencyIllusion</IRI>
    <Literal xml:lang="EN">Since I bought my car, I see the same model everywhere.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#frequencyIllusion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Frequency_illusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#frequencyIllusion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Illusion_de_fr%C3%A9quence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#frequencyIllusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#frequencyIllusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#availabilityHeuristic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="FR">Effet du lampadaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="EN">Streetlight effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="FR">Vous cherchez vos réponses là où il est facile de regarder, en ignorant des pistes plus importantes mais moins accessibles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="EN">Looking for answers where it is easy to look, while ignoring more important but less accessible leads.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="FR">Nous avons analysé les données de vente des trois derniers mois car elles étaient facilement disponibles, même si elles ne reflètent pas les tendances sur le long terme qui pourraient être plus pertinentes pour notre stratégie de marché.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="EN">We analyzed sales data from the last three months because they were readily available, even though they do not reflect the long-term trends that might be more relevant for our market strategy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Streetlight_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mereexposureEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <Literal xml:lang="FR">Nivellement et accentuation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <Literal xml:lang="EN">Leveling and sharpening</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <Literal xml:lang="FR">Vous simplifiez les souvenirs en éliminant les détails et en exagérant les éléments marquants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <Literal xml:lang="EN">Simplifying memories by omitting details and exaggerating salient elements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <Literal xml:lang="FR">Je me souviens des grandes lignes de l’histoire, mais pas des détails.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <Literal xml:lang="EN">I remember the broad strokes of the story, but not the details.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Leveling_and_sharpening</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#durationNeglect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#durationNeglect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#durationNeglect</IRI>
    <Literal xml:lang="FR">Négligence de la durée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#durationNeglect</IRI>
    <Literal xml:lang="EN">Duration neglect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#durationNeglect</IRI>
    <Literal xml:lang="FR">Vous sous-estimez l’importance de la durée d’une expérience dans son évaluation globale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#durationNeglect</IRI>
    <Literal xml:lang="EN">Underestimating the importance of the length of an experience in its overall evaluation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#durationNeglect</IRI>
    <Literal xml:lang="FR">Peu importe combien de temps cela a duré : c’est le résultat final qui compte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#durationNeglect</IRI>
    <Literal xml:lang="EN">It doesn't matter how long it lasted, it's the end result that matters.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#durationNeglect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Duration_neglect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#durationNeglect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#durationNeglect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#timesavingBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#timesavingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#timesavingBias</IRI>
    <Literal xml:lang="FR">Biais d’économie de temps</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#timesavingBias</IRI>
    <Literal xml:lang="EN">Time-saving bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#timesavingBias</IRI>
    <Literal xml:lang="FR">Vous surestimez le temps que vous gagnerez en augmentant votre vitesse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#timesavingBias</IRI>
    <Literal xml:lang="EN">Overestimating the time saved when increasing speed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#timesavingBias</IRI>
    <Literal xml:lang="FR">Si je conduis plus vite, je gagnerai beaucoup de temps sur mon trajet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#timesavingBias</IRI>
    <Literal xml:lang="EN">If I drive faster, I will save a lot of time on my commute.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#timesavingBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Time-saving_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#timesavingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#timesavingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#peak–endRule</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#peak–endRule</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#peak–endRule</IRI>
    <Literal xml:lang="FR">Règle du pic et de la fin</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#peak–endRule</IRI>
    <Literal xml:lang="EN">Peak–end rule</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#peak–endRule</IRI>
    <Literal xml:lang="FR">Vous jugez une expérience principalement d’après son pic d’intensité et sa fin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#peak–endRule</IRI>
    <Literal xml:lang="EN">Judging an experience mostly on its peak intensity and its end.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#peak–endRule</IRI>
    <Literal xml:lang="FR">Je me souviens surtout du meilleur moment et de la façon dont cela s’est terminé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#peak–endRule</IRI>
    <Literal xml:lang="EN">I mostly remember the best part and how it ended.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#peak–endRule</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Peak%E2%80%93end_rule</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#peak–endRule</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#peak–endRule</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#telescopingEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#telescopingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#telescopingEffect</IRI>
    <Literal xml:lang="FR">Effet télescopique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#telescopingEffect</IRI>
    <Literal xml:lang="EN">Telescoping effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#telescopingEffect</IRI>
    <Literal xml:lang="FR">Vous percevez les événements récents comme plus éloignés dans le temps et les événements plus anciens comme plus proches qu’ils ne le sont réellement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#telescopingEffect</IRI>
    <Literal xml:lang="EN">Perceiving recent events as more remote in time and older events as more recent than they actually are.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#telescopingEffect</IRI>
    <Literal xml:lang="FR">Il me semble que ce concert était l’année dernière, mais en réalité, c’était il y a trois ans.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#telescopingEffect</IRI>
    <Literal xml:lang="EN">It seems to me that this concert was last year, but in reality it was three years ago.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#telescopingEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Telescoping_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#telescopingEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#telescopingEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellTravelledRoadEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellTravelledRoadEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellTravelledRoadEffect</IRI>
    <Literal xml:lang="FR">Effet de la route bien parcourue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellTravelledRoadEffect</IRI>
    <Literal xml:lang="EN">Well travelled road effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellTravelledRoadEffect</IRI>
    <Literal xml:lang="FR">Vous sous-estimez le temps nécessaire pour parcourir un itinéraire familier par rapport à un itinéraire inconnu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellTravelledRoadEffect</IRI>
    <Literal xml:lang="EN">Underestimating the time it takes to travel a familiar route compared to an unfamiliar one.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellTravelledRoadEffect</IRI>
    <Literal xml:lang="FR">Je pense toujours que le trajet pour aller chez mes parents prend moins de temps qu’il ne le fait en réalité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellTravelledRoadEffect</IRI>
    <Literal xml:lang="EN">I always think the drive to my parents takes less time than it actually does.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellTravelledRoadEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Well_travelled_road_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellTravelledRoadEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellTravelledRoadEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hard–easyEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hard–easyEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hard–easyEffect</IRI>
    <Literal xml:lang="FR">Effet dur-facile</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hard–easyEffect</IRI>
    <Literal xml:lang="EN">Hard–easy effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hard–easyEffect</IRI>
    <Literal xml:lang="FR">Vous êtes trop confiant dans vos réponses à des questions difficles et pas assez confiant dans vos réponses à des questions faciles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hard–easyEffect</IRI>
    <Literal xml:lang="EN">Being too confident in one's answers to difficult questions and not confident enough in one's answers to easy questions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hard–easyEffect</IRI>
    <Literal xml:lang="FR">Je doute de ma réponse à cette question simple autant que pour cette question difficile.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hard–easyEffect</IRI>
    <Literal xml:lang="EN">I doubt my answer to this simple question as much as I doubt my answer to this difficult question.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hard–easyEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hard%E2%80%93easy_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hard–easyEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hard–easyEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#riskCompensation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#riskCompensation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#riskCompensation</IRI>
    <Literal xml:lang="FR">Compensation du risque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#riskCompensation</IRI>
    <Literal xml:lang="EN">Risk compensation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#riskCompensation</IRI>
    <Literal xml:lang="FR">Vous prenez plus de risques lorsque vous vous sentez en sécurité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#riskCompensation</IRI>
    <Literal xml:lang="EN">Taking more risks when feeling secure.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#riskCompensation</IRI>
    <Literal xml:lang="FR">Je conduis plus vite avec ma ceinture de sécurité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#riskCompensation</IRI>
    <Literal xml:lang="EN">I drive faster with my seat belt on.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#riskCompensation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Risk_compensation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#riskCompensation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Compensation_du_risque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#riskCompensation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#riskCompensation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#levelingAndSharpening</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="FR">Apophénie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="EN">Apophenia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="FR">Vous identifiez des liens ou des motifs dans des données ou des événements aléatoires, en créant du sens là où il n’y en a pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="EN">Identifying connections or patterns in random or unrelated data or events, creating meanings where none exist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="FR">Chaque fois que je porte ce chapeau, mon équipe gagne. Cela doit être un porte-bonheur !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="EN">Every time I wear this hat, my team wins. It must be a good luck charm!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Apophenia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Apoph%C3%A9nie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selectivePerception</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Sign_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="FR">Insensibilité à la taille de l’échantillon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="EN">Insensitivity to sample size</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="FR">Vous ne tenez pas compte de la taille de l’échantillon lorsque vous évaluez la fiabilité des données.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="EN">Not considering the sample size when evaluating data reliability.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="FR">Je crois à ce sondage, même s’il n’a interrogé que 10 personnes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="EN">I believe in this poll, even though it only asked 10 people.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Insensitivity_to_sample_size</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insensitivityToSampleSize</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="FR">Corrélation illusoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="EN">Illusory correlation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="FR">Vous percevez une relation entre deux variables qui ne sont pas liées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="EN">Perceiving a relationship between two unrelated variables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="FR">Chaque fois que je porte ce pull, mon équipe gagne. Il doit lui porter chance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="EN">Every time I wear this sweater, my team wins. It must bring them luck.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Illusory_correlation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Corr%C3%A9lation_illusoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryCorrelation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfValidity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfValidity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfValidity</IRI>
    <Literal xml:lang="FR">Illusion de validité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfValidity</IRI>
    <Literal xml:lang="EN">Illusion of validity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfValidity</IRI>
    <Literal xml:lang="FR">Vous surestimez vos capacités interprétatives et prédictives en présence de corrélations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfValidity</IRI>
    <Literal xml:lang="EN">Overestimating one's interpretive and predictive abilities in the presence of correlations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfValidity</IRI>
    <Literal xml:lang="FR">Je suis sûr que mon intuition sur les actions à acheter est correcte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfValidity</IRI>
    <Literal xml:lang="EN">I'm sure my intuition about which stocks to buy is correct.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfValidity</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Illusion_of_validity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfValidity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfValidity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="FR">Preuve anecdotique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="EN">Anecdotal evidence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="FR">Vous basez votre argumentation sur un événement isolé, qui ne suffit pas à démontrer une règle générale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="EN">Basing an argument solely on a singular incident, which is insufficient to establish a general rule.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="FR">J’ai eu de bonnes notes en mathématiques après avoir bu du jus de cassis ; le jus de cassis rend donc fort en mathématiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="EN">I got good grades in math after drinking blackcurrant juice; therefore, blackcurrant juice must be good for math.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Anecdotal_evidence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Preuve_anecdotique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#InductiveInference_Scheme_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animisticFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animisticFallacy</IRI>
    <Literal xml:lang="FR">Sophisme animiste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animisticFallacy</IRI>
    <Literal xml:lang="EN">Animistic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animisticFallacy</IRI>
    <Literal xml:lang="FR">Vous prétez aux éléments de la nature ou à des objets inanimés des intentions ou des actions propres aux êtres animés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animisticFallacy</IRI>
    <Literal xml:lang="EN">Attributing intentions or actions to elements of nature or inanimate objects that are typical of living beings.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animisticFallacy</IRI>
    <Literal xml:lang="FR">Les tremblements de terre sont un moyen pour la Terre de nous avertir que nous la traitons mal. C’est sa façon de nous dire de changer nos comportements destructeurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animisticFallacy</IRI>
    <Literal xml:lang="EN">The earthquakes are Earth's way of warning us that we're treating it poorly. It's its way of telling us to change our destructive behaviors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animisticFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Animistic_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropomorphism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropomorphism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropomorphism</IRI>
    <Literal xml:lang="FR">Anthropomorphisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropomorphism</IRI>
    <Literal xml:lang="EN">Anthropomorphism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropomorphism</IRI>
    <Literal xml:lang="FR">Vous attribuez des caractéristiques humaines à des objets, animaux ou phénomènes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropomorphism</IRI>
    <Literal xml:lang="EN">Attributing human characteristics to objects, animals, or phenomena.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropomorphism</IRI>
    <Literal xml:lang="FR">Je pense que ma voiture est heureuse quand je la nettoie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropomorphism</IRI>
    <Literal xml:lang="EN">I think my car is happy when I clean it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropomorphism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Anthropomorphism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropomorphism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Anthropomorphisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropomorphism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anthropomorphism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
    <Literal xml:lang="FR">Biais émotionnels</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
    <Literal xml:lang="EN">Emotional biases</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
    <Literal xml:lang="FR">Votre jugement et votre raisonnement sont influencés par vos émotions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
    <Literal xml:lang="EN">Allowing one's judgment and reasoning to be swayed by current emotions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
    <Literal xml:lang="FR">S’ils veulent la guerre, ils l’auront. Je ne vais pas me laisser impressionner par ces grandes théories.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
    <Literal xml:lang="EN">If they want war, they'll get it. I won't let myself be intimidated by these grand theories.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humanNatureBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
    <Literal xml:lang="FR">Effet de valence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
    <Literal xml:lang="EN">Valence Effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
    <Literal xml:lang="FR">La valence positive ou négative de vos émotions rend votre jugement excessivement optimiste ou pessimiste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
    <Literal xml:lang="EN">Being overly optimistic or pessimistic because of the valence, positive or negative, of the emotions one feels.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
    <Literal xml:lang="FR">Je conduis prudemment : je n’ai pas besoin d’une assurance aussi complète que celle que choisissent la plupart des gens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
    <Literal xml:lang="EN">I drive carefully: I don't need insurance as comprehensive as the kind most people choose.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Optimism_bias#Valence_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
    <Literal xml:lang="FR">Biais de négativité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
    <Literal xml:lang="EN">Negativity bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
    <Literal xml:lang="FR">Vous vous concentrez sur les éléments défavorables et pessimistes, au détriment des aspects positifs possibles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
    <Literal xml:lang="EN">Focusing one's thinking on unfavorable and pessimistic considerations to the detriment of possible positive elements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
    <Literal xml:lang="FR">Le rapport indique que la nouvelle politique a amélioré neuf indicateurs sur dix : moins d’accidents, moins de retards, moins de coûts et une meilleure satisfaction des usagers. Mais je la refuse, parce qu’un indicateur s’est légèrement dégradé. — Biais de négativité : un élément négatif limité pèse plus lourd que plusieurs éléments positifs pourtant importants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
    <Literal xml:lang="EN">The report indicates that the new policy improved nine out of ten indicators: fewer accidents, fewer delays, lower costs, and greater user satisfaction. But I reject it because one indicator declined slightly. — Negativity bias: one limited negative element outweighs several significant positive elements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
    <Literal xml:lang="EN">http://skepdic.com/negativitybias.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#NegativeConsequences_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
    <Literal xml:lang="FR">Biais de pessimisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
    <Literal xml:lang="EN">Pessimism bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
    <Literal xml:lang="FR">Vous sous-estimez les probabilités d’événements positifs et surestimez celles des événements négatifs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
    <Literal xml:lang="EN">Underestimating the likelihood of positive events and overestimating those of negative events.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
    <Literal xml:lang="FR">Tout va mal tourner.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
    <Literal xml:lang="EN">Everything will go wrong.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Optimism_bias#Pessimism_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversePsychology</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversePsychology</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversePsychology</IRI>
    <Literal xml:lang="FR">Psychologie inversée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversePsychology</IRI>
    <Literal xml:lang="EN">Reverse psychology</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversePsychology</IRI>
    <Literal xml:lang="FR">Vous faites le contraire de ce qu’on vous demande, en pensant que c’est ce que l’autre personne veut vraiment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversePsychology</IRI>
    <Literal xml:lang="EN">Doing the opposite of what one is told, thinking it's what the other person really wants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversePsychology</IRI>
    <Literal xml:lang="FR">Il dit que je ne devrais pas acheter cette voiture, donc il doit vraiment penser que c’est un bon achat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversePsychology</IRI>
    <Literal xml:lang="EN">He says I shouldn't buy this car, so he must really think it's a good buy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversePsychology</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Reverse_psychology</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversePsychology</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Psychologie_invers%C3%A9e</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversePsychology</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reversePsychology</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#murphysLaw</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#murphysLaw</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#murphysLaw</IRI>
    <Literal xml:lang="FR">Loi de Murphy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#murphysLaw</IRI>
    <Literal xml:lang="EN">Murphy's law</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#murphysLaw</IRI>
    <Literal xml:lang="FR">Vous croyez que si quelque chose peut mal tourner, cela arrivera probablement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#murphysLaw</IRI>
    <Literal xml:lang="EN">Believing that if something can go wrong, it probably will.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#murphysLaw</IRI>
    <Literal xml:lang="FR">Dès que je suis pressé, il y a toujours des embouteillages.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#murphysLaw</IRI>
    <Literal xml:lang="EN">Whenever I'm in a hurry, there are always traffic jams.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#murphysLaw</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Murphy's_law</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#murphysLaw</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Loi_de_Murphy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#murphysLaw</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#murphysLaw</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
    <Literal xml:lang="FR">Pensée à somme nulle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
    <Literal xml:lang="EN">Zero-sum thinking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
    <Literal xml:lang="FR">Vous considérez que les ressources sont limitées, de sorte que le gain de l’un est forcément la perte de l’autre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
    <Literal xml:lang="EN">Viewing resources as limited in such a way that one's gain is necessarily another's loss.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
    <Literal xml:lang="FR">Si mon collègue est promu, ça signifie que je ne le serai pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
    <Literal xml:lang="EN">If my colleague is promoted, that means I won't be.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Zero-sum_thinking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pens%C3%A9e_%C3%A0_somme_nulle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pessimismBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lumpOfLabourFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lumpOfLabourFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lumpOfLabourFallacy</IRI>
    <Literal xml:lang="FR">Sophisme d’une masse fixe de travail</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lumpOfLabourFallacy</IRI>
    <Literal xml:lang="EN">Lump of labour fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lumpOfLabourFallacy</IRI>
    <Literal xml:lang="FR">Vous assumez à tort que la quantité de travail disponible dans une économie est fixe, ignorant le potentiel de création d’emplois.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lumpOfLabourFallacy</IRI>
    <Literal xml:lang="EN">Erroneously assuming that the amount of available work in an economy is fixed, overlooking the potential for job creation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lumpOfLabourFallacy</IRI>
    <Literal xml:lang="FR">Je crois que l’immigration réduit les emplois disponibles pour les citoyens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lumpOfLabourFallacy</IRI>
    <Literal xml:lang="EN">I believe that immigration reduces the jobs available to citizens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lumpOfLabourFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Lump_of_labour_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lumpOfLabourFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme_d%27une_masse_fixe_de_travail</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lumpOfLabourFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lumpOfLabourFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zerosumThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <Literal xml:lang="FR">Distorsion cognitive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <Literal xml:lang="EN">Cognitive distortion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <Literal xml:lang="FR">Vous interprétez les événements de manière irrationnelle, souvent de façon trop positive ou trop négative, sans preuves concrètes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <Literal xml:lang="EN">Interpreting events irrationally, often seeing them as overly positive or negative without concrete evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <Literal xml:lang="FR">Je suis sûr que tout le monde me déteste, car personne ne m’a parlé à la fête.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <Literal xml:lang="EN">I'm convinced everyone hates me because nobody talked to me at the party.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#negativityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
    <Literal xml:lang="FR">Filtrage mental</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
    <Literal xml:lang="EN">Mental filtering</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
    <Literal xml:lang="FR">Vous vous concentrez uniquement sur les aspects négatifs d’une situation, en écartant tous les aspects positifs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
    <Literal xml:lang="EN">Focusing only on the negative aspects of a situation, filtering out all positive aspects.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
    <Literal xml:lang="FR">Je ne vois que les erreurs que j’ai faites dans le rapport, pas les parties réussies.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
    <Literal xml:lang="EN">I only see the mistakes I made in the report, not the successful parts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Mental_filtering</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disqualifyingThePositive</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disqualifyingThePositive</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disqualifyingThePositive</IRI>
    <Literal xml:lang="FR">Disqualification du positif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disqualifyingThePositive</IRI>
    <Literal xml:lang="EN">Disqualifying the positive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disqualifyingThePositive</IRI>
    <Literal xml:lang="FR">Vous rejetez les expériences positives en affirmant qu’elles ne comptent pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disqualifyingThePositive</IRI>
    <Literal xml:lang="EN">Rejecting positive experiences by insisting they don't count.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disqualifyingThePositive</IRI>
    <Literal xml:lang="FR">Ce compliment ne compte pas, il était juste poli.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disqualifyingThePositive</IRI>
    <Literal xml:lang="EN">That compliment doesn't count, they were just being polite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disqualifyingThePositive</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Disqualifying_the_positive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disqualifyingThePositive</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#La_disqualification_du_positif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disqualifyingThePositive</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disqualifyingThePositive</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="FR">Amplification et minimisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="EN">Magnification and minimization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="FR">Vous exagérez l’importance des problèmes ou minimisez l’importance de vos réussites.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="EN">Exaggerating the importance of problems or minimizing the importance of one's successes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="FR">Mon succès dans ce projet n’est pas si important, et puis ce que vous appelez échec mineur est pour moi un désastre total.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="EN">My success in this project is not that important, and then what you call a minor failure is a total disaster for me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Magnification_and_minimization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#Amplification_et_minimisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magnificationAndMinimization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mentalFiltering</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="FR">Fausses obligations</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="EN">Should/shouldn't and must/mustn't statements</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="FR">Vous utilisez des déclarations impératives comme "doit" ou "ne doit pas", imposant des attentes irréalistes à vous-même ou aux autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="EN">Using imperative statements like "must" or "should", imposing unrealistic expectations on oneself or others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="FR">Je devrais toujours être capable de contrôler mes émotions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="EN">I should always be able to control my emotions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Should/shouldn't_and_must/mustn't_statements</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#Fausses_obligations</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#should/shouldntAndMust/mustntStatements</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="FR">Piège de gratitude</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="EN">Gratitude trap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="FR">Vous vous sentez coupable ou frustré parce que vous pensez que vous devriez être plus reconnaissant dans votre situation actuelle, ou vous utilisez ce sentiment d’autrui pour asseoir votre contrôle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="EN">Feeling guilty or frustrated because of thinking one should be more grateful in one's current situation, or using this feeling in others to assert one's control.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="FR">Je devrais être heureux d’avoir un emploi, même si je le déteste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="EN">I should be happy to have a job, even though I hate it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Gratitude_trap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cognitiveDistortion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <Literal xml:lang="FR">Biais d’autocomplaisance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <Literal xml:lang="EN">Self-serving bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <Literal xml:lang="FR">Vous attribuez vos succès à vos propres mérites et vos échecs à des facteurs extérieurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <Literal xml:lang="EN">Attributing successes to one's own merits and failures to external factors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <Literal xml:lang="FR">J’ai réussi grâce à mon intelligence, mais j’ai échoué à cause de questions injustes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <Literal xml:lang="EN">I succeeded because of my intelligence, but I failed because of unfair questions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Self-serving_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_d%27autocomplaisance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#valenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#PositiveConsequences_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <Literal xml:lang="FR">Biais d’optimisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <Literal xml:lang="EN">Optimism bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <Literal xml:lang="FR">Vous croyez être moins exposé que les autres aux événements négatifs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <Literal xml:lang="EN">Believing oneself less likely than others to have negative experiences.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <Literal xml:lang="FR">Je ne pense pas que je serai un jour licencié ; je suis trop compétent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <Literal xml:lang="EN">I don't think I'll ever be fired; I'm too competent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Optimism_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_d%27optimisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#planningFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#planningFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#planningFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de planification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#planningFallacy</IRI>
    <Literal xml:lang="EN">Planning fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#planningFallacy</IRI>
    <Literal xml:lang="FR">Vous sous-estimez systématiquement le temps nécessaire pour réaliser une activité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#planningFallacy</IRI>
    <Literal xml:lang="EN">Systematically underestimating the time needed to complete a task.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#planningFallacy</IRI>
    <Literal xml:lang="FR">Ce projet est simple. Comptez sur moi pour le terminer en une semaine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#planningFallacy</IRI>
    <Literal xml:lang="EN">This project is simple. Expect me to finish it within a week.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#planningFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Planning_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#planningFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#planningFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proinnovationBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proinnovationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proinnovationBias</IRI>
    <Literal xml:lang="FR">Biais pro-innovation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proinnovationBias</IRI>
    <Literal xml:lang="EN">Pro-innovation bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proinnovationBias</IRI>
    <Literal xml:lang="FR">Vous surestimez la valeur ou l’utilité des innovations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proinnovationBias</IRI>
    <Literal xml:lang="EN">Overestimating the value or usefulness of innovations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proinnovationBias</IRI>
    <Literal xml:lang="FR">Cette nouvelle technologie va résoudre tous nos problèmes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proinnovationBias</IRI>
    <Literal xml:lang="EN">This new technology will solve all our problems.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proinnovationBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pro-innovation_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proinnovationBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proinnovationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivityEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivityEffect</IRI>
    <Literal xml:lang="FR">Effet de positivité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivityEffect</IRI>
    <Literal xml:lang="EN">Positivity effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivityEffect</IRI>
    <Literal xml:lang="FR">Vous vous souvenez mieux des aspects positifs d’une personne ou d’une expérience au fil du temps en tirant les leçons des aspects négatifs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivityEffect</IRI>
    <Literal xml:lang="EN">Better recall of the positive aspects of a person or experience over time by learning from the negative aspects.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivityEffect</IRI>
    <Literal xml:lang="FR">En me remémorant le passé, je me souviens surtout des bons moments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivityEffect</IRI>
    <Literal xml:lang="EN">Looking back on the past, I mostly remember the good times.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivityEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Positivity_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivityEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#positivityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#optimismBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <Literal xml:lang="FR">Supériorité illusoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <Literal xml:lang="EN">Illusory superiority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <Literal xml:lang="FR">Vous surestimez vos propres qualités et capacités par rapport à celles des autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <Literal xml:lang="EN">Overestimating one's own qualities and abilities compared to those of others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <Literal xml:lang="FR">Je suis un meilleur conducteur que la plupart des gens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <Literal xml:lang="EN">I'm a better driver than most people.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Illusory_superiority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sup%C3%A9riorit%C3%A9_illusoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasBlindSpot</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasBlindSpot</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasBlindSpot</IRI>
    <Literal xml:lang="FR">Angle mort du biais</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasBlindSpot</IRI>
    <Literal xml:lang="EN">Bias blind spot</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasBlindSpot</IRI>
    <Literal xml:lang="FR">Vous êtes moins conscient de vos propres biais que de ceux des autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasBlindSpot</IRI>
    <Literal xml:lang="EN">Being less aware of one's own biases than those of others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasBlindSpot</IRI>
    <Literal xml:lang="FR">Je suis objectif dans mes opinions, mais les autres sont souvent biaisés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasBlindSpot</IRI>
    <Literal xml:lang="EN">I am objective in my opinions, but others are often biased.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasBlindSpot</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Bias_blind_spot</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasBlindSpot</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Tache_aveugle_%C3%A0_l%27%C3%A9gard_des_pr%C3%A9jug%C3%A9s</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasBlindSpot</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasBlindSpot</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveCynicism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveCynicism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveCynicism</IRI>
    <Literal xml:lang="FR">Cynisme naïf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveCynicism</IRI>
    <Literal xml:lang="EN">Naïve cynicism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveCynicism</IRI>
    <Literal xml:lang="FR">Vous supposez que les autres sont plus égoïstes et manipulateurs que vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveCynicism</IRI>
    <Literal xml:lang="EN">Assuming others are more selfish and manipulative than oneself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveCynicism</IRI>
    <Literal xml:lang="FR">Les gens font semblant d’être gentils, mais ils ont tous un agenda caché.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveCynicism</IRI>
    <Literal xml:lang="EN">People pretend to be nice, but they all have a hidden agenda.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveCynicism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Na%C3%AFve_cynicism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveCynicism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naïveCynicism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lakeWobegonEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lakeWobegonEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lakeWobegonEffect</IRI>
    <Literal xml:lang="FR">Effet lac Wobegon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lakeWobegonEffect</IRI>
    <Literal xml:lang="EN">Lake Wobegon effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lakeWobegonEffect</IRI>
    <Literal xml:lang="FR">Vous croyez être supérieur à la moyenne dans divers domaines, même en l’absence de preuves.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lakeWobegonEffect</IRI>
    <Literal xml:lang="EN">Believing one is above average in various areas, even in the absence of evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lakeWobegonEffect</IRI>
    <Literal xml:lang="FR">Je suis sûr d’être plus intelligent que la moyenne des gens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lakeWobegonEffect</IRI>
    <Literal xml:lang="EN">I'm sure I'm smarter than the average person.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lakeWobegonEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Lake_Wobegon#The_Lake_Wobegon_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lakeWobegonEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lakeWobegonEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thirdpersonEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thirdpersonEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thirdpersonEffect</IRI>
    <Literal xml:lang="FR">Effet du tiers</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thirdpersonEffect</IRI>
    <Literal xml:lang="EN">Third-person effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thirdpersonEffect</IRI>
    <Literal xml:lang="FR">Vous pensez que les messages médiatiques affectent les autres plus qu’ils ne vous affectent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thirdpersonEffect</IRI>
    <Literal xml:lang="EN">Believing that media messages affect others more than they affect oneself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thirdpersonEffect</IRI>
    <Literal xml:lang="FR">Les publicités n’ont aucun effet sur moi, mais elles influencent sûrement les autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thirdpersonEffect</IRI>
    <Literal xml:lang="EN">The ads have no effect on me, but they sure influence others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thirdpersonEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Third-person_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thirdpersonEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thirdpersonEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusorySuperiority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <Literal xml:lang="FR">Excès de confiance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <Literal xml:lang="EN">Overconfidence effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <Literal xml:lang="FR">Vous avez une confiance excessive dans la justesse de vos croyances ou de vos prédictions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <Literal xml:lang="EN">Having excessive confidence in the correctness of one's beliefs or predictions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <Literal xml:lang="FR">Je suis sûr à 100 % que mon équipe va gagner le match.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <Literal xml:lang="EN">I am 100% sure that my team will win the match.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Overconfidence_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Exc%C3%A8s_de_confiance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfservingBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfControl</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfControl</IRI>
    <Literal xml:lang="FR">Illusion de maîtrise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfControl</IRI>
    <Literal xml:lang="EN">Illusion of control</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfControl</IRI>
    <Literal xml:lang="FR">Vous pensez pouvoir contrôler ou influencer des événements sur lesquels vous n’avez en réalité que peu ou pas d’influence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfControl</IRI>
    <Literal xml:lang="EN">Believing one can control or influence events over which one actually has little to no influence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfControl</IRI>
    <Literal xml:lang="FR">Je suis sûr que si je porte mon maillot porte-bonheur, mon équipe va gagner.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfControl</IRI>
    <Literal xml:lang="EN">I'm sure that if I wear my lucky jersey, my team will win.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfControl</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Illusion_of_control</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfControl</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Illusion_de_ma%C3%AEtrise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfControl</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#restraintBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#restraintBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#restraintBias</IRI>
    <Literal xml:lang="FR">Biais de retenue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#restraintBias</IRI>
    <Literal xml:lang="EN">Restraint bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#restraintBias</IRI>
    <Literal xml:lang="FR">Vous surestimez votre capacité à contrôler vos impulsions ou comportements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#restraintBias</IRI>
    <Literal xml:lang="EN">Overestimating one's ability to control impulses or behaviors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#restraintBias</IRI>
    <Literal xml:lang="FR">Je peux arrêter de fumer quand je veux, je ne suis pas dépendant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#restraintBias</IRI>
    <Literal xml:lang="EN">I can quit smoking whenever I want, I'm not addicted.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#restraintBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Restraint_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#restraintBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#restraintBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extrinsicIncentivesBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extrinsicIncentivesBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extrinsicIncentivesBias</IRI>
    <Literal xml:lang="FR">Biais d’incitations extrinsèques</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extrinsicIncentivesBias</IRI>
    <Literal xml:lang="EN">Extrinsic incentives bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extrinsicIncentivesBias</IRI>
    <Literal xml:lang="FR">Vous sous-estimez l’impact des récompenses externes sur votre propre motivation et comportement.
</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extrinsicIncentivesBias</IRI>
    <Literal xml:lang="EN">Underestimating the impact of external rewards on one's own motivation and behavior.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extrinsicIncentivesBias</IRI>
    <Literal xml:lang="FR">Je travaille dur parce que j’aime mon travail, pas à cause du bonus que je pourrais recevoir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extrinsicIncentivesBias</IRI>
    <Literal xml:lang="EN">I work hard because I love my job, not because of the bonus I might receive.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extrinsicIncentivesBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Extrinsic_incentives_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extrinsicIncentivesBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#extrinsicIncentivesBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseConsensusEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseConsensusEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseConsensusEffect</IRI>
    <Literal xml:lang="FR">Effet de faux consensus</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseConsensusEffect</IRI>
    <Literal xml:lang="EN">False consensus effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseConsensusEffect</IRI>
    <Literal xml:lang="FR">Vous surestimez le degré auquel les autres partagent vos opinions et comportements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseConsensusEffect</IRI>
    <Literal xml:lang="EN">Overestimating the degree to which others share one's opinions and behaviors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseConsensusEffect</IRI>
    <Literal xml:lang="FR">Tout le monde doit détester se lever tôt comme moi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseConsensusEffect</IRI>
    <Literal xml:lang="EN">Everyone surely hates getting up early just as I do.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseConsensusEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/False_consensus_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseConsensusEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_de_faux_consensus</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseConsensusEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#falseConsensusEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overconfidenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="FR">Raisonnement émotionnel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="EN">Emotional reasoning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="FR">Vous considérez que quelque chose est vrai parce que vous le ressentez fortement, même en l’absence de preuve.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="EN">Believing something to be true because it is felt strongly, even in the absence of evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="FR">Je me sens nul, donc je dois vraiment être nul.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="EN">I feel worthless, therefore I must be worthless.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Emotional_reasoning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Raisonnement_%C3%A9motionnel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="FR">Pensée dichotomique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="EN">Dichotomous thinking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="FR">Vous raisonnez en tout ou rien, sans nuance : si vous n’êtes pas parfait, vous vous considérez comme un échec total.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="EN">Reasoning in all-or-nothing terms, without nuance: if one is not perfect, considering oneself a complete failure.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="FR">Soit j’ai la moyenne, soit je suis complètement nul. — Dichotomie : il n’existe aucune autre note entre « moyenne » et « complètement nul », alors que la notation sur /20 offre une granularité bien plus fine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="EN">Either I get a passing grade, or I’m completely hopeless. — Dichotomy: there is no other grade between “passing” and “completely hopeless,” even though a 20-point grading scale offers much finer granularity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Splitting_(psychology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#Fractionnement_(pens%C3%A9e_%C2%AB_tout_ou_rien_%C2%BB,_pens%C3%A9e_%C2%AB_noir_ou_blanc_%C2%BB,_pens%C3%A9e_dichotomique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeroriskBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeroriskBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeroriskBias</IRI>
    <Literal xml:lang="FR">Biais du risque zéro</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeroriskBias</IRI>
    <Literal xml:lang="EN">Zero-risk bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeroriskBias</IRI>
    <Literal xml:lang="FR">Vous préférez éliminer un petit risque complètement plutôt que de réduire un plus grand risque.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeroriskBias</IRI>
    <Literal xml:lang="EN">Preferring to completely eliminate a small risk rather than reducing a larger risk.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeroriskBias</IRI>
    <Literal xml:lang="FR">Je préfère que vous me débarrassiez de cette petite tâche qui m’encombre. Je gérerai le plus gros.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeroriskBias</IRI>
    <Literal xml:lang="EN">I'd prefer you take care of this small bothersome task. I'll manage the bigger one.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeroriskBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Zero-risk_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeroriskBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeroriskBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudocertaintyEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudocertaintyEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudocertaintyEffect</IRI>
    <Literal xml:lang="FR">Effet de pseudo-certitude</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudocertaintyEffect</IRI>
    <Literal xml:lang="EN">Pseudocertainty effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudocertaintyEffect</IRI>
    <Literal xml:lang="FR">Vous considérez un résultat comme certain alors qu’il reste incertain dans une décision à plusieurs étapes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudocertaintyEffect</IRI>
    <Literal xml:lang="EN">Perceiving an outcome as certain when it is actually uncertain in multi-step decision-making.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudocertaintyEffect</IRI>
    <Literal xml:lang="FR">Après avoir réussi la première étape du jeu, je suis sûr de pouvoir terminer sans problème.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudocertaintyEffect</IRI>
    <Literal xml:lang="EN">After getting through the first step of the game, I'm certain I can finish it without any problem.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudocertaintyEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pseudocertainty_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudocertaintyEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pseudocertaintyEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="FR">Généralisation abusive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="EN">Faulty generalisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="FR">Vous faites une généralisation qui n’est pas valide dans cette situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="EN">Using a generalisation rule which is invalid in the considered situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="FR">Mes chats ont toujours été très doux ; les chats sont donc des animaux inoffensifs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="EN">My cats have always been sweet; therefore, cats must be harmless animals.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Faulty_generalization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/G%C3%A9n%C3%A9ralisation#Le_sophisme_de_la_g.C3.A9n.C3.A9ralisation_abusive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#faultyGeneralisation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguityEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguityEffect</IRI>
    <Literal xml:lang="FR">Effet d’ambiguïté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguityEffect</IRI>
    <Literal xml:lang="EN">Ambiguity effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguityEffect</IRI>
    <Literal xml:lang="FR">Vous évitez les options avec des résultats incertains ou inconnus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguityEffect</IRI>
    <Literal xml:lang="EN">Avoiding options with uncertain or unknown outcomes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguityEffect</IRI>
    <Literal xml:lang="FR">Je préfère les choix clairs et définis, même s’ils ne sont pas les meilleurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguityEffect</IRI>
    <Literal xml:lang="EN">I prefer clear and defined choices, even if they are not the best.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguityEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ambiguity_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguityEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ambiguityEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neglectOfProbabilityBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neglectOfProbabilityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neglectOfProbabilityBias</IRI>
    <Literal xml:lang="FR">Biais de négligence de la probabilité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neglectOfProbabilityBias</IRI>
    <Literal xml:lang="EN">Neglect of probability bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neglectOfProbabilityBias</IRI>
    <Literal xml:lang="FR">Vous ignorez ou minimisez la probabilité d’événements dans vos évaluations et prises de décision.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neglectOfProbabilityBias</IRI>
    <Literal xml:lang="EN">Ignoring or minimizing the probability of events in one's evaluations and decision-making.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neglectOfProbabilityBias</IRI>
    <Literal xml:lang="FR">Je ne veux pas aller me faire soigner à l’hopital car on y attrape des maladies.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neglectOfProbabilityBias</IRI>
    <Literal xml:lang="EN">I don't want to go to the hospital for treatment because you catch illnesses there.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neglectOfProbabilityBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ambiguity_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neglectOfProbabilityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neglectOfProbabilityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dichotomousThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <Literal xml:lang="FR">Prédiction affective</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <Literal xml:lang="EN">Affective forecasting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <Literal xml:lang="FR">Vous prédisez votre état émotionnel futur, souvent en surestimant l’intensité ou la durée de vos réactions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <Literal xml:lang="EN">Predicting one's future emotional state, often overestimating the intensity or duration of one's affective reactions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <Literal xml:lang="FR">Je sais que je vais regretter cette décision : demain, je me sentirai terriblement mal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <Literal xml:lang="EN">I know I'm going to regret this decision. I'll feel terrible about it tomorrow.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Affective_forecasting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="FR">Conclusion hâtive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="EN">Hasty conclusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="FR">Vous tirez des conclusions trop vite, sans disposer de preuves suffisantes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="EN">Drawing logical consequences from facts which are insufficient to support such an entailment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="FR">Cette gamelle est remplie de croquettes ; il y a donc forcément un chat dans la maison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="EN">There is catfood in that bowl, therefore there is a cat in the house.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Jumping_to_conclusions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyConclusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#expectationEffects</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#expectationEffects</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#expectationEffects</IRI>
    <Literal xml:lang="FR">Effet d’attente</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#expectationEffects</IRI>
    <Literal xml:lang="EN">Expectation effects</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#expectationEffects</IRI>
    <Literal xml:lang="FR">Vos attentes préalables modifient la façon dont vous vivez réellement l’événement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#expectationEffects</IRI>
    <Literal xml:lang="EN">Having one's prior expectations alter one's actual experience of the event.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#expectationEffects</IRI>
    <Literal xml:lang="FR">Je m’attendais à détester ce concert de jazz ; malgré la qualité de la performance, je ne l’ai pas apprécié.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#expectationEffects</IRI>
    <Literal xml:lang="EN">I was expecting to hate this jazz concert; despite the quality of the performance, I didn't enjoy it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#expectationEffects</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Affective_forecasting#Expectation_effects</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#expectationEffects</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#expectationEffects</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
    <Literal xml:lang="FR">Constructions erronnées</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
    <Literal xml:lang="EN">Misconstruals</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
    <Literal xml:lang="FR">Vous construisez une représentation imparfaite d’un événement futur, menant à des prédictions inexactes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
    <Literal xml:lang="EN">Constructing an imperfect representation of a future event, leading to inaccurate predictions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
    <Literal xml:lang="FR">Je pensais que le travail à distance serait relaxant, sans réaliser à quel point les distractions à la maison affecteraient ma productivité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
    <Literal xml:lang="EN">I thought working from home would be relaxing, not realizing how much home distractions would affect my productivity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Affective_forecasting#Misconstruals</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#focalism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#focalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#focalism</IRI>
    <Literal xml:lang="FR">Focalisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#focalism</IRI>
    <Literal xml:lang="EN">Focalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#focalism</IRI>
    <Literal xml:lang="FR">Vous vous concentrez trop sur certains aspects d’un événement futur, en ignorant d’autres facteurs importants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#focalism</IRI>
    <Literal xml:lang="EN">Focusing too much on certain aspects of a future event, ignoring other important factors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#focalism</IRI>
    <Literal xml:lang="FR">Je pensais que vivre dans une grande ville serait excitant, mais j’ai sous-estimé le stress du bruit et de la foule.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#focalism</IRI>
    <Literal xml:lang="EN">I thought living in a big city would be exciting, but I underestimated the stress of the noise and crowds.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#focalism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Affective_forecasting#Focalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#focalism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#focalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#projectionBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#projectionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#projectionBias</IRI>
    <Literal xml:lang="FR">Biais de projection affective</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#projectionBias</IRI>
    <Literal xml:lang="EN">Projection bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#projectionBias</IRI>
    <Literal xml:lang="FR">Vous prétez à tort vos émotions et préférences actuelles à des évènements futurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#projectionBias</IRI>
    <Literal xml:lang="EN">Wrongly attributing one's current emotions and preferences to future events.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#projectionBias</IRI>
    <Literal xml:lang="FR">Si je gagne à la loterie, je serai heureux pour toujours.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#projectionBias</IRI>
    <Literal xml:lang="EN">If I win the lottery, I will be happy forever.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#projectionBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Affective_forecasting#Projection_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#projectionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#projectionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impactBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impactBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impactBias</IRI>
    <Literal xml:lang="FR">Biais d’impact</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impactBias</IRI>
    <Literal xml:lang="EN">Impact bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impactBias</IRI>
    <Literal xml:lang="FR">Vous surestimez l’impact émotionnel des événements futurs, tant en intensité qu’en durée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impactBias</IRI>
    <Literal xml:lang="EN">Overestimating the emotional impact of future events, both in intensity and duration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impactBias</IRI>
    <Literal xml:lang="FR">Après avoir été promu, j’ai vite réalisé que le bonheur attendu n’était pas aussi grand que prévu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impactBias</IRI>
    <Literal xml:lang="EN">After being promoted, I quickly realized that the expected happiness was not as great as expected.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impactBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Impact_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impactBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_d%27impact</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impactBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#impactBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#misconstruals</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
    <Literal xml:lang="FR">Biais d’effet de disparition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
    <Literal xml:lang="EN">Fading affect bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
    <Literal xml:lang="FR">Vous oubliez plus rapidement les émotions négatives associées à des souvenirs passés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
    <Literal xml:lang="EN">Faster fading of negative emotions associated with past memories.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
    <Literal xml:lang="FR">Avec le temps, je me souviens des bons moments et j’oublie les mauvais.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
    <Literal xml:lang="EN">Over time, I recall the good moments and forget the bad ones.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fading_affect_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#immuneNeglect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#immuneNeglect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#immuneNeglect</IRI>
    <Literal xml:lang="FR">Biais d’immunité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#immuneNeglect</IRI>
    <Literal xml:lang="EN">Immune neglect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#immuneNeglect</IRI>
    <Literal xml:lang="FR">Vous négligez votre capacité à vous adapter psychologiquement aux événements négatifs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#immuneNeglect</IRI>
    <Literal xml:lang="EN">Neglecting one's psychological ability to adapt to negative events.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#immuneNeglect</IRI>
    <Literal xml:lang="FR">Je craignais que le déménagement ne me rende misérable, mais je me suis adapté plus rapidement que prévu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#immuneNeglect</IRI>
    <Literal xml:lang="EN">I was worried that the move would make me miserable, but I adapted faster than I expected.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#immuneNeglect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Affective_forecasting#Immune_neglect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#immuneNeglect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#immuneNeglect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rosyRetrospection</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rosyRetrospection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rosyRetrospection</IRI>
    <Literal xml:lang="FR">Passéisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rosyRetrospection</IRI>
    <Literal xml:lang="EN">Rosy retrospection</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rosyRetrospection</IRI>
    <Literal xml:lang="FR">Vous vous souvenez du passé de manière plus positive qu’il ne l’était en réalité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rosyRetrospection</IRI>
    <Literal xml:lang="EN">Remembering the past more positively than it actually was.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rosyRetrospection</IRI>
    <Literal xml:lang="FR">Nos vacances étaient toujours parfaites quand j’étais enfant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rosyRetrospection</IRI>
    <Literal xml:lang="EN">Our vacations were always perfect when I was a child.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rosyRetrospection</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Rosy_retrospection</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rosyRetrospection</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pass%C3%A9isme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rosyRetrospection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rosyRetrospection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#declinism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#declinism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#declinism</IRI>
    <Literal xml:lang="FR">Déclinisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#declinism</IRI>
    <Literal xml:lang="EN">Declinism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#declinism</IRI>
    <Literal xml:lang="FR">Vous croyez que la société ou le monde se détériore constamment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#declinism</IRI>
    <Literal xml:lang="EN">Believing that society or the world is constantly deteriorating.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#declinism</IRI>
    <Literal xml:lang="FR">De mon temps nous savions mieux vivre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#declinism</IRI>
    <Literal xml:lang="EN">In my time we knew how to live better.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#declinism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Declinism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#declinism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/D%C3%A9clinisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#declinism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#declinism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fadingAffectBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lossAversion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lossAversion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lossAversion</IRI>
    <Literal xml:lang="FR">Aversion aux pertes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lossAversion</IRI>
    <Literal xml:lang="EN">Loss aversion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lossAversion</IRI>
    <Literal xml:lang="FR">Vous craignez les pertes plus que vous ne valorisez les gains.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lossAversion</IRI>
    <Literal xml:lang="EN">Fearing losses more than valuing gains.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lossAversion</IRI>
    <Literal xml:lang="FR">Je préfère éviter de perdre 100 € plutôt que de gagner 100 €.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lossAversion</IRI>
    <Literal xml:lang="EN">I prefer to avoid losing 100 euros rather than gaining 100 euros.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lossAversion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Loss_aversion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lossAversion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Aversion_pour_la_perte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lossAversion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lossAversion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveForecasting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <Literal xml:lang="FR">Conservatisme (révision des croyances)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <Literal xml:lang="EN">Conservatism (belief revision)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <Literal xml:lang="FR">Vous avez tendance à préserver vos croyances existantes, même face à des preuves contraires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <Literal xml:lang="EN">Tendency to preserve one's existing beliefs even when faced with contrary evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <Literal xml:lang="FR">Malgré les nouvelles preuves, je ne peux pas croire que mon candidat favori soit impliqué dans un scandale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <Literal xml:lang="EN">Despite the new evidence, I cannot believe that my favorite candidate is involved in a scandal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Conservatism_(belief_revision)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
    <Literal xml:lang="FR">Biais du statu quo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
    <Literal xml:lang="EN">Status quo bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
    <Literal xml:lang="FR">Vous avez tendance à préférer le maintien de l’état actuel des choses, même lorsque de meilleures options existent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
    <Literal xml:lang="EN">Preferring to maintain the current state of affairs, even when better alternatives exist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
    <Literal xml:lang="FR">Je préfère rester dans mon emploi actuel, même si l’autre offre un meilleur salaire. Mieux vaut ne pas changer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
    <Literal xml:lang="EN">I prefer to stay in my current job, even if the other offers a better salary. Better to avoid changes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Status_quo_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_du_statu_quo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#systemJustification</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#systemJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#systemJustification</IRI>
    <Literal xml:lang="FR">Justification du système</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#systemJustification</IRI>
    <Literal xml:lang="EN">System justification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#systemJustification</IRI>
    <Literal xml:lang="FR">Vous défendez le statu quo, même si cela va à l’encontre de vos propres intérêts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#systemJustification</IRI>
    <Literal xml:lang="EN">Defending the status quo, even if doing so goes against one's own interests.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#systemJustification</IRI>
    <Literal xml:lang="FR">Ce système n’est peut-être pas parfait, mais c’est le meilleur que nous ayons.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#systemJustification</IRI>
    <Literal xml:lang="EN">This system might not be perfect, but it's the best we can do.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#systemJustification</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/System_justification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#systemJustification</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Th%C3%A9orie_de_la_justification_du_syst%C3%A8me</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#systemJustification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#systemJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuedInfluenceEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuedInfluenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuedInfluenceEffect</IRI>
    <Literal xml:lang="FR">Effet d’influence continue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuedInfluenceEffect</IRI>
    <Literal xml:lang="EN">Continued influence effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuedInfluenceEffect</IRI>
    <Literal xml:lang="FR">Les informations discréditées continuent d’influencer vos croyances et perceptions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuedInfluenceEffect</IRI>
    <Literal xml:lang="EN">Discredited information continues to influence one's beliefs and perceptions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuedInfluenceEffect</IRI>
    <Literal xml:lang="FR">Je sais que cette rumeur a été démentie, mais je pense qu’il y a du vrai.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuedInfluenceEffect</IRI>
    <Literal xml:lang="EN">I know this rumor has been debunked, but I think there is some truth to it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuedInfluenceEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/List_of_cognitive_biases#Continued_influence_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuedInfluenceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#continuedInfluenceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statusQuoBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactance</IRI>
    <Literal xml:lang="FR">Réactance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactance</IRI>
    <Literal xml:lang="EN">Reactance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactance</IRI>
    <Literal xml:lang="FR">Vous résistez à faire ce qui vous est dit de faire, pour préserver votre liberté de choix.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactance</IRI>
    <Literal xml:lang="EN">Resisting doing what one is told to do to preserve one's freedom of choice.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactance</IRI>
    <Literal xml:lang="FR">Plus ils me disent de ne pas le faire, plus j’ai envie de le faire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactance</IRI>
    <Literal xml:lang="EN">The more they tell me not to do it, the more I want to do it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactance</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Reactance_(psychology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactance</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/R%C3%A9actance_(psychologie)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionBias</IRI>
    <Literal xml:lang="FR">Biais d’omission</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionBias</IRI>
    <Literal xml:lang="EN">Omission bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionBias</IRI>
    <Literal xml:lang="FR">Vous jugez les actions négatives comme étant plus graves que les inactions équivalentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionBias</IRI>
    <Literal xml:lang="EN">Judging negative actions as being worse than equivalent inactions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionBias</IRI>
    <Literal xml:lang="FR">Je trouve moins acceptable de causer un mal par action que par inaction, même si le résultat est le même.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionBias</IRI>
    <Literal xml:lang="EN">I find it less acceptable to cause harm through action than through inaction, even if the result is the same.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Omission_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#omissionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#informationBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#informationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#informationBias</IRI>
    <Literal xml:lang="FR">Biais d’information</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#informationBias</IRI>
    <Literal xml:lang="EN">Information bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#informationBias</IRI>
    <Literal xml:lang="FR">Vous recherchez ou mettez l’accent sur des informations non pertinentes lors de la prise de décisions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#informationBias</IRI>
    <Literal xml:lang="EN">Seeking or emphasizing irrelevant information in decision-making.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#informationBias</IRI>
    <Literal xml:lang="FR">Pouvez-vous me détailler toutes les options avant que l’on se décide?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#informationBias</IRI>
    <Literal xml:lang="EN">Can you detail all the options for me before we decide?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#informationBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Information_bias_(psychology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#informationBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#informationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conservatism(beliefRevision)</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lawOfTriviality</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lawOfTriviality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lawOfTriviality</IRI>
    <Literal xml:lang="FR">Loi de futilité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lawOfTriviality</IRI>
    <Literal xml:lang="EN">Law of triviality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lawOfTriviality</IRI>
    <Literal xml:lang="FR">Vous accordez une importance disproportionnée à des sujets triviaux par rapport à des sujets plus importants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lawOfTriviality</IRI>
    <Literal xml:lang="EN">Disproportionate focus on trivial matters over more important ones.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lawOfTriviality</IRI>
    <Literal xml:lang="FR">On passe plus de temps à discuter de la couleur de la peinture qu’à planifier le budget du projet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lawOfTriviality</IRI>
    <Literal xml:lang="EN">More time is spent discussing paint color than planning the project budget.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lawOfTriviality</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Law_of_triviality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lawOfTriviality</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Loi_de_futilit%C3%A9_de_Parkinson</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#informationBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lawOfTriviality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lawOfTriviality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#informationBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <Literal xml:lang="FR">Biais égocentrique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <Literal xml:lang="EN">Egocentric bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <Literal xml:lang="FR">Vous centrez vos pensées et vos perceptions sur votre propre point de vue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <Literal xml:lang="EN">Centering oneself in one's thoughts and perceptions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <Literal xml:lang="FR">Tout le monde doit être intéressé par mon nouveau projet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <Literal xml:lang="EN">Everyone must be interested in my new project.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Egocentric_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_%C3%A9gocentrique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBiases</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <Literal xml:lang="FR">Biais de congruence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <Literal xml:lang="EN">Congruence bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <Literal xml:lang="FR">Vous accordez plus de poids aux informations qui confirment vos croyances établies.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <Literal xml:lang="EN">Giving more weight to information that confirms one's existing beliefs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <Literal xml:lang="FR">Je lis surtout des articles qui soutiennent mon point de vue politique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <Literal xml:lang="EN">I mostly read articles that support my political point of view.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Congruence_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <Literal xml:lang="FR">Justification de l’effort</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <Literal xml:lang="EN">Effort justification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <Literal xml:lang="FR">Vous attribuez plus de valeur à un résultat pour lequel vous avez beaucoup travaillé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <Literal xml:lang="EN">Valuing a result more when one has worked hard for it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <Literal xml:lang="FR">J’apprécie davantage mon diplôme parce que j’ai dû travailler dur pour l’obtenir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <Literal xml:lang="EN">I appreciate my degree more because I had to work hard to get it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Effort_justification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Waste_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#processingDifficultyEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#processingDifficultyEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#processingDifficultyEffect</IRI>
    <Literal xml:lang="FR">Effet de difficulté de traitement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#processingDifficultyEffect</IRI>
    <Literal xml:lang="EN">Processing difficulty effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#processingDifficultyEffect</IRI>
    <Literal xml:lang="FR">Vous accordez plus de valeur aux informations difficiles à comprendre ou à traiter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#processingDifficultyEffect</IRI>
    <Literal xml:lang="EN">Finding more value in information that is difficult to process.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#processingDifficultyEffect</IRI>
    <Literal xml:lang="FR">Ce livre complexe doit être important, puisqu’il est difficile à comprendre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#processingDifficultyEffect</IRI>
    <Literal xml:lang="EN">This complex book must be important because it is difficult to understand.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#processingDifficultyEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/List_of_cognitive_biases#Processing_difficulty_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#processingDifficultyEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#processingDifficultyEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKEAEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKEAEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKEAEffect</IRI>
    <Literal xml:lang="FR">Effet IKEA</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKEAEffect</IRI>
    <Literal xml:lang="EN">IKEA effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKEAEffect</IRI>
    <Literal xml:lang="FR">Vous valorisez plus les choses dans lesquelles vous avez investi du temps et de l’effort.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKEAEffect</IRI>
    <Literal xml:lang="EN">Valuing things more highly because one has invested time and effort into them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKEAEffect</IRI>
    <Literal xml:lang="FR">J’adore cette étagère que j’ai assemblée moi-même, même si elle n’est pas parfaite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKEAEffect</IRI>
    <Literal xml:lang="EN">I love this shelf that I put together myself, even though it's not perfect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKEAEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/IKEA_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKEAEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_Ikea</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKEAEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKEAEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostBias</IRI>
    <Literal xml:lang="FR">Biais des coûts irrécupérables</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostBias</IRI>
    <Literal xml:lang="EN">Sunk cost bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostBias</IRI>
    <Literal xml:lang="FR">Vous continuez une action inutile car vous avez déjà investi du temps, de l’argent ou des efforts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostBias</IRI>
    <Literal xml:lang="EN">Continuing a futile action because one has already invested time, money, or effort.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostBias</IRI>
    <Literal xml:lang="FR">Je finis ce livre ennuyeux car j’ai déjà lu la moitié.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostBias</IRI>
    <Literal xml:lang="EN">I'm finishing this boring book because I've already read half of it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sunk_cost#Psychological_factors</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Co%C3%BBt_irr%C3%A9cup%C3%A9rable</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionEffect</IRI>
    <Literal xml:lang="FR">Effet de disposition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionEffect</IRI>
    <Literal xml:lang="EN">Disposition effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionEffect</IRI>
    <Literal xml:lang="FR">Vous avez tendance à vendre des actifs gagnants trop tôt et à conserver des actifs perdants trop longtemps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionEffect</IRI>
    <Literal xml:lang="EN">Tendency to sell winning assets too soon and hold onto losing assets too long.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionEffect</IRI>
    <Literal xml:lang="FR">Je garde ces actions en perte, espérant qu’elles remontent un jour.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionEffect</IRI>
    <Literal xml:lang="EN">I'm keeping these stocks in losses, hoping they'll come back one day.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Disposition_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_de_disposition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#effortJustification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
    <Literal xml:lang="FR">Biais de cohérence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
    <Literal xml:lang="EN">Consistency bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
    <Literal xml:lang="FR">Vous modifiez vos souvenirs pour les rendre cohérents avec vos croyances actuelles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
    <Literal xml:lang="EN">Modifying one's memories to be consistent with current beliefs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
    <Literal xml:lang="FR">Je me souviens avoir toujours soutenu cette cause, même si, en réalité, mes opinions ont changé au fil du temps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
    <Literal xml:lang="EN">I remember always supporting this cause, although in reality my opinions have changed over time.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/List_of_cognitive_biases#Consistency_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moodCongruence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moodCongruence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moodCongruence</IRI>
    <Literal xml:lang="FR">Congruence d’humeur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moodCongruence</IRI>
    <Literal xml:lang="EN">Mood congruence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moodCongruence</IRI>
    <Literal xml:lang="FR">Votre état émotionnel actuel influence la récupération des souvenirs ayant un état émotionnel similaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moodCongruence</IRI>
    <Literal xml:lang="EN">Current emotional state influencing the retrieval of memories with a similar emotional state.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moodCongruence</IRI>
    <Literal xml:lang="FR">Quand je suis triste, je me souviens plus facilement des moments où j’étais également triste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moodCongruence</IRI>
    <Literal xml:lang="EN">When I'm sad, I more easily remember times when I was also sad.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moodCongruence</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Mood_congruence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moodCongruence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moodCongruence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="FR">Biais rétrospectif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="EN">Hindsight bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="FR">Vous croyez, après un événement, que vous aviez prédit ou attendu ce résultat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="EN">After an event, you believe that you had predicted or expected that outcome.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="FR">Je t’avais bien dit que c’était une mauvaise idée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="EN">I told you it was a bad idea.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hindsight_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_r%C3%A9trospectif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#choicesupportiveBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#choicesupportiveBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#choicesupportiveBias</IRI>
    <Literal xml:lang="FR">Biais de soutien à la décision</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#choicesupportiveBias</IRI>
    <Literal xml:lang="EN">Choice-supportive bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#choicesupportiveBias</IRI>
    <Literal xml:lang="FR">Vous justifiez rétrospectivement vos choix pour les faire paraître meilleurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#choicesupportiveBias</IRI>
    <Literal xml:lang="EN">Justifying one's past choices to make them appear better.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#choicesupportiveBias</IRI>
    <Literal xml:lang="FR">J’ai choisi cette voiture parce qu’elle a toujours été fiable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#choicesupportiveBias</IRI>
    <Literal xml:lang="EN">I chose this car because it has always been reliable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#choicesupportiveBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Choice-supportive_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#choicesupportiveBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#choicesupportiveBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#consistencyBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endowmentEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endowmentEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endowmentEffect</IRI>
    <Literal xml:lang="FR">Effet de dotation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endowmentEffect</IRI>
    <Literal xml:lang="EN">Endowment effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endowmentEffect</IRI>
    <Literal xml:lang="FR">Vous valorisez davantage ce que vous possédez déjà.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endowmentEffect</IRI>
    <Literal xml:lang="EN">Valuing something more highly simply because one already owns it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endowmentEffect</IRI>
    <Literal xml:lang="FR">Je ne veux pas vendre ce vieux meuble, il a une grande valeur pour moi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endowmentEffect</IRI>
    <Literal xml:lang="EN">I don't want to sell this old piece of furniture; it has great sentimental value to me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endowmentEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Endowment_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endowmentEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Aversion_%C3%A0_la_d%C3%A9possession</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#choicesupportiveBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endowmentEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endowmentEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#choicesupportiveBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <Literal xml:lang="FR">Biais de croyance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <Literal xml:lang="EN">Belief bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <Literal xml:lang="FR">Vous évaluez la force logique d’un argument en fonction de la croyance en sa conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <Literal xml:lang="EN">Assessing the strength of an argument based on the belief in its conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <Literal xml:lang="FR">Je suis bien d’accord avec ce que vous dites et j’ai du mal à croire qu’on puisse présenter les choses autrement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <Literal xml:lang="EN">I completely agree with what you say and I find it hard to believe that things could be presented any other way.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Belief_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ostrichEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ostrichEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ostrichEffect</IRI>
    <Literal xml:lang="FR">Effet autruche</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ostrichEffect</IRI>
    <Literal xml:lang="EN">Ostrich effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ostrichEffect</IRI>
    <Literal xml:lang="FR">Vous évitez les informations négatives ou menaçantes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ostrichEffect</IRI>
    <Literal xml:lang="EN">Avoiding negative or threatening information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ostrichEffect</IRI>
    <Literal xml:lang="FR">Je n’aime pas lire les nouvelles parce qu’elles sont trop déprimantes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ostrichEffect</IRI>
    <Literal xml:lang="EN">I don't like reading the news because it's too depressing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ostrichEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ostrich_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ostrichEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ostrichEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#normalcyBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#normalcyBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#normalcyBias</IRI>
    <Literal xml:lang="FR">Biais de normalité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#normalcyBias</IRI>
    <Literal xml:lang="EN">Normalcy bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#normalcyBias</IRI>
    <Literal xml:lang="FR">Vous sous-estimez la probabilité d’événements négatifs si ceux-ci ne se sont pas produits récemment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#normalcyBias</IRI>
    <Literal xml:lang="EN">Underestimating the likelihood of negative events if they haven't occurred recently.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#normalcyBias</IRI>
    <Literal xml:lang="FR">Un tremblement de terre ici ? Ça n’arrive jamais, je ne m’inquiète pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#normalcyBias</IRI>
    <Literal xml:lang="EN">An earthquake here? It never happens, I don't worry.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#normalcyBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Normalcy_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#normalcyBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_de_normalit%C3%A9</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#normalcyBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#normalcyBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveValidation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveValidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveValidation</IRI>
    <Literal xml:lang="FR">Validation subjective</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveValidation</IRI>
    <Literal xml:lang="EN">Subjective validation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveValidation</IRI>
    <Literal xml:lang="FR">Vous croyez qu’une information est vraie parce qu’elle a un sens personnel pour vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveValidation</IRI>
    <Literal xml:lang="EN">Believing a piece of information to be true because it has personal meaning to one.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveValidation</IRI>
    <Literal xml:lang="FR">Cette horoscope doit être vrai, il décrit exactement ce que je ressens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveValidation</IRI>
    <Literal xml:lang="EN">This horoscope must be true, it describes exactly what I feel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveValidation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Subjective_validation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveValidation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subjectiveValidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outcomeBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outcomeBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outcomeBias</IRI>
    <Literal xml:lang="FR">Biais de résultat</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outcomeBias</IRI>
    <Literal xml:lang="EN">Outcome bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outcomeBias</IRI>
    <Literal xml:lang="FR">Vous jugez une décision basée sur son résultat plutôt que sur les informations disponibles au moment de la décision.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outcomeBias</IRI>
    <Literal xml:lang="EN">Judging a decision based on its outcome rather than the information available at the time of the decision.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outcomeBias</IRI>
    <Literal xml:lang="FR">Finalement, ça n’était pas une si mauvaise décision, tu vois?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outcomeBias</IRI>
    <Literal xml:lang="EN">After all, it wasn't such a bad decision, was it?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outcomeBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Outcome_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outcomeBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outcomeBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beliefBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selflicensing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selflicensing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selflicensing</IRI>
    <Literal xml:lang="FR">Hypocrisie morale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selflicensing</IRI>
    <Literal xml:lang="EN">Self-licensing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selflicensing</IRI>
    <Literal xml:lang="FR">Vous vous autorisez à agir de manière contraire à vos principes ou valeurs après avoir accompli un acte positif ou moral.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selflicensing</IRI>
    <Literal xml:lang="EN">Allowing oneself to act against one's principles or values after performing a positive or moral act.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selflicensing</IRI>
    <Literal xml:lang="FR">Après avoir fait un don à une œuvre caritative, je me sens moins coupable de faire des dépenses égoïstes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selflicensing</IRI>
    <Literal xml:lang="EN">After donating to charity, I feel less guilty about making selfish purchases.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selflicensing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Self-licensing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selflicensing</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Hypocrisie_morale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selflicensing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selflicensing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#congruenceBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="FR">Projection mentale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="EN">Mind projection fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="FR">Vous considérez que votre manière d’envisager le monde reflète exactement la réalité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="EN">Assuming one's perspective of the world to be the exact reflection of reality.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="FR">En ces temps de grande incertitude pour notre entreprise, il me paraît inconcevable que vous refusiez cette baisse de salaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="EN">In these times of great uncertainty for our company, it seems inconceivable to me that you could refuse this pay cut.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Mind_projection_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="FR">Projection psychologique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="EN">Psychological projection</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="FR">Vous attribuez vos propres défauts à votre adversaire afin de détourner l’attention de vos erreurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="EN">Attributing one's own flaws to one's opponent to divert attention from one's errors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="FR">Ce n’est pas surprenant que vous pensiez que je fuis le sujet ; après tout, c’est exactement ce que ferait quelqu’un qui manque d’arguments, comme vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="EN">It's not surprising that you think I'm dodging the issue; after all, that's exactly what someone who lacks arguments, like you, would do.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Psychological_projection</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="FR">Renvoyer la balle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="EN">Buck passing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="FR">Vous attribuez à une autre personne ou groupe une responsabilité qui est en réalité la vôtre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="EN">Attributing to another person or group a responsibility that is actually one's own.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="FR">Si nous avons échoué, c’est parce que l’équipe a fait preuve de nonchalence et n’a pas suivi mes directives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="EN">If we failed, it's because the team was careless and failed to follow my directions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Buck_passing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#buckPassing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#victimBlaming</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#victimBlaming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#victimBlaming</IRI>
    <Literal xml:lang="FR">Blâmer la victime</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#victimBlaming</IRI>
    <Literal xml:lang="EN">Victim blaming</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#victimBlaming</IRI>
    <Literal xml:lang="FR">Votre argument vise à rendre la victime responsable d’avoir subi un préjudice.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#victimBlaming</IRI>
    <Literal xml:lang="EN">Holding the victim responsible for the harm they have suffered.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#victimBlaming</IRI>
    <Literal xml:lang="FR">Vous portiez-bien une mini-jupe ce soir là ? Et vous reconnaissez que vous aviez trop bu ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#victimBlaming</IRI>
    <Literal xml:lang="EN">You were wearing a mini-skirt that night? And you admit you had too much to drink?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#victimBlaming</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Victim_blaming</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#victimBlaming</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Blâmer_la_victime</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#victimBlaming</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#victimBlaming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfblame</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfblame</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfblame</IRI>
    <Literal xml:lang="FR">Auto-flagelation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfblame</IRI>
    <Literal xml:lang="EN">Self-blame</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfblame</IRI>
    <Literal xml:lang="FR">Vous vous accusez vous-même pour un malheur duquel vous n’êtes pas responsable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfblame</IRI>
    <Literal xml:lang="EN">Blaming oneself for a misfortune for which one is not responsible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfblame</IRI>
    <Literal xml:lang="FR">Je savais que je n’aurais pas dû être dans ce quartier si tard le soir. C’est de ma faute si j’ai été agressé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfblame</IRI>
    <Literal xml:lang="EN">I knew I shouldn't have been in that neighborhood so late at night. It's my fault I got mugged.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfblame</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Self-blame_(psychology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfblame</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfblame</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalProjection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="FR">Personnalisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="EN">Personalization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="FR">Vous attribuez une responsabilité personnelle, y compris l’éloge ou le blâme qui en résulte, à des événements sur lesquels vous avez peu ou pas de contrôle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="EN">Assigning personal responsibility, including praise or blame, for events over which one has little or no control.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="FR">C’est de ma faute si la réunion s’est mal passée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="EN">It's my fault the meeting went poorly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Personalization_and_blaming</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#Personnalisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfChange</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfChange</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfChange</IRI>
    <Literal xml:lang="FR">Argument du changement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfChange</IRI>
    <Literal xml:lang="EN">Fallacy of change</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfChange</IRI>
    <Literal xml:lang="FR">Vous vous attendez à ce que les autres changent pour répondre à vos besoins et désirs, en vous appuyant typiquement le contrôle social.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfChange</IRI>
    <Literal xml:lang="EN">Expecting others to change to meet one's needs and desires, often involving social control.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfChange</IRI>
    <Literal xml:lang="FR">Si mon partenaire m’aimait vraiment, il changerait pour moi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfChange</IRI>
    <Literal xml:lang="EN">If my partner really loved me, they would change for me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfChange</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Fallacy_of_change</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfChange</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#Argument_du_changement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfChange</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfChange</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="FR">Avoir toujours raison</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="EN">Always being right</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="FR">Vous ressentez le besoin de prouver constamment que vos opinions et actions sont correctes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="EN">Feeling the need to constantly prove that one's opinions and actions are correct.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="FR">Je dois gagner cet argument pour montrer que j’ai raison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="EN">I must win this argument to show I'm right.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cognitive_distortion#Always_being_right</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Distorsion_cognitive#Avoir_toujours_raison</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alwaysBeingRight</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#empathyGap</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#empathyGap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#empathyGap</IRI>
    <Literal xml:lang="FR">Biais d’empathie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#empathyGap</IRI>
    <Literal xml:lang="EN">Empathy gap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#empathyGap</IRI>
    <Literal xml:lang="FR">Vous avez du mal à adopter une perspective appropriée vis à vis des autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#empathyGap</IRI>
    <Literal xml:lang="EN">Having difficulty adopting an appropriate perspective towards others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#empathyGap</IRI>
    <Literal xml:lang="FR">Je crois bien que je ne me suis pas comporté comme ils l’attendaient.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#empathyGap</IRI>
    <Literal xml:lang="EN">I think I didn't behave as they expected.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#empathyGap</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Empathy_gap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#empathyGap</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#empathyGap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egotism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egotism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egotism</IRI>
    <Literal xml:lang="FR">Égotisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egotism</IRI>
    <Literal xml:lang="EN">Egotism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egotism</IRI>
    <Literal xml:lang="FR">Vous avez une vision exagérément positive de vous-même.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egotism</IRI>
    <Literal xml:lang="EN">Having an excessively positive view of oneself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egotism</IRI>
    <Literal xml:lang="FR">Je suis clairement le membre le plus intelligent et le plus compétent de mon équipe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egotism</IRI>
    <Literal xml:lang="EN">I am clearly the most intelligent and competent member of my team.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egotism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Egotism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egotism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/%C3%89gotisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egotism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egotism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#egocentricBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
    <Literal xml:lang="FR">Biais culturels</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
    <Literal xml:lang="EN">Cultural bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
    <Literal xml:lang="FR">Vos prises de position sont influencées par votre contexte culturel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
    <Literal xml:lang="EN">Having one's positions influenced by one's cultural context.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
    <Literal xml:lang="FR">Ces personnes sont bien à plaindre : elles n’ont ni télévision ni voiture…</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
    <Literal xml:lang="EN">Those people are to be pitied: they have neither a television nor a car...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Idola_specus</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#biasedThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <Literal xml:lang="FR">Biais d’attribution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <Literal xml:lang="EN">Attribution bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <Literal xml:lang="FR">Vous attribuez à tort des comportements ou des événements à certaines causes, souvent en sous-estimant l’influence des circonstances extérieures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <Literal xml:lang="EN">Incorrectly attributing the causes of behaviors or events, often underestimating the impact of external circumstances.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <Literal xml:lang="FR">Quand mon collègue n’a pas respecté son délai, j’ai immédiatement pensé qu’il était paresseux, sans tenir compte des urgences familiales qu’il avait dû gérer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <Literal xml:lang="EN">When my coworker missed his deadline, I immediately thought he was lazy, never mind the family emergencies he had to deal with.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Attribution_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_d%27attribution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Example_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <Literal xml:lang="FR">Effet acteur-observateur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <Literal xml:lang="EN">Actor–observer asymmetry</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <Literal xml:lang="FR">Vous attribuez vos propres actions à des facteurs situationnels, mais vous attribuez celles des autres à leur personnalité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <Literal xml:lang="EN">Attributing one's own actions to situational factors, but others' actions to their personality.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <Literal xml:lang="FR">Je suis en retard à cause de la circulation, mais s’il est en retard, c’est parce qu’il est paresseux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <Literal xml:lang="EN">I'm late because of traffic, but if he's late, it's because he's lazy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Actor%E2%80%93observer_asymmetry</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_acteur-observateur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
    <Literal xml:lang="FR">Dispositionalisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
    <Literal xml:lang="EN">Dispositional attribution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
    <Literal xml:lang="FR">Vous expliquez un comportement par une disposition interne de la personne plutôt que par la situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
    <Literal xml:lang="EN">Attributing behavior to internal characteristics rather than external circumstances.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
    <Literal xml:lang="FR">S’il est en retard, c’est qu’il est paresseux. Il savait bien que c’était un rendez-vous important.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
    <Literal xml:lang="EN">He's late because he's lazy. He knew how important this meeting was.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Dispositional_attribution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalAttributionError</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalAttributionError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalAttributionError</IRI>
    <Literal xml:lang="FR">Erreur fondamentale d’attribution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalAttributionError</IRI>
    <Literal xml:lang="EN">Fundamental attribution error</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalAttributionError</IRI>
    <Literal xml:lang="FR">Vous attribuez un comportement ou un événement principalement aux caractéristiques d’une personne, en négligeant les facteurs contextuels.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalAttributionError</IRI>
    <Literal xml:lang="EN">Overemphasizing personal characteristics in explaining someone's behavior while underestimating situational factors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalAttributionError</IRI>
    <Literal xml:lang="FR">Quand on travaille bien, on gagne suffisamment d’argent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalAttributionError</IRI>
    <Literal xml:lang="EN">When people work well, they earn enough money.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalAttributionError</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fundamental_attribution_error</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalAttributionError</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Erreur_fondamentale_d%27attribution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalAttributionError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fundamentalAttributionError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defensiveAttribution</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defensiveAttribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defensiveAttribution</IRI>
    <Literal xml:lang="FR">Attribution défensive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defensiveAttribution</IRI>
    <Literal xml:lang="EN">Defensive attribution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defensiveAttribution</IRI>
    <Literal xml:lang="FR">Vous attribuez la responsabilité à la personne concernée afin de vous convaincre que vous ne subiriez pas une situation similaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defensiveAttribution</IRI>
    <Literal xml:lang="EN">You assign responsibility to the person concerned in order to convince yourself that you would not experience a similar situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defensiveAttribution</IRI>
    <Literal xml:lang="FR">Il ne l’a sans doute pas volé s’il se retrouve dans cette situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defensiveAttribution</IRI>
    <Literal xml:lang="EN">He probably didn’t steal it if he finds himself in this situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defensiveAttribution</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Defensive_attribution_hypothesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defensiveAttribution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#defensiveAttribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostileAttributionBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostileAttributionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostileAttributionBias</IRI>
    <Literal xml:lang="FR">Biais d’attribution hostile</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostileAttributionBias</IRI>
    <Literal xml:lang="EN">Hostile Attribution Bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostileAttributionBias</IRI>
    <Literal xml:lang="FR">Vous interprétez les intentions ambiguës des autres comme malveillantes, même en l’absence de preuves concrètes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostileAttributionBias</IRI>
    <Literal xml:lang="EN">Interpreting ambiguous actions of others as hostile, even in the absence of concrete evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostileAttributionBias</IRI>
    <Literal xml:lang="FR">Quand quelqu’un m’a bousculé dans le métro, j’ai immédiatement pensé qu’il le faisait exprès pour m’énerver.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostileAttributionBias</IRI>
    <Literal xml:lang="EN">When someone bumped into me on the subway, I immediately thought they were doing it on purpose to annoy me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostileAttributionBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hostile_attribution_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostileAttributionBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_d%27attribution_hostile</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostileAttributionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hostileAttributionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dispositionalAttribution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfExternalAgency</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfExternalAgency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfExternalAgency</IRI>
    <Literal xml:lang="FR">Illusion d’agence externe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfExternalAgency</IRI>
    <Literal xml:lang="EN">Illusion of external agency</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfExternalAgency</IRI>
    <Literal xml:lang="FR">Vous attribuez à tort vos propres actions ou décisions à des forces ou à des agents extérieurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfExternalAgency</IRI>
    <Literal xml:lang="EN">Falsely attributing one's own actions or decisions to external forces or agents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfExternalAgency</IRI>
    <Literal xml:lang="FR">Je n’ai pas vraiment choisi cette carrière ; c’est comme si les circonstances m’y avaient poussé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfExternalAgency</IRI>
    <Literal xml:lang="EN">I didn't really choose this career; It's as if circumstances pushed me to it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfExternalAgency</IRI>
    <Literal xml:lang="EN">https://handwiki.org/wiki/Philosophy:Illusion_of_external_agency</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfExternalAgency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusionOfExternalAgency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralLuck</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralLuck</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralLuck</IRI>
    <Literal xml:lang="FR">Chance morale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralLuck</IRI>
    <Literal xml:lang="EN">Moral luck</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralLuck</IRI>
    <Literal xml:lang="FR">Vous attribuez des résultats chanceux à vos propres mérites ou compétences.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralLuck</IRI>
    <Literal xml:lang="EN">Attributing lucky outcomes to one's own merits or skills.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralLuck</IRI>
    <Literal xml:lang="FR">J’ai réussi grâce à mon travail acharné</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralLuck</IRI>
    <Literal xml:lang="EN">I achieved success through my hard work</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralLuck</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Moral_luck</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralLuck</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralLuck</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#traitAscriptionBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#traitAscriptionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#traitAscriptionBias</IRI>
    <Literal xml:lang="FR">Biais d’attribution des traits</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#traitAscriptionBias</IRI>
    <Literal xml:lang="EN">Trait ascription bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#traitAscriptionBias</IRI>
    <Literal xml:lang="FR">Vous attribuez des caractéristiques variables imprédictibles à vous-même et aux autres basées sur des comportements observés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#traitAscriptionBias</IRI>
    <Literal xml:lang="EN">Attributing unpredictable variable characteristics to oneself and others based on observed behaviors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#traitAscriptionBias</IRI>
    <Literal xml:lang="FR">Elle a souri; elle doit être une personne heureuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#traitAscriptionBias</IRI>
    <Literal xml:lang="EN">She smiled; she must be a happy person.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#traitAscriptionBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Trait_ascription_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#traitAscriptionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#traitAscriptionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#actor–observerAsymmetry</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
    <Literal xml:lang="FR">Erreur ultime d’attribution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
    <Literal xml:lang="EN">Ultimate attribution error</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
    <Literal xml:lang="FR">Vous imputez les échecs de votre groupe à des causes extérieures, et ses réussites à ses qualités intrinsèques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
    <Literal xml:lang="EN">Attributing failures to external causes outside of one's group and successes to the group's inherent qualities.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
    <Literal xml:lang="FR">Ce n’est pas votre faute si le projet a échoué, ce sont les concurrents qui ont joué de façon déloyale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
    <Literal xml:lang="EN">It's not your team's fault the project failed; the competition played dirty.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ultimate_attribution_error</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
    <Literal xml:lang="FR">Sophisme de préjudice</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
    <Literal xml:lang="EN">Fallacy of prejudice</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
    <Literal xml:lang="FR">Vous partez du principe que l’adversaire devrait être d’accord avec votre conclusion, ce qui fausse le débat dès le départ.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
    <Literal xml:lang="EN">Assuming that the opposition must agree with one's conclusion from the outset, falsely setting the stage for the argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
    <Literal xml:lang="FR">Si vous n’acceptez pas mon explication, c’est que vous faites partie du problème.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
    <Literal xml:lang="EN">If you don't accept my explanation, then you're simply part of the problem.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Fallacy_of_opposition#Fallacy_of_prejudice</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactiveDevaluation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactiveDevaluation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactiveDevaluation</IRI>
    <Literal xml:lang="FR">Dévaluation réactive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactiveDevaluation</IRI>
    <Literal xml:lang="EN">Reactive devaluation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactiveDevaluation</IRI>
    <Literal xml:lang="FR">Vous attribuez une valeur moindre à une offre ou à une proposition simplement parce qu’elle provient d’un adversaire ou d’un rival.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactiveDevaluation</IRI>
    <Literal xml:lang="EN">Assigning less value to an offer or proposal simply because it comes from an adversary or rival.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactiveDevaluation</IRI>
    <Literal xml:lang="FR">Toute proposition de cette entreprise concurrente est automatiquement suspecte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactiveDevaluation</IRI>
    <Literal xml:lang="EN">Any proposal from this competing company is automatically suspect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactiveDevaluation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Reactive_devaluation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactiveDevaluation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reactiveDevaluation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="FR">Effet « pas d’ici »</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="EN">Not invented here</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="FR">Vous rejetez les idées, les recherches ou les produits qui ne sont pas développés au sein de votre propre groupe ou organisation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="EN">Rejecting ideas, research, or products not developed within one's own group or organization.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="FR">Si cette idée ne vient pas de notre équipe, elle ne doit pas être bonne.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="EN">If this idea didn't come from our team, it definitely isn't good.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Not_invented_here</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Not_invented_here</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfPrejudice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
    <Literal xml:lang="FR">Narcissisme collectif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
    <Literal xml:lang="EN">Collective narcissism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
    <Literal xml:lang="FR">Vous exprimez un orgueil et un sentiment de supériorité exagérés pour un groupe auquel vous appartenez, souvent en dépréciant les autres groupes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
    <Literal xml:lang="EN">Expressing an inflated sense of pride and superiority for a group to which one belongs, often coupled with depreciating other groups.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
    <Literal xml:lang="FR">Notre nation est clairement la plus grande de toutes, et ceux qui ne le reconnaissent pas sont soit ignorants, soit jaloux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
    <Literal xml:lang="EN">Our nation is undoubtedly the greatest of all, and those who don't recognize this are either ignorant or jealous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Collective_narcissism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#islandMentality</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#islandMentality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#islandMentality</IRI>
    <Literal xml:lang="FR">Mentalité de l’ilot</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#islandMentality</IRI>
    <Literal xml:lang="EN">Island mentality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#islandMentality</IRI>
    <Literal xml:lang="FR">Votre argument laisse entendre que votre communauté est la seule à détenir la vérité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#islandMentality</IRI>
    <Literal xml:lang="EN">Suggesting that one's community alone holds the truth, discounting external perspectives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#islandMentality</IRI>
    <Literal xml:lang="FR">Nos traditions et nos enseignements sont les seuls qui offrent la vraie sagesse sur ce sujet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#islandMentality</IRI>
    <Literal xml:lang="EN">Our traditions and teachings are the only true source of wisdom on this matter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#islandMentality</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Island_mentality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#islandMentality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#islandMentality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingroupFavoritism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingroupFavoritism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingroupFavoritism</IRI>
    <Literal xml:lang="FR">Favoritisme endogroupe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingroupFavoritism</IRI>
    <Literal xml:lang="EN">In-group Favoritism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingroupFavoritism</IRI>
    <Literal xml:lang="FR">Vous favorisez les membres de votre propre groupe par rapport à ceux d’un groupe extérieur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingroupFavoritism</IRI>
    <Literal xml:lang="EN">Preferring members of one's own group over those from an external one.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingroupFavoritism</IRI>
    <Literal xml:lang="FR">Notre équipe locale est la meilleure. Les autres équipes gagnent seulement à cause des arbitres biaisés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingroupFavoritism</IRI>
    <Literal xml:lang="EN">Our local team is the best. The other teams win only because of biased referees.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingroupFavoritism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/In-group_favoritism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingroupFavoritism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingroupFavoritism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#collectiveNarcissism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outgroupHomogeneity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outgroupHomogeneity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outgroupHomogeneity</IRI>
    <Literal xml:lang="FR">Homogénéité du groupe externe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outgroupHomogeneity</IRI>
    <Literal xml:lang="EN">Out-group homogeneity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outgroupHomogeneity</IRI>
    <Literal xml:lang="FR">Vous percevez les membres d’un groupe extérieur comme étant plus similaires entre eux que les membres de votre propre groupe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outgroupHomogeneity</IRI>
    <Literal xml:lang="EN">Perceiving members of an external group as more similar to each other than members of one's own group.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outgroupHomogeneity</IRI>
    <Literal xml:lang="FR">Les gens de cette ville semblent tous penser de la même façon. Ils ne sont pas aussi diversifiés que nous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outgroupHomogeneity</IRI>
    <Literal xml:lang="EN">People in this town all seem to think the same way. They are not as diverse as us.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outgroupHomogeneity</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Out-group_homogeneity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outgroupHomogeneity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outgroupHomogeneity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultimateAttributionError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossraceEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossraceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossraceEffect</IRI>
    <Literal xml:lang="FR">Effet de race croisée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossraceEffect</IRI>
    <Literal xml:lang="EN">Cross-race effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossraceEffect</IRI>
    <Literal xml:lang="FR">Vous avez plus de mal à reconnaître et à différencier les visages de personnes appartenant à une race différente de la vôtre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossraceEffect</IRI>
    <Literal xml:lang="EN">Having difficulty recognizing and differentiating faces of people from a race different from one's own.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossraceEffect</IRI>
    <Literal xml:lang="FR">Je trouve plus difficile de distinguer les visages de personnes d’une race différente de la mienne.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossraceEffect</IRI>
    <Literal xml:lang="EN">I find it more difficult to distinguish the faces of people of a different race than myself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossraceEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cross-race_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossraceEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_d%27appartenance_ethnique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outgroupHomogeneity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossraceEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossraceEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#outgroupHomogeneity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
    <Literal xml:lang="FR">Biais de proportionnalité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
    <Literal xml:lang="EN">Proportionality bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
    <Literal xml:lang="FR">Vous supposez que de grands effets requièrent forcément de grandes causes, ce qui n’est pas toujours le cas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
    <Literal xml:lang="EN">Assuming that big effects must have big causes, which is not always the case.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
    <Literal xml:lang="FR">Je refuse de croire qu’une catastrophe de cette ampleur ait été causée par un oubli aussi insignifiant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
    <Literal xml:lang="EN">I can't believe such a massive disaster was caused by something as minor as an oversight.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
    <Literal xml:lang="EN">http://skepdic.com/proportionalitybias.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attributionBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
    <Literal xml:lang="FR">Conspirationnisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
    <Literal xml:lang="EN">Conspiracy theory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
    <Literal xml:lang="FR">Vous adhérez à des théories du complot qui prétendent expliquer de manière simpliste des événements complexes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
    <Literal xml:lang="EN">Adhering to simplistic conspiracy theories to explain complex events.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
    <Literal xml:lang="FR">Ce groupe politique est à la solde des franc-maçons, c’est la seule explication possible pour leurs décisions controversées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
    <Literal xml:lang="EN">This political group is in the pay of the Freemasons; that is the only possible explanation for their controversial decisions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Conspiracy_theory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Théorie_du_complot</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#furtiveFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#furtiveFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#furtiveFallacy</IRI>
    <Literal xml:lang="FR">Sophisme furtif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#furtiveFallacy</IRI>
    <Literal xml:lang="EN">Furtive fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#furtiveFallacy</IRI>
    <Literal xml:lang="FR">Vous insinuez qu’une séquence d’événements est le résultat secret de l’action d’un groupe dissimulé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#furtiveFallacy</IRI>
    <Literal xml:lang="EN">Suggesting a series of events is secretly orchestrated by a hidden group.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#furtiveFallacy</IRI>
    <Literal xml:lang="FR">La récente décision de politique étrangère aurait été influencée par un groupe d’investisseurs occultes qui cherchent à tirer profit de la situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#furtiveFallacy</IRI>
    <Literal xml:lang="EN">The recent foreign policy decision is said to have been influenced by a group of hidden investors seeking to profit from the situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#furtiveFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Furtive_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#furtiveFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#furtiveFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conspiracyTheory</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressiveFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressiveFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressiveFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de régression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressiveFallacy</IRI>
    <Literal xml:lang="EN">Regressive fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressiveFallacy</IRI>
    <Literal xml:lang="FR">Vous attribuez un résultat à des causes spécifiques alors qu’il pourrait simplement s’agir d’un retour à la moyenne statistique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressiveFallacy</IRI>
    <Literal xml:lang="EN">Attributing an outcome to specific causes when it might just be a return to statistical average.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressiveFallacy</IRI>
    <Literal xml:lang="FR">J’ai bu ce thé à la pêche après 11 jours de maladie, et il a fait disparaître ma grippe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressiveFallacy</IRI>
    <Literal xml:lang="EN">After 11 days of being sick, I drank this peach tea, and it cured my flu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressiveFallacy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/regressf.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressiveFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#regressiveFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#galileoGambit</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#galileoGambit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#galileoGambit</IRI>
    <Literal xml:lang="FR">Pari de Galilée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#galileoGambit</IRI>
    <Literal xml:lang="EN">Galileo gambit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#galileoGambit</IRI>
    <Literal xml:lang="FR">Vous pensez que si vos idées sont critiquées ou si vous êtes persécuté, cela prouve leur validité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#galileoGambit</IRI>
    <Literal xml:lang="EN">Believing that criticism or persecution of one's ideas proves their validity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#galileoGambit</IRI>
    <Literal xml:lang="FR">Ils disent que mes méthodes sont non conventionnelles, mais ils sont conformistes, et je suis un empêcheur de tourner en rond. C’est bien la preuve que j’ai raison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#galileoGambit</IRI>
    <Literal xml:lang="EN">They say my methods are unconventional, but they're conformists, and I'm a maverick. This proves I'm right.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#galileoGambit</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Galileo_gambit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#galileoGambit</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#galileoGambit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proportionalityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <Literal xml:lang="FR">Essentialisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <Literal xml:lang="EN">Essentialism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <Literal xml:lang="FR">Vous présentez certains traits ou caractéristiques comme naturels et inhérents à des groupes ou à des catégories.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <Literal xml:lang="EN">Presenting certain traits or characteristics as natural and inherent to groups or categories.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <Literal xml:lang="FR">Les femmes sont naturellement plus empathiques que les hommes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <Literal xml:lang="EN">Women are naturally more empathetic than men.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Essentialism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Essentialisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#culturalBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Preference_Scheme_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="FR">Stéréotype</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="EN">Stereotype</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="FR">Vous vous appuyez sur des croyances généralisées, souvent simplistes, concernant les caractéristiques d’un groupe de personnes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="EN">Relying on generalized, often simplistic beliefs about the characteristics of a group of people.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="FR">Je suppose que tous les ingénieurs communiquent mal avec les autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="EN">I assume that all engineers communicate poorly with others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Stereotype</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/St%C3%A9r%C3%A9otype</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupAttributionError</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupAttributionError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupAttributionError</IRI>
    <Literal xml:lang="FR">Erreur d’attribution de groupe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupAttributionError</IRI>
    <Literal xml:lang="EN">Group attribution error</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupAttributionError</IRI>
    <Literal xml:lang="FR">Vous attribuez les actions ou les comportements d’un individu aux caractéristiques supposées du groupe auquel il appartient.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupAttributionError</IRI>
    <Literal xml:lang="EN">Attributing the actions or behaviors of an individual to the perceived characteristics of the group they belong to.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupAttributionError</IRI>
    <Literal xml:lang="FR">Il a mal agi ; c’est typique des gens de son entreprise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupAttributionError</IRI>
    <Literal xml:lang="EN">He did something wrong, that's typical of people in his company.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupAttributionError</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Group_attribution_error</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupAttributionError</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#groupAttributionError</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitStereotype</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitStereotype</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitStereotype</IRI>
    <Literal xml:lang="FR">Stéréotype implicite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitStereotype</IRI>
    <Literal xml:lang="EN">Implicit stereotype</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitStereotype</IRI>
    <Literal xml:lang="FR">Vous portez des jugements et adoptez des attitudes automatiques envers des personnes ou des groupes, sans en avoir conscience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitStereotype</IRI>
    <Literal xml:lang="EN">Forming automatic judgments and attitudes towards people or groups without being aware of it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitStereotype</IRI>
    <Literal xml:lang="FR">Sans m’en rendre compte, j’ai des attentes différentes envers les gens selon leur groupe social ou ethnique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitStereotype</IRI>
    <Literal xml:lang="EN">Without realizing it, I have different expectations of people depending on their social or ethnic group.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitStereotype</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Implicit_stereotype</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitStereotype</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitStereotype</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stereotype</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <Literal xml:lang="FR">Ethnocentrisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <Literal xml:lang="EN">Ethnocentrism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <Literal xml:lang="FR">Vous interprétez et jugez les autres cultures à travers le prisme de votre propre culture, ce qui fausse votre perception et vos interactions avec elles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <Literal xml:lang="EN">Interpreting and judging the world primarily through the lens of one's own culture, influencing the perception of and interaction with other cultures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <Literal xml:lang="FR">Je ne comprends pas leurs façons de faire dans ce pays ; nos méthodes sont tout simplement plus civilisées et plus efficaces.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <Literal xml:lang="EN">I do not understand their ways of doing things in that country; our methods are simply more civilized and more effective.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ethnocentrism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Ethnocentrisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#essentialism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <Literal xml:lang="FR">Discrimination</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <Literal xml:lang="EN">Discrimination</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <Literal xml:lang="FR">Vous traitez des personnes différemment ou injustement en raison de certaines caractéristiques personnelles ou sociales.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <Literal xml:lang="EN">Treating people differently or unfairly because of certain personal or social characteristics.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <Literal xml:lang="FR">Je ne pense pas que cette personne convienne au poste en raison de son âge.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <Literal xml:lang="EN">I don't think this person is suitable for the position due to their age.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Discrimination</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Discrimination</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ethnocentrism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racism</IRI>
    <Literal xml:lang="FR">Racisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racism</IRI>
    <Literal xml:lang="EN">Racism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racism</IRI>
    <Literal xml:lang="FR">Votre argument suppose l’existence de races au sein de l’espèce humaine, et affirme que certaines seraient supérieures à d’autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racism</IRI>
    <Literal xml:lang="EN">Assuming the existence of races within the human species, some of which are superior to others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racism</IRI>
    <Literal xml:lang="FR">Les principaux problèmes de notre pays proviennent de ce groupe ethnique ; ils ne pourront jamais vraiment s’intégrer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racism</IRI>
    <Literal xml:lang="EN">The main problems in our country come from this ethnic group; they will never truly be able to integrate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Racism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Racisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#racism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
    <Literal xml:lang="FR">Sexisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
    <Literal xml:lang="EN">Sexism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
    <Literal xml:lang="FR">Votre argument repose sur des préjugés liés au sexe ou au genre et les perpétue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
    <Literal xml:lang="EN">Your argument relies on and perpetuates prejudices related to sex or gender.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
    <Literal xml:lang="FR">Cette équipe n’a jamais réussi à cause de sa directrice ; c’est bien connu, les femmes ne savent pas diriger.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
    <Literal xml:lang="EN">The team has been failing because of the female director; it's well known that women can't manage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sexism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sexisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#discrimination</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heteronormativity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heteronormativity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heteronormativity</IRI>
    <Literal xml:lang="FR">Hétéronormativité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heteronormativity</IRI>
    <Literal xml:lang="EN">Heteronormativity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heteronormativity</IRI>
    <Literal xml:lang="FR">Vous considérez l’hétérosexualité comme la norme et excluez d’autres orientations sexuelles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heteronormativity</IRI>
    <Literal xml:lang="EN">Viewing heterosexuality as the norm, excluding other sexual orientations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heteronormativity</IRI>
    <Literal xml:lang="FR">C’est normal pour une fille de vouloir un petit ami, pas une petite amie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heteronormativity</IRI>
    <Literal xml:lang="EN">It's normal for a girl to want a boyfriend, not a girlfriend.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heteronormativity</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Heteronormativity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heteronormativity</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/H%C3%A9t%C3%A9ronormativit%C3%A9</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heteronormativity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#heteronormativity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amatonormativity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amatonormativity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amatonormativity</IRI>
    <Literal xml:lang="FR">Amatonormativité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amatonormativity</IRI>
    <Literal xml:lang="EN">Amatonormativity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amatonormativity</IRI>
    <Literal xml:lang="FR">Vous considérez les relations romantiques comme la norme sociale à suivre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amatonormativity</IRI>
    <Literal xml:lang="EN">Viewing romantic relationships as the societal norm to follow.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amatonormativity</IRI>
    <Literal xml:lang="FR">C’est étrange qu’à son âge, il soit toujours célibataire. Il doit manquer quelque chose.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amatonormativity</IRI>
    <Literal xml:lang="EN">It's strange that at his age he's still single. Something must be missing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amatonormativity</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Amatonormativity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amatonormativity</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Amatonormativit%C3%A9</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amatonormativity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amatonormativity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
