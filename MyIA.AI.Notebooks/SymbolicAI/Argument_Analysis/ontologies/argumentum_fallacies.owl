    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <Literal xml:lang="FR">Argument fallacieux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <Literal xml:lang="EN">Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <Literal xml:lang="FR">Votre discours vise à tromper votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <Literal xml:lang="EN">Using an argument aimed at deceiving one's audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <Literal xml:lang="FR">Tout ce qui rare est cher. Un cheval bon marché est rare. Donc un cheval bon marché est cher.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <Literal xml:lang="EN">Everything rare is expensive. A cheap horse is rare. So a cheap horse is expensive.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#hasTopConcept" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#topConceptOf" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
    <Literal xml:lang="FR">Insuffisance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
    <Literal xml:lang="EN">Insufficiency</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
    <Literal xml:lang="FR">Les arguments que vous utilisez ne suffisent pas à démontrer votre propos.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
    <Literal xml:lang="EN">The arguments used fail to provide adequate support for the conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
    <Literal xml:lang="FR"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
    <Literal xml:lang="EN"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#GeneralAcceptanceDoubt_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <Literal xml:lang="FR">Généralisation hâtive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <Literal xml:lang="EN">Hasty generalization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <Literal xml:lang="FR">Vous construisez un argument à partir d’impressions ou d’anecdotes, sans preuve solide.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <Literal xml:lang="EN">Basing an argument on impressions or anecdotes, without solid evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <Literal xml:lang="FR">Hier, j’ai marché dans une crotte de chien après avoir salué un passant dans la rue. En ville, il vaut donc mieux éviter de parler à des inconnus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <Literal xml:lang="EN">Yesterday, I stepped in dog poo after greeting a passer-by in the street. In the city, it is therefore better to avoid talking to strangers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#LackOfPTKReliability_Scheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <Literal xml:lang="FR">Argument vide</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <Literal xml:lang="EN">Hollow argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <Literal xml:lang="FR">Vous utilisez des affirmations qui n’apportent rien à la construction d’un argument convaincant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <Literal xml:lang="EN">Using assertions that contribute nothing to building a convincing argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <Literal xml:lang="FR">Il est inutile que je poursuive mes études, car l’avenir est incertain.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <Literal xml:lang="EN">There is no point in my continuing my studies, because the future is uncertain.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argument_from_ignorance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Appel_%C3%A0_l%27ignorance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <Literal xml:lang="FR">Appel à l’ignorance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <Literal xml:lang="EN">Appeal to ignorance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <Literal xml:lang="FR">Vous jugez une proposition vraie uniquement parce qu’elle n’a pas été prouvée fausse, ou fausse parce qu’elle n’a pas été prouvée vraie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <Literal xml:lang="EN">Judging a proposition to be true solely because it has not been proven false, or false because it has not been proven true.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <Literal xml:lang="FR">Dieu n’existe pas, car personne n’a démontré son existence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <Literal xml:lang="EN">God doesn't exist since his existence has not been proven.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <Literal xml:lang="EN">http://philosophy.lander.edu/logic/ignorance.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Appel_%C3%A0_l%27ignorance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#Ignorance_Inference</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
    <Literal xml:lang="FR">Ignorance délibérée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
    <Literal xml:lang="EN">Willed ignorance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
    <Literal xml:lang="FR">Vous rejetez volontairement toute information qui pourrait contredire votre position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
    <Literal xml:lang="EN">Voluntarily avoiding knowledge of what could undermine one's argumentative position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
    <Literal xml:lang="FR">Je préfère que vous ne me disiez pas ce qu’ils ont fait ensuite : cela risquerait de contredire ce que je pense.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
    <Literal xml:lang="EN">I'd rather you didn't tell me what they did next: it might contradict what I think.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/182/Willed-Ignorance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invincibleIgnorance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invincibleIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invincibleIgnorance</IRI>
    <Literal xml:lang="FR">A priorisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invincibleIgnorance</IRI>
    <Literal xml:lang="EN">Invincible ignorance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invincibleIgnorance</IRI>
    <Literal xml:lang="FR">Vous refusez d’examiner toute preuve qui contredit vos croyances, quelle que soit sa force.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invincibleIgnorance</IRI>
    <Literal xml:lang="EN">Refusing to consider any evidence that contradicts one's beliefs, no matter how strong it is.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invincibleIgnorance</IRI>
    <Literal xml:lang="FR">Peu importe les nombreuses études montrant l’efficacité de ce traitement médical : je suis convaincu que seule cette pierre précieuse peut guérir ma maladie, car j’ai décidé qu’il en était ainsi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invincibleIgnorance</IRI>
    <Literal xml:lang="EN">No matter how many studies show the medical treatment's effectiveness, I still believe only this precious stone can heal my illness because I've decided it's so.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invincibleIgnorance</IRI>
    <Literal xml:lang="EN">http://www.ditext.com/fearnside/28.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invincibleIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invincibleIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truebelieverSyndrome</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truebelieverSyndrome</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truebelieverSyndrome</IRI>
    <Literal xml:lang="FR">Syndrome du vrai croyant</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truebelieverSyndrome</IRI>
    <Literal xml:lang="EN">True-believer syndrome</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truebelieverSyndrome</IRI>
    <Literal xml:lang="FR">Vous persistez dans une croyance erronée malgré des preuves solides du contraire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truebelieverSyndrome</IRI>
    <Literal xml:lang="EN">Persisting in an erroneous belief despite solid evidence to the contrary.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truebelieverSyndrome</IRI>
    <Literal xml:lang="FR">Seuls des extraterrestres ont pu construire ces soucoupes volantes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truebelieverSyndrome</IRI>
    <Literal xml:lang="EN">Only aliens could have built these flying saucers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truebelieverSyndrome</IRI>
    <Literal xml:lang="EN">http://skepdic.com/truebeliever.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truebelieverSyndrome</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Syndrome_du_vrai_croyant</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truebelieverSyndrome</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#truebelieverSyndrome</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taboo</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taboo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taboo</IRI>
    <Literal xml:lang="FR">Tabou</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taboo</IRI>
    <Literal xml:lang="EN">Taboo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taboo</IRI>
    <Literal xml:lang="FR">Vous refusez de discuter de faits qui pourraient invalider votre argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taboo</IRI>
    <Literal xml:lang="EN">Refusing to discuss facts that could invalidate one's argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taboo</IRI>
    <Literal xml:lang="FR">Nous n’avons pas besoin de discuter de ce problème de société : cela a toujours été comme ça et cela le restera.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taboo</IRI>
    <Literal xml:lang="EN">We don't need to discuss this societal issue; it has always been this way and will stay the same.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taboo</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Taboo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taboo</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Tabou</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taboo</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#taboo</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#willedIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMystery</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMystery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMystery</IRI>
    <Literal xml:lang="FR">Appel au mystère</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMystery</IRI>
    <Literal xml:lang="EN">Appeal to mystery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMystery</IRI>
    <Literal xml:lang="FR">Vous prétendez qu’un sujet est trop mystérieux pour être compris ou expliqué.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMystery</IRI>
    <Literal xml:lang="EN">Claiming a subject is too mysterious to be understood or explained.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMystery</IRI>
    <Literal xml:lang="FR">Face à la complexité de l’univers, je dis toujours qu’il ne sert à rien de chercher des explications : cela dépasse sûrement notre entendement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMystery</IRI>
    <Literal xml:lang="EN">Faced with the complexities of the universe, I've always said it's pointless to seek explanations; it must be something beyond our understanding.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMystery</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_mystery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMystery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMystery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingTheLimitationOfScience</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingTheLimitationOfScience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingTheLimitationOfScience</IRI>
    <Literal xml:lang="FR">Argument de la science lacunaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingTheLimitationOfScience</IRI>
    <Literal xml:lang="EN">Invoking the limitation of science</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingTheLimitationOfScience</IRI>
    <Literal xml:lang="FR">Vous soutenez une idée peu crédible en avançant que la science ne sait pas tout.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingTheLimitationOfScience</IRI>
    <Literal xml:lang="EN">Supporting a dubious claim by asserting that science does not have all the answers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingTheLimitationOfScience</IRI>
    <Literal xml:lang="FR">Puisque la science n’a pas d’explication pour la disparition des licornes, elles ont bien dû exister.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingTheLimitationOfScience</IRI>
    <Literal xml:lang="EN">Since science can't explain the disappearance of unicorns, they must have existed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingTheLimitationOfScience</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Science_doesn%27t_know_everything</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMystery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingTheLimitationOfScience</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#invokingTheLimitationOfScience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMystery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
    <Literal xml:lang="FR">Argument d’incrédulité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
    <Literal xml:lang="EN">Argument from incredulity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
    <Literal xml:lang="FR">Vous rejetez une hypothèse ou un fait sous prétexte qu’il vous paraît incompréhensible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
    <Literal xml:lang="EN">Rejecting a hypothesis or fact on the grounds that it seems incomprehensible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
    <Literal xml:lang="FR">Je refuse d’admettre la théorie du Big Bang, car elle est trop complexe pour être crédible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
    <Literal xml:lang="EN">I refuse to accept the Big Bang theory because it is too complex to be credible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Argument_from_incredulity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divineFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divineFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divineFallacy</IRI>
    <Literal xml:lang="FR">Sophisme théologique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divineFallacy</IRI>
    <Literal xml:lang="EN">Divine fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divineFallacy</IRI>
    <Literal xml:lang="FR">Vous attribuez à une intervention divine ce que vous n’arrivez pas à comprendre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divineFallacy</IRI>
    <Literal xml:lang="EN">Attributing what one cannot understand to divine intervention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divineFallacy</IRI>
    <Literal xml:lang="FR">C’est tellement merveilleux que seul Dieu a pu le faire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divineFallacy</IRI>
    <Literal xml:lang="EN">It is so wonderful that only God could have done it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divineFallacy</IRI>
    <Literal xml:lang="EN">http://skepdic.com/dvinefal.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divineFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#divineFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAstonishment</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAstonishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAstonishment</IRI>
    <Literal xml:lang="FR">Argument de l’étonnement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAstonishment</IRI>
    <Literal xml:lang="EN">Argument from personal astonishment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAstonishment</IRI>
    <Literal xml:lang="FR">Vous refusez de croire une proposition simplement parce qu’elle vous surprendrait si elle était vraie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAstonishment</IRI>
    <Literal xml:lang="EN">Refusing to believe a proposition simply because it would be surprising if it were true.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAstonishment</IRI>
    <Literal xml:lang="FR">Bien sûr que je ne crois pas que la Terre soit ronde : je suis monté sur la plus haute montagne, et l’horizon était plat comme la paume de ma main.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAstonishment</IRI>
    <Literal xml:lang="EN">Of course I don't believe the Earth is round; I've climbed the highest mountain and the horizon was as flat as the palm of my hand.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAstonishment</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#astonishment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAstonishment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAstonishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromIncredulity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackSwanFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackSwanFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackSwanFallacy</IRI>
    <Literal xml:lang="FR">Preuve par absence de réfutation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackSwanFallacy</IRI>
    <Literal xml:lang="EN">Black swan fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackSwanFallacy</IRI>
    <Literal xml:lang="FR">Vous jugez une théorie valide simplement parce qu’elle n’a pas encore été réfutée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackSwanFallacy</IRI>
    <Literal xml:lang="EN">Using the lack of facts contradicting a theory as proof of the theory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackSwanFallacy</IRI>
    <Literal xml:lang="FR">Puisque nous n’avons encore capturé aucun extraterrestre, cela montre qu’ils sont assez avancés pour échapper à notre détection.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackSwanFallacy</IRI>
    <Literal xml:lang="EN">Since we haven't captured any aliens to prove their existence yet, this proves they are advanced enough to evade our detection.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackSwanFallacy</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/black_swan_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackSwanFallacy</IRI>
    <Literal xml:lang="FR">https://cortecs.org/materiel/sophisme-le-repulsif-anti-girafe/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackSwanFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackSwanFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToComplexity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToComplexity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToComplexity</IRI>
    <Literal xml:lang="FR">Appel à la complexité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToComplexity</IRI>
    <Literal xml:lang="EN">Appeal to complexity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToComplexity</IRI>
    <Literal xml:lang="FR">Vous considérez qu’une idée trop complexe pour vous l’est aussi pour tout le monde, ce qui justifie vos propres spéculations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToComplexity</IRI>
    <Literal xml:lang="EN">Considering that an idea too complex for oneself is also too complex for everyone, thereby justifying one's own speculations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToComplexity</IRI>
    <Literal xml:lang="FR">La physique quantique est si complexe que personne ne peut vraiment prétendre comprendre l’univers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToComplexity</IRI>
    <Literal xml:lang="EN">Quantum physics is so complex that no one can truly claim to understand the universe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToComplexity</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#complexity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToComplexity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToComplexity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
    <Literal xml:lang="FR">Argument d’omniscience</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
    <Literal xml:lang="EN">Argument from omniscience</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
    <Literal xml:lang="FR">Vous prétendez tout savoir sur le sujet et affirmez des vérités générales qui devraient pourtant être débattues.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
    <Literal xml:lang="EN">Claiming to know everything about a subject, asserting general truths that should nevertheless be discussed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
    <Literal xml:lang="FR">En matière d’astronomie, je sais ce dont je parle, alors ne remettez pas en question mes théories sur les trous noirs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
    <Literal xml:lang="EN">In matters of astronomy, I know what I'm talking about, so do not question my theories about black holes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_omniscience</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="FR">Réfutation lapidaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="EN">Appeal to the stone</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="FR">Vous rejetez arbitrairement une proposition sans fournir d’explication ou de preuve.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="EN">Dismissing a statement or proposition summarily, without giving any explanation or evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="FR">Ce que vous affirmez ne peut pas être vrai, parce que cela semble complètement ridicule.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="EN">What you claim cannot be true because that just sounds completely ridiculous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argumentum_ad_lapidem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStone</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sherlockHolmesFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sherlockHolmesFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sherlockHolmesFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de Sherlock Holmes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sherlockHolmesFallacy</IRI>
    <Literal xml:lang="EN">Sherlock Holmes fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sherlockHolmesFallacy</IRI>
    <Literal xml:lang="FR">Vous estimez que votre explication est la bonne sous prétexte que toutes celles qui ont été considérées étaient fausses, ignorant ainsi d’autres hypothèses non encore évoquées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sherlockHolmesFallacy</IRI>
    <Literal xml:lang="EN">Considering one's explanation to be correct on the pretext that all those considered were false, thus ignoring other hypotheses not yet mentioned.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sherlockHolmesFallacy</IRI>
    <Literal xml:lang="FR">Il doit forcément s’agir d’un complot ; après avoir éliminé tous les autres scénarios, c’est la seule explication qui reste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sherlockHolmesFallacy</IRI>
    <Literal xml:lang="EN">It must be a conspiracy; after eliminating all other scenarios, it's the only explanation left.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sherlockHolmesFallacy</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Holmesian_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sherlockHolmesFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sherlockHolmesFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="FR">Substitut de preuve</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="EN">Proof Surrogate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="FR">Vous prétendez apporter une preuve, sans en fournir réellement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="EN">Claiming to provide proof or evidence, when in reality, none is actually presented.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="FR">Tout le monde sait que cette politique est inefficace. Les experts en parlent tout le temps à la télévision.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="EN">Everybody claims that this policy is ineffective because they always see discussions about its failures on TV.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/logicalfallacies/Proof-Surrogate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofSurrogate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromOmniscience</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPragmaticUrgency</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPragmaticUrgency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPragmaticUrgency</IRI>
    <Literal xml:lang="FR">Appel à l’urgence pragmatique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPragmaticUrgency</IRI>
    <Literal xml:lang="EN">Appeal to pragmatic urgency</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPragmaticUrgency</IRI>
    <Literal xml:lang="FR">Vous défendez votre point de vue en insistant sur la nécessité d’agir, même sans preuve que l’action proposée est la bonne.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPragmaticUrgency</IRI>
    <Literal xml:lang="EN">Defending one's point of view by insisting on the need to act, even without evidence that the proposed action is the right one.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPragmaticUrgency</IRI>
    <Literal xml:lang="FR">On ne peut pas laisser les souris proliférer dans la cave. Il faut donc l’inonder.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPragmaticUrgency</IRI>
    <Literal xml:lang="EN">We can't let the mice keep multiplying in the cellar. So we have to flood it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPragmaticUrgency</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/28/Appeal-to-Desperation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPragmaticUrgency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPragmaticUrgency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="FR">Syllogisme du politicien</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="EN">Politician's syllogism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="FR">Vous affirmez qu’une action est souhaitable simplement parce qu’il faut faire quelque chose, sans montrer qu’elle est réellement appropriée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="EN">Claiming that an action is desirable simply because something must be done, without showing that it is actually appropriate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="FR">Pour qu’elle s’améliore, la situation doit changer. Nous changeons la situation, donc nous améliorons la situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="EN">To improve our situation, change is needed. We are making changes, hence we are improving the situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Politician%27s_syllogism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPragmaticUrgency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politiciansSyllogism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPragmaticUrgency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="FR">Acte de foi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="EN">Leap of faith</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="FR">Vous demandez d’accepter une affirmation sans fournir de raison ni d’explication logique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="EN">Asking for a claim to be accepted without providing any reason or logical explanation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="FR">Vous pouvez me croire quand je vous dis que notre produit est supérieur à tous les autres sur le marché.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="EN">You can believe me when I say that our product is superior to every other product on the market.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Leap_of_faith</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Acte_de_foi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHeaven</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHeaven</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHeaven</IRI>
    <Literal xml:lang="FR">Appel au ciel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHeaven</IRI>
    <Literal xml:lang="EN">Appeal to Heaven</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHeaven</IRI>
    <Literal xml:lang="FR">Pour faire accepter vos conclusions, vous affirmez qu’elles sont dictées par la volonté divine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHeaven</IRI>
    <Literal xml:lang="EN">Asserting that a conclusion or proposition must be accepted because it is the will of God or the will of the gods.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHeaven</IRI>
    <Literal xml:lang="FR">Nous devons le faire, parce que Dieu le veut.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHeaven</IRI>
    <Literal xml:lang="EN">Because it's God's will, we must do it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHeaven</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/35/Appeal-to-Heaven</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHeaven</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHeaven</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superstition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superstition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superstition</IRI>
    <Literal xml:lang="FR">Superstition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superstition</IRI>
    <Literal xml:lang="EN">Superstition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superstition</IRI>
    <Literal xml:lang="FR">Vos avis comme vos actions sont motivés par l’interprétation magique ou mystique que vous faites de certains phénomènes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superstition</IRI>
    <Literal xml:lang="EN">Basing one's opinions and actions on the magical or mystical interpretation of certain phenomena.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superstition</IRI>
    <Literal xml:lang="FR">Si nous ne faisons pas cette cérémonie lors de l’éclipse, alors les démons reviendront.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superstition</IRI>
    <Literal xml:lang="EN">If we don't perform this ceremony during the eclipse, then the demons will return.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superstition</IRI>
    <Literal xml:lang="EN">http://skepdic.com/superstition.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superstition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superstition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magicalThinking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magicalThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magicalThinking</IRI>
    <Literal xml:lang="FR">Pensée magique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magicalThinking</IRI>
    <Literal xml:lang="EN">Magical thinking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magicalThinking</IRI>
    <Literal xml:lang="FR">Vous croyez à tort que deux événements sont liés, par superstition, au lieu de vous appuyer sur la logique ou sur des preuves.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magicalThinking</IRI>
    <Literal xml:lang="EN">Making causal connections between two events on the basis of superstition rather than logic or evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magicalThinking</IRI>
    <Literal xml:lang="FR">Grâce à la décision de l’église, il a plu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magicalThinking</IRI>
    <Literal xml:lang="EN">Thanks to the church's decision it rained.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magicalThinking</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/123/Magical-Thinking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magicalThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#magicalThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leapOfFaith</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <Literal xml:lang="FR">Pensée clichée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <Literal xml:lang="EN">Cliche thinking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <Literal xml:lang="FR">Vous fondez vos arguments sur des expressions toutes faites, comme si elles constituaient des preuves solides.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <Literal xml:lang="EN">Basing arguments on ready-made expressions as if they constituted solid evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <Literal xml:lang="FR">Tout travail mérite salaire ; il est donc grand temps pour nous de récolter les fruits de nos efforts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <Literal xml:lang="EN">All work deserves pay; so it is high time for us to reap the fruits of our efforts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#cliche</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hollowArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exceptionThatProvesTheRule</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exceptionThatProvesTheRule</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exceptionThatProvesTheRule</IRI>
    <Literal xml:lang="FR">L’exception qui confirme la règle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exceptionThatProvesTheRule</IRI>
    <Literal xml:lang="EN">Exception that proves the rule</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exceptionThatProvesTheRule</IRI>
    <Literal xml:lang="FR">Lorsqu’on oppose à votre thèse un contre-exemple, vous l’invalidez d’emblée en invoquant le cliché de l’exception qui confirme la règle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exceptionThatProvesTheRule</IRI>
    <Literal xml:lang="EN">Invalidating a counterexample to one's thesis outright by invoking the cliché of the exception that proves the rule.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exceptionThatProvesTheRule</IRI>
    <Literal xml:lang="FR">Il est vrai que j’ai réussi sans ce diplôme, mais je suis l’exception qui confirme la règle. Il faut absolument que vous l’obteniez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exceptionThatProvesTheRule</IRI>
    <Literal xml:lang="EN">I succeeded without that degree, but I'm the exception that confirms the rule. You definitely need to get yours.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exceptionThatProvesTheRule</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#proves_the_rule</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exceptionThatProvesTheRule</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exceptionThatProvesTheRule</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inTheoryButNotPractice</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inTheoryButNotPractice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inTheoryButNotPractice</IRI>
    <Literal xml:lang="FR">Révocation de l’abstrait</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inTheoryButNotPractice</IRI>
    <Literal xml:lang="EN">In theory, but not practice</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inTheoryButNotPractice</IRI>
    <Literal xml:lang="FR">Vous disqualifiez un argument spéculatif en usant du cliché selon lequel la théorie ne résiste jamais à l’épreuve de la pratique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inTheoryButNotPractice</IRI>
    <Literal xml:lang="EN">Rejecting a speculative argument by invoking the cliché that theory never stands up in practice.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inTheoryButNotPractice</IRI>
    <Literal xml:lang="FR">Bien sûr que je n’ai pas pris en compte cette théorie que vous nous avez enseignée. Tout le monde sait que, dans le monde réel, rien ne se passe jamais comme dans les livres !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inTheoryButNotPractice</IRI>
    <Literal xml:lang="EN">Of course, I didn't consider that theory you taught us. We all know that in the real world, things never happen as they do in books!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inTheoryButNotPractice</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#It_Applies_in_Theory,_But_Not_in_Practice</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inTheoryButNotPractice</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_XXXIII</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inTheoryButNotPractice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inTheoryButNotPractice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snowclone</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snowclone</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snowclone</IRI>
    <Literal xml:lang="FR">Détournement de cliché</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snowclone</IRI>
    <Literal xml:lang="EN">Snowclone</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snowclone</IRI>
    <Literal xml:lang="FR">Vous modifiez à dessein une expression populaire afin de l’adapter au contexte de votre argumentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snowclone</IRI>
    <Literal xml:lang="EN">Adapting a well-known quote to the context of an argumentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snowclone</IRI>
    <Literal xml:lang="FR">Je dis toujours, on ne change pas une équipe qui gagne. Pourquoi essayer autre chose ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snowclone</IRI>
    <Literal xml:lang="EN">I always say, you don't change a winning team. Why try anything else?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snowclone</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Snowclone</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snowclone</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Snowclone</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snowclone</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snowclone</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credoQuiaAbsurdum</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credoQuiaAbsurdum</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credoQuiaAbsurdum</IRI>
    <Literal xml:lang="FR">Preuve par l’absurde fallacieuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credoQuiaAbsurdum</IRI>
    <Literal xml:lang="EN">Credo quia absurdum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credoQuiaAbsurdum</IRI>
    <Literal xml:lang="FR">Vous pensez que l’absurdité apparente d’une idée est une raison suffisante pour y croire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credoQuiaAbsurdum</IRI>
    <Literal xml:lang="EN">Arguing that the absurdity of something is the main reason to believe it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credoQuiaAbsurdum</IRI>
    <Literal xml:lang="FR">Pourquoi est-ce que j’apporte un parapluie en plein été, alors que le soleil brille ? Parce qu’il est tellement improbable qu’il pleuve aujourd’hui que cela va sûrement arriver.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credoQuiaAbsurdum</IRI>
    <Literal xml:lang="EN">Why do I carry an umbrella in mid-summer with the sun shining bright? Because it's so unlikely to rain today, that it must surely happen.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credoQuiaAbsurdum</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Credo_quia_absurdum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credoQuiaAbsurdum</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#credoQuiaAbsurdum</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lapalissade</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lapalissade</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lapalissade</IRI>
    <Literal xml:lang="FR">Lapalissade</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lapalissade</IRI>
    <Literal xml:lang="EN">Lapalissade</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lapalissade</IRI>
    <Literal xml:lang="FR">Vous énoncez une vérité tellement évidente qu’elle ne soutient aucun argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lapalissade</IRI>
    <Literal xml:lang="EN">Stating a truth so obvious that it supports no argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lapalissade</IRI>
    <Literal xml:lang="FR">Si je n’ai pas de nouvelles de mon fils, c’est qu’il n’a rien à me dire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lapalissade</IRI>
    <Literal xml:lang="EN">If I haven't heard from my son, it's because he has nothing to tell me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lapalissade</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Lapalissade</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lapalissade</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Lapalissade</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lapalissade</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lapalissade</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bromide</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bromide</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bromide</IRI>
    <Literal xml:lang="FR">Bromure</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bromide</IRI>
    <Literal xml:lang="EN">Bromide</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bromide</IRI>
    <Literal xml:lang="FR">Vous énoncez des platitudes afin d’endormir la vigilance de votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bromide</IRI>
    <Literal xml:lang="EN">Stating platitudes in order to lull one's audience into lowering its guard.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bromide</IRI>
    <Literal xml:lang="FR">Ne vous préoccupez pas de la crise économique, mon vieux. Comme on dit : après la pluie, le beau temps !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bromide</IRI>
    <Literal xml:lang="EN">Don't worry about the economic crisis, old sport. As they say, every cloud has a silver lining!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bromide</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Bromide_(language)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bromide</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bromide</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clicheThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
    <Literal xml:lang="FR">Justification triviale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
    <Literal xml:lang="EN">Trivial Justification</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
    <Literal xml:lang="FR">Vous accordez à une habitude, à une impression ou à un exemple la valeur d’une preuve.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
    <Literal xml:lang="EN">Treating a habit, an impression, or an example as if it were evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
    <Literal xml:lang="FR">Je conviens que votre calcul est correct. Mais votre raisonnement est insignifiant : ce détail ne change rien au problème de fond. — Rejet d’un argument correct sur la base de son importance perçue, pas de sa validité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
    <Literal xml:lang="EN">I agree that your calculation is correct. But your reasoning is insignificant: this detail changes nothing about the underlying issue. — Rejection of a correct argument based on its perceived importance, not its validity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#AlternativeMeans_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="FR">Preuve anecdotique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="EN">Anecdotal evidence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="FR">Vous basez votre argumentation sur un événement isolé, qui ne suffit pas à démontrer une règle générale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="EN">Basing an argument on an isolated event that is not enough to demonstrate a general rule.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="FR">J’ai eu de bonnes notes en mathématiques après avoir bu du jus de cassis ; le jus de cassis rend donc fort en mathématiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="EN">I had good grades in mathematics after drinking blackcurrant juice; thus, blackcurrant juice makes one strong in mathematics.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Anecdotal_evidence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromHearsay</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromHearsay</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromHearsay</IRI>
    <Literal xml:lang="FR">Argument par ouï-dire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromHearsay</IRI>
    <Literal xml:lang="EN">Argument from hearsay</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromHearsay</IRI>
    <Literal xml:lang="FR">Votre discours repose sur des propos rapportés et donc invérifiables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromHearsay</IRI>
    <Literal xml:lang="EN">Basing an argument on reported and therefore unverifiable statements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromHearsay</IRI>
    <Literal xml:lang="FR">Nombreux sont ceux qui m’ont dit que le maire est corrompu. On ne peut pas lui faire confiance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromHearsay</IRI>
    <Literal xml:lang="EN">Many people have told me that the mayor is corrupt. He cannot be trusted.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromHearsay</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/52/Argument-from-Hearsay</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromHearsay</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromHearsay</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#counterfactualAssumption</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#counterfactualAssumption</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#counterfactualAssumption</IRI>
    <Literal xml:lang="FR">Hypothèse contraire aux faits</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#counterfactualAssumption</IRI>
    <Literal xml:lang="EN">Counterfactual assumption</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#counterfactualAssumption</IRI>
    <Literal xml:lang="FR">Vous vous appuyez sur des suppositions irréalistes pour soutenir votre point de vue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#counterfactualAssumption</IRI>
    <Literal xml:lang="EN">Arguing on the basis of an assumption which is not actually true.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#counterfactualAssumption</IRI>
    <Literal xml:lang="FR">Si César avait eu des chars d’assaut, Rome n’aurait jamais chuté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#counterfactualAssumption</IRI>
    <Literal xml:lang="EN">If Caesar had had tanks, Rome would never have fallen.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#counterfactualAssumption</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/106/Hypothesis-Contrary-to-Fact</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#counterfactualAssumption</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#counterfactualAssumption</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
    <Literal xml:lang="FR">Sophisme pragmatique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
    <Literal xml:lang="EN">Pragmatic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
    <Literal xml:lang="FR">Vous croyez qu’une solution fonctionnant pour une personne conviendra nécessairement à tout le monde.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
    <Literal xml:lang="EN">Assuming that something which helped one (usually the speaker) will help anyone.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
    <Literal xml:lang="FR">L’uniforme m’a permis de remettre ma vie sur les rails. Tout le monde devrait donc passer par l’armée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
    <Literal xml:lang="EN">The uniform helped me get my life back on track. Everyone should therefore go through the military.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Pragmatic_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theBrokenClock</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theBrokenClock</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theBrokenClock</IRI>
    <Literal xml:lang="FR">La pendule arrêtée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theBrokenClock</IRI>
    <Literal xml:lang="EN">The broken clock</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theBrokenClock</IRI>
    <Literal xml:lang="FR">Vous pensez qu’une chose vraie une fois le sera toujours, même si cette vérité n’est due qu’au hasard.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theBrokenClock</IRI>
    <Literal xml:lang="EN">Asserting the accuracy of a theory on the basis of its correct prediction on one or several specific, lucky cases.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theBrokenClock</IRI>
    <Literal xml:lang="FR">L’horloge de la gare est arrêtée depuis des mois, mais il arrive qu’elle indique l’heure exacte ; cela prouve qu’elle fonctionne par intermittence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theBrokenClock</IRI>
    <Literal xml:lang="EN">The station clock has been stopped for months, but it sometimes shows the exact time; this proves that it works intermittently.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theBrokenClock</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Stopped_clock</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theBrokenClock</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theBrokenClock</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theSqueakyWheel</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theSqueakyWheel</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theSqueakyWheel</IRI>
    <Literal xml:lang="FR">La roue grinçante</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theSqueakyWheel</IRI>
    <Literal xml:lang="EN">The squeaky wheel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theSqueakyWheel</IRI>
    <Literal xml:lang="FR">Vous supposez que votre idée est correcte simplement parce qu’elle n’a pas été réfutée, sans fournir de preuve concrète.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theSqueakyWheel</IRI>
    <Literal xml:lang="EN">Grounding the validity of an argument on the absence of contrary evidence rather than on supporting evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theSqueakyWheel</IRI>
    <Literal xml:lang="FR">Mon voisin n’a jamais signalé de problème quand je mets ma musique à fond, donc il doit apprécier mon bon goût musical.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theSqueakyWheel</IRI>
    <Literal xml:lang="EN">I play my music loud and my neighbor never complains, so they must enjoy my taste in music.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theSqueakyWheel</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/The_squeaky_wheel_gets_the_grease*</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theSqueakyWheel</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theSqueakyWheel</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pragmaticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFriendArgument</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFriendArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFriendArgument</IRI>
    <Literal xml:lang="FR">Argument de l’ami</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFriendArgument</IRI>
    <Literal xml:lang="EN">The friend argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFriendArgument</IRI>
    <Literal xml:lang="FR">Pour vous défendre d’une accusation de préjugé, vous prétendez fréquenter quelqu’un du groupe concerné.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFriendArgument</IRI>
    <Literal xml:lang="EN">Invoking a friend within a group in order to fend off accusations of prejudice against that group.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFriendArgument</IRI>
    <Literal xml:lang="FR">Je ne suis pas antisémite puisque j’ai un ami juif.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFriendArgument</IRI>
    <Literal xml:lang="EN">I'm not antisemitic; I have a Jewish friend.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFriendArgument</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Friend_argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFriendArgument</IRI>
    <Literal xml:lang="FR">http://rationalwiki.org/wiki/Argument_de_l'ami</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFriendArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFriendArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKnowItWhenISeeIt</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKnowItWhenISeeIt</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKnowItWhenISeeIt</IRI>
    <Literal xml:lang="FR">Je le sais quand je le vois</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKnowItWhenISeeIt</IRI>
    <Literal xml:lang="EN">I know it when I see it</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKnowItWhenISeeIt</IRI>
    <Literal xml:lang="FR">Vous prétendez identifier une réalité juste par intuition, sans critère vérifiable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKnowItWhenISeeIt</IRI>
    <Literal xml:lang="EN">Instead of relying on objective definitions, asserting one's individual, subjective and arbitrary judgement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKnowItWhenISeeIt</IRI>
    <Literal xml:lang="FR">Je n’ai peut-être pas de preuve concrète, mais je ressens simplement que cette décision politique est néfaste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKnowItWhenISeeIt</IRI>
    <Literal xml:lang="EN">I may not have concrete evidence, but I just feel this political decision is harmful.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKnowItWhenISeeIt</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/I_know_it_when_I_see_it</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKnowItWhenISeeIt</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#iKnowItWhenISeeIt</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFiction</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFiction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFiction</IRI>
    <Literal xml:lang="FR">Appel à la fiction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFiction</IRI>
    <Literal xml:lang="EN">Appeal to fiction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFiction</IRI>
    <Literal xml:lang="FR">Vous argumentez sur la réalité en vous basant sur des éléments de fiction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFiction</IRI>
    <Literal xml:lang="EN">Making claims about reality on the basis of evidence drawn from fictional works.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFiction</IRI>
    <Literal xml:lang="FR">Dans mon roman de science-fiction, l’humanité crée un bouclier contre la pollution en utilisant l’énergie des étoiles filantes. Si seulement notre gouvernement pouvait faire la même chose pour sauver la planète !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFiction</IRI>
    <Literal xml:lang="EN">In my science-fiction novel, humanity creates a shield against pollution by using the energy of shooting stars. If only our government could do the same to save the planet!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFiction</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Generalization_from_fictional_evidence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFiction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFiction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anecdotalEvidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <Literal xml:lang="FR">Pratique courante</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <Literal xml:lang="EN">Appeal to common practice</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <Literal xml:lang="FR">Vous considérez qu’un comportement est justifié parce qu’il est communément adopté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <Literal xml:lang="EN">Justifying choices, methods or actions on grounds that they are common practice.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <Literal xml:lang="FR">Tout le monde dépasse les limites de vitesse ; cela ne devrait donc pas être sanctionné.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <Literal xml:lang="EN">Everyone speeds; it shouldn't be penalized.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <Literal xml:lang="EN">http://www.nizkor.org/features/fallacies/appeal-to-common-practice.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <Literal xml:lang="FR">http://autopsia.fr/sophismes-arguments-autorite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#closeMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#PopularPractice_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegedCertainty</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegedCertainty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegedCertainty</IRI>
    <Literal xml:lang="FR">Certitude supposée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegedCertainty</IRI>
    <Literal xml:lang="EN">Alleged certainty</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegedCertainty</IRI>
    <Literal xml:lang="FR">Vous présupposez que tout le monde adhère à vos croyances sans qu’elles soient remises en question.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegedCertainty</IRI>
    <Literal xml:lang="EN">Presupposing that everyone shares one's beliefs without them being questioned.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegedCertainty</IRI>
    <Literal xml:lang="FR">Je suis sûr que tout le monde dans mon quartier trouve cette route inutile. Il ne fait aucun doute que la mairie ferait mieux de l’abandonner.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegedCertainty</IRI>
    <Literal xml:lang="EN">I'm sure everyone in my neighborhood thinks this road is unnecessary. There's no doubt the local government should abandon it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegedCertainty</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/15/Alleged-Certainty</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegedCertainty</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegedCertainty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSilentMajority</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSilentMajority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSilentMajority</IRI>
    <Literal xml:lang="FR">Appel à la majorité silencieuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSilentMajority</IRI>
    <Literal xml:lang="EN">Appeal to silent majority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSilentMajority</IRI>
    <Literal xml:lang="FR">Vous invoquez l’existence d’un grand nombre de personnes qui, bien que ne l’ayant jamais exprimé, partageraient votre point de vue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSilentMajority</IRI>
    <Literal xml:lang="EN">Calling upon a hypothetical mass of citizens that support a proposition, but have not publicly expressed this in any tangible way.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSilentMajority</IRI>
    <Literal xml:lang="FR">Je dis seulement haut et fort ce que beaucoup de gens pensent tout bas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSilentMajority</IRI>
    <Literal xml:lang="EN">I am only saying out loud what many people think quietly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSilentMajority</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Silent_Majority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegedCertainty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSilentMajority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSilentMajority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegedCertainty</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNormality</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNormality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNormality</IRI>
    <Literal xml:lang="FR">Appel à la normalité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNormality</IRI>
    <Literal xml:lang="EN">Appeal to normality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNormality</IRI>
    <Literal xml:lang="FR">Vous pensez que si quelque chose est normal ou moyen, cela le rend automatiquement correct ou acceptable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNormality</IRI>
    <Literal xml:lang="EN">Thinking that if something is normal or average, that automatically makes it correct or acceptable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNormality</IRI>
    <Literal xml:lang="FR">90 % des personnes interrogées utilisent leur smartphone au réveil. C’est donc forcément la manière idéale de commencer la journée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNormality</IRI>
    <Literal xml:lang="EN">90% of those surveyed use their smartphones right after waking up. It must be the ideal way to start the day.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNormality</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/37/Appeal-to-Normality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNormality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNormality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonFolk</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonFolk</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonFolk</IRI>
    <Literal xml:lang="FR">Appel au commun des mortels</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonFolk</IRI>
    <Literal xml:lang="EN">Appeal to common folk</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonFolk</IRI>
    <Literal xml:lang="FR">Vous pensez qu’en étant "comme tout le monde", votre argument est nécessairement valide.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonFolk</IRI>
    <Literal xml:lang="EN">Thinking that by being "like everyone else", one's argument is necessarily valid.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonFolk</IRI>
    <Literal xml:lang="FR">Je suis un citoyen lambda, et je trouve cette mesure disproportionnée, donc elle n’est pas adaptée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonFolk</IRI>
    <Literal xml:lang="EN">I'm an ordinary citizen, and I find this measure excessive; hence it's clearly unsuitable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonFolk</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/25/Appeal-to-Common-Folk</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonFolk</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonFolk</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#communalReinforcement</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#communalReinforcement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#communalReinforcement</IRI>
    <Literal xml:lang="FR">Renforcement communautaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#communalReinforcement</IRI>
    <Literal xml:lang="EN">Communal reinforcement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#communalReinforcement</IRI>
    <Literal xml:lang="FR">Vous répétez sans cesse la même affirmation au sein d’un groupe, jusqu’à ce qu’elle devienne une croyance collective.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#communalReinforcement</IRI>
    <Literal xml:lang="EN">Repeating assertions consistent with an idea within a community in order to convince its members despite lack of evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#communalReinforcement</IRI>
    <Literal xml:lang="FR">Chaque année, pour Noël, on nous rappelle combien notre famille est exceptionnelle et doit se méfier des influences extérieures. Tout le monde l’a bien compris maintenant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#communalReinforcement</IRI>
    <Literal xml:lang="EN">Every year at Christmas, we are reminded how unique our family is and that we should be wary of outsiders. Everyone gets the message now.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#communalReinforcement</IRI>
    <Literal xml:lang="EN">http://skepdic.com/communalreinforcement.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#communalReinforcement</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#communalReinforcement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldEffect</IRI>
    <Literal xml:lang="FR">Effet Gold</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldEffect</IRI>
    <Literal xml:lang="EN">The Gold effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldEffect</IRI>
    <Literal xml:lang="FR">Vous cherchez à obtenir l’approbation d’une communauté scientifique sur une idée non vérifiée pour créer un faux consensus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldEffect</IRI>
    <Literal xml:lang="EN">Seeking the approval of a scientific community for an unverified idea in order to create a false consensus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldEffect</IRI>
    <Literal xml:lang="FR">Ma théorie sur les bienfaits de la luminothérapie a été plébiscitée lors du dernier colloque. Plus besoin de preuves, la communauté est convaincue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldEffect</IRI>
    <Literal xml:lang="EN">My theory on the benefits of light therapy was overwhelmingly supported at the last conference. No further evidence needed, the community is persuaded.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Gold_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#communalReinforcement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#communalReinforcement</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonSense</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonSense</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonSense</IRI>
    <Literal xml:lang="FR">Appel au bon sens</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonSense</IRI>
    <Literal xml:lang="EN">Appeal to common sense</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonSense</IRI>
    <Literal xml:lang="FR">Vous vous appuyez sur ce qui semble être du bon sens pour justifier une proposition sans preuve, en jouant sur la peur d’être jugé autrement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonSense</IRI>
    <Literal xml:lang="EN">Asserting that an idea is common sense in order to impose it without proof, leveraging the opponent's fear of being bizarre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonSense</IRI>
    <Literal xml:lang="FR">C’est le bon sens même de ne pas nager après avoir mangé. Pourquoi remettre en question cette règle populaire avec des études scientifiques ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonSense</IRI>
    <Literal xml:lang="EN">It just makes sense not to swim right after eating. Why challenge this popular rule with scientific studies?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonSense</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#commonsense</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonSense</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonSense</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCommonPractice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="FR">Sophisme du psychologue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="EN">Psychologist's fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="FR">Vous confondez votre perspective individuelle avec une objectivité universelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="EN">Confusing subjective experience of reality with the essence of that which is being observed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="FR">Je trouve les enfants terrifiants ; vous avez donc beaucoup de mérite à élever le vôtre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="EN">I find children terrifying; you deserve a lot of credit for raising yours.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Psychologist%27s_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trivialJustification</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="FR">Projection mentale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="EN">Mind projection fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="FR">Vous considérez que votre manière d’envisager le monde reflète exactement la réalité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="EN">To believe that one's personal way of viewing the world reflects the exact nature of reality.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="FR">En ces temps de grande incertitude pour notre entreprise, il me paraît inconcevable que vous puissiez refuser cette baisse de salaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="EN">In these times of great uncertainty for our company, it seems inconceivable to me that you could refuse this pay cut.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Mind_projection_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindProjectionFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="FR">Raisonnement émotionnel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="EN">Emotional reasoning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="FR">Vous considérez que quelque chose est vrai parce que vous le ressentez fortement, même en l’absence de preuve.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="EN">Considering something to be true because one feels it strongly, even in the absence of evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="FR">Je me sens nul, donc je dois vraiment être nul.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="EN">I feel like a failure, so I must truly be one.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Emotional_reasoning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Raisonnement_%C3%A9motionnel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologistsFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveFallacy</IRI>
    <Literal xml:lang="FR">Sophisme affectif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveFallacy</IRI>
    <Literal xml:lang="EN">Affective Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveFallacy</IRI>
    <Literal xml:lang="FR">Vous considérez que vos émotions ou intuitions sont des indices indiscutables de vérité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveFallacy</IRI>
    <Literal xml:lang="EN">Claiming that intuition or emotion are divine truth detectors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveFallacy</IRI>
    <Literal xml:lang="FR">Ce candidat ne m’inspire pas confiance, il ne doit donc pas être compétent pour nous représenter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveFallacy</IRI>
    <Literal xml:lang="EN">This candidate doesn't inspire confidence in me, hence they must not be competent to represent us.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveFallacy</IRI>
    <Literal xml:lang="EN">http://utminers.utep.edu/omwilliamson/ENGL1311/fallacies.htm#5</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#affectiveFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalReasoning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <Literal xml:lang="FR">Sauvetage ad hoc</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <Literal xml:lang="EN">Ad hoc rescue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <Literal xml:lang="FR">Face à des objections valables, vous improvisez des justifications sans fondement pour échapper à la critique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <Literal xml:lang="EN">Improvising unfounded justifications in the face of valid objections in order to escape criticism.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <Literal xml:lang="FR">Si on ne voit pas les extraterrestres, c’est parce qu’ils rendent amnésiques tous ceux qui les aperçoivent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <Literal xml:lang="EN">If we don't see extraterrestrials, it's because they give amnesia to everyone who sees them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/8/Ad-Hoc-Rescue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <Literal xml:lang="FR">https://initiativerationnelle.wordpress.com/2016/04/16/sauvetage-ad-hoc/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hastyGeneralization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
    <Literal xml:lang="FR">Le marteau d’or</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
    <Literal xml:lang="EN">The golden hammer</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
    <Literal xml:lang="FR">Vous appliquez la même solution à divers problèmes, sans tenir compte du contexte spécifique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
    <Literal xml:lang="EN">Applying the same solution to various problems without taking the specific context into account.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
    <Literal xml:lang="FR">Quelle que soit la complexité de la panne de votre voiture, tapez sur le moteur avec un marteau. Cela règle tous mes problèmes mécaniques, donc cela devrait aussi fonctionner pour vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
    <Literal xml:lang="EN">No matter the complexity of your car's malfunction, just hammer the engine. This fixes all my mechanical problems, so it should work for you too.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Golden_hammer</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fractalWrongness</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fractalWrongness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fractalWrongness</IRI>
    <Literal xml:lang="FR">Contre-vérité fractale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fractalWrongness</IRI>
    <Literal xml:lang="EN">Fractal wrongness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fractalWrongness</IRI>
    <Literal xml:lang="FR">Chaque niveau de votre raisonnement repose sur une erreur, ce qui vous conduit à des conclusions tout aussi erronées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fractalWrongness</IRI>
    <Literal xml:lang="EN">Having every level of a line of reasoning rest on an error, leading to equally erroneous conclusions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fractalWrongness</IRI>
    <Literal xml:lang="FR">Chaque catastrophe naturelle est un nouveau signe de la colère divine devant votre entêtement à ne pas m’écouter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fractalWrongness</IRI>
    <Literal xml:lang="EN">Every natural disaster is a new sign of God's wrath due to your stubbornness in not listening to me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fractalWrongness</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Fractal_wrongness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fractalWrongness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fractalWrongness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingUnexplainedAndUnexplainable</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingUnexplainedAndUnexplainable</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingUnexplainedAndUnexplainable</IRI>
    <Literal xml:lang="FR">Le faux mystère</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingUnexplainedAndUnexplainable</IRI>
    <Literal xml:lang="EN">Confusing unexplained and unexplainable</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingUnexplainedAndUnexplainable</IRI>
    <Literal xml:lang="FR">Vous supposez qu’un mystère non encore élucidé ne pourra jamais l’être, rejetant ainsi toute future explication.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingUnexplainedAndUnexplainable</IRI>
    <Literal xml:lang="EN">Considering that what is yet unexplained is impossible to ever explain.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingUnexplainedAndUnexplainable</IRI>
    <Literal xml:lang="FR">Ne cherchez pas à comprendre pourquoi c’est arrivé. Il y a des choses qui ne s’expliquent pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingUnexplainedAndUnexplainable</IRI>
    <Literal xml:lang="EN">Don't bother trying to find out why it happened. Some things are just inexplicable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingUnexplainedAndUnexplainable</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/logicalfallacies/Confusing-Currently-Unexplained-with-Unexplainable</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingUnexplainedAndUnexplainable</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingUnexplainedAndUnexplainable</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theGoldenHammer</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#diditFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#diditFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#diditFallacy</IRI>
    <Literal xml:lang="FR">L’agent providentiel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#diditFallacy</IRI>
    <Literal xml:lang="EN">Didit fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#diditFallacy</IRI>
    <Literal xml:lang="FR">Vous expliquez un phénomène inexpliqué par l’intervention d’une force ou entité puissante et cachée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#diditFallacy</IRI>
    <Literal xml:lang="EN">Invoking the intervention of some powerful invisible entity to explain the unexplainable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#diditFallacy</IRI>
    <Literal xml:lang="FR">Mais pourquoi tel candidat que j’aimais bien s’est-il discrédité à ce point ? Encore un coup de la CIA !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#diditFallacy</IRI>
    <Literal xml:lang="EN">But why did the candidate I liked discredit himself so badly? Another CIA operation!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#diditFallacy</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Didit_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingUnexplainedAndUnexplainable</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#diditFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#diditFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#confusingUnexplainedAndUnexplainable</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#godOfTheGaps</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#godOfTheGaps</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#godOfTheGaps</IRI>
    <Literal xml:lang="FR">Le dieu des lacunes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#godOfTheGaps</IRI>
    <Literal xml:lang="EN">God of the gaps</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#godOfTheGaps</IRI>
    <Literal xml:lang="FR">Vous comblez les lacunes de votre théorie en invoquant un pouvoir divin, faute de meilleure explication.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#godOfTheGaps</IRI>
    <Literal xml:lang="EN">Invoking a divine agent to fill the explanatory gaps of a theory.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#godOfTheGaps</IRI>
    <Literal xml:lang="FR">Cette guérison inattendue ne peut être que l’œuvre d’une intervention divine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#godOfTheGaps</IRI>
    <Literal xml:lang="EN">This unexpected recovery can only be the work of a divine intervention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#godOfTheGaps</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/God_of_the_gaps</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#diditFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#godOfTheGaps</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#godOfTheGaps</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#diditFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByScenario</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByScenario</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByScenario</IRI>
    <Literal xml:lang="FR">Argument par le scénario</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByScenario</IRI>
    <Literal xml:lang="EN">Argument by scenario</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByScenario</IRI>
    <Literal xml:lang="FR">Vous construisez un récit qui relie des éléments sans rapport afin de prétendre, à tort, qu’ils sont connectés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByScenario</IRI>
    <Literal xml:lang="EN">Creating a narrative that ties unrelated elements, falsely implying their connection.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByScenario</IRI>
    <Literal xml:lang="FR">Imaginez qu’en achetant ce produit, vous commenciez à mener une vie de luxe et de succès. N’est-ce pas la preuve qu’il va changer votre vie ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByScenario</IRI>
    <Literal xml:lang="EN">Imagine buying this product leads you to a life of luxury and success. Doesn't that prove it will change your life?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByScenario</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#scenario</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByScenario</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByScenario</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="FR">Rationalisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="EN">Rationalization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="FR">Vous présentez des justifications peu sincères pour rendre une affirmation acceptable, sans discuter du fond.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="EN">Providing insincere justifications to make a claim acceptable, without discussing its validity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="FR">Si je n’ai pas réussi l’examen, c’est juste parce que le professeur me déteste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="EN">If I didn't pass the exam, it's just because the teacher hates me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/149/Rationalization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="FR">Hypothèse farfelue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="EN">Far-fetched hypothesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="FR">Vous privilégiez des explications invraisemblables sans avoir écarté les hypothèses plus probables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="EN">Offering a n unlikely hypothesis as the correct explanation without first ruling out more mundane explanations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="FR">Cette erreur a fichu ma présentation en l’air. Je suis sûr que vous l’avez faite exprès pour la saboter !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="EN">This mistake ruined my presentation. I'm sure you did it on purpose to sabotage it!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/96/Far-Fetched-Hypothesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="FR">Familiarité inexpliquée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="EN">Amazing familiarity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="FR">Vous mentionnez des informations que, d’après vos propres déclarations, vous n’êtes pas censé détenir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="EN">To mention information that one, according to one's own statements, should not possess.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="FR">Comme je n’étais pas là, je suis sûr que vous en avez profité pour dire du mal de moi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="EN">I wasn't there, so I'm sure you used that opportunity to speak ill of me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#familiarity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#amazingFamiliarity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#farfetchedHypothesis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="FR">Sophisme du vrai Écossais</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="EN">No true Scotsman</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="FR">Afin de réfuter un contre-exemple, vous modifiez les contours de l’idée générale que vous soutenez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="EN">Saving a generalization from a counterexample by changing its definition in order to exclude that counterexample.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="FR">- Tous les Écossais sont roux. - Angus est écossais mais il n’est pas roux. - Ce n’est donc pas un vrai Écossais.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="EN">- All Scots are redheads.
- Angus is Scots but isn't a redhead.
- Then he isn't a true Scotsman.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/No_true_Scotsman</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sophisme_du_vrai_%C3%89cossais</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noTrueScotsman</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rationalization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
    <Literal xml:lang="FR">Effet rebond</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
    <Literal xml:lang="EN">Backfire effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
    <Literal xml:lang="FR">Face à une preuve qui contredit vos croyances, vous vous accrochez encore plus fort à celles-ci.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
    <Literal xml:lang="EN">In the face of contradictory evidence, established beliefs do not change but actually get stronger.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
    <Literal xml:lang="FR">Plus je vois tous ces médecins passer à la télévision pour expliquer pourquoi il faut porter un masque, plus je me dis que j’ai raison de ne pas en porter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
    <Literal xml:lang="EN">The more I see all these doctors on TV explaining why we need to wear masks, the more I'm convinced that not wearing one is the right choice.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Confirmation_bias#backfire_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
    <Literal xml:lang="FR">https://fr.wiktionary.org/wiki/effet_rebond</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semmelweisReflex</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semmelweisReflex</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semmelweisReflex</IRI>
    <Literal xml:lang="FR">Effet Semmelweis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semmelweisReflex</IRI>
    <Literal xml:lang="EN">Semmelweis reflex</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semmelweisReflex</IRI>
    <Literal xml:lang="FR">Vous rejetez d’emblée toute proposition qui ne respecte pas la norme, les croyances ou les paradigmes établis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semmelweisReflex</IRI>
    <Literal xml:lang="EN">Rejecting new evidence or new knowledge because it contradicts established norms, beliefs or paradigms.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semmelweisReflex</IRI>
    <Literal xml:lang="FR">Comment imaginer que les mains des médecins puissent transmettre la maladie ? Il est absurde de leur demander de se les laver.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semmelweisReflex</IRI>
    <Literal xml:lang="EN">How can we think that doctors' hands might transmit disease? It's absurd to request them to wash their hands.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semmelweisReflex</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Semmelweis_reflex</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semmelweisReflex</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semmelweisReflex</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#backfireEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pIDOOMA</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pIDOOMA</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pIDOOMA</IRI>
    <Literal xml:lang="FR">Argument sorti de nulle part</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pIDOOMA</IRI>
    <Literal xml:lang="EN">PIDOOMA</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pIDOOMA</IRI>
    <Literal xml:lang="FR">Obstiné à défendre une proposition sans fondement, vous utilisez des arguments inventés de toutes pièces, aussi absurdes soient-ils.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pIDOOMA</IRI>
    <Literal xml:lang="EN">Using any fabricated, even absurd argument, in a desperate attempt to defend an entirely baseless claim.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pIDOOMA</IRI>
    <Literal xml:lang="FR">Mais si, je vous dis que la Lune est faite de fromage. Mon ami astronaute, de retour de sa dernière mission spatiale, m’a confié qu’elle avait le goût du cheddar.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pIDOOMA</IRI>
    <Literal xml:lang="EN">But if I tell you that the moon is made of cheese. My astronaut friend back from his last space mission confessed it tasted like Cheddar.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pIDOOMA</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Argumentum_ex_culo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pIDOOMA</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pIDOOMA</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adHocRescue</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justsoStory</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justsoStory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justsoStory</IRI>
    <Literal xml:lang="FR">Histoire ad hoc</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justsoStory</IRI>
    <Literal xml:lang="EN">Just-so story</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justsoStory</IRI>
    <Literal xml:lang="FR">Vous inventez un récit spéculatif pour expliquer un phénomène, sans possibilité de vérification.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justsoStory</IRI>
    <Literal xml:lang="EN">To invent an unverifiable narrative to explain something and support one's claim.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justsoStory</IRI>
    <Literal xml:lang="FR">Les zèbres ont des rayures parce que, dans les temps anciens, cela leur permettait de se cacher des prédateurs en se camouflant parmi les hautes herbes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justsoStory</IRI>
    <Literal xml:lang="EN">Zebras have stripes because, in ancient times, this allowed them to hide from predators by blending in with the tall grasses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justsoStory</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Just-so_story</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pIDOOMA</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justsoStory</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justsoStory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pIDOOMA</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <Literal xml:lang="FR">Préjugé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <Literal xml:lang="EN">Prejudice</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <Literal xml:lang="FR">Vous fondez vos arguments sur des idées reçues, sans les examiner de façon critique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <Literal xml:lang="EN">Basing one's arguments on received ideas without examining them critically.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <Literal xml:lang="FR">Laissez donc votre père ouvrir ce pot de cornichons : c’est une affaire d’hommes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <Literal xml:lang="EN">Let your father open that jar of pickles, it's a man's job.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Prejudice</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pr%C3%A9jug%C3%A9</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <Literal xml:lang="FR">Argument d’autorité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <Literal xml:lang="EN">Argument from Authority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <Literal xml:lang="FR">Vous croyez qu’une affirmation est vraie uniquement parce qu’une autorité la soutient, sans examiner les faits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <Literal xml:lang="EN">Believing that a claim is true solely because an authority supports it, without examining the facts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <Literal xml:lang="FR">Même si j’ai trop chaud, je n’enlève pas mon manteau, car maman a dit qu’il faisait froid.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <Literal xml:lang="EN">I'm feeling hot but I'll keep my coat on because Mum said it was cold today.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argument_from_authority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argument_d%27autorité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#closeMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <Literal xml:lang="FR">Argument de pouvoir</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <Literal xml:lang="EN">Argument from power</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <Literal xml:lang="FR">Vous accordez de la valeur à un argument parce qu’il est soutenu par les autorités en place.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <Literal xml:lang="EN">Valuing an argument solely because it is supported by existing authorities.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <Literal xml:lang="FR">C’est le directeur lui-même qui a voulu ce nouveau logiciel, alors ne me dites pas que vous y avez trouvé des bogues.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <Literal xml:lang="EN">The CEO himself requested this new software, so don't tell me you've found bugs in it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argument_from_authority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argument_d%27autorité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBlindObedience</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBlindObedience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBlindObedience</IRI>
    <Literal xml:lang="FR">Argument d’obéissance aveugle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBlindObedience</IRI>
    <Literal xml:lang="EN">Argument from blind obedience</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBlindObedience</IRI>
    <Literal xml:lang="FR">Vous accordez de la valeur à un argument sous prétexte qu’il est soutenu par une autorité jugée suprême.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBlindObedience</IRI>
    <Literal xml:lang="EN">Asserting that a proposition is true solely because a supposedly absolute authority supports it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBlindObedience</IRI>
    <Literal xml:lang="FR">Le pape, parce qu’il est pape, ne peut jamais avoir tort.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBlindObedience</IRI>
    <Literal xml:lang="EN">The Pope, being the Pope, can never be wrong.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBlindObedience</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/62/Blind-Authority-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBlindObedience</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBlindObedience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAuthority</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAuthority</IRI>
    <Literal xml:lang="FR">Argument d’autorité personnelle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAuthority</IRI>
    <Literal xml:lang="EN">Argument from personal authority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAuthority</IRI>
    <Literal xml:lang="FR">Vous refusez de justifier vos propos, prétendant que votre position d’autorité suffit à les valider.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAuthority</IRI>
    <Literal xml:lang="EN">Refusing to justify one's claims, claiming that one's position of authority is enough to validate them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAuthority</IRI>
    <Literal xml:lang="FR">En tant que votre aîné, je n’ai pas à expliquer pourquoi mes décisions sont les meilleures pour la famille.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAuthority</IRI>
    <Literal xml:lang="EN">As your senior, I don't have to explain why my decisions are the best for the family.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAuthority</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/115/Just-Because-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBlindObedience</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAuthority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPersonalAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBlindObedience</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="FR">Appel à l’assurance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="EN">Appeal to confidence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="FR">La confiance que vous accordez à une proposition suffit, à vos yeux, à en garantir la validité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="EN">Treating someone's confidence in an assertion as proof of its validity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="FR">Vous pouvez me faire confiance pour ce projet. J’y crois dur comme fer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="EN">Trust me on this project. I believe in it wholeheartedly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_confidence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undisputableAuthority</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undisputableAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undisputableAuthority</IRI>
    <Literal xml:lang="FR">Autorité invincible</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undisputableAuthority</IRI>
    <Literal xml:lang="EN">Undisputable authority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undisputableAuthority</IRI>
    <Literal xml:lang="FR">Vous considérez une proposition comme indiscutable simplement parce qu’elle est soutenue par une autorité que vous jugez irréprochable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undisputableAuthority</IRI>
    <Literal xml:lang="EN">Citing an authority's opinion on an idea as if that authority's support was the only evidence necessary to uphold said idea</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undisputableAuthority</IRI>
    <Literal xml:lang="FR">Ce concept doit être vrai, car il est enseigné par le professeur X, qui est une sommité dans son domaine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undisputableAuthority</IRI>
    <Literal xml:lang="EN">This concept must be true because it is taught by Professor X, who is a leading authority in his field.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undisputableAuthority</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Invincible_authority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undisputableAuthority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#undisputableAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToLoyalty</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToLoyalty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToLoyalty</IRI>
    <Literal xml:lang="FR">Appel à la loyauté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToLoyalty</IRI>
    <Literal xml:lang="EN">Appeal to loyalty</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToLoyalty</IRI>
    <Literal xml:lang="FR">Vous accusez vos détracteurs de trahir votre confiance, ce qui, à vos yeux, vous dispense de répondre à leurs arguments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToLoyalty</IRI>
    <Literal xml:lang="EN">Accusing one's detractors of betraying one's trust, thereby avoiding having to answer their arguments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToLoyalty</IRI>
    <Literal xml:lang="FR">Est-ce que vous me faites confiance ou non ? Je n’ai pas à me justifier. Si je dis que c’est bien, c’est que ça l’est.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToLoyalty</IRI>
    <Literal xml:lang="EN">Do you trust me or not? I don't need to justify myself. If I say it's good, then it must be.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToLoyalty</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_loyalty</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToLoyalty</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToLoyalty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromPower</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
    <Literal xml:lang="FR">Appel au respect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
    <Literal xml:lang="EN">Argument from respect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
    <Literal xml:lang="FR">Vous accordez de la valeur à une proposition parce qu’elle est soutenue par une personne réputée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
    <Literal xml:lang="EN">Grounding the validity of a proposition on the basis that a reputable, respected person or entity supports it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
    <Literal xml:lang="FR">Ce gâteau doit être excellent puisqu’il s’agit d’une recette inventée par Albert Einstein.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
    <Literal xml:lang="EN">This cake must be excellent since it was invented by Albert Einstein.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argument_from_authority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argument_d%27autorit%C3%A9</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="FR">Argument d’accomplissement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="EN">Appeal to accomplishment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="FR">Vous fondez la validité des propos de quelqu’un sur ses succès dans le domaine concerné.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="EN">Granting value to someone's claims on the basis of his or her achievements in the field being debated.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="FR">Votre opinion sur la musique m’intéressera quand vous aurez sorti un album !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="EN">Your opinion on music will interest me when you've released an album!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_accomplishment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMoon</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMoon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMoon</IRI>
    <Literal xml:lang="FR">Appel à la Lune</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMoon</IRI>
    <Literal xml:lang="EN">Appeal to the Moon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMoon</IRI>
    <Literal xml:lang="FR">Vous jugez une tâche réalisable en la comparant à l’exploit d’avoir envoyé des humains sur la Lune, sans considérer les différences essentielles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMoon</IRI>
    <Literal xml:lang="EN">Judging a task to be feasible by comparing it to the feat of sending humans to the Moon, without considering essential differences.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMoon</IRI>
    <Literal xml:lang="FR">Si l’on peut envoyer des êtres humains sur la Lune, on peut bien guérir tous les types de cancers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMoon</IRI>
    <Literal xml:lang="EN">If we can put a man on the Moon, surely we can find a cure for every type of cancer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMoon</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/43/Appeal-to-the-Moon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMoon</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMoon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statementOfConversion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statementOfConversion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statementOfConversion</IRI>
    <Literal xml:lang="FR">Appel à la conversion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statementOfConversion</IRI>
    <Literal xml:lang="EN">Statement of conversion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statementOfConversion</IRI>
    <Literal xml:lang="FR">Le simple fait que vous ayez changé d’avis sur un sujet assure à vos yeux la validité de votre nouvelle opinion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statementOfConversion</IRI>
    <Literal xml:lang="EN">Using a drastic change in one's opinion as proof that his or her latest belief is truth.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statementOfConversion</IRI>
    <Literal xml:lang="FR">Depuis que j’ai changé de régime alimentaire, je me sens tellement mieux. Si vous vous sentez mal, vous devriez essayer : cela change vraiment tout.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statementOfConversion</IRI>
    <Literal xml:lang="EN">Since I changed my diet, I've felt much better. If you're feeling bad, you should try it too—it really changes everything.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statementOfConversion</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/166/Statement-of-Conversion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statementOfConversion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#statementOfConversion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCelebrity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCelebrity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCelebrity</IRI>
    <Literal xml:lang="FR">Appel à la célébrité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCelebrity</IRI>
    <Literal xml:lang="EN">Appeal to celebrity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCelebrity</IRI>
    <Literal xml:lang="FR">Vous donnez du poids à une idée car elle est promue par une célébrité, indépendamment de son fondement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCelebrity</IRI>
    <Literal xml:lang="EN">Using the celebrity of supporters of an argument to strengthen it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCelebrity</IRI>
    <Literal xml:lang="FR">Je bois toujours cette marque de soda parce que ma star préférée en fait la publicité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCelebrity</IRI>
    <Literal xml:lang="EN">I always drink this brand of soda because my favorite celebrity endorses it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCelebrity</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/apcelebs.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCelebrity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCelebrity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAccomplishment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToModesty</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToModesty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToModesty</IRI>
    <Literal xml:lang="FR">Appel à l’humilité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToModesty</IRI>
    <Literal xml:lang="EN">Appeal to modesty</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToModesty</IRI>
    <Literal xml:lang="FR">Vous considérez votre contradicteur comme ridicule ou insignifiant face à l’autorité qui soutient votre proposition, ce qui suffit à assurer, à vos yeux, la validité de celle-ci.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToModesty</IRI>
    <Literal xml:lang="EN">Deterring any contradiction of an argument by calling the former immodest in front of an autority supporting the latter.
</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToModesty</IRI>
    <Literal xml:lang="FR">Kepler disait que rejeter l’astrologie sans la connaître est une folie à trois dimensions. Ce n’est pas Monsieur Martin qui l’a dit : c’était Kepler !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToModesty</IRI>
    <Literal xml:lang="EN">Kepler said that rejecting astrology without understanding it is three-dimensional madness. Remember it's Kepler speaking, not just anybody!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToModesty</IRI>
    <Literal xml:lang="EN">https://philosophy.lander.edu/logic/authority.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToModesty</IRI>
    <Literal xml:lang="FR">http://www.charlatans.info/logique-suite.shtml#humilite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToModesty</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToModesty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromRespect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
    <Literal xml:lang="FR">Ultracrépidarianisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
    <Literal xml:lang="EN">Ultracrepidarianism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
    <Literal xml:lang="FR">Vous prétendez faire autorité sur un sujet hors de votre domaine d’expertise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
    <Literal xml:lang="EN">Claiming authority on a subject outside one's field of expertise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
    <Literal xml:lang="FR">Évidemment, en tant que blogueur mode, je peux affirmer que ce régime est le plus efficace. Nul besoin d’être nutritionniste pour reconnaître les bons choix alimentaires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
    <Literal xml:lang="EN">Obviously, as a fashion blogger, I can assert that this diet is the most effective. There's no need to be a nutritionist to recognize good food choices.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Ultracrepidarianism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromAuthority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
    <Literal xml:lang="FR">Autorité non pertinente</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
    <Literal xml:lang="EN">Appeal to False Authority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
    <Literal xml:lang="FR">Vous vous appuyez sur un expert qui n’est pas qualifié dans le domaine concerné par votre argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
    <Literal xml:lang="EN">To support a claim by citing an expert who lacks the relevant expertise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
    <Literal xml:lang="FR">Je n’utilise pas de crayons parce que John Terry, un marin de renommée mondiale, a déclaré que leur production contribue fortement au réchauffement climatique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
    <Literal xml:lang="EN">I avoid pencils because John Terry, a world-renowned sailor, claims they're major contributors to global warming.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argument_from_authority#Appeal_to_false_authority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#linkingToAuthority</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#linkingToAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#linkingToAuthority</IRI>
    <Literal xml:lang="FR">Référence à une autorité douteuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#linkingToAuthority</IRI>
    <Literal xml:lang="EN">Linking to authority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#linkingToAuthority</IRI>
    <Literal xml:lang="FR">Vous appuyez votre argument sur des sources qui ne sont pas reconnues comme faisant autorité dans le domaine concerné, en espérant que personne ne vérifie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#linkingToAuthority</IRI>
    <Literal xml:lang="EN">You support your argument with sources that are not recognized as authorities in the relevant field, hoping that no one will check.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#linkingToAuthority</IRI>
    <Literal xml:lang="FR">Il est prouvé que les ovnis visitent notre planète : de nombreux articles et témoignages disponibles en ligne l’attestent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#linkingToAuthority</IRI>
    <Literal xml:lang="EN">It is proven that UFOs visit our planet: many articles and testimonials available online attest to it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#linkingToAuthority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#linkingToAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <Literal xml:lang="FR">Faux experts</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <Literal xml:lang="EN">Fake experts</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <Literal xml:lang="FR">Vous présentez comme expert quelqu’un qui n’a aucune compétence avérée dans le sujet discuté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <Literal xml:lang="EN">Presenting an unqualified person or institution as a source of credible information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <Literal xml:lang="FR">Cette astrophysicienne, qui a gagné un concours de cuisine télévisé, présente désormais sa propre émission sur la gastronomie ; son avis sur les meilleures pratiques culinaires serait donc un gage de qualité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <Literal xml:lang="EN">This astrophysicist, who won a televised cooking contest, now hosts her own gastronomy show; her opinion on best culinary practices would therefore be a guarantee of quality.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <Literal xml:lang="EN">https://www.climatechangecommunication.org/wp-content/uploads/2020/11/Cook_2020_deconstructing_denial.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <Literal xml:lang="FR">https://vert.eco/articles/les-technique-des-climatosceptiques-pour-nier-la-realite-scientifique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFalseAuthority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#professorOfNothing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#professorOfNothing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#professorOfNothing</IRI>
    <Literal xml:lang="FR">Professeur de rien</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#professorOfNothing</IRI>
    <Literal xml:lang="EN">Professor of nothing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#professorOfNothing</IRI>
    <Literal xml:lang="FR">Vous citez comme référence une autorité dont le titre est factice.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#professorOfNothing</IRI>
    <Literal xml:lang="EN">Citing as a reference an authority whose title is fictitious.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#professorOfNothing</IRI>
    <Literal xml:lang="FR">Le professeur BAYO est un puissant marabout à Paris dont l’efficacité n’est plus à prouver.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#professorOfNothing</IRI>
    <Literal xml:lang="EN">Professor BAYO is a powerful marabout in Paris whose effectiveness is no longer to be proven.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#professorOfNothing</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Professor_of_nothing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#professorOfNothing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#professorOfNothing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulkFakeExperts</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulkFakeExperts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulkFakeExperts</IRI>
    <Literal xml:lang="FR">Faux experts en vrac</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulkFakeExperts</IRI>
    <Literal xml:lang="EN">Bulk Fake Experts</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulkFakeExperts</IRI>
    <Literal xml:lang="FR">Vous invoquez de nombreux prétendus spécialistes pour suggérer l’absence de consensus sur un sujet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulkFakeExperts</IRI>
    <Literal xml:lang="EN">Citing large numbers of seeming experts to argue that there is no scientific consensus on a topic.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulkFakeExperts</IRI>
    <Literal xml:lang="FR">31 487 Américains diplômés en sciences ont signé une pétition affirmant que les humains ne perturbaient pas le climat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulkFakeExperts</IRI>
    <Literal xml:lang="EN">31,487 Americans with a science degree signed a petition saying humans aren't disrupting climate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulkFakeExperts</IRI>
    <Literal xml:lang="EN">https://www.climatechangecommunication.org/wp-content/uploads/2020/11/Cook_2020_deconstructing_denial.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulkFakeExperts</IRI>
    <Literal xml:lang="FR">https://vert.eco/articles/les-technique-des-climatosceptiques-pour-nier-la-realite-scientifique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulkFakeExperts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bulkFakeExperts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeDebate</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeDebate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeDebate</IRI>
    <Literal xml:lang="FR">Faux débat</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeDebate</IRI>
    <Literal xml:lang="EN">Fake Debate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeDebate</IRI>
    <Literal xml:lang="FR">Vous créez un faux débat en mettant sur le même plan une position scientifique et une position pseudo-scientifique, et en prétendant qu’il existe une controverse là où il y a consensus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeDebate</IRI>
    <Literal xml:lang="EN">Creating a fake debate by placing a scientific position and a pseudoscientific position on the same level, and claiming that controversy exists where there is consensus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeDebate</IRI>
    <Literal xml:lang="FR">Certains disent que la Terre est ronde, d’autres qu’elle est plate ; la vérité doit donc se situer quelque part entre les deux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeDebate</IRI>
    <Literal xml:lang="EN">Some say the earth is round, others say it's flat; the truth must lie somewhere in between.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeDebate</IRI>
    <Literal xml:lang="EN">https://www.climatechangecommunication.org/wp-content/uploads/2020/11/Cook_2020_deconstructing_denial.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeDebate</IRI>
    <Literal xml:lang="FR">https://vert.eco/articles/les-technique-des-climatosceptiques-pour-nier-la-realite-scientifique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeDebate</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeDebate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fakeExperts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anonymousAuthority</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anonymousAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anonymousAuthority</IRI>
    <Literal xml:lang="FR">Autorité anonyme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anonymousAuthority</IRI>
    <Literal xml:lang="EN">Anonymous authority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anonymousAuthority</IRI>
    <Literal xml:lang="FR">Vous vous référez à des experts anonymes pour donner du poids à votre argument, sans permettre de vérifier leur légitimité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anonymousAuthority</IRI>
    <Literal xml:lang="EN">Using unspecified authoritative sources as evidence for a claim.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anonymousAuthority</IRI>
    <Literal xml:lang="FR">De nombreux experts disent que ce traitement est le plus efficace.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anonymousAuthority</IRI>
    <Literal xml:lang="EN">Many experts state that this is the most effective treatment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anonymousAuthority</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/18/Anonymous-Authority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anonymousAuthority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anonymousAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disguisedOpinion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disguisedOpinion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disguisedOpinion</IRI>
    <Literal xml:lang="FR">Opinion déguisée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disguisedOpinion</IRI>
    <Literal xml:lang="EN">Disguised opinion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disguisedOpinion</IRI>
    <Literal xml:lang="FR">Vous exprimez vos opinions personnelles en prétendant être totalement impartial.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disguisedOpinion</IRI>
    <Literal xml:lang="EN">Expressing personal opinions while claiming to be totally impartial.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disguisedOpinion</IRI>
    <Literal xml:lang="FR">Je ne veux pas me mêler de ce qui ne me regarde pas, et je ne suis pas compétent sur le sujet qui vous oppose, mais je crois que vous devriez écouter ce qu’essaie de vous dire votre ami.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disguisedOpinion</IRI>
    <Literal xml:lang="EN">I don't want to meddle in something that is none of my business, and I'm not knowledgeable about the issue you disagree on, but I think you should listen to what your friend is trying to tell you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disguisedOpinion</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Fox_News#Disguised_opinion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anonymousAuthority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disguisedOpinion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disguisedOpinion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anonymousAuthority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ipseDixit</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ipseDixit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ipseDixit</IRI>
    <Literal xml:lang="FR">Ipse dixit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ipseDixit</IRI>
    <Literal xml:lang="EN">Ipse Dixit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ipseDixit</IRI>
    <Literal xml:lang="FR">Vous vous citez vous-même comme expert pour justifier vos affirmations sans apporter de preuve complémentaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ipseDixit</IRI>
    <Literal xml:lang="EN">Quoting oneself as authoritative source to support one's argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ipseDixit</IRI>
    <Literal xml:lang="FR">Comme je l’ai souvent souligné lors de mes dernières conférences, ces méthodes de développement personnel sont infaillibles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ipseDixit</IRI>
    <Literal xml:lang="EN">As I've often emphasized in my recent talks, these personal development methods are flawless.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ipseDixit</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Ipse_dixit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ipseDixit</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ipseDixit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ultracrepidarianism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vicariousAutotheism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vicariousAutotheism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vicariousAutotheism</IRI>
    <Literal xml:lang="FR">Projection théologique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vicariousAutotheism</IRI>
    <Literal xml:lang="EN">Vicarious autotheism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vicariousAutotheism</IRI>
    <Literal xml:lang="FR">Vous invoquez une divinité qui partage vos opinions pour donner autorité à vos propos.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vicariousAutotheism</IRI>
    <Literal xml:lang="EN">Creating a deity similar to oneself, and using this persona as an authority to support one's arguments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vicariousAutotheism</IRI>
    <Literal xml:lang="FR">Nos idées sont pures et justes, c’est pourquoi Dieu est clairement de notre côté dans ce combat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vicariousAutotheism</IRI>
    <Literal xml:lang="EN">Certainly, our beliefs are pure and just, which is why God definitely sides with us in this struggle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vicariousAutotheism</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Vicarious_autotheism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ipseDixit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vicariousAutotheism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vicariousAutotheism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ipseDixit</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cafetariaChristianity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cafetariaChristianity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cafetariaChristianity</IRI>
    <Literal xml:lang="FR">Libre-service théologique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cafetariaChristianity</IRI>
    <Literal xml:lang="EN">Cafetaria Christianity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cafetariaChristianity</IRI>
    <Literal xml:lang="FR">Vous piochez dans vos croyances uniquement ce qui soutient votre argumentation, en ignorant le reste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cafetariaChristianity</IRI>
    <Literal xml:lang="EN">You pick from your beliefs only what supports your argument, while ignoring the rest.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cafetariaChristianity</IRI>
    <Literal xml:lang="FR">Bien sûr que je vais chanter à l’église à Noël, même si je ne suis pas pratiquante : c’est la tradition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cafetariaChristianity</IRI>
    <Literal xml:lang="EN">Of course, I attend church services during Christmas even though I'm not religious; it's tradition, after all.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cafetariaChristianity</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Cafeteria_Christian</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vicariousAutotheism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cafetariaChristianity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cafetariaChristianity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vicariousAutotheism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <Literal xml:lang="FR">Appel à la nature</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <Literal xml:lang="EN">Naturalistic Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <Literal xml:lang="FR">Vous considérez qu’une chose est meilleure simplement parce qu’elle est naturelle, sans tenir compte d’autres facteurs importants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <Literal xml:lang="EN">Believing that something is better simply because it is natural, without considering other important factors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <Literal xml:lang="FR">L’être humain a toujours mangé de la viande ; être végétarien est donc contre nature.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <Literal xml:lang="EN">Humans have always eaten meat; therefore, being vegetarian is considered against nature.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Naturalistic_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Paralogisme_naturaliste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCustom</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCustom</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCustom</IRI>
    <Literal xml:lang="FR">Appel à la coutume</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCustom</IRI>
    <Literal xml:lang="EN">Appeal to custom</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCustom</IRI>
    <Literal xml:lang="FR">Vous croyez qu’une action est juste parce qu’elle est habituelle ou commune.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCustom</IRI>
    <Literal xml:lang="EN">Assuming that because something is a practice, it ought to be the practice.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCustom</IRI>
    <Literal xml:lang="FR">Puisque, dans la tradition du village, on danse autour du feu à chaque solstice, ne pas y participer reviendrait à aller contre nos ancêtres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCustom</IRI>
    <Literal xml:lang="EN">Since it's a custom in our village to dance around the fire each solstice, it's against our ancestors not to participate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCustom</IRI>
    <Literal xml:lang="EN">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCustom</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToCustom</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <Literal xml:lang="FR">Appel à la majorité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <Literal xml:lang="EN">Appeal to the majority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <Literal xml:lang="FR">Vous justifiez une position par le fait qu’elle est partagée par le plus grand nombre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <Literal xml:lang="EN">Grounding the validity of a proposition on the fact that many or most people agree with it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <Literal xml:lang="FR">La plupart des enfants réclament tous les jours des frites à la cantine ; c’est donc ce qu’il faudrait leur servir quotidiennement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <Literal xml:lang="EN">Most kids want fries every day at the cafeteria; therefore, that's what they should be served.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argumentum_ad_populum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_populum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#3MenMakeATiger</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#3MenMakeATiger</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#3MenMakeATiger</IRI>
    <Literal xml:lang="FR">Trois hommes font un tigre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#3MenMakeATiger</IRI>
    <Literal xml:lang="EN">3 men make a tiger</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#3MenMakeATiger</IRI>
    <Literal xml:lang="FR">La validité de votre argument tient pour vous au fait qu’il a été répété par de nombreuses personnes jusqu’à devenir une croyance collective.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#3MenMakeATiger</IRI>
    <Literal xml:lang="EN">Asserting the truth of a proposition because many people repeat it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#3MenMakeATiger</IRI>
    <Literal xml:lang="FR">Vous n’avez pas entendu dire qu’il y a des crocodiles dans les égouts de la ville ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#3MenMakeATiger</IRI>
    <Literal xml:lang="EN">Haven't you heard that there are crocodiles in the city's sewers?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#3MenMakeATiger</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Three_men_make_a_tiger</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#3MenMakeATiger</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#3MenMakeATiger</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flagwaving</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flagwaving</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flagwaving</IRI>
    <Literal xml:lang="FR">Appel au drapeau</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flagwaving</IRI>
    <Literal xml:lang="EN">Flag-waving</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flagwaving</IRI>
    <Literal xml:lang="FR">Vous renforcez votre argument en invoquant des symboles patriotiques, comme si cela suffisait à démontrer sa validité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flagwaving</IRI>
    <Literal xml:lang="EN">Using nationalist symbols or patriotic appeals as a means to substantiate an argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flagwaving</IRI>
    <Literal xml:lang="FR">Les vrais patriotes sont dans cette salle pour fêter les victoires de nos athlètes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flagwaving</IRI>
    <Literal xml:lang="EN">Real patriots are in this room to celebrate our athletes' victories.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flagwaving</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Flag-waving</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flagwaving</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flagwaving</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkingTheKoolAid./PeerPressure</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkingTheKoolAid./PeerPressure</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkingTheKoolAid./PeerPressure</IRI>
    <Literal xml:lang="FR">Pression des pairs</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkingTheKoolAid./PeerPressure</IRI>
    <Literal xml:lang="EN">Drinking the Kool-Aid. / Peer pressure</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkingTheKoolAid./PeerPressure</IRI>
    <Literal xml:lang="FR">Vous exercez une pression de groupe pour amener quelqu’un à accepter une idée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkingTheKoolAid./PeerPressure</IRI>
    <Literal xml:lang="EN">Using peer-pressure to force someone to agree with an idea they know is wrong.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkingTheKoolAid./PeerPressure</IRI>
    <Literal xml:lang="FR">Chaque matin, dans l’open space, tous les collègues prennent un café ensemble ; vous devriez rejoindre ce rituel pour mieux vous intégrer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkingTheKoolAid./PeerPressure</IRI>
    <Literal xml:lang="EN">Every morning, in the open space, all colleagues drink coffee together; you should join this ritual to integrate better.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkingTheKoolAid./PeerPressure</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Drinking_the_Kool-Aid</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkingTheKoolAid./PeerPressure</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#drinkingTheKoolAid./PeerPressure</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheNumber</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheNumber</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheNumber</IRI>
    <Literal xml:lang="FR">Appel au nombre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheNumber</IRI>
    <Literal xml:lang="EN">Appeal to the number</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheNumber</IRI>
    <Literal xml:lang="FR">Vous affirmez que le nombre de personnes qui adhèrent à l’idée que vous défendez en détermine la véracité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheNumber</IRI>
    <Literal xml:lang="EN">Basing the degree of truth of a proposition on the number of people who support it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheNumber</IRI>
    <Literal xml:lang="FR">Sur les réseaux sociaux, tout le monde ne parle que de ce film, donc forcément, il doit être bon. Je vais acheter un billet pour la prochaine séance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheNumber</IRI>
    <Literal xml:lang="EN">Everyone on social media is talking about this movie, so it must be good. I'm going to buy a ticket for the next showing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheNumber</IRI>
    <Literal xml:lang="EN">https://infidels.org/library/modern/mathew/logic.html#numerum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheNumber</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheNumber</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pluralisticIgnorance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pluralisticIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pluralisticIgnorance</IRI>
    <Literal xml:lang="FR">Non-dit collectif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pluralisticIgnorance</IRI>
    <Literal xml:lang="EN">Pluralistic ignorance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pluralisticIgnorance</IRI>
    <Literal xml:lang="FR">Vous choisissez de vous conformer à une norme parce que vous croyez à tort que la majorité l’approuve.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pluralisticIgnorance</IRI>
    <Literal xml:lang="EN">Choosing to conform to a norm because one mistakenly believes that the majority approves of it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pluralisticIgnorance</IRI>
    <Literal xml:lang="FR">Personne au village n’a jamais dit du mal de la statue hideuse sur la place centrale. C’est donc qu’elle a sa place ici.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pluralisticIgnorance</IRI>
    <Literal xml:lang="EN">No one in the village has ever spoken ill of the hideous statue in the central square. So it must belong here.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pluralisticIgnorance</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pluralistic_ignorance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pluralisticIgnorance</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Ignorance_pluraliste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pluralisticIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pluralisticIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheMajority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <Literal xml:lang="FR">Appel à la tradition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <Literal xml:lang="EN">Appeal to tradition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <Literal xml:lang="FR">Vous considérez une pratique comme correcte simplement parce qu’elle est traditionnelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <Literal xml:lang="EN">Supporting an opinion or practice on the basis of it being traditional.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <Literal xml:lang="FR">La corrida a toujours existé en France ; il serait donc stupide d’interdire cette pratique dans notre pays.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <Literal xml:lang="EN">Bullfighting has always existed in France; it would therefore be foolish to ban this practice in our country.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <Literal xml:lang="EN">http://www.csun.edu/%7Edgw61315/fallacies.html#Argumentum%20ad%20antiquitatem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_antiquitatem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPrecedent</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPrecedent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPrecedent</IRI>
    <Literal xml:lang="FR">Appel au précédent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPrecedent</IRI>
    <Literal xml:lang="EN">Appeal to Precedent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPrecedent</IRI>
    <Literal xml:lang="FR">Vous affirmez qu’un événement ne peut pas se produire à l’avenir parce qu’il ne s’est jamais produit auparavant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPrecedent</IRI>
    <Literal xml:lang="EN">Arguing that because an event has never occurred before, it cannot happen in the future.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPrecedent</IRI>
    <Literal xml:lang="FR">Aucun bâtiment de ce type n’a jamais résisté à un tremblement de terre d’une telle magnitude. Il est donc impossible qu’il reste debout après un tel événement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPrecedent</IRI>
    <Literal xml:lang="EN">No building of this kind has ever withstood an earthquake of this magnitude. Therefore, it is impossible for it to remain standing after such an event.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPrecedent</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Draft:Appeal_to_precedent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPrecedent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPrecedent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="FR">Hyperlocalisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="EN">Not invented here</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="FR">Vous refusez une proposition sous prétexte qu’elle a été élaborée hors de la communauté concernée par le débat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="EN">Refusing ideas because they come from elsewhere than the group involved in the debate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="FR">Ce programme éducatif venu de l’étranger ne peut pas répondre aux besoins de notre système d’enseignement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="EN">This educational program from abroad cannot address our teaching methods' needs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Not_invented_here</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#notInventedHere</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAncientWisdom</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAncientWisdom</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAncientWisdom</IRI>
    <Literal xml:lang="FR">Appel à la sagesse immémoriale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAncientWisdom</IRI>
    <Literal xml:lang="EN">Appeal to ancient wisdom</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAncientWisdom</IRI>
    <Literal xml:lang="FR">Vous valorisez un argument simplement parce qu’il est ancien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAncientWisdom</IRI>
    <Literal xml:lang="EN">Granting value to an argument because it comes from the alledged wisdom of ancient times.
</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAncientWisdom</IRI>
    <Literal xml:lang="FR">Comme le disait Confucius, une pomme par jour éloigne le médecin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAncientWisdom</IRI>
    <Literal xml:lang="EN">As Confucius said in the third century, an apple a day keeps the doctor away.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAncientWisdom</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_ancient_wisdom</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAncientWisdom</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAncientWisdom</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTradition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <Literal xml:lang="FR">Appel à la nature</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <Literal xml:lang="EN">Appeal to nature</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <Literal xml:lang="FR">Vous supposez qu’une chose est bonne parce qu’elle est naturelle, ou mauvaise parce qu’elle n’est pas naturelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <Literal xml:lang="EN">Grounding one's argumentation on the assumption that anything natural is good, or that anything non-natural is bad.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <Literal xml:lang="FR">Il est normal que, chez les êtres humains comme chez la plupart des animaux, les mâles dominent, car ils sont plus forts et plus violents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <Literal xml:lang="EN">It's natural for men, like most animals, to dominate because they are stronger and more violent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_nature
https://utminers.utep.edu/omwilliamson/ENGL1311/fallacies.htm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Appel_à_la_nature</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naturalisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greenwashing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greenwashing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greenwashing</IRI>
    <Literal xml:lang="FR">Argument vert</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greenwashing</IRI>
    <Literal xml:lang="EN">Greenwashing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greenwashing</IRI>
    <Literal xml:lang="FR">Vous utilisez des arguments écologiques de façade pour soutenir une position de manière peu sincère.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greenwashing</IRI>
    <Literal xml:lang="EN">Dishonestly using ecological arguments to support a position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greenwashing</IRI>
    <Literal xml:lang="FR">Vous devriez acheter ce nettoyant multi-surfaces : il est fabriqué avec 95 % d’ingrédients naturels et respecte donc l’environnement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greenwashing</IRI>
    <Literal xml:lang="EN">You should buy this multi-surface cleaner; it's made with 95% natural ingredients, therefore it supports the environment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greenwashing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Greenwashing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greenwashing</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/écoblanchiment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greenwashing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greenwashing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technophobia</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technophobia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technophobia</IRI>
    <Literal xml:lang="FR">Technophobie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technophobia</IRI>
    <Literal xml:lang="EN">Technophobia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technophobia</IRI>
    <Literal xml:lang="FR">Vous rejetez systématiquement tout progrès technologique, ignorant les avantages qu’il peut apporter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technophobia</IRI>
    <Literal xml:lang="EN">You systematically reject all technological progress, ignoring the benefits it can bring.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technophobia</IRI>
    <Literal xml:lang="FR">Je n’utilise jamais de micro-ondes pour cuisiner. Les aliments deviennent toxiques à cause des ondes électromagnétiques, comme avec les téléphones portables, c’est bien connu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technophobia</IRI>
    <Literal xml:lang="EN">I never use a microwave for cooking. Food becomes toxic due to electromagnetic waves, which is well-known, just like cell phones.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technophobia</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Technophobia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technophobia</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Technophobie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technophobia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technophobia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theNobleSavage</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theNobleSavage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theNobleSavage</IRI>
    <Literal xml:lang="FR">Argument rousseauiste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theNobleSavage</IRI>
    <Literal xml:lang="EN">The Noble Savage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theNobleSavage</IRI>
    <Literal xml:lang="FR">Vous estimez, sans nuance, que l’être humain est naturellement bon et que la société le dénature.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theNobleSavage</IRI>
    <Literal xml:lang="EN">Assuming that Man is originally good and that civilisation corrupts him.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theNobleSavage</IRI>
    <Literal xml:lang="FR">Dans toutes les sociétés primitives, on vit en harmonie avec la nature. C’est pour cette raison que je refuse de vivre en appartement et que j’ai décidé de m’installer dans une cabane en forêt.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theNobleSavage</IRI>
    <Literal xml:lang="EN">In all primitive societies, people live in harmony with nature. That's why I refuse to live in an apartment and instead decided to move into a cabin in the forest.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theNobleSavage</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Noble_savage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theNobleSavage</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Bon_sauvage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theNobleSavage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theNobleSavage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNature</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <Literal xml:lang="FR">Sophisme moraliste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <Literal xml:lang="EN">Moralistic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <Literal xml:lang="FR">Vous jugez que certains faits sont vrais ou faux en fonction de vos principes moraux, et non sur la base d’une démonstration objective.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <Literal xml:lang="EN">You judge certain facts to be true or false based on your moral principles rather than on objective evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <Literal xml:lang="FR">Ce sont des enfants innocents. Ils ne pourraient pas causer autant de problèmes à leurs parents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <Literal xml:lang="EN">These are innocent children. They would not cause so much trouble for their parents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Moralistic_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFaith</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFaith</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFaith</IRI>
    <Literal xml:lang="FR">Appel à la foi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFaith</IRI>
    <Literal xml:lang="EN">Appeal to Faith</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFaith</IRI>
    <Literal xml:lang="FR">Vous demandez que votre argument soit accepté sur la base de la croyance plutôt que sur des preuves rationnelles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFaith</IRI>
    <Literal xml:lang="EN">Arguing on the basis of assumptions that require an act of faith rather than on rational evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFaith</IRI>
    <Literal xml:lang="FR">Il suffit d’avoir la foi pour comprendre que ma décision est la bonne. N’essayez pas de l’analyser avec votre logique froide.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFaith</IRI>
    <Literal xml:lang="EN">Just have faith and you'll see that my choice is correct. Don't try to analyze it with your cold logic.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFaith</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/31/Appeal-to-Faith</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFaith</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFaith</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofFromTheFuture</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofFromTheFuture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofFromTheFuture</IRI>
    <Literal xml:lang="FR">Argument du futur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofFromTheFuture</IRI>
    <Literal xml:lang="EN">Proof from the future</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofFromTheFuture</IRI>
    <Literal xml:lang="FR">Vous affirmez que l’avenir se chargera d’apporter les preuves qui manquent à votre démonstration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofFromTheFuture</IRI>
    <Literal xml:lang="EN">Arguing that evidence will someday be discovered which will then support the point.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofFromTheFuture</IRI>
    <Literal xml:lang="FR">On ne peut pas rejeter cette théorie maintenant, car les preuves pourraient être découvertes dans le futur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofFromTheFuture</IRI>
    <Literal xml:lang="EN">We can't dismiss this theory right now, as the evidence might be found in the future.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofFromTheFuture</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#future</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFaith</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofFromTheFuture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofFromTheFuture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFaith</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="FR">Appel à la nouveauté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="EN">Appeal to novelty</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="FR">Vous estimez que le caractère inédit ou prétendument moderne d’un argument suffit à en garantir la validité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="EN">Arguing that an idea or proposition is good, valid, or true solely because it is newer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="FR">Cette technologie vient de sortir : elle doit être la meilleure option. Pourquoi s’embarrasser avec d’anciens modèles ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="EN">This technology is the latest, it must be the best option. Why bother with older models?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_novelty</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_novitatem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronologicalSnobbery</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronologicalSnobbery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronologicalSnobbery</IRI>
    <Literal xml:lang="FR">Supériorité progressiste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronologicalSnobbery</IRI>
    <Literal xml:lang="EN">Chronological snobbery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronologicalSnobbery</IRI>
    <Literal xml:lang="FR">Vous croyez qu’une idée est meilleure simplement parce qu’elle est plus récente.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronologicalSnobbery</IRI>
    <Literal xml:lang="EN">Believing an idea is superior merely because it is newer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronologicalSnobbery</IRI>
    <Literal xml:lang="FR">Le parti a introduit des réformes inédites cette année, preuve indéniable que sa proposition est la plus judicieuse pour l’avenir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronologicalSnobbery</IRI>
    <Literal xml:lang="EN">The party introduced unprecedented reforms this year, undeniable proof that its proposal is the wisest for the future.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronologicalSnobbery</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Chronological_snobbery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronologicalSnobbery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronologicalSnobbery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToNovelty</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
    <Literal xml:lang="FR">Supériorité morale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
    <Literal xml:lang="EN">Moral high ground fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
    <Literal xml:lang="FR">Vous présentez vos arguments comme nécessairement valides parce qu’ils vous paraissent moralement supérieurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
    <Literal xml:lang="EN">Presenting one's arguments as necessarily valid because they seem morally superior.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
    <Literal xml:lang="FR">Cet homme n’a pas pu commettre cette faute. Sa moralité et son comportement public parlent pour lui.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
    <Literal xml:lang="EN">This man couldn't have made such a mistake. His morality and public behavior speak for themselves.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Moral_high_ground#Everyday_use</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
    <Literal xml:lang="FR">Snobisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
    <Literal xml:lang="EN">Snobbery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
    <Literal xml:lang="FR">Vous évaluez un discours en fonction de la classe sociale dont est issu son auteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
    <Literal xml:lang="EN">Evaluating a discourse according to the social class from which its author comes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
    <Literal xml:lang="FR">Il n’a pas l’air d’un expert, il vient d’un quartier populaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
    <Literal xml:lang="EN">He doesn't seem like an expert; he comes from a working-class neighborhood.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Snob</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Snob</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elitism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elitism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elitism</IRI>
    <Literal xml:lang="FR">Élitisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elitism</IRI>
    <Literal xml:lang="EN">Elitism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elitism</IRI>
    <Literal xml:lang="FR">Vous accordez plus d’importance aux arguments des personnes issues d’un milieu intellectuel que vous jugez supérieur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elitism</IRI>
    <Literal xml:lang="EN">Granting more weight to arguments from individuals considered intellectual elites, over others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elitism</IRI>
    <Literal xml:lang="FR">Son argumentation est plus crédible car il est issu de l’université la plus prestigieuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elitism</IRI>
    <Literal xml:lang="EN">His argumentation is more credible because he comes from the most prestigious university.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elitism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Elitism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elitism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Elitisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elitism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#elitism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="FR">Appel à la minorité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="EN">Appeal to minority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="FR">Vous prétendez qu’une opinion minoritaire est juste, sous prétexte qu’elle est peu répandue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="EN">Claiming that an assertion is true because it goes against the opinion of the majority.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="FR">Pourquoi lire ces chaînes d’e-mails ennuyeuses que tout le monde lit ? Vous savez que vous valez mieux que cela.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="EN">Why read those boring email chains that everyone reads? You know you're above that.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_the_minority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="FR">http://www.fallacydetective.com/news/read/snob-appeal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#snobbery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="FR">Politiquement correct</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="EN">Political correctness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="FR">Vous rejetez ou détournez un argument au motif qu’il risque de heurter la sensibilité d’une partie de l’auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="EN">Rejecting or diverting arguments for fear they may cause social or institutional offense.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="FR">Ne cherchez pas d’explication du côté des croyances ; la religion relève de la conscience et ne doit donc jamais être critiquée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="EN">Do not look for explanations in terms of beliefs; religion is a matter of conscience and therefore should never be criticized.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/141/Political-Correctness-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Politiquement_correct</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralHighGroundFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blasphemy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blasphemy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blasphemy</IRI>
    <Literal xml:lang="FR">Blasphème</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blasphemy</IRI>
    <Literal xml:lang="EN">Blasphemy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blasphemy</IRI>
    <Literal xml:lang="FR">Vous rejetez un argument en le considérant irrespectueux de vos croyances religieuses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blasphemy</IRI>
    <Literal xml:lang="EN">Rejecting arguments on grounds of them being blasphemous</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blasphemy</IRI>
    <Literal xml:lang="FR">Cet auteur ne devrait pas être publié, ses écrits blasphématoires pourraient offenser notre communauté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blasphemy</IRI>
    <Literal xml:lang="EN">This author should not be published, his blasphemous writings could offend our community.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blasphemy</IRI>
    <Literal xml:lang="EN">http://skepdic.com/blasphemy.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blasphemy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blasphemy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breachOfEtiquette</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breachOfEtiquette</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breachOfEtiquette</IRI>
    <Literal xml:lang="FR">Manquement à l’étiquette</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breachOfEtiquette</IRI>
    <Literal xml:lang="EN">Breach of etiquette</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breachOfEtiquette</IRI>
    <Literal xml:lang="FR">Vous disqualifiez d’emblée tout argument dont vous considérez qu’il ne respecte pas les usages de la société dont vous êtes issu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breachOfEtiquette</IRI>
    <Literal xml:lang="EN">Rejecting arguments on grounds of them being expressed in a manner which does not conform to rules of etiquette.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breachOfEtiquette</IRI>
    <Literal xml:lang="FR">Je ne prête pas attention à ce qu’il dit, car il ne m’a même pas serré la main en me saluant. C’est un signe évident de manque de sérieux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breachOfEtiquette</IRI>
    <Literal xml:lang="EN">I don't pay attention to his words as he didn't even shake my hand when greeting me. It's a clear sign of disrespect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breachOfEtiquette</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Etiquette</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breachOfEtiquette</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/%C3%89tiquette_(code)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breachOfEtiquette</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breachOfEtiquette</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#politicalCorrectness</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromForm</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromForm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromForm</IRI>
    <Literal xml:lang="FR">Forme sans fond</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromForm</IRI>
    <Literal xml:lang="EN">Argument from form</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromForm</IRI>
    <Literal xml:lang="FR">Vous considérez qu’un argument est valide simplement parce qu’il est bien formulé ou présenté avec élégance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromForm</IRI>
    <Literal xml:lang="EN">Judging arguments on their style rather than their substance, considering that good style is sign of soundness.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromForm</IRI>
    <Literal xml:lang="FR">Regardez comme cette idée est brillamment présentée, avec quelle élégance elle est formulée ! Elle ne peut qu’être vraie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromForm</IRI>
    <Literal xml:lang="EN">Look how brilliantly this idea is presented, with such elegance and flair! It must be the truth.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromForm</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/170/Style-Over-Substance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromForm</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromForm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromDesign</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromDesign</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromDesign</IRI>
    <Literal xml:lang="FR">Argument téléologique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromDesign</IRI>
    <Literal xml:lang="EN">Argument from design</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromDesign</IRI>
    <Literal xml:lang="FR">Vous pensez que la complexité et la perfection de certains aspects du monde prouvent l’existence d’une entité créatrice.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromDesign</IRI>
    <Literal xml:lang="EN">Judging that something is so perfect that it must have been designed by a superior, dvine entity, thus proving the xistence of the latter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromDesign</IRI>
    <Literal xml:lang="FR">La complexité de l’œil humain ne peut s’expliquer que par l’intervention d’un créateur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromDesign</IRI>
    <Literal xml:lang="EN">Looking at the complexity of the human eye, it's clear that it must have been designed by some divine being. Nature alone couldn't achieve this level of complexity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromDesign</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Argument_from_design</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromForm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromDesign</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromDesign</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromForm</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBeauty</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBeauty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBeauty</IRI>
    <Literal xml:lang="FR">Appel à la beauté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBeauty</IRI>
    <Literal xml:lang="EN">Argument from beauty</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBeauty</IRI>
    <Literal xml:lang="FR">Vous considérez que l’existence d’êtres ou d’objets dont l’esthétique vous paraît parfaite suffit à prouver l’existence d’une entité divine créatrice.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBeauty</IRI>
    <Literal xml:lang="EN">Judging that something is so beautiful that it must have been designed by a superior, dvine entity, thus proving the existence of the latter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBeauty</IRI>
    <Literal xml:lang="FR">Regardez cette magnifique fleur, si délicate et parfaitement formée. Seule une divinité pouvait créer une telle beauté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBeauty</IRI>
    <Literal xml:lang="EN">See how exquisite this flower is, its delicate form and perfect symmetry. Only a divine hand could craft such beauty.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBeauty</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Argument_from_beauty</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromDesign</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBeauty</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromBeauty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromDesign</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
    <Literal xml:lang="FR">Appel à l’argent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
    <Literal xml:lang="EN">Appeal to money</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
    <Literal xml:lang="FR">Vous jugez la validité d’une idée en fonction de la richesse de la personne qui la propose.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
    <Literal xml:lang="EN">You judge the validity of an idea based on the wealth of the person proposing it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
    <Literal xml:lang="FR">Vous devriez absolument écouter le conseil de Marc : après tout, il est millionnaire ! Si quelqu’un sait ce qui est bon pour nous, c’est bien lui.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
    <Literal xml:lang="EN">You should definitely listen to Mark—he's a millionaire! Surely, if anyone knows what's best, it would be him.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Appeal_to_money</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWealth</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWealth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWealth</IRI>
    <Literal xml:lang="FR">Raison du plus riche</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWealth</IRI>
    <Literal xml:lang="EN">Appeal to wealth</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWealth</IRI>
    <Literal xml:lang="FR">Vous pensez qu’une idée est valide seulement parce que celui qui la présente est riche.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWealth</IRI>
    <Literal xml:lang="EN">Concluding that a statement is correct because the speaker is rich</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWealth</IRI>
    <Literal xml:lang="FR">S’il avait tort, il ne serait pas arrivé là où il en est aujourd’hui.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWealth</IRI>
    <Literal xml:lang="EN">If he were wrong, he wouldn't have reached where he is today.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWealth</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argumentum_ad_crumenam</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWealth</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_crumenam</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWealth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWealth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPoverty</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPoverty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPoverty</IRI>
    <Literal xml:lang="FR">Raison du plus pauvre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPoverty</IRI>
    <Literal xml:lang="EN">Appeal to poverty</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPoverty</IRI>
    <Literal xml:lang="FR">Vous croyez qu’une idée est juste parce que la personne qui la défend est pauvre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPoverty</IRI>
    <Literal xml:lang="EN">You believe an idea is right because the person defending it is poor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPoverty</IRI>
    <Literal xml:lang="FR">Il est issu d’une famille modeste et a travaillé dur pour gagner son argent ; ses opinions sur l’économie de notre pays méritent donc plus de respect que celles des grandes fortunes héritées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPoverty</IRI>
    <Literal xml:lang="EN">He comes from a modest background and worked hard for his money, so his views on our country's economy should be respected more than those of inherited wealth.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPoverty</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argumentum_ad_lazarum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPoverty</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_lazarum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPoverty</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPoverty</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoney</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheLaw</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheLaw</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheLaw</IRI>
    <Literal xml:lang="FR">Appel à la loi</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheLaw</IRI>
    <Literal xml:lang="EN">Appeal to the law</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheLaw</IRI>
    <Literal xml:lang="FR">Vous jugez une action uniquement selon qu’elle est légale ou non.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheLaw</IRI>
    <Literal xml:lang="EN">Judging an action solely on the basis of its legality.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheLaw</IRI>
    <Literal xml:lang="FR">J’ai trompé ma femme, et alors ? Ce n’est pas comme si être infidèle était un crime !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheLaw</IRI>
    <Literal xml:lang="EN">So what if I cheated on my wife? It's not like being unfaithful is a crime!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheLaw</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_the_law</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheLaw</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheLaw</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rightstooughtFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rightstooughtFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rightstooughtFallacy</IRI>
    <Literal xml:lang="FR">Appel au droit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rightstooughtFallacy</IRI>
    <Literal xml:lang="EN">Rights-to-ought fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rightstooughtFallacy</IRI>
    <Literal xml:lang="FR">Vous confondez ce qui est légal avec ce qui est souhaitable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rightstooughtFallacy</IRI>
    <Literal xml:lang="EN">Confusing what is legal with what is desirable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rightstooughtFallacy</IRI>
    <Literal xml:lang="FR">J’exerce mon droit constitutionnel en venant protester armé devant chez vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rightstooughtFallacy</IRI>
    <Literal xml:lang="EN">I'm exercising my constitutional right by coming to protest armed in front of your house.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rightstooughtFallacy</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/157/Rights-To-Ought-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheLaw</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rightstooughtFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rightstooughtFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheLaw</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="FR">Capacitisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="EN">Ableism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="FR">Vous utilisez le handicap pour discriminer ou marginaliser une personne, comme si cela constituait un argument valable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="EN">Discriminating or marginalizing on the basis of disability, considering it a valid argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="FR">Je préfère ne pas lui confier de responsabilités importantes ; avec son handicap, il ne pourrait pas suivre le rythme comme nous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="EN">I'd rather not give him major responsibilities; with his disability, he couldn't keep up with us.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="EN">http://utminers.utep.edu/omwilliamson/ENGL1311/fallacies.htm#2</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Capacitisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralisticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <Literal xml:lang="FR">Surinterprétation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <Literal xml:lang="EN">Overinterpretation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <Literal xml:lang="FR">Vous tirez des conclusions exagérées des éléments dont vous disposez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <Literal xml:lang="EN">Drawing conclusions which exceed what available evidence permits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <Literal xml:lang="FR">Il ment, puisqu’il rougit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <Literal xml:lang="EN">He's lying because he blushes!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/overinterpretation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <Literal xml:lang="FR">https://fr.wiktionary.org/wiki/surinterpr%C3%A9tation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#insufficiency</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <Literal xml:lang="FR">Sophisme du jeu</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <Literal xml:lang="EN">Ludic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <Literal xml:lang="FR">Vous abordez des questions complexes comme s’il s’agissait de simples jeux ou de problèmes faciles à résoudre, souvent à l’aide de modèles simplistes qui négligent leur complexité réelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <Literal xml:lang="EN">Approaching complex questions as if they were simple games or easily solvable problems, often using simplistic models or neglecting the real complexity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <Literal xml:lang="FR">Gérer une entreprise n’est pas si différent d’un jeu vidéo de stratégie : il suffit de choisir les bonnes options et la croissance suivra d’elle-même.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <Literal xml:lang="EN">Running a business isn't that different from playing a strategy video game. Just choose the right options and watch the growth happen.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ludic_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <Literal xml:lang="FR">Simplification abusive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <Literal xml:lang="EN">Réductive fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <Literal xml:lang="FR">Vous ignorez la complexité d’une situation en proposant une explication trop simplifiée, qui omet des éléments essentiels.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <Literal xml:lang="EN">Ignoring the complexity of a situation by offering an overly simplified explanation that leaves out essential elements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <Literal xml:lang="FR">Payer des impôts pour aider les autres ? C’est juste du vol à l’échelle d’un pays.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <Literal xml:lang="EN">Paying taxes to help others? That's just theft on a national scale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#reductive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfTheCrucialExperiment</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfTheCrucialExperiment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfTheCrucialExperiment</IRI>
    <Literal xml:lang="FR">Sophisme de l’expérience déterminante</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfTheCrucialExperiment</IRI>
    <Literal xml:lang="EN">Fallacy of the crucial experiment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfTheCrucialExperiment</IRI>
    <Literal xml:lang="FR">Vous pensez qu’une expérience unique peut apporter une preuve absolue à une théorie complexe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfTheCrucialExperiment</IRI>
    <Literal xml:lang="EN">Believing that a single experiment can provide absolute proof of a complex theory.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfTheCrucialExperiment</IRI>
    <Literal xml:lang="FR">Depuis que notre entreprise a lancé ce produit, nous avons fait des profits ; notre stratégie commerciale est donc parfaite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfTheCrucialExperiment</IRI>
    <Literal xml:lang="EN">Since our company launched this product, we've been profitable, so our business strategy must be flawless.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfTheCrucialExperiment</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#crucial_experiment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfTheCrucialExperiment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyOfTheCrucialExperiment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantitativeFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantitativeFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantitativeFallacy</IRI>
    <Literal xml:lang="FR">Sophisme quantitatif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantitativeFallacy</IRI>
    <Literal xml:lang="EN">Quantitative fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantitativeFallacy</IRI>
    <Literal xml:lang="FR">Vous accordez trop d’importance aux nombres et aux mesures, en laissant de côté des éléments importants qui ne sont pas quantifiables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantitativeFallacy</IRI>
    <Literal xml:lang="EN">Placing undue importance on numbers and metrics, dismissing critical elements that are not quantifiable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantitativeFallacy</IRI>
    <Literal xml:lang="FR">Cet hôtel a plus d’étoiles que les autres. Il doit forcément être le plus agréable de la ville.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantitativeFallacy</IRI>
    <Literal xml:lang="EN">This hotel has more stars than the others. It must necessarily be the most pleasant in the city.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantitativeFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/McNamara_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantitativeFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#quantitativeFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="FR">Effet du lampadaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="EN">Streetlight effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="FR">Vous cherchez vos réponses là où il est facile de regarder, en ignorant des pistes plus importantes mais moins accessibles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="EN">Focusing on the most accessible or obvious areas to seek answers or solutions, potentially ignoring more significant but less obvious or more challenging to examine aspects.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="FR">Nous avons analysé les données de vente des trois derniers mois, car elles étaient facilement disponibles, même si elles ne reflètent pas les tendances à long terme, qui pourraient être plus pertinentes pour notre stratégie de marché.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="EN">We analyzed the sales data from the last three months because it was readily available, even though it may not reflect the long-term trends that could be more relevant to our market strategy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Streetlight_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#streetlightEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naiveIdealism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naiveIdealism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naiveIdealism</IRI>
    <Literal xml:lang="FR">Angélisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naiveIdealism</IRI>
    <Literal xml:lang="EN">Naive idealism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naiveIdealism</IRI>
    <Literal xml:lang="FR">Vous évaluez des scénarios réels avec une perspective idéalisée, ignorant les défauts et les motivations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naiveIdealism</IRI>
    <Literal xml:lang="EN">Evaluating real scenarios from an idealized perspective, ignoring flaws and motivations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naiveIdealism</IRI>
    <Literal xml:lang="FR">Pour résoudre le chômage, pas de mystère : il faut travailler plus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naiveIdealism</IRI>
    <Literal xml:lang="EN">To solve unemployment, there is no mystery: people need to work more.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naiveIdealism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Angelism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naiveIdealism</IRI>
    <Literal xml:lang="FR">https://fr.wiktionary.org/wiki/ang%C3%A9lisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naiveIdealism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naiveIdealism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intuitionPump</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intuitionPump</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intuitionPump</IRI>
    <Literal xml:lang="FR">Pompe à intuitions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intuitionPump</IRI>
    <Literal xml:lang="EN">Intuition pump</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intuitionPump</IRI>
    <Literal xml:lang="FR">Pour aider votre auditoire à appréhender un concept, vous faites appel à son sentiment immédiat et à ses impressions plutôt qu’à sa raison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intuitionPump</IRI>
    <Literal xml:lang="EN">Appealing to the immediate feelings, impressions rather than reason to make a concept easier to grasp for the audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intuitionPump</IRI>
    <Literal xml:lang="FR">Sentez cette crème pour la peau : c’est un pur moment de bonheur. Elle doit forcément fonctionner !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intuitionPump</IRI>
    <Literal xml:lang="EN">Feel this skin cream, it's pure happiness. It has to work!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intuitionPump</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Intuition_pump</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intuitionPump</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intuitionPump</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#réductiveFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="FR">Biais rétrospectif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="EN">Hindsight bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="FR">Après un événement, vous pensez que vous aviez prévu ou anticipé son résultat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="EN">Thinking, after an event, that its outcome had been foreseen or anticipated.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="FR">Je savais dès le début que ce projet était voué à l’échec. Il n’y avait aucun doute à ce sujet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="EN">I knew from the start that this project was doomed. There was never any doubt about it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hindsight_bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Biais_r%C3%A9trospectif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historiansFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historiansFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historiansFallacy</IRI>
    <Literal xml:lang="FR">Sophisme de l’historien</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historiansFallacy</IRI>
    <Literal xml:lang="EN">Historian's fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historiansFallacy</IRI>
    <Literal xml:lang="FR">Vous critiquez une décision prise dans le passé à la lumière de faits postérieurs, en semblant considérer que son auteur disposait à l’époque des mêmes informations que vous aujourd’hui.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historiansFallacy</IRI>
    <Literal xml:lang="EN">Criticizing a past decision in the light of subsequent facts, as if its author had the same information at the time as is available today.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historiansFallacy</IRI>
    <Literal xml:lang="FR">Les dirigeants de 1920 vivaient les années folles. Ils auraient dû voir venir la crise de 1929.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historiansFallacy</IRI>
    <Literal xml:lang="EN">The leaders of the 1920s were enjoying the Roaring Twenties. They should have foreseen the crash of 1929.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historiansFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Historian%27s_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historiansFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#historiansFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrospectiveDeterminism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrospectiveDeterminism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrospectiveDeterminism</IRI>
    <Literal xml:lang="FR">Déterminisme rétrospectif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrospectiveDeterminism</IRI>
    <Literal xml:lang="EN">Retrospective determinism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrospectiveDeterminism</IRI>
    <Literal xml:lang="FR">Vous considérez après coup que les circonstances dans lesquelles un événement s’est déroulé en étaient nécessairement la cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrospectiveDeterminism</IRI>
    <Literal xml:lang="EN">Inferring that because something happened under some circumstances, it was therefore bound to happen due to those circumstance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrospectiveDeterminism</IRI>
    <Literal xml:lang="FR">À partir du moment où Jules César s’est déclaré dictateur à vie, il était destiné à être assassiné.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrospectiveDeterminism</IRI>
    <Literal xml:lang="EN">From the moment Julius Caesar declared himself emperor, his assassination was inevitable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrospectiveDeterminism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Retrospective_determinism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrospectiveDeterminism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retrospectiveDeterminism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retroactiveClairvoyance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retroactiveClairvoyance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retroactiveClairvoyance</IRI>
    <Literal xml:lang="FR">Clairvoyance rétroactive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retroactiveClairvoyance</IRI>
    <Literal xml:lang="EN">Retroactive clairvoyance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retroactiveClairvoyance</IRI>
    <Literal xml:lang="FR">Vous considérez après coup qu’un événement avait bel et bien été prédit, mais que la prophétie n’avait pas été comprise à l’époque.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retroactiveClairvoyance</IRI>
    <Literal xml:lang="EN">Claiming that an event was predicted a posteriori, though the prediction at the time was obscure and not understood.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retroactiveClairvoyance</IRI>
    <Literal xml:lang="FR">Après l’accident, il est évident que les signes précurseurs étaient là. Si seulement nous avions su interpréter correctement ces signes...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retroactiveClairvoyance</IRI>
    <Literal xml:lang="EN">After the accident, it was clear that the warning signs were there. If only we had known how to interpret them correctly...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retroactiveClairvoyance</IRI>
    <Literal xml:lang="EN">http://skepdic.com/retroactiveclairvoyance.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retroactiveClairvoyance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#retroactiveClairvoyance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hindsightBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
    <Literal xml:lang="FR">Biais temporels et spatiaux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
    <Literal xml:lang="EN">Temporal and Spatial Biases</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
    <Literal xml:lang="FR">Vous projetez à tort des concepts modernes sur des époques passées, ou les idées d’une culture sur un autre contexte culturel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
    <Literal xml:lang="EN">Analyzing or interpreting events or situations using inappropriate temporal or spatial perspectives, applying modern concepts to historical periods, or erroneously transferring ideas from one culture or geographical context to another.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
    <Literal xml:lang="FR">Les citoyens de la Rome antique devaient certainement aspirer aux mêmes valeurs démocratiques que nous aujourd’hui.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
    <Literal xml:lang="EN">The citizens of ancient Rome must have surely aspired to the same democratic values we hold today.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
    <Literal xml:lang="FR">Anachronisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
    <Literal xml:lang="EN">Anachronism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
    <Literal xml:lang="FR">Dans votre analyse d’un fait passé, vous supposez ou jugez que des idées ou des concepts existaient déjà à l’époque, alors qu’ils n’existaient pas encore.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
    <Literal xml:lang="EN">Judging people for their application of concepts or perspectives during periods of time when they were not in use.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
    <Literal xml:lang="FR">Les Romains avaient compris la nécessité d’utiliser des matériaux et des énergies renouvelables pour préserver leur environnement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
    <Literal xml:lang="EN">The Romans understood the need to use materials and energy sustainably to preserve their environment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Anachronism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Anachronisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#presentism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#presentism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#presentism</IRI>
    <Literal xml:lang="FR">Présentisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#presentism</IRI>
    <Literal xml:lang="EN">Presentism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#presentism</IRI>
    <Literal xml:lang="FR">Vous analysez des faits du passé à l’aune d’idées et de concepts actuels qui étaient inenvisageables à l’époque concernée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#presentism</IRI>
    <Literal xml:lang="EN">Analyzing past events with modern-day ideas and perspectives, which were unthinkable at that time.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#presentism</IRI>
    <Literal xml:lang="FR">Il est inconcevable que Jeanne d’Arc n’ait pas lutté pour les droits des femmes, elle qui était si avancée pour son temps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#presentism</IRI>
    <Literal xml:lang="EN">It's unthinkable that Joan of Arc didn't advocate for women's rights, considering she was so progressive for her time.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#presentism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Presentism_(literary_and_historical_analysis)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#presentism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#presentism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anachronism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFlintstonesFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFlintstonesFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFlintstonesFallacy</IRI>
    <Literal xml:lang="FR">Sophisme Pierre-à-feu</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFlintstonesFallacy</IRI>
    <Literal xml:lang="EN">The Flintstones Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFlintstonesFallacy</IRI>
    <Literal xml:lang="FR">Vous projetez sur une époque ou une situation une vision anachronique ou inadaptée issue de votre propre expérience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFlintstonesFallacy</IRI>
    <Literal xml:lang="EN">Projecting anachronistic or inappropriate visions based on one's own experience onto a period or situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFlintstonesFallacy</IRI>
    <Literal xml:lang="FR">L’homme préhistorique aimait discuter de politique au coin du feu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFlintstonesFallacy</IRI>
    <Literal xml:lang="EN">Prehistoric humans enjoyed discussing politics at the fireside.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFlintstonesFallacy</IRI>
    <Literal xml:lang="EN">http://www.academia.edu/2760517/The_Flintstones_Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#presentism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFlintstonesFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theFlintstonesFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#presentism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anatopism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anatopism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anatopism</IRI>
    <Literal xml:lang="FR">Anatopisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anatopism</IRI>
    <Literal xml:lang="EN">Anatopism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anatopism</IRI>
    <Literal xml:lang="FR">Dans votre analyse d’un fait localisé, vous jugez de l’emploi d’idées et de concepts inconnus dans la zone concernée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anatopism</IRI>
    <Literal xml:lang="EN">In analyzing a localized fact, judging the use of ideas and concepts unknown in the area concerned.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anatopism</IRI>
    <Literal xml:lang="FR">Les problèmes sociaux de cette communauté rurale isolée sont certainement dus à son manque d’accès à Internet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anatopism</IRI>
    <Literal xml:lang="EN">The social problems of this isolated rural community are certainly due to its lack of Internet access.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anatopism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Anatopism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anatopism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anatopism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
    <Literal xml:lang="FR">Archaïsme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
    <Literal xml:lang="EN">Archaism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
    <Literal xml:lang="FR">Votre argument, censé s’appliquer à une situation présente, repose sur un terme dont le sens a changé ou sur un concept du passé inapplicable à l’époque actuelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
    <Literal xml:lang="EN">Relying on terms or concepts from the past that are no longer valid or applicable in the present context.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
    <Literal xml:lang="FR">Regardez nos valeureux ancêtres et leur solide morale. Pourtant, aujourd’hui, les gens sont corrompus et décadents.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
    <Literal xml:lang="EN">Look at our valiant ancestors and their solid morals. Yet, today, people are corrupted and decadent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Archaism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Archa%C3%AFsme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#temporalAndSpatialBiases</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#etymologicalFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#etymologicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#etymologicalFallacy</IRI>
    <Literal xml:lang="FR">Sophisme étymologique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#etymologicalFallacy</IRI>
    <Literal xml:lang="EN">Etymological fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#etymologicalFallacy</IRI>
    <Literal xml:lang="FR">Votre argumentation repose sur l’origine ou l’ancienne définition d’un terme et non sur ce qu’il signifie aujourd’hui.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#etymologicalFallacy</IRI>
    <Literal xml:lang="EN">Making a claim about the present meaning of a word on the exclusive basis of its etymology.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#etymologicalFallacy</IRI>
    <Literal xml:lang="FR">Je suis un ’athlète’, au sens étymologique du terme, je ’souffre’ au travail, ça n’a rien à voir avec le sport.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#etymologicalFallacy</IRI>
    <Literal xml:lang="EN">I'm an 'athlete' in the etymological sense of the word; I 'suffer' at work, it has nothing to do with sports.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#etymologicalFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Etymological_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#etymologicalFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#etymologicalFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#archaism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveImplication</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveImplication</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveImplication</IRI>
    <Literal xml:lang="FR">Tromperie implicite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveImplication</IRI>
    <Literal xml:lang="EN">Deceptive implication</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveImplication</IRI>
    <Literal xml:lang="FR">Même si votre affirmation est correcte, vous la formulez d’une manière qui induit en erreur sur une question liée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveImplication</IRI>
    <Literal xml:lang="EN">Asserting a statement which may be clear and even true but which implies that something else is true or false when it isn't.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveImplication</IRI>
    <Literal xml:lang="FR">Notre régime révolutionnaire vous fera perdre cinq kilos en une semaine, à condition de suivre aussi notre programme minceur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveImplication</IRI>
    <Literal xml:lang="EN">Our revolutionary diet promises you'll lose five pounds in a week, coupled with our slimming plan.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveImplication</IRI>
    <Literal xml:lang="EN">http://skepdic.com/falseimplication.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveImplication</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deceptiveImplication</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ludicFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <Literal xml:lang="FR">Argument des mauvaises raisons</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <Literal xml:lang="EN">Bad reasons fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <Literal xml:lang="FR">Vous rejetez une position en supposant que le raisonnement ou les intentions de son auteur sont douteux, plutôt qu’en examinant l’argument lui-même.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <Literal xml:lang="EN">You reject a position by assuming that its author's reasoning or intentions are questionable, rather than examining the argument itself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <Literal xml:lang="FR">Cet homme a tout intérêt à me vendre sa voiture. Sa description du véhicule manque nécessairement d’objectivité : mieux vaut ne pas l’acheter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <Literal xml:lang="EN">This man has every interest in selling me his car. His description of the vehicle is necessarily lacking in objectivity, so it would be better not to buy it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <Literal xml:lang="EN">http://www.fallacyfiles.org/badreasn.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Commitment_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
    <Literal xml:lang="FR">Sophisme du sophisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
    <Literal xml:lang="EN">Fallacist's Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
    <Literal xml:lang="FR">Vous rejetez une conclusion uniquement parce que l’argument qui la soutient est fallacieux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
    <Literal xml:lang="EN">Arguing that a conclusion is false because its proof involves a fallacy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
    <Literal xml:lang="FR">Il m’a dit d’emprunter la route qui descend sur la droite ; or cette route monte. Prenons plutôt à gauche.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
    <Literal xml:lang="EN">He told me to take the road that goes down on the right; but that road goes uphill. Let's take the left instead.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argument_from_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
    <Literal xml:lang="FR">https://nicomaque.com/la-philosophie/logique/les-sophismes/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="FR">Analyse défaillante</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="EN">Substituting Explanation for Premise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="FR">Vous considérez qu’un phénomène n’existe pas simplement parce que l’explication théorique proposée est incorrecte ou insuffisante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="EN">Concluding that a phenomenon does not exist merely because the theoretical explanation offered is incorrect or inadequate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="FR">Ils affirment que le changement climatique est causé par les activités humaines, mais leur modèle prédictif présente des failles. Donc, le changement climatique ne doit pas être réel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="EN">They claim climate change is caused by human activities, but their predictive model has flaws. Therefore, climate change must not be real.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Substituting_explanation_for_premise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitutingExplanationForPremise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacistsFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
    <Literal xml:lang="FR">Appel au bénéficiaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
    <Literal xml:lang="EN">Whom does it profit?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
    <Literal xml:lang="FR">Vous disqualifiez une proposition sans examiner son bien-fondé, sous prétexte qu’elle favorise son auteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
    <Literal xml:lang="EN">Discarding a proposal because it benefits its proponents, whithout considering its soundness.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
    <Literal xml:lang="FR">Le député propose d’augmenter les fonds pour l’éducation parce que sa femme dirige une école. Peu importe les arguments, c’est forcément pour son propre profit et non dans l’intérêt des enfants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
    <Literal xml:lang="EN">The congressman proposes an increase in education funding because his wife runs a school. Regardless of his arguments, it's surely for his own benefit and not in the interest of the children.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cui_bono</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Cui_bono</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#followTheMoney</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#followTheMoney</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#followTheMoney</IRI>
    <Literal xml:lang="FR">Appel à la vénalité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#followTheMoney</IRI>
    <Literal xml:lang="EN">Follow the money</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#followTheMoney</IRI>
    <Literal xml:lang="FR">Vous disqualifiez une proposition sans examiner son bien-fondé, sous prétexte qu’elle favorise financièrement son auteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#followTheMoney</IRI>
    <Literal xml:lang="EN">You dismiss a proposal without examining its merits, on the grounds that it financially benefits its author.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#followTheMoney</IRI>
    <Literal xml:lang="FR">Quoi qu’ils nous racontent, c’est seulement pour nous vendre plus de produits et enrichir leurs actionnaires. Pas de ce blabla avec moi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#followTheMoney</IRI>
    <Literal xml:lang="EN">No matter what they tell us, it's all to sell more products and enrich their shareholders. Spare me that talk.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#followTheMoney</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Follow_the_money</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#followTheMoney</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#followTheMoney</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#whomDoesItProfit?</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
    <Literal xml:lang="FR">Appel à l’intention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
    <Literal xml:lang="EN">Argument from motives</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
    <Literal xml:lang="FR">Vous disqualifiez une proposition sans examiner son bien-fondé, sous prétexte que les motivations de son auteur sont critiquables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
    <Literal xml:lang="EN">Challenging a thesis by calling into question the motives of its proposer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
    <Literal xml:lang="FR">Lorsque le maire a suggéré de déplacer le terrain de sport plus près du centre-ville, tout le monde a affirmé qu’il cherchait seulement à faciliter l’accès pour sa propre famille.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
    <Literal xml:lang="EN">When the mayor suggested moving the sports field closer to downtown, everyone said it was just to make access easier for his own family.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_motive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#badReasonsFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromEditorsIntent</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromEditorsIntent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromEditorsIntent</IRI>
    <Literal xml:lang="FR">Appel à la ligne éditoriale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromEditorsIntent</IRI>
    <Literal xml:lang="EN">Argument from editor's intent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromEditorsIntent</IRI>
    <Literal xml:lang="FR">Vous refusez une idée en critiquant les valeurs du média qui la publie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromEditorsIntent</IRI>
    <Literal xml:lang="EN">Criticizing the editorial intent of the media in which an argumentation is published rather than the argumentation itself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromEditorsIntent</IRI>
    <Literal xml:lang="FR">Cette chaîne d’actualités est connue pour son goût du sensationnalisme. Si elle parle de cette affaire de corruption, c’est probablement pour augmenter son audience, et non parce que l’affaire est réelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromEditorsIntent</IRI>
    <Literal xml:lang="EN">This news channel is known for its sensationalism. If they're covering this corruption story, it's probably to boost their ratings rather than because the case is real.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromEditorsIntent</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Authorial_intent#New_Criticism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromEditorsIntent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromEditorsIntent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
    <Literal xml:lang="FR">Procès d’intention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
    <Literal xml:lang="EN">Appeal to malintention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
    <Literal xml:lang="FR">Vous dénigrez une proposition en attribuant un agenda caché à son auteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
    <Literal xml:lang="EN">Discrediting a proposal by suggesting a hidden agenda on the part of its author.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
    <Literal xml:lang="FR">Elle a beau présenter des idées pour réduire la pollution, je suis convaincu qu’elle le fait uniquement pour se donner une image de responsabilité écologique auprès de ses électeurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
    <Literal xml:lang="EN">She may propose ideas to reduce pollution, but I believe it's solely to gain ecological credibility among her voters.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_motive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Proc%C3%A8s_d%27intention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="FR">Piège kafkaïen</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="EN">Kafkatrap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="FR">Vous interprétez toute tentative de défense comme une confirmation de culpabilité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="EN">Considering every defense as proof of guilt.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="FR">Si vous avez autant d’excuses, c’est parce que vous avez bien quelque chose à vous reprocher.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="EN">If you're coming up with so many excuses, it's because you've surely got something to hide.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/Kafkatrap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <Literal xml:lang="FR">https://mgtow-france.fr/2020/01/sophismes-kafkaiens-les-armes-rhetoriques-de-la-victimisation/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kafkatrap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMalintention</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
    <Literal xml:lang="FR">Sophisme psychogénétique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
    <Literal xml:lang="EN">Psychogenetic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
    <Literal xml:lang="FR">Vous discréditez un argument en pointant les raisons psychologiques de son auteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
    <Literal xml:lang="EN">Challenging an argumentation by showing the psychological reasons for its proponents to develop it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
    <Literal xml:lang="FR">Vous n’aimez pas ce film simplement parce que vous êtes jalouse de l’actrice principale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
    <Literal xml:lang="EN">You don't like this movie just because you are jealous of the main actress.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#psycho</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentFromMotives</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAnger</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAnger</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAnger</IRI>
    <Literal xml:lang="FR">Appel à la colère</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAnger</IRI>
    <Literal xml:lang="EN">Appeal to anger</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAnger</IRI>
    <Literal xml:lang="FR">Vous ignorez le fond d’une proposition en suggérant que la colère aveugle son auteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAnger</IRI>
    <Literal xml:lang="EN">Accusing one's opponent of being angry or holding their beliefs for anger-related reasons, which purportedly disproves their argument or diminishes its weight.
</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAnger</IRI>
    <Literal xml:lang="FR">Le candidat s’oppose à la construction de l’autoroute, mais étant donné qu’il enrage à chaque fois qu’on parle de progrès, ses arguments ne sont sûrement pas valides.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAnger</IRI>
    <Literal xml:lang="EN">The candidate opposes the highway construction, but since he rages every time progress is mentioned, his arguments are surely flawed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAnger</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Ad_iram</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAnger</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToAnger</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFeminam</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFeminam</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFeminam</IRI>
    <Literal xml:lang="FR">Misogynie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFeminam</IRI>
    <Literal xml:lang="EN">Ad feminam</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFeminam</IRI>
    <Literal xml:lang="FR">Sans juger de son bien-fondé, vous disqualifiez toute proposition énoncée par une femme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFeminam</IRI>
    <Literal xml:lang="EN">Without judging whether it is valid, you dismiss any proposition made by a woman.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFeminam</IRI>
    <Literal xml:lang="FR">Cette théorie est typique des discours que tiennent les femmes, pleins d’émotions mais manquant de logique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFeminam</IRI>
    <Literal xml:lang="EN">This theory is typical of speeches given by women, full of emotions but lacking in logic.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFeminam</IRI>
    <Literal xml:lang="EN">http://www.thefreedictionary.com/Argumentum+ad+feminam</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFeminam</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adFeminam</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychogeneticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <Literal xml:lang="FR">Manque de parcimonie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <Literal xml:lang="EN">Lack of Parsimony</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <Literal xml:lang="FR">Vous compliquez excessivement votre raisonnement au lieu de retenir l’explication la plus simple.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <Literal xml:lang="EN">Complicating one's reasoning excessively instead of seeking simplicity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <Literal xml:lang="FR">Où sont mes clés ? Quelqu’un a dû me les voler. Il y a sûrement un complot pour me rendre fou.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <Literal xml:lang="EN">Where did my keys go? Surely someone has stolen them. It's a conspiracy to drive me insane.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Occam%27s_razor</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Rasoir_d%27Ockham</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#overinterpretation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hanlonsRazorFailure</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hanlonsRazorFailure</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hanlonsRazorFailure</IRI>
    <Literal xml:lang="FR">Manquement au rasoir d’Hanlon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hanlonsRazorFailure</IRI>
    <Literal xml:lang="EN">Hanlon's razor failure</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hanlonsRazorFailure</IRI>
    <Literal xml:lang="FR">Vous supposez une mauvaise intention pour expliquer une erreur qui pourrait simplement résulter d’une maladresse ou d’un accident.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hanlonsRazorFailure</IRI>
    <Literal xml:lang="EN">Explaining bad choices by causes worse and more complex than others. For example, by malice instead of error.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hanlonsRazorFailure</IRI>
    <Literal xml:lang="FR">Si des erreurs ont été commises dans ce projet, c’est certainement que les concurrents ont infiltré l’entreprise pour nous faire échouer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hanlonsRazorFailure</IRI>
    <Literal xml:lang="EN">If mistakes were made in this project, it must be because competitors infiltrated the company to make us fail.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hanlonsRazorFailure</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Hanlon%27s_razor</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hanlonsRazorFailure</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hanlonsRazorFailure</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
    <Literal xml:lang="FR">Manquement au principe de charité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
    <Literal xml:lang="EN">Failing the principle of charity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
    <Literal xml:lang="FR">Vous interprétez les propos de votre interlocuteur de la manière la plus défavorable ou la moins raisonnable possible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
    <Literal xml:lang="EN">Interpreting one's interlocutor's words in the least favorable or least reasonable way possible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
    <Literal xml:lang="FR">Si vous commencez à parler de réduire les dépenses, nous comprenons bien que vous voulez nous forcer à nous battre pour nos salaires et nos emplois.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
    <Literal xml:lang="EN">If you start talking about cutting expenses, it clearly means we will have to fight for our salaries and jobs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Principle_of_charity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Principe_de_charit%C3%A9</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="FR">Homme de paille</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="EN">Straw man</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="FR">Vous caricaturez l’argument de l’autre pour pouvoir le réfuter plus facilement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="EN">Attributing easily refutable claims to the opposing party, then disproving them easily.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="FR">Ah, donc selon vous, nous devrions passer toutes nos journées à fouiller dans les poubelles pour trier les déchets ? Ce n’est pas une vie !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="EN">Ah, so according to you, we should spend all our days digging through trash to sort out the waste? That's no way to live!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Straw_man</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/%C3%89pouvantail_(rh%C3%A9torique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#strawMan</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failingThePrincipleOfCharity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#violatingMorgansCanon</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#violatingMorgansCanon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#violatingMorgansCanon</IRI>
    <Literal xml:lang="FR">Manquement au canon de Morgan</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#violatingMorgansCanon</IRI>
    <Literal xml:lang="EN">Violating Morgan's Canon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#violatingMorgansCanon</IRI>
    <Literal xml:lang="FR">Vous attribuez aux animaux des intentions, des raisonnements ou des caractéristiques typiquement humaines sans justification suffisante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#violatingMorgansCanon</IRI>
    <Literal xml:lang="EN">Granting more rationality than necessary to animal behaviour, tthus risking to slip into anthropomorphic thinking.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#violatingMorgansCanon</IRI>
    <Literal xml:lang="FR">Mon chat m’apporte toujours des souris mortes : cela montre qu’il comprend la valeur du travail et qu’il veut partager ses gains avec la famille.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#violatingMorgansCanon</IRI>
    <Literal xml:lang="EN">Whenever my cat brings me a dead mouse, it demonstrates that he recognizes the value of labor and wishes to share it with me, feeling part of our household.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#violatingMorgansCanon</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/Morgan%27s_canon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#violatingMorgansCanon</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#violatingMorgansCanon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
    <Literal xml:lang="FR">Sophisme animiste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
    <Literal xml:lang="EN">Animism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
    <Literal xml:lang="FR">Vous prêtez aux éléments de la nature ou à des objets inanimés des intentions ou des actions propres aux êtres animés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
    <Literal xml:lang="EN">Attributing actions or intentions to natural elements or inanimate objects as though they were living beings.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
    <Literal xml:lang="FR">Les tremblements de terre sont un moyen pour la Terre de nous avertir que nous la traitons mal. C’est sa façon de nous dire de changer nos comportements destructeurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
    <Literal xml:lang="EN">Earthquakes are the Earth's way of signaling to us that we abuse it. It's as if the planet is telling us to change our harmful behaviors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Animism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
    <Literal xml:lang="FR">http://sophismes.free.fr/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#violatingMorgansCanon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#violatingMorgansCanon</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#patheticFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#patheticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#patheticFallacy</IRI>
    <Literal xml:lang="FR">Sophisme pathétique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#patheticFallacy</IRI>
    <Literal xml:lang="EN">Pathetic fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#patheticFallacy</IRI>
    <Literal xml:lang="FR">Vous attribuez aux choses inanimées des sentiments humains, comme si elles pouvaient ressentir des émotions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#patheticFallacy</IRI>
    <Literal xml:lang="EN">Attributing human feelings to inanimate things, as if they could experience emotions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#patheticFallacy</IRI>
    <Literal xml:lang="FR">Cette voiture abandonnée depuis des mois dans la rue semble triste et délaissée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#patheticFallacy</IRI>
    <Literal xml:lang="EN">This abandoned car, sitting for months on the street, looks sad and neglected.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#patheticFallacy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pathetic_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#patheticFallacy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pathetic_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#patheticFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#patheticFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#animism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="FR">Apophénie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="EN">Apophenia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="FR">Vous imaginez des liens ou des significations entre des éléments qui, en réalité, ne sont pas liés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="EN">Attributing meaning to perceived connections or patterns between seemingly unrelated things.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="FR">Il y a eu trois coupures de courant la semaine où j’ai emménagé. C’est un signe qu’il ne faut pas que je reste dans cette ville.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="EN">There were three power outages the week I moved in. It's a sign I should not stay in this city.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="EN">http://skepdic.com/apophenia.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Apoph%C3%A9nie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lackOfParsimony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pareidolia</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pareidolia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pareidolia</IRI>
    <Literal xml:lang="FR">Paréidolie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pareidolia</IRI>
    <Literal xml:lang="EN">Pareidolia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pareidolia</IRI>
    <Literal xml:lang="FR">Vous percevez des motifs familiers dans des images vagues, alors qu’ils n’y sont pas réellement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pareidolia</IRI>
    <Literal xml:lang="EN">Perceiving a familiar pattern where none exists.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pareidolia</IRI>
    <Literal xml:lang="FR">Ce matin, la tache dans mon café ressemblait à un visage souriant : je suis sûr que c’est un présage de bonne fortune pour ma journée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pareidolia</IRI>
    <Literal xml:lang="EN">That stain on my coffee this morning resembled a smiling face; I'm convinced it portends good luck for the day.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pareidolia</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pareidolia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pareidolia</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Par%C3%A9idolie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pareidolia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pareidolia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="FR">Illusion de regroupement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="EN">Clustering Illusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="FR">Vous percevez des motifs ou des tendances dans des données aléatoires ou sans lien, ce qui crée une fausse impression de corrélation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="EN">Perceiving patterns or trends in random or unrelated data, creating a false impression of correlation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="FR">Regardez cette série de nombres : il y a sûrement un modèle secret derrière !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="EN">Look at this sequence of numbers, there must be a secret pattern behind it!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Clustering_illusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Illusion_des_s%C3%A9ries</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clusteringIllusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophenia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <Literal xml:lang="FR">Influence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <Literal xml:lang="EN">Influence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <Literal xml:lang="FR">Vous manipulez votre auditoire pour le persuader au lieu de le convaincre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <Literal xml:lang="EN">Using tactics to manipulate the audience rather than using logical reasoning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <Literal xml:lang="FR"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <Literal xml:lang="EN"></Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Social_influence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Influence_(psychologie)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
    <Literal xml:lang="FR">Technique rhétorique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
    <Literal xml:lang="EN">Rhetorical device</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
    <Literal xml:lang="FR">Vous utilisez des formules séduisantes et un style persuasif pour convaincre, sans nécessairement fonder votre propos sur un raisonnement logique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
    <Literal xml:lang="EN">Using seductive phrases and a persuasive style to convince, without necessarily founding the point on logical reasoning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
    <Literal xml:lang="FR">Votre éloquence est à la hauteur de votre prestance : vous êtes vraiment exceptionnel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
    <Literal xml:lang="EN">Your eloquence matches your presence: you truly are exceptional.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Rhetorical_device</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <Literal xml:lang="FR">Langage persuasif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <Literal xml:lang="EN">Loaded language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <Literal xml:lang="FR">Vous vous exprimez de manière à imposer implicitement le cadre et les termes du débat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <Literal xml:lang="EN">Using emotionally charged or connotative language to implicitly shape the debate's framework.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <Literal xml:lang="FR">À votre avis, les élites, responsables de cette situation, peuvent-elles nous en sortir ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <Literal xml:lang="EN">In your view, can the elites responsible for this situation get us out of it?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Loaded_language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="FR">Question piège</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="EN">Loaded question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="FR">Vous posez une question piégée ou complexe pour amener votre interlocuteur à donner une réponse qui le mettra en difficulté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="EN">Posing a complex question to trap the opponent into a response that disadvantages them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="FR">Quand allez-vous enfin admettre que vous n’avez aucune preuve de ce que vous avancez ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="EN">When will you finally admit that you have no evidence to back up your claims?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="FR">Question piège</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="EN">Loaded question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="FR">Vous posez une question qui suppose subtilement une prémisse fausse ou controversée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="EN">Asking a question that subtly assumes a false or controversial premise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="FR">Avez-vous arrêté de martyriser votre chien ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="EN">Have you stopped tormenting your dog?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Complex_question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Plurium_interrogationum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalQuestion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalQuestion</IRI>
    <Literal xml:lang="FR">Question rhétorique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalQuestion</IRI>
    <Literal xml:lang="EN">Rhetorical question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalQuestion</IRI>
    <Literal xml:lang="FR">Vous posez une question qui n’attend pas de réponse, comme si la réponse était évidente.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalQuestion</IRI>
    <Literal xml:lang="EN">Asking a question that does not expect an answer, as if the answer were obvious.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalQuestion</IRI>
    <Literal xml:lang="FR">Dois-je vous rappeler combien nous serions tous bien mieux sans ces taxes supplémentaires ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalQuestion</IRI>
    <Literal xml:lang="EN">Do I need to remind you how much better off we would all be without these extra taxes?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalQuestion</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#rhetorical_question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#compoundQuestion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#compoundQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#compoundQuestion</IRI>
    <Literal xml:lang="FR">Question multiple</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#compoundQuestion</IRI>
    <Literal xml:lang="EN">Compound question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#compoundQuestion</IRI>
    <Literal xml:lang="FR">Vous demandez à votre interlocuteur de répondre à plusieurs questions complexes en une seule fois.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#compoundQuestion</IRI>
    <Literal xml:lang="EN">Asking the interlocutor to answer several complex questions at once.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#compoundQuestion</IRI>
    <Literal xml:lang="FR">Êtes-vous d’accord pour dire que les voitures devraient être à la fois plus sûres et plus rapides ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#compoundQuestion</IRI>
    <Literal xml:lang="EN">Do you agree that cars should be both safer and faster?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#compoundQuestion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Double-barreled_question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#compoundQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#compoundQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alternativeAdvance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alternativeAdvance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alternativeAdvance</IRI>
    <Literal xml:lang="FR">Fausse alternative</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alternativeAdvance</IRI>
    <Literal xml:lang="EN">Alternative advance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alternativeAdvance</IRI>
    <Literal xml:lang="FR">Vous présentez un choix entre deux propositions qui mènent au même résultat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alternativeAdvance</IRI>
    <Literal xml:lang="EN">Pretending to offer an alternative, whereas its terms lead to essentially similar results.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alternativeAdvance</IRI>
    <Literal xml:lang="FR">Pile, je gagne. Face, vous perdez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alternativeAdvance</IRI>
    <Literal xml:lang="EN">Heads I win, tails you lose.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alternativeAdvance</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/16/Alternative-Advance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alternativeAdvance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alternativeAdvance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="FR">Pétition de principe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="EN">Begging the question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="FR">Vous utilisez un argument qui suppose déjà vrai ce que vous cherchez à prouver.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="EN">Proving a proposition with an argumentation that takes it for granted.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="FR">Mieux vaut avoir un chat qu’un chien, car les chats sont de meilleurs animaux de compagnie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="EN">Owning a cat is better than owning a dog, because cats make better pets.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Begging_the_question</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/P%C3%A9tition_de_principe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#beggingTheQuestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <Literal xml:lang="FR">Définition persuasive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <Literal xml:lang="EN">Persuasive definition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <Literal xml:lang="FR">Vous définissez des termes de manière biaisée pour orienter le débat en votre faveur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <Literal xml:lang="EN">Defining terms in a biased way to steer the debate in one's favor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <Literal xml:lang="FR">Cet homme est athée : il n’a pas été touché par la grâce de Dieu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <Literal xml:lang="EN">This man is an atheist, someone who has not been touched by the grace of God.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Persuasive_definition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persuasiveDefinition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <Literal xml:lang="FR">Poncif anticritique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <Literal xml:lang="EN">Thought-terminating cliché</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <Literal xml:lang="FR">Vous utilisez des clichés frappants pour court-circuiter l’esprit critique ou éviter un débat argumenté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <Literal xml:lang="EN">Using striking clichés to short-circuit critical thinking or avoid an argued debate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <Literal xml:lang="FR">Nous devons aussi appliquer une politique de tolérance zéro aux enfants : qui vole un œuf vole un bœuf.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <Literal xml:lang="EN">We must also apply a zero-tolerance policy to children, because he who steals an egg will steal an ox.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Clich%C3%A9#Thought-terminating_clich.C3.A9</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Thought-terminating_cliché</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentBySlogan</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentBySlogan</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentBySlogan</IRI>
    <Literal xml:lang="FR">Appel au slogan</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentBySlogan</IRI>
    <Literal xml:lang="EN">Argument by slogan</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentBySlogan</IRI>
    <Literal xml:lang="FR">Afin de convaincre votre auditoire, vous employez en guise d’argument une formule concise et accrocheuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentBySlogan</IRI>
    <Literal xml:lang="EN">Using a slogan for its concision and efficacy to support one's argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentBySlogan</IRI>
    <Literal xml:lang="FR">Notre dette, c’est votre liberté !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentBySlogan</IRI>
    <Literal xml:lang="EN">Our debt is your freedom!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentBySlogan</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#slogan</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentBySlogan</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentBySlogan</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="FR">Petite phrase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="EN">Sound bite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="FR">Afin de convaincre votre auditoire, vous glissez dans un discours public une phrase accrocheuse censée marquer les esprits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="EN">Slipping a catchy phrase into a public speech to make an impression and convince one's audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="FR">Même quand je ne dis rien, cela fait du bruit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="EN">Even when I say nothing, it makes noise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sound_bite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Petite_phrase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#soundBite</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clichéThinking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clichéThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clichéThinking</IRI>
    <Literal xml:lang="FR">Pensée cliché</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clichéThinking</IRI>
    <Literal xml:lang="EN">Cliché thinking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clichéThinking</IRI>
    <Literal xml:lang="FR">Vous basez vos arguments sur des expressions toutes faites comme si elles constituaient une preuve solide.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clichéThinking</IRI>
    <Literal xml:lang="EN">Using as evidence a well-known wise saying, as if that is proven, or as if it has no exceptions.
</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clichéThinking</IRI>
    <Literal xml:lang="FR">Tout travail mérite salaire, et il est grand temps pour nous de récolter les fruits de nos efforts mûris avec patience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clichéThinking</IRI>
    <Literal xml:lang="EN">Every job deserves a wage, and it's high time for us to reap the fruits of our patiently ripened efforts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clichéThinking</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#cliche</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clichéThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clichéThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeFraming</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeFraming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeFraming</IRI>
    <Literal xml:lang="FR">Technique du carpaccio</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeFraming</IRI>
    <Literal xml:lang="EN">Narrative framing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeFraming</IRI>
    <Literal xml:lang="FR">Afin de rendre votre argumentation plus séduisante, vous l’inscrivez dans une trame narrative.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeFraming</IRI>
    <Literal xml:lang="EN">Presenting an argument in a carefully crafted drama in order to make it more attractive.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeFraming</IRI>
    <Literal xml:lang="FR">Le président, après s’être rendu sur les lieux du drame, a visité les familles endeuillées, puis il a déclaré qu’il rencontrerait les responsables syndicaux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeFraming</IRI>
    <Literal xml:lang="EN">The president, after visiting the scene of the tragedy, met with the bereaved families, then stated that he would meet with union representatives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeFraming</IRI>
    <Literal xml:lang="EN">https://repository.upenn.edu/cgi/viewcontent.cgi?referer=&amp;httpsredir=1&amp;article=1367&amp;context=asc_papers</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeFraming</IRI>
    <Literal xml:lang="FR">https://cortecs.org/materiel/scenarisation-de-linformation-la-technique-du-carpaccio/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeFraming</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narrativeFraming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thoughtterminatingCliché</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
    <Literal xml:lang="FR">Preuve par intimidation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
    <Literal xml:lang="EN">Proof by intimidation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
    <Literal xml:lang="FR">Vous présentez votre argument de façon à impressionner votre auditoire ou à lui faire croire qu’il n’est pas compétent, afin qu’il l’accepte sans discussion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
    <Literal xml:lang="EN">Presenting an argument so as to impress the audience or make them feel incompetent, so that they accept it without discussion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
    <Literal xml:lang="FR">Je vous rappelle que j’ai un doctorat dans ce domaine : je sais donc mieux que quiconque ce qui est vrai ou faux ici.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
    <Literal xml:lang="EN">I remind you that I have a PhD in this field, so I know better than anyone what is true or false here.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Proof_by_intimidation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <Literal xml:lang="FR">Obscurcissement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <Literal xml:lang="EN">Obfuscation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <Literal xml:lang="FR">Vous rendez volontairement l’information difficile à comprendre afin de masquer certains faits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <Literal xml:lang="EN">Intentionally making information difficult to understand to hide facts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <Literal xml:lang="FR">Lors de notre dernière réunion, nous avons longuement discuté des implications multifactorielles de notre stratégie de développement, en tenant compte de diverses perspectives, des contingences possibles et des ramifications probables de chaque scénario envisageable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <Literal xml:lang="EN">At our last meeting, we discussed in depth and comprehensively the multi-factorial implications of our development strategy, taking into account the various possible perspectives and contingencies, as well as the likely ramifications of each possible scenario.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Obfuscation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Offuscation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbosity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbosity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbosity</IRI>
    <Literal xml:lang="FR">Verbiage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbosity</IRI>
    <Literal xml:lang="EN">Verbosity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbosity</IRI>
    <Literal xml:lang="FR">Vous utilisez trop de mots pour noyer l’essentiel ou rendre le message moins clair.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbosity</IRI>
    <Literal xml:lang="EN">Using too many words to drown out the main point or make the message less clear.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbosity</IRI>
    <Literal xml:lang="FR">Pour atteindre les objectifs stratégiques du trimestre prochain, il est impératif de reconsidérer nos paradigmes opérationnels et de réévaluer les synergies potentielles entre les départements afin de maximiser l’efficacité globale de l’organisation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbosity</IRI>
    <Literal xml:lang="EN">In order to optimize our ability to achieve the strategic objectives set for the next quarter, it is imperative to reconsider our operational paradigms and reassess potential synergies between the various departments in order to maximize the overall efficiency of our organization.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbosity</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Verbosity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbosity</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Verbiage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbosity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbosity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <Literal xml:lang="FR">Preuve par jargon prestigieux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <Literal xml:lang="EN">Proof by prestigious jargon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <Literal xml:lang="FR">Vous employez volontairement des termes complexes ou prestigieux pour intimider votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <Literal xml:lang="EN">Using deliberately complex terms intended to intimidate an audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <Literal xml:lang="FR">Tout cela est encore une conséquence du champ quantique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <Literal xml:lang="EN">All this is yet another consequence of the quantum field.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#jargon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLatin</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLatin</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLatin</IRI>
    <Literal xml:lang="FR">Preuve par le latin</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLatin</IRI>
    <Literal xml:lang="EN">Proof by Latin</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLatin</IRI>
    <Literal xml:lang="FR">Vous utilisez des expressions latines pour intimider votre public.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLatin</IRI>
    <Literal xml:lang="EN">You use Latin expressions to intimidate your audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLatin</IRI>
    <Literal xml:lang="FR">Comme l’affirme l’adage juridique « Nemo auditur propriam turpitudinem allegans ». Votre faute est donc impardonnable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLatin</IRI>
    <Literal xml:lang="EN">As the legal adage states 'Nemo auditur propriam turpitudinem allegans'. Your fault is therefore unforgivable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLatin</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Quidquid_latine_dictum_sit,_altum_videtur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLatin</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLatin</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alphabetSoup</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alphabetSoup</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alphabetSoup</IRI>
    <Literal xml:lang="FR">Soupe alphabétique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alphabetSoup</IRI>
    <Literal xml:lang="EN">Alphabet Soup</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alphabetSoup</IRI>
    <Literal xml:lang="FR">Vous abusez d’abréviations et de jargon spécialisé pour afficher vos connaissances et désorienter les personnes qui ne maîtrisent pas ces termes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alphabetSoup</IRI>
    <Literal xml:lang="EN">Utilizing an overabundance of acronyms and specialized jargon to display expertise and bewildering those unfamiliar with the terms.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alphabetSoup</IRI>
    <Literal xml:lang="FR">En programmation CGI, une interface WYSIWYG ne gère pas très bien PHP ou CSS. Si vous vous inscrivez à mon programme de coaching, je vous montrerai comment faire un site web.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alphabetSoup</IRI>
    <Literal xml:lang="EN">In CGI programming, a WYSIWYG interface doesn't handle PHP or CSS very well. If you enroll in my coaching program, I'll show you how to make a website.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alphabetSoup</IRI>
    <Literal xml:lang="EN">http://utminers.utep.edu/omwilliamson/ENGL1311/fallacies.htm#6</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alphabetSoup</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alphabetSoup</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#corporateJargon</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#corporateJargon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#corporateJargon</IRI>
    <Literal xml:lang="FR">Jargon corporate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#corporateJargon</IRI>
    <Literal xml:lang="EN">Corporate jargon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#corporateJargon</IRI>
    <Literal xml:lang="FR">Vous employez des termes propres au monde de l’entreprise et du management qui nuisent à la compréhension de votre discours.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#corporateJargon</IRI>
    <Literal xml:lang="EN">You use terms specific to the corporate and management world that make your argument harder to understand.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#corporateJargon</IRI>
    <Literal xml:lang="FR">On n’avancera qu’en capitalisant sur ce leverage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#corporateJargon</IRI>
    <Literal xml:lang="EN">We will only advance by capitalizing on this leverage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#corporateJargon</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Corporate_jargon</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#corporateJargon</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#corporateJargon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#academese</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#academese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#academese</IRI>
    <Literal xml:lang="FR">Academisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#academese</IRI>
    <Literal xml:lang="EN">Academese</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#academese</IRI>
    <Literal xml:lang="FR">Vous utilisez un langage formel, spécialisé et souvent complexe, typique
du milieu académique, qui peut rendre votre discours inaccessibles aux
non-initiés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#academese</IRI>
    <Literal xml:lang="EN">Employing a formal, specialized, and often complex language typical of
academic settings, which can make one's speech inaccessible to the
uninitiated.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#academese</IRI>
    <Literal xml:lang="FR">Dans le cadre de cette recherche, nous postulons que les paradigmes épistémologiques actuels nécessitent une réévaluation dialectique pour comprendre pleinement les implications ontologiques des phénomènes observés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#academese</IRI>
    <Literal xml:lang="EN">In this research, we posit that the current epistemological paradigms need dialectical reassessment to fully understand the ontological implications of the phenomena observed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#academese</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Academese</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#academese</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#academese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technobabble</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technobabble</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technobabble</IRI>
    <Literal xml:lang="FR">Jargon scientifique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technobabble</IRI>
    <Literal xml:lang="EN">Technobabble</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technobabble</IRI>
    <Literal xml:lang="FR">Vous donnez un air de sérieux à votre argumentation en utilisant des mots complexes du jargon scientifique, qui ne sont pourtant pas nécessaires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technobabble</IRI>
    <Literal xml:lang="EN">Giving an argument an air of seriousness by using complex words from scientific jargon which are not necessary.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technobabble</IRI>
    <Literal xml:lang="FR">Grâce à l’utilisation de nanotechnologies avancées, nous pouvons optimiser le flux d’énergie quantique dans nos systèmes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technobabble</IRI>
    <Literal xml:lang="EN">Using cutting-edge nanotechnology, we can optimize the quantum energy flow in our systems.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technobabble</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Technobabble</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#academese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technobabble</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#technobabble</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#academese</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#officialese</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#officialese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#officialese</IRI>
    <Literal xml:lang="FR">Langage bureaucratique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#officialese</IRI>
    <Literal xml:lang="EN">Officialese</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#officialese</IRI>
    <Literal xml:lang="FR">Vous utilisez un langage complexe et pompeux, typique de l’administration, pour donner une impression d’officiel et d’autorité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#officialese</IRI>
    <Literal xml:lang="EN">Employing complex and pompous administrative language to create an impression of officialdom and authority.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#officialese</IRI>
    <Literal xml:lang="FR">Dans le cadre de l’application des dispositions statutaires prévues par le règlement intérieur, une procédure de réévaluation des protocoles existants sera mise en œuvre conformément aux normes institutionnelles établies.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#officialese</IRI>
    <Literal xml:lang="EN">Within the framework of applying the statutory provisions outlined in the internal regulations, a procedure for reassessing existing protocols will be implemented in accordance with established institutional standards.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#officialese</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Officialese</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#officialese</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#officialese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fedspeak</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fedspeak</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fedspeak</IRI>
    <Literal xml:lang="FR">Fedspeak</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fedspeak</IRI>
    <Literal xml:lang="EN">Fedspeak</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fedspeak</IRI>
    <Literal xml:lang="FR">Vous utilisez un langage délibérément vague, complexe et ambigu, typique des présidents de la Réserve fédérale américaine, pour prévenir les réactions excessives à vos déclarations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fedspeak</IRI>
    <Literal xml:lang="EN">Employing deliberately vague, complex, and ambiguous language characteristic of Federal Reserve Board chairs to prevent overreactions to one's statements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fedspeak</IRI>
    <Literal xml:lang="FR">Les membres du Conseil des gouverneurs et les présidents des banques de réserve prévoient un renforcement implicite de l’activité après la fin de la rééquilibration actuelle, bien que la tendance centrale de leurs prévisions individuelles pour le PIB réel montre encore un ralentissement substantiel, dans l’ensemble, pour l’année dans son ensemble.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fedspeak</IRI>
    <Literal xml:lang="EN">The members of the Board of Governors and the Reserve Bank presidents foresee an implicit strengthening of activity after the current rebalancing is over, although the central tendency of their individual forecasts for real GDP still shows a substantial slowdown, on balance, for the year as a whole.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fedspeak</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fedspeak</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#officialese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fedspeak</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fedspeak</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#officialese</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#legalese</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#legalese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#legalese</IRI>
    <Literal xml:lang="FR">Jargon juridique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#legalese</IRI>
    <Literal xml:lang="EN">Legalese</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#legalese</IRI>
    <Literal xml:lang="FR">Vous donnez un air de sérieux à votre argumentation en utilisant des mots complexes du jargon scientifique, qui ne sont pourtant pas nécessaires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#legalese</IRI>
    <Literal xml:lang="EN">You make your argument seem more serious by using complex scientific jargon, even though such terms are unnecessary.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#legalese</IRI>
    <Literal xml:lang="FR">Conformément aux dispositions prévues par l’article 1357 du Code civil, le débiteur s’engage irrévocablement à exécuter ses obligations contractuelles dans un délai stipulé, sous réserve des conditions suspensives énoncées aux alinéas 3 et 4.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#legalese</IRI>
    <Literal xml:lang="EN">In accordance with the stipulations set forth in section 1357 of the Civil Code, the debtor irrevocably commits to fulfilling their contractual obligations within the specified timeframe, subject to the suspensive conditions outlined in paragraphs 3 and 4.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#legalese</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Legal_writing#Legalese</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#legalese</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#legalese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByPrestigiousJargon</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obscurantism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obscurantism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obscurantism</IRI>
    <Literal xml:lang="FR">Obscurantisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obscurantism</IRI>
    <Literal xml:lang="EN">Obscurantism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obscurantism</IRI>
    <Literal xml:lang="FR">Vous présentez un savoir théorique de manière intentionnellement difficile à comprendre afin de limiter sa diffusion ou d’échapper aux critiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obscurantism</IRI>
    <Literal xml:lang="EN">Presenting theoretical knowledge in a manner that intentionally makes it difficult to understand, either to limit its dissemination or to evade criticism.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obscurantism</IRI>
    <Literal xml:lang="FR">L’interprétation des données phénoménologiques nécessite une compréhension herméneutique approfondie, qui transcende la simple analyse empirique et s’inscrit dans une démarche épistémologique non réductrice.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obscurantism</IRI>
    <Literal xml:lang="EN">The interpretation of phenomenological data requires an in-depth hermeneutic understanding, which transcends simple empirical analysis and is part of a non-reductive epistemological approach.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obscurantism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Obscurantism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obscurantism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Obscurantisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obscurantism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obscurantism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#obfuscation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <Literal xml:lang="FR">Effet d’impact</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <Literal xml:lang="EN">Slanted language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <Literal xml:lang="FR">Vous employez délibérément des mots dont les connotations peuvent influencer votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <Literal xml:lang="EN">Choosing formulations for their impact on the audience, independently from their explicit meaning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <Literal xml:lang="FR">L’armée a procédé à une « frappe chirurgicale » lors d’une incursion qui n’a entraîné aucune « perte collatérale ».</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <Literal xml:lang="EN">The army carried out a “surgical strike” during an incursion that caused no “collateral losses.”</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <Literal xml:lang="EN">https://www.vanderbilt.edu/writing/resources/handouts/illogical-arguments/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <Literal xml:lang="FR">https://cortecs.org/materiel/leffet-impact/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLargeNumbers</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLargeNumbers</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLargeNumbers</IRI>
    <Literal xml:lang="FR">Preuve par les grands nombres</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLargeNumbers</IRI>
    <Literal xml:lang="EN">Proof by large numbers</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLargeNumbers</IRI>
    <Literal xml:lang="FR">Vous impressionnez par des chiffres énormes pour masquer le manque de solidité de votre argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLargeNumbers</IRI>
    <Literal xml:lang="EN">Impressing with enormous numbers to conceal the lack of solidity in an argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLargeNumbers</IRI>
    <Literal xml:lang="FR">Les 150 000 femmes qui ont déjà acheté ce parfum ne peuvent pas se tromper.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLargeNumbers</IRI>
    <Literal xml:lang="EN">150,000 women can't be wrong for choosing this perfume.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLargeNumbers</IRI>
    <Literal xml:lang="EN">http://www.ditext.com/fearnside/17.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLargeNumbers</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByLargeNumbers</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByGibberish</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByGibberish</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByGibberish</IRI>
    <Literal xml:lang="FR">Appel au charabia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByGibberish</IRI>
    <Literal xml:lang="EN">Argument by gibberish</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByGibberish</IRI>
    <Literal xml:lang="FR">Votre discours, embrouillé et peu intelligible, s’appuie sur un langage prétendument savant censé intimider votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByGibberish</IRI>
    <Literal xml:lang="EN">Basing a confused and barely intelligible discourse on supposedly scholarly language meant to intimidate an audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByGibberish</IRI>
    <Literal xml:lang="FR">L’émergence de la conscience dépend de l’esprit holographique quantique qui se réfléchit en nous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByGibberish</IRI>
    <Literal xml:lang="EN">The emergence of consciousness is dependent on the quantum holographic spirit reflecting within us.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByGibberish</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#gibberish</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByGibberish</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentByGibberish</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="FR">Effet puits</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="EN">Deepity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="FR">Vous employez des formules creuses et pompeuses qui donnent une impression de profondeur, tout en restant vides de contenu précis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="EN">Using hollow and pompous formulas that give an impression of depth while remaining devoid of precise content.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="FR">Considérant la conjoncture actuelle, il est nécessaire de prendre en compte chacune des problématiques déjà en notre possession, afin de pouvoir prendre les mesures indispensables pour y répondre pertinemment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="EN">Considering the current situation, it is necessary to take into account each of the issues already in our possession, so that we can take the indispensable measures to respond to them appropriately.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="EN">https://www.readjuancarlos.com/mental-model-twaddle-tendency/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="FR">https://cortecs.org/materiel/leffet-puits/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
    <Literal xml:lang="FR">Jargon journalistique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
    <Literal xml:lang="EN">Journalese</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
    <Literal xml:lang="FR">Vous utilisez un style d’écriture ou de langage spécifique au journalisme, caractérisé par des formulations sensationnalistes, des clichés ou des termes à la mode pour capter l’attention du public.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
    <Literal xml:lang="EN">Employing a writing or speaking style specific to journalism, characterized by sensationalist phrasing, clichés, or trendy terms to capture public attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
    <Literal xml:lang="FR">En exclusivité mondiale, notre enquête explosive révèle le scandale qui secoue les couloirs du pouvoir, une affaire à rebondissements qui pourrait bien ébranler les plus hautes sphères de l’État.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
    <Literal xml:lang="EN">In a world exclusive, our explosive investigation reveals the scandal rocking the corridors of power, a story full of twists that could shake the highest echelons of government.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Journalese</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slantedLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#varietyese</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#varietyese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#varietyese</IRI>
    <Literal xml:lang="FR">Jargon de la variété</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#varietyese</IRI>
    <Literal xml:lang="EN">Varietyese</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#varietyese</IRI>
    <Literal xml:lang="FR">Vous adoptez le style des magazines people : hyperboles, jeux de mots et références à la culture populaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#varietyese</IRI>
    <Literal xml:lang="EN">Adopting the style of celebrity magazines: hyperbole, wordplay, and references to popular culture.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#varietyese</IRI>
    <Literal xml:lang="FR">La star montante du cinéma français illumine le tapis rouge avec une robe à couper le souffle, éclipsant tous les autres lors de cette soirée pailletée d’étoiles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#varietyese</IRI>
    <Literal xml:lang="EN">The rising star of French cinema lights up the red carpet in a breathtaking gown, outshining everyone at this glittering star-studded event.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#varietyese</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Varietyese</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#varietyese</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#varietyese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#headlinese</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#headlinese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#headlinese</IRI>
    <Literal xml:lang="FR">Langage des titres de presse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#headlinese</IRI>
    <Literal xml:lang="EN">Headlinese</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#headlinese</IRI>
    <Literal xml:lang="FR">Vous écrivez en utilisant un style succinct, souvent avec des abréviations, des ellipses et des mots-clés accrocheurs, pour attirer l’attention rapide des lecteurs sans fournir de détails complets.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#headlinese</IRI>
    <Literal xml:lang="EN">Using a brief style, often with abbreviations, ellipses, and catchy keywords, to quickly grab readers' attention without providing full details.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#headlinese</IRI>
    <Literal xml:lang="FR">Crise gouvernementale : PM démissionne, marchés chutent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#headlinese</IRI>
    <Literal xml:lang="EN">Govt Crisis: PM Resigns, Markets Tumble</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#headlinese</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Headline#Headlinese</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#headlinese</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#headlinese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#journalese</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sensationalHeadlines</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sensationalHeadlines</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sensationalHeadlines</IRI>
    <Literal xml:lang="FR">Titre sensationnel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sensationalHeadlines</IRI>
    <Literal xml:lang="EN">Sensational Headlines</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sensationalHeadlines</IRI>
    <Literal xml:lang="FR">Vous utilisez des formules dramatiques et des titres accrocheurs pour attirer l’attention, souvent au prix de la précision et de la clarté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sensationalHeadlines</IRI>
    <Literal xml:lang="EN">Relying on dramatic formulas and eye-catching headlines to grab attention, often at the expense of accuracy and clarity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sensationalHeadlines</IRI>
    <Literal xml:lang="FR">Tragédie en montagne : un bus plonge, des dizaines de morts !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sensationalHeadlines</IRI>
    <Literal xml:lang="EN">Mountain Tragedy: Bus Plunge Leaves Dozens Dead!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sensationalHeadlines</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Headline#Criticism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#headlinese</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sensationalHeadlines</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sensationalHeadlines</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#headlinese</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToManyAuthoritativeReferences</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToManyAuthoritativeReferences</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToManyAuthoritativeReferences</IRI>
    <Literal xml:lang="FR">Référencement pléthorique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToManyAuthoritativeReferences</IRI>
    <Literal xml:lang="EN">Appeal to many authoritative references</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToManyAuthoritativeReferences</IRI>
    <Literal xml:lang="FR">Vous invoquez un grand nombre de sources pour donner de l’autorité à un argument faible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToManyAuthoritativeReferences</IRI>
    <Literal xml:lang="EN">Invoking a large number of sources to lend authority to a weak argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToManyAuthoritativeReferences</IRI>
    <Literal xml:lang="FR">Chers investisseurs, permettez-moi de vous présenter l’ensemble des études qui viendront soutenir mon projet de développement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToManyAuthoritativeReferences</IRI>
    <Literal xml:lang="EN">Let me list all the studies that back my development project, dear investors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToManyAuthoritativeReferences</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Linking_to_authority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToManyAuthoritativeReferences</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToManyAuthoritativeReferences</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByIntimidation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <Literal xml:lang="FR">Préjugés linguistiques</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <Literal xml:lang="EN">Prejudicial language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <Literal xml:lang="FR">Votre discours repose sur des termes à forte connotation morale, qui orientent déjà la conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <Literal xml:lang="EN">Basing discourse on terms with strong moral connotations that already steer the conclusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <Literal xml:lang="FR">Tous les bons croyants savent que les pensées impures viennent du Diable et qu’il faut donc y résister à tout prix.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <Literal xml:lang="EN">Every good believer knows that impure thoughts come from the Devil, and must therefore be resisted at all costs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/143/Prejudicial-Language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loadedLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogwhistlePolitics</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogwhistlePolitics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogwhistlePolitics</IRI>
    <Literal xml:lang="FR">Acception sélective</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogwhistlePolitics</IRI>
    <Literal xml:lang="EN">Dog-whistle politics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogwhistlePolitics</IRI>
    <Literal xml:lang="FR">Vous employez volontairement une formulation qui prendra, pour une communauté ciblée, un sens différent de celui que percevra le grand public.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogwhistlePolitics</IRI>
    <Literal xml:lang="EN">Deliberately using wording that will, for a targeted community, take on a meaning different from the one perceived by the general public.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogwhistlePolitics</IRI>
    <Literal xml:lang="FR">En parlant de « liberté », je veux dire la liberté de choisir nos produits : la vraie liberté que tout consommateur recherche.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogwhistlePolitics</IRI>
    <Literal xml:lang="EN">Talking about 'freedom', I mean the freedom to choose our products, which is the true freedom every consumer is looking for.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogwhistlePolitics</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Dog-whistle_politics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogwhistlePolitics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogwhistlePolitics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theRaceCard</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theRaceCard</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theRaceCard</IRI>
    <Literal xml:lang="FR">Appel au racisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theRaceCard</IRI>
    <Literal xml:lang="EN">The race card</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theRaceCard</IRI>
    <Literal xml:lang="FR">Vous exploitez l’hostilité de votre auditoire envers un groupe racial ou, à l’inverse, son rejet intransigeant de cette hostilité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theRaceCard</IRI>
    <Literal xml:lang="EN">Trying to exploit racism or anti-racism in order to advance a position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theRaceCard</IRI>
    <Literal xml:lang="FR">Vous remettez en cause mon droit à la nationalité de votre pays parce que vous êtes raciste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theRaceCard</IRI>
    <Literal xml:lang="EN">You are questioning my right to this country's nationality because you are racist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theRaceCard</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Race_card</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogwhistlePolitics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theRaceCard</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#theRaceCard</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dogwhistlePolitics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulgarism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulgarism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulgarism</IRI>
    <Literal xml:lang="FR">Grossièreté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulgarism</IRI>
    <Literal xml:lang="EN">Vulgarism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulgarism</IRI>
    <Literal xml:lang="FR">Vous employez des propos vulgaires pour capter l’attention et provoquer une réaction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulgarism</IRI>
    <Literal xml:lang="EN">Resorting to vulgarism to catch the attention and provoke a reaction from the audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulgarism</IRI>
    <Literal xml:lang="FR">Et que font ces supposés représentants du peuple ? Rien ! Si ça continue, qu’ils aillent au diable !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulgarism</IRI>
    <Literal xml:lang="EN">What are these so-called representatives of the people doing? Nothing! If this continues, let them go to hell!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulgarism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Rudeness</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulgarism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulgarism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nastyEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nastyEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nastyEffect</IRI>
    <Literal xml:lang="FR">Effet vitriol</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nastyEffect</IRI>
    <Literal xml:lang="EN">Nasty effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nastyEffect</IRI>
    <Literal xml:lang="FR">Vous critiquez avec agressivité pour polariser le débat et empêcher une réflexion nuancée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nastyEffect</IRI>
    <Literal xml:lang="EN">Using nasty comments to polarize the debate and discourage nuanced reflection.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nastyEffect</IRI>
    <Literal xml:lang="FR">Préférez-vous faire confiance à cette horde de trolls ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nastyEffect</IRI>
    <Literal xml:lang="EN">Do you prefer trusting a horde of trolls?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nastyEffect</IRI>
    <Literal xml:lang="EN">http://skepdic.com/nastyeffect.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulgarism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nastyEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nastyEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulgarism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#judgementalLanguage</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#judgementalLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#judgementalLanguage</IRI>
    <Literal xml:lang="FR">Langage moralisateur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#judgementalLanguage</IRI>
    <Literal xml:lang="EN">Judgemental language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#judgementalLanguage</IRI>
    <Literal xml:lang="FR">Afin de discréditer une position, vous formulez à son encontre un discours méprisant censé influer sur votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#judgementalLanguage</IRI>
    <Literal xml:lang="EN">In order to discredit a position, you use contemptuous language against it with the aim of influencing your audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#judgementalLanguage</IRI>
    <Literal xml:lang="FR">Refuser d’adopter ces habitudes écoresponsables, n’est-ce pas simplement confirmer son mépris pour l’avenir de nos enfants ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#judgementalLanguage</IRI>
    <Literal xml:lang="EN">Is refusing to adopt these eco-friendly habits not simply confirming one's contempt for our children's future?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#judgementalLanguage</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Judgmental_language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#judgementalLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#judgementalLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="FR">Conjugaison Émotive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="EN">Emotive conjugation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="FR">Vous utilisez des verbes différents pour décrire le même comportement selon que vous approuvez ou non la personne concernée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="EN">Using different verbs to describe the same behavior depending on whether one approves of the person involved or not.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="FR">Je suis persévérant, mais mon adversaire est têtu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="EN">I am persistent, but my opponent is stubborn.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Emotive_conjugation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotiveConjugation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prejudicialLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <Literal xml:lang="FR">Humour</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <Literal xml:lang="EN">Humour</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <Literal xml:lang="FR">Vous recourez à l’humour pour rendre votre argumentation plus sympathique, sans vous appuyer sur des faits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <Literal xml:lang="EN">Using humour to make an argumentation more appealing, without relying on facts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <Literal xml:lang="FR">Je ne suis pas vieux, voyons ! Je suis simplement jeune depuis plus longtemps que vous…</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <Literal xml:lang="EN">I'm not old, come on! I've simply been young longer than you have…</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Humour</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Humour</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
    <Literal xml:lang="FR">Comique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
    <Literal xml:lang="EN">Comic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
    <Literal xml:lang="FR">Pour rendre votre discours plus séduisant, vous y ajoutez des éléments destinés à distraire et à amuser votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
    <Literal xml:lang="EN">Using humor to make a discourse more attractive, punctuating it with elements designed to entertain and amuse the audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
    <Literal xml:lang="FR">Je ne suis pas expert en économie… mais quand je regarde ces chiffres, je me dis que même ma grand-mère ferait mieux !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
    <Literal xml:lang="EN">I'm not an economics expert... but looking at these figures, I think even my grandmother would do a better job!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Comique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#joke</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#joke</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#joke</IRI>
    <Literal xml:lang="FR">Blague</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#joke</IRI>
    <Literal xml:lang="EN">Joke</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#joke</IRI>
    <Literal xml:lang="FR">Vous racontez une histoire drôle pour séduire l’auditoire, sans vous appuyer sur des arguments solides.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#joke</IRI>
    <Literal xml:lang="EN">Using jokes within a speech to charm the audience, without relying on strong arguments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#joke</IRI>
    <Literal xml:lang="FR">Ils m’ont demandé de parler des statistiques économiques, mais j’ai peur que, si je commence, plusieurs personnes s’endorment sur place !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#joke</IRI>
    <Literal xml:lang="EN">They asked me to talk about economic statistics, but I'm afraid that if I start, several people will fall asleep right there!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#joke</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Joke</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#joke</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#joke</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <Literal xml:lang="FR">Absurde</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <Literal xml:lang="EN">Absurd</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <Literal xml:lang="FR">Vous utilisez des situations absurdes pour faire rire, sans tenir compte de la logique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <Literal xml:lang="EN">Using absurd situations to make people laugh, without regard for logic.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <Literal xml:lang="FR">Bien sûr : si vous parlez à vos plantes, elles pousseront plus vite. C’est comme leur donner de l’amour sous forme de CO2 !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <Literal xml:lang="EN">Of course, if you talk to your plants, they'll grow faster. It's like giving them love as CO2!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Surreal_humour</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Humour_absurde</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretentiousAmphigory</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretentiousAmphigory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretentiousAmphigory</IRI>
    <Literal xml:lang="FR">Amphigouri</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretentiousAmphigory</IRI>
    <Literal xml:lang="EN">Pretentious amphigory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretentiousAmphigory</IRI>
    <Literal xml:lang="FR">Vous compliquez délibérément votre discours pour amuser, en évitant un argumentaire solide.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretentiousAmphigory</IRI>
    <Literal xml:lang="EN">You deliberately complicate your discourse for amusement, avoiding a solid argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretentiousAmphigory</IRI>
    <Literal xml:lang="FR">En invoquant l’exégèse transcendantale des états intuitifs, on pourrait approximativement déduire que la vérité est une illusion... Vous me suivez ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretentiousAmphigory</IRI>
    <Literal xml:lang="EN">Invoking the transcendental exegesis of intuitive states, one might deduce that truth is an illusion... Are you following?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretentiousAmphigory</IRI>
    <Literal xml:lang="EN">https://www.thefreedictionary.com/amphigory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretentiousAmphigory</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Amphigouri</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretentiousAmphigory</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pretentiousAmphigory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#burlesque</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#burlesque</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#burlesque</IRI>
    <Literal xml:lang="FR">Burlesque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#burlesque</IRI>
    <Literal xml:lang="EN">Burlesque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#burlesque</IRI>
    <Literal xml:lang="FR">Afin de rendre votre discours plus séduisant, vous employez des termes comiques, familiers et vulgaires pour évoquer des sujets nobles et sérieux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#burlesque</IRI>
    <Literal xml:lang="EN">Using comic, colloquial, and vulgar terms to evoke noble and serious subjects in order to make a speech more appealing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#burlesque</IRI>
    <Literal xml:lang="FR">Notre cher maire, lors de sa dernière intervention, semblait plus soucieux de la couleur de ses chaussettes que de l’avenir de notre ville. Un vrai clown qui mène le spectacle !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#burlesque</IRI>
    <Literal xml:lang="EN">Our dear mayor, during his last speech, seemed more concerned about the color of his socks than the future of our city. A true clown running the show!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#burlesque</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Burlesque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#burlesque</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Burlesque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#burlesque</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#burlesque</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#liarParadox</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#liarParadox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#liarParadox</IRI>
    <Literal xml:lang="FR">Paradoxe du menteur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#liarParadox</IRI>
    <Literal xml:lang="EN">Liar Paradox</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#liarParadox</IRI>
    <Literal xml:lang="FR">Vous troublez votre auditoire en énonçant une proposition qui ne peut être ni tout à fait vraie ni tout à fait fausse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#liarParadox</IRI>
    <Literal xml:lang="EN">Confusing the audience by stating a proposition that can be neither entirely true nor entirely false.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#liarParadox</IRI>
    <Literal xml:lang="FR">Cette phrase est fausse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#liarParadox</IRI>
    <Literal xml:lang="EN">This sentence is false.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#liarParadox</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Liar_paradox</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#liarParadox</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Paradoxe_du_menteur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#liarParadox</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#liarParadox</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bathos</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bathos</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bathos</IRI>
    <Literal xml:lang="FR">Bathos</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bathos</IRI>
    <Literal xml:lang="EN">Bathos</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bathos</IRI>
    <Literal xml:lang="FR">Vous passez brusquement d’un sujet sérieux ou élevé à un sujet trivial ou ridicule, ce qui crée un effet comique ou déconcertant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bathos</IRI>
    <Literal xml:lang="EN">Using an abrupt transition in speech or writing, moving from a serious or lofty subject to a trivial or ludicrous one, creating a comedic or disconcerting effect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bathos</IRI>
    <Literal xml:lang="FR">Notre société se doit de lutter contre les grandes injustices de ce monde, comme la faim et la pauvreté... et n’oubliez pas, la machine à café est toujours en panne.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bathos</IRI>
    <Literal xml:lang="EN">Our society must fight against the great injustices of the world, like hunger and poverty... and don't forget, the coffee machine is still broken.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bathos</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Bathos</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bathos</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Bathos</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bathos</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bathos</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#absurd</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
    <Literal xml:lang="FR">Jeu de mots</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
    <Literal xml:lang="EN">Wordplay</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
    <Literal xml:lang="FR">Pour rendre votre discours plus séduisant, vous jouez sur les mots, notamment sur l’équivoque de leurs sonorités ou de leurs sens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
    <Literal xml:lang="EN">Making a speech more appealing by playing on words, especially on the ambiguity of their sounds or meanings.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
    <Literal xml:lang="FR">Je n’ai jamais perdu un match ; j’ai seulement manqué de temps pour gagner.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
    <Literal xml:lang="EN">I have never lost a game; I just ran out of time to win.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Word_play</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Jeu_de_mots</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#comic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pun</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pun</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pun</IRI>
    <Literal xml:lang="FR">Calembour</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pun</IRI>
    <Literal xml:lang="EN">Pun</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pun</IRI>
    <Literal xml:lang="FR">Pour rendre votre discours plus séduisant, vous jouez sur la polysémie des mots ou sur leur homophonie avec d’autres termes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pun</IRI>
    <Literal xml:lang="EN">Making a speech more appealing by manipulating its terms through their polysemy or homophony with other words.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pun</IRI>
    <Literal xml:lang="FR">Dans le monde de la finance, être « sous l’eau » ne signifie pas qu’on a besoin d’un tuba, mais plutôt d’un bon comptable !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pun</IRI>
    <Literal xml:lang="EN">In the world of finance, being 'underwater' doesn't mean you need a snorkel, but rather a good accountant!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pun</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pun</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pun</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Calembour</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pun</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pun</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
    <Literal xml:lang="FR">Double sens</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
    <Literal xml:lang="EN">Double entendre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
    <Literal xml:lang="FR">Afin de rendre votre discours plus séduisant, vous employez une formule pouvant être comprise de deux façons différentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
    <Literal xml:lang="EN">Making a discourse more appealing by using a formulation that can be understood in two different ways.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
    <Literal xml:lang="FR">Je suis dans le spectacle, alors je peux vous dire que je sais ce que c’est de travailler avec des clowns.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
    <Literal xml:lang="EN">I work in show business, so I can tell you I know what it's like to work with clowns.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Double_entendre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Double_sens_(figure_de_style)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wordplay</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spoonerism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spoonerism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spoonerism</IRI>
    <Literal xml:lang="FR">Contrepèterie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spoonerism</IRI>
    <Literal xml:lang="EN">Spoonerism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spoonerism</IRI>
    <Literal xml:lang="FR">Vous échangez des lettres ou des syllabes pour créer un sens caché, souvent grivois.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spoonerism</IRI>
    <Literal xml:lang="EN">Swapping letters or syllables to create a hidden, often risqué, meaning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spoonerism</IRI>
    <Literal xml:lang="FR">Le général est arrivé à pied par la Chine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spoonerism</IRI>
    <Literal xml:lang="EN">The general arrived “on foot through China”—in French, “à pied par la Chine,” which becomes the risqué “à chier par la pine” when sounds are swapped.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spoonerism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Spoonerism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spoonerism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Contrepèterie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spoonerism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spoonerism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleEntendre</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <Literal xml:lang="FR">Satire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <Literal xml:lang="EN">Satire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <Literal xml:lang="FR">Pour influencer votre auditoire, vous formulez une critique moqueuse du sujet dont il est question.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <Literal xml:lang="EN">Swaying an audience by engaging in mocking criticism of the subject at hand.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <Literal xml:lang="FR">Dans notre société, les smartphones sont devenus si indispensables que, bientôt, on naîtra avec des doigts tactiles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <Literal xml:lang="EN">In our society, smartphones have become so essential that soon, we'll be born with touch-sensitive fingers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Satire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Satire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wit</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wit</IRI>
    <Literal xml:lang="FR">Mot d’esprit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wit</IRI>
    <Literal xml:lang="EN">Wit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wit</IRI>
    <Literal xml:lang="FR">Pour gagner les faveurs de votre auditoire, vous formulez une remarque subtile et ingénieuse, souvent acerbe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wit</IRI>
    <Literal xml:lang="EN">Winning over an audience by making a subtle and ingenious remark, often with a biting implication.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wit</IRI>
    <Literal xml:lang="FR">Vous me demandez de faire un mot d’esprit à votre sujet, mais, Sire, le roi n’est pas un sujet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wit</IRI>
    <Literal xml:lang="EN">You ask me to make a witty remark on your subject, but, Sire, the king is not a subject.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wit</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Wit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wit</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Mot_d%27esprit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wit</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wit</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="FR">Exagération</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="EN">Exaggeration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="FR">Vous accentuez certains aspects de manière démesurée pour renforcer votre argumentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="EN">Exaggerating certain aspects to an unreasonable extent to strengthen an argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="FR">Ce sac à main est si petit que même une fourmi trouverait l’espace limité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="EN">This handbag is so small that even an ant would find the space limited.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Exaggeration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Hyperbole_(rhétorique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#caricature</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#caricature</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#caricature</IRI>
    <Literal xml:lang="FR">Caricature</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#caricature</IRI>
    <Literal xml:lang="EN">Caricature</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#caricature</IRI>
    <Literal xml:lang="FR">Vous amplifiez ou tordiez certaines caractéristiques pour moquer ou critiquer quelque chose ou quelqu’un.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#caricature</IRI>
    <Literal xml:lang="EN">Amplifying or distorting certain characteristics to mock or criticize something or someone.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#caricature</IRI>
    <Literal xml:lang="FR">Le dernier film de ce réalisateur est tellement avant-gardiste qu’il a réussi à tourner la première scène après le générique de fin !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#caricature</IRI>
    <Literal xml:lang="EN">The latest film by this director is so avant-garde that he managed to shoot the first scene after the end credits!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#caricature</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Caricature</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#caricature</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Caricature</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#caricature</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#caricature</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
    <Literal xml:lang="FR">Parodie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
    <Literal xml:lang="EN">Parody</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
    <Literal xml:lang="FR">Vous imitez de façon satirique un discours ou une idée sérieuse pour la tourner en dérision.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
    <Literal xml:lang="EN">Satirically imitating a serious discourse or idea to ridicule it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
    <Literal xml:lang="FR">Votre plan d’économie est exactement comme dans Monopoly : investissez dans les hôtels de la rue de la Paix, et tout ira bien pour l’économie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
    <Literal xml:lang="EN">Your savings plan is exactly like in Monopoly: invest in hotels on Rue de la Paix, and everything will be fine for the economy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Parody</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Parodie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exaggeration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellerism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellerism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellerism</IRI>
    <Literal xml:lang="FR">Wellerisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellerism</IRI>
    <Literal xml:lang="EN">Wellerism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellerism</IRI>
    <Literal xml:lang="FR">Vous détournez des expressions ou des citations de manière humoristique pour enrichir votre discours.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellerism</IRI>
    <Literal xml:lang="EN">Humorously twisting expressions or quotations to enrich a speech.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellerism</IRI>
    <Literal xml:lang="FR">Au pays des aveugles, les borgnes sont rois ; mais dans notre bureau, ils ne trouvent même pas la machine à café.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellerism</IRI>
    <Literal xml:lang="EN">In the land of the blind, the one-eyed man is king, but in our office, they can't even find the coffee machine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellerism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Wellerism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellerism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Wellerisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellerism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wellerism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perverb</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perverb</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perverb</IRI>
    <Literal xml:lang="FR">Antiparémie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perverb</IRI>
    <Literal xml:lang="EN">Perverb</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perverb</IRI>
    <Literal xml:lang="FR">Vous inventez des adages humoristiques pour critiquer quelque chose ou vous en moquer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perverb</IRI>
    <Literal xml:lang="EN">Inventing humorous adages to critique or mock something.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perverb</IRI>
    <Literal xml:lang="FR">Pourquoi faire simple quand on peut faire compliqué ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perverb</IRI>
    <Literal xml:lang="EN">Why make it simple when you can make it complicated?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perverb</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Anti-proverb</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perverb</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Antiparémie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perverb</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perverb</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parody</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
    <Literal xml:lang="FR">Ironie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
    <Literal xml:lang="EN">Irony</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
    <Literal xml:lang="FR">Pour gagner les faveurs de votre auditoire, vous faites comprendre ce que vous pensez en disant le contraire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
    <Literal xml:lang="EN">Expressing one's actual thoughts by stating the contrary in order to gain one's audience's favor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
    <Literal xml:lang="FR">Je rajoute un peu de bazar dans votre chambre ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
    <Literal xml:lang="EN">Shall I add a bit more mess to your room?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Irony</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Ironie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#satire</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#situationalIrony</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#situationalIrony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#situationalIrony</IRI>
    <Literal xml:lang="FR">Ironie du sort</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#situationalIrony</IRI>
    <Literal xml:lang="EN">Situational Irony</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#situationalIrony</IRI>
    <Literal xml:lang="FR">Vous soulignez le contraste entre ce qui était attendu et ce qui se produit réellement afin de mettre en évidence l’absurdité ou la malice d’une situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#situationalIrony</IRI>
    <Literal xml:lang="EN">Highlighting the contrast between expectation and reality to emphasize the absurdity or malice of some situations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#situationalIrony</IRI>
    <Literal xml:lang="FR">Après des années à critiquer les réseaux sociaux, il est devenu célèbre... grâce à une vidéo virale sur Internet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#situationalIrony</IRI>
    <Literal xml:lang="EN">After spending years criticizing social media, he became famous... thanks to a viral video on the internet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#situationalIrony</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Irony#Situational_irony</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#situationalIrony</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Ironie#L.27ironie_situationnelle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#situationalIrony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#situationalIrony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <Literal xml:lang="FR">Ironie socratique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <Literal xml:lang="EN">Socratic Irony</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <Literal xml:lang="FR">Vous feignez de ne pas savoir pour amener l’autre personne à révéler ses présupposés ou ses erreurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <Literal xml:lang="EN">Feigning ignorance in order to lead the other person to reveal their presumptions or errors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <Literal xml:lang="FR">Ah, donc selon vous, investir dans cette technologie obsolète garantira notre avenir ? Intéressant, dites-m’en plus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <Literal xml:lang="EN">Ah, so according to you, investing in this obsolete technology will secure our future? Interesting, tell me more.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Irony#Socratic_irony</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Ironie_socratique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#irony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sarcasm</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sarcasm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sarcasm</IRI>
    <Literal xml:lang="FR">Sarcasme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sarcasm</IRI>
    <Literal xml:lang="EN">Sarcasm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sarcasm</IRI>
    <Literal xml:lang="FR">Vous utilisez une ironie mordante pour ridiculiser ou critiquer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sarcasm</IRI>
    <Literal xml:lang="EN">Using irony in a biting manner to ridicule or criticize.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sarcasm</IRI>
    <Literal xml:lang="FR">J’aimerais bien être d’accord avec vous, mais nous serions deux à avoir tort.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sarcasm</IRI>
    <Literal xml:lang="EN">I would agree with you, but then we'd both be wrong.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sarcasm</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sarcasm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sarcasm</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sarcasme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sarcasm</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sarcasm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadpan</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadpan</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadpan</IRI>
    <Literal xml:lang="FR">Pince-sans-rire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadpan</IRI>
    <Literal xml:lang="EN">Deadpan</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadpan</IRI>
    <Literal xml:lang="FR">Vous dissimulez votre moquerie sous une apparence de sérieux pour critiquer ou amuser.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadpan</IRI>
    <Literal xml:lang="EN">Concealing one's mockery under a guise of seriousness to blame or amuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadpan</IRI>
    <Literal xml:lang="FR">Vous n’avez pas de produits stupéfiants sur vous ? Ne vous inquiétez pas, monsieur l’agent : j’ai tout ce qu’il me faut.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadpan</IRI>
    <Literal xml:lang="EN">Got any drugs on you? Don't worry, officer, I'm fully stocked.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadpan</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Deadpan</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadpan</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pince-sans-rire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadpan</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deadpan</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tongueinCheek</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tongueinCheek</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tongueinCheek</IRI>
    <Literal xml:lang="FR">Second degré</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tongueinCheek</IRI>
    <Literal xml:lang="EN">Tongue-in-Cheek</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tongueinCheek</IRI>
    <Literal xml:lang="FR">Vous faites comprendre subtilement que vos propos sont à prendre de façon non littérale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tongueinCheek</IRI>
    <Literal xml:lang="EN">Subtly making it understood that one's statements are to be taken non-literally.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tongueinCheek</IRI>
    <Literal xml:lang="FR">Oh, je prends toujours les critiques très au sérieux, surtout quand elles viennent de professionnels aussi persuasifs que ma propre mère.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tongueinCheek</IRI>
    <Literal xml:lang="EN">Oh, I always take criticism very seriously, especially when it comes from professionals as persuasive as my own mother.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tongueinCheek</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Tongue-in-cheek</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tongueinCheek</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tongueinCheek</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socraticIrony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
    <Literal xml:lang="FR">Cynisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
    <Literal xml:lang="EN">Cynicism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
    <Literal xml:lang="FR">Vous affichez un mépris effronté des convenances et de l’opinion commune, en exprimant sans ménagement des principes contraires à la morale ou aux normes sociales.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
    <Literal xml:lang="EN">Displaying blatant disdain for norms and public opinion, expressing principles contrary to morality or social standards without restraint.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
    <Literal xml:lang="FR">Pourquoi vouloir changer le monde ? Après tout, la corruption a toujours bien fonctionné pour ceux qui sont au pouvoir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
    <Literal xml:lang="EN">Why bother changing the world? After all, corruption has always worked well for those in power.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cynicism_(contemporary)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Cynisme_(contemporain)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humour</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackComedy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackComedy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackComedy</IRI>
    <Literal xml:lang="FR">Humour noir</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackComedy</IRI>
    <Literal xml:lang="EN">Black comedy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackComedy</IRI>
    <Literal xml:lang="FR">Le ressort comique de votre argumentation vise à faire apparaître votre amertume face à l’absurdité du monde.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackComedy</IRI>
    <Literal xml:lang="EN">Using the comedic device of one's argumentation to reveal one's bitterness toward the world's absurdity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackComedy</IRI>
    <Literal xml:lang="FR">Quand mon père m’a beaucoup battu, il a chaud. Alors je me traîne vers la fenêtre et je la ferme pour qu’il n’attrape pas de courant d’air.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackComedy</IRI>
    <Literal xml:lang="EN">When my father beats me, it gets hot, so I drag myself to the window and close it to make sure he doesn't catch a draft.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackComedy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Black_comedy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackComedy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Humour_noir</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackComedy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#blackComedy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nihilism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nihilism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nihilism</IRI>
    <Literal xml:lang="FR">Nihilisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nihilism</IRI>
    <Literal xml:lang="EN">Nihilism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nihilism</IRI>
    <Literal xml:lang="FR">Vous rejetez les croyances et valeurs établies pour montrer leur manque de fondement dans votre argumentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nihilism</IRI>
    <Literal xml:lang="EN">Rejecting established beliefs and values to demonstrate their lack of substance in one's argumentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nihilism</IRI>
    <Literal xml:lang="FR">Dans un monde doté de fondements moraux, vos arguments m’auraient convaincu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nihilism</IRI>
    <Literal xml:lang="EN">In a world with moral foundations, your arguments would have convinced me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nihilism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Nihilism#Positions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nihilism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Nihilisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nihilism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nihilism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cynicism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <Literal xml:lang="FR">Poésie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <Literal xml:lang="EN">Poetry</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <Literal xml:lang="FR">Vous utilisez des images et un style fleuri pour rendre votre argumentation plus séduisante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <Literal xml:lang="EN">Using imagery and flowery language to make one's argumentation more appealing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <Literal xml:lang="FR">Dans la vallée, où chaque fleur exhale un soupir d’amour, notre candidat est le seul qui, grâce à sa longue expérience, connaisse le secret des mots capables de convaincre l’État de préserver ce morceau de paradis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <Literal xml:lang="EN">In the valley, where every flower breathes a sigh of love, our candidate alone, with his extensive experience, knows the secrets of the words that will convince the state to preserve this piece of paradise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#poetry</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Po%C3%A9sie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rhetoricalDevice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <Literal xml:lang="FR">Jeu de sonorités</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <Literal xml:lang="EN">Sonic device</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <Literal xml:lang="FR">Vous utilisez des allitérations ou des assonances pour rendre votre propos plus séduisant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <Literal xml:lang="EN">Using alliterations or assonances to make one's argumentation more appealing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <Literal xml:lang="FR">Ah, quelle mélodie que celle de ces paroles qui, telles des perles d’eau sur les feuilles du matin, dansent ensemble en harmonie !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <Literal xml:lang="EN">Ah, what a melody those words make, like pearls of dew on morning leaves, dancing together in harmony!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Rhetorical_device#Sonic_devices</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alliteration</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alliteration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alliteration</IRI>
    <Literal xml:lang="FR">Allitération</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alliteration</IRI>
    <Literal xml:lang="EN">Alliteration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alliteration</IRI>
    <Literal xml:lang="FR">Vous répétez un même groupe de consonnes dans des mots qui se suivent afin de rendre votre argumentation plus séduisante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alliteration</IRI>
    <Literal xml:lang="EN">Repeating the same group of consonants in successive words to make one's argumentation more appealing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alliteration</IRI>
    <Literal xml:lang="FR">Pour qui sont ces serpents qui sifflent sur vos têtes ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alliteration</IRI>
    <Literal xml:lang="EN">For whom do these serpents hiss upon your heads?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alliteration</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Alliteration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alliteration</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Allitération</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alliteration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#alliteration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assonance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assonance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assonance</IRI>
    <Literal xml:lang="FR">Assonance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assonance</IRI>
    <Literal xml:lang="EN">Assonance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assonance</IRI>
    <Literal xml:lang="FR">Vous répétez des sons vocaliques similaires afin de rendre votre argumentation plus séduisante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assonance</IRI>
    <Literal xml:lang="EN">Repeating similar vowel sounds to make one's argumentation more appealing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assonance</IRI>
    <Literal xml:lang="FR">Quelqu’un pleure sa douleur, et c’est mon cœur !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assonance</IRI>
    <Literal xml:lang="EN">Someone weeps their sorrow, and it's my heart!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assonance</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Assonance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assonance</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Assonance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assonance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assonance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cacophony</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cacophony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cacophony</IRI>
    <Literal xml:lang="FR">Cacophonie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cacophony</IRI>
    <Literal xml:lang="EN">Cacophony</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cacophony</IRI>
    <Literal xml:lang="FR">Vous créez une dissonance volontaire par des sons répétitifs pour susciter l’intérêt ou le rire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cacophony</IRI>
    <Literal xml:lang="EN">Creating deliberate dissonance with repetitive sounds to intrigue or amuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cacophony</IRI>
    <Literal xml:lang="FR">« Non, il n’est rien que Nanine n’honore » — Voltaire, Nanine, III, 8</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cacophony</IRI>
    <Literal xml:lang="EN">“No, there is nothing that Nanine does not honor” — Voltaire, Nanine, III, 8</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cacophony</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Phonaesthetics#Euphony_and_cacophony</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cacophony</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Cacophonie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cacophony</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cacophony</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onomatopeia</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onomatopeia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onomatopeia</IRI>
    <Literal xml:lang="FR">Onomatopée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onomatopeia</IRI>
    <Literal xml:lang="EN">Onomatopeia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onomatopeia</IRI>
    <Literal xml:lang="FR">Vous utilisez des mots qui imitent des sons réels afin de produire un effet expressif, souvent comique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onomatopeia</IRI>
    <Literal xml:lang="EN">Using words that imitate real sounds to create an expressive, often comedic effect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onomatopeia</IRI>
    <Literal xml:lang="FR">Le tic-tac de l’horloge lui intimait de ne plus perdre de temps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onomatopeia</IRI>
    <Literal xml:lang="EN">The tick-tock of the clock urged him not to waste any more time.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onomatopeia</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Onomatopoeia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onomatopeia</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Onomatopée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onomatopeia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onomatopeia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
    <Literal xml:lang="FR">Métaplasme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
    <Literal xml:lang="EN">Metaplasm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
    <Literal xml:lang="FR">Vous modifiez des mots de façon ludique afin de produire un effet expressif, souvent comique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
    <Literal xml:lang="EN">Playfully altering words to achieve an expressive, often comedic effect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
    <Literal xml:lang="FR">Las, il en a pris pour perpète.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
    <Literal xml:lang="EN">Alas, he got sentenced to perpet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Metaplasm#Rhetoric</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Métaplasme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sonicDevice</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assimilation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assimilation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assimilation</IRI>
    <Literal xml:lang="FR">Assimilation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assimilation</IRI>
    <Literal xml:lang="EN">Assimilation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assimilation</IRI>
    <Literal xml:lang="FR">Vous simplifiez la prononciation de certains mots pour les rendre familiers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assimilation</IRI>
    <Literal xml:lang="EN">Simplifying the pronunciation of certain words to make them more familiar.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assimilation</IRI>
    <Literal xml:lang="FR">Entre nous, c’pas la peine d’faire des chichis, on est tous dans l’même bateau, non ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assimilation</IRI>
    <Literal xml:lang="EN">Just b’tween us, ’s no need t’make a fuss—we’re all in th’same boat, right?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assimilation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Assimilation_(phonology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assimilation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Assimilation_(phonétique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assimilation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#assimilation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaplasm</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <Literal xml:lang="FR">Répétition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <Literal xml:lang="EN">Repetition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <Literal xml:lang="FR">Pour marquer les esprits, vous répétez un même mot ou une même formule dans votre discours.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <Literal xml:lang="EN">Repeating the same word or phrase multiple times in one's speech to make a memorable impact.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <Literal xml:lang="FR">Liberté, égalité, fraternité : ces mots libres, égaux et fraternels sont les fondements de notre nation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <Literal xml:lang="EN">Freedom, equality, fraternity: these free, equal, and fraternal words are the foundations of our nation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
    <Literal xml:lang="FR">Accumulation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
    <Literal xml:lang="EN">Accumulatio</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
    <Literal xml:lang="FR">Vous empilez des mots ou des idées afin de produire un effet d’amplification et de marquer les esprits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
    <Literal xml:lang="EN">Stacking words or ideas to create an amplifying effect, aiming to leave a memorable impression.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
    <Literal xml:lang="FR">Quand on m’aura jeté, vieux flacon désolé, décrépit, poudreux, sale, abject, visqueux, fêlé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
    <Literal xml:lang="EN">When they have thrown me away, a sad old flask, decrepit, dusty, dirty, abject, slimy, cracked.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Accumulatio</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Accumulation_(rhétorique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#enumeratio</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#enumeratio</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#enumeratio</IRI>
    <Literal xml:lang="FR">Énumération</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#enumeratio</IRI>
    <Literal xml:lang="EN">Enumeratio</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#enumeratio</IRI>
    <Literal xml:lang="FR">Afin de marquer les esprits, vous énumérez les différents éléments qui composent une idée d’ensemble.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#enumeratio</IRI>
    <Literal xml:lang="EN">Listing various elements that make up a complete idea, aiming to impress.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#enumeratio</IRI>
    <Literal xml:lang="FR">Elle était vide, claire, profonde, pleine de lumière !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#enumeratio</IRI>
    <Literal xml:lang="EN">It was empty, clear, deep, filled with light!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#enumeratio</IRI>
    <Literal xml:lang="EN">https://7esl.com/rhetorical-devices/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#enumeratio</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Énumération</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#enumeratio</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#enumeratio</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conglobatio</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conglobatio</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conglobatio</IRI>
    <Literal xml:lang="FR">Conglobation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conglobatio</IRI>
    <Literal xml:lang="EN">Conglobatio</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conglobatio</IRI>
    <Literal xml:lang="FR">Afin de convaincre votre auditoire, vous énumérez plusieurs arguments dont l’accumulation est censée prouver la conclusion exposée à la fin de votre développement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conglobatio</IRI>
    <Literal xml:lang="EN">In order to convince your audience, you enumerate several arguments whose accumulation is supposed to prove the conclusion presented at the end of your argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conglobatio</IRI>
    <Literal xml:lang="FR">Le prévenu affirme à la fois qu’il n’avait aucune intention malveillante, qu’il n’était pas présent sur les lieux du crime et qu’il n’a donc pas commis ce crime.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conglobatio</IRI>
    <Literal xml:lang="EN">The defendant asserts both that he had no malicious intent, that he was not present at the crime scene, and that he therefore did not commit this crime.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conglobatio</IRI>
    <Literal xml:lang="EN">https://journals.openedition.org/ces/10232</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conglobatio</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Conglobation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conglobatio</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conglobatio</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#accumulatio</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
    <Literal xml:lang="FR">Anaphore</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
    <Literal xml:lang="EN">Anaphora</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
    <Literal xml:lang="FR">Pour marquer les esprits, vous répétez un même terme ou une même formule au début de plusieurs phrases.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
    <Literal xml:lang="EN">Repeating the same term or phrase at the beginning of several sentences to leave a memorable impression.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
    <Literal xml:lang="FR">« Paris ! Paris outragé ! Paris brisé ! Paris martyrisé ! Mais Paris libéré ! »</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
    <Literal xml:lang="EN">"Paris! Paris outraged! Paris broken! Paris martyred! But Paris liberated!"</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Anaphora_(rhetoric)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Anaphore_(rhétorique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistrophe</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistrophe</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistrophe</IRI>
    <Literal xml:lang="FR">Épiphore</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistrophe</IRI>
    <Literal xml:lang="EN">Epistrophe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistrophe</IRI>
    <Literal xml:lang="FR">Vous terminez vos phrases par les mêmes mots ou sons pour renforcer votre message.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistrophe</IRI>
    <Literal xml:lang="EN">Ending sentences with the same words or sounds to reinforce one's message.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistrophe</IRI>
    <Literal xml:lang="FR">Infiniment, la pluie, la longue pluie, la pluie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistrophe</IRI>
    <Literal xml:lang="EN">Endlessly, the rain, the long rain, The rain.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistrophe</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Epistrophe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistrophe</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Épiphore</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistrophe</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epistrophe</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#symploce</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#symploce</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#symploce</IRI>
    <Literal xml:lang="FR">Symploque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#symploce</IRI>
    <Literal xml:lang="EN">Symploce</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#symploce</IRI>
    <Literal xml:lang="FR">Vous commencez et terminez vos phrases par des répétitions pour marquer l’auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#symploce</IRI>
    <Literal xml:lang="EN">Beginning and concluding sentences with repetitions to make an impact on the audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#symploce</IRI>
    <Literal xml:lang="FR">Qui est l’auteur de cette loi ? Rullus. Qui a privé du suffrage la plus grande partie du peuple romain ? Rullus. Qui a présidé les comices ? Rullus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#symploce</IRI>
    <Literal xml:lang="EN">Who is the author of this law? Rullus. Who deprived the majority of the Roman people of their vote? Rullus. Who presided over the assemblies? Rullus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#symploce</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Symploce</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#symploce</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Symploque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#symploce</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#symploce</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anaphora</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
    <Literal xml:lang="FR">Paronomase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
    <Literal xml:lang="EN">Paronomasia</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
    <Literal xml:lang="FR">Vous utilisez des mots similaires en apparence ou en sonorité pour frapper les esprits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
    <Literal xml:lang="EN">Using words that are similar in appearance or sound to make an impact.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
    <Literal xml:lang="FR">Comparaison n’est pas raison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
    <Literal xml:lang="EN">Comparison is not reasoning.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/paronomasia#English</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Paronymie#Paronomase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adnomination</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adnomination</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adnomination</IRI>
    <Literal xml:lang="FR">Annomination</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adnomination</IRI>
    <Literal xml:lang="EN">Adnomination</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adnomination</IRI>
    <Literal xml:lang="FR">Vous jouez sur les différents sens d’un même mot pour captiver l’attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adnomination</IRI>
    <Literal xml:lang="EN">Playing with different meanings of a word to captivate attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adnomination</IRI>
    <Literal xml:lang="FR">Je vous dis que vous êtes Pierre, et sur cette pierre je bâtirai mon Église.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adnomination</IRI>
    <Literal xml:lang="EN">I tell you that you are Peter, and on this rock I will build my church.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adnomination</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Adnomination</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adnomination</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Annomination</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adnomination</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adnomination</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paronomasia</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
    <Literal xml:lang="FR">Hyperbole</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
    <Literal xml:lang="EN">Hyperbole</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
    <Literal xml:lang="FR">Vous amplifiez un fait à l’excès pour impressionner davantage que pour argumenter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
    <Literal xml:lang="EN">Exaggerating to the extreme to make an impression rather than to argue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
    <Literal xml:lang="FR">Ce colis pèse une tonne !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
    <Literal xml:lang="EN">This package weighs a ton!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hyperbole</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Hyperbole_(rhétorique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adynaton</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adynaton</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adynaton</IRI>
    <Literal xml:lang="FR">Adynaton</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adynaton</IRI>
    <Literal xml:lang="EN">Adynaton</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adynaton</IRI>
    <Literal xml:lang="FR">Vous poussez l’exagération à son paroxysme pour frapper les esprits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adynaton</IRI>
    <Literal xml:lang="EN">Pushing exaggeration to its extreme to make an impact.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adynaton</IRI>
    <Literal xml:lang="FR">On tue un homme : on est un assassin. On en tue des millions : on est un conquérant. On les tue tous : on est un Dieu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adynaton</IRI>
    <Literal xml:lang="EN">Kill one man: you are a murderer. Kill millions: you are a conqueror. Kill them all: you are a God.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adynaton</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Adynaton</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adynaton</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Adynaton</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adynaton</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#adynaton</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#auxesis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#auxesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#auxesis</IRI>
    <Literal xml:lang="FR">Auxèse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#auxesis</IRI>
    <Literal xml:lang="EN">Auxesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#auxesis</IRI>
    <Literal xml:lang="FR">Vous intensifiez progressivement vos exagérations, au point de produire un effet paradoxal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#auxesis</IRI>
    <Literal xml:lang="EN">Gradually intensifying exaggerations to the point of becoming paradoxical.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#auxesis</IRI>
    <Literal xml:lang="FR">Il est génial, fantastique, fabuleux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#auxesis</IRI>
    <Literal xml:lang="EN">He's genius, fantastic, fabulous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#auxesis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Auxesis_(figure_of_speech)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#auxesis</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Auxèse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#auxesis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#auxesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hyperbole</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hendiadys</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hendiadys</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hendiadys</IRI>
    <Literal xml:lang="FR">Hendiadys</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hendiadys</IRI>
    <Literal xml:lang="EN">Hendiadys</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hendiadys</IRI>
    <Literal xml:lang="FR">Vous remplacez le lien logique entre deux idées par un simple « et » afin de créer un effet de style.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hendiadys</IRI>
    <Literal xml:lang="EN">Replacing the logical link between two ideas with a simple 'and' to create a stylistic effect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hendiadys</IRI>
    <Literal xml:lang="FR">J’ai connu cet homme et sa probité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hendiadys</IRI>
    <Literal xml:lang="EN">I knew this man and his integrity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hendiadys</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hendiadys</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hendiadys</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Hendiadys</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hendiadys</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hendiadys</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#repetition</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <Literal xml:lang="FR">Adjonction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <Literal xml:lang="EN">Syllepsis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <Literal xml:lang="FR">Vous ajoutez et reliez plusieurs mots ou idées pour créer un effet de style.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <Literal xml:lang="EN">Adding and linking several words or ideas to create a stylistic effect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <Literal xml:lang="FR">Ce politicien est honnête, dévoué, compétent, travailleur et empathique ; c’est donc le candidat idéal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <Literal xml:lang="EN">This politician is honest, dedicated, competent, hardworking, empathetic, and thus, the ideal candidate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Zeugma_and_syllepsis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <Literal xml:lang="FR">http://www.cosmovisions.com/adjonction.htm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gradatio</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gradatio</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gradatio</IRI>
    <Literal xml:lang="FR">Gradation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gradatio</IRI>
    <Literal xml:lang="EN">Gradatio</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gradatio</IRI>
    <Literal xml:lang="FR">Vous énoncez une série d’éléments en faisant croître leur intensité pour marquer les esprits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gradatio</IRI>
    <Literal xml:lang="EN">List elements in increasing intensity to make a memorable impact.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gradatio</IRI>
    <Literal xml:lang="FR">Je vous aurais suivi, mon frère, mon capitaine, mon roi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gradatio</IRI>
    <Literal xml:lang="EN">I would have followed you, my brother, my captain, my king.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gradatio</IRI>
    <Literal xml:lang="EN">https://www.thoughtco.com/gradatio-rhetoric-term-1690905</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gradatio</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gradation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gradatio</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gradatio</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paraphrase</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paraphrase</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paraphrase</IRI>
    <Literal xml:lang="FR">Paraphrase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paraphrase</IRI>
    <Literal xml:lang="EN">Paraphrase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paraphrase</IRI>
    <Literal xml:lang="FR">Vous reformulez une même idée de plusieurs façons pour en couvrir tous les aspects.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paraphrase</IRI>
    <Literal xml:lang="EN">Explaining the same idea in multiple ways to cover all its aspects.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paraphrase</IRI>
    <Literal xml:lang="FR">Souvent, ma voix parle ; parfois elle chante, parfois elle murmure, parfois elle pleure. Oh, comme chaque intonation reflète un pan de l’univers !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paraphrase</IRI>
    <Literal xml:lang="EN">Often, my voice speaks, but sometimes it sings, sometimes it whispers, sometimes it cries, oh, how each tone reflects a facet of the universe!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paraphrase</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Paraphrase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paraphrase</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Paraphrase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paraphrase</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paraphrase</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oxymoron</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oxymoron</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oxymoron</IRI>
    <Literal xml:lang="FR">Oxymore</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oxymoron</IRI>
    <Literal xml:lang="EN">Oxymoron</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oxymoron</IRI>
    <Literal xml:lang="FR">Vous associez des mots opposés pour créer un effet de contraste ou de surprise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oxymoron</IRI>
    <Literal xml:lang="EN">Pairing opposite words together to create a contrast or surprise effect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oxymoron</IRI>
    <Literal xml:lang="FR">Une obscure clarté illuminait son visage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oxymoron</IRI>
    <Literal xml:lang="EN">An obscure brightness lit her face.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oxymoron</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Oxymoron</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oxymoron</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Oxymore</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oxymoron</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oxymoron</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tautology</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tautology</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tautology</IRI>
    <Literal xml:lang="FR">Tautologie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tautology</IRI>
    <Literal xml:lang="EN">Tautology</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tautology</IRI>
    <Literal xml:lang="FR">Vous répétez la même idée en utilisant différents mots, ce qui ne fournit pas d’argument supplémentaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tautology</IRI>
    <Literal xml:lang="EN">Repeating the same idea using different words, which does not provide an additional argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tautology</IRI>
    <Literal xml:lang="FR">Mais le mal que j’y trouve, c’est que votre père est votre père.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tautology</IRI>
    <Literal xml:lang="EN">But the trouble I find is that your father is your father.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tautology</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Tautology_(language)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tautology</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Tautologie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tautology</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tautology</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#syllepsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <Literal xml:lang="FR">Ellipse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <Literal xml:lang="EN">Ellipsis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <Literal xml:lang="FR">Vous supprimez des mots clés produisant ainsi un effet de raccourci.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <Literal xml:lang="EN">Omitting key words, thereby producing a shortcut effect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <Literal xml:lang="FR">Vous connaissez mon envie, et moi, ce qu’il vous faut.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <Literal xml:lang="EN">You know my desire, and I, what you need.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ellipsis_(linguistics)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Ellipse_(rhétorique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#aposiopesis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#aposiopesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#aposiopesis</IRI>
    <Literal xml:lang="FR">Aposiopèse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#aposiopesis</IRI>
    <Literal xml:lang="EN">Aposiopesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#aposiopesis</IRI>
    <Literal xml:lang="FR">Vous interrompez abruptement ce que vous dites, laissant le reste sous-entendu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#aposiopesis</IRI>
    <Literal xml:lang="EN">Abruptly interrupting what one is saying, leaving the rest implied.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#aposiopesis</IRI>
    <Literal xml:lang="FR">Et alors que je vous révèle, les yeux dans les yeux, l’étendue de… Mais non, laissez-moi plutôt vous emmener là où l’horizon embrasse nos attentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#aposiopesis</IRI>
    <Literal xml:lang="EN">And as I reveal to you, eye to eye, the extent of... No, let me instead take you where the horizon meets our expectations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#aposiopesis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Aposiopesis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#aposiopesis</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L’Encyclopédie/1re_édition/APOSIOPESE</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#aposiopesis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#aposiopesis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiphrasis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiphrasis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiphrasis</IRI>
    <Literal xml:lang="FR">Antiphrase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiphrasis</IRI>
    <Literal xml:lang="EN">Antiphrasis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiphrasis</IRI>
    <Literal xml:lang="FR">Vous employez un mot dans un sens opposé à son sens habituel, souvent par ironie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiphrasis</IRI>
    <Literal xml:lang="EN">Using a word in the opposite of its usual meaning, often through irony.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiphrasis</IRI>
    <Literal xml:lang="FR">Quelle magnifique réalisation que la vôtre ; assurément, elle pourrait même plaire à ceux qui auraient encore le sens du beau.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiphrasis</IRI>
    <Literal xml:lang="EN">What a wonderful piece this is, it could surely even please those who still appreciate beauty.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiphrasis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Antiphrasis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiphrasis</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Antiphrase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiphrasis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiphrasis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#euphemism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#euphemism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#euphemism</IRI>
    <Literal xml:lang="FR">Euphémisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#euphemism</IRI>
    <Literal xml:lang="EN">Euphemism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#euphemism</IRI>
    <Literal xml:lang="FR">Vous adoucissez le langage pour éviter d’offenser ou de choquer, souvent à l’aide de formules atténuantes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#euphemism</IRI>
    <Literal xml:lang="EN">Softening language to avoid offending or startling, often using mitigating expressions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#euphemism</IRI>
    <Literal xml:lang="FR">Votre facture évolue, les tarifs évoluent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#euphemism</IRI>
    <Literal xml:lang="EN">Your bill is evolving, so are our rates.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#euphemism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Euphemism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#euphemism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Euphémisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#euphemism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#euphemism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophasis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophasis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophasis</IRI>
    <Literal xml:lang="FR">Prétérition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophasis</IRI>
    <Literal xml:lang="EN">Apophasis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophasis</IRI>
    <Literal xml:lang="FR">Vous mentionnez un sujet en précisant que vous ne souhaitez pas en parler, attirant ainsi l’attention sur lui.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophasis</IRI>
    <Literal xml:lang="EN">Mentioning a topic by explicitly stating that one does not wish to talk about it, thereby drawing attention to it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophasis</IRI>
    <Literal xml:lang="FR">Ai-je besoin de vous dire l’extrême précarité de la situation ? Je ne parlerai pas de son insolence, encore moins de sa grossièreté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophasis</IRI>
    <Literal xml:lang="EN">Do I need to tell you how extremely precarious the situation is? I will not speak of his insolence, still less of his rudeness.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophasis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Apophasis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophasis</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Prétérition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophasis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#apophasis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSyllepsis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSyllepsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSyllepsis</IRI>
    <Literal xml:lang="FR">Syllepse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSyllepsis</IRI>
    <Literal xml:lang="EN">Semantic syllepsis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSyllepsis</IRI>
    <Literal xml:lang="FR">Vous jouez sur les mots en donnant à un même terme un double sens, littéral et figuré, dans le même contexte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSyllepsis</IRI>
    <Literal xml:lang="EN">Using a single word with a double meaning, literal and figurative, in the same context.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSyllepsis</IRI>
    <Literal xml:lang="FR">La lumière de ce tableau, si crue qu’elle en est presque accueillante, nous laisse entrevoir le génie de l’artiste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSyllepsis</IRI>
    <Literal xml:lang="EN">The painting's light, so raw it's almost inviting, gives us a glimpse into the artist's genius.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSyllepsis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Zeugma_and_syllepsis#Type_4</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSyllepsis</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Syllepse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSyllepsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#semanticSyllepsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeugma</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeugma</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeugma</IRI>
    <Literal xml:lang="FR">Zeugma</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeugma</IRI>
    <Literal xml:lang="EN">Zeugma</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeugma</IRI>
    <Literal xml:lang="FR">Vous mettez en relation des éléments qui ne vont pas naturellement ensemble pour créer un effet surprenant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeugma</IRI>
    <Literal xml:lang="EN">Connecting elements that do not naturally go together to create a surprising effect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeugma</IRI>
    <Literal xml:lang="FR">Il vaut mieux prêter à 15 % qu’à confusion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeugma</IRI>
    <Literal xml:lang="EN">Lending at 15% is preferable to lending to the baffled.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeugma</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Zeugma_and_syllepsis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeugma</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Zeugma_(stylistique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeugma</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#zeugma</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allusion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allusion</IRI>
    <Literal xml:lang="FR">Allusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allusion</IRI>
    <Literal xml:lang="EN">Allusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allusion</IRI>
    <Literal xml:lang="FR">Vous faites référence de façon indirecte à des éléments que votre auditoire est censé reconnaître.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allusion</IRI>
    <Literal xml:lang="EN">Indirectly referencing elements that one's audience is expected to recognize.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allusion</IRI>
    <Literal xml:lang="FR">Certains événements récents, que je n’ai pas besoin de détailler, rappellent combien il est important de rester unis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allusion</IRI>
    <Literal xml:lang="EN">Recent events, which I need not detail, remind us how important it is to stay united.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allusion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Allusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allusion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Allusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antilogy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antilogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antilogy</IRI>
    <Literal xml:lang="FR">Antilogie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antilogy</IRI>
    <Literal xml:lang="EN">Antilogy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antilogy</IRI>
    <Literal xml:lang="FR">Vous tenez des propos qui se contredisent eux-mêmes pour créer un effet rhétorique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antilogy</IRI>
    <Literal xml:lang="EN">Making statements that contradict themselves to create a rhetorical effect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antilogy</IRI>
    <Literal xml:lang="FR">Je ne suis pas superstitieux, ça porte malheur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antilogy</IRI>
    <Literal xml:lang="EN">I'm not superstitious, it's bad luck.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antilogy</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/antilogy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antilogy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Antilogie_(rhétorique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antilogy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antilogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ellipsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <Literal xml:lang="FR">Déplacement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <Literal xml:lang="EN">Rearrangement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <Literal xml:lang="FR">Vous changez volontairement la place habituelle des mots ou des idées pour produire un effet de style.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <Literal xml:lang="EN">Deliberately changing the usual position of words or ideas to produce a stylistic effect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <Literal xml:lang="FR">Écoutez l’appel de ces terres lointaines, où la brise murmure encore le nom des héros disparus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <Literal xml:lang="EN">Hear the call of those distant lands, where the breeze still murmurs the names of the lost heroes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chiasmus</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chiasmus</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chiasmus</IRI>
    <Literal xml:lang="FR">Chiasme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chiasmus</IRI>
    <Literal xml:lang="EN">Chiasmus</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chiasmus</IRI>
    <Literal xml:lang="FR">Vous créez un effet miroir en inversant l’ordre des termes dans deux expressions similaires, afin de marquer les esprits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chiasmus</IRI>
    <Literal xml:lang="EN">Creating a mirror effect by reversing the order of terms in two similar expressions to make a memorable impact.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chiasmus</IRI>
    <Literal xml:lang="FR">En temps de paix, les enfants enterrent leurs parents. En temps de guerre, les parents enterrent leurs enfants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chiasmus</IRI>
    <Literal xml:lang="EN">In times of peace, children bury their parents. In times of war, parents bury their children.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chiasmus</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Chiasmus</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chiasmus</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Chiasme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chiasmus</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chiasmus</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiparastasis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiparastasis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiparastasis</IRI>
    <Literal xml:lang="FR">Antiparastase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiparastasis</IRI>
    <Literal xml:lang="EN">Antiparastasis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiparastasis</IRI>
    <Literal xml:lang="FR">Vous transformez un défaut que l’on vous reproche en mérite, et l’affirmez avec fierté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiparastasis</IRI>
    <Literal xml:lang="EN">Turning a fault for which one is criticized into a merit and asserting it with pride.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiparastasis</IRI>
    <Literal xml:lang="FR">On reproche à ce livre de ne pas dévoiler toutes les énigmes de ce peintre si mystérieux ; c’est au contraire son mérite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiparastasis</IRI>
    <Literal xml:lang="EN">This book is criticized for not revealing all the enigmas of such a mysterious painter; on the contrary, that is its merit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiparastasis</IRI>
    <Literal xml:lang="EN">https://www.ifioque.com/figures-of-speech/trope/antiparastasis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiparastasis</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Antiparastase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiparastasis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antiparastasis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epanorthosis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epanorthosis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epanorthosis</IRI>
    <Literal xml:lang="FR">Épanorthose</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epanorthosis</IRI>
    <Literal xml:lang="EN">Epanorthosis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epanorthosis</IRI>
    <Literal xml:lang="FR">Vous faites semblant de nuancer ou de renforcer votre point de vue pour impressionner votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epanorthosis</IRI>
    <Literal xml:lang="EN">Pretending to qualify or strengthen one's point of view to impress one's audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epanorthosis</IRI>
    <Literal xml:lang="FR">Votre prudence, ou plutôt votre lâcheté, nous a perdus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epanorthosis</IRI>
    <Literal xml:lang="EN">Your caution, or rather your cowardice, has ruined us.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epanorthosis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Epanorthosis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epanorthosis</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Épanorthose</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epanorthosis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#epanorthosis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metalepsis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metalepsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metalepsis</IRI>
    <Literal xml:lang="FR">Métalepse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metalepsis</IRI>
    <Literal xml:lang="EN">Metalepsis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metalepsis</IRI>
    <Literal xml:lang="FR">Vous remplacez une idée par une autre qui lui est liée, comme la cause par la conséquence, pour frapper les esprits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metalepsis</IRI>
    <Literal xml:lang="EN">Replacing one idea with another related to it, such as a cause with its effect, to make a stronger impression.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metalepsis</IRI>
    <Literal xml:lang="FR">Il a perdu sa langue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metalepsis</IRI>
    <Literal xml:lang="EN">He has lost his tongue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metalepsis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Metalepsis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metalepsis</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Métalepse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metalepsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metalepsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#procatalepsis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#procatalepsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#procatalepsis</IRI>
    <Literal xml:lang="FR">Prolepse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#procatalepsis</IRI>
    <Literal xml:lang="EN">Procatalepsis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#procatalepsis</IRI>
    <Literal xml:lang="FR">Vous anticipez une objection pour l’écarter avant qu’elle ne vous soit présentée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#procatalepsis</IRI>
    <Literal xml:lang="EN">Anticipating an objection to dismiss it before it is presented to one.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#procatalepsis</IRI>
    <Literal xml:lang="FR">Nous pourrions en discuter toute la journée mais je ne vais pas entrer dans les détails.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#procatalepsis</IRI>
    <Literal xml:lang="EN">We could discuss this all day, yet I choose not to delve deeper.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#procatalepsis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Procatalepsis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#procatalepsis</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Prolepse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#procatalepsis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#procatalepsis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
    <Literal xml:lang="FR">Périphrase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
    <Literal xml:lang="EN">Periphrasis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
    <Literal xml:lang="FR">Vous remplacez un mot direct par une expression plus longue pour embellir votre discours.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
    <Literal xml:lang="EN">Replacing a direct word with a longer expression to embellish one's speech.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
    <Literal xml:lang="FR">La clarté de la lune en cette nuit, révèle à qui sait voir, l’éclat et la splendeur du firmament en sa robe d’azur étoilé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
    <Literal xml:lang="EN">The moon's clarity tonight reveals, to those who can see, the brilliance and splendor of the firmament in its starry azure robe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Periphrasis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Périphrase</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rearrangement</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumlocution</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumlocution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumlocution</IRI>
    <Literal xml:lang="FR">Circonlocution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumlocution</IRI>
    <Literal xml:lang="EN">Circumlocution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumlocution</IRI>
    <Literal xml:lang="FR">Vous remplacez un mot simple par une longue tournure, de façon à rendre votre propos moins direct et moins clair.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumlocution</IRI>
    <Literal xml:lang="EN">Replacing a simple word with a long turn of phrase to make the point less direct and less clear.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumlocution</IRI>
    <Literal xml:lang="FR">Il est de ces vérités qui, pour être dites, nécessitent des circonvolutions oratoires afin de ne pas froisser les oreilles les plus sensibles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumlocution</IRI>
    <Literal xml:lang="EN">There are truths that, to be told, require rhetorical circumvolutions so as not to offend the most sensitive ears.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumlocution</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Circumlocution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumlocution</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Circonlocution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumlocution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#circumlocution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#periphrasis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <Literal xml:lang="FR">Substitution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <Literal xml:lang="EN">Substitution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <Literal xml:lang="FR">Vous remplacez un mot ou une idée par une autre expression pour produire un effet de style.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <Literal xml:lang="EN">Replacing a word or idea with another expression to produce a stylistic effect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <Literal xml:lang="FR">Seuls des capitaines d’industrie aguerris pourront affronter la tempête qui se lève sur les marchés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <Literal xml:lang="EN">Only battle-hardened captains of industry will be able to navigate the storm that's brewing on the markets.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <Literal xml:lang="EN">https://aflintvisuallanguage2014.wordpress.com/2015/01/27/rhetoric-figures-of-supression/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <Literal xml:lang="FR">https://ug.ambafrance.org/IMG/pdf/les_figures_de_styles.pdf?3116/...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poetry</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaphor</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaphor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaphor</IRI>
    <Literal xml:lang="FR">Métaphore</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaphor</IRI>
    <Literal xml:lang="EN">Metaphor</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaphor</IRI>
    <Literal xml:lang="FR">Vous faites une comparaison détournée pour exprimer une idée de manière plus imagée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaphor</IRI>
    <Literal xml:lang="EN">To use a hidden comparison to express an idea in a more imaginative way.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaphor</IRI>
    <Literal xml:lang="FR">Son regard était un océan profond et mystérieux, dans lequel les marins se noyaient.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaphor</IRI>
    <Literal xml:lang="EN">His gaze was a deep and mysterious ocean in which sailors drowned.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaphor</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Metaphor</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaphor</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Métaphore</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaphor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metaphor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#asteism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#asteism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#asteism</IRI>
    <Literal xml:lang="FR">Astéisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#asteism</IRI>
    <Literal xml:lang="EN">Asteism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#asteism</IRI>
    <Literal xml:lang="FR">Vous louez un discours tout en faisant mine de le blâmer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#asteism</IRI>
    <Literal xml:lang="EN">Subtly complimenting a statement while ostensibly criticizing it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#asteism</IRI>
    <Literal xml:lang="FR">Quelle brillante idée de commencer la réunion à 18 h un vendredi : cela nous donnera certainement tout le temps de discuter en détail.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#asteism</IRI>
    <Literal xml:lang="EN">Starting a meeting at 6 PM on a Friday is such a brilliant idea, it will surely give us plenty of time to discuss everything in detail.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#asteism</IRI>
    <Literal xml:lang="EN">https://www.urbandictionary.com/define.php?term=Backhanded%20Insult</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#asteism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Astéisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#asteism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#asteism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegory</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegory</IRI>
    <Literal xml:lang="FR">Allégorie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegory</IRI>
    <Literal xml:lang="EN">Allegory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegory</IRI>
    <Literal xml:lang="FR">Vous usez d’une image concrète pour évoquer une idée abstraite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegory</IRI>
    <Literal xml:lang="EN">Using concrete imagery to convey an abstract idea.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegory</IRI>
    <Literal xml:lang="FR">Dans cette entreprise, nous plantons de jeunes pousses pour cultiver des succès, arrosons-les de labeur pour récolter les performances.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegory</IRI>
    <Literal xml:lang="EN">In this company, we plant young shoots to cultivate success, watering them with hard work to harvest performance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegory</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Allegory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegory</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Allégorie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegory</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#allegory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#litotes</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#litotes</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#litotes</IRI>
    <Literal xml:lang="FR">Litote</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#litotes</IRI>
    <Literal xml:lang="EN">Litotes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#litotes</IRI>
    <Literal xml:lang="FR">Vous affirmez quelque chose de manière atténuée pour laisser sous-entendre l’opposé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#litotes</IRI>
    <Literal xml:lang="EN">Making an understatement to imply the opposite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#litotes</IRI>
    <Literal xml:lang="FR">Après des années de service, notre collègue décida de prendre un repos bien mérité au grand jardin des personnes au travail suspendu.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#litotes</IRI>
    <Literal xml:lang="EN">After years of service, our colleague decided to take a well-deserved break in the great garden of paused work.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#litotes</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Litotes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#litotes</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Litote</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#litotes</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#litotes</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="FR">Métonymie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="EN">Metonymy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="FR">Vous remplacez une idée par une autre qui lui est conceptuellement liée, sans que cela soit clairement justifié.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="EN">Replacing an idea with another conceptually related one, without clear justification.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="FR">Avec le nombre de stylos que cette entreprise distribue, ils écrivent clairement leur succès.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="EN">With the number of pens this company distributes, they are clearly writing their success.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Metonymy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Métonymie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#synecdoche</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#synecdoche</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#synecdoche</IRI>
    <Literal xml:lang="FR">Synecdoque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#synecdoche</IRI>
    <Literal xml:lang="EN">Synecdoche</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#synecdoche</IRI>
    <Literal xml:lang="FR">Vous remplacez un terme par un autre étroitement lié afin de déformer ou mettre l’accent sur un aspect de votre discours.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#synecdoche</IRI>
    <Literal xml:lang="EN">Replacing a term with another closely related one to distort or emphasize an aspect of one's speech.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#synecdoche</IRI>
    <Literal xml:lang="FR">Respectez ses cheveux blancs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#synecdoche</IRI>
    <Literal xml:lang="EN">Respect his white hair.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#synecdoche</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Synecdoche</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#synecdoche</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Synecdoque</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#synecdoche</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#synecdoche</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#metonymy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="FR">Digression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="EN">Digression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="FR">Vous déviez du sujet principal pour introduire un thème secondaire détournant ainsi l’attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="EN">Deviating from the main subject to introduce a secondary theme thus diverting attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="FR">Avant de parler de l’impact de cette réforme sur les petites entreprises, permettez-moi de rappeler en quelques points clés combien il est essentiel de soutenir l’éducation dans notre pays.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="EN">Before discussing the impact of this reform on small businesses, let me remind you in a few key points how essential it is to support education in our country.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Digression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Digression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#substitution</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parembole</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parembole</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parembole</IRI>
    <Literal xml:lang="FR">Parembole</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parembole</IRI>
    <Literal xml:lang="EN">Parembole</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parembole</IRI>
    <Literal xml:lang="FR">Vous insérez un commentaire personnel qui détourne le discours de son objet principal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parembole</IRI>
    <Literal xml:lang="EN">Inserting a personal comment that diverts the discourse from its main subject.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parembole</IRI>
    <Literal xml:lang="FR">Entre nous, et sans vouloir m’avancer trop, il me semble que l’issue de ce projet n’est pas tout à fait assurée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parembole</IRI>
    <Literal xml:lang="EN">Between us, and not to speak too soon, it seems to me that the outcome of this project isn't entirely certain.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parembole</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/parembole#English</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parembole</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Parembole</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parembole</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#parembole</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#digression</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
    <Literal xml:lang="FR">Appel à l’émotion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
    <Literal xml:lang="EN">Appeal to emotion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
    <Literal xml:lang="FR">Vous suscitez de fortes émotions pour détourner votre auditoire d’une réflexion rationnelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
    <Literal xml:lang="EN">Stirring strong emotions to divert an audience from rational reflection.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
    <Literal xml:lang="FR">Si vous avez de bonnes notes, votre père sera très fier de vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
    <Literal xml:lang="EN">If you get good grades, your father will be very proud of you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_emotion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <Literal xml:lang="FR">Connivence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <Literal xml:lang="EN">Connivance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <Literal xml:lang="FR">Vous créez une alliance émotionnelle avec votre auditoire pour infléchir son jugement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <Literal xml:lang="EN">Creating an emotional bond with an audience to win it's support.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <Literal xml:lang="FR">En tant que parents, nous comprenons l’importance de protéger nos enfants, n’est-ce pas ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <Literal xml:lang="EN">As parents, we understand the importance of protecting our children, don't we?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Connivance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <Literal xml:lang="FR">https://fr.wiktionary.org/wiki/connivence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#PositiveConsequences_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="FR">Appel à la conviction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="EN">Appeal to confidence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="FR">Vous présentez une affirmation comme vraie simplement parce qu’une personne y croit avec assurance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="EN">Assuming a statement is true based solely on someone's strong belief in it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="FR">Ce produit va révolutionner votre quotidien, je vous assure que vous ne pourrez plus vous en passer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="EN">This product will revolutionize your daily life, I assure you that you won't be able to live without it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_confidence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="FR">Effet de halo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="EN">Halo effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="FR">Vous étendez sans fondement une première bonne impression, liée à un aspect, à tout le reste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="EN">Extending a positive impression about one specific aspect of an entity to the whole entity, in any of its dimension.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="FR">Avez-vous vu comme il est beau quand il parle ? Quelle classe, quelle éloquence. On boirait ses paroles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="EN">Did you see how great he speaks? Such class, such eloquence. You could hang on his every word.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Halo_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_de_halo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#haloEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConfidence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <Literal xml:lang="FR">Appel au désir</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <Literal xml:lang="EN">Appeal to desire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <Literal xml:lang="FR">Votre argumentation repose sur un souhait ou un désir de votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <Literal xml:lang="EN">Tapping into an audience's desires to influence them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <Literal xml:lang="FR">Bien sûr que votre ville mérite l’organisation des Jeux olympiques : imaginez simplement l’enthousiasme et l’énergie que cela apporterait à tous vos concitoyens !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <Literal xml:lang="EN">Of course your city deserves to host the Olympic Games, just imagine the excitement and energy it would bring to all its citizens!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <Literal xml:lang="EN">http://www.cogsci.rpi.edu/~heuveb/teaching/CriticalThinking/Web/Presentations/EmotionalAppeals.pdf#page=6</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wishfulThinking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wishfulThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wishfulThinking</IRI>
    <Literal xml:lang="FR">Vœu pieux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wishfulThinking</IRI>
    <Literal xml:lang="EN">Wishful thinking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wishfulThinking</IRI>
    <Literal xml:lang="FR">Vous tenez une idée pour vraie uniquement parce que vous aimeriez qu’elle le soit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wishfulThinking</IRI>
    <Literal xml:lang="EN">Deciding a concept is true simply because it's desirable, regardless of the evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wishfulThinking</IRI>
    <Literal xml:lang="FR">Je suis convaincu que mon dispositif de téléportation fonctionnera un jour. Après tout, il faut croire en l’avenir !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wishfulThinking</IRI>
    <Literal xml:lang="EN">I'm convinced that my teleportation device will work one day. After all, one must believe in the future!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wishfulThinking</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Wishful_thinking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wishfulThinking</IRI>
    <Literal xml:lang="FR">https://fr.wiktionary.org/wiki/v%C5%93u_pieux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wishfulThinking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wishfulThinking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
    <Literal xml:lang="FR">Appel aux généralités flatteuses</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
    <Literal xml:lang="EN">Glittering generality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
    <Literal xml:lang="FR">Pour convaincre votre auditoire, vous vous appuyez sur des concepts consensuels et valorisants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
    <Literal xml:lang="EN">Relying on consensual and flattering concepts to persuade an audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
    <Literal xml:lang="FR">Cet homme politique ne parle que de paix, d’amour et de démocratie ; il doit donc forcément être digne de notre confiance et de nos votes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
    <Literal xml:lang="EN">This politician speaks only of peace, love, and democracy, so he surely must deserve our trust and our votes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Glittering_generality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hardworkingFamilies</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hardworkingFamilies</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hardworkingFamilies</IRI>
    <Literal xml:lang="FR">Appel à « la France qui se lève tôt »</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hardworkingFamilies</IRI>
    <Literal xml:lang="EN">Hardworking families</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hardworkingFamilies</IRI>
    <Literal xml:lang="FR">Vous utilisez la valeur du travail pour légitimer une idée, en ciblant une classe sociale précise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hardworkingFamilies</IRI>
    <Literal xml:lang="EN">Using the value of work to legitimize an idea while targeting a specific social class.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hardworkingFamilies</IRI>
    <Literal xml:lang="FR">En tant que personnes qui se lèvent tôt et se donnent à fond dans leur travail, vous méritez notre écoute plus que quiconque.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hardworkingFamilies</IRI>
    <Literal xml:lang="EN">As hardworking people who rise early and give their all, you deserve to be listened to more than anyone else.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hardworkingFamilies</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hardworking_families</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hardworkingFamilies</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hardworkingFamilies</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="FR">Appel à la pseudo-profondeur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="EN">Deepity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="FR">Vous utilisez des affirmations vagues qui paraissent profondes pour impressionner, sans véritable fondement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="EN">Using vague statements that seem profound to impress, without any real foundation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="FR">Notre produit n’est pas juste une simple nouveauté, il est l’une des clefs pour améliorer l’avenir de notre planète.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="EN">Our product is not just a mere novelty; it's one of the keys to improving the future of our planet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Deepity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#deepity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#glitteringGenerality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
    <Literal xml:lang="FR">Piège émotionnel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
    <Literal xml:lang="EN">Emotional capture</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
    <Literal xml:lang="FR">Vous évoquez un élément qui suscite une forte émotion afin de faire accepter ensuite votre argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
    <Literal xml:lang="EN">Evoking a powerfully emotional element in order to later have one's argument accepted.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
    <Literal xml:lang="FR">Regardez ce pauvre ourson polaire sur la banquise fondante ; comment pouvez-vous encore dire que le changement climatique n’est pas notre problème le plus urgent ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
    <Literal xml:lang="EN">Look at this poor polar bear on the melting ice cap; how can you say then that climate change isn't our most urgent problem?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argumentum_ad_captandum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demagoguery</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demagoguery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demagoguery</IRI>
    <Literal xml:lang="FR">Démagogie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demagoguery</IRI>
    <Literal xml:lang="EN">Demagoguery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demagoguery</IRI>
    <Literal xml:lang="FR">Vous privilégiez les passions populaires au détriment de la réflexion pour obtenir du soutien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demagoguery</IRI>
    <Literal xml:lang="EN">Prioritizing popular passions over reflection in order to gain support.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demagoguery</IRI>
    <Literal xml:lang="FR">Mes chers compatriotes, je rendrai notre nation à nouveau grande : chaque famille pourra vivre notre rêve de réussite, sans obstacles ni limites !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demagoguery</IRI>
    <Literal xml:lang="EN">My fellow citizens, I will make our nation great again, where every family can truly live the dream of success without any barriers or limitations!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demagoguery</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Demagogue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demagoguery</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Démagogie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demagoguery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demagoguery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breadAndCircuses</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breadAndCircuses</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breadAndCircuses</IRI>
    <Literal xml:lang="FR">Appel au pain et aux jeux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breadAndCircuses</IRI>
    <Literal xml:lang="EN">Bread and circuses</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breadAndCircuses</IRI>
    <Literal xml:lang="FR">Vous détournez l’attention des problèmes réels en proposant des distractions et des plaisirs simples.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breadAndCircuses</IRI>
    <Literal xml:lang="EN">Distracting from real issues by providing entertainments and simple pleasures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breadAndCircuses</IRI>
    <Literal xml:lang="FR">Ignorez les critiques contre notre culture populaire ; qui a besoin de politique quand la nouvelle saison de notre série préférée vient de sortir ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breadAndCircuses</IRI>
    <Literal xml:lang="EN">Forget the criticism against our pop culture; who needs politics when the new season of our favorite show is out?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breadAndCircuses</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Bread_and_circuses</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breadAndCircuses</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Panem_et_circenses</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breadAndCircuses</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#breadAndCircuses</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fastfoodChristianity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fastfoodChristianity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fastfoodChristianity</IRI>
    <Literal xml:lang="FR">Fast-food théologique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fastfoodChristianity</IRI>
    <Literal xml:lang="EN">Fast-food Christianity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fastfoodChristianity</IRI>
    <Literal xml:lang="FR">Vous simplifiez des concepts religieux complexes pour les rendre faciles à consommer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fastfoodChristianity</IRI>
    <Literal xml:lang="EN">You simplify complex religious concepts to make them easy to consume.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fastfoodChristianity</IRI>
    <Literal xml:lang="FR">Joignez-vous à notre mouvement : la bienveillance et la générosité guident nos actions quotidiennes, et la parole de Dieu devient un grand spectacle de chants et de louanges à ne pas manquer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fastfoodChristianity</IRI>
    <Literal xml:lang="EN">Join our movement: kindness and generosity guide our daily actions, and God's word becomes a grand spectacle of songs and praise not to be missed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fastfoodChristianity</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Fast-food_Christianity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fastfoodChristianity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fastfoodChristianity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalCapture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pandering</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pandering</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pandering</IRI>
    <Literal xml:lang="FR">Discours démagogique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pandering</IRI>
    <Literal xml:lang="EN">Pandering</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pandering</IRI>
    <Literal xml:lang="FR">Vous dites exactement à votre auditoire ce qu’il veut entendre afin d’obtenir son approbation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pandering</IRI>
    <Literal xml:lang="EN">Telling an audience what it wants to hear in order to win its support.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pandering</IRI>
    <Literal xml:lang="FR">Vous dites que vous en avez assez du cynisme ambiant et que vous voulez vivre dans un monde meilleur, n’est-ce pas ? Eh bien, soutenez notre plan de développement, et vous verrez !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pandering</IRI>
    <Literal xml:lang="EN">You all say you're tired of the prevailing cynicism and want to live in a better world, right? Well, support our development plan and you'll see!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pandering</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pandering_(politics)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pandering</IRI>
    <Literal xml:lang="FR">http://www.linternaute.com/expression/langue-francaise/19094/servir-la-soupe/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pandering</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pandering</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDesire</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <Literal xml:lang="FR">Flatterie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <Literal xml:lang="EN">Flattery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <Literal xml:lang="FR">Vous faites l’éloge de votre auditoire afin de le rallier à votre cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <Literal xml:lang="EN">Using praise or ego-boosting implications to seduce the audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <Literal xml:lang="FR">Une femme aussi intelligente que vous ne peut qu’accepter cette proposition exceptionnelle !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <Literal xml:lang="EN">A woman as intelligent as you can only accept this exceptional proposal!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_flattery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Appel_%C3%A0_la_flatterie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGoodwill</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGoodwill</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGoodwill</IRI>
    <Literal xml:lang="FR">Appel à la bienveillance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGoodwill</IRI>
    <Literal xml:lang="EN">Appeal to goodwill</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGoodwill</IRI>
    <Literal xml:lang="FR">Vous demandez à votre auditoire de se montrer indulgent et compréhensif dès le début, pour le rendre favorable à vos idées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGoodwill</IRI>
    <Literal xml:lang="EN">Using a rhetorical technique aimed to capture the goodwill of an audience at the beginning of a speech or appeal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGoodwill</IRI>
    <Literal xml:lang="FR">Ma chère assemblée, nous partageons tous le désir de bâtir un avenir fondé sur le respect et l’harmonie, où la parole de chacun sera accueillie avec attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGoodwill</IRI>
    <Literal xml:lang="EN">My dear assembly, we all share the desire to build a future founded on respect and harmony, where everyone's words will be received with attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGoodwill</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Captatio_benevolentiae</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGoodwill</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGoodwill</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoralElevation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoralElevation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoralElevation</IRI>
    <Literal xml:lang="FR">Appel à l’élévation morale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoralElevation</IRI>
    <Literal xml:lang="EN">Appeal to moral elevation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoralElevation</IRI>
    <Literal xml:lang="FR">Vous suggérez que soutenir votre point de vue fait de quelqu’un une personne de valeur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoralElevation</IRI>
    <Literal xml:lang="EN">Suggesting that supporting one's point of view makes someone a person of worth.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoralElevation</IRI>
    <Literal xml:lang="FR">Je n’irai pas plus loin dans cette campagne tant elle est insultante pour tout le monde.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoralElevation</IRI>
    <Literal xml:lang="EN">I will go no further in this campaign, it is so insulting to everyone.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoralElevation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Moral_high_ground#Everyday_use</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoralElevation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoralElevation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="FR">Appel à la minorité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="EN">Appeal to minority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="FR">Vous prétendez qu’une opinion minoritaire est juste, sous prétexte qu’elle est peu répandue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="EN">Claiming that an assertion is true because it goes against the opinion of the majority.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="FR">Pourquoi lire ces messages en chaîne ennuyeux que tout le monde lit ? Vous savez que vous valez mieux que cela.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="EN">Why read those boring chain messages that everyone reads? You know you're better than that.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_the_minority</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <Literal xml:lang="FR">http://www.fallacydetective.com/news/read/snob-appeal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoralElevation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMoralElevation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivityAppeal</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivityAppeal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivityAppeal</IRI>
    <Literal xml:lang="FR">Appel au sentiment d’exclusivité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivityAppeal</IRI>
    <Literal xml:lang="EN">Exclusivity appeal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivityAppeal</IRI>
    <Literal xml:lang="FR">Vous flattez votre interlocuteur en lui faisant croire qu’il est personnellement privilégié ou qu’il appartient à un petit groupe bénéficiant d’avantages particuliers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivityAppeal</IRI>
    <Literal xml:lang="EN">Flattering an interlocutor by making them believe they are personally privileged or part of a small group with special benefits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivityAppeal</IRI>
    <Literal xml:lang="FR">En tant que membre de notre programme exclusif, vous aurez accès à des offres que le reste du public ne pourra même pas imaginer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivityAppeal</IRI>
    <Literal xml:lang="EN">As a member of our exclusive program, you will have access to offers that the general public can't even imagine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivityAppeal</IRI>
    <Literal xml:lang="EN">https://www.fastcompany.com/3032675/5-psychological-tactics-marketers-use-to-influence-consumer-behavior</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivityAppeal</IRI>
    <Literal xml:lang="FR">http://www.cogsci.rpi.edu/~heuveb/teaching/CriticalThinking/Web/Presentations/EmotionalAppeals.pdf#page=17</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivityAppeal</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exclusivityAppeal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMinority</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPride</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPride</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPride</IRI>
    <Literal xml:lang="FR">Appel à la fierté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPride</IRI>
    <Literal xml:lang="EN">Appeal to pride</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPride</IRI>
    <Literal xml:lang="FR">Vous encouragez votre interlocuteur à se sentir fier d’adhérer à vos propositions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPride</IRI>
    <Literal xml:lang="EN">Encouraging an interlocutor to feel proud of adhering to one's propositions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPride</IRI>
    <Literal xml:lang="FR">Vous avez fait preuve d’une intelligence remarquable en soutenant notre projet, et cela honore toute notre communauté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPride</IRI>
    <Literal xml:lang="EN">You have shown remarkable intelligence by supporting our project, and that honors our entire community.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPride</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_shame#Appeal_to_pride</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPride</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPride</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flattery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
    <Literal xml:lang="FR">Appel à la pitié</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
    <Literal xml:lang="EN">Appeal to Pity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
    <Literal xml:lang="FR">Vous faites appel à la compassion de votre auditoire pour gagner son soutien sans argumenter sur le fond.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
    <Literal xml:lang="EN">Invoking an audience's sympathy to win support without arguing the merits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
    <Literal xml:lang="FR">Mesdames et messieurs les jurés, regardez cet homme misérable, en fauteuil roulant, incapable d’utiliser ses jambes. Un tel homme peut-il vraiment être coupable de détournement de fonds ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
    <Literal xml:lang="EN">Ladies and gentlemen of the jury, look at this miserable man, in a wheelchair, unable to use his legs. Can such a man really be guilty of embezzlement?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_pity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_misericordiam</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#connivance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thinkOfTheChildren</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thinkOfTheChildren</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thinkOfTheChildren</IRI>
    <Literal xml:lang="FR">Appel aux têtes blondes</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thinkOfTheChildren</IRI>
    <Literal xml:lang="EN">Think of the children</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thinkOfTheChildren</IRI>
    <Literal xml:lang="FR">Vous utilisez le bien-être des enfants comme argument pour éveiller les émotions et esquiver le débat rationnel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thinkOfTheChildren</IRI>
    <Literal xml:lang="EN">Appealing to children's need for protection in order to substitute emotion for reason in a debate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thinkOfTheChildren</IRI>
    <Literal xml:lang="FR">Si vous votez contre cette loi, pensez au message désastreux que cela enverra à nos enfants sur l’importance de l’éducation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thinkOfTheChildren</IRI>
    <Literal xml:lang="EN">If you vote against this law, think of the disastrous message it will send to our children about the importance of education.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thinkOfTheChildren</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Think_of_the_children</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thinkOfTheChildren</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thinkOfTheChildren</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdMartyrdom</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdMartyrdom</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdMartyrdom</IRI>
    <Literal xml:lang="FR">Appel au martyr</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdMartyrdom</IRI>
    <Literal xml:lang="EN">Argumentum ad martyrdom</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdMartyrdom</IRI>
    <Literal xml:lang="FR">Vous affirmez qu’une croyance est vraie parce que son défenseur est persécuté ou parce que des martyrs sont morts pour elle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdMartyrdom</IRI>
    <Literal xml:lang="EN">Asserting that a belief is true because its advocate has been persecuted or martyrs have died for it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdMartyrdom</IRI>
    <Literal xml:lang="FR">Ce militant, après tant d’années de lutte acharnée et de persécutions, qui a tout donné pour vous, ne peut être que sincère dans son engagement pour la cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdMartyrdom</IRI>
    <Literal xml:lang="EN">This activist, after so many years of fierce struggle and persecution, who has given everything for you, must be sincere in his commitment to the cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdMartyrdom</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Argumentum_ad_martyrdom</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdMartyrdom</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#argumentumAdMartyrdom</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToPity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <Literal xml:lang="FR">Repoussoir</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <Literal xml:lang="EN">Foil</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <Literal xml:lang="FR">Vous discréditez une idée en la rendant repoussante, au lieu de l’examiner rationnellement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <Literal xml:lang="EN">Showing an idea in a repulsive light instead of rationally arguing against it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <Literal xml:lang="FR">Les collapsologues veulent nous ramener à l’âge de pierre et abolir toute industrie. — Repoussoir : caricature volontairement excessive d’un mouvement réel pour rendre sa réfutation plus facile et plus applaudie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <Literal xml:lang="EN">Collapsologists want to take us back to the Stone Age and abolish all industry. — Foil: a deliberately exaggerated caricature of a real movement, making it easier and more popular to refute.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <Literal xml:lang="FR">https://fr.wiktionary.org/wiki/repoussoir</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#NegativeConsequences_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <Literal xml:lang="FR">Appel au mépris</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <Literal xml:lang="EN">Appeal to spite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <Literal xml:lang="FR">Vous présentez un élément de sorte qu’il paraisse condamnable, indigne d’attention ou indigne d’estime.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <Literal xml:lang="EN">You present something in such a way that it appears reprehensible, unworthy of attention, or unworthy of esteem.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <Literal xml:lang="FR">Mon fils, vous ne ferez pas vos études en faculté de lettres, ce ramassis notoire de paresseux et de névrosés !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <Literal xml:lang="EN">My son, you won't study in the college of Arts, a notorious gathering of lazy and neurotic folks!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_spite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_odium</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
    <Literal xml:lang="FR">Appel au ridicule</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
    <Literal xml:lang="EN">Appeal to mockery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
    <Literal xml:lang="FR">Vous tournez en dérision la proposition de votre adversaire afin de la discréditer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
    <Literal xml:lang="EN">Presenting an opponent's argument as absurd, ridiculous, or humorous, and therefore not worth consideration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
    <Literal xml:lang="FR">Vous, le nouveau, ne pensez même pas à gagner le match de vendredi. Vous venez d’arriver : regardez et apprenez, vous n’avez pas ce qu’il faut.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
    <Literal xml:lang="EN">You, the new guy, don't even think about winning the Friday match. You've just arrived, watch and learn, you don't have what it takes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_ridicule</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Appel_au_ridicule</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disdain</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disdain</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disdain</IRI>
    <Literal xml:lang="FR">Appel au dédain</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disdain</IRI>
    <Literal xml:lang="EN">Disdain</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disdain</IRI>
    <Literal xml:lang="FR">Vous déclarez que la proposition de votre adversaire ne vaut pas la peine d’être prise en considération.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disdain</IRI>
    <Literal xml:lang="EN">Declaring that an opponent's proposition is not worth taking into consideration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disdain</IRI>
    <Literal xml:lang="FR">Les théories de Charles Darwin ne sont jamais que des rêveries sans danger d’un homme faisant la sieste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disdain</IRI>
    <Literal xml:lang="EN">Charles Darwin's theories are but the harmless dreams of a man napping.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disdain</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pooh-pooh</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disdain</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disdain</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToMockery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToShame</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToShame</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToShame</IRI>
    <Literal xml:lang="FR">Appel à la honte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToShame</IRI>
    <Literal xml:lang="EN">Appeal to shame</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToShame</IRI>
    <Literal xml:lang="FR">Vous tentez de discréditer votre adversaire en affirmant que sa proposition est si indigne de lui qu’il devrait en éprouver de l’embarras et s’attendre à une réprobation générale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToShame</IRI>
    <Literal xml:lang="EN">Attempting to discredit an opponent by declaring that their proposition is so unworthy of them that they should feel embarrassed and expect general disapproval.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToShame</IRI>
    <Literal xml:lang="FR">Vous n’avez pas honte de tenir cette opinion ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToShame</IRI>
    <Literal xml:lang="EN">Aren't you ashamed for having that opinion?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToShame</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_shame</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToShame</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToShame</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDisgust</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDisgust</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDisgust</IRI>
    <Literal xml:lang="FR">Appel au dégoût</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDisgust</IRI>
    <Literal xml:lang="EN">Appeal to disgust</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDisgust</IRI>
    <Literal xml:lang="FR">Vous tentez de discréditer votre adversaire en affirmant que sa proposition, par son caractère immoral ou immonde, provoque un sentiment d’aversion ou d’hostilité profonde.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDisgust</IRI>
    <Literal xml:lang="EN">Attempting to discredit an opponent by declaring that their proposition provokes, through its immoral or revolting character, a feeling of aversion and deep hostility.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDisgust</IRI>
    <Literal xml:lang="FR">Ne prenez même pas la peine de goûter à ce plat ; rien qu’à son odeur, on sait que c’est du poison !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDisgust</IRI>
    <Literal xml:lang="EN">Don't even bother tasting that dish; just from its smell, you can tell it's poison!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDisgust</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Argumentum_ad_fastidium</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDisgust</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDisgust</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSpite</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#yuckFactor</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#yuckFactor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#yuckFactor</IRI>
    <Literal xml:lang="FR">Facteur beurk</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#yuckFactor</IRI>
    <Literal xml:lang="EN">Yuck Factor</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#yuckFactor</IRI>
    <Literal xml:lang="FR">Vous dites qu’une idée est mauvaise seulement parce qu’elle vous déplaît ou vous dégoûte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#yuckFactor</IRI>
    <Literal xml:lang="EN">Arguing that an intuitive negative response to some thing, idea, or practice is evidence for the intrinsically wrong character of that thing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#yuckFactor</IRI>
    <Literal xml:lang="FR">Les OGM, c’est jouer aux apprentis sorciers. Voulez-vous vraiment manger des tomates au goût de poisson ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#yuckFactor</IRI>
    <Literal xml:lang="EN">GMOs are like playing god. Do you really want to eat tomatoes that taste like fish?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#yuckFactor</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Wisdom_of_repugnance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDisgust</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#yuckFactor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#yuckFactor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToDisgust</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
    <Literal xml:lang="FR">Preuve par le courroux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
    <Literal xml:lang="EN">Proof by anger</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
    <Literal xml:lang="FR">Vous partez du principe que le fait d’avancer un argument sous le coup de la colère en prouve la validité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
    <Literal xml:lang="EN">Assuming that presenting an argument in anger proves its validity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
    <Literal xml:lang="FR">Vous en avez marre d’être ignoré par votre gouvernement ? Est-il bien normal que 1% détienne tant quand le reste détient si peu. Votez pour moi !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
    <Literal xml:lang="EN">Are you tired of being ignored by your government? Is it really normal for the 1% to hold so much while the rest hold so little? Vote for me!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/20/Appeal-to-Anger</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIndignation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIndignation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIndignation</IRI>
    <Literal xml:lang="FR">Appel à l’indignation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIndignation</IRI>
    <Literal xml:lang="EN">Appeal to indignation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIndignation</IRI>
    <Literal xml:lang="FR">Afin de discréditer la thèse adverse, vous suscitez à son encontre la colère de votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIndignation</IRI>
    <Literal xml:lang="EN">Arousing an audience's anger against the opposing thesis in order to discredit it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIndignation</IRI>
    <Literal xml:lang="FR">Ce politicien n’a pas cessé de retourner sa veste et de vous trahir. Comment pouvez-vous encore le soutenir ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIndignation</IRI>
    <Literal xml:lang="EN">This politician continually switches sides and betrays you. How can you still support them?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIndignation</IRI>
    <Literal xml:lang="EN">https://homepages.hass.rpi.edu/heuveb/Teaching/CriticalThinking/Web/Presentations/EmotionalAppeals.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIndignation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToIndignation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHate</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHate</IRI>
    <Literal xml:lang="FR">Appel à la haine</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHate</IRI>
    <Literal xml:lang="EN">Appeal to hate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHate</IRI>
    <Literal xml:lang="FR">Vous suscitez un sentiment de haine à l’encontre de la thèse adverse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHate</IRI>
    <Literal xml:lang="EN">Arousing a feeling of hatred against the opposing thesis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHate</IRI>
    <Literal xml:lang="FR">Ceux qui s’opposent à notre politique veulent voir votre pays plonger dans le chaos. Il faut les arrêter avant qu’il ne soit trop tard.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHate</IRI>
    <Literal xml:lang="EN">Those opposing our policy want to see your country fall into chaos. We must stop them before it's too late.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHate</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Appeal_to_hate</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHate</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToHate</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#proofByAnger</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <Literal xml:lang="FR">Fâcher l’adversaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <Literal xml:lang="EN">Anger the opponent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <Literal xml:lang="FR">Vous énervez exprès votre adversaire pour qu’il perde son calme et semble moins crédible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <Literal xml:lang="EN">Deliberately angering an opponent so that they lose their composure and seem less credible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <Literal xml:lang="FR">Mais regardez-vous, avec vos arguments ! On dirait que vous découvrez le sujet... Ne vous fatiguez-vous pas à vous entendre déblatérer ainsi ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <Literal xml:lang="EN">Look at you, with your arguments! It's like you're just discovering the topic. Don't you get tired of hearing yourself ramble on?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Make_Your_Opponent_Angry</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_VIII</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressingWhereItHurts</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressingWhereItHurts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressingWhereItHurts</IRI>
    <Literal xml:lang="FR">Appuyer là où ça fait mal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressingWhereItHurts</IRI>
    <Literal xml:lang="EN">Pressing where it hurts</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressingWhereItHurts</IRI>
    <Literal xml:lang="FR">Vous identifiez ce qui énerve votre adversaire comme autant de points de faiblesse où vous le pressez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressingWhereItHurts</IRI>
    <Literal xml:lang="EN">Identifying what irritates your opponent as so many weak points to press.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressingWhereItHurts</IRI>
    <Literal xml:lang="FR">Regardez mon adversaire s’emporter après ce que je viens de dire ; il se disqualifie lui-même dans ce débat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressingWhereItHurts</IRI>
    <Literal xml:lang="EN">Look at my opponent getting carried away after what I just said; he is disqualifying himself in this debate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressingWhereItHurts</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Anger_Indicates_a_Weak_Point</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressingWhereItHurts</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_XXVII</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressingWhereItHurts</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressingWhereItHurts</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tacticOfNeedling</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tacticOfNeedling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tacticOfNeedling</IRI>
    <Literal xml:lang="FR">Appel à l’exaspération</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tacticOfNeedling</IRI>
    <Literal xml:lang="EN">Tactic of Needling</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tacticOfNeedling</IRI>
    <Literal xml:lang="FR">Vous taquinez votre adversaire jusqu’à l’énerver afin de lui faire perdre ses moyens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tacticOfNeedling</IRI>
    <Literal xml:lang="EN">Repeatedly anoying an opponents until they become angry and lose their mind.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tacticOfNeedling</IRI>
    <Literal xml:lang="FR">Encore une erreur, mon cher adversaire ! À ce rythme, vous ne finirez jamais votre exposé sans que je vous interrompe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tacticOfNeedling</IRI>
    <Literal xml:lang="EN">Another mistake, my dear opponent! At this rate, you'll never finish your presentation without me interrupting you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tacticOfNeedling</IRI>
    <Literal xml:lang="EN">http://www.seekfind.net/Tactic_of_Needling.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tacticOfNeedling</IRI>
    <Literal xml:lang="FR">http://www.seekfind.net/Tactic_of_Needling.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tacticOfNeedling</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tacticOfNeedling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrarianArgumentation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrarianArgumentation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrarianArgumentation</IRI>
    <Literal xml:lang="FR">Argument contrariant</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrarianArgumentation</IRI>
    <Literal xml:lang="EN">Contrarian argumentation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrarianArgumentation</IRI>
    <Literal xml:lang="FR">Vous contestez systématiquement les idées établies pour déstabiliser votre audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrarianArgumentation</IRI>
    <Literal xml:lang="EN">You systematically challenge established ideas to unsettle your audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrarianArgumentation</IRI>
    <Literal xml:lang="FR">Tout le monde pense que la Terre est ronde, mais avez-vous personnellement vérifié ? Ne croyez pas tout ce qu’on vous dit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrarianArgumentation</IRI>
    <Literal xml:lang="EN">Everyone thinks the Earth is round, but have you checked for yourself? Don't believe everything you're told.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrarianArgumentation</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#contrarian</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrarianArgumentation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrarianArgumentation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trapOfExaggeration</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trapOfExaggeration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trapOfExaggeration</IRI>
    <Literal xml:lang="FR">Hyperbole forcée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trapOfExaggeration</IRI>
    <Literal xml:lang="EN">Trap of exaggeration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trapOfExaggeration</IRI>
    <Literal xml:lang="FR">Afin de discréditer l’argumentation de votre adversaire, vous poussez celui-ci à l’exagération.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trapOfExaggeration</IRI>
    <Literal xml:lang="EN">Pushing an opponent into exaggeration in order to discredit their argumentation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trapOfExaggeration</IRI>
    <Literal xml:lang="FR">Vous pensez vraiment que vos histoires de voitures électriques changent quoi que ce soit au climat ? Pourquoi ne pas interdire les voitures à essence, pendant que vous y êtes !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trapOfExaggeration</IRI>
    <Literal xml:lang="EN">Do you really think your electric car stories will change the climate? Why not call for a ban on gasoline cars while you're at it!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trapOfExaggeration</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Make_Him_Exaggerate_his_Statement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trapOfExaggeration</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L’Art_d’avoir_toujours_raison/Stratagème_XXIII</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trapOfExaggeration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#trapOfExaggeration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#angerTheOpponent</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <Literal xml:lang="FR">Appel à la terreur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <Literal xml:lang="EN">Appeal to fear</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <Literal xml:lang="FR">Vous provoquez la peur chez votre auditoire pour le persuader, en délaissant les arguments raisonnables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <Literal xml:lang="EN">You provoke fear in your audience to persuade them, abandoning reasonable arguments.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <Literal xml:lang="FR">Ne vous éloignez pas du chemin, ou le loup vous dévorera !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <Literal xml:lang="EN">Do not stray from the path, or the wolf will eat you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_fear</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Appel_%C3%A0_la_terreur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#foil</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#closeMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="FR">Appel au doute et à la crainte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="EN">Fear, uncertainty and doubt</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="FR">Vous diffusez des informations négatives, souvent vagues, pour semer la peur et la méfiance, et rallier le public à votre cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="EN">Disseminating negative information, often vague, to sow fear and mistrust and rally the public to one's cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="FR">J’ai entendu dire que notre concurrent était en grandes difficultés. Avec leur situation financière, c’est un miracle s’ils tiennent jusqu’au printemps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="EN">I heard that our competitor was in big trouble. With their financial situation, it's a miracle they last until spring.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fear,_uncertainty,_and_doubt</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Fear,_uncertainty_and_doubt</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearUncertaintyAndDoubt</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="FR">Appel à la panique morale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="EN">Moral panic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="FR">Vous suscitez l’indignation en présentant certaines actions comme immorales, afin de provoquer une forte réaction émotionnelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="EN">You stir up outrage by presenting certain actions as immoral in order to provoke a strong emotional reaction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="FR">Cette nouvelle danse qui se répand chez les jeunes est un signe de décadence morale, qui mène droit à la dépravation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="EN">This new dance which is spreading among young people is a sign of moral decadence, which leads straight to depravity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Moral_panic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Panique_morale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#moralPanic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToFear</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <Literal xml:lang="FR">Appel aux conséquences</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <Literal xml:lang="EN">Appeal to consequences</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <Literal xml:lang="FR">Vous fondez votre argumentation sur les conséquences d’une idée plutôt que sur sa justesse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <Literal xml:lang="EN">Basing an argument on the consequences of an idea rather than on its soundness.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <Literal xml:lang="FR">Je ne donne jamais d’argent aux mendiants car je crains qu’ils n’en profitent pour acheter de l’alcool.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <Literal xml:lang="EN">I never give money to beggars because I fear they might use it to buy alcohol.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Appeal_to_consequences</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Argumentum_ad_consequentiam</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToEmotion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#EstablishedRule_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <Literal xml:lang="FR">Appel à la force</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <Literal xml:lang="EN">Appeal to force</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <Literal xml:lang="FR">Vous utilisez la menace de représailles contre votre contradicteur comme si elle suffisait à prouver la validité de votre proposition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <Literal xml:lang="EN">Arguing that threats of retaliation are sufficient proof of the validity of one's argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <Literal xml:lang="FR">Si vous continuez à contester la décision du comité, vos possibilités de promotion pourraient être compromises.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <Literal xml:lang="EN">If you continue to dispute the committee's decision, your promotion prospects might be adversely affected.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#force
https://utminers.utep.edu/omwilliamson/ENGL1311/fallacies.htm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vehemence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vehemence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vehemence</IRI>
    <Literal xml:lang="FR">Appel à la véhémence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vehemence</IRI>
    <Literal xml:lang="EN">Vehemence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vehemence</IRI>
    <Literal xml:lang="FR">Vous essayez de gagner un débat en criant plus fort ou en intimidant votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vehemence</IRI>
    <Literal xml:lang="EN">Winning an argument by being the loudest or by intimidation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vehemence</IRI>
    <Literal xml:lang="FR">Vous savez, si vous ne soutenez pas cette cause, je vais devenir nettement moins aimable avec vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vehemence</IRI>
    <Literal xml:lang="EN">You know, if you don't support this cause, I'm going to be significantly less friendly towards you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vehemence</IRI>
    <Literal xml:lang="EN">http://www.don-lindsay-archive.org/skeptic/arguments.html#vehemence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vehemence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vehemence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="FR">Argument du bâton</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="EN">Appeal to the stick</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="FR">Vous utilisez la menace pour remporter un débat au lieu de défendre votre position par la raison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="EN">Using a threat to win a debate instead of defending one's position through reason.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="FR">Si vous ne me laissez pas la dernière tranche de jambon, vous le paierez très cher.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="EN">If you don't leave that last slice of ham for me, you will pay dearly for it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argumentum_ad_baculum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="FR">Capacitisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="EN">Ableism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="FR">Vous discriminez ou marginalisez sur la base du handicap, considérant cela comme un argument valable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="EN">Discriminating or marginalizing on the basis of disability, treating it as a valid argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="FR">Je préfère ne pas lui confier de responsabilités importantes ; avec son handicap, il ne pourrait pas suivre le rythme comme nous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="EN">I prefer not to entrust him with important responsibilities; with his disability, he would not be able to keep up with the pace like us.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="EN">http://utminers.utep.edu/omwilliamson/ENGL1311/fallacies.htm#2</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Capacitisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ableism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRigor</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRigor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRigor</IRI>
    <Literal xml:lang="FR">Appel à la rigueur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRigor</IRI>
    <Literal xml:lang="EN">Appeal to rigor</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRigor</IRI>
    <Literal xml:lang="FR">Vous cherchez à impressionner ou à persuader en insistant sur la sévérité ou la rigueur de votre position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRigor</IRI>
    <Literal xml:lang="EN">Seeking to impress or persuade by emphasizing the severity or strictness of one's position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRigor</IRI>
    <Literal xml:lang="FR">Dans cette crise, il nous faut un leader qui n’ait pas peur de prendre des décisions difficiles ; la compassion ne résoudra pas nos problèmes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRigor</IRI>
    <Literal xml:lang="EN">In this crisis, we need a leader who isn't afraid of making tough decisions; compassion won't solve our problems.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRigor</IRI>
    <Literal xml:lang="EN">http://utminers.utep.edu/omwilliamson/ENGL1311/fallacies.htm#11</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRigor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToRigor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paternalism</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paternalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paternalism</IRI>
    <Literal xml:lang="FR">Paternalisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paternalism</IRI>
    <Literal xml:lang="EN">Paternalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paternalism</IRI>
    <Literal xml:lang="FR">Vous affirmez savoir ce qui est mieux pour les autres, imposant votre vue de manière dominatrice ou condescendante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paternalism</IRI>
    <Literal xml:lang="EN">Claiming to know what is best for others, imposing one's view in a domineering or condescending manner.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paternalism</IRI>
    <Literal xml:lang="FR">Vous comprendrez quand vous serez plus âgé, mais pour l’instant, faites-moi confiance et faites ce que je vous dis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paternalism</IRI>
    <Literal xml:lang="EN">You will understand when you are older, but for now, trust me and do what I tell you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paternalism</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Paternalism</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paternalism</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Paternalisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paternalism</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paternalism</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToForce</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toneArgument</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toneArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toneArgument</IRI>
    <Literal xml:lang="FR">Appel au ton</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toneArgument</IRI>
    <Literal xml:lang="EN">Tone argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toneArgument</IRI>
    <Literal xml:lang="FR">Vous rejetez un argument en raison de sa formulation jugée grossière ou insultante, plutôt que d’en examiner le fond.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toneArgument</IRI>
    <Literal xml:lang="EN">Dismissing an argument based on its perceived offensive or disrespectful tone, rather than its substance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toneArgument</IRI>
    <Literal xml:lang="FR">Je regrette de vous informer qu’en utilisant ce genre de langage, vous vous êtes complètement disqualifié.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toneArgument</IRI>
    <Literal xml:lang="EN">I'm sorry to inform you that by using that kind of language, you've totally disqualified yourself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toneArgument</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Tone_argument</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toneArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toneArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
    <Literal xml:lang="FR">Appel à la retenue</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
    <Literal xml:lang="EN">Demanding self-control</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
    <Literal xml:lang="FR">Vous disqualifiez un argument parce que la personne ne l’a pas présenté calmement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
    <Literal xml:lang="EN">Disqualification of an argument because the presenter doesn't remain calm, falsely equating emotional expression with lack of reason.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
    <Literal xml:lang="FR">Cet homme s’emporte toujours ; ses arguments ne peuvent pas être raisonnables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
    <Literal xml:lang="EN">How can we take his points seriously when he's always so upset? Calmness is key to credibility.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toneArgument</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#toneArgument</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGravity</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGravity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGravity</IRI>
    <Literal xml:lang="FR">Appel à la gravité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGravity</IRI>
    <Literal xml:lang="EN">Appeal to gravity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGravity</IRI>
    <Literal xml:lang="FR">Vous invoquez l’importance ou la solennité d’une situation pour donner du poids à votre point de vue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGravity</IRI>
    <Literal xml:lang="EN">Leveraging the supposed importance or seriousness of a situation to make someone's viewpoint stronger.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGravity</IRI>
    <Literal xml:lang="FR">Ce n’est pas parce qu’il a gagné au tiercé qu’on peut lui faire confiance pour envoyer un homme sur la Lune.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGravity</IRI>
    <Literal xml:lang="EN">Just because he won the trifecta doesn't mean he can be trusted to send a man to the moon.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGravity</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Appeal_to_gravity</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGravity</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToGravity</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mansplaining</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mansplaining</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mansplaining</IRI>
    <Literal xml:lang="FR">Appel à la virilité sentencieuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mansplaining</IRI>
    <Literal xml:lang="EN">Mansplaining</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mansplaining</IRI>
    <Literal xml:lang="FR">Vous expliquez de manière présomptueuse aux femmes ce qu’elles savent déjà, sous-entendant votre supériorité de compréhension.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mansplaining</IRI>
    <Literal xml:lang="EN">Presumptuously explaining to women what they already know, implying one's superior understanding.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mansplaining</IRI>
    <Literal xml:lang="FR">Laissez-moi m’occuper de ce problème. C’est un travail pour un homme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mansplaining</IRI>
    <Literal xml:lang="EN">Let me handle this problem. This is a job for a man.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mansplaining</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Mansplaining</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mansplaining</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mansplaining</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demandingSelfcontrol</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <Literal xml:lang="FR">Appel à l’intérêt personnel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <Literal xml:lang="EN">Appeal to self-interest</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <Literal xml:lang="FR">Vous amenez votre interlocuteur à accepter votre proposition en lui faisant croire qu’il pourra en tirer un avantage personnel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <Literal xml:lang="EN">Convincing an opponent to accept a proposal by suggesting personal benefits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <Literal xml:lang="FR">Si vous votez pour ma proposition, je m’assurerai que vous obteniez cet espace de bureau avec la vue que vous convoitez depuis longtemps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <Literal xml:lang="EN">If you support my proposal, I'll make sure you get the office space with the view you've been longing for.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <Literal xml:lang="EN">http://www.thinklikeacop.org/Military%20Manuals/Attacking%20Faulty%20Reasoning.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <Literal xml:lang="FR">https://en.wikipedia.org/wiki/Appeal_to_advantage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reciprocation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reciprocation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reciprocation</IRI>
    <Literal xml:lang="FR">Appel à la réciprocité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reciprocation</IRI>
    <Literal xml:lang="EN">Reciprocation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reciprocation</IRI>
    <Literal xml:lang="FR">Vous proposez à votre interlocuteur de lui rendre service s’il soutient votre argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reciprocation</IRI>
    <Literal xml:lang="EN">Trading argumentative support for a personal favour.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reciprocation</IRI>
    <Literal xml:lang="FR">Je vous couvre ce week-end si vous acceptez de me soutenir sur ce projet controversé ; nous serons quittes comme ça.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reciprocation</IRI>
    <Literal xml:lang="EN">I'll cover for you this weekend if you support me on this controversial project — let's square things up.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reciprocation</IRI>
    <Literal xml:lang="EN">http://www.cogsci.rpi.edu/~heuveb/teaching/CriticalThinking/Web/Presentations/EmotionalAppeals.pdf#page=15</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reciprocation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reciprocation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#revenge</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#revenge</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#revenge</IRI>
    <Literal xml:lang="FR">Appel à la revanche</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#revenge</IRI>
    <Literal xml:lang="EN">Revenge</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#revenge</IRI>
    <Literal xml:lang="FR">Vous soutenez ou rejetez une proposition non parce qu’elle est valide, mais parce qu’elle satisfait un désir de vengeance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#revenge</IRI>
    <Literal xml:lang="EN">Supporting or rejecting a proposition not because it is valid, but because it satisfies a feeling of vengeance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#revenge</IRI>
    <Literal xml:lang="FR">On ne devrait plus acheter leurs produits : ça leur apprendra à fermer l’usine de notre ville !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#revenge</IRI>
    <Literal xml:lang="EN">We should stop buying their products, that'll teach them for closing the factory in our town!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#revenge</IRI>
    <Literal xml:lang="EN">http://www.cogsci.rpi.edu/~heuveb/teaching/CriticalThinking/Web/Presentations/EmotionalAppeals.pdf#page=16</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#revenge</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#revenge</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bribery</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bribery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bribery</IRI>
    <Literal xml:lang="FR">Corruption</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bribery</IRI>
    <Literal xml:lang="EN">Bribery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bribery</IRI>
    <Literal xml:lang="FR">Vous cherchez à obtenir l’accord de votre auditoire en promettant un avantage en retour, au lieu de présenter un argument valable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bribery</IRI>
    <Literal xml:lang="EN">Seeking to obtain an audience's agreement by promising an advantage in return, rather than presenting a valid argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bribery</IRI>
    <Literal xml:lang="FR">Adoptez cette position, et je m’assurerai que votre prochain projet soit financé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bribery</IRI>
    <Literal xml:lang="EN">Support this stance and I'll make sure your next project gets funded.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bribery</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Bribery</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bribery</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bribery</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSelfinterest</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWilledIgnorance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWilledIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWilledIgnorance</IRI>
    <Literal xml:lang="FR">Appel à l’ignorance assumée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWilledIgnorance</IRI>
    <Literal xml:lang="EN">Appeal to willed ignorance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWilledIgnorance</IRI>
    <Literal xml:lang="FR">Vous incitez à rejeter toute information susceptible de contredire la position que vous défendez, afin de préserver le statu quo.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWilledIgnorance</IRI>
    <Literal xml:lang="EN">Encouraging the rejection of any information that could contradict the defended position in order to preserve the status quo.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWilledIgnorance</IRI>
    <Literal xml:lang="FR">Nous ne savons pas tout sur ce sujet, donc il vaut mieux s’en tenir à ce qui a toujours fonctionné plutôt que de risquer le changement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWilledIgnorance</IRI>
    <Literal xml:lang="EN">We don't know everything about this topic, so it's safer to stick with what has always worked rather than risk a change.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWilledIgnorance</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/182/Willed-Ignorance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWilledIgnorance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToWilledIgnorance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToConsequences</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <Literal xml:lang="FR">Manipulation mentale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <Literal xml:lang="EN">Psychological manipulation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <Literal xml:lang="FR">Vous utilisez des procédés qui orientent subtilement le point de vue de vos interlocuteurs, souvent sans qu’ils s’en rendent compte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <Literal xml:lang="EN">Using methods that subtly steer interlocutors' viewpoints, often without them realizing it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <Literal xml:lang="FR">N’oubliez pas : il y a ceux qui ont le privilège de choisir et ceux qui subissent les choix des autres. Agissez en conséquence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <Literal xml:lang="EN">Remember: there are those who have the privilege to choose and those who endure the choices of others. Act accordingly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Psychological_manipulation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Manipulation_mentale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#influence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <IRI>http://www.arg.dundee.ac.uk/aif#ConflictingGoals_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <Literal xml:lang="FR">Conditionnement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <Literal xml:lang="EN">Conditioning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <Literal xml:lang="FR">Vous associez des idées à des émotions afin d’influencer les comportements, sans que cette influence soit clairement perçue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <Literal xml:lang="EN">Creating associations between ideas and emotions, influencing behaviors without this being obvious.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <Literal xml:lang="FR">Quand vous voyez notre logo, vous pensez aussitôt à la liberté et à l’aventure. C’est ce qui rend notre marque si spéciale pour nos clients.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <Literal xml:lang="EN">When you see our logo, you immediately think of freedom and adventure. That is what makes our brand so special to our customers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <Literal xml:lang="EN">http://skepdic.com/conditioning.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Conditionnement_(psychologie)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <Literal xml:lang="FR">Cadrage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <Literal xml:lang="EN">Framing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <Literal xml:lang="FR">Votre formulation impose un contexte qui oriente les conclusions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <Literal xml:lang="EN">Imposing a context through wording that steers the conclusions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <Literal xml:lang="FR">Les études doivent préparer à la vie professionnelle ; il serait donc logique que les universités soient administrées par les chambres de commerce.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <Literal xml:lang="EN">Studies should prepare people for professional life; it would therefore be logical for universities to be administered by chambers of commerce.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Framing_(social_sciences)#Rhetorical_framing_in_politics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Cadrage_(d%C3%A9cision)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <Literal xml:lang="FR">Objectif caché</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <Literal xml:lang="EN">Hidden objective</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <Literal xml:lang="FR">Vous présentez vos arguments progressivement, sans révéler votre objectif final, pour que votre interlocuteur les accepte un à un sans comprendre où vous voulez en venir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <Literal xml:lang="EN">Presenting arguments gradually, without revealing the final objective, so that the interlocutor accepts them one by one without understanding where they are leading.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <Literal xml:lang="FR">Commencez par essayer notre version gratuite. Elle possède les fonctionnalités dont vous avez besoin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <Literal xml:lang="EN">Start by trying our free version. It has the features you need.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Conceal_Your_Game</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_IV</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antitheticalEquivocation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antitheticalEquivocation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antitheticalEquivocation</IRI>
    <Literal xml:lang="FR">Équivoque antithétique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antitheticalEquivocation</IRI>
    <Literal xml:lang="EN">Antithetical Equivocation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antitheticalEquivocation</IRI>
    <Literal xml:lang="FR">En alternant habilement le pour et le contre, vous embrouillez votre auditoire, qui ne sait plus quel est votre véritable point de vue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antitheticalEquivocation</IRI>
    <Literal xml:lang="EN">Skillfully playing with pros and cons to confuse an audience until it no longer knows what one's real stance is.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antitheticalEquivocation</IRI>
    <Literal xml:lang="FR">Il est essentiel de préserver nos traditions, tout en accueillant ce qui peut enrichir notre culture.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antitheticalEquivocation</IRI>
    <Literal xml:lang="EN">It's important to preserve our traditions, yet enriching our culture is also crucial.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antitheticalEquivocation</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Take_Advantage_of_The_Nay-Sayer</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antitheticalEquivocation</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_X</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antitheticalEquivocation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#antitheticalEquivocation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitAndSwitch</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitAndSwitch</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitAndSwitch</IRI>
    <Literal xml:lang="FR">Appât et substitution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitAndSwitch</IRI>
    <Literal xml:lang="EN">Bait and Switch</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitAndSwitch</IRI>
    <Literal xml:lang="FR">Vous commencez par des affirmations que tout le monde accepte, puis vous glissez subtilement vers vos idées contestables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitAndSwitch</IRI>
    <Literal xml:lang="EN">Stating a series of uncontroversial statements before introducing the proposed, debatable argument.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitAndSwitch</IRI>
    <Literal xml:lang="FR">Les parents ont le devoir d’éduquer leurs enfants et de subvenir à leurs besoins ; ils devraient donc aussi déterminer les études que leurs enfants doivent suivre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitAndSwitch</IRI>
    <Literal xml:lang="EN">Parents have the duty to educate their children and provide for their needs; it's also up to them to decide which studies their children should undertake.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitAndSwitch</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/105/Hypnotic-Bait-and-Switch</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitAndSwitch</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitAndSwitch</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#praiseSandwich</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#praiseSandwich</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#praiseSandwich</IRI>
    <Literal xml:lang="FR">Sandwich de louanges</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#praiseSandwich</IRI>
    <Literal xml:lang="EN">Praise Sandwich</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#praiseSandwich</IRI>
    <Literal xml:lang="FR">Vous encadrez une critique ou un commentaire négatif entre deux éloges ou compliments, pour adoucir le message et le rendre plus acceptable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#praiseSandwich</IRI>
    <Literal xml:lang="EN">Framing a criticism or negative comment between two praises or compliments, to soften the message and make it more palatable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#praiseSandwich</IRI>
    <Literal xml:lang="FR">Votre travail sur le projet a été impressionnant. En revanche, il y a eu quelques erreurs dans vos calculs. Mais, dans l’ensemble, vous avez montré un grand engagement. — Technique managériale : la critique centrale est encadrée par deux compliments, ce qui augmente le taux d’acceptation de la critique tout en diminuant la perception de son importance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#praiseSandwich</IRI>
    <Literal xml:lang="EN">Your work on the project was impressive. However, there were a few errors in your calculations. But overall, you showed great commitment. — Management technique: the central criticism is framed by two compliments, which increases the criticism's acceptance rate while reducing how important it is perceived to be.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#praiseSandwich</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Praise_sandwich</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitAndSwitch</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#praiseSandwich</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#praiseSandwich</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#baitAndSwitch</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="FR">Compliment empoisonné</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="EN">Damning with faint praise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="FR">Vous discréditez quelqu’un par un compliment qui insinue en réalité le contraire de ce qu’il semble affirmer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="EN">Undermining someone with a compliment that insinuates the opposite of its apparent expression.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="FR">Je ne dirais pas que son raisonnement ne vaut rien ; ce serait sans doute exagéré.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="EN">I would not say that his reasoning is worthless; that would probably be an exaggeration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Damning_with_faint_praise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#damningWithFaintPraise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteAndBailey</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteAndBailey</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteAndBailey</IRI>
    <Literal xml:lang="FR">Sophisme de la motte castrale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteAndBailey</IRI>
    <Literal xml:lang="EN">Motte and bailey</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteAndBailey</IRI>
    <Literal xml:lang="FR">Vous vous appuyez sur une position modeste et consensuelle pour faire accepter une position plus ambitieuse et controversée, comme si la première prouvait la seconde.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteAndBailey</IRI>
    <Literal xml:lang="EN">You rely on a modest, widely accepted position to get a more ambitious and controversial position accepted, as if the former proved the latter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteAndBailey</IRI>
    <Literal xml:lang="FR">Bien sûr que les astres influencent la nature : regardez l’effet de la Lune sur les marées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteAndBailey</IRI>
    <Literal xml:lang="EN">Of course the heavenly bodies influence nature: just look at the effect of the Moon on the tides.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteAndBailey</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/Motte_and_bailey</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteAndBailey</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#motteAndBailey</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionsInDetouringOrder</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionsInDetouringOrder</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionsInDetouringOrder</IRI>
    <Literal xml:lang="FR">Questions en désordre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionsInDetouringOrder</IRI>
    <Literal xml:lang="EN">Questions in detouring order</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionsInDetouringOrder</IRI>
    <Literal xml:lang="FR">Vous présentez vos arguments dans un ordre confus afin de masquer vos intentions et d’empêcher votre interlocuteur de comprendre le but de votre raisonnement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionsInDetouringOrder</IRI>
    <Literal xml:lang="EN">Presenting one's arguments in a confused order to mask one's intentions and prevent the aim of one's reasoning from being guessed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionsInDetouringOrder</IRI>
    <Literal xml:lang="FR">Pourquoi s’inquiéter de la dette nationale alors qu’il y a des problèmes de sécurité ? Mais la sécurité ne dépend-elle pas, elle aussi, d’une économie solide ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionsInDetouringOrder</IRI>
    <Literal xml:lang="EN">"Why worry about national debt when there are security problems? But then, doesn't security depend on our robust economy?"</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionsInDetouringOrder</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Questions_in_Detouring_Order</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionsInDetouringOrder</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_IX</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionsInDetouringOrder</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#questionsInDetouringOrder</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distancingLanguage</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distancingLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distancingLanguage</IRI>
    <Literal xml:lang="FR">Distanciation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distancingLanguage</IRI>
    <Literal xml:lang="EN">Distancing language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distancingLanguage</IRI>
    <Literal xml:lang="FR">Vous présentez vos idées de façon évasive afin d’éviter de vous y engager pleinement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distancingLanguage</IRI>
    <Literal xml:lang="EN">Using formulations which signal non-comitment to what is said.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distancingLanguage</IRI>
    <Literal xml:lang="FR">Il se pourrait que cette nouvelle politique ait un impact positif, même si certains ajustements mineurs restent nécessaires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distancingLanguage</IRI>
    <Literal xml:lang="EN">The new policy presented here might have a positive impact, though some minor adjustments are still needed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distancingLanguage</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Distancing_language</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distancingLanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#distancingLanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sleeperEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sleeperEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sleeperEffect</IRI>
    <Literal xml:lang="FR">Effet d’assoupissement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sleeperEffect</IRI>
    <Literal xml:lang="EN">Sleeper effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sleeperEffect</IRI>
    <Literal xml:lang="FR">Vous faites appel à des arguments faibles, en misant sur l’idée que le fond sera retenu et non leur origine douteuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sleeperEffect</IRI>
    <Literal xml:lang="EN">You appeal to weak arguments, counting on the idea that their substance, rather than their dubious origin, will be remembered.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sleeperEffect</IRI>
    <Literal xml:lang="FR">Bien que certains experts contestent nos données, l’important est de retenir que la tendance générale nous est favorable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sleeperEffect</IRI>
    <Literal xml:lang="EN">Though some experts dispute our data, the key takeaway is that the general trend is in our favor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sleeperEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sleeper_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sleeperEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sleeperEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="FR">Effet de vérité illusoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="EN">Illusory truth effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="FR">Vous subissez ou vous appuyez sur le fait qu’une information fausse suffisament répétée a plus de chance d’être acceptée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="EN">Being subjected to, or relying on, the fact that sufficiently repeated false information has a greater chance of being accepted.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="FR">J’ai entendu tellement de fois que ce régime alimentaire fonctionne, il doit sûrement être efficace.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="EN">I have heard so many times that this diet works, surely it must be effective.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Illusory_truth_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_de_v%C3%A9rit%C3%A9_illusoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusoryTruthEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hiddenObjective</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
    <Literal xml:lang="FR">Appel à la validation subjective</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
    <Literal xml:lang="EN">Appeal to subjective validation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
    <Literal xml:lang="FR">Pour faire accepter une proposition, vous faites en sorte qu’elle prenne un sens particulier aux yeux de votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
    <Literal xml:lang="EN">Making a proposition acceptable by ensuring that it takes on a particular meaning in the eyes of one's interlocutor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
    <Literal xml:lang="FR">Vous vous sentez certainement préoccupé par l’avenir, n’est-ce pas ? C’est pourquoi notre programme est conçu pour des gens comme vous, qui se soucient vraiment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
    <Literal xml:lang="EN">You surely worry about the future, don't you? That's why our program is designed for people like you who truly care.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
    <Literal xml:lang="EN">http://skepdic.com/subjectivevalidation.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
    <Literal xml:lang="FR">Appel à l’effet Barnum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
    <Literal xml:lang="EN">Appeal to Barnum effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
    <Literal xml:lang="FR">Vous utilisez des descriptions générales pour que votre interlocuteur s’y reconnaisse et valide ainsi votre aptitude à comprendre les gens.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
    <Literal xml:lang="EN">Using general descriptions so that the interlocutor recognizes themselves in them and thereby validates one's ability to understand people.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
    <Literal xml:lang="FR">Vous avez un potentiel considérable que vous n’avez pas encore exploité à votre avantage. En apparence, vous êtes discipliné et maître de vous-même, mais intérieurement, vous avez tendance à être préoccupé et peu sûr de vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
    <Literal xml:lang="EN">You have great potential that you haven't used to your advantage yet. On the outside, you're disciplined and know how to control yourself, but inside you tend to be worried and not very confident.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Barnum_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_Barnum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#warmReading</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#warmReading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#warmReading</IRI>
    <Literal xml:lang="FR">Lecture à chaud</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#warmReading</IRI>
    <Literal xml:lang="EN">Warm reading</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#warmReading</IRI>
    <Literal xml:lang="FR">Vous formulez des observations psychologiques assez vagues pour s’appliquer à n’importe qui, tout en paraissant personnelles à votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#warmReading</IRI>
    <Literal xml:lang="EN">Formulating psychological observations vague enough to apply to anyone while still seeming personal to the interlocutor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#warmReading</IRI>
    <Literal xml:lang="FR">Vous avez une forte personnalité, mais parfois vous doutez de vous, n’est-ce pas ? C’est ce que je ressens, et c’est pourquoi notre produit est parfait pour vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#warmReading</IRI>
    <Literal xml:lang="EN">You have a strong personality, but sometimes you doubt yourself, right? That's what I sense, and that's why our product is perfect for you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#warmReading</IRI>
    <Literal xml:lang="EN">http://skepdic.com/warmreading.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#warmReading</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#warmReading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#possibilitytreeTrap</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#possibilitytreeTrap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#possibilitytreeTrap</IRI>
    <Literal xml:lang="FR">Piège de l’arbre des possibles</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#possibilitytreeTrap</IRI>
    <Literal xml:lang="EN">Possibility-tree trap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#possibilitytreeTrap</IRI>
    <Literal xml:lang="FR">Vous adressez à votre interlocuteur une recommandation à caractère prophétique, conçue pour que les événements à venir semblent vous donner raison dans tous les cas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#possibilitytreeTrap</IRI>
    <Literal xml:lang="EN">Addressing a prophetic recommendation to an interlocutor, designed so that future events seem to prove one right in every case.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#possibilitytreeTrap</IRI>
    <Literal xml:lang="FR">Si vous investissez dans cette technologie maintenant, vous serez en avance ; si elle devient la norme, vous serez un pionnier ; et si elle échoue, votre expérience vous distinguera des débutants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#possibilitytreeTrap</IRI>
    <Literal xml:lang="EN">If you invest in this technology now, you'll be ahead; if it becomes the standard, you'll be a pioneer, and if it fails, your experience will set you apart from the beginners.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#possibilitytreeTrap</IRI>
    <Literal xml:lang="FR">https://cortecs.org/materiel/leffet-barnum-forer-ou-validation-subjective/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#possibilitytreeTrap</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#possibilitytreeTrap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToBarnumEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
    <Literal xml:lang="FR">Lecture à froid</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
    <Literal xml:lang="EN">Cold reading</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
    <Literal xml:lang="FR">Vous observez attentivement votre interlocuteur pour en déduire ses besoins, puis adaptez votre discours à son profil.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
    <Literal xml:lang="EN">Carefully observing an interlocutor to infer their needs, then adapting one's discourse to their profile.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
    <Literal xml:lang="FR">Savez-vous que le champion ambassadeur de notre marque porte la même montre que vous ? Vous aimez l’aventure, n’est-ce pas ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
    <Literal xml:lang="EN">Did you know that the champion ambassador of our brand wears the same watch as you? You like adventure, don't you?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cold_reading</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Lecture_à_froid</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToSubjectiveValidation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rainbowRuse</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rainbowRuse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rainbowRuse</IRI>
    <Literal xml:lang="FR">Ruse de l’arc-en-ciel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rainbowRuse</IRI>
    <Literal xml:lang="EN">Rainbow ruse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rainbowRuse</IRI>
    <Literal xml:lang="FR">Vous affirmez paradoxalement que votre interlocuteur possède à la fois une qualité et son contraire, ce qui vous permet de paraître toujours cohérent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rainbowRuse</IRI>
    <Literal xml:lang="EN">Paradoxically claiming that the interlocutor has both a quality and its opposite, allowing one to appear consistently coherent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rainbowRuse</IRI>
    <Literal xml:lang="FR">Vous avez la fermeté nécessaire pour prendre des décisions difficiles, mais vous êtes assez flexible pour vous adapter à de nouvelles informations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rainbowRuse</IRI>
    <Literal xml:lang="EN">You have the firmness necessary to make tough decisions, but you're also flexible enough to adapt to new information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rainbowRuse</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cold_reading#The_rainbow_ruse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rainbowRuse</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rainbowRuse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shotgunning</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shotgunning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shotgunning</IRI>
    <Literal xml:lang="FR">Tir au petit plomb</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shotgunning</IRI>
    <Literal xml:lang="EN">Shotgunning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shotgunning</IRI>
    <Literal xml:lang="FR">Vous lancez plusieurs idées en espérant que l’une d’elles sera acceptée, pour ensuite l’exploiter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shotgunning</IRI>
    <Literal xml:lang="EN">Projecting many conjectures so that the audience confirms one, which will then be focused on.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shotgunning</IRI>
    <Literal xml:lang="FR">Je vous verrai bien dans le marketing digital, les événements en direct, peut-être des partenariats stratégiques ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shotgunning</IRI>
    <Literal xml:lang="EN">I could see you working in digital marketing, live events, maybe strategic partnerships?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shotgunning</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Cold_reading#Shotgunning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shotgunning</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Lecture_à_froid#Tir_au_petit_plomb</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shotgunning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shotgunning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coldReading</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <Literal xml:lang="FR">Programmation neurolinguistique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <Literal xml:lang="EN">Neuro-linguistic programming</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <Literal xml:lang="FR">Au moyen de stimuli sensoriels ou verbaux, vous influez sur le comportement ou la mémoire de votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <Literal xml:lang="EN">Using sensory or verbal stimuli to influence the behavior or memory of one's audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <Literal xml:lang="FR">Succombez à la délicatesse de ses arômes, à son goût enchanteur et à la finesse de sa texture...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <Literal xml:lang="EN">Succumb to the delicacy of its aromas, its enchanting taste, and the finesse of its texture...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Methods_of_neuro-linguistic_programming</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Programmation_neuro-linguistique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoring</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoring</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoring</IRI>
    <Literal xml:lang="FR">Ancrage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoring</IRI>
    <Literal xml:lang="EN">Anchoring</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoring</IRI>
    <Literal xml:lang="FR">Vous créez un lien entre un signal et une réaction pour provoquer cette réaction chez votre public à l’avenir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoring</IRI>
    <Literal xml:lang="EN">Creating a connection between a cue and a reaction in order to elicit this reaction from one's audience in the future.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoring</IRI>
    <Literal xml:lang="FR">Pensez à la dernière fois que vous vous êtes senti complètement détendu. C’est exactement l’état d’esprit que notre spa cherche à recréer pour vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoring</IRI>
    <Literal xml:lang="EN">Think of the last time you felt completely relaxed. That's exactly the state of mind our spa seeks to recreate for you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoring</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Methods_of_neuro-linguistic_programming#Anchoring</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoring</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Programmation_neuro-linguistique#L.27ancrage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoring</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anchoring</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rapport</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rapport</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rapport</IRI>
    <Literal xml:lang="FR">Synchronisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rapport</IRI>
    <Literal xml:lang="EN">Rapport</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rapport</IRI>
    <Literal xml:lang="FR">Vous imitez le comportement de votre interlocuteur pour instaurer un sentiment de confiance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rapport</IRI>
    <Literal xml:lang="EN">Imitating an interlocutor's behavior to establish a sense of trust.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rapport</IRI>
    <Literal xml:lang="FR">Vous aimez les fleurs ? Moi aussi !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rapport</IRI>
    <Literal xml:lang="EN">You like flowers? So do I!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rapport</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Rapport</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rapport</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Programmation_neuro-linguistique#La_synchronisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rapport</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rapport</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reframing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reframing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reframing</IRI>
    <Literal xml:lang="FR">Recadrage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reframing</IRI>
    <Literal xml:lang="EN">Reframing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reframing</IRI>
    <Literal xml:lang="FR">Vous modifiez le regard porté sur une idée en la présentant sous un jour différent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reframing</IRI>
    <Literal xml:lang="EN">Changing how an idea is viewed by presenting it in a different light.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reframing</IRI>
    <Literal xml:lang="FR">Ne voyez pas ce changement comme une perte, mais comme une opportunité de découvrir de nouveaux horizons professionnels.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reframing</IRI>
    <Literal xml:lang="EN">Don't see this change as a loss, but as an opportunity to explore new professional horizons.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reframing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Methods_of_neuro-linguistic_programming#Reframing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reframing</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Programmation_neuro-linguistique#Le_recadrage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reframing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#reframing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dissociation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dissociation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dissociation</IRI>
    <Literal xml:lang="FR">Appel à la dissociation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dissociation</IRI>
    <Literal xml:lang="EN">Dissociation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dissociation</IRI>
    <Literal xml:lang="FR">Vous invitez votre interlocuteur à se voir comme un observateur, pour envisager différemment ses propres idées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dissociation</IRI>
    <Literal xml:lang="EN">Inviting one's interlocutor to view themselves as an observer, to consider their own ideas differently.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dissociation</IRI>
    <Literal xml:lang="FR">Vous vous êtes vu quand vous avez bu ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dissociation</IRI>
    <Literal xml:lang="EN">Have you seen yourself when you've been drinking?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dissociation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Methods_of_neuro-linguistic_programming#VK.2FD</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dissociation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Programmation_neuro-linguistique#La_dissociation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dissociation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dissociation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#futurePacing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#futurePacing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#futurePacing</IRI>
    <Literal xml:lang="FR">Appel au voyage dans le futur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#futurePacing</IRI>
    <Literal xml:lang="EN">Future pacing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#futurePacing</IRI>
    <Literal xml:lang="FR">Vous projetez votre interlocuteur dans le futur pour influencer ses décisions présentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#futurePacing</IRI>
    <Literal xml:lang="EN">Projecting one's interlocutor into the future to influence their present decisions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#futurePacing</IRI>
    <Literal xml:lang="FR">Imaginez-vous dans dix ans, profitant pleinement de votre retraite grâce à l’investissement que vous aurez fait aujourd’hui.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#futurePacing</IRI>
    <Literal xml:lang="EN">Imagine yourself in ten years, fully enjoying your retirement thanks to the investment you make today.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#futurePacing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Methods_of_neuro-linguistic_programming#Future_pacing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#futurePacing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#futurePacing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#swish</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#swish</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#swish</IRI>
    <Literal xml:lang="FR">Effet swish</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#swish</IRI>
    <Literal xml:lang="EN">Swish</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#swish</IRI>
    <Literal xml:lang="FR">Vous cherchez à modifier le comportement de votre interlocuteur en perturbant ses habitudes de pensée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#swish</IRI>
    <Literal xml:lang="EN">Disrupting a pattern of thought in order to change the behavior it leads to.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#swish</IRI>
    <Literal xml:lang="FR">Chaque fois que vous pensez à fumer, remplacez cette image par celle de vous faisant une activité saine. C’est une façon de reprogrammer votre désir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#swish</IRI>
    <Literal xml:lang="EN">Every time you think about smoking, replace that image with one of you doing a healthy activity. It's a way to reprogram your desire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#swish</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Methods_of_neuro-linguistic_programming#Swish</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#swish</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#swish</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#neurolinguisticProgramming</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leveragingNegativityBias</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leveragingNegativityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leveragingNegativityBias</IRI>
    <Literal xml:lang="FR">Exploiter le biais de négativité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leveragingNegativityBias</IRI>
    <Literal xml:lang="EN">Leveraging negativity bias</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leveragingNegativityBias</IRI>
    <Literal xml:lang="FR">Vous axez votre discours sur des considérations défavorables et pessimistes au détriment d’éventuels éléments positifs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leveragingNegativityBias</IRI>
    <Literal xml:lang="EN">Focusing discourse on unfavorable and pessimistic considerations, neglecting potential positive aspects.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leveragingNegativityBias</IRI>
    <Literal xml:lang="FR">Oui, il y a des chances que tout se passe bien lors de ce voyage, mais vous avez entendu combien de fois les trains ont eu du retard dernièrement ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leveragingNegativityBias</IRI>
    <Literal xml:lang="EN">Sure, there's a chance everything will go well on this trip, but have you heard how often trains have been delayed recently?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leveragingNegativityBias</IRI>
    <Literal xml:lang="EN">http://skepdic.com/negativitybias.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leveragingNegativityBias</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#leveragingNegativityBias</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#framing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <Literal xml:lang="FR">Conditionnement opérant</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <Literal xml:lang="EN">Operant conditioning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <Literal xml:lang="FR">Vous influencez le comportement d’autrui au moyen de récompenses ou de punitions, afin de favoriser les réponses que vous souhaitez obtenir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <Literal xml:lang="EN">Influencing the behavior of others by means of rewards or punishments, in order to favor the responses one wishes to obtain.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <Literal xml:lang="FR">Chaque objectif de vente atteint donnera lieu à une prime importante. En revanche, si l’objectif n’est pas atteint, des réunions intensives d’accompagnement seront programmées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <Literal xml:lang="EN">For every sales goal achieved, there will be a hefty bonus. If the goal is not met, intensive coaching meetings will be scheduled.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Operant_conditioning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Conditionnement_opérant</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
    <Literal xml:lang="FR">La carotte et le bâton</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
    <Literal xml:lang="EN">Carrot and stick</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
    <Literal xml:lang="FR">Vous combinez des récompenses (la carotte) et des punitions (le bâton) pour influencer le comportement d’autrui.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
    <Literal xml:lang="EN">Using a motivational strategy that combines rewards (the carrot) and punishments (the stick) to influence someone else's behavior.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
    <Literal xml:lang="FR">Si vous atteignez vos objectifs ce mois-ci, vous recevrez une prime, mais si vous échouez, des mesures disciplinaires seront appliquées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
    <Literal xml:lang="EN">If you meet your targets this month, you will receive a bonus, but if you fail, disciplinary actions will be taken.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Carrot_and_stick</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
    <Literal xml:lang="FR">https://fr.wiktionary.org/wiki/la_carotte_et_le_b%C3%A2ton</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisonousPedagogy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisonousPedagogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisonousPedagogy</IRI>
    <Literal xml:lang="FR">Pédagogie noire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisonousPedagogy</IRI>
    <Literal xml:lang="EN">Poisonous pedagogy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisonousPedagogy</IRI>
    <Literal xml:lang="FR">Vous utilisez des méthodes éducatives ou disciplinaires sévères, souvent dommageables, fondées sur la peur, la culpabilité et l’humiliation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisonousPedagogy</IRI>
    <Literal xml:lang="EN">Employing harsh and often damaging educational or disciplinary methods, based on fear, guilt, and humiliation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisonousPedagogy</IRI>
    <Literal xml:lang="FR">Si vous ne finissez pas vos devoirs à temps, vous serez privé de tout loisir pendant une semaine. C’est pour votre bien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisonousPedagogy</IRI>
    <Literal xml:lang="EN">If you don't finish your homework on time, you'll be deprived of all leisure for a week. It's for your own good.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisonousPedagogy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Poisonous_pedagogy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisonousPedagogy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/P%C3%A9dagogie_noire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisonousPedagogy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#poisonousPedagogy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#carrotAndStick</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaping</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaping</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaping</IRI>
    <Literal xml:lang="FR">Façonnage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaping</IRI>
    <Literal xml:lang="EN">Shaping</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaping</IRI>
    <Literal xml:lang="FR">Vous renforcez progressivement des comportements de plus en plus proches de l’objectif visé, en commençant par des actions simples puis en augmentant graduellement la complexité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaping</IRI>
    <Literal xml:lang="EN">Progressively reinforcing behaviors that are increasingly closer to the desired goal, starting with simple actions and gradually increasing complexity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaping</IRI>
    <Literal xml:lang="FR">Je sais que vous êtes réticent à l’idée de tricher, mais commençons simplement par regarder les réponses des autres sans les copier.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaping</IRI>
    <Literal xml:lang="EN">I know you're hesitant about cheating, but let's just start by looking at others' answers without copying them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaping</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Shaping_(psychology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaping</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaping</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chaining</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chaining</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chaining</IRI>
    <Literal xml:lang="FR">Chaînage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chaining</IRI>
    <Literal xml:lang="EN">Chaining</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chaining</IRI>
    <Literal xml:lang="FR">Vous induisez une séquence complexe de comportements en liant des actions simples dans un ordre spécifique, chacune servant de signal pour la suivante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chaining</IRI>
    <Literal xml:lang="EN">Forming a complex sequence of behaviors by linking simple actions in a specific order, each serving as a cue for the next.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chaining</IRI>
    <Literal xml:lang="FR">À 10 h, vous récupérez le colis à l’entrepôt. Pendant ce temps, Miguel s’occupera de neutraliser le témoin gênant. À 11 h, vous vous retrouvez au point de rendez-vous pour échanger vos positions. Ensuite, à 11 h 30, vous livrerez le colis à l’acheteur pendant que Miguel effacera toutes les preuves.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chaining</IRI>
    <Literal xml:lang="EN">At 10 AM, you pick up the package from the warehouse. Meanwhile, Miguel will take care of the troublesome witness. At 11 AM, you meet at the rendezvous point to switch roles. Then, at 11:30 AM, you deliver the package to the buyer while Miguel erases all evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chaining</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Chaining</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chaining</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Cha%C3%AEnage_(psychologie)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaping</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chaining</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chaining</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaping</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
    <Literal xml:lang="FR">Inoculation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
    <Literal xml:lang="EN">Inoculation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
    <Literal xml:lang="FR">Vous présentez des contre-arguments faibles afin de renforcer la crédibilité de vos propres idées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
    <Literal xml:lang="EN">Introducing weak counterarguments to strengthen the credibility of one's ideas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
    <Literal xml:lang="FR">Certains disent que notre produit est trop cher, mais voyez plutôt la qualité de ce produit concurrent moins cher.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
    <Literal xml:lang="EN">Some argue that our product is too costly, but consider the quality of this cheaper competing product.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Inoculation_theory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
    <Literal xml:lang="FR">https://psychologie.savoir.fr/psychologie-inoculation-attitudinale/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="FR">Jeu de contraste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="EN">Contrast effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="FR">Vous poussez votre adversaire vers une position en la faisant contraster avec la position inverse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="EN">Inducing one's opponent to take a position by contrasting it with the opposite stance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="FR">Vous vous plaignez que je ne vous écoute pas assez, mais écoutez : les voisins se disputent encore.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="EN">You complain that I don't listen to you enough, but do you hear? The neighbors are arguing again.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Contrast_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#contrastEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inoculation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intermittentReinforcement</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intermittentReinforcement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intermittentReinforcement</IRI>
    <Literal xml:lang="FR">Renforcement Intermittent</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intermittentReinforcement</IRI>
    <Literal xml:lang="EN">Intermittent Reinforcement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intermittentReinforcement</IRI>
    <Literal xml:lang="FR">Vous appliquez des récompenses ou des punitions de façon imprévisible pour manipuler.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intermittentReinforcement</IRI>
    <Literal xml:lang="EN">Applying rewards or punishments unpredictably as a form of manipulation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intermittentReinforcement</IRI>
    <Literal xml:lang="FR">Comme vous avez bien travaillé ces derniers jours sans mon aide, aujourd’hui je vous invite au restaurant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intermittentReinforcement</IRI>
    <Literal xml:lang="EN">Since you have worked well in the past few days without my help, today I'm treating you to a dinner out.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intermittentReinforcement</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Reinforcement#Intermittent_reinforcement_schedules</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intermittentReinforcement</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intermittentReinforcement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#operantConditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
    <Literal xml:lang="FR">Prophétie autoréalisatrice</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
    <Literal xml:lang="EN">Self-fulfilling Prophecy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
    <Literal xml:lang="FR">Vous croyez tellement à une prédiction ou à une attente que vos actions finissent par la réaliser.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
    <Literal xml:lang="EN">Believing so strongly in a prediction or expectation that one's actions end up making it come true.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
    <Literal xml:lang="FR">Tout le monde pensait que ce projet allait échouer, et cette croyance a tellement affecté notre motivation que nous n’avons pas réussi à le mener à bien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
    <Literal xml:lang="EN">Everyone thought this project was going to fail, and that belief affected our motivation so much that we couldn't make it succeed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Self-fulfilling_prophecy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Proph%C3%A9tie_autor%C3%A9alisatrice</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
    <Literal xml:lang="FR">Prophétie auto-réalisatrice endogène</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
    <Literal xml:lang="EN">Endogenous Self-fulfilling Prophecy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
    <Literal xml:lang="FR">Vous croyez tellement en une prédiction ou une attente personnelle qu’elle finit par se réaliser en raison de vos propres actions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
    <Literal xml:lang="EN">Believing so strongly in a personal prediction or expectation that it comes true due to one's own actions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
    <Literal xml:lang="FR">Je me suis toujours dit que j’étais mauvais à l’oral. Maintenant, chaque fois que je dois parler en public, je panique et j’échoue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
    <Literal xml:lang="EN">I've always told myself that I'm bad at public speaking. Now, every time I have to speak in public, I panic and fail.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#autosuggestion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#autosuggestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#autosuggestion</IRI>
    <Literal xml:lang="FR">Appel à la méthode Coué</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#autosuggestion</IRI>
    <Literal xml:lang="EN">Autosuggestion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#autosuggestion</IRI>
    <Literal xml:lang="FR">Vous utilisez l’autosuggestion positive, comme la méthode Coué, pour renforcer la confiance en soi et influencer positivement vos réalisations.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#autosuggestion</IRI>
    <Literal xml:lang="EN">Using positive self-suggestion practices, like Coué's method, to boost self-confidence and positively influence one's achievements.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#autosuggestion</IRI>
    <Literal xml:lang="FR">Chaque matin, je me répète : « Chaque jour, à tous points de vue, je vais de mieux en mieux », et cela me rend plus optimiste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#autosuggestion</IRI>
    <Literal xml:lang="EN">Every morning, I repeat to myself 'Every day, in every way, I'm getting better and better', and it makes me more optimistic.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#autosuggestion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Autosuggestion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#autosuggestion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Méthode_Coué</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#autosuggestion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#autosuggestion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureNeurosis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureNeurosis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureNeurosis</IRI>
    <Literal xml:lang="FR">Névrose d’échec</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureNeurosis</IRI>
    <Literal xml:lang="EN">Failure neurosis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureNeurosis</IRI>
    <Literal xml:lang="FR">Vous vous organisez inconsciemment de manière à échouer, souvent en surestimant les risques ou en vous imposant des conditions supplémentaires inutiles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureNeurosis</IRI>
    <Literal xml:lang="EN">Unconsciously organizing oneself in a way that leads to failure, often by overestimating risks or imposing unnecessary additional conditions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureNeurosis</IRI>
    <Literal xml:lang="FR">Même si je sais que je pourrais réussir, je trouve toujours une excuse pour ne pas terminer mes projets. C’est comme si je me préparais à échouer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureNeurosis</IRI>
    <Literal xml:lang="EN">Even though I know I could succeed, I always find an excuse not to finish my projects. It's like I'm setting myself up for failure.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureNeurosis</IRI>
    <Literal xml:lang="EN">https://www.encyclopedia.com/psychology/dictionaries-thesauruses-pictures-and-press-releases/failure-neurosis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureNeurosis</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/N%C3%A9vrose_d%27%C3%A9chec</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureNeurosis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#failureNeurosis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearOfFailure</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearOfFailure</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearOfFailure</IRI>
    <Literal xml:lang="FR">Peur de l’échec</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearOfFailure</IRI>
    <Literal xml:lang="EN">Fear of Failure</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearOfFailure</IRI>
    <Literal xml:lang="FR">Vous avez une peur intense et irrationnelle de l’échec, qui vous pousse à éviter les situations comportant un risque d’échouer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearOfFailure</IRI>
    <Literal xml:lang="EN">Having an intense and irrational fear of failure, leading one to avoid situations where there's a risk of failing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearOfFailure</IRI>
    <Literal xml:lang="FR">Je suis tellement terrifié à l’idée d’échouer que je préfère ne pas essayer du tout, plutôt que de risquer un échec.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearOfFailure</IRI>
    <Literal xml:lang="EN">I'm so terrified of failing that I prefer not to try at all, rather than risk failure.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearOfFailure</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fear_of_negative_evaluation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearOfFailure</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Atychiphobie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearOfFailure</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearOfFailure</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfdefeatingProphecy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfdefeatingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfdefeatingProphecy</IRI>
    <Literal xml:lang="FR">Prophétie auto-destructrice</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfdefeatingProphecy</IRI>
    <Literal xml:lang="EN">Self-defeating prophecy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfdefeatingProphecy</IRI>
    <Literal xml:lang="FR">Vous faites une prédiction qui empêche ce qu’elle prédit de se réaliser.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfdefeatingProphecy</IRI>
    <Literal xml:lang="EN">Making a prediction that prevents what it predicts from happening.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfdefeatingProphecy</IRI>
    <Literal xml:lang="FR">Je vous parie que votre équipe ne pourra jamais terminer le projet à temps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfdefeatingProphecy</IRI>
    <Literal xml:lang="EN">I bet you your team will never be able to finish the project on time.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfdefeatingProphecy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Self-defeating_prophecy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfdefeatingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selfdefeatingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#endogenousSelffulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <Literal xml:lang="FR">Prophétie auto-réalisatrice exogène</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <Literal xml:lang="EN">Exogenous Self-Fulfilling Prophecy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <Literal xml:lang="FR">Vous formulez des prédictions sur des individus ou des groupes à partir d’attentes ou de stéréotypes externes, et ces prédictions finissent par influencer leur comportement ou leur réussite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <Literal xml:lang="EN">Making predictions about individuals or groups, based on external expectations or stereotypes, which end up influencing and determining their behavior or success.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <Literal xml:lang="FR">On répète à cette nouvelle équipe qu’elle ne fera jamais aussi bien que l’ancienne ; elle finit par perdre confiance et obtient de moins bons résultats.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <Literal xml:lang="EN">This new team is repeatedly told that it will never do as well as the old one; it eventually loses confidence and achieves poorer results.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#selffulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pygmalionEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pygmalionEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pygmalionEffect</IRI>
    <Literal xml:lang="FR">Appel à l’effet Pygmalion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pygmalionEffect</IRI>
    <Literal xml:lang="EN">Pygmalion effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pygmalionEffect</IRI>
    <Literal xml:lang="FR">Vous tentez d’influencer positivement le comportement de votre interlocuteur en l’assurant qu’il réussira, notamment parce qu’une personne d’autorité croit en sa réussite.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pygmalionEffect</IRI>
    <Literal xml:lang="EN">Relying on the fact that higher expectations placed upon individuals lead to better performance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pygmalionEffect</IRI>
    <Literal xml:lang="FR">Je sais que vous allez réussir cet examen : vous avez toujours été le meilleur de la classe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pygmalionEffect</IRI>
    <Literal xml:lang="EN">I know you're going to ace this exam, you've always been the top of your class.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pygmalionEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Pygmalion_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pygmalionEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_Pygmalion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pygmalionEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pygmalionEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#golemEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#golemEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#golemEffect</IRI>
    <Literal xml:lang="FR">Appel à l’effet Golem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#golemEffect</IRI>
    <Literal xml:lang="EN">Golem effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#golemEffect</IRI>
    <Literal xml:lang="FR">Vous tentez de réduire les chances de réussite de votre interlocuteur en lui faisant comprendre que vous ne croyez pas en son succès.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#golemEffect</IRI>
    <Literal xml:lang="EN">You attempt to reduce your interlocutor's chances of success by making them understand that you do not believe they will succeed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#golemEffect</IRI>
    <Literal xml:lang="FR">Vous n’êtes qu’un bon à rien, et vous finirez à la rue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#golemEffect</IRI>
    <Literal xml:lang="EN">You're nothing but a failure, and you'll end up in the streets.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#golemEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Golem_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#golemEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_Golem</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#golemEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#golemEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#matthewEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#matthewEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#matthewEffect</IRI>
    <Literal xml:lang="FR">Appel à l’effet Matthieu</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#matthewEffect</IRI>
    <Literal xml:lang="EN">Matthew effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#matthewEffect</IRI>
    <Literal xml:lang="FR">Vous influencez l’attitude d’autrui en partant de l’idée que ceux qui ont déjà des avantages sont plus susceptibles de réussir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#matthewEffect</IRI>
    <Literal xml:lang="EN">To influence the attitude of others based on the idea that those who already have advantages are more likely to succeed.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#matthewEffect</IRI>
    <Literal xml:lang="FR">Il vient d’une famille de médecins, il sera sûrement un excellent chirurgien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#matthewEffect</IRI>
    <Literal xml:lang="EN">He comes from a family of doctors; he's bound to be a great surgeon too.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#matthewEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Matthew_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#matthewEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_Matthieu</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#matthewEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#matthewEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#placeboEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#placeboEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#placeboEffect</IRI>
    <Literal xml:lang="FR">Appel à l’effet placebo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#placeboEffect</IRI>
    <Literal xml:lang="EN">Placebo effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#placeboEffect</IRI>
    <Literal xml:lang="FR">Vous faites croire qu’un faux remède peut être efficace, en jouant sur la croyance de votre auditoire pour améliorer une situation, sans aucune preuve réelle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#placeboEffect</IRI>
    <Literal xml:lang="EN">Rely on the belief in a fake remedy to improve a condition, despite no real evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#placeboEffect</IRI>
    <Literal xml:lang="FR">Buvez un verre d’eau tous les soirs et vous n’aurez plus jamais de migraine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#placeboEffect</IRI>
    <Literal xml:lang="EN">Drink a glass of water every night and you'll never have a headache again.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#placeboEffect</IRI>
    <Literal xml:lang="EN">http://skepdic.com/placebo.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#placeboEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#placeboEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noceboEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noceboEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noceboEffect</IRI>
    <Literal xml:lang="FR">Appel à l’effet nocebo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noceboEffect</IRI>
    <Literal xml:lang="EN">Nocebo effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noceboEffect</IRI>
    <Literal xml:lang="FR">Vous insinuez que la situation se dégradera avec une certaine solution, en pariant sur le pessimisme de la personne face à vous pour accentuer un problème fictif.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noceboEffect</IRI>
    <Literal xml:lang="EN">You insinuate that the situation will get worse with a certain solution, banking on the other person's pessimism to magnify a fictitious problem.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noceboEffect</IRI>
    <Literal xml:lang="FR">Si tu continues à travailler avec cette méthode, tu vas certainement échouer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noceboEffect</IRI>
    <Literal xml:lang="EN">If you keep working with this method, you will definitely fail.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noceboEffect</IRI>
    <Literal xml:lang="EN">http://skepdic.com/nocebo.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noceboEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#noceboEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#exogenousSelfFulfillingProphecy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
    <Literal xml:lang="FR">Appel à l’illusion perceptive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
    <Literal xml:lang="EN">Perception deception</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
    <Literal xml:lang="FR">Vous déformez sciemment la réalité à l’aide de trucages ou d’artifices afin de tromper les sens de quelqu’un.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
    <Literal xml:lang="EN">Deliberately distorting reality through tricks or artifices in order to deceive someone's senses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
    <Literal xml:lang="FR">Nous avons arrangé l’éclairage et les miroirs de notre magasin pour que chaque vêtement essayé semble parfaitement ajusté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
    <Literal xml:lang="EN">We've arranged the lighting and mirrors in our store so that every tried-on garment appears perfectly fitted.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
    <Literal xml:lang="EN">http://skepdic.com/refuge/ctlessons/lesson13.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusions</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusions</IRI>
    <Literal xml:lang="FR">Illusionnisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusions</IRI>
    <Literal xml:lang="EN">Illusions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusions</IRI>
    <Literal xml:lang="FR">Vous recourez à l’illusion pour faire accepter comme vraies des choses fausses ou trompeuses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusions</IRI>
    <Literal xml:lang="EN">Using illusion to make false or misleading things be accepted as true.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusions</IRI>
    <Literal xml:lang="FR">Un magicien déplace rapidement des cartes sur la table et laisse croire au spectateur qu’il choisit librement, alors qu’il oriente secrètement sa décision.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusions</IRI>
    <Literal xml:lang="EN">A magician swiftly moves the cards on the table, suggesting a free choice to the audience while secretly directing their decision.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusions</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Magic_(illusion)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusions</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Illusionnisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusions</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#illusions</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#photoManipulation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#photoManipulation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#photoManipulation</IRI>
    <Literal xml:lang="FR">Manipulation photographique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#photoManipulation</IRI>
    <Literal xml:lang="EN">Photo manipulation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#photoManipulation</IRI>
    <Literal xml:lang="FR">Vous modifiez des images pour présenter une réalité différente de celle d’origine.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#photoManipulation</IRI>
    <Literal xml:lang="EN">Altering images to present a reality different from the original one.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#photoManipulation</IRI>
    <Literal xml:lang="FR">En ajustant les couleurs et en modifiant légèrement les arrière-plans de nos photos de vacances, nous donnons l’impression que chaque destination est le paradis sur Terre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#photoManipulation</IRI>
    <Literal xml:lang="EN">By adjusting the colors and slightly altering the backgrounds in our vacation photos, we make each destination look like paradise on Earth.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#photoManipulation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Photo_manipulation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#photoManipulation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Retouche_d%27image</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#photoManipulation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#photoManipulation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#perceptionDeception</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <Literal xml:lang="FR">Influence subconsciente</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <Literal xml:lang="EN">Subconscious influence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <Literal xml:lang="FR">Vous exercez une influence subtile sur quelqu’un, sans que cette personne en prenne conscience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <Literal xml:lang="EN">Exercising a subtle influence on someone without their awareness.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <Literal xml:lang="FR">Remarquez comment la mélodie de cette publicité accompagne précisément le récit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <Literal xml:lang="EN">Notice how this advertisement's melody follows the narration closely.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
    <Literal xml:lang="FR">Induction hypnotique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
    <Literal xml:lang="EN">Hypnosis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
    <Literal xml:lang="FR">Vous utilisez des techniques de suggestion, comme l’hypnose, pour rendre une personne plus ouverte à vos idées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
    <Literal xml:lang="EN">Using suggestion techniques such as hypnosis to make a person more open to one's ideas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
    <Literal xml:lang="FR">Écoutez attentivement ma voix, laissez-vous emporter par mes paroles, et imaginez un monde où notre produit change votre vie...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
    <Literal xml:lang="EN">Listen carefully to my voice, let yourself be carried away by my words, and imagine a world where our product changes your life...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hypnosis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Hypnose</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertHypnosis</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertHypnosis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertHypnosis</IRI>
    <Literal xml:lang="FR">Hypnose conversationnelle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertHypnosis</IRI>
    <Literal xml:lang="EN">Covert Hypnosis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertHypnosis</IRI>
    <Literal xml:lang="FR">Vous utilisez des techniques de suggestion hypnotique dans une conversation ordinaire, sans que votre interlocuteur se rende compte qu’il est influencé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertHypnosis</IRI>
    <Literal xml:lang="EN">Using hypnotic suggestion techniques in everyday conversation, unbeknownst to the listener being influenced.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertHypnosis</IRI>
    <Literal xml:lang="FR">Vous semblez vraiment détendu en parlant de cela. Imaginez si vous pouviez ressentir cette tranquillité en permanence. Ce serait agréable, n’est-ce pas ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertHypnosis</IRI>
    <Literal xml:lang="EN">You seem really relaxed talking about this. Imagine if you could feel this calm all the time. That would be nice, wouldn't it?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertHypnosis</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Covert_hypnosis</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertHypnosis</IRI>
    <Literal xml:lang="FR">https://hansen-hypnose.com/vol-sous-hypnose-est-il-vraiment-possible-dhypnotiser-une-personne-sans-son-consentement/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertHypnosis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#covertHypnosis</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hypnosis</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subliminalStimuli</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subliminalStimuli</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subliminalStimuli</IRI>
    <Literal xml:lang="FR">Message subliminal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subliminalStimuli</IRI>
    <Literal xml:lang="EN">Subliminal stimuli</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subliminalStimuli</IRI>
    <Literal xml:lang="FR">Vous envoyez des signaux à peine perceptibles à votre interlocuteur pour modifier son comportement sans qu’il s’en rende compte.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subliminalStimuli</IRI>
    <Literal xml:lang="EN">Sending barely perceptible signals to an interlocutor to modify their behavior without their realizing it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subliminalStimuli</IRI>
    <Literal xml:lang="FR">Dans une publicité, la silhouette d’un verre de whisky transparaît parmi les glaçons. Sans la mentionner explicitement, la marque suggère ainsi subrepticement que consommer sa boisson apporte naturel et fraîcheur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subliminalStimuli</IRI>
    <Literal xml:lang="EN">In a commercial, the silhouette of a whiskey glass seems to subtly appear among the ice cubes. Without explicitly mentioning it, the brand thus covertly suggests that consuming their beverage offers naturalness and freshness.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subliminalStimuli</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Subliminal_stimuli</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subliminalStimuli</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Message_subliminal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subliminalStimuli</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subliminalStimuli</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="FR">Effet de l’expérimentateur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="EN">Experimenter effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="FR">Votre argumentation est influencée inconsciemment par vos propres attentes ou comportements envers le sujet discuté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="EN">Having one's argumentation unconsciously influenced by one's own expectations or behaviors towards the discussed topic.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="FR">Je vais maintenant vous demander de vous mettre à l’aise pour ce test.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="EN">I'm going to ask you to get comfortable for this test.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="EN">http://skepdic.com/experimentereffect.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <Literal xml:lang="FR">http://skepdic.com/experimentereffect.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#experimenterEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverHansEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverHansEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverHansEffect</IRI>
    <Literal xml:lang="FR">Effet Hans le malin</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverHansEffect</IRI>
    <Literal xml:lang="EN">Clever Hans effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverHansEffect</IRI>
    <Literal xml:lang="FR">Sans le vouloir, vous transmettez des indices qui modifient le comportement ou les réponses de votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverHansEffect</IRI>
    <Literal xml:lang="EN">Without realizing it, you give cues that change your interlocutor’s behavior or responses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverHansEffect</IRI>
    <Literal xml:lang="FR">Si ce cheval sait donner la bonne réponse, c’est qu’il sait compter et calculer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverHansEffect</IRI>
    <Literal xml:lang="EN">With the right cues, this horse can select the correct answer, leading one to believe it can count and calculate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverHansEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Clever_Hans</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverHansEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_Hans_le_Malin</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverHansEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverHansEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverLinda</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverLinda</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverLinda</IRI>
    <Literal xml:lang="FR">Appel à l’effet Linda</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverLinda</IRI>
    <Literal xml:lang="EN">Clever Linda</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverLinda</IRI>
    <Literal xml:lang="FR">Vous prétendez percevoir des signaux ou des informations cachés que les autres ne détectent pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverLinda</IRI>
    <Literal xml:lang="EN">Claiming to perceive signals which are not perceivable by others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverLinda</IRI>
    <Literal xml:lang="FR">En observant attentivement, je peux deviner à travers ses choix de mots qu’il est clairement stressé par la situation que vous nous imposez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverLinda</IRI>
    <Literal xml:lang="EN">By observing closely, I can infer from his choice of words that he is clearly stressed by the situation you're imposing on us.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverLinda</IRI>
    <Literal xml:lang="EN">http://skepdic.com/cleverlinda.html</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverLinda</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#cleverLinda</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#subconsciousInfluence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <Literal xml:lang="FR">Ingénierie sociale (politique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <Literal xml:lang="EN">Social Engineering (politics)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <Literal xml:lang="FR">Vous influencez subtilement les comportements et les décisions sociales au moyen de stratégies et de techniques diverses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <Literal xml:lang="EN">Subtly influencing social behaviors and decisions through various strategies and techniques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <Literal xml:lang="FR">En diffusant des rumeurs et des informations partiales, ils ont progressivement modifié la perception publique de l’initiative de réforme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <Literal xml:lang="EN">By spreading rumors and partial information, they gradually altered public perception of the reform initiative.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Social_engineering_(political_science)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Ing%C3%A9nierie_sociale_(science_politique)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#conditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nudge</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nudge</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nudge</IRI>
    <Literal xml:lang="FR">Incitation douce</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nudge</IRI>
    <Literal xml:lang="EN">Nudge</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nudge</IRI>
    <Literal xml:lang="FR">Vous orientez les choix des individus de manière non contraignante pour promouvoir des comportements bénéfiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nudge</IRI>
    <Literal xml:lang="EN">Steering individuals' choices in a non-forcing way to promote beneficial behaviors.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nudge</IRI>
    <Literal xml:lang="FR">En disposant des fruits à hauteur des yeux dans la cantine, ils ont incité les employés à choisir des options plus saines.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nudge</IRI>
    <Literal xml:lang="EN">By placing fruits at eye level in the cafeteria, they nudged employees towards healthier options.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nudge</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Nudge_theory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nudge</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Th%C3%A9orie_du_nudge</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nudge</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nudge</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
    <Literal xml:lang="FR">Interface truquée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
    <Literal xml:lang="EN">Dark pattern</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
    <Literal xml:lang="FR">Vous utilisez des techniques de conception trompeuses pour amener les utilisateurs à agir contre leur propre intérêt.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
    <Literal xml:lang="EN">Employing deceptive design techniques to manipulate users into actions against their own interests.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
    <Literal xml:lang="FR">Le site Web a utilisé des interfaces truquées en dissimulant les coûts additionnels en petits caractères, induisant ainsi les clients en erreur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
    <Literal xml:lang="EN">The website used dark patterns by hiding additional costs in fine print, misleading the customers.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Dark_pattern</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Dark_pattern</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clickbait</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clickbait</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clickbait</IRI>
    <Literal xml:lang="FR">Piège à clics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clickbait</IRI>
    <Literal xml:lang="EN">Clickbait</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clickbait</IRI>
    <Literal xml:lang="FR">Vous utilisez des titres accrocheurs ou trompeurs pour inciter les gens à cliquer sur un lien ou à regarder une vidéo.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clickbait</IRI>
    <Literal xml:lang="EN">Using catchy or misleading headlines to entice people to click on a link or watch a video.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clickbait</IRI>
    <Literal xml:lang="FR">Vous ne croirez jamais ce que cette célébrité a fait ! Cliquez ici pour découvrir !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clickbait</IRI>
    <Literal xml:lang="EN">You won't believe what this celebrity did! Click here to find out!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clickbait</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Clickbait</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clickbait</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pi%C3%A8ge_%C3%A0_clics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clickbait</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clickbait</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#darkPattern</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="FR">Culture de la peur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="EN">Fearmongering</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="FR">Vous répandez des rumeurs effrayantes et exagérées, sur un danger imminent, afin de susciter délibérément et inutilement la peur du public au sujet d’une question.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="EN">Spreading frightening and exaggerated rumors about imminent danger to deliberately and unnecessarily instill public fear about an issue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="FR">Savez-vous que l’eau du robinet est très rarement contrôlée et souvent contaminée, contrairement à cette eau minérale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="EN">Did you know that tap water is very rarely checked and often contaminated, unlike this bottled mineral water?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fearmongering</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Culture_de_la_peur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearmongering</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pushPoll</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pushPoll</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pushPoll</IRI>
    <Literal xml:lang="FR">Sondage orienté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pushPoll</IRI>
    <Literal xml:lang="EN">Push Poll</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pushPoll</IRI>
    <Literal xml:lang="FR">Vous utilisez un sondage pour influencer ou manipuler l’opinion publique en posant des questions biaisées ou suggestives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pushPoll</IRI>
    <Literal xml:lang="EN">Using a poll to influence or manipulate public opinion by asking biased or leading questions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pushPoll</IRI>
    <Literal xml:lang="FR">Seriez-vous favorable à un candidat sachant qu’il a été impliqué dans des scandales financiers ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pushPoll</IRI>
    <Literal xml:lang="EN">Would you be supportive of a candidate knowing that they have been involved in financial scandals?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pushPoll</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Push_poll</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pushPoll</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pushPoll</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(politics)</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <Literal xml:lang="FR">Jeu de pouvoir</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <Literal xml:lang="EN">Power games</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <Literal xml:lang="FR">Vous cherchez à influencer votre auditoire en exerçant un ascendant psychologique sur lui.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <Literal xml:lang="EN">Seeking to influence an audience by exerting psychological ascendancy over it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <Literal xml:lang="FR">Si votre amour pour moi est sincère, alors vous comprendrez ce que je vais vous expliquer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <Literal xml:lang="EN">If your love for me is sincere, then you will understand what I am about to explain to you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Power_and_control_in_abusive_relationships</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
    <Literal xml:lang="FR">Charme personnel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
    <Literal xml:lang="EN">Personal charm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
    <Literal xml:lang="FR">Vous utilisez votre charisme pour obtenir l’adhésion de votre auditoire à vos idées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
    <Literal xml:lang="EN">Using one's charisma to get one's audience to embrace one's ideas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
    <Literal xml:lang="FR">Après une si belle entrée en matière, je suis sûr que nous parviendrons à dépasser ce fâcheux différend.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
    <Literal xml:lang="EN">After such a fine opening, I am sure we will manage to get past this unfortunate disagreement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/48/Argument-by-Personal-Charm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <Literal xml:lang="FR">Ingratiation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <Literal xml:lang="EN">Ingratiation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <Literal xml:lang="FR">Vous cherchez à vous faire apprécier ou à obtenir des faveurs en flattant ou en louant votre interlocuteur de manière excessive ou peu sincère.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <Literal xml:lang="EN">Seeking to be appreciated or to obtain favors by flattering or praising one's interlocutor in an excessive or insincere manner.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <Literal xml:lang="FR">Votre opinion est toujours si perspicace. J’ai de la chance d’avoir un collègue aussi intelligent que vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <Literal xml:lang="EN">Your insight is always profound. It's my fortune to work alongside someone as enlightened as you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Ingratiation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
    <Literal xml:lang="FR">Vantardise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
    <Literal xml:lang="EN">Boasting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
    <Literal xml:lang="FR">Vous mettez en avant vos propres réalisations ou qualités, souvent de manière exagérée, pour impressionner les autres ou gagner leur admiration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
    <Literal xml:lang="EN">Putting forward one's own achievements or qualities, often in an exaggerated manner, to impress others or gain their admiration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
    <Literal xml:lang="FR">Lors de mon dernier projet, j’ai réalisé des bénéfices record. Certains disent que je transforme des idées en or.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
    <Literal xml:lang="EN">In my last project, I achieved record profits. Some say I turn ideas into gold.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Boasting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Vantardise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namedropping</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namedropping</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namedropping</IRI>
    <Literal xml:lang="FR">Mention de noms prestigieux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namedropping</IRI>
    <Literal xml:lang="EN">Name-dropping</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namedropping</IRI>
    <Literal xml:lang="FR">Vous mentionnez des personnes influentes ou célèbres que vous connaissez ou avez rencontrées, afin d’impressionner votre auditoire ou de gagner sa confiance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namedropping</IRI>
    <Literal xml:lang="EN">Mentioning names of influential or famous people one knows or has met, to impress or gain the trust of one's audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namedropping</IRI>
    <Literal xml:lang="FR">Lors de ma dernière réunion avec le maire, il a mentionné à quel point il apprécie mes idées. D’ailleurs, la semaine dernière, j’ai dîné avec un célèbre écrivain qui partageait la même opinion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namedropping</IRI>
    <Literal xml:lang="EN">In my last meeting with the mayor, he mentioned how much he appreciates my ideas. Also, last week I had dinner with a famous author who shared the same view.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namedropping</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Name-dropping</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namedropping</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Name_dropping</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namedropping</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namedropping</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rodomontade</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rodomontade</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rodomontade</IRI>
    <Literal xml:lang="FR">Fanfaronnade</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rodomontade</IRI>
    <Literal xml:lang="EN">Rodomontade</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rodomontade</IRI>
    <Literal xml:lang="FR">Vous vous vantez bruyamment ou faites des déclarations exagérées sur vos capacités ou vos exploits, souvent sans fondement réel.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rodomontade</IRI>
    <Literal xml:lang="EN">Bragging loudly or making exaggerated statements about one's abilities or achievements, often without real foundation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rodomontade</IRI>
    <Literal xml:lang="FR">Je suis le meilleur négociateur de la ville. J’ai réussi des accords que personne d’autre n’aurait même pu imaginer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rodomontade</IRI>
    <Literal xml:lang="EN">I'm the best negotiator in town. I've made deals that no one else could even dream of.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rodomontade</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Rodomontade</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rodomontade</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#rodomontade</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#boasting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loveBombing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loveBombing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loveBombing</IRI>
    <Literal xml:lang="FR">Bombardement d’amour</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loveBombing</IRI>
    <Literal xml:lang="EN">Love bombing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loveBombing</IRI>
    <Literal xml:lang="FR">Vous manifestez une affection intense pour amener les autres à vous suivre, même en l’absence de raisons valables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loveBombing</IRI>
    <Literal xml:lang="EN">Demonstrating a great deal of affection to persuade others to follow one's lead, even without valid reasons.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loveBombing</IRI>
    <Literal xml:lang="FR">Vous êtes une personne formidable. Vous verra-t-on samedi ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loveBombing</IRI>
    <Literal xml:lang="EN">You're such an amazing person. Will we see you on Saturday?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loveBombing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Love_bombing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loveBombing</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Love_bombing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loveBombing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#loveBombing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crocodileTears</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crocodileTears</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crocodileTears</IRI>
    <Literal xml:lang="FR">Larmes de crocodile</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crocodileTears</IRI>
    <Literal xml:lang="EN">Crocodile tears</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crocodileTears</IRI>
    <Literal xml:lang="FR">Vous feignez des émotions pour attendrir ou influencer ceux qui vous écoutent.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crocodileTears</IRI>
    <Literal xml:lang="EN">Feigning emotions to move or influence those who are listening.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crocodileTears</IRI>
    <Literal xml:lang="FR">Croyez-vous vraiment que je me satisfais de la situation ? Penser aux enfants qui souffrent me tient éveillé la nuit, et c’est pour cela que j’irai jusqu’au bout, quoi qu’en disent mes détracteurs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crocodileTears</IRI>
    <Literal xml:lang="EN">Do you really think I'm fully satisfied with this situation? Thinking about the suffering children keeps me awake at night, and that's why I will go all the way regardless of what my detractors say.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crocodileTears</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Crocodile_tears</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crocodileTears</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Larmes_de_crocodile</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crocodileTears</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crocodileTears</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionSeeking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionSeeking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionSeeking</IRI>
    <Literal xml:lang="FR">Recherche d’attention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionSeeking</IRI>
    <Literal xml:lang="EN">Attention Seeking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionSeeking</IRI>
    <Literal xml:lang="FR">Vous cherchez constamment à être le centre d’intérêt, en adoptant des comportements ou en racontant des histoires pour attirer l’attention sur vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionSeeking</IRI>
    <Literal xml:lang="EN">Constantly seeking to be the center of attention, adopting behaviors or telling stories to draw attention to oneself.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionSeeking</IRI>
    <Literal xml:lang="FR">Vous ne devinerez jamais ce qui m’est arrivé aujourd’hui ! J’ai rencontré une célébrité et elle m’a invité à dîner !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionSeeking</IRI>
    <Literal xml:lang="EN">You won't believe what happened to me today! I met a celebrity and they invited me to dinner!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionSeeking</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Attention_seeking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionSeeking</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Besoin_d%27attention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionSeeking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#attentionSeeking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ingratiation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flirt</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flirt</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flirt</IRI>
    <Literal xml:lang="FR">Flirt</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flirt</IRI>
    <Literal xml:lang="EN">Flirt</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flirt</IRI>
    <Literal xml:lang="FR">Vous usez de séduction pour gagner le soutien de votre interlocuteur, en détournant son jugement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flirt</IRI>
    <Literal xml:lang="EN">Using seduction to gain an interlocutor's support by diverting their judgment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flirt</IRI>
    <Literal xml:lang="FR">Vous êtes aussi critique que charmant, mais je suis sûr que ce produit saura gagner votre cœur exigeant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flirt</IRI>
    <Literal xml:lang="EN">You are as critical as you are charming, but I'm sure this product will win over your discerning heart.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flirt</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Flirting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flirt</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Flirt</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flirt</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flirt</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superficialCharm</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superficialCharm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superficialCharm</IRI>
    <Literal xml:lang="FR">Charme superficiel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superficialCharm</IRI>
    <Literal xml:lang="EN">Superficial Charm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superficialCharm</IRI>
    <Literal xml:lang="FR">Vous utilisez une séduction apparente et un charisme de surface pour persuader ou manipuler les autres, souvent sans véritable affection ou engagement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superficialCharm</IRI>
    <Literal xml:lang="EN">Using apparent seduction and surface charisma to persuade or manipulate others, often without real affection or commitment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superficialCharm</IRI>
    <Literal xml:lang="FR">Je sais toujours quoi dire pour plaire. Un sourire par ici, un compliment par là, et tout le monde est dans ma poche.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superficialCharm</IRI>
    <Literal xml:lang="EN">I always know just what to say to charm. A smile here, a compliment there, and everyone's wrapped around my finger.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superficialCharm</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Superficial_charm</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superficialCharm</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Charme_superficiel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superficialCharm</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#superficialCharm</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#personalCharm</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <Literal xml:lang="FR">Prise de contrôle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <Literal xml:lang="EN">Taking control</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <Literal xml:lang="FR">Vous cherchez à soumettre votre auditoire à vos avis sans faire appel à sa raison mais en induisant son comportement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <Literal xml:lang="EN">Seeking to subject the audience to one's views without appealing to their reason, but by inducing their behavior.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <Literal xml:lang="FR">Votre présence ici, jour après jour, montre votre engagement. Et vous savez qu’un bon employé est un employé engagé.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <Literal xml:lang="EN">Your presence here, day after day, shows your commitment. And you know that a good employee is a committed employee.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Compliance_gaining</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <Literal xml:lang="FR">Engagement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <Literal xml:lang="EN">Commitment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <Literal xml:lang="FR">Vous cherchez à influer sur le comportement de votre auditoire en l’invitant à assumer une responsabilité induite par votre proposition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <Literal xml:lang="EN">Seeking to influence the audience's behavior by inviting it to assume a responsibility induced by the proposal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <Literal xml:lang="FR">Puisque vous êtes favorables à la transition écologique, que ceux d’entre vous qui accepteront de prendre le train plutôt que l’avion pour leurs prochains déplacements lèvent la main. — Lewin (1947) : l’engagement public active l’acceptation privée, indépendamment du sujet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <Literal xml:lang="EN">Since you support the ecological transition, those of you who are willing to take the train rather than fly on your next trips, raise your hands. — Lewin (1947): public commitment activates private acceptance, regardless of the subject.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Compliance_(psychology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Engagement_(psychologie_sociale)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broadMatch" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#Waste_Inference_Conflict</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <Literal xml:lang="FR">Escalade d’engagement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <Literal xml:lang="EN">Escalation of commitment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <Literal xml:lang="FR">Vous amenez quelqu’un à accepter, étape par étape, des demandes de plus en plus importantes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <Literal xml:lang="EN">Encouraging someone to progressively commit to increasingly significant requests.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <Literal xml:lang="FR">Notre association commence par de petites actions avant de mener des projets de plus grande envergure. Aidez-nous d’abord à organiser ce petit événement communautaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <Literal xml:lang="EN">Our charity starts with small-scale projects before tackling larger initiatives. Support us with this minor community event.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Escalation_of_commitment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Escalade_d%27engagement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
    <Literal xml:lang="FR">Pied-dans-la-porte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
    <Literal xml:lang="EN">Foot in the door</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
    <Literal xml:lang="FR">Vous faites accepter une demande modeste à votre interlocuteur afin qu’il valide plus facilement la proposition plus coûteuse qui suivra.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
    <Literal xml:lang="EN">Securing agreement to a minor request as a precursor to gaining acceptance for a larger, related request.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
    <Literal xml:lang="FR">Vous avez déjà signé notre pétition pour les aires de jeux ; il serait logique que vous contribuiez aussi à la collecte de fonds pour la rénovation du parc, non ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
    <Literal xml:lang="EN">Having signed our petition for playground areas, would it not make sense for you to also contribute to the fundraising for the park renovation?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Foot-in-the-door_technique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pied-dans-la-porte</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitFootInTheDoor</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitFootInTheDoor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitFootInTheDoor</IRI>
    <Literal xml:lang="FR">Pied-dans-la-porte implicite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitFootInTheDoor</IRI>
    <Literal xml:lang="EN">Implicit foot in the door</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitFootInTheDoor</IRI>
    <Literal xml:lang="FR">Vous cherchez à obtenir un accord sur une petite demande pour ensuite faire accepter des requêtes plus importantes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitFootInTheDoor</IRI>
    <Literal xml:lang="EN">Securing agreement on smaller requests to gradually gain acceptance for larger ones.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitFootInTheDoor</IRI>
    <Literal xml:lang="FR">Si vous pouviez simplement nous laisser votre adresse e-mail pour recevoir notre newsletter, vous y trouverez notamment des offres exclusives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitFootInTheDoor</IRI>
    <Literal xml:lang="EN">If you could just leave us your email address for our newsletter, you'll find exclusive offers inside.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitFootInTheDoor</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Engagement_(psychologie_sociale)#Approche_implicite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitFootInTheDoor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#implicitFootInTheDoor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salamiTactic</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salamiTactic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salamiTactic</IRI>
    <Literal xml:lang="FR">Tactique du salami</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salamiTactic</IRI>
    <Literal xml:lang="EN">Salami tactic</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salamiTactic</IRI>
    <Literal xml:lang="FR">Vous parvenez peu à peu à vos fins en faisant accepter progressivement des points mineurs qui, cumulés, mènent à votre objectif principal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salamiTactic</IRI>
    <Literal xml:lang="EN">Achieving one's larger goals by gradually winning approval for smaller, associated tasks.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salamiTactic</IRI>
    <Literal xml:lang="FR">Nous avons fixé la réduction des coûts de production à 10 % ce trimestre, car vous avez largement prouvé que vous en êtes capables.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salamiTactic</IRI>
    <Literal xml:lang="EN">We set a 10% production cost reduction goal this quarter because you've clearly shown you can achieve it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salamiTactic</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Salami_tactics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salamiTactic</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salamiTactic</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheDoor</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lowball</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lowball</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lowball</IRI>
    <Literal xml:lang="FR">Amorçage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lowball</IRI>
    <Literal xml:lang="EN">Low-ball</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lowball</IRI>
    <Literal xml:lang="FR">Vous convainquez quelqu’un d’accepter une proposition en omettant sciemment des détails qui pourraient l’en dissuader</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lowball</IRI>
    <Literal xml:lang="EN">Convincing someone to accept a proposal while deliberately omitting details that might deter them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lowball</IRI>
    <Literal xml:lang="FR">Profitez immédiatement des avantages de norte abonnement premium. En ce moment, les 3 premiers mois sont gratuits sans engagement. C’est le moment d’essayer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lowball</IRI>
    <Literal xml:lang="EN">Take immediate advantage of our premium subscription benefits. Currently, the first 3 months are free with no commitment. It's the perfect time to try.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lowball</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Engagement_(psychologie_sociale)#L.27amor.C3.A7age</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lowball</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#lowball</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improvingTheDeal</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improvingTheDeal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improvingTheDeal</IRI>
    <Literal xml:lang="FR">Ce-n’est-pas-tout</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improvingTheDeal</IRI>
    <Literal xml:lang="EN">Improving the Deal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improvingTheDeal</IRI>
    <Literal xml:lang="FR">Vous présentez d’abord une offre peu attrayante, puis vous l’améliorez avant que votre interlocuteur ait le temps de décider.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improvingTheDeal</IRI>
    <Literal xml:lang="EN">Initially presenting an unattractive offer, then enhancing it before the counterpart has time to decide.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improvingTheDeal</IRI>
    <Literal xml:lang="FR">Mais pour ce prix, vous obtenez peut-être un voyage en Laponie, ainsi qu’une réduction sur votre prochain achat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improvingTheDeal</IRI>
    <Literal xml:lang="EN">But for this price, you might get a trip to Lapland, plus a discount on your next purchase.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improvingTheDeal</IRI>
    <Literal xml:lang="EN">https://www.scu.edu/media/college-of-arts-and-sciences/psychology/documents/Burger-JPSP-1986.pdf</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improvingTheDeal</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Engagement_(psychologie_sociale)#La_technique_du_ce-n.27est-pas-tout</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improvingTheDeal</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#improvingTheDeal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bait</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bait</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bait</IRI>
    <Literal xml:lang="FR">Leurre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bait</IRI>
    <Literal xml:lang="EN">Bait</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bait</IRI>
    <Literal xml:lang="FR">Vous séduisez votre auditoire avec une offre prometteuse, puis la changez pour arriver à vos fins.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bait</IRI>
    <Literal xml:lang="EN">Attracting the audience with a promising offer, then switching it to achieve one's own ends.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bait</IRI>
    <Literal xml:lang="FR">Le concert est annulé mais pour vous remercier d’être venu jusqu’ici, pourriez vous remplir cette feuille ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bait</IRI>
    <Literal xml:lang="EN">The concert is cancelled but to thank you for coming, could you fill out this form?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bait</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Engagement_(psychologie_sociale)#Le_leurre</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bait</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bait</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#escalationOfCommitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="FR">Sophisme des coûts irrécupérables</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="EN">Sunk Cost Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="FR">Vous persuadez de la nécessité d’investir d’avantage pour ne pas perdre ce qui a déjà été investi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="EN">Persuading of the necessity to invest more so as not to lose what has already been invested.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="FR">Vous avez investi tant de temps dans ce projet; il serait vraiment dommage de s’arrêter maintenant alors qu’il reste si peu à faire pour le compléter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="EN">You've invested so much time in this project; it would really be a shame to stop now when there's so little left to do to complete it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <Literal xml:lang="EN">https://www.logicallyfallacious.com/tools/lp/Bo/LogicalFallacies/173/Sunk-Cost-Fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bait</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sunkCostFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bait</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <Literal xml:lang="FR">Engagement induit</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <Literal xml:lang="EN">Induced commitment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <Literal xml:lang="FR">Vous amenez subtilement votre interlocuteur à s’engager, en renforçant progressivement son implication et son adhésion à vos propositions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <Literal xml:lang="EN">Subtly inducing an interlocutor to commit by strengthening their involvement and agreement with one's propositions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <Literal xml:lang="FR">Vous savez comme moi que ces réglementations sont essentielles, et je sais que je peux compter sur vous pour les adopter immédiatement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <Literal xml:lang="EN">You know as well as I do that these regulations are crucial, and I know I can count on you to adopt them immediately.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#commitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearAndRelief</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearAndRelief</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearAndRelief</IRI>
    <Literal xml:lang="FR">Crainte puis soulagement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearAndRelief</IRI>
    <Literal xml:lang="EN">Fear and relief</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearAndRelief</IRI>
    <Literal xml:lang="FR">Vous effrayez d’abord votre interlocuteur, puis vous le rassurez, ce qui le rend plus réceptif à votre influence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearAndRelief</IRI>
    <Literal xml:lang="EN">You first frighten the person you are speaking to, then reassure them, making them more receptive to your influence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearAndRelief</IRI>
    <Literal xml:lang="FR">Rassurez-vous, c’est pour votre bien que je vous ai dit tout cela. Si nous collaborons en bonne intelligence, nous pourrons probablement éviter le pire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearAndRelief</IRI>
    <Literal xml:lang="EN">Rest assured, it's for your own good that I've told you all this. If we cooperate intelligently, it's likely we can avoid the worst.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearAndRelief</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Engagement_(psychologie_sociale)#Technique_de_la_crainte-puis-soulagement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearAndRelief</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearAndRelief</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doorInTheFace</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doorInTheFace</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doorInTheFace</IRI>
    <Literal xml:lang="FR">Porte-au-nez</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doorInTheFace</IRI>
    <Literal xml:lang="EN">Door in the face</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doorInTheFace</IRI>
    <Literal xml:lang="FR">Vous faites d’abord une demande excessive, pour ensuite en faire une plus modeste et plus susceptible d’être acceptée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doorInTheFace</IRI>
    <Literal xml:lang="EN">Convincing someone to comply to a second request because it looks smaller than the first, extortionate one, which they had to decline.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doorInTheFace</IRI>
    <Literal xml:lang="FR">Je comprends que vous ne puissiez pas vous engager personnellement pour cette cause essentielle, mais peut-être qu’un petit don mensuel est à votre portée ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doorInTheFace</IRI>
    <Literal xml:lang="EN">I understand that you might not be able to personally commit to this essential cause, but maybe a small monthly donation would be more manageable?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doorInTheFace</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Door-in-the-face_technique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doorInTheFace</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Porte-au-nez</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearAndRelief</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doorInTheFace</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doorInTheFace</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fearAndRelief</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheMouth</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheMouth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheMouth</IRI>
    <Literal xml:lang="FR">Pied-dans-la-bouche</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheMouth</IRI>
    <Literal xml:lang="EN">Foot in the mouth</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheMouth</IRI>
    <Literal xml:lang="FR">Vous rendez votre demande plus acceptable en l’accompagnant de formules de politesse ou de marques d’attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheMouth</IRI>
    <Literal xml:lang="EN">You make your request more acceptable by accompanying it with polite phrases or signs of attentiveness.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheMouth</IRI>
    <Literal xml:lang="FR">Ah... J’ai oublié de vous compter les frais de déplacement. Comment va votre dame ? Je l’ai croisée au marché ; elle semblait bien embêtée par cette fuite. Elle est bien brave, votre dame...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheMouth</IRI>
    <Literal xml:lang="EN">Ah... I forgot to mention the travel expenses. How is your lady doing? I saw her at the market; she seemed quite troubled by that leak. She's very brave, your lady...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheMouth</IRI>
    <Literal xml:lang="EN">https://onlinelibrary.wiley.com/doi/abs/10.1111/j.1559-1816.1990.tb00399.x</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheMouth</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Engagement_(psychologie_sociale)#Technique_du_pied-dans-la-bouche</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheMouth</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footInTheMouth</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedHypocrisy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedHypocrisy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedHypocrisy</IRI>
    <Literal xml:lang="FR">Hypocrisie induite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedHypocrisy</IRI>
    <Literal xml:lang="EN">Induced hypocrisy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedHypocrisy</IRI>
    <Literal xml:lang="FR">Vous mettez en lumière les incohérences entre les paroles et les actions pour forcer un changement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedHypocrisy</IRI>
    <Literal xml:lang="EN">Highlighting someone's dissonance between their actions and discourse in order to make them change.
</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedHypocrisy</IRI>
    <Literal xml:lang="FR">Vous dites tous vouloir une ville propre, mais qui d’entre vous recycle vraiment? Montrez-moi ce que vous comptez faire pour changer les choses.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedHypocrisy</IRI>
    <Literal xml:lang="EN">You all say you want a clean city, but who among you really recycles? Show me what you plan to do to make a change.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedHypocrisy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Engagement_(psychologie_sociale)#L.E2.80.99hypocrisie_induite</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedHypocrisy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedHypocrisy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footinmemory</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footinmemory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footinmemory</IRI>
    <Literal xml:lang="FR">Pied-dans-la-mémoire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footinmemory</IRI>
    <Literal xml:lang="EN">Foot-in-memory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footinmemory</IRI>
    <Literal xml:lang="FR">Après avoir fait valider une norme, vous rappelez des comportements passés contraires pour pousser à l’application de cette norme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footinmemory</IRI>
    <Literal xml:lang="EN">After getting someone to endorse a norm, you remind them of past behavior that went against it to push them to apply that norm.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footinmemory</IRI>
    <Literal xml:lang="FR">Vous ne trouvez pas que depuis qu’on impose une limite de vitesse, vous vous sentez plus en sécurité ? Alors, si on l’abaissait encore, ça serait pas encore mieux pour nos enfants ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footinmemory</IRI>
    <Literal xml:lang="EN">Don't you find that ever since we imposed a speed limit, you feel safer? So, wouldn't it be even better for our children if we lowered it further?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footinmemory</IRI>
    <Literal xml:lang="EN">https://prezi.com/s9qrwgqui1ch/compliance-techniques/?webgl=0</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footinmemory</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Engagement_(psychologie_sociale)#La_technique_du_pied-dans-la-m.C3.A9moire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedHypocrisy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footinmemory</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#footinmemory</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedHypocrisy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#labelling</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#labelling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#labelling</IRI>
    <Literal xml:lang="FR">Étiquetage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#labelling</IRI>
    <Literal xml:lang="EN">Labelling</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#labelling</IRI>
    <Literal xml:lang="FR">Vous attribuez des qualités conformes à votre demande à votre interlocuteur pour obtenir son assentiment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#labelling</IRI>
    <Literal xml:lang="EN">Getting someone to comply by telling them that they are compliant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#labelling</IRI>
    <Literal xml:lang="FR">Je sais que tu es un battant, et les battants ne lâchent jamais jusqu’au dernier coup de sifflet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#labelling</IRI>
    <Literal xml:lang="EN">I know you're a fighter, and fighters never give up until the final whistle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#labelling</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Labeling_theory</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#labelling</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Engagement_(psychologie_sociale)#Technique_de_l.27.C3.A9tiquetage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#labelling</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#labelling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#callToFreedom</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#callToFreedom</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#callToFreedom</IRI>
    <Literal xml:lang="FR">Appel à la liberté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#callToFreedom</IRI>
    <Literal xml:lang="EN">Call to freedom</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#callToFreedom</IRI>
    <Literal xml:lang="FR">Vous rappelez à votre interlocuteur sa liberté de choix pour l’inciter à accepter votre proposition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#callToFreedom</IRI>
    <Literal xml:lang="EN">Winning someone's agreement by reminding them that they are free to agree or not.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#callToFreedom</IRI>
    <Literal xml:lang="FR">Maintenant, si certains d’entre vous ne sont toujours pas convaincus, vous êtes absolument libre de repartir sans notre produit et nous aurons pris un grand plaisir à vous le présenter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#callToFreedom</IRI>
    <Literal xml:lang="EN">Now, if any of you are still not convinced, you are absolutely free to leave without buying our product, and we would still have been pleased to present it to you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#callToFreedom</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Engagement_(psychologie_sociale)#La_technique_du_mais-vous-.C3.AAtes-libre-de</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#callToFreedom</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#callToFreedom</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anythingHelps</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anythingHelps</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anythingHelps</IRI>
    <Literal xml:lang="FR">Un-peu-c’est-mieux-que-rien</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anythingHelps</IRI>
    <Literal xml:lang="EN">Anything helps</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anythingHelps</IRI>
    <Literal xml:lang="FR">Vous suggérez que toute aide, même minime, est appréciée pour encourager le soutien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anythingHelps</IRI>
    <Literal xml:lang="EN">Suggesting that any help, however minimal, is appreciated in order to encourage support.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anythingHelps</IRI>
    <Literal xml:lang="FR">J’en appelle à votre générosité quelque soit votre situation: Chaque centime compte ; même une petite somme peut faire la différence !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anythingHelps</IRI>
    <Literal xml:lang="EN">I appeal to your generosity no matter your situation: Every cent counts; even a small amount can make a difference!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anythingHelps</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Engagement_(psychologie_sociale)#La_technique_du_un-peu-c.27est-mieux-que-rien</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#callToFreedom</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anythingHelps</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#anythingHelps</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#callToFreedom</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#touching</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#touching</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#touching</IRI>
    <Literal xml:lang="FR">Toucher</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#touching</IRI>
    <Literal xml:lang="EN">Touching</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#touching</IRI>
    <Literal xml:lang="FR">Vous utilisez un contact physique léger pour rendre votre demande plus convaincante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#touching</IRI>
    <Literal xml:lang="EN">Using body contact to induce compliance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#touching</IRI>
    <Literal xml:lang="FR">Allez, Jean, je compte sur toi pour ne pas nous décevoir (avec tape sur l’épaule).</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#touching</IRI>
    <Literal xml:lang="EN">Come on, Jean, I'm counting on you not to let us down (with a pat on the shoulder).</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#touching</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Engagement_(psychologie_sociale)#Le_toucher</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#touching</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#touching</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="FR">Piège de gratitude</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="EN">Gratitude trap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="FR">Vous vous sentez coupable ou frustré parce que vous pensez que vous devriez être plus reconnaissant dans votre situation actuelle, ou vous utilisez ce sentiment d’autrui pour asseoir votre contrôle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="EN">Feeling guilty or frustrated because one thinks one should be more grateful in one's current situation, or using this feeling in others to assert control.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="FR">Je devrais être heureux d’avoir un emploi, même si je le déteste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="EN">I should be happy to have a job, even though I hate it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Gratitude_trap</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gratitudeTrap</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#inducedCommitment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disruptThenReframe</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disruptThenReframe</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disruptThenReframe</IRI>
    <Literal xml:lang="FR">Perturbation-recadrage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disruptThenReframe</IRI>
    <Literal xml:lang="EN">Disrupt then Reframe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disruptThenReframe</IRI>
    <Literal xml:lang="FR">Vous commencez par déstabiliser votre interlocuteur avec un message déroutant, puis vous reformulez votre demande de façon plus acceptable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disruptThenReframe</IRI>
    <Literal xml:lang="EN">First destabilizing an interlocutor with a disorienting message, then reformulating the request in a more acceptable way.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disruptThenReframe</IRI>
    <Literal xml:lang="FR">Je sais, le prix paraît élevé, mais nous avons aussi un modèle maison qui devrait convenir à votre budget et n’a pas grand-chose à envier à ce très beau modèle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disruptThenReframe</IRI>
    <Literal xml:lang="EN">I know, the price seems high, but we also have an in-house model that should fit your budget and compares very favorably with this beautiful model.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disruptThenReframe</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Compliance_gaining#Disrupt-then-reframe_.28DTR.29</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disruptThenReframe</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#disruptThenReframe</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persistence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persistence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persistence</IRI>
    <Literal xml:lang="FR">Persistance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persistence</IRI>
    <Literal xml:lang="EN">Persistence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persistence</IRI>
    <Literal xml:lang="FR">Vous répétez le même message à plusieurs reprises afin d’obtenir l’adhésion ou l’obéissance de votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persistence</IRI>
    <Literal xml:lang="EN">Achieving compliance by repetitively delivering the same message.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persistence</IRI>
    <Literal xml:lang="FR">Comme je vous l’ai déjà dit à de nombreuses reprises, nous devons tous suivre les nouvelles règles, aussi dures soient-elles, et je ne transigerai pas. C’est essentiel pour notre communauté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persistence</IRI>
    <Literal xml:lang="EN">As I've already repeated many times, we all need to follow the new rules, no matter how hard they might be, and I will not make any exceptions. It's essential for our community.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persistence</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Compliance_gaining#Persistence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persistence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persistence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justonemore</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justonemore</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justonemore</IRI>
    <Literal xml:lang="FR">Appel au dernier effort</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justonemore</IRI>
    <Literal xml:lang="EN">Just-one-more</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justonemore</IRI>
    <Literal xml:lang="FR">Vous cherchez à obtenir l’accord de votre interlocuteur en lui présentant son aide comme le dernier effort nécessaire pour atteindre votre objectif.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justonemore</IRI>
    <Literal xml:lang="EN">Seeking to obtain an interlocutor's agreement by presenting their help as the final effort needed to achieve one's objective.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justonemore</IRI>
    <Literal xml:lang="FR">Nous avons déjà tant accompli ; il ne nous manque plus que votre expertise sur cette dernière partie, et vous contribuerez à faire de ce projet un succès.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justonemore</IRI>
    <Literal xml:lang="EN">We've come so far, all that's left is your expertise on this final part, and you will crown this project with success.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justonemore</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Compliance_gaining#Just-One-More_.28JOM.29</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justonemore</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#justonemore</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(security)</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(security)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(security)</IRI>
    <Literal xml:lang="FR">Ingénierie sociale (sécurité)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(security)</IRI>
    <Literal xml:lang="EN">Social Engineering (security)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(security)</IRI>
    <Literal xml:lang="FR">Vous manipulez psychologiquement des personnes pour les amener à effectuer des actions ou à divulguer des informations confidentielles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(security)</IRI>
    <Literal xml:lang="EN">Psychologically manipulating people into performing actions or divulging confidential information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(security)</IRI>
    <Literal xml:lang="FR">Bonjour, ici Jean de l’équipe informatique. Nous faisons une mise à jour de sécurité et avons besoin de vérifier vos identifiants. Pouvez-vous me confirmer votre mot de passe, s’il vous plaît ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(security)</IRI>
    <Literal xml:lang="EN">Hi, this is John from IT. We're doing a security update and need to verify your credentials. Can you confirm your password for me, please?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(security)</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Social_engineering_(security)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(security)</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Ing%C3%A9nierie_sociale_(s%C3%A9curit%C3%A9_de_l%27information)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(security)</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialEngineering(security)</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#takingControl</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <Literal xml:lang="FR">Jeu psychologique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <Literal xml:lang="EN">Mind games</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <Literal xml:lang="FR">Vous déstabilisez votre interlocuteur par des messages ambigus ou déroutants afin de mieux influencer sa réaction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <Literal xml:lang="EN">Destabilizing an interlocutor through ambiguous or confusing messages in order to better influence their reaction.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <Literal xml:lang="FR">Je vous remercie pour votre excellent travail, c’est admirable. Pensez-vous pouvoir faire encore mieux au prochain trimestre ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <Literal xml:lang="EN">I thank you for your excellent work, it's truly admirable. Now, do you think you can do even better for the next quarter?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Mind_games</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Analyse_transactionnelle#Jeux_psychologiques</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <Literal xml:lang="FR">Déstabilisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <Literal xml:lang="EN">Destabilization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <Literal xml:lang="FR">Vous semez le doute ou la confusion chez votre interlocuteur pour compromettre ses facultés perceptives.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <Literal xml:lang="EN">Sowing doubt or confusion in one's interlocutor to compromise their perceptual faculties.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <Literal xml:lang="FR">Vous dites que je vous ai promis cela ? Vous devez confondre : je n’ai jamais dit une chose pareille.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <Literal xml:lang="EN">Are you saying I promised you that? You must be confusing things: I never said anything like that.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Destabilisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
    <Literal xml:lang="FR">Appel à l’effet Stroop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
    <Literal xml:lang="EN">Stroop effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
    <Literal xml:lang="FR">Vous perturbez l’attention de votre auditoire avec des informations non pertinentes afin de compromettre sa concentration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
    <Literal xml:lang="EN">Providing irrelevant information to disrupt the focus of an audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
    <Literal xml:lang="FR">Je repense aux dates que vous m’avez proposées — cette cravate ne vous va vraiment pas — et j’aurais besoin que vous les décaliez. Vous devriez cesser de la porter. La semaine suivante vous conviendrait-elle ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
    <Literal xml:lang="EN">I think about those dates you suggested to me, that tie really doesn't suit you, I need you to move them, you should stop wearing it, would the following week suit you?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Stroop_effect</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Effet_Stroop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gaslighting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gaslighting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gaslighting</IRI>
    <Literal xml:lang="FR">Effet gaslighting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gaslighting</IRI>
    <Literal xml:lang="EN">Gaslighting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gaslighting</IRI>
    <Literal xml:lang="FR">Vous manipulez sciemment la réalité pour faire douter quelqu’un de ses propres souvenirs ou perceptions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gaslighting</IRI>
    <Literal xml:lang="EN">Intentionnaly making a targeted individual or members of a group question their own memory, perception, and sanity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gaslighting</IRI>
    <Literal xml:lang="FR">Vous ne vous souvenez pas que vous m’aviez promis de venir à cette réunion ? Vous oubliez souvent ce que vous dites, c’est inquiétant. Peut-être devriez-vous faire plus attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gaslighting</IRI>
    <Literal xml:lang="EN">Don't you remember you promised to come to this meeting? You often forget what you say, which is concerning. Maybe you should take more care.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gaslighting</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Gaslighting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gaslighting</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gaslighting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gaslighting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gaslighting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="FR">Lance à incendie du mensonge</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="EN">Firehose of falsehood</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="FR">Vous diffusez en masse des messages répétés sur de multiples canaux (médias, réseaux sociaux), sans souci de vérité ni de cohérence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="EN">Rapid, repetitive, and continuous broadcasting of a large number of messages across various channels, such as news and social media, without regard for truth or consistency, in order to overwhelm the audience, making it difficult to discern truth amidst the torrent of conflicting information.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="FR">Les canaux officiels du gouvernement, appuyés par une armée de bots et de comptes anonymes, publient une avalanche de rapports contradictoires sur la situation économique. Ces messages se contredisent, inondent l’espace d’information et rendent les véritables conditions économiques impossibles à comprendre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="EN">The government's official channels, supported by an army of online bots and anonymous accounts, release a barrage of conflicting reports about the economic situation, each contradicting the other, flooding the information space and making it impossible to understand the real economic conditions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Firehose_of_falsehood</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Lance_%C3%A0_incendie_du_mensonge</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#firehoseOfFalsehood</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stroopEffect</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
    <Literal xml:lang="FR">Culpabilisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
    <Literal xml:lang="EN">Guilt Induction</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
    <Literal xml:lang="FR">Vous manipulez une personne en utilisant sa culpabilité pour la faire agir comme vous le souhaitez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
    <Literal xml:lang="EN">Using someone's guilt to make them act accordingly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
    <Literal xml:lang="FR">Vous savez, j’ai passé toute la semaine à préparer cet événement. Si vous n’y assistez pas, ce sera une énorme déception.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
    <Literal xml:lang="EN">You know, I spent the whole week preparing for this event. If you don't attend, it will be a huge disappointment.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Guilt_(emotion)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltive</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltive</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltive</IRI>
    <Literal xml:lang="FR">Culpabilisation passive-agressive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltive</IRI>
    <Literal xml:lang="EN">Guiltive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltive</IRI>
    <Literal xml:lang="FR">Vous vous présentez ouvertement comme généreux ou indifférent, tout en signifiant en réalité le contraire, dans le but de faire culpabiliser votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltive</IRI>
    <Literal xml:lang="EN">Overtly presenting oneself as generous or indifferent but actually meaning the opposite, with the intention of making the addressee feel guilty.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltive</IRI>
    <Literal xml:lang="FR">Ne vous inquiétez pas pour moi, je vais bien. Continuez à sortir avec vos amis ; je resterai seul à la maison, cela ne me dérange pas du tout.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltive</IRI>
    <Literal xml:lang="EN">Don't worry about me, I'm fine. Go ahead and hang out with your friends, I'll just stay home alone, it doesn't bother me at all.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltive</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Guiltive</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltive</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltive</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltTrip</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltTrip</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltTrip</IRI>
    <Literal xml:lang="FR">Voyage de culpabilité</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltTrip</IRI>
    <Literal xml:lang="EN">Guilt trip</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltTrip</IRI>
    <Literal xml:lang="FR">Vous manipulez quelqu’un en l’accablant de culpabilité pour l’inciter à agir selon vos désirs ou pour le faire se sentir responsable de quelque chose qu’il n’a pas commis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltTrip</IRI>
    <Literal xml:lang="EN">Manipulating someone by overwhelming them with guilt to coerce them into acting as desired or to make them feel responsible for something they haven't done.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltTrip</IRI>
    <Literal xml:lang="FR">Je ne peux pas croire que tu refuses de m’aider après tout ce que j’ai fait pour toi. Je me suis toujours sacrifié pour toi, et maintenant que j’ai besoin de ton aide, tu t’en laves les mains ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltTrip</IRI>
    <Literal xml:lang="EN">I can't believe you're refusing to help me after all I've done for you. I've always sacrificed for you, and now when I need your help, you're just washing your hands of it?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltTrip</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltTrip</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBlackmail</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBlackmail</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBlackmail</IRI>
    <Literal xml:lang="FR">Chantage affectif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBlackmail</IRI>
    <Literal xml:lang="EN">Emotional Blackmail</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBlackmail</IRI>
    <Literal xml:lang="FR">Vous exercez une pression directe sur quelqu’un en exploitant ses sentiments de peur, d’obligation ou de culpabilité, souvent par des transactions claires ou des ultimatums.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBlackmail</IRI>
    <Literal xml:lang="EN">Putting direct pressure on someone by exploiting their feelings of fear, obligation, or guilt, often through clear deals or ultimatums.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBlackmail</IRI>
    <Literal xml:lang="FR">Si tu m’aimes vraiment, tu arrêteras de fréquenter ces bon à rien, et tu me ramèneras de meilleures notes de l’école.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBlackmail</IRI>
    <Literal xml:lang="EN">If you really love me, you'll stop hanging out with these deadbeats, and you'll bring me better grades from school.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBlackmail</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Emotional_blackmail</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBlackmail</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Chantage_%C3%A9motionnel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBlackmail</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#emotionalBlackmail</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#guiltInduction</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demoralization</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demoralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demoralization</IRI>
    <Literal xml:lang="FR">Démoralisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demoralization</IRI>
    <Literal xml:lang="EN">Demoralization</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demoralization</IRI>
    <Literal xml:lang="FR">Vous cherchez à faire perdre confiance ou courage à votre adversaire afin de le pousser à abandonner le débat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demoralization</IRI>
    <Literal xml:lang="EN">Seeking to make an opponent lose confidence or courage in order to make them give up the debate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demoralization</IRI>
    <Literal xml:lang="FR">Votre cause est sans espoir. Tout au plus verserez-vous votre sang en vain.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demoralization</IRI>
    <Literal xml:lang="EN">Your cause is hopeless. You'll merely spill your blood in vain.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demoralization</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Demoralization_(warfare)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demoralization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#demoralization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <Literal xml:lang="FR">Intimidation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <Literal xml:lang="EN">Intimidation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <Literal xml:lang="FR">Vous utilisez la peur ou les menaces pour forcer la conformité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <Literal xml:lang="EN">Employing fear or threats to compel conformity or silence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <Literal xml:lang="FR">Si tu ne suis pas mes instructions, tu risques gros.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <Literal xml:lang="EN">If you don't follow my instructions, you risk a lot.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Intimidation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Intimidation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
    <Literal xml:lang="FR">Coercition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
    <Literal xml:lang="EN">Coercion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
    <Literal xml:lang="FR">Vous usez de la contrainte pour forcer quelqu’un à agir ou à s’absternir de le faire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
    <Literal xml:lang="EN">Using coercion to force someone into action or to desist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
    <Literal xml:lang="FR">Si tu ne change pas de comportement, je vais me facher.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
    <Literal xml:lang="EN">If you don't change your behavior, I'm going to get angry.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Coercion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Coercition</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="FR">Argument du bâton</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="EN">Appeal to the stick</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="FR">Vous utilisez la menace pour gagner un argument au lieu de le prouver par la raison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="EN">Using threat to force someone's agreement with a proposition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="FR">Si tu ne me laisses pas la dernière tranche de jambon, tu le paieras très cher.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="EN">If you don't let me have the last slice of ham, you will pay dearly for it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Argumentum_ad_baculum</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#appealToTheStick</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#coercion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humiliation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humiliation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humiliation</IRI>
    <Literal xml:lang="FR">Humiliation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humiliation</IRI>
    <Literal xml:lang="EN">Humiliation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humiliation</IRI>
    <Literal xml:lang="FR">Vous utilisez la dégradation et l’humiliation pour manipuler autrui.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humiliation</IRI>
    <Literal xml:lang="EN">Using degradation and humiliation as a means of manipulation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humiliation</IRI>
    <Literal xml:lang="FR">Regardez, voici quelqu’un qui ne sait même pas faire une addition simple !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humiliation</IRI>
    <Literal xml:lang="EN">Look everyone, here's someone who can't even add simple numbers!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humiliation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Humiliation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humiliation</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Humiliation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humiliation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#humiliation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbalAbuse</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbalAbuse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbalAbuse</IRI>
    <Literal xml:lang="FR">Abus Verbal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbalAbuse</IRI>
    <Literal xml:lang="EN">Verbal Abuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbalAbuse</IRI>
    <Literal xml:lang="FR">Vous recourez à des attaques verbales pour intimider ou dominer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbalAbuse</IRI>
    <Literal xml:lang="EN">Resorting to verbal attacks to intimidate or dominate.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbalAbuse</IRI>
    <Literal xml:lang="FR">Si tu n’étais pas si incompétent, nous n’en serions pas là !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbalAbuse</IRI>
    <Literal xml:lang="EN">If you weren't so incompetent, we wouldn't be in this situation!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbalAbuse</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Verbal_abuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbalAbuse</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Abus_verbal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbalAbuse</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#verbalAbuse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#intimidation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turnTheTables</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turnTheTables</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turnTheTables</IRI>
    <Literal xml:lang="FR">Cannibalisme dialectique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turnTheTables</IRI>
    <Literal xml:lang="EN">Turn the tables</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turnTheTables</IRI>
    <Literal xml:lang="FR">Vous utilisez l’argument de l’autre pour le retourner contre lui de manière fallacieuse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turnTheTables</IRI>
    <Literal xml:lang="EN">Using an opponent's argument to his or her disadvantage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turnTheTables</IRI>
    <Literal xml:lang="FR">C’est justement parce que c’est un enfant qu’il faut être particulièrement sévère avec lui.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turnTheTables</IRI>
    <Literal xml:lang="EN">It's because he's a child that we need to be especially stern with him.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turnTheTables</IRI>
    <Literal xml:lang="EN">https://en.wikisource.org/wiki/The_Art_of_Being_Right#Turn_The_Tables</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turnTheTables</IRI>
    <Literal xml:lang="FR">https://fr.wikisource.org/wiki/L%E2%80%99Art_d%E2%80%99avoir_toujours_raison/Stratag%C3%A8me_XXVI</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turnTheTables</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#turnTheTables</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#destabilization</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <Literal xml:lang="FR">Tactiques de pression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <Literal xml:lang="EN">Pressure Tactics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <Literal xml:lang="FR">Vous exercez une pression constante sur quelqu’un afin de le contraindre à se plier à vos attentes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <Literal xml:lang="EN">Exerting constant pressure to compel someone into compliance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <Literal xml:lang="FR">Le responsable évoquait sans cesse d’éventuels licenciements pour pousser l’équipe à faire des heures supplémentaires.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <Literal xml:lang="EN">The manager kept mentioning potential layoffs to pressure the team into working overtime.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Psychological_stress</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Stress_chez_l%27humain</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#catandmouseGame</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#catandmouseGame</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#catandmouseGame</IRI>
    <Literal xml:lang="FR">Jeu du chat et de la souris</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#catandmouseGame</IRI>
    <Literal xml:lang="EN">Cat-and-mouse game</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#catandmouseGame</IRI>
    <Literal xml:lang="FR">Vous insistez sur chaque objection soulevée pour mieux asseoir votre point de vue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#catandmouseGame</IRI>
    <Literal xml:lang="EN">Insisting on every objection raised to better establish one's point of view.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#catandmouseGame</IRI>
    <Literal xml:lang="FR">Mais si tout ce que vous dites est vrai, pourquoi ne pas simplement accepter l’accord tel qu’il est proposé actuellement ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#catandmouseGame</IRI>
    <Literal xml:lang="EN">But if everything you say is true, why not simply accept the agreement as it is currently proposed?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#catandmouseGame</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Compliance_gaining#Dump_and_chase_.28DAC.29</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#catandmouseGame</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#catandmouseGame</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <Literal xml:lang="FR">Pression répétée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <Literal xml:lang="EN">Nagging</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <Literal xml:lang="FR">Vous répétez la même demande jusqu’à lasser ou agacer votre interlocuteur, afin qu’il finisse par céder.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <Literal xml:lang="EN">Persistently expressing the same request to an interlocutor to irritate them sufficiently until they concede to the request.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <Literal xml:lang="FR">Vous ne m’avez toujours pas dit comment vous ferez sans cette nouvelle protection que nous vous proposons en cas de sinistre. Vous jouez avec le feu, et vous le savez.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <Literal xml:lang="EN">You still haven't told me how you'll manage without this new protection we're offering you in the event of a loss. You're playing with fire, and you know it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Nagging</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="FR">Gish gallop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="EN">Gish gallop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="FR">Vous submergez votre interlocuteur avec un flot rapide et continu d’arguments et de réclamations, rendant difficile une réfutation complète et réfléchie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="EN">Overwhelm the interlocutor with a rapid and continuous flow of arguments, making it difficult for a full and thoughtful rebuttal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="FR">Comment pouvez-vous être compétent si vous ne répondez même pas à mes arguments sur la fiscalité, l’éducation, la santé, et l’environnement ? Et je n’ai même pas encore abordé la politique étrangère !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="EN">How can you claim to be competent if you can't even address my arguments on taxation, education, health, and the environment? And I haven't even started on foreign policy yet!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="EN">https://rationalwiki.org/wiki/Gish_Gallop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Gish_gallop</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gishGallop</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="FR">Répandage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="EN">Spreading</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="FR">Vous parlez extrêmement vite pour présenter un maximum d’arguments en un minimum de temps, rendant difficile pour l’adversaire de répondre à tous les points.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="EN">Speaking rapidly to present as many arguments as possible in the least amount of time, making it difficult for the opponent to respond to all points.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="FR">Mon adversaire devrait maintenant répondre à mes arguments sur diverses politiques économiques, sociales et environnementales,
couvrant les implications à court et à long terme, les impacts sur les personnes vulnérables
populations, considérations géopolitiques et aspects juridiques et éthiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="EN">My opponent should now answer my arguments about various economic, social, and environmental policies,
covering implications in the short and long term, impacts on vulnerable
populations, geopolitical considerations, and legal and ethical aspects.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Spreading_(debate)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#spreading</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="FR">Sophisme sur-le-champ</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="EN">On the spot fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="FR">Vous considérez votre interlocuteur comme incompétent s’il ne peut pas réciter des données spécifiques ou des détails techniques sur un sujet.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="EN">Considering an interlocutor incompetent if they cannot recite specific data or technical details on a subject.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="FR">Si vous ne pouvez pas me citer les dernières statistiques sur la croissance économique, alors votre point de vue sur la politique économique n’est pas valide.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="EN">If you can't quote the latest economic growth statistics, then your views on economic policy are invalid.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <Literal xml:lang="EN">http://rationalwiki.org/wiki/On_the_spot_fallacy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#onTheSpotFallacy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="FR">Lavage de cerveau</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="EN">Brainwashing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="FR">Vous employez une combinaison de répétition intensive et de manipulation psychologique pour influencer ou changer radicalement les opinions et les croyances d’une personne.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="EN">Using a combination of intense repetition and psychological manipulation to significantly influence or alter someone's beliefs or opinions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="FR">Je comprends que vous soyez sceptique, mais pensez-y chaque soir avant de dormir et vous verrez que ma théorie est la seule qui tient la route.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="EN">I understand you're skeptical, but think about it every night before you sleep and you'll see my theory is the only one that makes sense.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Brainwashing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Lavage_de_cerveau</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#brainwashing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nagging</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <Literal xml:lang="FR">Harcèlement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <Literal xml:lang="EN">Harassment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <Literal xml:lang="FR">Vous exercez une pression constante pour affaiblir psychologiquement l’autre.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <Literal xml:lang="EN">Repeatedly behaving in ways which undermine a person's psychology, in order to make her more compliant.
</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <Literal xml:lang="FR">Il faut que tu te ressaisses. Les réponses à mes emails de la semaine dernière n’étaient clairement pas à la hauteur, je serai obligé de parler de ton attitude au directeur si tu continues à ignorer mes appels quand tu pars du bureau</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <Literal xml:lang="EN">I'll need to step up your game. Last week's email responses were clearly not up to scratch, and I will have to discuss your attitude with the manager if you continue to ignore my calls when you leave the office.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Harassment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Harc%C3%A8lement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#pressureTactics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sealioning</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sealioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sealioning</IRI>
    <Literal xml:lang="FR">Sealioning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sealioning</IRI>
    <Literal xml:lang="EN">Sealioning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sealioning</IRI>
    <Literal xml:lang="FR">Vous feignez l’ignorance et posez des questions répétitives et insistantes sous couvert de recherche sincère, dans le but de déstabiliser ou d’exaspérer votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sealioning</IRI>
    <Literal xml:lang="EN">Feigning ignorance and repeatedly asking questions under the guise of earnest inquiry, aiming to destabilize or exasperate the interlocutor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sealioning</IRI>
    <Literal xml:lang="FR">Pourriez-vous m’expliquer encore une fois pourquoi c’est offensant ? Et là, qu’est-ce que ça signifie exactement ? Je veux juste comprendre, pouvez-vous clarifier ce point ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sealioning</IRI>
    <Literal xml:lang="EN">Could you explain to me again why this is offensive? And what does that mean exactly? I just want to understand, can you clarify this point?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sealioning</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sealioning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sealioning</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Sealioning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sealioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sealioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
    <Literal xml:lang="FR">Harcèlement Sexuel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
    <Literal xml:lang="EN">Sexual bullying</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
    <Literal xml:lang="FR">Vous utilisez des comportements, commentaires ou suggestions à connotation sexuelle pour intimider ou embarrasser quelqu’un, souvent dans un cadre professionnel ou éducatif.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
    <Literal xml:lang="EN">Using behaviors, comments, or suggestions of a sexual nature to intimidate or embarrass someone, often in a professional or educational setting.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
    <Literal xml:lang="FR">Tu sais, si tu étais plus détendue avec moi, je pourrais t’aider à obtenir cette promotion. Tu serais tellement plus à l’aise dans ton travail.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
    <Literal xml:lang="EN">You know, if you were more relaxed with me, I could help you get that promotion. You would be so much more comfortable in your job.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sexual_bullying</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Harc%C3%A8lement_sexuel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slutshaming</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slutshaming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slutshaming</IRI>
    <Literal xml:lang="FR">Slut-shaming</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slutshaming</IRI>
    <Literal xml:lang="EN">Slut-shaming</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slutshaming</IRI>
    <Literal xml:lang="FR">Vous dénigrez ou humiliez une personne, souvent une femme, pour son comportement sexuel réel ou perçu, ses choix vestimentaires ou son apparence, en suggérant qu’elle est immorale ou indigne.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slutshaming</IRI>
    <Literal xml:lang="EN">Degrading or humiliating someone, often a woman, for their real or perceived sexual behavior, clothing choices, or appearance, suggesting they are immoral or unworthy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slutshaming</IRI>
    <Literal xml:lang="FR">u as vu comment elle est habillée ? Elle cherche vraiment à attirer l’attention... C’est honteux de se présenter comme ça en public.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slutshaming</IRI>
    <Literal xml:lang="EN">Did you see how she's dressed? She's really looking for attention... It's shameful to present oneself like that in public.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slutshaming</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Slut-shaming</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slutshaming</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Slut-shaming</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slutshaming</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#slutshaming</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homophobicAndTransphobicHarassment</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homophobicAndTransphobicHarassment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homophobicAndTransphobicHarassment</IRI>
    <Literal xml:lang="FR">Harcèlement Homophobe et Transphobe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homophobicAndTransphobicHarassment</IRI>
    <Literal xml:lang="EN">Homophobic and Transphobic Harassment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homophobicAndTransphobicHarassment</IRI>
    <Literal xml:lang="FR">Vous ciblez des personnes en raison de leur orientation sexuelle, identité ou expression de genre, souvent par des agressions verbales, physiques ou psychologiques.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homophobicAndTransphobicHarassment</IRI>
    <Literal xml:lang="EN">Targeting individuals based on their sexual orientation, gender identity, or gender expression, often through verbal, physical, or psychological aggression.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homophobicAndTransphobicHarassment</IRI>
    <Literal xml:lang="FR">Regardez ce type là-bas. Il a l’air tellement efféminé. Il doit sûrement être gay. On devrait lui montrer ce que c’est un vrai homme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homophobicAndTransphobicHarassment</IRI>
    <Literal xml:lang="EN">Look at that guy over there. He looks so effeminate. He must be gay. We should show him what a real man is.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homophobicAndTransphobicHarassment</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Harc%C3%A8lement_homophobe_et_transphobe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homophobicAndTransphobicHarassment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#homophobicAndTransphobicHarassment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sexualBullying</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stalking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stalking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stalking</IRI>
    <Literal xml:lang="FR">Harcèlement obsessionnel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stalking</IRI>
    <Literal xml:lang="EN">Stalking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stalking</IRI>
    <Literal xml:lang="FR">Vous suivez et surveillez de manière obsessionnelle et prolongée une personne, créant une situation de peur intense et d’angoisse pour la victime.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stalking</IRI>
    <Literal xml:lang="EN">Obsessively and persistently following and monitoring a person, creating a situation of intense fear and anxiety for the victim.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stalking</IRI>
    <Literal xml:lang="FR">Je garde un œil sur tous tes déplacements, chaque jour, chaque nuit. Tu ne peux rien faire sans que je le sache.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stalking</IRI>
    <Literal xml:lang="EN">I keep an eye on all your movements, day and night. You can't do anything without me knowing it.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stalking</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Stalking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stalking</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Stalking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stalking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stalking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#harassment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <Literal xml:lang="FR">Comportement passif-agressif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <Literal xml:lang="EN">Passive-aggressive behaviour</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <Literal xml:lang="FR">Vous exprimez votre opposition indirectement, par l’évitement, les sous-entendus ou des marques d’irritation, plutôt que de la formuler clairement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <Literal xml:lang="EN">Expressing opposition indirectly, through avoidance, insinuations, or signs of irritation, rather than stating it clearly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <Literal xml:lang="FR">Non, ce n’est pas parce que j’ai claqué la porte que je suis en colère.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <Literal xml:lang="EN">No, it's not because I slammed the door that I'm angry.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Passive-aggressive_behavior</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Comportement_passif-agressif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
    <Literal xml:lang="FR">Mutisme actif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
    <Literal xml:lang="EN">Silent Treatment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
    <Literal xml:lang="FR">Vous ignorez délibérément quelqu’un et refusez de communiquer avec lui pour exercer un contrôle ou exprimer votre mécontentement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
    <Literal xml:lang="EN">Deliberately ignoring and refusing to communicate with someone to exert control or express displeasure.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
    <Literal xml:lang="FR">Je ne vais ni lui parler ni répondre à ses messages pendant des jours. Il comprendra qu’il a fait quelque chose de mal.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
    <Literal xml:lang="EN">I'm not going to talk to him or respond to his messages for days. He'll realize he did something wrong.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Silent_treatment</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Mutisme_actif</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sulking</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sulking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sulking</IRI>
    <Literal xml:lang="FR">Bouderie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sulking</IRI>
    <Literal xml:lang="EN">Sulking</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sulking</IRI>
    <Literal xml:lang="FR">Vous manifestez votre mécontentement ou votre frustration en restant silencieux et distant, souvent de manière ostensible, pour influencer l’autre personne.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sulking</IRI>
    <Literal xml:lang="EN">Expressing displeasure or frustration by remaining silent and distant, often ostentatiously, to influence another person.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sulking</IRI>
    <Literal xml:lang="FR">Je vais rester dans mon coin. Peut-être qu’ils viendront me demander ce qui ne va pas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sulking</IRI>
    <Literal xml:lang="EN">I'll just stay in my corner. Maybe they'll come over and ask what's wrong.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sulking</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/sulk</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sulking</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Bouderie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sulking</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sulking</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dumbInsolence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dumbInsolence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dumbInsolence</IRI>
    <Literal xml:lang="FR">Insolence muette</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dumbInsolence</IRI>
    <Literal xml:lang="EN">Dumb insolence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dumbInsolence</IRI>
    <Literal xml:lang="FR">Vous communiquez votre désaccord ou votre dédain sans prononcer un mot, utilisant des gestes subtils ou des expressions faciales pour exprimer votre mépris.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dumbInsolence</IRI>
    <Literal xml:lang="EN">Conveying disagreement or disdain without uttering a word, using subtle gestures or facial expressions to express contempt.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dumbInsolence</IRI>
    <Literal xml:lang="FR">Lorsque le directeur a annoncé la nouvelle politique, j’ai simplement levé les yeux au ciel et esquissé un sourire moqueur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dumbInsolence</IRI>
    <Literal xml:lang="EN">When the manager announced the new policy, I just rolled my eyes and cracked a mocking smile.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dumbInsolence</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Dumb_insolence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dumbInsolence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#dumbInsolence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#silentTreatment</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maliciousCompliance</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maliciousCompliance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maliciousCompliance</IRI>
    <Literal xml:lang="FR">Conformité malveillante</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maliciousCompliance</IRI>
    <Literal xml:lang="EN">Malicious Compliance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maliciousCompliance</IRI>
    <Literal xml:lang="FR">Vous suivez les instructions à la lettre, mais de manière à provoquer un résultat indésirable ou à mettre en évidence l’absurdité ou les failles de la demande.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maliciousCompliance</IRI>
    <Literal xml:lang="EN">Following instructions to the letter in a way that causes an undesirable outcome or highlights the absurdity or flaws of the request.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maliciousCompliance</IRI>
    <Literal xml:lang="FR">Comme vous l’avez demandé, j’ai suivi scrupuleusement le protocole, même si cela a retardé la livraison de trois jours. Après tout, il est important de respecter les procédures à la lettre, n’est-ce pas ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maliciousCompliance</IRI>
    <Literal xml:lang="EN">As per your instructions, I meticulously adhered to the protocol, even though it set us back by three days. After all, strictly following procedures is key, right?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maliciousCompliance</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Malicious_compliance</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maliciousCompliance</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#maliciousCompliance</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stonewalling</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stonewalling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stonewalling</IRI>
    <Literal xml:lang="FR">Obstructionnisme</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stonewalling</IRI>
    <Literal xml:lang="EN">Stonewalling</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stonewalling</IRI>
    <Literal xml:lang="FR">Vous refusez systématiquement de répondre ou de coopérer, souvent pour éviter une confrontation ou comme stratégie pour gagner du temps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stonewalling</IRI>
    <Literal xml:lang="EN">Systematically refusing to respond or cooperate, often to avoid confrontation or as a strategy to gain time.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stonewalling</IRI>
    <Literal xml:lang="FR">Chaque fois qu’elle me demande quelque chose de difficile, je fais juste comme si je ne l’avais pas entendue. Ça la décourage de poser plus de questions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stonewalling</IRI>
    <Literal xml:lang="EN">Whenever she asks me something tough, I just act like I didn't hear her. It discourages her from asking more questions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stonewalling</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Stonewalling</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stonewalling</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Obstruction_(comportement)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stonewalling</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#stonewalling</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="FR">Potin</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="EN">Gossip</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="FR">Vous partagez des histoires informelles ou des rumeurs sur la vie personnelle d’autres personnes, souvent non vérifiées et privées.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="EN">Sharing informal stories or rumors about other people's private lives, often unverified and private.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="FR">J’ai entendu dire que notre patron part en vacances avec son assistant, c’est intrigant !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="EN">I heard our boss is going on vacation with his assistant, how intriguing!</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Gossip</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gossip</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#passiveaggressiveBehaviour</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
    <Literal xml:lang="FR">Auto-victimisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
    <Literal xml:lang="EN">Playing the Victim</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
    <Literal xml:lang="FR">Vous vous présentez comme une victime, souvent de manière exagérée, pour gagner de la sympathie ou éviter d’assumer vos responsabilités.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
    <Literal xml:lang="EN">Portraying oneself as a victim, often in an exaggerated way, to gain sympathy or avoid responsibility.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
    <Literal xml:lang="FR">Chaque fois que quelque chose ne va pas, c’est toujours moi qui suis blâmé, même si ce n’est pas ma faute.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
    <Literal xml:lang="EN">Every time something goes wrong, I'm always the one blamed, even when it's not my fault.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Playing_the_victim</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Auto-victimisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sadfishing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sadfishing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sadfishing</IRI>
    <Literal xml:lang="FR">Sadfishing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sadfishing</IRI>
    <Literal xml:lang="EN">Sadfishing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sadfishing</IRI>
    <Literal xml:lang="FR">Vous exagérez ou inventez des problèmes personnels pour attirer l’attention et la sympathie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sadfishing</IRI>
    <Literal xml:lang="EN">Exaggerating or fabricating personal problems to garner attention and sympathy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sadfishing</IRI>
    <Literal xml:lang="FR">Je me sens tellement seul ces jours-ci... Personne ne semble se soucier de moi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sadfishing</IRI>
    <Literal xml:lang="EN">Feeling so alone these days... Seems like nobody cares about me.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sadfishing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sadfishing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sadfishing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sadfishing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persecutoryDelusion</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persecutoryDelusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persecutoryDelusion</IRI>
    <Literal xml:lang="FR">Délire de persécution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persecutoryDelusion</IRI>
    <Literal xml:lang="EN">Persecutory delusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persecutoryDelusion</IRI>
    <Literal xml:lang="FR">Vous croyez ou prétendez que tout le monde est contre vous, souvent sans preuve concrète.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persecutoryDelusion</IRI>
    <Literal xml:lang="EN">Believing or pretending that everyone is hostile, often without concrete evidence.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persecutoryDelusion</IRI>
    <Literal xml:lang="FR">Je sais que tout le monde parle de moi dans mon dos et complote pour me faire échouer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persecutoryDelusion</IRI>
    <Literal xml:lang="EN">I just know everyone is talking behind my back and plotting to make me fail.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persecutoryDelusion</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Persecutory_delusion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persecutoryDelusion</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/D%C3%A9lire_de_pers%C3%A9cution</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persecutoryDelusion</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#persecutoryDelusion</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#playingTheVictim</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#triangulation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#triangulation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#triangulation</IRI>
    <Literal xml:lang="FR">Triangulation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#triangulation</IRI>
    <Literal xml:lang="EN">Triangulation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#triangulation</IRI>
    <Literal xml:lang="FR">Vous faites intervenir un tiers pour influencer indirectement quelqu’un.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#triangulation</IRI>
    <Literal xml:lang="EN">Involving a third party to indirectly influence someone or a situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#triangulation</IRI>
    <Literal xml:lang="FR">Le consultant l’a bien dit: il ne sert à rien de s’engager dans ce marché en déclin.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#triangulation</IRI>
    <Literal xml:lang="EN">The consultant made it clear: there's no point in entering this declining market.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#triangulation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Triangulation_(psychology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#triangulation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#triangulation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="FR">Minimisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="EN">Minimisation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="FR">Vous atténuez intentionnellement des éléments de vérité, l’importance des problèmes ou des sentiments d’autrui, pour minimiser leur impact ou pour détourner la responsabilité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="EN">Deliberately downplaying elements of truth, the significance of problems, or the feelings of others to lessen their perceived impact or deflect accountability.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="FR">Ce n’est pas si grave, tout le monde fait des erreurs et ça ne va rien changer. Pas la peine d’en faire tout un plat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="EN">It's not that bad, everyone makes mistakes and it's not going to change anything. No need to make a mountain out of a molehill.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Minimisation_(psychology)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#minimisation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#mindGames</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
    <Literal xml:lang="FR">Conditionnement social</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
    <Literal xml:lang="EN">Social Conditioning</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
    <Literal xml:lang="FR">Vous influencez un groupe en vous appuyant sur ses normes, ses rôles ou ses attentes sociales plutôt que sur des raisons.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
    <Literal xml:lang="EN">Manipulating social norms and expectations to influence individual behaviors and beliefs within a group.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
    <Literal xml:lang="FR">Regardez, tout le monde dans l’équipe s’est engagé à travailler les week-ends pour finir ce projet. Si vous ne participez pas, vous risquez vraiment de vous faire remarquer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
    <Literal xml:lang="EN">Look, everyone in the team has committed to working weekends to finish this project. If you don't join in, you're really going to stand out.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#powerGames</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <Literal xml:lang="FR">Abus de pouvoir</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <Literal xml:lang="EN">Abusive power and control</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <Literal xml:lang="FR">Vous utilisez votre position ou votre pouvoir pour manipuler ou contrôler les autres de manière abusive et dommageable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <Literal xml:lang="EN">Using one's position or power to manipulate or control others in abusive and damaging ways.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <Literal xml:lang="FR">C’est moi qui décide quand et comment les choses doivent être faites ici. Si vous ne suivez pas mes directives, il y aura de lourdes conséquences.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <Literal xml:lang="EN">I decide when and how things should be done here. If you do not follow my instructions, there will be severe consequences.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Abusive_power_and_control</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
    <Literal xml:lang="FR">Microgestion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
    <Literal xml:lang="EN">Micromanagement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
    <Literal xml:lang="FR">Vous contrôlez minutieusement et excessivement le travail de vos subordonnés, en leur laissant peu ou pas d’autonomie ni d’espace créatif.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
    <Literal xml:lang="EN">Carefully and excessively controlling the work of one's subordinates, leaving little or no autonomy or creative space.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
    <Literal xml:lang="FR">Je veux que vous me rendiez compte de chaque détail de votre travail. Chaque courriel, chaque appel : je dois tout savoir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
    <Literal xml:lang="EN">I want you to report to me every detail of your work. Every email, every call, I have to know everything.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Micromanagement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Microgestion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goingPostal</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goingPostal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goingPostal</IRI>
    <Literal xml:lang="FR">Syndrome du facteur fou</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goingPostal</IRI>
    <Literal xml:lang="EN">Going Postal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goingPostal</IRI>
    <Literal xml:lang="FR">Vous créez un environnement de travail si stressant et oppressant qu’il pousse les employés à des réactions extrêmes ou irréfléchies.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goingPostal</IRI>
    <Literal xml:lang="EN">Creating a work environment so stressful and oppressive that it pushes employees to extreme and rash reactions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goingPostal</IRI>
    <Literal xml:lang="FR">Depuis que les heures supplémentaires sont devenues monnaie courante sans reconnaissance ni compensation, l’ambiance au bureau est devenue électrique et imprévisible.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goingPostal</IRI>
    <Literal xml:lang="EN">Since overtime has become commonplace without recognition or compensation, the atmosphere in the office has become electric and unpredictable.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goingPostal</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Micromanagement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goingPostal</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#goingPostal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#micromanagement</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="FR">Bouc émissaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="EN">Scapegoating</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="FR">Cibler un individu ou un groupe pour le blâmer pour des problèmes dont il n’est pas responsable, souvent pour détourner l’attention de ses propres échecs ou responsabilités.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="EN">Singling an individual or group to blame them for problems that are not their fault, often to distract from one's own failures or responsibilities.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="FR">C’est à cause de l’équipe marketing que nous n’avons pas atteint nos objectifs ce trimestre. Ils n’ont pas fait correctement leur travail.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="EN">It's because of the marketing team that we didn't achieve our goals this quarter. They didn't do their job properly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Scapegoating</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scapegoating</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#isolationToFacilitateAbuse</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#isolationToFacilitateAbuse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#isolationToFacilitateAbuse</IRI>
    <Literal xml:lang="FR">Isolation pour faciliter l’abus</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#isolationToFacilitateAbuse</IRI>
    <Literal xml:lang="EN">Isolation to facilitate abuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#isolationToFacilitateAbuse</IRI>
    <Literal xml:lang="FR">Vous isolez un individu pour mieux contrôler et abuser de lui, souvent en le coupant de ses réseaux de soutien et en limitant ses interactions avec les autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#isolationToFacilitateAbuse</IRI>
    <Literal xml:lang="EN">Isolating an individual to further control and abuse them, often by cutting them off from their support networks and limiting their interactions with others.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#isolationToFacilitateAbuse</IRI>
    <Literal xml:lang="FR">Je t’ai dit que je ne voulais plus que tu fréquente ces gens là qui ne te veulent pas du bien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#isolationToFacilitateAbuse</IRI>
    <Literal xml:lang="EN">I told you that I no longer wanted you to hang out with these people who don't wish you well.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#isolationToFacilitateAbuse</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Isolation_to_facilitate_abuse</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#isolationToFacilitateAbuse</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#isolationToFacilitateAbuse</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narcissismInTheWorkplace</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narcissismInTheWorkplace</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narcissismInTheWorkplace</IRI>
    <Literal xml:lang="FR">Narcissisme en milieu de travail</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narcissismInTheWorkplace</IRI>
    <Literal xml:lang="EN">Narcissism in the Workplace</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narcissismInTheWorkplace</IRI>
    <Literal xml:lang="FR">Vous manifestez un comportement narcissique en milieu de travail, cherchant constamment admiration et attention, tout en dénigrant ou exploitant vos collègues.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narcissismInTheWorkplace</IRI>
    <Literal xml:lang="EN">Exhibiting narcissistic behavior in the workplace, constantly seeking admiration and attention, while denigrating or exploiting colleagues.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narcissismInTheWorkplace</IRI>
    <Literal xml:lang="FR">Je suis clairement le plus compétent ici. Sans moi, ce projet serait un désastre. Les autres ne sont là que pour exécuter mes idées brillantes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narcissismInTheWorkplace</IRI>
    <Literal xml:lang="EN">I am clearly the most competent here. Without me, this project would be a disaster. The others are only there to execute my brilliant ideas.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narcissismInTheWorkplace</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Narcissism_in_the_workplace</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narcissismInTheWorkplace</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#narcissismInTheWorkplace</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#settingUpToFail</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#settingUpToFail</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#settingUpToFail</IRI>
    <Literal xml:lang="FR">Mise en place pour échouer</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#settingUpToFail</IRI>
    <Literal xml:lang="EN">Setting up to fail</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#settingUpToFail</IRI>
    <Literal xml:lang="FR">Vous créez des conditions dans lesquelles une personne est presque certaine d’échouer, souvent pour justifier des critiques ou des actions négatives ultérieures à son égard.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#settingUpToFail</IRI>
    <Literal xml:lang="EN">Creating conditions in which a person is almost certain to fail, often to justify later criticism or negative actions towards them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#settingUpToFail</IRI>
    <Literal xml:lang="FR">Je vais lui assigner ce projet impossible dans un délai irréaliste. Quand il échouera, cela justifiera sa mise à l’écart.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#settingUpToFail</IRI>
    <Literal xml:lang="EN">I'll assign him this impossible project with an unrealistic deadline. When he fails, it will justify sidelining him.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#settingUpToFail</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Setting_up_to_fail</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#settingUpToFail</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#settingUpToFail</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#abusivePowerAndControl</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
    <Literal xml:lang="FR">Dynamiques de pouvoir intermédiaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
    <Literal xml:lang="EN">Middle power dynamics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
    <Literal xml:lang="FR">Vous alternez entre flatterie envers vos supérieurs, compétition faussée avec vos pairs et autoritarisme envers vos subordonnés.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
    <Literal xml:lang="EN">You alternate between flattering your superiors, engaging in unfair competition with your peers, and acting authoritarian toward your subordinates.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
    <Literal xml:lang="FR">Pour me démarquer, je flatte constamment mes supérieurs, je cherche à discréditer mes collègues et je maintiens une forte emprise sur mon équipe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
    <Literal xml:lang="EN">To stand out, I constantly flatter my superiors while undermining my colleagues and ruling my team with an iron fist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#socialConditioning</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crabMentality</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crabMentality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crabMentality</IRI>
    <Literal xml:lang="FR">Mentalité de crabe</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crabMentality</IRI>
    <Literal xml:lang="EN">Crab Mentality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crabMentality</IRI>
    <Literal xml:lang="FR">Vous adoptez une attitude selon laquelle, si vous ne pouvez pas réussir, vous faites en sorte que personne d’autre ne réussisse non plus.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crabMentality</IRI>
    <Literal xml:lang="EN">Adopting an attitude where if one can't succeed, one makes sure no one else can either.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crabMentality</IRI>
    <Literal xml:lang="FR">Si je ne peux pas être promu, je ferai en sorte que personne dans mon équipe ne le soit.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crabMentality</IRI>
    <Literal xml:lang="EN">If I can't get promoted, I'll make sure no one on my team gets promoted.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crabMentality</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Crab_mentality</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crabMentality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crabMentality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tallPoppySyndrome</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tallPoppySyndrome</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tallPoppySyndrome</IRI>
    <Literal xml:lang="FR">Syndrome d’exposition élevée</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tallPoppySyndrome</IRI>
    <Literal xml:lang="EN">Tall Poppy Syndrome</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tallPoppySyndrome</IRI>
    <Literal xml:lang="FR">Vous critiquez ou minimisez ceux qui se démarquent ou réussissent, souvent par jalousie ou par crainte de perdre votre propre statut.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tallPoppySyndrome</IRI>
    <Literal xml:lang="EN">Criticizing or minimizing those who stand out or succeed, often out of jealousy or fear of losing one's own status.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tallPoppySyndrome</IRI>
    <Literal xml:lang="FR">Peu importe ses réalisations, il ne faut pas oublier qu’il n’est pas différent de nous. Il a juste eu plus de chance, c’est tout.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tallPoppySyndrome</IRI>
    <Literal xml:lang="EN">No matter his accomplishments, we must remember that he is no different from us. He just got luckier, that's all.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tallPoppySyndrome</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Tall_poppy_syndrome</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tallPoppySyndrome</IRI>
    <Literal xml:lang="FR">https://nospensees.fr/le-syndrome-d-exposition-elevee-au-travail-une-realite-tres-courante/</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crabMentality</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tallPoppySyndrome</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#tallPoppySyndrome</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crabMentality</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kickTheCat</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kickTheCat</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kickTheCat</IRI>
    <Literal xml:lang="FR">Frapper le chat</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kickTheCat</IRI>
    <Literal xml:lang="EN">Kick the cat</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kickTheCat</IRI>
    <Literal xml:lang="FR">Vous exprimez votre frustration ou votre colère sur des personnes moins puissantes ou subordonnées, souvent parce que vous ne pouvez pas l’exprimer là où elle est causée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kickTheCat</IRI>
    <Literal xml:lang="EN">Taking out one's frustration or anger on less powerful or subordinate people, often because one cannot express it where it is caused.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kickTheCat</IRI>
    <Literal xml:lang="FR">Écoutez, je ne veux pas entendre vos excuses. Je sais que ce n’est pas votre faute, mais quelqu’un doit payer pour l’échec de ce matin, et c’est vous.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kickTheCat</IRI>
    <Literal xml:lang="EN">Look, I don't want to hear your excuses. I know it's not your fault, but someone has to pay for this morning's failure, and it's you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kickTheCat</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Kick_the_cat</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kickTheCat</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kickTheCat</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kissUpKickDown</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kissUpKickDown</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kissUpKickDown</IRI>
    <Literal xml:lang="FR">Kiss up kick down</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kissUpKickDown</IRI>
    <Literal xml:lang="EN">Kiss up kick down</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kissUpKickDown</IRI>
    <Literal xml:lang="FR">Vous adoptez un comportement servile envers ceux qui ont plus de pouvoir que vous, tout en étant agressif ou méprisant envers ceux qui sont en position inférieure.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kissUpKickDown</IRI>
    <Literal xml:lang="EN">Behaving subserviently toward those who have more power, while being aggressive or contemptuous toward those in an inferior position.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kissUpKickDown</IRI>
    <Literal xml:lang="FR">Votre idée lors de la réunion était absolument géniale, chef. Vous tous, arrêtez de vous tourner les pouces et commencez à travailler plus dur pour atteindre les nouveaux objectifs.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kissUpKickDown</IRI>
    <Literal xml:lang="EN">Your idea in the meeting was absolutely brilliant, boss. All of you, stop twiddling your thumbs and start working harder to achieve the new goals.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kissUpKickDown</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Kiss_up_kick_down</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kissUpKickDown</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kissUpKickDown</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sycophancy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sycophancy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sycophancy</IRI>
    <Literal xml:lang="FR">Sycophantie</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sycophancy</IRI>
    <Literal xml:lang="EN">Sycophancy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sycophancy</IRI>
    <Literal xml:lang="FR">Vous agissez de manière obséquieuse ou flatteuse pour gagner la faveur de personnes influentes, souvent au détriment de vos propres principes ou de ceux des autres.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sycophancy</IRI>
    <Literal xml:lang="EN">Acting obsequiously or flatteringly to gain the favor of influential people, often to the detriment of one's own or others' principles.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sycophancy</IRI>
    <Literal xml:lang="FR">Vous avez absolument raison, comme toujours, Patron. Votre perspective est si éclairée, heureusement que vous êtes là pour nous guider.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sycophancy</IRI>
    <Literal xml:lang="EN">You're absolutely right, as always, Boss. Your perspective is so enlightened, fortunately you are here to guide us.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sycophancy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sycophancy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sycophancy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sycophancy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#middlePowerDynamics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <Literal xml:lang="FR">Influence non verbale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <Literal xml:lang="EN">Nonverbal influence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <Literal xml:lang="FR">Vous cherchez à convaincre au-delà du sens des mots, notamment par le langage corporel ou les inflexions de la voix.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <Literal xml:lang="EN">Seeking to persuade beyond the meaning of words, notably through body language or vocal inflections.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <Literal xml:lang="FR">J’ai levé les yeux au ciel et soupiré à plusieurs reprises durant son intervention pour le déstabiliser.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <Literal xml:lang="EN">I sighed and rolled my eyes several times during their speech to destabilize them.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Nonverbal_influence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Communication_non_verbale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#psychologicalManipulation</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
    <Literal xml:lang="FR">Paralangage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
    <Literal xml:lang="EN">Paralanguage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
    <Literal xml:lang="FR">Vous cherchez à influencer votre auditoire en modulant le ton, le volume ou le rythme de votre discours.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
    <Literal xml:lang="EN">Seeking to influence an audience by manipulating the tone, volume, or pace of one's speech.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
    <Literal xml:lang="FR">En baissant la voix et en ralentissant mon débit, j’ai donné plus de gravité aux risques potentiels.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
    <Literal xml:lang="EN">By lowering my voice and slowing my pace, I gave greater gravity to the potential risks.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
    <Literal xml:lang="EN">https://en.wiktionary.org/wiki/paralanguage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#babytalk</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#babytalk</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#babytalk</IRI>
    <Literal xml:lang="FR">Parler bébé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#babytalk</IRI>
    <Literal xml:lang="EN">Baby-talk</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#babytalk</IRI>
    <Literal xml:lang="FR">Vous cherchez à influer sur votre interlocuteur en vous adressant à lui comme s’il était un enfant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#babytalk</IRI>
    <Literal xml:lang="EN">Seeking to influence an interlocutor by addressing them as if they were a child.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#babytalk</IRI>
    <Literal xml:lang="FR">Alors ? Il a mal à son petit genou le bonhomme et il va se mettre à pleurer ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#babytalk</IRI>
    <Literal xml:lang="EN">Oh? Did someone hurt their little knee and is going to cry about it?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#babytalk</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Baby_talk#Use_with_non-infants</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#babytalk</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#babytalk</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
    <Literal xml:lang="FR">Respiration paralinguistique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
    <Literal xml:lang="EN">Paralinguistic respiration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
    <Literal xml:lang="FR">Vous cherchez à transmettre certaines intentions par l’acte de respirer de manière audible ou particulière.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
    <Literal xml:lang="EN">Seeking to convey certain intentions through audible or particular breathing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
    <Literal xml:lang="FR">Pfff... Vous me fatiguez avec vos problèmes.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
    <Literal xml:lang="EN">Sigh... You're exhausting me with your problems.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Paralanguage#Specific_forms_of_paralinguistic_respiration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralanguage</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#throatclear</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#throatclear</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#throatclear</IRI>
    <Literal xml:lang="FR">Toussotement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#throatclear</IRI>
    <Literal xml:lang="EN">Throat-clear</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#throatclear</IRI>
    <Literal xml:lang="FR">Vous vous éclaircissez la gorge, par exemple pour marquer votre désapprobation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#throatclear</IRI>
    <Literal xml:lang="EN">Clearing one's throat, for example to signal disapproval.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#throatclear</IRI>
    <Literal xml:lang="FR">Hum hum, vous ne devriez pas être là, les enfants.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#throatclear</IRI>
    <Literal xml:lang="EN">Ahem, children, you shouldn't be here.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#throatclear</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Paralanguage#The_Throat-Clear</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#throatclear</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#throatclear</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sighs</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sighs</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sighs</IRI>
    <Literal xml:lang="FR">Soupir</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sighs</IRI>
    <Literal xml:lang="EN">Sighs</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sighs</IRI>
    <Literal xml:lang="FR">Vous exprimez votre lassitude ou votre exaspération en soupirant pour influencer l’entourage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sighs</IRI>
    <Literal xml:lang="EN">Expressing weariness or exasperation by sighing in order to influence those nearby.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sighs</IRI>
    <Literal xml:lang="FR">Ah ! Si seulement...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sighs</IRI>
    <Literal xml:lang="EN">Ah! If only...</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sighs</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Paralanguage#Sighs</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sighs</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#sighs</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gasp</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gasp</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gasp</IRI>
    <Literal xml:lang="FR">Souffle court</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gasp</IRI>
    <Literal xml:lang="EN">Gasp</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gasp</IRI>
    <Literal xml:lang="FR">Vous simulez une respiration saccadée pour communiquer une émotion intense.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gasp</IRI>
    <Literal xml:lang="EN">Gasping to express one's strong feelings about something.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gasp</IRI>
    <Literal xml:lang="FR">Là, le train, derrière, vite !</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gasp</IRI>
    <Literal xml:lang="EN">There, the train, behind, hurry up.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gasp</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Paralanguage#Gasps</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gasp</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gasp</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#paralinguisticRespiration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronemics</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronemics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronemics</IRI>
    <Literal xml:lang="FR">Chronémique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronemics</IRI>
    <Literal xml:lang="EN">Chronemics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronemics</IRI>
    <Literal xml:lang="FR">Vous utilisez le temps de parole et les pauses pour dynamiser ou apaiser votre discours.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronemics</IRI>
    <Literal xml:lang="EN">Using speaking time and pauses to energize or soothe one's speech.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronemics</IRI>
    <Literal xml:lang="FR">Vous auriez préféré autre chose. Je comprends. C’est naturel. Et c’est votre droit. Maintenant, faites-moi confiance : nous allons relever ce défi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronemics</IRI>
    <Literal xml:lang="EN">You would have preferred something else. I understand. It is natural. And it is your right. Now, trust me: we are going to meet this challenge.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronemics</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Chronemics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronemics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chronemics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oculesics</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oculesics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oculesics</IRI>
    <Literal xml:lang="FR">Oculésique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oculesics</IRI>
    <Literal xml:lang="EN">Oculesics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oculesics</IRI>
    <Literal xml:lang="FR">Vous utilisez votre regard, fixe ou détourné, pour transmettre un message sans dire un mot.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oculesics</IRI>
    <Literal xml:lang="EN">Using one's gaze, fixed or averted, to convey a message without saying a word.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oculesics</IRI>
    <Literal xml:lang="FR">Je t’ai vu rouler des yeux quand il a dit ça.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oculesics</IRI>
    <Literal xml:lang="EN">I saw you roll your eyes when he said that.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oculesics</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Oculesics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oculesics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oculesics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eyeContact</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eyeContact</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eyeContact</IRI>
    <Literal xml:lang="FR">Contact visuel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eyeContact</IRI>
    <Literal xml:lang="EN">Eye contact</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eyeContact</IRI>
    <Literal xml:lang="FR">Vous regardez votre interlocuteur dans les yeux afin d’augmenter la portée de votre message.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eyeContact</IRI>
    <Literal xml:lang="EN">Looking an interlocutor in the eyes to enhance the impact of the message.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eyeContact</IRI>
    <Literal xml:lang="FR">Regardez-moi dans les yeux quand je vous parle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eyeContact</IRI>
    <Literal xml:lang="EN">Look into my eyes when I'm speaking to you.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eyeContact</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Eye_contact</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eyeContact</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Contact_visuel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oculesics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eyeContact</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eyeContact</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#oculesics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <Literal xml:lang="FR">Kinésique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <Literal xml:lang="EN">Kinesics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <Literal xml:lang="FR">Vous utilisez les mouvements de votre corps pour influencer votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <Literal xml:lang="EN">Utilizing body movements to influence an audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <Literal xml:lang="FR">En avançant vers le public et en faisant des gestes précis avec les mains, j’ai captivé l’auditoire et rendu mon message plus persuasif.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <Literal xml:lang="EN">By moving toward the audience and making precise hand gestures, I captivated the audience and made my message more persuasive.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Kinesics</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Kin%C3%A9sique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#nonverbalInfluence</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
    <Literal xml:lang="FR">Expression faciale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
    <Literal xml:lang="EN">Facial expression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
    <Literal xml:lang="FR">Vous cherchez à influencer votre auditoire en jouant sur les expressions du visage afin de suggérer une émotion ou une attitude.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
    <Literal xml:lang="EN">Seeking to influence an audience by using facial expressions to suggest an emotion or attitude.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
    <Literal xml:lang="FR">En fronçant profondément les sourcils, j’ai communiqué mon désaccord sans prononcer un seul mot.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
    <Literal xml:lang="EN">By frowning deeply, I conveyed my disapproval without a single word.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Facial_expression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Expression_faciale</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#microexpression</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#microexpression</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#microexpression</IRI>
    <Literal xml:lang="FR">Appel aux micro-expressions</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#microexpression</IRI>
    <Literal xml:lang="EN">Microexpression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#microexpression</IRI>
    <Literal xml:lang="FR">Pour mieux influencer votre interlocuteur, vous interprétez son état émotionnel à partir de signes brefs et involontaires visibles sur son visage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#microexpression</IRI>
    <Literal xml:lang="EN">To better influence the person you are speaking with, you interpret their emotional state from brief, involuntary signs visible on their face.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#microexpression</IRI>
    <Literal xml:lang="FR">En remarquant le plissement soudain de ses yeux, j’ai saisi son inquiétude face à la situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#microexpression</IRI>
    <Literal xml:lang="EN">Noticing the sudden narrowing of his eyes, I grasped his concern about the situation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#microexpression</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Microexpression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#microexpression</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Micro-expression</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#microexpression</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#microexpression</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#facialExpression</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <Literal xml:lang="FR">Gestuelle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <Literal xml:lang="EN">Gesture</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <Literal xml:lang="FR">Vous cherchez à influencer votre auditoire en utilisant délibérément des gestes de la main ou du corps.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <Literal xml:lang="EN">Seeking to influence an audience by deliberately using hand or body gestures.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <Literal xml:lang="FR">J’ai fait un geste en direction de la porte pour suggérer subtilement qu’il était temps pour lui de partir.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <Literal xml:lang="EN">I gestured towards the door, subtly suggesting it was time for him to leave.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Gesture</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Modèle:Palette_Gestuelle</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kinesics</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <Literal xml:lang="FR">Amical</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <Literal xml:lang="EN">Friendly</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <Literal xml:lang="FR">Vous tissez une complicité avec ceux qui vous écoutent par un geste amical pour gagner leur sympathie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <Literal xml:lang="EN">Building rapport with listeners through a friendly gesture to win their sympathy.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <Literal xml:lang="FR">Poser ma main sur son épaule durant la conversation pour instaurer une ambiance détendue et conviviale.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <Literal xml:lang="EN">Placing my hand on his shoulder during the conversation to create a relaxed and friendly atmosphere.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <Literal xml:lang="FR">Clin d’œil</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <Literal xml:lang="EN">Wink</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <Literal xml:lang="FR">Vous faites un clin d’œil pour partager une connivence ou suggérer un secret partagé avec votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <Literal xml:lang="EN">Sharing a moment of connection or hinting at a shared secret with an interlocutor by a simple wink.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <Literal xml:lang="FR">Vous savez ce qu’il vous reste à faire, n’est-ce pas Monsieur Bernard ?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <Literal xml:lang="EN">You know what to do now, don't you, Mr. Bernard?</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Wink</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Clin_d%27oeil</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleWink</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleWink</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleWink</IRI>
    <Literal xml:lang="FR">Double clin d’oeil</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleWink</IRI>
    <Literal xml:lang="EN">Double wink</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleWink</IRI>
    <Literal xml:lang="FR">Vous clignez deux fois des yeux, souvent pour signifier que ce que vous venez de dire est sujet à caution.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleWink</IRI>
    <Literal xml:lang="EN">Blinking twice, often to suggest that what was just said should be taken with caution.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleWink</IRI>
    <Literal xml:lang="FR">Après avoir promis que tout serait prêt à temps, Léa fait un double clin d’œil à son collègue pour lui faire comprendre de ne pas la prendre au mot.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleWink</IRI>
    <Literal xml:lang="EN">After a sarcastic remark, I blinked twice to indicate that my comment should be taken lightly.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleWink</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Wink#Double_wink</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleWink</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#doubleWink</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chlick</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chlick</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chlick</IRI>
    <Literal xml:lang="FR">Click</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chlick</IRI>
    <Literal xml:lang="EN">Chlick</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chlick</IRI>
    <Literal xml:lang="FR">Vous utilisez un claquement de langue pour indiquer discrètement votre accord ou complicité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chlick</IRI>
    <Literal xml:lang="EN">Indicating discreet agreement or complicity with a tongue click, implying there's nothing left to add or discuss.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chlick</IRI>
    <Literal xml:lang="FR">Après avoir livré une explication compliquée, le locuteur fait un ’click’ avec sa langue, suggérant qu’il ne reste rien à ajouter ou discuter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chlick</IRI>
    <Literal xml:lang="EN">After delivering a complex explanation, the speaker clicks their tongue, suggesting there's nothing more to add or dispute.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chlick</IRI>
    <Literal xml:lang="EN">https://www.urbandictionary.com/define.php?term=Chlick</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chlick</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#chlick</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flutter</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flutter</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flutter</IRI>
    <Literal xml:lang="FR">Clin des deux yeux</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flutter</IRI>
    <Literal xml:lang="EN">Flutter</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flutter</IRI>
    <Literal xml:lang="FR">Vous clignez des deux yeux, souvent pour signifier votre intéret ou de façon ironique votre désapprobation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flutter</IRI>
    <Literal xml:lang="EN">Blinking both eyes, often to express interest or, ironically, disapproval.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flutter</IRI>
    <Literal xml:lang="FR">Pendant la réunion, vous clignez des deux yeux en regardant votre collègue pour lui faire comprendre que sa proposition vous intéresse.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flutter</IRI>
    <Literal xml:lang="EN">Blinking both eyes to show fascination or, sarcastically, disbelief.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flutter</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Wink#Both_eyes_(bat/flutter)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flutter</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#flutter</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#wink</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kiss</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kiss</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kiss</IRI>
    <Literal xml:lang="FR">Baiser</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kiss</IRI>
    <Literal xml:lang="EN">Kiss</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kiss</IRI>
    <Literal xml:lang="FR">Vous envoyez un baiser pour témoigner de l’affection ou du respect, influençant l’autre de manière bienveillante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kiss</IRI>
    <Literal xml:lang="EN">Conveying affection or respect through a kiss, subtly influencing in a positive manner.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kiss</IRI>
    <Literal xml:lang="FR">Avant de partir, Léa envoie un baiser de la main à son collègue pour l’encourager à accepter sa proposition.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kiss</IRI>
    <Literal xml:lang="EN">Sending a kiss during a speech to emphasize feelings of appreciation or deep affection.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kiss</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Kiss</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kiss</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Baiser</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kiss</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kiss</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eskimoKiss</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eskimoKiss</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eskimoKiss</IRI>
    <Literal xml:lang="FR">Bisou esquimau</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eskimoKiss</IRI>
    <Literal xml:lang="EN">Eskimo kiss</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eskimoKiss</IRI>
    <Literal xml:lang="FR">Vous touchez le nez de votre interlocuteur avec le vôtre dans un geste affectueux pour créer un lien chaleureux.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eskimoKiss</IRI>
    <Literal xml:lang="EN">Touching noses in an affectionate gesture to create a warm bond.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eskimoKiss</IRI>
    <Literal xml:lang="FR">Pour convaincre son enfant d’aller se coucher, Léa lui fait un bisou esquimau en frottant doucement son nez contre le sien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eskimoKiss</IRI>
    <Literal xml:lang="EN">Gently approaching and performing an Eskimo kiss, thereby strengthening our emotional bond without words.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eskimoKiss</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Eskimo_kiss</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eskimoKiss</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Bisou_esquimau</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eskimoKiss</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#eskimoKiss</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formalHug</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formalHug</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formalHug</IRI>
    <Literal xml:lang="FR">Accolade</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formalHug</IRI>
    <Literal xml:lang="EN">Formal hug</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formalHug</IRI>
    <Literal xml:lang="FR">Vous échangez une étreinte formelle pour exprimer une forme de respect ou d’entente officielle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formalHug</IRI>
    <Literal xml:lang="EN">Exchanging a formal embrace to express respect or to signify an official agreement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formalHug</IRI>
    <Literal xml:lang="FR">Lors d’une rencontre, celui qui initie une accolade peut subtilement imposer un climat de familiarité voire de supériorité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formalHug</IRI>
    <Literal xml:lang="EN">Initiating a hug at a meeting can subtly enforce a climate of familiarity or even superiority.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formalHug</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Accolade_(geste)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formalHug</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formalHug</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistBump</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistBump</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistBump</IRI>
    <Literal xml:lang="FR">Fist bump</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistBump</IRI>
    <Literal xml:lang="EN">Fist bump</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistBump</IRI>
    <Literal xml:lang="FR">Vous saluez poing contre poing, généralement pour signifier une connivence ou un accord.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistBump</IRI>
    <Literal xml:lang="EN">You greet someone by bumping fists, usually to signal camaraderie or agreement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistBump</IRI>
    <Literal xml:lang="FR">Le ’fist bump’ est parfois utilisé pour remplacer une poignée de main dans un but de décontraction ou d’affinité spécifique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistBump</IRI>
    <Literal xml:lang="EN">A 'fist bump' is sometimes used as a substitute for a handshake to bring casualness or specific camaraderie into play.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistBump</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Fist_bump</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistBump</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Fist_bump</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistBump</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fistBump</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaka</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaka</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaka</IRI>
    <Literal xml:lang="FR">Shaka</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaka</IRI>
    <Literal xml:lang="EN">Shaka</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaka</IRI>
    <Literal xml:lang="FR">Vous tendez votre main paume vers l’extérieur avec le pouce et le petit doigt levés en signe de salut amical et décontracté.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaka</IRI>
    <Literal xml:lang="EN">Extending the hand with the palm out and the thumb and pinkie raised as a friendly and relaxed greeting.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaka</IRI>
    <Literal xml:lang="FR">Pour convaincre les nouveaux de rejoindre son équipe de surf, Léo leur adresse un shaka, pouce et petit doigt levés, en lançant : « Venez, l’ambiance est cool ! »</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaka</IRI>
    <Literal xml:lang="EN">During a casual meeting, I give a shaka sign, signaling a relaxed and friendly greeting to the group.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaka</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Shaka_sign</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaka</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Shaka_(signe)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaka</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#shaka</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedFingers</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedFingers</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedFingers</IRI>
    <Literal xml:lang="FR">Croiser l’index et le majeur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedFingers</IRI>
    <Literal xml:lang="EN">Crossed fingers</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedFingers</IRI>
    <Literal xml:lang="FR">Vous croisez l’index et le majeur en espérant bonne chance, parfois pour montrer que l’on ment ou que l’on plaisante.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedFingers</IRI>
    <Literal xml:lang="EN">Crossing the index and middle fingers in hope of luck, or to signal that one is jesting or lying.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedFingers</IRI>
    <Literal xml:lang="FR">Avant l’entretien, Léa croise l’index et le majeur pour rassurer son ami et lui souhaiter bonne chance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedFingers</IRI>
    <Literal xml:lang="EN">Crossing fingers behind your back while making a promise to signify jest or to keep fingers crossed for luck.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedFingers</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Crossed_fingers</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedFingers</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Doigts_croisés</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedFingers</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#crossedFingers</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#friendly</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <Literal xml:lang="FR">Formel</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <Literal xml:lang="EN">Formal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <Literal xml:lang="FR">Vous faites un geste formel pour marquer votre respect et attirer la bienveillance de votre interlocuteur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <Literal xml:lang="EN">Making a formal gesture to show respect and elicit goodwill from an interlocutor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <Literal xml:lang="FR">Nous avons serré la main de chaque participant en début de réunion pour marquer le respect et l’importance de l’échange.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <Literal xml:lang="EN">We shook hands with each participant at the start of the meeting to demonstrate respect and emphasize the significance of the dialogue.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handkissing</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handkissing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handkissing</IRI>
    <Literal xml:lang="FR">Baisemain</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handkissing</IRI>
    <Literal xml:lang="EN">Hand-kissing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handkissing</IRI>
    <Literal xml:lang="FR">Vous embrassez la main, pour marquer un profond respect ou votre dévouement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handkissing</IRI>
    <Literal xml:lang="EN">Kissing someone's hand as a sign of deep respect or devotion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handkissing</IRI>
    <Literal xml:lang="FR">Lors d’une réception, il lui fait un baisemain pour marquer son profond respect et gagner sa confiance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handkissing</IRI>
    <Literal xml:lang="EN">At the formal dinner, John respectfully kissed the hand of the elderly lady as a sign of his esteem.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handkissing</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hand-kissing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handkissing</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Baisemain</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handkissing</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handkissing</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#atAttention</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#atAttention</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#atAttention</IRI>
    <Literal xml:lang="FR">Garde-à-vous</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#atAttention</IRI>
    <Literal xml:lang="EN">At attention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#atAttention</IRI>
    <Literal xml:lang="FR">Vous adoptez une position verticale immobile et assertive pour saluer un supérieur hiérarchique dans un contexte militaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#atAttention</IRI>
    <Literal xml:lang="EN">Assuming a strict upright posture to salute a superior officer in a military context.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#atAttention</IRI>
    <Literal xml:lang="FR">À l’arrivée du colonel, le soldat se met au garde-à-vous pour lui témoigner son respect et obtenir son attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#atAttention</IRI>
    <Literal xml:lang="EN">During the ceremony, the soldiers stood at attention as the national anthem played, showing their respect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#atAttention</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/At_attention</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#atAttention</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Garde-à-vous</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#atAttention</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#atAttention</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#genuflection</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#genuflection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#genuflection</IRI>
    <Literal xml:lang="FR">Génuflexion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#genuflection</IRI>
    <Literal xml:lang="EN">Genuflection</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#genuflection</IRI>
    <Literal xml:lang="FR">Vous posez un genou à terre pour signifier votre dévotion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#genuflection</IRI>
    <Literal xml:lang="EN">Kneeling on one knee as a gesture of devotion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#genuflection</IRI>
    <Literal xml:lang="FR">Pour convaincre sa partenaire d’accepter sa demande en mariage, il pose un genou à terre et lui tend une bague.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#genuflection</IRI>
    <Literal xml:lang="EN">In the ancient ceremony, the knight genuflected before the queen, pledging his loyalty.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#genuflection</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Genuflection</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#genuflection</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Génuflexion</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#genuflection</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#genuflection</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bow</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bow</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bow</IRI>
    <Literal xml:lang="FR">Inclination</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bow</IRI>
    <Literal xml:lang="EN">Bow</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bow</IRI>
    <Literal xml:lang="FR">Vous penchez votre corps vers votre interlocuteur pour marquer votre respect ou votre admiration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bow</IRI>
    <Literal xml:lang="EN">Leaning the body towards an interlocutor to express respect or admiration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bow</IRI>
    <Literal xml:lang="FR">Lors de l’entretien, vous inclinez légèrement le buste vers la recruteuse pour lui témoigner votre respect et gagner sa confiance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bow</IRI>
    <Literal xml:lang="EN">He bowed deeply to the audience in gratitude after his piano recital.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bow</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Bowing</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bow</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Inclination_(geste)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bow</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#bow</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kowtow</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kowtow</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kowtow</IRI>
    <Literal xml:lang="FR">Kowtow</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kowtow</IRI>
    <Literal xml:lang="EN">Kowtow</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kowtow</IRI>
    <Literal xml:lang="FR">Vous vous prosternez devant votre interlocuteur pour marchez votre profonde dévotion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kowtow</IRI>
    <Literal xml:lang="EN">A gesture of deep respect and devotion, prostrating oneself before another.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kowtow</IRI>
    <Literal xml:lang="FR">Vous vous prosternez jusqu’au sol devant le chef pour lui témoigner votre profonde dévotion et gagner sa faveur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kowtow</IRI>
    <Literal xml:lang="EN">In a display of utmost respect, the envoy performed a kowtow before the emperor.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kowtow</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Kowtow</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kowtow</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Kowtow</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kowtow</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#kowtow</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curtsy</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curtsy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curtsy</IRI>
    <Literal xml:lang="FR">Révérence</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curtsy</IRI>
    <Literal xml:lang="EN">Curtsy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curtsy</IRI>
    <Literal xml:lang="FR">Vous vous inclinez en tenant votre toilette pour exprimer votre considération.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curtsy</IRI>
    <Literal xml:lang="EN">You bow while holding your dress to express your consideration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curtsy</IRI>
    <Literal xml:lang="FR">Exécuter une révérence peut indiquer un profond respect ou être utilisé de manière ironique pour souligner une prétendue supériorité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curtsy</IRI>
    <Literal xml:lang="EN">Performing a curtsy can indicate deep respect or be used ironically to emphasize a supposed superiority.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curtsy</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Curtsy</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curtsy</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Révérence_(geste)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curtsy</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#curtsy</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handOverHeart</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handOverHeart</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handOverHeart</IRI>
    <Literal xml:lang="FR">La main sur le cœur</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handOverHeart</IRI>
    <Literal xml:lang="EN">Hand over heart</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handOverHeart</IRI>
    <Literal xml:lang="FR">Vous posez une main à l’emplacement de votre coeur pour souligner votre profonde considération ou gratitude.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handOverHeart</IRI>
    <Literal xml:lang="EN">Placing a hand over one's heart as a gesture of sincere respect, consideration, or gratitude.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handOverHeart</IRI>
    <Literal xml:lang="FR">En remerciant son équipe, Léa pose la main sur son cœur pour montrer que leur soutien la touche profondément.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handOverHeart</IRI>
    <Literal xml:lang="EN">During the pledge of allegiance, she placed her hand over her heart, signifying her loyalty to the country.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handOverHeart</IRI>
    <Literal xml:lang="EN">https://commons.wikimedia.org/wiki/Category:Hand_over_heart</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handOverHeart</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handOverHeart</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#formal</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <Literal xml:lang="FR">Salutation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <Literal xml:lang="EN">Greeting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <Literal xml:lang="FR">Vous effectuez un signe de salutation afin de renforcer l’idée d’un accord.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <Literal xml:lang="EN">Performing a greeting gesture to reinforce the notion of agreement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <Literal xml:lang="FR">J’ai opiné du chef à chaque proposition soumise pour encourager la participation et l’accord général.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <Literal xml:lang="EN">I nodded at every proposal put forward to encourage participation and general agreement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handshake</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handshake</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handshake</IRI>
    <Literal xml:lang="FR">Poignée de main</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handshake</IRI>
    <Literal xml:lang="EN">Handshake</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handshake</IRI>
    <Literal xml:lang="FR">Vous saisissez la main de votre interlocuteur en guise de salutation ou pour signaler votre accord.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handshake</IRI>
    <Literal xml:lang="EN">Engaging in the physical act of gripping hands as a form of greeting or to signify agreement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handshake</IRI>
    <Literal xml:lang="FR">Pour convaincre le client que l’accord est conclu, vous lui serrez fermement la main en souriant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handshake</IRI>
    <Literal xml:lang="EN">After negotiating the terms, both parties shared a firm handshake, symbolizing the conclusion of the agreement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handshake</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Handshake</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handshake</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Poignée_de_main</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handshake</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handshake</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hatTip</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hatTip</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hatTip</IRI>
    <Literal xml:lang="FR">Salut du chapeau</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hatTip</IRI>
    <Literal xml:lang="EN">Hat tip</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hatTip</IRI>
    <Literal xml:lang="FR">Vous soulevez ou touchez brièvement votre chapeau en signe de respect ou de salutation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hatTip</IRI>
    <Literal xml:lang="EN">Briefly touching or lifting one's hat as a sign of respect or greeting.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hatTip</IRI>
    <Literal xml:lang="FR">Pour gagner la sympathie du voisin, Paul soulève brièvement son chapeau en le saluant.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hatTip</IRI>
    <Literal xml:lang="EN">As he walked into the room, he gave a quick hat tip in greeting to the assembled group.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hatTip</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hat_tip</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hatTip</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Chapeau#Usage</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hatTip</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#hatTip</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salute</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salute</IRI>
    <Literal xml:lang="FR">Salut militaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salute</IRI>
    <Literal xml:lang="EN">Salute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salute</IRI>
    <Literal xml:lang="FR">Vous portez la main au front en signe de respect et de reconnaissance hiérarchique dans un contexte militaire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salute</IRI>
    <Literal xml:lang="EN">Raising the hand to the forehead as a sign of respect and hierarchical recognition in a military context.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salute</IRI>
    <Literal xml:lang="FR">Face à son supérieur, le soldat porte la main au front dans un salut militaire pour montrer son respect avant de présenter sa demande.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salute</IRI>
    <Literal xml:lang="EN">During the ceremony, the soldiers gave a salute to the flag as it was raised.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salute</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Salute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salute</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Salut_militaire</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salute</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#salute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#romanSalute</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#romanSalute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#romanSalute</IRI>
    <Literal xml:lang="FR">Salut romain</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#romanSalute</IRI>
    <Literal xml:lang="EN">Roman salute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#romanSalute</IRI>
    <Literal xml:lang="FR">Vous étendez le bras devant vous, paume vers le bas, en signe de salutation ou de respect dans un contexte historique ou symbolique.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#romanSalute</IRI>
    <Literal xml:lang="EN">Extending the arm forward, palm down, as a gesture of greeting or respect in a historical or symbolic context.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#romanSalute</IRI>
    <Literal xml:lang="FR">Lors d’une reconstitution antique, le général tend le bras devant lui, paume vers le bas, pour imposer le respect à ses soldats.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#romanSalute</IRI>
    <Literal xml:lang="EN">During a public gathering, he extended his arm forward, palm down, in a respectful gesture to the audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#romanSalute</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Roman_salute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#romanSalute</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Salut_romain</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#romanSalute</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#romanSalute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scoutSalute</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scoutSalute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scoutSalute</IRI>
    <Literal xml:lang="FR">Salut scout</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scoutSalute</IRI>
    <Literal xml:lang="EN">Scout salute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scoutSalute</IRI>
    <Literal xml:lang="FR">Vous levez trois doigts de la main droite en signe de salutation ou de fidélité aux principes du scoutisme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scoutSalute</IRI>
    <Literal xml:lang="EN">Raising three fingers of the right hand as a sign of greeting or allegiance to the principles of scouting.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scoutSalute</IRI>
    <Literal xml:lang="FR">Pour convaincre les jeunes de respecter leur promesse, le chef lève trois doigts de la main droite en rappelant les principes du scoutisme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scoutSalute</IRI>
    <Literal xml:lang="EN">During a scouting event, participants give a three-finger salute, emphasizing their commitment to scouting values.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scoutSalute</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Scout_sign_and_salute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scoutSalute</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Rites_et_coutumes_dans_le_scoutisme#Salut_scout</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scoutSalute</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#scoutSalute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#budoBow</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#budoBow</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#budoBow</IRI>
    <Literal xml:lang="FR">Salut en budo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#budoBow</IRI>
    <Literal xml:lang="EN">Budo bow</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#budoBow</IRI>
    <Literal xml:lang="FR">Vous inclinez le corps en avant avec les mains sur les cuisses, en signe de respect dans les arts martiaux japonais.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#budoBow</IRI>
    <Literal xml:lang="EN">Bowing forward with hands on thighs as a sign of respect in Japanese martial arts.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#budoBow</IRI>
    <Literal xml:lang="FR">Avant le combat, vous inclinez le corps en avant, les mains sur les cuisses, pour témoigner votre respect à l’adversaire et l’inciter à faire de même.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#budoBow</IRI>
    <Literal xml:lang="EN">He bowed to his opponent, showing respect in the martial arts context.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#budoBow</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Bowing#In_martial_arts</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#budoBow</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Salut_en_budo</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#budoBow</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#budoBow</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namaste</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namaste</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namaste</IRI>
    <Literal xml:lang="FR">Namasté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namaste</IRI>
    <Literal xml:lang="EN">Namaste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namaste</IRI>
    <Literal xml:lang="FR">Vous joignez les paumes des mains devant le cœur ou le front en signe de salutation, de respect ou de prière.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namaste</IRI>
    <Literal xml:lang="EN">Joining palms in front of the heart or forehead as a sign of greeting, respect, or prayer.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namaste</IRI>
    <Literal xml:lang="FR">Pour apaiser un client mécontent, la responsable joint les paumes devant son cœur en signe de namasté et lui demande calmement de l’écouter.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namaste</IRI>
    <Literal xml:lang="EN">In a calm setting, he performed a Namaste, joining palms in front of his heart, expressing his respect and peaceful intentions.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namaste</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Namaste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namaste</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Namasté</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namaste</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#namaste</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thaiGreeting</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thaiGreeting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thaiGreeting</IRI>
    <Literal xml:lang="FR">Wai</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thaiGreeting</IRI>
    <Literal xml:lang="EN">Thai greeting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thaiGreeting</IRI>
    <Literal xml:lang="FR">Vous joignez les mains devant le visage et inclinez légèrement la tête en signe de respect, typique de la culture thaïlandaise.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thaiGreeting</IRI>
    <Literal xml:lang="EN">Join hands in front of the face and slightly bow the head as a sign of respect, typical of Thai culture.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thaiGreeting</IRI>
    <Literal xml:lang="FR">À Bangkok, un vendeur joint les mains devant son visage et incline légèrement la tête en wai pour gagner la confiance d’un client.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thaiGreeting</IRI>
    <Literal xml:lang="EN">While meeting a Thai colleague, I join my hands and bow slightly, showing my respect for their culture.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thaiGreeting</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Thai_greeting</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thaiGreeting</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Wai</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thaiGreeting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thaiGreeting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulcanSalute</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulcanSalute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulcanSalute</IRI>
    <Literal xml:lang="FR">Salut vulcain</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulcanSalute</IRI>
    <Literal xml:lang="EN">Vulcan salute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulcanSalute</IRI>
    <Literal xml:lang="FR">Vous écartez le majeur et l’annulaire en levant la main, en référence au salut populaire dans la série ’Star Trek’.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulcanSalute</IRI>
    <Literal xml:lang="EN">Separate the middle and ring fingers while raising the hand, referencing the popular salute in the 'Star Trek' series.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulcanSalute</IRI>
    <Literal xml:lang="FR">Pour convaincre ses amis de regarder Star Trek, Léa lève la main, écarte le majeur et l’annulaire et lance : « Longue vie et prospérité ! »</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulcanSalute</IRI>
    <Literal xml:lang="EN">Meeting other Star Trek fans, I give a Vulcan salute to express a shared bond without words.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulcanSalute</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Vulcan_salute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulcanSalute</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Salut_vulcain</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulcanSalute</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#vulcanSalute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#greeting</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <Literal xml:lang="FR">Idéologique</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <Literal xml:lang="EN">Ideological</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <Literal xml:lang="FR">Vous signez votre discours d’un geste idéologique pour en reforcer la signification et marquer votre auditoire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <Literal xml:lang="EN">Using gestures to signify adherence to a particular ideology, reinforcing the message and leaving a lasting impression on the audience.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <Literal xml:lang="FR">À la fin de son discours, le militant lève le poing pour renforcer son appel à la résistance et marquer les esprits.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <Literal xml:lang="EN">Wearing a pin at the rally, I silently show my support for our cause.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheCross</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheCross</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheCross</IRI>
    <Literal xml:lang="FR">Signe de croix</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheCross</IRI>
    <Literal xml:lang="EN">Sign of the cross</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheCross</IRI>
    <Literal xml:lang="FR">Vous tracez une croix sur votre corps avec votre main, signe de dévotion et de prière dans le christianisme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheCross</IRI>
    <Literal xml:lang="EN">Using the sign of the cross on one's body as a gesture of devotion and prayer within Christianity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheCross</IRI>
    <Literal xml:lang="FR">Avant de demander à sa famille de lui faire confiance, Paul fait un signe de croix pour montrer la sincérité de son engagement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheCross</IRI>
    <Literal xml:lang="EN">Making the sign of the cross on my chest as I entered the room, invoking a silent prayer for guidance.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheCross</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Sign_of_the_cross</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheCross</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Signe_de_croix</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheCross</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#signOfTheCross</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prostration</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prostration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prostration</IRI>
    <Literal xml:lang="FR">Prosternation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prostration</IRI>
    <Literal xml:lang="EN">Prostration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prostration</IRI>
    <Literal xml:lang="FR">Vous vous inclinez jusqu’à toucher le sol avec votre front, en signe de grande dévotion ou de respect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prostration</IRI>
    <Literal xml:lang="EN">Bowing deeply to touch the ground with one's forehead as a gesture of profound devotion or respect.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prostration</IRI>
    <Literal xml:lang="FR">Pour obtenir le pardon du chef, il se prosterne devant lui jusqu’à toucher le sol du front.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prostration</IRI>
    <Literal xml:lang="EN">As I approach the altar, I bow down in prostration, deeply embodying the gesture of respect and devotion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prostration</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Prostration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prostration</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Prosternation</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prostration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#prostration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#layingOnOfHands</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#layingOnOfHands</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#layingOnOfHands</IRI>
    <Literal xml:lang="FR">Imposition des mains</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#layingOnOfHands</IRI>
    <Literal xml:lang="EN">Laying on of hands</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#layingOnOfHands</IRI>
    <Literal xml:lang="FR">Vous placez vos mains sur une autre personne en signe de bénédiction ou de guérison.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#layingOnOfHands</IRI>
    <Literal xml:lang="EN">Placing hands upon another person as a gesture of blessing or healing.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#layingOnOfHands</IRI>
    <Literal xml:lang="FR">Le guérisseur pose ses mains sur les épaules d’un malade pour le convaincre qu’il peut soulager sa douleur.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#layingOnOfHands</IRI>
    <Literal xml:lang="EN">Placing my hands gently on the shoulders of a loved one, imparting a blessing of health and protection.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#layingOnOfHands</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Laying_on_of_hands</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#layingOnOfHands</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Imposition_des_mains</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#layingOnOfHands</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#layingOnOfHands</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#threefingerSalute</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#threefingerSalute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#threefingerSalute</IRI>
    <Literal xml:lang="FR">Salut à trois doigts</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#threefingerSalute</IRI>
    <Literal xml:lang="EN">Three-finger salute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#threefingerSalute</IRI>
    <Literal xml:lang="FR">Vous levez trois doigts en l’air, souvent utilisé comme symbole de résistance ou de solidarité.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#threefingerSalute</IRI>
    <Literal xml:lang="EN">Raising three fingers in the air, often used as a symbol of resistance or solidarity.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#threefingerSalute</IRI>
    <Literal xml:lang="FR">Face aux manifestants hésitants, Léa lève trois doigts en signe de solidarité pour les encourager à rester unis.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#threefingerSalute</IRI>
    <Literal xml:lang="EN">Raising three fingers in unity during the rally, symbolizing our collective resilience and hope.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#threefingerSalute</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Three-finger_salute_(Serbian)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#threefingerSalute</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Salut_à_trois_doigts</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#threefingerSalute</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#threefingerSalute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naziSalute</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naziSalute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naziSalute</IRI>
    <Literal xml:lang="FR">Salut fasciste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naziSalute</IRI>
    <Literal xml:lang="EN">Nazi salute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naziSalute</IRI>
    <Literal xml:lang="FR">Vous tendez le bras droit en l’air avec la paume vers le bas, associé historiquement au fascisme.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naziSalute</IRI>
    <Literal xml:lang="EN">Extending the right arm forward with the palm down, historically associated with fascism.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naziSalute</IRI>
    <Literal xml:lang="FR">Lors d’un rassemblement, un militant tend le bras droit, paume vers le bas, pour pousser la foule à afficher son adhésion au mouvement fasciste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naziSalute</IRI>
    <Literal xml:lang="EN">Extending my right arm in the air, I replicated a gesture historically tied to a dark era, to illustrate its power in my presentation on political symbols.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naziSalute</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Nazi_salute</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naziSalute</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Salut_fasciste</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naziSalute</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#naziSalute</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#raisedFist</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#raisedFist</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#raisedFist</IRI>
    <Literal xml:lang="FR">Poing levé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#raisedFist</IRI>
    <Literal xml:lang="EN">Raised fist</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#raisedFist</IRI>
    <Literal xml:lang="FR">Vous levez un poing serré en l’air, souvent un geste de solidarité, de résistance ou de protestation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#raisedFist</IRI>
    <Literal xml:lang="EN">Raising a clenched fist in the air, often a gesture of solidarity, resistance, or protest.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#raisedFist</IRI>
    <Literal xml:lang="FR">Pendant la manifestation, Léa lève le poing pour encourager la foule à rester unie.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#raisedFist</IRI>
    <Literal xml:lang="EN">I raised my fist high at the protest, uniting with the voices calling for change and justice.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#raisedFist</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Raised_fist</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#raisedFist</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Poing_levé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#raisedFist</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#raisedFist</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fingerRaise</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fingerRaise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fingerRaise</IRI>
    <Literal xml:lang="FR">Lever le doigt</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fingerRaise</IRI>
    <Literal xml:lang="EN">Finger raise</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fingerRaise</IRI>
    <Literal xml:lang="FR">Vous levez un doigt en l’air pour attirer l’attention ou pour indiquer que vous avez quelque chose à dire.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fingerRaise</IRI>
    <Literal xml:lang="EN">Raising a finger in the air to draw attention or to indicate having something to say.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fingerRaise</IRI>
    <Literal xml:lang="FR">En pleine réunion, Léa lève le doigt pour attirer l’attention et faire accepter son idée.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fingerRaise</IRI>
    <Literal xml:lang="EN">Elevating my finger, I signalled my eagerness to contribute to the debate, hoping to draw the room's attention.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fingerRaise</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fingerRaise</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handClasping</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handClasping</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handClasping</IRI>
    <Literal xml:lang="FR">Joindre les mains</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handClasping</IRI>
    <Literal xml:lang="EN">Hand clasping</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handClasping</IRI>
    <Literal xml:lang="FR">Vous joignez les mains, souvent en signe de prière, de supplication, de demande ou de gratitude.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handClasping</IRI>
    <Literal xml:lang="EN">Clasping hands together, often as a gesture of prayer, supplication, request, or gratitude.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handClasping</IRI>
    <Literal xml:lang="FR">Vous joignez les mains comme pour prier afin de convaincre votre collègue de vous remplacer samedi.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handClasping</IRI>
    <Literal xml:lang="EN">Clasping my hands together, I expressed my heartfelt gratitude to those who supported me during difficult times.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handClasping</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Hand_clasping</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handClasping</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#handClasping</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#ideological</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <Literal xml:lang="FR">Célébration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <Literal xml:lang="EN">Celebration</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <Literal xml:lang="FR">Vous appuyez votre discours d’un geste de célébration en vue de suggérer la survenue heureuse d’un accord de principe.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <Literal xml:lang="EN">Using a celebratory gesture to suggest the happy occurrence of an agreement in principle.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <Literal xml:lang="FR">Nous avons levé les bras en l’air en criant ’victoire’ lorsque le jury annonce notre projet comme lauréat.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <Literal xml:lang="EN">We raised our arms in the air shouting 'victory' when the jury announced our project as the winner.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#gesture</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
    <Literal xml:lang="FR">Applaudissement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
    <Literal xml:lang="EN">Applause</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
    <Literal xml:lang="FR">Vous frappez vos mains l’une contre l’autre pour exprimer l’approbation ou l’appréciation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
    <Literal xml:lang="EN">Clapping one's hands together to express approval or appreciation.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
    <Literal xml:lang="FR">Nous avons offert une ovation debout à la fin d’une performance à couper le souffle pour montrer une immense admiration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
    <Literal xml:lang="EN">A standing ovation at the end of a breathtaking performance to show immense admiration.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Applause</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Applaudissement</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clapping</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clapping</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clapping</IRI>
    <Literal xml:lang="FR">Clapping</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clapping</IRI>
    <Literal xml:lang="EN">Clapping</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clapping</IRI>
    <Literal xml:lang="FR">Vous frappez vos mains l’une contre l’autre rythmiquement, souvent pour accompagner une musique ou pour encourager.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clapping</IRI>
    <Literal xml:lang="EN">Striking one's hands together rhythmically, often to accompany music or to encourage.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clapping</IRI>
    <Literal xml:lang="FR">J’ai tapé des mains en rythme lors du concert pour montrer mon plaisir et mon soutien à l’artiste.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clapping</IRI>
    <Literal xml:lang="EN">Clapping along to the beat at a concert to show your enjoyment and support for the artist.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clapping</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Clapping</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clapping</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Clapping_(applaudissement)</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clapping</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#clapping</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#applause</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#highFive</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#highFive</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#highFive</IRI>
    <Literal xml:lang="FR">High five</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#highFive</IRI>
    <Literal xml:lang="EN">High five</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#highFive</IRI>
    <Literal xml:lang="FR">Vous tapez la paume de votre main contre celle d’une autre personne en l’air, en signe de célébration ou d’accord.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#highFive</IRI>
    <Literal xml:lang="EN">Slapping the palm of one's hand against another person's in midair as a sign of celebration or agreement.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#highFive</IRI>
    <Literal xml:lang="FR">J’ai partagé un « high five » avec ce coéquipier après son action réussie pour reconnaître un travail bien fait.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#highFive</IRI>
    <Literal xml:lang="EN">I shared a high five with my teammate after their successful action, acknowledging a job well done.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#highFive</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/High_five</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#highFive</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/High_five</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#highFive</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#highFive</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#type" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsup</IRI>
    <IRI>http://www.w3.org/2004/02/skos/core#Concept</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#inScheme" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsup</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#fallacyScheme</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsup</IRI>
    <Literal xml:lang="FR">Pouce levé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsup</IRI>
    <Literal xml:lang="EN">Thumbs-up</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsup</IRI>
    <Literal xml:lang="FR">Vous levez le pouce en signe d’approbation, de satisfaction ou pour signaler que tout va bien.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsup</IRI>
    <Literal xml:lang="EN">Raising one's thumb as a sign of approval, satisfaction, or to indicate that all is well.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsup</IRI>
    <Literal xml:lang="FR">J’ai fait un pouce levé pour signaler mon accord avec la décision prise lors de la réunion.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#example" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsup</IRI>
    <Literal xml:lang="EN">Giving a thumbs-up to signal your agreement with the decision made during a meeting.</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsup</IRI>
    <Literal xml:lang="EN">https://en.wikipedia.org/wiki/Thumb_signal</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#seeAlso" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsup</IRI>
    <Literal xml:lang="FR">https://fr.wikipedia.org/wiki/Pouce_levé</Literal>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#narrower" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsup</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
    <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#broader" />
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#thumbsup</IRI>
    <IRI>https://www.argumentum.games/argumentum_fallacies.owl#celebration</IRI>
  </AnnotationAssertion>
  <AnnotationAssertion>
