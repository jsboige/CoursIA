import MathUniverse_en

/-!
# General mutual generation — arbitrary arity (Appendix A of R16, slice 4)

Follows `MathUniverse` (finite structures, decidability of equivalence) and
`Generators` (binary term on a single generator, NAND instance of equation (A2)).
This slice generalizes the two residuals named throughout #16753:

1. **The arbitrary-arity tuple**: `TermSig` is a term over an arbitrary
   signature `σ : Fin n → ℕ` — `n` symbols, each of arity `σ i`,
   multi-generators where `Generators.Term` carried a single binary generator.
2. **General mutual generation**: the paper's "two structure definitions are
   equivalent if they generate each other" (§A.2), rendered as a general
   theorem — if every generator of `g₁` is defined by a term over `g₂` and
   conversely, then `g₁` and `g₂` generate **exactly the same functions**
   (`mutual_gen_iff`), by double substitution of terms (`translate`).

The engine lemma is the compatibility of evaluation with substitution
(`eval_subst`, `eval_translate`) — the paper's "easy to see" argument:
replacing a symbol by its definition inside a term does not change the
computed function. The examples close on the `nand` anchor of
`MathUniverse`: an arity-3 function generated by the binary generator alone,
and a two-symbol signature (¬, ∧) generating ∨ by De Morgan — each confirmed
by the kernel (`decide`), with the witness carried by the proof rather than
the statement.

Paper source: R16 — M. Tegmark, *The Mathematical Universe*, arXiv:0704.0646,
Appendix A §A.2. Issue: #16753 (slice 4).
-/

namespace MathUniverse.MutualGen_en

/-! ## 1. Terms over an arbitrary signature

The signature `σ : Fin n → ℕ` gives the arity of each of the `n` symbols.
A term is either a variable or a symbol `i` applied to `σ i` subterms — the
arbitrary-arity tuple of residual #16753. -/

/-- A **term** over the signature `σ` with coefficients in the variables `ν`:
either a variable, or the symbol `i` applied to `σ i` subterms. -/

inductive TermSig {n : ℕ} (σ : Fin n → ℕ) (ν : Type) where
  /-- a variable -/
  | var : ν → TermSig σ ν
  /-- the symbol `i` applied to `σ i` subterms -/
  | node : (i : Fin n) → (Fin (σ i) → TermSig σ ν) → TermSig σ ν

/-- The **evaluation** of a term: a valuation of the variables and a family
of concrete generators — for each symbol `i`, a function of arity `σ i`
over `α`. -/
def TermSig.eval {n : ℕ} {σ : Fin n → ℕ} {ν α : Type}
    (t : TermSig σ ν)
    (g : (i : Fin n) → ((Fin (σ i) → α) → α)) (env : ν → α) : α :=
  match t with
  | .var x => env x
  | .node i args => g i (fun k => (args k).eval g env)

/-- The **function of arity `ν` defined by a term**: the term evaluated as
a function of the variables. -/
def TermSig.funOf {n : ℕ} {σ : Fin n → ℕ} {ν α : Type}
    (t : TermSig σ ν) (g : (i : Fin n) → ((Fin (σ i) → α) → α)) :
    (ν → α) → α :=
  fun env => t.eval g env

/-- The generator family `g` **generates** the function `f` when a term
defines it — the multi-symbol, arbitrary-arity generalization of the binary
`Generates`. -/
def GeneratesSig {n : ℕ} {σ : Fin n → ℕ} {ν α : Type}
    (g : (i : Fin n) → ((Fin (σ i) → α) → α)) (f : (ν → α) → α) : Prop :=
  ∃ t : TermSig σ ν, t.funOf g = f

/-! ## 2. Substitution — the engine lemma

Substituting a term for each variable of another amounts to composing the
evaluations. This is the only computation mutual generation needs. -/

/-- The **substitution** `t[s]`: each variable `x` of `t` replaced by the
term `s x`. -/
def TermSig.subst {n : ℕ} {σ : Fin n → ℕ} {ν μ : Type}
    (t : TermSig σ ν) (s : ν → TermSig σ μ) : TermSig σ μ :=
  match t with
  | .var x => s x
  | .node i args => .node i (fun k => (args k).subst s)

/-- **Evaluation is compatible with substitution**: evaluating `t[s]` in
`env` is evaluating `t` in the values of `s` in `env`. -/
theorem TermSig.eval_subst {n : ℕ} {σ : Fin n → ℕ} {ν μ α : Type}
    (t : TermSig σ ν) (s : ν → TermSig σ μ)
    (g : (i : Fin n) → ((Fin (σ i) → α) → α)) (env : μ → α) :
    (t.subst s).eval g env = t.eval g (fun x => (s x).eval g env) := by
  induction t with
  | var x => rfl
  | node i args ih =>
      simp only [TermSig.subst, TermSig.eval]
      exact congrArg (g i) (funext ih)

/-- **The translation of a term over `g₁` into a term over `g₂`**: each
symbol `i` of the signature of `g₁` is replaced by its definitional term
`d i` over `g₂` — substitution applied symbol by symbol. -/
def translate {n₁ n₂ : ℕ} {σ₁ : Fin n₁ → ℕ} {σ₂ : Fin n₂ → ℕ} {ν : Type}
    (d : (i : Fin n₁) → TermSig σ₂ (Fin (σ₁ i))) (t : TermSig σ₁ ν) :
    TermSig σ₂ ν :=
  match t with
  | .var x => .var x
  | .node i args => (d i).subst (fun k => translate d (args k))

/-- **Translation preserves evaluation**: if each `d i` defines `g₁ i`
over `g₂`, then the translated term computes the same function — replacing
a symbol by its definition does not change the value. This is the paper's
"easy to see" of §A.2, made precise. -/
theorem eval_translate {n₁ n₂ : ℕ} {σ₁ : Fin n₁ → ℕ} {σ₂ : Fin n₂ → ℕ} {ν α : Type}
    (g₁ : (i : Fin n₁) → ((Fin (σ₁ i) → α) → α))
    (g₂ : (i : Fin n₂) → ((Fin (σ₂ i) → α) → α))
    (d : (i : Fin n₁) → TermSig σ₂ (Fin (σ₁ i)))
    (hd : ∀ (i : Fin n₁) (t : Fin (σ₁ i) → α), (d i).eval g₂ t = g₁ i t)
    (t : TermSig σ₁ ν) (env : ν → α) :
    (translate d t).eval g₂ env = t.eval g₁ env := by
  induction t with
  | var x => rfl
  | node i args ih =>
      simp only [translate, TermSig.eval_subst]
      have e : (fun k => (translate d (args k)).eval g₂ env)
          = (fun k => (args k).eval g₁ env) := funext ih
      simp only [TermSig.eval]
      rw [e, hd i]

/-! ## 3. General mutual generation

The paper's theorem: two definitions that generate each other are
equivalent — here, at the level of generated functions: the two generator
families define exactly the same functions, all arities together. -/

/-- **General mutual generation** (§A.2): if every generator of `g₁` is
generated by `g₂` and every generator of `g₂` by `g₁`, then `g₁` and `g₂`
generate exactly the same functions — of any arity `ν`. -/
theorem mutual_gen_iff {n₁ n₂ : ℕ} {σ₁ : Fin n₁ → ℕ} {σ₂ : Fin n₂ → ℕ} {α ν : Type}
    (g₁ : (i : Fin n₁) → ((Fin (σ₁ i) → α) → α))
    (g₂ : (i : Fin n₂) → ((Fin (σ₂ i) → α) → α))
    (h₁ : ∀ i : Fin n₁, GeneratesSig g₂ (g₁ i))
    (h₂ : ∀ i : Fin n₂, GeneratesSig g₁ (g₂ i))
    (f : (ν → α) → α) :
    GeneratesSig g₁ f ↔ GeneratesSig g₂ f := by
  constructor
  · rintro ⟨t, ht⟩
    choose d hd using h₁
    have hd' : ∀ (i : Fin n₁) (u : Fin (σ₁ i) → α), (d i).eval g₂ u = g₁ i u :=
      fun i u => congrFun (hd i) u
    refine ⟨translate d t, funext fun env => ?_⟩
    show (translate d t).eval g₂ env = f env
    rw [eval_translate g₁ g₂ d hd' t env]
    exact congrFun ht env
  · rintro ⟨t, ht⟩
    choose d hd using h₂
    have hd' : ∀ (i : Fin n₂) (u : Fin (σ₂ i) → α), (d i).eval g₁ u = g₂ i u :=
      fun i u => congrFun (hd i) u
    refine ⟨translate d t, funext fun env => ?_⟩
    show (translate d t).eval g₁ env = f env
    rw [eval_translate g₂ g₁ d hd' t env]
    exact congrFun ht env

/-! ## 4. Examples — the `nand` anchor

Two witnesses confirmed by the kernel, carried by the proof rather than the
statement: an **arity-3** function generated by the binary NAND generator
alone, and a **two-symbol** signature (¬ unary, ∧ binary) generating ∨ by
De Morgan. -/

/-- The single binary-symbol signature: NAND alone (equation (A2)). -/
def nandSig : Fin 1 → ℕ := fun _ => 2

/-- The concrete generator: NAND over `Bool`, read as an arity-2 function.
The type carries the **literal** arity `Fin 2`: `σ := fun _ => 2` is
recovered by pattern unification, and `t 0` / `t 1` synthesize
`OfNat (Fin 2)` directly — going through `Fin (nandSig i)` would require
unfolding `nandSig` on the fly, which instance search does not do. -/
def nandG : (i : Fin 1) → ((Fin 2 → Bool) → Bool) :=
  fun _ t => MathUniverse_en.Examples.nand (t 0) (t 1)

/-- The arity-2 conjunction: the target of the first witness. -/
def and2 : (Fin 2 → Bool) → Bool := fun t => t 0 && t 1

/-- The arity-3 conjunction: `x ∧ y ∧ z` — the arbitrary-arity tuple,
generated by the binary symbol alone. -/
def and3 : (Fin 3 → Bool) → Bool := fun t => t 0 && t 1 && t 2

/-- A brick term: `a ∧ b` as double NAND — `R(R(a, b), R(a, b))`,
reusable. -/
def tAnd {ν : Type} (a b : TermSig nandSig ν) : TermSig nandSig ν :=
  .node 0 (fun _ => .node 0 ![a, b])

/-- **NAND generates ∧** (R₄ of §A.2): `x ∧ y = R(R(x, y), R(x, y))`. The
kernel confirms the function equality by exhaustive evaluation of the
environments (`decide` via `Pi.instDecidableEqFintype`). -/
theorem nand_generates_and2 : GeneratesSig nandG and2 :=
  ⟨tAnd (.var 0) (.var 1), by decide⟩

/-- **NAND generates an arity-3 function**: `x ∧ y ∧ z` by composition —
the arity of the tuple is not a ceiling on the binary generator. -/
theorem nand_generates_and3 : GeneratesSig nandG and3 :=
  ⟨tAnd (tAnd (.var 0) (.var 1)) (.var 2), by decide⟩

/-- The two-symbol signature: ¬ (unary) and ∧ (binary). The structural
match on `0` / `⟨j + 1, _⟩` (the `Fin.cons` idiom) makes the arity reduce
by iota on the literal index as well as on the successor. -/
def notAndSig : Fin 2 → ℕ
  | 0 => 1
  | ⟨j + 1, _⟩ => 2

/-- The concrete generators: negation and conjunction over `Bool`,
distinguished by the same structural match. Each branch **announces its
literal arity** (`Fin 1` / `Fin 2`) — definitional unification unfolds
`notAndSig` on the pattern, and `u 0` / `u 1` synthesize `OfNat` on a
literal, never on an opaque `Fin (notAndSig i)`. Iota reduction on the
concrete indices of the witness carries the proof by `decide`. -/
def notAndG : (i : Fin 2) → ((Fin (notAndSig i) → Bool) → Bool)
  | 0 => fun (u : Fin 1 → Bool) => !(u 0)
  | ⟨j + 1, _⟩ => fun (u : Fin 2 → Bool) => u 0 && u 1

/-- The disjunction: the target of the De Morgan witness. -/
def or2 : (Fin 2 → Bool) → Bool := fun t => t 0 || t 1

/-- **¬ and ∧ generate ∨ by De Morgan**: `x ∨ y = ¬(¬x ∧ ¬y)` — a
multi-generator, two distinct arities in the same signature. -/
theorem notAnd_generates_or2 :
    GeneratesSig notAndG or2 :=
  ⟨.node 0 (fun _ => .node 1 (fun k => .node 0 (fun _ => .var k))), by decide⟩

end MathUniverse.MutualGen_en
