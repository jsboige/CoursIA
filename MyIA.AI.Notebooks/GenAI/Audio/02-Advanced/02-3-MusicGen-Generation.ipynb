import time
from pathlib import Path

import numpy as np
import soundfile as sf
import torch


def compare_description_precision(descriptions, model, output_dir):
    """
    Compare la qualité de génération selon la précision de la description.

    Args:
        descriptions (list): Liste de descriptions de précision croissante
        model: Modèle MusicGen chargé
        output_dir (Path): Répertoire de sauvegarde

    Returns:
        list: Liste de dictionnaires avec 'description', 'rms', 'variance', ...
    """
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    results = []

    # Paramètres imposés par l'énoncé
    model.set_generation_params(temperature=1.0, duration=8)
    sample_rate = model.sample_rate

    for i, desc in enumerate(descriptions):
        print(f"Génération {i+1}/{len(descriptions)} : {desc[:30]}...")

        # Même graine pour chaque description -> comparaison plus équitable
        torch.manual_seed(42)

        # Étape 1 : générer l'audio
        start = time.time()
        wav = model.generate([desc])           # shape : [batch, canaux, échantillons]
        gen_time = time.time() - start

        samples = wav[0, 0].detach().cpu().numpy().astype(np.float32)

        # Étape 2 : métriques
        rms = float(np.sqrt(np.mean(samples ** 2)))
        variance = float(np.var(samples))

        # Bonus : stabilité temporelle (variance du RMS par fenêtres de 0,5 s)
        win = sample_rate // 2
        n_win = len(samples) // win
        frames = samples[: n_win * win].reshape(n_win, win)
        rms_windows = np.sqrt(np.mean(frames ** 2, axis=1))
        rms_variability = float(np.var(rms_windows))

        # Étape 3 : sauvegarde
        filepath = output_dir / f"precision_test_{i+1}.wav"
        sf.write(str(filepath), samples, sample_rate)

        results.append({
            "description": desc,
            "rms": rms,
            "variance": variance,
            "rms_variability": rms_variability,
            "gen_time": gen_time,
            "filepath": str(filepath),
        })

    return results


