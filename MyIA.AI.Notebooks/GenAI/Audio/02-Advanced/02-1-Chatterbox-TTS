    "# Exercice 1 - Correction : debit de parole en fonction de la longueur du texte\n",
    "#\n",
    "# Idee : on genere le DEBUT d'un meme texte de reference a 4 longueurs\n",
    "# (10, 20, 40, 60 mots). Garder le meme texte et les memes parametres\n",
    "# (exaggeration, cfg_weight, seed) isole l'effet de la seule longueur.\n",
    "\n",
    "\n",
    "def _to_numpy(wav):\n",
    "    \"\"\"Convertit la sortie de model.generate() (tenseur torch ou array) en 1D numpy.\"\"\"\n",
    "    if hasattr(wav, 'cpu'):\n",
    "        return wav.detach().cpu().numpy().squeeze()\n",
    "    return np.asarray(wav).squeeze()\n",
    "\n",
    "\n",
    "def measure_speech_rate(texts, model):\n",
    "    \"\"\"\n",
    "    Mesure le debit de parole pour des textes de differentes longueurs.\n",
    "\n",
    "    Args:\n",
    "        texts (list): Liste de textes de longueurs croissantes\n",
    "        model: Modele Chatterbox charge\n",
    "\n",
    "    Returns:\n",
    "        list: Liste de dictionnaires avec 'word_count', 'duration', 'rate'\n",
    "    \"\"\"\n",
    "    results = []\n",
    "    for text in texts:\n",
    "        # Etape 1 : nombre de mots (separation sur les espaces)\n",
    "        word_count = len(text.split())\n",
    "        if word_count == 0:\n",
    "            # Cas limite : texte vide -> rien a synthetiser, on l'ignore\n",
    "            print(\"Texte vide ignore\")\n",
    "            continue\n",
    "\n",
    "        # Etape 2 : generation avec les memes parametres pour tous les textes\n",
    "        start = time.time()\n",
    "        wav = model.generate(text=text, exaggeration=exaggeration, cfg_weight=cfg_weight)\n",
    "        gen_time = time.time() - start\n",
    "\n",
    "        # Etape 3 : duree = nb d'echantillons / frequence d'echantillonnage\n",
    "        samples = _to_numpy(wav)\n",
    "        duration = len(samples) / model.sr\n",
    "        rate = word_count / duration if duration > 0 else float('nan')\n",
    "\n",
    "        results.append({\n",
    "            'word_count': word_count,\n",
    "            'duration': duration,\n",
    "            'rate': rate,\n",
    "            'gen_time': gen_time,\n",
    "        })\n",
    "    return results\n",
    "\n",
    "\n",
    "# Texte de reference (> 60 mots) dont on prend les N premiers mots\n",
    "reference_text = (\n",
    "    \"Speech synthesis has made remarkable progress over the last decade. \"\n",
    "    \"Modern neural models can now read a paragraph with natural rhythm, \"\n",
    "    \"clear pronunciation and a convincing emotional tone. In this experiment \"\n",
    "    \"we measure how the duration of the generated audio grows with the number \"\n",
    "    \"of words, in order to estimate the average speaking rate of the model. \"\n",
    "    \"A stable rate means that the duration of a long narration can be predicted \"\n",
    "    \"before generating it, which is useful to plan audiobooks or lessons.\"\n",
    ")\n",
    "ref_words = reference_text.split()\n",
    "target_lengths = [10, 20, 40, 60]\n",
    "assert len(ref_words) >= max(target_lengths), \"Le texte de reference doit faire au moins 60 mots\"\n",
    "\n",
    "long_texts = [\" \".join(ref_words[:n]) for n in target_lengths]\n",
    "\n",
    "if chatterbox_loaded and generate_audio:\n",
    "    rate_results = measure_speech_rate(long_texts, model)\n",
    "\n",
    "    print(f\"{'Mots':<6} {'Duree':>8} {'Debit':>12} {'Generation':>12}\")\n",
    "    for r in rate_results:\n",
    "        print(f\"{r['word_count']:<6} {r['duration']:>7.1f}s {r['rate']:>7.2f} mots/s {r['gen_time']:>10.1f}s\")\n",
    "\n",
    "    words = np.array([r['word_count'] for r in rate_results], dtype=float)\n",
    "    durations = np.array([r['duration'] for r in rate_results], dtype=float)\n",
    "\n",
    "    # Debit moyen global = total mots / total secondes (pondere par la longueur,\n",
    "    # plus robuste que la moyenne des debits individuels)\n",
    "    mean_rate = words.sum() / durations.sum()\n",
    "    print(f\"\\nDebit moyen global : {mean_rate:.2f} mots/s\")\n",
    "\n",
    "    # Regression lineaire duree = a * mots + b :\n",
    "    #   a = secondes par mot (1/a = debit \"marginal\"),\n",
    "    #   b = surcout fixe (silences de debut/fin) independant de la longueur\n",
    "    if len(words) >= 2:\n",
    "        a, b = np.polyfit(words, durations, 1)\n",
    "        print(f\"Regression : duree ~ {a:.3f} s/mot x mots + {b:.2f} s  (debit marginal {1/a:.2f} mots/s)\")\n",
    "\n",
    "    try:\n",
    "        import matplotlib.pyplot as plt\n",
    "        fig, ax = plt.subplots(figsize=(7, 4))\n",
    "        ax.plot(words, durations, 'o', label='Mesures')\n",
    "        if len(words) >= 2:\n",
    "            xs = np.linspace(0, words.max(), 50)\n",
    "            ax.plot(xs, a * xs + b, '--', label=f'Regression ({1/a:.2f} mots/s)')\n",
    "        ax.set_xlabel('Nombre de mots')\n",
    "        ax.set_ylabel('Duree audio (s)')\n",
    "        ax.set_title('Chatterbox : duree audio vs longueur du texte')\n",
    "        ax.grid(alpha=0.3)\n",
    "        ax.legend()\n",
    "        plt.tight_layout()\n",
    "        if save_results:\n",
    "            fig.savefig(OUTPUT_DIR / 'chatterbox_speech_rate.png', dpi=100)\n",
    "        plt.show()\n",
    "    except ImportError:\n",
    "        print(\"matplotlib non installe : graphique ignore\")\n",
    "else:\n",
    "    print(\"Modele non charge ou generation desactivee : exercice non execute\")"
