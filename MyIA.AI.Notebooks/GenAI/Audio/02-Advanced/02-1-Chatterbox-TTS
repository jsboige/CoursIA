    "# Test des differents niveaux d'expressivite\n",
    "# #20624 : chaque reglage est mesure sur plusieurs passes. Une seule passe\n",
    "# ne distingue pas une tendance d'un alea de generation -- la prose citait\n",
    "# des valeurs non reproductibles d'un run a l'autre.\n",
    "print(\"CONTROLE DES EMOTIONS\")\n",
    "print(\"=\" * 45)\n",
    "\n",
    "emotion_text = (\n",
    "    \"I am absolutely thrilled to share this incredible news with you today. \"\n",
    "    \"This is going to change everything.\"\n",
    ")\n",
    "\n",
    "exaggeration_levels = [0.0, 0.25, 0.5, 0.75, 1.0]\n",
    "n_passes = 3\n",
    "emotion_results = {}\n",
    "\n",
    "if chatterbox_loaded and generate_audio and compare_emotions:\n",
    "    # Le logger de chatterbox emet une ligne \"EOS token detected\" par\n",
    "    # generation : deux objets de sortie par generation, sans valeur\n",
    "    # pedagogique. On le ramene a WARNING pour que le volume de sortie\n",
    "    # suive la mesure et non la verbosite de la bibliotheque.\n",
    "    logging.getLogger(\"chatterbox\").setLevel(logging.WARNING)\n",
    "\n",
    "    for exag in exaggeration_levels:\n",
    "        print(f\"\\nExaggeration = {exag}\")\n",
    "        passes = []\n",
    "        pass_lines = []\n",
    "\n",
    "        for pass_idx in range(n_passes):\n",
    "            # Graine distincte par passe : la dispersion mesuree inclut\n",
    "            # l alea de sampling, pas seulement la variation du reglage.\n",
    "            pass_seed = seed + pass_idx\n",
    "            random.seed(pass_seed)\n",
    "            np.random.seed(pass_seed)\n",
    "            if torch is not None:\n",
    "                torch.manual_seed(pass_seed)\n",
    "                torch.cuda.manual_seed_all(pass_seed)\n",
    "\n",
    "            start_time = time.time()\n",
    "            wav = model.generate(\n",
    "                text=emotion_text,\n",
    "                exaggeration=exag,\n",
    "                cfg_weight=cfg_weight\n",
    "            )\n",
    "            gen_time = time.time() - start_time\n",
    "\n",
    "            if hasattr(wav, 'cpu'):\n",
    "                samples = wav.cpu().numpy().squeeze()\n",
    "            else:\n",
    "                samples = np.array(wav).squeeze()\n",
    "\n",
    "            sample_rate = model.sr\n",
    "            duration = len(samples) / sample_rate\n",
    "            passes.append({\n",
    "                \"duration\": duration,\n",
    "                \"gen_time\": gen_time,\n",
    "                \"ratio\": duration / gen_time,\n",
    "                \"samples\": samples,\n",
    "                \"sample_rate\": sample_rate,\n",
    "            })\n",
    "            pass_lines.append(\n",
    "                f\"  passe {pass_idx + 1}/{n_passes} : Duree {duration:.1f}s | \"\n",
    "                f\"Temps {gen_time:.2f}s | Ratio TR {duration / gen_time:.2f}x\")\n",
    "\n",
    "            if pass_idx == 0:\n",
    "                display_audio_array(samples, sample_rate)\n",
    "                if save_results:\n",
    "                    filepath = OUTPUT_DIR / f\"emotion_exag_{exag:.2f}.wav\"\n",
    "                    sf.write(str(filepath), samples, sample_rate)\n",
    "\n",
    "        # Un seul objet de sortie par reglage : les 3 passes sont regroupees\n",
    "        # en un bloc. Un print par iteration ferait croitre le volume de\n",
    "        # sortie avec le nombre de passes, sans rien ajouter a la lecture.\n",
    "        print(\"\\n\".join(pass_lines))\n",
    "\n",
    "        gen_times = [p[\"gen_time\"] for p in passes]\n",
    "        durations = [p[\"duration\"] for p in passes]\n",
    "        ratios = [p[\"ratio\"] for p in passes]\n",
    "        emotion_results[exag] = {\n",
    "            \"passes\": len(passes),\n",
    "            \"duration_median\": float(np.median(durations)),\n",
    "            \"duration_spread\": float(max(durations) - min(durations)),\n",
    "            \"gen_time_median\": float(np.median(gen_times)),\n",
    "            \"gen_time_spread\": float(max(gen_times) - min(gen_times)),\n",
    "            \"ratio_median\": float(np.median(ratios)),\n",
    "            \"ratio_spread\": float(max(ratios) - min(ratios)),\n",
