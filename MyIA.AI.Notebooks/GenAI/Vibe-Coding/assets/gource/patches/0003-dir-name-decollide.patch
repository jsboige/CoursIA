+// ---------------------------------------------------------------------------
+// Etiquettes de repertoires : une boite ecran par etiquette, un choix sans
+// recouvrement (--dir-name-decollide) et un journal des boites
+// (--dir-label-boxes). Les deux sont inactifs par defaut et ne changent rien
+// au dessin d'origine.
+//
+// Le nom est dessine sous push2D(), en pixels ecran, avec la police des
+// repertoires (couleur et alpha par etiquette, coordonnees non arrondies) :
+// l'ancre spline.getLabelPos() et les metriques de FXFont sont donc dans le
+// meme repere, et la boite du texte est exacte sans transformation.
+//
+// Priorite du choix : alpha decroissant (ce qui vient de changer passe avant
+// un nom de hub), puis profondeur croissante (un repertoire general passe
+// avant ses descendants), puis le texte pour un ordre total et reproductible.
+// Une exception a l'alpha : le nom d'un descendant cede a celui du hub qui
+// le contient, pour qu'un nom de hub ne clignote pas a chaque modification
+// de son sous-arbre ; ailleurs, un nom en changement passe bien avant un hub.
+// ---------------------------------------------------------------------------
+
+struct DirLabel {
+    const RDirNode* node;
+    std::string     text;
+    float           alpha;
+    float           x;         // ancre ecran (pixels)
+    float           y;
+    float           w;         // largeur du texte
+    float           asc;       // ascender (positif)
+    float           desc;      // descender (negatif ou nul)
+    float           top;       // haut de la ligne telle qu'elle est dessinee
+    float           bottom;    // bas de cette meme ligne
+    int             depth;
+    int             id;        // identite stable du nom d'un top a l'autre
+    int             prev_rank; // rang retenu au top precedent, -1 si nouveau
+    bool            hub;       // nom tenu par --dir-name-hubs
+    int             group;     // 0 : en changement hors hub, 1 : hub, 2 : sous un hub
+    std::vector<const RDirNode*> ancestors;
+    bool            kept;
+    int             kept_after; // etiquette retenue qui a bloque celle-ci, -1 sinon
+};
+
+namespace {
+
+    std::vector<DirLabel> gDirLabels;
+    std::ofstream         gDirLabelLog;
+    int                   gDirLabelFrame = 0;
+
+    // Identite d'un nom d'un top a l'autre. La cle est le noeud ; le texte et
+    // la profondeur la valident, pour qu'un noeud detruit puis recree a la
+    // meme adresse ne prenne pas l'identite de son predecesseur.
+    struct DirLabelIdentity {
+        DirLabelIdentity() : depth(-1), rank(-1), id(0) {}
+
+        std::string text;
+        int         depth;
+        int         rank;  // rang parmi les noms retenus du dernier top, -1 sinon
+        int         id;    // numero attribue a la premiere apparition
+    };
+
+    std::map<const RDirNode*, DirLabelIdentity> gDirLabelIdentities;
+    int gDirLabelNextId = 0;
+
+    DirLabelIdentity& dirLabelIdentity(const DirLabel& label) {
+        DirLabelIdentity& entree = gDirLabelIdentities[label.node];
+
+        if(entree.depth != label.depth || entree.text != label.text) {
+            entree.text  = label.text;
+            entree.depth = label.depth;
+            entree.rank  = -1;
+            entree.id    = ++gDirLabelNextId;
+        }
+
+        return entree;
+    }
+
+    // La boite de a est agrandie de gap de chaque cote, celle de b ne l'est pas :
+    // deux etiquettes retenues finissent donc separees d'au moins gap pixels.
+    bool dirLabelOverlap(const DirLabel& a, const DirLabel& b, float gap) {
+        // Les boites sont celles que la police dessine reellement : draw(x, y)
+        // pose la ligne de base a y + getHeight() (align_top), donc le haut du
+        // texte est getHeight() - asc sous y, pas asc au-dessus.
+        float a_left   = a.x - gap;
+        float a_right  = a.x + a.w + gap;
+        float a_top    = a.top - gap;
+        float a_bottom = a.bottom + gap;
+
+        float b_left   = b.x;
+        float b_right  = b.x + b.w;
+        float b_top    = b.top;
+        float b_bottom = b.bottom;
+
+        return a_left < b_right && b_left < a_right && a_top < b_bottom && b_top < a_bottom;
+    }
+
+    // Priorite : le groupe, puis le nom deja retenu au top precedent (a son
+    // rang), puis seulement la fraicheur. Sans cette preseance, un nom cede sa
+    // place des qu'un voisin est modifie, alors qu'il est encore candidat :
+    // le jeu retenu clignotait a la cadence des commits.
+    bool dirLabelFirst(const DirLabel& a, const DirLabel& b) {
+        if(a.group != b.group) return a.group < b.group;
+
+        bool a_garde = a.prev_rank >= 0;
+        bool b_garde = b.prev_rank >= 0;
+
+        if(a_garde != b_garde) return a_garde;
+        if(a_garde && a.prev_rank != b.prev_rank) return a.prev_rank < b.prev_rank;
+
+        if(a.alpha != b.alpha) return a.alpha > b.alpha;
+        if(a.depth != b.depth) return a.depth < b.depth;
+        return a.text < b.text;
+    }
+
+    // Trois groupes : ce qui change hors des hubs, les hubs, puis ce qui
+    // change dans le sous-arbre d'un hub nomme.
+    void groupDirLabels() {
+        std::set<const RDirNode*> hubs;
+
+        for(size_t i = 0; i < gDirLabels.size(); i++) {
+            if(gDirLabels[i].hub) hubs.insert(gDirLabels[i].node);
+        }
+
+        for(size_t i = 0; i < gDirLabels.size(); i++) {
+            DirLabel& label = gDirLabels[i];
+
+            bool sous_hub = false;
+            for(size_t k = 0; k < label.ancestors.size(); k++) {
+                if(hubs.count(label.ancestors[k]) != 0) { sous_hub = true; break; }
+            }
+
+            label.group = label.hub ? 1 : (sous_hub ? 2 : 0);
+        }
+    }
+
+    void selectDirLabels(float gap, int max_labels) {
+        // Les rangs du top precedent sont lus ici, puis remis a -1 pour tous :
+        // seuls les noms retenus a ce top en porteront un, et un nom qui
+        // disparait du jeu un seul top n'en retrouve pas un plus tard.
+        for(size_t i = 0; i < gDirLabels.size(); i++) {
+            DirLabelIdentity& entree = dirLabelIdentity(gDirLabels[i]);
+            gDirLabels[i].id        = entree.id;
+            gDirLabels[i].prev_rank = entree.rank;
+        }
+
+        for(std::map<const RDirNode*, DirLabelIdentity>::iterator it = gDirLabelIdentities.begin();
+            it != gDirLabelIdentities.end(); ++it) {
+            it->second.rank = -1;
+        }
+
+        groupDirLabels();
+        std::stable_sort(gDirLabels.begin(), gDirLabels.end(), dirLabelFirst);
+
+        std::vector<size_t> kept;
+
+        for(size_t i = 0; i < gDirLabels.size(); i++) {
+            DirLabel& candidate = gDirLabels[i];
+
+            candidate.kept = false;
+            candidate.kept_after = -1;
+
+            bool blocked = false;
+
+            if(max_labels > 0 && (int)kept.size() >= max_labels) {
+                blocked = true;
+            } else {
+                for(size_t k = 0; k < kept.size(); k++) {
+                    if(dirLabelOverlap(candidate, gDirLabels[kept[k]], gap)) {
+                        blocked = true;
+                        candidate.kept_after = (int)k;
+                        break;
+                    }
+                }
+            }
+
+            if(blocked) continue;
+
+            candidate.kept = true;
+            kept.push_back(i);
+        }
+
+        for(size_t k = 0; k < kept.size(); k++) {
+            dirLabelIdentity(gDirLabels[kept[k]]).rank = (int)k;
+        }
+    }
+
+    int countDirLabelPairs(bool kept_only) {
+        int pairs = 0;
+
+        for(size_t i = 0; i < gDirLabels.size(); i++) {
+            if(kept_only && !gDirLabels[i].kept) continue;
+            for(size_t j = i + 1; j < gDirLabels.size(); j++) {
+                if(kept_only && !gDirLabels[j].kept) continue;
+                if(dirLabelOverlap(gDirLabels[i], gDirLabels[j], 0.0f)) pairs++;
+            }
+        }
+
+        return pairs;
+    }
+
+    void logDirLabels() {
+        if(!gDirLabelLog.is_open()) return;
+
+        int kept = 0;
+        for(size_t i = 0; i < gDirLabels.size(); i++) if(gDirLabels[i].kept) kept++;
+
+        gDirLabelLog << "F\t" << gDirLabelFrame << "\t" << (int)gDirLabels.size() << "\t" << kept
+                     << "\t" << countDirLabelPairs(false) << "\t" << countDirLabelPairs(true) << "\n";
+
+        // Detail de l'index, par defaut une lecture sur trente tops, soit une
+        // par demi-seconde de film. L'index compte les ticks de simulation, pas
+        // les images : a -r 30, Gource simule a 60 Hz et n'exporte qu'une image
+        // sur deux (Gource::setFrameExporter), donc l'image k tombe au top 2k.
+        // Une image tiree par ffmpeg a une image par seconde pour la seconde s
+        // n'est pas le top 60*s : c'est l'image 30*s+14, soit le top 60*s+28
+        // (mesure sur le film v3, ou la trame 152 est l'image 4544).
+        int every = gGourceSettings.dir_label_boxes_every > 0
+                        ? gGourceSettings.dir_label_boxes_every : 30;
+
+        if((gDirLabelFrame % every) == 0) {
+            for(size_t i = 0; i < gDirLabels.size(); i++) {
+                const DirLabel& label = gDirLabels[i];
+
+                gDirLabelLog << "L\t" << gDirLabelFrame << "\t" << label.text
+                             << "\t" << label.depth
+                             << "\t" << label.alpha
+                             << "\t" << label.x
+                             << "\t" << label.top
+                             << "\t" << label.w
+                             << "\t" << (label.bottom - label.top)
+                             << "\t" << (label.kept ? 1 : 0)
+                             << "\t" << (label.kept_after >= 0 ? gDirLabels[label.kept_after].text : "-")
+                             << "\t" << label.group
+                             << "\t" << label.id
+                             << "\n";
+            }
+        }
+
+        gDirLabelLog.flush();
+        gDirLabelFrame++;
+    }
+
+    // Appelee une fois par trame, apres le parcours de l'arbre : choisit les
+    // etiquettes a garder, journalise, puis les dessine.
+    void drawDirLabels(FXFont& dirfont) {
+        if(gGourceSettings.dir_name_decollide) {
+            selectDirLabels((float)gGourceSettings.dir_name_gap, gGourceSettings.dir_name_max);
+        } else {
+            // Journal seul : le dessin d'origine a deja eu lieu pour chacune.
+            for(size_t i = 0; i < gDirLabels.size(); i++) gDirLabels[i].kept = true;
+        }
+
+        if(!gGourceSettings.dir_label_boxes_file.empty()) {
+            if(!gDirLabelLog.is_open()) {
+                gDirLabelLog.open(gGourceSettings.dir_label_boxes_file.c_str());
+            }
+            logDirLabels();
+        }
+
+        if(!gGourceSettings.dir_name_decollide) return;
+
+        for(size_t i = 0; i < gDirLabels.size(); i++) {
+            const DirLabel& label = gDirLabels[i];
+            if(!label.kept) continue;
+
+            dirfont.setAlpha(label.alpha);
+            dirfont.draw(label.x, label.y, label.text);
+        }
+    }
+}
