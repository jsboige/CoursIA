<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- IsAspireHost n'est pas positionné : sous le SDK 10.0.110, cette
         propriété déclenche NETSDK1228 (charge de travail Aspire dépréciée).
         Aspire 13.x est livré via le package NuGet Aspire.Hosting.AppHost,
         qui fournit lui-même les targets AppHost. Voir #10474. -->
    <!-- L'AppHost est un hôte .NET Aspire : il n'orchestre aucune ressource
         de notre pile GenAI. Son seul rôle est d'exposer le dashboard Aspire
         et l'endpoint OTLP (http://localhost:4317) que le notebook Python
         Semantic Kernel cible au §6 de 04-SemanticKernel-Filters-Observability.
         Voir #10474 / #10473. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.4.6" />
  </ItemGroup>

</Project>
