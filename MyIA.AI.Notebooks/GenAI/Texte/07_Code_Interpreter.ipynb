    "# Interpreteur maison : un outil run_python execute localement, et une boucle de function calling\n",
    "import json, subprocess, sys\n",
    "from openai import BadRequestError\n",
    "\n",
    "RUN_PYTHON_TOOL = {\n",
    "    \"type\": \"function\",\n",
    "    \"function\": {\n",
    "        \"name\": \"run_python\",\n",
    "        \"description\": (\"Execute un script Python complet dans un processus neuf et rend sa sortie. \"\n",
    "                        \"Rien n'est conserve d'un appel a l'autre ; utiliser print() pour voir un resultat.\"),\n",
    "        \"parameters\": {\n",
    "            \"type\": \"object\",\n",
    "            \"properties\": {\"code\": {\"type\": \"string\", \"description\": \"Script Python complet\"}},\n",
    "            \"required\": [\"code\"],\n",
    "        },\n",
    "    },\n",
    "}\n",
    "\n",
    "def run_python(code, timeout=60):\n",
    "    \"\"\"Execute le code dans un processus separe, sans les variables d'environnement du carnet (donc sans cle d'API).\"\"\"\n",
    "    env = {\"PYTHONIOENCODING\": \"utf-8\", \"MPLBACKEND\": \"Agg\",\n",
    "           \"PATH\": os.environ.get(\"PATH\", \"\"), \"SYSTEMROOT\": os.environ.get(\"SYSTEMROOT\", \"\")}\n",
    "    try:\n",
    "        proc = subprocess.run([sys.executable, \"-c\", code], capture_output=True, text=True,\n",
    "                              encoding=\"utf-8\", timeout=timeout, env=env)\n",
    "        sortie = proc.stdout + (f\"\\n[stderr]\\n{proc.stderr}\" if proc.stderr else \"\")\n",
    "    except subprocess.TimeoutExpired:\n",
    "        sortie = f\"[delai de {timeout} s depasse]\"\n",
    "    return sortie.strip() or \"[aucune sortie : utiliser print()]\"\n",
    "\n",
    "TOOL_CALL_OPTIONS = {}  # complete au premier refus de l'API (voir chat_with_tools)\n",
    "\n",
    "def chat_with_tools(messages, tools):\n",
    "    \"\"\"Un appel Chat Completions avec outils. Certains modeles de raisonnement n'acceptent des outils\n",
    "    'function' dans Chat Completions qu'avec reasoning_effort='none' : on le regle au premier refus.\"\"\"\n",
    "    try:\n",
    "        return client.chat.completions.create(model=DEFAULT_MODEL, messages=messages, tools=tools, **TOOL_CALL_OPTIONS)\n",
    "    except BadRequestError as e:\n",
    "        if \"reasoning_effort\" not in str(e) or TOOL_CALL_OPTIONS:\n",
    "            raise\n",
    "        TOOL_CALL_OPTIONS[\"reasoning_effort\"] = \"none\"\n",
    "        print(\"(L'API exige reasoning_effort='none' pour les outils function de ce modele : reglage applique.)\")\n",
    "        return client.chat.completions.create(model=DEFAULT_MODEL, messages=messages, tools=tools, **TOOL_CALL_OPTIONS)\n",
    "\n",
    "def ask_with_tools(question, tools, functions, system=None, max_steps=6, max_chars=1500):\n",
    "    \"\"\"Boucle de function calling : execute chaque appel d'outil et renvoie son resultat au modele.\"\"\"\n",
    "    messages = ([{\"role\": \"system\", \"content\": system}] if system else []) + [{\"role\": \"user\", \"content\": question}]\n",
    "    for step in range(1, max_steps + 1):\n",
    "        msg = chat_with_tools(messages, tools).choices[0].message\n",
    "        if not msg.tool_calls:\n",
    "            print(\"=== Reponse du modele ===\")\n",
    "            print(msg.content)\n",
    "            return msg.content\n",
    "        messages.append(msg)\n",
    "        for call in msg.tool_calls:\n",
    "            args = json.loads(call.function.arguments)\n",
    "            print(f\"--- Etape {step} : appel de {call.function.name} ---\")\n",
    "            print(args[\"code\"].strip() if call.function.name == \"run_python\" else json.dumps(args, ensure_ascii=False))\n",
    "            resultat = str(functions[call.function.name](**args))\n",
    "            print(f\"--- Resultat renvoye au modele ---\\n{resultat[:max_chars]}{' [...]' if len(resultat) > max_chars else ''}\")\n",
    "            messages.append({\"role\": \"tool\", \"tool_call_id\": call.id, \"content\": resultat[:6000]})\n",
    "    print(f\"Arret apres {max_steps} etapes sans reponse finale.\")\n",
    "    return None\n",
    "\n",
    "SYSTEME_INTERPRETEUR = (\"Tu disposes de l'outil run_python. Pour tout calcul, écris le code et exécute-le \"\n",
    "                        \"au lieu de calculer de tête. Réponds en français.\")\n",
    "reponse_maison = ask_with_tools(question_premiers, [RUN_PYTHON_TOOL], {\"run_python\": run_python},\n",
    "                                system=SYSTEME_INTERPRETEUR)\n",
    "print(f\"\\nValeur exacte (crible local) : {NB_PREMIERS}\")"
   ]
