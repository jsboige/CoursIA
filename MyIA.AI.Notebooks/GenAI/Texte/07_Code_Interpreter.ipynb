   "source": [
    "# Sans outil : le modele repond \"de tete\", sans executer de code\n",
    "question_premiers = (\"Combien y a-t-il de nombres premiers p tels que 1 000 000 <= p < 1 010 000 ? \"\n",
    "                     \"Donne uniquement le nombre.\")\n",
    "\n",
    "response = client.chat.completions.create(\n",
    "    model=DEFAULT_MODEL,\n",
    "    messages=[{\"role\": \"user\", \"content\": question_premiers}],\n",
    ")\n",
    "reponse_sans_outil = response.choices[0].message.content.strip()\n",
    "details = response.usage.completion_tokens_details\n",
    "print(\"=== Sans outil (Chat Completions : aucune execution) ===\")\n",
    "print(f\"Reponse du modele : {reponse_sans_outil}\")\n",
    "print(f\"Tokens de raisonnement depenses : {details.reasoning_tokens if details else 'non communique'}\")\n",
    "\n",
    "# Reference calculee localement par un crible d'Eratosthene, pour juger la reponse\n",
    "def compter_premiers(debut, fin):\n",
    "    crible = bytearray([1]) * fin\n",
    "    crible[0:2] = b\"\\x00\\x00\"\n",
    "    for i in range(2, int(fin ** 0.5) + 1):\n",
    "        if crible[i]:\n",
    "            crible[i * i::i] = bytearray(len(crible[i * i::i]))\n",
    "    return sum(crible[debut:fin])\n",
    "\n",
    "NB_PREMIERS = compter_premiers(1_000_000, 1_010_000)\n",
    "print(f\"Valeur exacte (crible local) : {NB_PREMIERS}\")\n",
    "print(f\"Reponse correcte : {reponse_sans_outil.replace(' ', '') == str(NB_PREMIERS)}\")"
   ]
