   "source": [
    "# Interpreteur heberge : outil code_interpreter de la Responses API\n",
    "import base64\n",
    "from IPython.display import Image, display\n",
    "\n",
    "CONTAINERS, UPLOADED_FILES = set(), []  # ressources cote OpenAI, supprimees en fin de carnet\n",
    "\n",
    "def show_interpreter_run(response, max_chars=2000):\n",
    "    \"\"\"Affiche le code execute par le modele, ses sorties, puis la reponse finale.\"\"\"\n",
    "    appels = [item for item in response.output if item.type == \"code_interpreter_call\"]\n",
    "    for n, item in enumerate(appels, 1):\n",
    "        print(f\"--- Execution {n} : code ecrit par le modele ---\")\n",
    "        print(item.code.strip())\n",
    "        for out in item.outputs or []:\n",
    "            if out.type == \"logs\":\n",
    "                logs = out.logs.strip()\n",
    "                print(f\"--- Sortie ---\\n{logs[:max_chars]}{' [...]' if len(logs) > max_chars else ''}\")\n",
    "            elif out.type == \"image\":\n",
    "                print(\"--- Sortie : image ---\")\n",
    "                display(Image(data=base64.b64decode(out.url.split(\",\", 1)[1])))\n",
    "    print(f\"=== Reponse du modele ({len(appels)} execution(s) de code) ===\")\n",
    "    print(response.output_text)\n",
    "\n",
    "def container_of(response):\n",
    "    \"\"\"Identifiant du conteneur utilise par une reponse (None si aucun code n'a ete execute).\"\"\"\n",
    "    return next((i.container_id for i in response.output if i.type == \"code_interpreter_call\"), None)\n",
    "\n",
    "def ask_code_interpreter(prompt, file_ids=None, previous=None):\n",
    "    \"\"\"Interroge le modele avec l'outil code_interpreter ; previous = reponse a poursuivre dans le meme conteneur.\"\"\"\n",
    "    if not HOSTED_CI:\n",
    "        print(\"Interpreteur heberge indisponible avec ce fournisseur : voir la section sur l'interpreteur maison.\")\n",
    "        return None\n",
    "    container = container_of(previous) if previous is not None else None\n",
    "    suite = {\"previous_response_id\": previous.id} if previous is not None else {}\n",
