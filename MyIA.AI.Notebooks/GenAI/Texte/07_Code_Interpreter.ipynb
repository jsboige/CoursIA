    "# Exercice 4 : Boucle de correction automatique\n",
    "# Etape 1 : generate_with_repair(spec, test_cases, max_attempts=3), premier essai comme l'exemple guide 1\n",
    "# Etape 2 : si un test echoue, renvoyer au modele le code + les cas en echec, et redemander\n",
    "# Etape 3 : rendre code, tests_passed, tests_total, attempts, history (score de chaque essai)\n",
    "# Indice : reutiliser l'extraction par regex et l'execution dans un namespace dedie de l'exemple guide 1\n",
    "\n",
    "def generate_with_repair(spec, test_cases, max_attempts=3):\n",
    "    return None  # TODO etudiant : implementer\n",
