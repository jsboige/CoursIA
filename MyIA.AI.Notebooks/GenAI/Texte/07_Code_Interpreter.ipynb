   "source": [
    "# Exemple guide 2 : la fonction du groupe, mise a disposition du modele par function calling\n",
    "# Contribution d'un groupe d'etudiants EPF (TP2, PR #20688)\n",
    "# histogramme (moyenne, mediane) + boxplot par groupe ; outliers par la regle IQR, celle du boxplot\n",
    "\n",
    "import matplotlib\n",
    "matplotlib.use('Agg')  # backend non interactif : la figure est enregistree puis affichee\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from IPython.display import Image, display\n",
    "\n",
    "def plot_sales_analysis(df, value_col, group_col):\n",
    "    values = df[value_col]\n",
    "    mean, median = values.mean(), values.median()\n",
    "\n",
    "    fig, (ax_hist, ax_box) = plt.subplots(1, 2, figsize=(12, 5))\n",
    "\n",
    "    # Sous-figure 1 : histogramme + moyenne et mediane\n",
    "    ax_hist.hist(values, bins=20, color='#95a5a6', edgecolor='black', alpha=0.7)\n",
    "    ax_hist.axvline(mean, color='red', linestyle='--', linewidth=2, label=f'Moyenne = {mean:.1f}')\n",
    "    ax_hist.axvline(median, color='blue', linestyle='-', linewidth=2, label=f'Mediane = {median:.1f}')\n",
    "    ax_hist.set_title(f'Distribution de {value_col}')\n",
    "    ax_hist.set_xlabel(value_col)\n",
    "    ax_hist.set_ylabel('Frequence')\n",
    "    ax_hist.legend()\n",
    "\n",
    "    # Sous-figure 2 : boxplot par groupe, outliers en rouge\n",
    "    groups = sorted(df[group_col].unique())\n",
    "    data = [df.loc[df[group_col] == g, value_col].values for g in groups]\n",
    "    ax_box.boxplot(data, flierprops=dict(marker='o', markerfacecolor='red', markersize=8))\n",
    "    ax_box.set_xticks(range(1, len(groups) + 1))\n",
    "    ax_box.set_xticklabels(groups)\n",
    "    ax_box.set_title(f'{value_col} par {group_col} (outliers en rouge)')\n",
    "    ax_box.set_xlabel(group_col)\n",
    "    ax_box.set_ylabel(value_col)\n",
    "\n",
    "    # Detection des outliers (regle IQR, la meme que le boxplot)\n",
    "    outliers = {}\n",
    "    for g, vals in zip(groups, data):\n",
    "        q1, q3 = np.percentile(vals, [25, 75])\n",
    "        iqr = q3 - q1\n",
    "        outliers[g] = vals[(vals < q1 - 1.5 * iqr) | (vals > q3 + 1.5 * iqr)]\n",
    "\n",
    "    fig.suptitle(f'Analyse de {value_col} et detection d\\'anomalies', fontsize=14)\n",
    "    plt.tight_layout()\n",
    "    filename = 'graphique_analyse_anomalies.png'\n",
    "    plt.savefig(filename, dpi=100, bbox_inches='tight')\n",
    "    plt.close(fig)\n",
    "    display(Image(filename))  # backend 'Agg' actif : on affiche le PNG sauvegarde\n",
    "\n",
    "    print(f\"Graphique sauvegarde : {filename}\")\n",
    "    print(f\"Moyenne : {mean:.2f} | Mediane : {median:.2f}\")\n",
    "    for g, vals in outliers.items():\n",
    "        print(f\"  {g} : {len(vals)} outlier(s) {np.round(vals, 1).tolist() if len(vals) else ''}\")\n",
    "    return outliers\n",
    "\n",
    "# Test :\n",
    "np.random.seed(42)\n",
    "test_df = pd.DataFrame({\n",
    "    'ventes': np.random.randint(100, 500, 100) + np.sin(np.arange(100)*0.1)*50,\n",
    "    'region': np.random.choice(['Nord', 'Sud', 'Est', 'Ouest'], 100)\n",
    "})\n",
    "plot_sales_analysis(test_df, 'ventes', 'region')"
    "    return outliers\n",
    "\n",
    "# Description de l'outil pour le modele\n",
    "SALES_TOOL = {\n",
    "    \"type\": \"function\",\n",
    "    \"function\": {\n",
    "        \"name\": \"plot_sales_analysis\",\n",
    "        \"description\": (\"Trace la distribution d'une colonne du jeu de ventes et un boxplot par groupe, \"\n",
    "                        \"puis rend la moyenne, la mediane et les valeurs aberrantes de chaque groupe (regle IQR).\"),\n",
    "        \"parameters\": {\n",
    "            \"type\": \"object\",\n",
    "            \"properties\": {\n",
    "                \"value_col\": {\"type\": \"string\", \"enum\": [\"ventes\"]},\n",
    "                \"group_col\": {\"type\": \"string\", \"enum\": [\"region\", \"produit\"]},\n",
    "            },\n",
    "            \"required\": [\"value_col\", \"group_col\"],\n",
    "        },\n",
    "    },\n",
    "}\n",
    "\n",
    "def sales_tool(value_col, group_col):\n",
    "    \"\"\"Appelle la fonction du groupe sur le jeu de ventes et rend au modele un resultat JSON.\"\"\"\n",
    "    outliers = plot_sales_analysis(df, value_col, group_col)\n",
    "    return json.dumps({\n",
    "        \"moyenne\": round(float(df[value_col].mean()), 2),\n",
    "        \"mediane\": round(float(df[value_col].median()), 2),\n",
    "        \"outliers_par_groupe\": {g: np.round(v, 1).tolist() for g, v in outliers.items()},\n",
    "    }, ensure_ascii=False)\n",
    "\n",
    "reponse_eg2 = ask_with_tools(\n",
    "    \"Dans notre jeu de ventes, certaines régions ont-elles des ventes anormales ? \"\n",
    "    \"Appuie-toi sur l'outil disponible et explique ce que montre son résultat.\",\n",
    "    [SALES_TOOL], {\"plot_sales_analysis\": sales_tool},\n",
    ")"
   ]
