   "source": [
    "# Exemple guide 3 : rapport statistique du groupe, mis a disposition du modele par function calling\n",
    "# Contribution d'un groupe d'etudiants EPF (TP2, PR #20688)\n",
    "# une ligne par colonne : moyenne, mediane, ecart-type, min, max, outliers a 2 sigma, interpretation\n",
    "\n",
    "\n",
    "def analyze_dataframe(df, columns=None):\n",
    "    # Par defaut : toutes les colonnes numeriques\n",
    "    if columns is None:\n",
    "        columns = df.select_dtypes(include='number').columns.tolist()\n",
    "\n",
    "    rows = []\n",
    "    for col in columns:\n",
    "        values = df[col].dropna()\n",
    "        mean, median, std = values.mean(), values.median(), values.std()\n",
    "        nb_outliers = int(((values > mean + 2 * std) | (values < mean - 2 * std)).sum())\n",
    "        rows.append({\n",
    "            'colonne': col,\n",
    "            'moyenne': mean,\n",
    "            'mediane': median,\n",
    "            'ecart_type': std,\n",
    "            'min': values.min(),\n",
    "            'max': values.max(),\n",
    "            'nb_outliers': nb_outliers,\n",
    "            'interpretation': 'symetrique' if abs(mean - median) < 0.1 * std else 'asymetrique',\n",
    "        })\n",
    "\n",
    "    return pd.DataFrame(rows).set_index('colonne').round(2)\n",
    "\n",
    "# Test avec le dataset de ventes :\n",
    "np.random.seed(42)\n",
    "test_df = pd.DataFrame({\n",
    "    'ventes': np.random.randint(100, 500, 100),\n",
    "    'temperature': np.random.normal(20, 5, 100)\n",
    "})\n",
    "rapport = analyze_dataframe(test_df, ['ventes', 'temperature'])\n",
    "print(rapport)"
    "\n",
    "# Jeu de test du groupe : ventes uniformes et temperature gaussienne\n",
    "np.random.seed(42)\n",
    "test_df = pd.DataFrame({\n",
    "    'ventes': np.random.randint(100, 500, 100),\n",
    "    'temperature': np.random.normal(20, 5, 100)\n",
    "})\n",
    "DATASETS = {\"ventes\": df, \"mesures\": test_df}\n",
    "\n",
    "STATS_TOOL = {\n",
    "    \"type\": \"function\",\n",
    "    \"function\": {\n",
    "        \"name\": \"analyze_dataframe\",\n",
    "        \"description\": (\"Rapport statistique d'un jeu de donnees : par colonne numerique, moyenne, mediane, \"\n",
    "                        \"ecart-type, min, max, nombre de valeurs a plus de deux ecarts-types de la moyenne, \"\n",
    "                        \"et forme de la distribution.\"),\n",
    "        \"parameters\": {\n",
    "            \"type\": \"object\",\n",
    "            \"properties\": {\n",
    "                \"dataset\": {\"type\": \"string\", \"enum\": list(DATASETS)},\n",
    "                \"columns\": {\"type\": \"array\", \"items\": {\"type\": \"string\"},\n",
    "                            \"description\": \"Colonnes a analyser ; toutes les colonnes numeriques si absent\"},\n",
    "            },\n",
    "            \"required\": [\"dataset\"],\n",
    "        },\n",
    "    },\n",
    "}\n",
    "\n",
    "def stats_tool(dataset, columns=None):\n",
    "    \"\"\"Calcule le rapport du groupe (colonnes inconnues ignorees) et le rend au modele en JSON.\"\"\"\n",
    "    data = DATASETS[dataset]\n",
    "    columns = [c for c in (columns or []) if c in data.columns] or None\n",
    "    return analyze_dataframe(data, columns).to_json(orient=\"index\", force_ascii=False)\n",
    "\n",
    "reponse_eg3 = ask_with_tools(\n",
    "    \"Le jeu 'mesures' contient-il des valeurs aberrantes inquiétantes ? Utilise l'outil, puis dis pour \"\n",
    "    \"chaque colonne si les valeurs signalées sont de vraies anomalies ou ce qu'on attend de cette distribution.\",\n",
    "    [STATS_TOOL], {\"analyze_dataframe\": stats_tool},\n",
    ")"
   ]
