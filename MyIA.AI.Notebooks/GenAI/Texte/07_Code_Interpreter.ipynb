    "# Exemple guide 1 : Generation de code avec validation\n",
    "# Contribution d'un groupe d'etudiants EPF (TP2, PR #20688)\n",
    "# generer -> extraire le bloc de code -> executer dans un namespace dedie -> tester\n",
    "\n",
    "\n",
    "import re\n",
    "\n",
    "def generate_and_validate(spec, test_cases):\n",
    "    # Etape 1 : prompt qui demande uniquement le code Python\n",
    "    prompt = (\n",
    "        f\"Ecris en Python : {spec}.\\n\"\n",
    "        \"Reponds UNIQUEMENT avec le code de la fonction dans un bloc ```python ... ```, \"\n",
    "        \"sans explications, sans exemples d'utilisation et sans tests.\"\n",
    "    )\n",
    "\n",
    "    # Etape 2 : appel a l'API Chat Completions\n",
    "    response = client.chat.completions.create(\n",
    "        model=DEFAULT_MODEL,\n",
    "        messages=[\n",
    "            {\"role\": \"system\", \"content\": \"Tu es un developpeur Python expert. Tu ne reponds qu'avec du code.\"},\n",
    "            {\"role\": \"user\", \"content\": prompt}\n",
    "        ],\n",
    "        max_completion_tokens=2000\n",
    "    )\n",
    "    content = response.choices[0].message.content or \"\"\n",
    "\n",
    "    # Etape 3 : extraction du bloc de code (fallback : reponse brute si pas de bloc)\n",
    "    match = re.search(r'```(?:python)?\\s*\\n(.*?)```', content, re.DOTALL)\n",
    "    code = match.group(1).strip() if match else content.strip()\n",
    "\n",
    "    # Etape 4 : execution dans un namespace dedie\n",
    "    namespace = {}\n",
    "    try:\n",
    "        exec(code, namespace)\n",
    "    except Exception as e:\n",
    "        print(f\"Erreur a l'execution du code genere : {e}\")\n",
    "        return {\"code\": code, \"tests_passed\": 0, \"tests_total\": len(test_cases)}\n",
    "\n",
    "    # Recuperer la fonction : nom cite dans la spec (ex: \"is_palindrome(s)\"), sinon derniere fonction definie\n",
    "    functions = {name: obj for name, obj in namespace.items()\n",
    "                 if callable(obj) and not name.startswith(\"__\")}\n",
    "    name_match = re.search(r'(\\w+)\\s*\\(', spec)\n",
    "    if name_match and name_match.group(1) in functions:\n",
    "        func = functions[name_match.group(1)]\n",
    "    elif functions:\n",
    "        func = list(functions.values())[-1]\n",
    "    else:\n",
    "        print(\"Aucune fonction trouvee dans le code genere\")\n",
    "        return {\"code\": code, \"tests_passed\": 0, \"tests_total\": len(test_cases)}\n",
    "\n",
    "    # Lancer les tests\n",
    "    nb_passed = 0\n",
    "    for test_input, expected in test_cases:\n",
    "        try:\n",
    "            result = func(*test_input) if isinstance(test_input, tuple) else func(test_input)\n",
    "            ok = result == expected\n",
    "        except Exception as e:\n",
    "            result, ok = f\"Exception: {e}\", False\n",
    "        nb_passed += ok\n",
    "        print(f\"  {'OK  ' if ok else 'FAIL'} {func.__name__}({test_input!r}) -> {result!r} (attendu: {expected!r})\")\n",
    "\n",
    "    return {\"code\": code, \"tests_passed\": nb_passed, \"tests_total\": len(test_cases)}\n",
    "\n",
    "# Test :\n",
    "result = generate_and_validate(\n",
    "    \"Fonction is_palindrome(s) qui retourne True si s est un palindrome\",\n",
    "    [(\"radar\", True), (\"hello\", False), (\"\", True), (\"a\", True)]\n",
    ")\n",
    "print(\"\\nCode genere :\")\n",
    "print(result[\"code\"])\n",
    "print(f\"\\nTests reussis : {result['tests_passed']}/{result['tests_total']}\")"
   ]
