   "source": [
    "# Volet PDF (seconde passe #18574) : le tableau de ventes, mais en VRAI\n",
    "# document PDF -- reportlab est installe depuis la cellule d'installation et\n",
    "# c'est ici sa premiere utilisation. On reutilise la variable `ventes` definie\n",
    "# par la resolution ci-dessus : meme contenu, autre medium.\n",
    "from reportlab.lib.pagesizes import A4\n",
    "from reportlab.pdfgen import canvas as pdf_canvas\n",
    "\n",
    "pdf_buffer = io.BytesIO()\n",
    "c = pdf_canvas.Canvas(pdf_buffer, pagesize=A4)\n",
    "c.setFont(\"Helvetica-Bold\", 16)\n",
    "c.drawString(60, 800, \"Ventes Mensuelles 2026\")\n",
    "c.setFont(\"Helvetica\", 12)\n",
    "y = 760\n",
    "for mois, valeur in ventes:\n",
    "    c.drawString(60, y, f\"{mois} : {valeur}\")\n",
    "    y -= 20\n",
    "c.save()\n",
    "pdf_bytes = pdf_buffer.getvalue()\n",
    "pdf_b64 = base64.b64encode(pdf_bytes).decode()\n",
    "print(f\"PDF genere : {len(pdf_bytes)} octets, une page A4, {len(ventes)} lignes de ventes\")\n",
    "\n",
    "# La section 1 laissait entendre que Chat Completions n'accepte pas les PDF.\n",
    "# La partie de contenu de type \"file\" le permet pourtant -- testons sur un\n",
    "# document reel si gpt-5-mini lit un PDF aussi bien qu'une image.\n",
    "response_pdf = client.chat.completions.create(\n",
    "    model=DEFAULT_MODEL,\n",
    "    messages=[{\n",
    "        \"role\": \"user\",\n",
    "        \"content\": [\n",
    "            {\"type\": \"text\",\n",
    "             \"text\": \"Extrais les ventes mensuelles de ce document PDF et identifie la tendance.\"},\n",
    "            {\"type\": \"file\",\n",
    "             \"file\": {\"filename\": \"ventes_2026.pdf\",\n",
    "                      \"file_data\": f\"data:application/pdf;base64,{pdf_b64}\"}},\n",
    "        ],\n",
    "    }],\n",
    "    max_completion_tokens=4000,\n",
    ")\n",
    "print(response_pdf.choices[0].message.content)\n",
    "print(f\"\\nTokens utilises: {response_pdf.usage.total_tokens}\")"
   ]
