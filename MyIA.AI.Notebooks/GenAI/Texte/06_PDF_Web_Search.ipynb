    "3. Les perspectives pour Q2 2026\n",
    "\n",
    "Fournis une analyse comparative brève.\n",
    "\"\"\"\n",
    "\n",
    "web_context = client.responses.create(\n",
    "    model=DEFAULT_MODEL,\n",
    "    tools=[WEB_TOOL],\n",
    "    input=context_query\n",
    ")\n",
    "\n",
    "print(\"=== Analyse enrichie (Document + Web) ===\")\n",
    "for item in web_context.output:\n",
    "    if hasattr(item, 'content'):\n",
