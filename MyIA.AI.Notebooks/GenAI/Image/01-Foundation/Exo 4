        "def profil_couleur(img):\n",
        "    \"\"\"(luminosite moyenne, part de pixels chauds, part de pixels froids).\"\"\"\n",
        "    rvb = img.convert(\"RGB\")\n",
        "    luminosite = ImageStat.Stat(rvb.convert(\"L\")).mean[0]\n",
