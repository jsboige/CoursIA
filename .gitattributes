# Normalize Jupyter notebooks to LF line endings
*.ipynb text eol=lf
# Normalize files consumed by the catalog-drift CI check to LF so byte-level
# comparison is platform-independent (issue #1056). Limited to the exact files
# the check reads, to avoid a wide renormalization of unrelated .md files.
COURSE_CATALOG.generated.json text eol=lf
MyIA.AI.Notebooks/README.md text eol=lf
MyIA.AI.Notebooks/*/README.md text eol=lf
# Source/config files that are consumed by Linux/WSL tooling (Lean lakes,
# shell scripts, env files) MUST be LF — a CRLF shebang (e.g. "#!/bin/bash\r")
# breaks WSL with "bad interpreter", and CRLF in .lean breaks lake on Linux.
# Pattern "L268": the Edit tool on Windows flips LF->CRLF intermittently when
# no explicit eol rule is set. Found 5x (i18n *.en.md c.268, *.sh + .env c.281).
*.lean text eol=lf
*.sh text eol=lf
.env text eol=lf
.env.example text eol=lf
*.en.md text eol=lf
# Lean lake manifests are JSON consumed cross-platform; keep LF.
lake-manifest.json text eol=lf
# Traduction CSVs (translation-sync, #11249) : le generateur
# `extract_cells_to_csv.py` est deja LF-only (L359 normalise \r\n et \r), mais
# un `eol=lf` explicite rend l'invariant structurel au lieu de dependre des
# internes d'un script (residus CRLF legacy pre-L268 encore presents sur main).
# Meme motif que `*.ipynb text eol=lf` / L268.
translations/**/*.csv text eol=lf
# Quarto site config (#11109) : _quarto.yml est consomme par Quarto CLI (Linux
# dans CI, local Windows). CRLF le brise silencieusement (parsing YAML + render
# pages github.io). Meme motif L268.
_quarto.yml text eol=lf
# Git LFS tracking for model files referenced by notebooks
*.pt filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text

# Registre twin-parity (#8057) : autrefois un mono-fichier `twin_pairs.yaml`
# (liste append-only) sur lequel un `merge=union` etait declare pour mitiger le
# conflit serie systematique entre N tranches de registration (recurrences
# #8415/#8476/#8499/#8505/#8526/#8492, toutes resolues a la main). #8542 Option
# C a deplace le registre vers `twin_pairs.d/` (un fichier par paire) : deux PRs
# qui enregistrent des paires differentes touchent des fichiers differentes ->
# la classe de conflit est supprimee a la source, le driver `union` n'a donc
# plus d'objet (et de toute facon n'etait jamais honore par le merge cote serveur
# GitHub). Ne PAS le re-ajouter : le filet de securite structural est desormais
# scripts/notebook_tools/tests/test_twin_registry_integrity.py (file-per-entry).
#
# EOL (meme motif "L268" que ci-dessus) : le registre est reecrit par
# `check_twin_parity.py --update`, donc par des agents dont la moitie tourne
# sous Windows. Sans regle explicite, un rebaseline d'UNE paire y basculait le
# fichier entier en CRLF et le diff passait de 2 lignes a tout le fichier
# (#8709, #8713). L'ecrivain est corrige cote outil (`write_registry_text`) ;
# cette regle est le second filet, qui vaut pour n'importe quel ecrivain.
scripts/notebook_tools/twin_pairs.d/*.yaml text eol=lf

# Snapshots verbatim des taxonomies Argumentum (amont : ArgumentumGames/Argumentum).
# Ces deux CSV ne sont PAS edites ici : ils sont recopies octet pour octet depuis
# l'amont, et tout le reste (notebooks Argument_Analysis, FallacyDetection,
# scripts/fallacy_detection) les lit comme source de verite locale.
#
# Pourquoi `-text` et non `text eol=crlf` : la source porte 139 sauts de ligne
# ISOLES (LF nu) a l'interieur de cellules citees, en plus de ses 1409 CRLF de
# fin d'enregistrement. Sous `core.autocrlf=true` et sans regle, git normalise
# ces LF internes en CRLF -- c'est exactement ce qui est arrive a l'import de
# juillet (#5183), dont le message annoncait "verbatim" alors que le blob stocke
# differait de l'amont. `-text` desactive toute conversion : le blob est l'amont.
# Ne pas "corriger" en `text eol=...` : ce serait re-ouvrir la meme corruption.
MyIA.AI.Notebooks/SymbolicAI/Argument_Analysis/data/argumentum_*_taxonomy.csv -text

# Troisieme copie historique (SymbolicAI/data/) : unifiee octet pour octet a la
# canonique le 30/08 (#13578) apres sept semaines de derive silencieuse (74
# colonnes contre 104 : toute la couche i18n _ar/_es et les AIF_* manquaient).
# Elle n'a aucun consommateur dans le repo (scripts et notebooks pointent tous
# sur la canonique) mais reste distribuee : meme regle -text, sinon le prochain
# checkout re-corrigerait les LF internes et la re-divergence renaîtrait.
MyIA.AI.Notebooks/SymbolicAI/data/argumentum_*_taxonomy.csv -text

# Meme raisonnement pour les ontologies OWL distillees depuis le meme amont, et
# meme phenomene mesure : argumentum.owl porte 41 sauts de ligne ISOLES (LF nu)
# au milieu de ses 107853 CRLF, argumentum_virtues.owl est en CRLF pur. L'amont
# stocke ces octets tels quels ; sous `core.autocrlf=true` et sans regle, git
# normaliserait ici et le blob stocke differerait de l'amont alors que le fichier
# sur disque semblerait identique -- la panne exacte de l'import #5183.
# `text eol=crlf` ne conviendrait pas davantage que pour les CSV : il ecraserait
# les 41 LF nus. La preuve de verbatim est l'EGALITE DES SHA DE BLOB (consignee
# dans argumentum_snapshot.json), et elle n'est atteignable qu'avec `-text`.
MyIA.AI.Notebooks/SymbolicAI/Argument_Analysis/ontologies/argumentum_*.owl -text
